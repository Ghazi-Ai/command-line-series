#chapter[BSD: العائلة الأخرى]

#objectives((
  [تعرف من أين جاءت عائلة BSD، وما صِلتها بيونِكس الأصليّ وبلِينُكس.],
  [تميّز بين أبنائها الرئيسيّين: FreeBSD وOpenBSD وNetBSD وGhostBSD وDragonFly، ومتى يُختار كلٌّ منها.],
  [تدير الحزم بأداة `pkg` وشجرة `ports`، بدل `apt`، وتشغّل الخدمات بـ `rc.d` و `rc.conf` بدل systemd.],
  [تكتب قاعدة جدارٍ ناريٍّ بـ `pf`، وتفهم العزل عبر `jails` — الحاويات قبل أن تُسمّى حاويات.],
  [تنتبه إلى الفروق الخفيّة بين أدوات BSD الأصيلة وأدوات GNU التي اعتدتها.],
))

طوال خمسةٍ وأربعين فصلًا كنت تظنّ أنّ عالم يونِكس المفتوح هو لِينُكس وحده. الحقيقة أنّ للِينُكس ابنَ عمٍّ أكبرَ منه سنًّا، أعرقَ نسبًا، وأهدأَ صوتًا: عائلة *BSD*. تخيّل أُسرتين تنحدران من جدٍّ واحدٍ هو يونِكس الأصليّ الذي وُلد في مختبرات بل عام ١٩٦٩. أحد الفرعين — لِينُكس — أعاد بناء البيت من الصفر بأثاثٍ جديد. والفرع الآخر — BSD — ورِث البيتَ العتيقَ نفسه وظلّ يرمّمه جيلًا بعد جيل. حين تدخل بيت BSD تشعر أنك في مكانٍ مألوفٍ وغريبٍ معًا: الطرفية هي الطرفية، و `ls` هي `ls`، لكنّ رفوف المطبخ رُتّبت بترتيبٍ آخر. هذا الفصل خريطتُك إلى ذلك البيت الشقيق.

#section[شجرة العائلة: من يونِكس إلى BSD]

يونِكس الأصليّ لم يكن مفتوحًا؛ كان ملكًا لشركة AT&T. لكنّ جامعة كاليفورنيا في بِركلي حصلت على نسخةٍ منه في السبعينيّات، وأخذ طلّابها — وعلى رأسهم بِل جوي — يضيفون إليه ويحسّنونه، حتى صارت إضافاتُهم توزيعةً كاملةً سُمّيت *توزيعة بِركلي للبرمجيّات*، واختُصرت إلى BSD. من هذا المطبخ الجامعيّ خرجت أشياء نستعملها كلَّ يومٍ الآن: محرّر `vi`، والصدفة C‑shell، وأهمُّ من ذلك: مكدّس الشبكة الذي يشغّل الإنترنت (TCP/IP) وُلد هنا.

#define("BSD", [
  اختصار «Berkeley Software Distribution»، أي توزيعة بِركلي للبرمجيّات. عائلةٌ من أنظمة التشغيل الشبيهة بيونِكس، تنحدر مباشرةً من شِفرة يونِكس الأصليّة عبر أعمال جامعة بِركلي، لا من إعادة بناءٍ مستقلّة كما فعل لِينُكس.
])

هنا يظهر الفرق الجوهريّ الأوّل عن لِينُكس. لِينُكس *نواةٌ* فقط، كتبها لينوس تورفالدس من الصفر، ثم لُفّت حولها أدواتُ مشروع GNU، ثم جمعت التوزيعاتُ (أوبونتو، فيدورا...) القطعتين. أمّا BSD فهو *نظامٌ كاملٌ متكامل* من مصدرٍ واحد: النواة والأدوات والمكتبات والمثبِّت تُطوَّر معًا في مستودعٍ واحدٍ ويصدر كوحدةٍ واحدة. لا «توزيعات BSD» بالمعنى نفسه، بل مشاريعُ BSD مستقلّة، لكلٍّ نواتُه وأدواتُه معًا.

#note[
  ولهذا رخصةٌ مختلفة أيضًا. لِينُكس تحت رخصة GPL التي تُلزم من يعدّل الشِّفرة بأن ينشر تعديله. أمّا رخصة BSD فمتساهلة: خذ الشِّفرة، وغيّرها، وبِعها مغلقةً إن شئت، دون التزامٍ بالنشر. ولهذا استعملتها شركاتٌ كبرى في منتجاتها المغلقة — ومنها آبل، كما سترى بعد قليل.
]

#section[القبائل الخمس: من هو مَن في BSD]

حين يقول أحدهم «أستعمل لِينُكس» تسأله: أيَّ توزيعة؟ وحين يقول «أستعمل BSD» تسأله: أيَّ BSD؟ فالعائلة اليوم خمسةُ مشاريعَ كبرى، لكلٍّ فلسفةٌ وميدانٌ يتفوّق فيه:

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 1 { right + horizon } else { center + horizon },
  table.header([المشروع], [فلسفتُه وميدانُه]),
  [FreeBSD], [الأشهر والأعمّ. خوادمُ عالية الأداء والشبكات. تشغّل شركاتٍ كبرى؛ وتبثّ نتفليكس جزءًا ضخمًا من فيديو العالم عبره.],
  [OpenBSD], [الأمن والصحّة قبل كلّ شيء. «افتراضيًّا آمن». منه خرجت `OpenSSH` و `pf` و `LibreSSL` التي يستعملها العالم كلّه.],
  [NetBSD], [النقل (Portability). شعارُه «طبعًا يعمل عليه»: يُقلع على عشرات المعماريّات، من الخوادم إلى المحمّصة الكهربائيّة تقريبًا.],
  [GhostBSD], [سطح المكتب. يبني على FreeBSD ويضيف واجهةً رسوميّةً جاهزة (MATE)، ليجرّب المبتدئ BSD دون عناء التركيب.],
  [DragonFly], [انشقّ عن FreeBSD عام ٢٠٠٣ على يد مات ديلون، بحثًا عن أداءٍ مختلفٍ في المعالجات متعدّدة الأنوية، ونظام ملفّاته المميّز HAMMER2.],
)

الخلاصة العمليّة: إن أردت خادمًا متينًا فـ FreeBSD؛ وإن كان الأمنُ هاجسَك الأكبر فـ OpenBSD؛ وإن كنت مبتدئًا تريد أن ترى BSD بعينيك على سطح مكتبٍ فـ GhostBSD. وبقيّة هذا الفصل تتّخذ FreeBSD مرجعًا، لأنه الأوسع انتشارًا، مع الإشارة إلى فروق إخوته حيث تهمّ.

#try-it[
  لا تحتاج إلى مغادرة لِينُكس لتلمس روح BSD. افتح طرفيّتك ونفّذ `ssh -V`؛ الاسم `OpenSSH` الذي سيظهر لك هو هديّة مشروع OpenBSD إلى العالم كلّه. الأداة التي تربط بها خوادمك يوميًّا وُلدت في بيت BSD، لا في لِينُكس.
]

#section[إدارة الحزم: pkg وشجرة ports]

في الفصل الثاني عشر أتقنت `apt`. في FreeBSD تجد طريقين للبرمجيّات، لا طريقًا واحدًا، وهذا أوّل اختلافٍ يوميٍّ ستلمسه. الطريق الأوّل حزمٌ ثنائيّةٌ جاهزة عبر أداة `pkg` — وهو نظيرُ `apt` المباشر:

```sh
pkg install nginx      # ثبّت حزمة جاهزة (كـ apt install)
pkg search editor      # ابحث في المستودع
pkg update             # حدّث فهرس المستودع
pkg upgrade            # رقِّ كلّ المثبَّت
pkg info               # اعرض المثبَّت
pkg delete nginx       # احذف
```

#define("pkg", [
  مدير الحزم الثنائيّة في FreeBSD: يجلب برامجَ مُصرَّفةً جاهزةً من مستودعٍ رسميّ ويثبّتها بسرعة، تمامًا كما يفعل `apt` في دبيان. هو الطريق المعتاد للاستعمال اليوميّ.
])

الطريق الثاني هو *شجرة ports*، وهنا يفترق عالمُ BSD عن أغلب لِينُكس. الـ ports شجرةُ مجلّداتٍ ضخمةٌ في `/usr/ports`، فيها «وصفةُ» بناءٍ لكلّ برنامجٍ من *شِفرته المصدريّة* على جهازك أنت، بخياراتٍ تختارها بنفسك:

```sh
cd /usr/ports/www/nginx
make install clean     # نزّل المصدر، صرِّفه، ثبّته، نظّف
```

#define("شجرة ports", [
  مجموعةٌ منظَّمةٌ من «وصفات» البناء في `/usr/ports`، تُصرِّف كلَّ برنامجٍ من مصدره على جهازك مع إمكان تخصيص خياراته وقت البناء. تمنحك تحكّمًا كاملًا، مقابل وقتِ تصريفٍ أطول. حزمُ `pkg` الجاهزة تُبنى أصلًا من هذه الشجرة نفسها.
])

فأنت أمام مقايضةٍ واضحة: `pkg` سريعٌ وجاهز، و `ports` أبطأُ لكنه يمنحك خياراتِ بناءٍ لا يمنحها الثنائيّ الجاهز. والجميل أنّ الاثنين وجهان لعملةٍ واحدة: المستودع الثنائيّ لـ `pkg` مبنيٌّ من شجرة `ports` ذاتها.

#table(
  columns: (auto, auto, auto),
  align: (x, y) => if x == 0 { right + horizon } else { center + horizon },
  table.header([المهمّة], [دبيان/أوبونتو], [FreeBSD]),
  [تثبيت],   [`apt install nginx`], [`pkg install nginx`],
  [بحث],     [`apt search x`],      [`pkg search x`],
  [تحديث الفهرس], [`apt update`],   [`pkg update`],
  [ترقية الكلّ],  [`apt upgrade`],  [`pkg upgrade`],
  [حذف],     [`apt remove nginx`],  [`pkg delete nginx`],
  [بناء من المصدر], [نادرًا],        [`make install clean` في `ports`],
)

#distro[
  كلُّ أخٍ في العائلة وأداتُه. في *OpenBSD* الحزمُ الثنائيّة عبر `pkg_add nginx` (لا `pkg install`). وفي *NetBSD* المنظومةُ اسمها `pkgsrc` وأداتُها الثنائيّة `pkgin install nginx`. الفكرة واحدة، والاسمُ يتبدّل من بيتٍ إلى بيت.
]

#try-it[
  هذا يحتاج نظام FreeBSD فعليًّا (جهازٌ ظاهريّ يكفي). بعد التثبيت، نفّذ `pkg search shell` وتأمّل القائمة، ثم `pkg install bash` — نعم، `bash` نفسها ليست الصدفةَ الافتراضيّة هنا، بل تُثبَّت حزمةً. هذه أوّل مفاجأةٍ لقادمٍ من لِينُكس: كثيرٌ ممّا تحسبه بديهيًّا في لِينُكس هو في BSD إضافةٌ اختياريّة.
]

#section[الخدمات: rc.d و rc.conf بدل systemd]

في الفصول السابقة صار `systemctl start nginx` عادةً في أصابعك. في FreeBSD لا وجود لـ systemd أصلًا؛ بل نظامُ إقلاعٍ أعرقُ وأبسطُ اسمه *rc.d*، يقوم على سكربتاتِ صدفةٍ صريحة، لا على وِحداتٍ ثنائيّة. وكلُّ إعداداتِ ما يُقلَع مع النظام تُجمَع في ملفٍّ نصيٍّ واحدٍ سهلِ القراءة: `/etc/rc.conf`.

#define("‏rc.d‏", [
  نظام إقلاع BSD التقليديّ: مجموعةُ سكربتاتِ صدفةٍ في `/etc/rc.d` و `/usr/local/etc/rc.d`، تُدير تشغيل الخدمات وإيقافها. بسيطٌ وشفّاف — كلُّ خدمةٍ سكربتٌ يمكنك قراءتُه — بديلًا عن systemd في لِينُكس.
])

#define("‏/etc/rc.conf‏", [
  الملفّ النصيّ المركزيّ الذي يقرّر أيّ الخدمات تُقلَع مع النظام وبأيّ إعدادات. تفعيلُ خدمةٍ دائمةٍ يعني ببساطة إضافةَ سطرٍ مثل `nginx_enable="YES"` فيه.
])

لتشغيل خدمةٍ الآن تستعمل الأمر `service`، ولجعلها تُقلع مع النظام تضيف سطرًا إلى `rc.conf` — لكن لا تحرّره بيدك، بل استعمل `sysrc` الذي يعدّله بأمان:

```sh
sysrc nginx_enable="YES"   # فعّلها عند الإقلاع (يكتب في rc.conf)
service nginx start        # شغّلها الآن
service nginx status       # اعرض حالتها
service nginx restart      # أعد تشغيلها
```

#table(
  columns: (auto, auto),
  align: (x, y) => if x == 0 { right + horizon } else { center + horizon },
  table.header([لِينُكس (systemd)], [FreeBSD (rc.d)]),
  [`systemctl start nginx`],   [`service nginx start`],
  [`systemctl stop nginx`],    [`service nginx stop`],
  [`systemctl status nginx`],  [`service nginx status`],
  [`systemctl enable nginx`],  [`sysrc nginx_enable="YES"`],
  [`systemctl disable nginx`], [`sysrc nginx_enable="NO"`],
)

#note[
  انتبه إلى الفرق المفهوميّ، لا اللفظيّ فقط. في systemd «التشغيل الآن» و «التفعيل عند الإقلاع» أمرانِ متمايزان (`start` مقابل `enable`). في rc.d كذلك تمامًا: `service ... start` يشغّل اللحظةَ، و `sysrc ..._enable="YES"` يقرّر الإقلاع. الفصلُ بين المعنيين واحدٌ في العالمين؛ الأسماءُ فقط تختلف.
]

#distro[
  في *OpenBSD* أداةٌ ألطف تجمع الوظيفتين: `rcctl`. فـ `rcctl enable nginx` يفعّلها عند الإقلاع، و `rcctl start nginx` يشغّلها الآن، و `rcctl start`/`enable` تغنيك عن تحرير أيّ ملفّ. إنها أنظفُ واجهةٍ للخدمات في العائلة كلّها.
]

#try-it[
  على لِينُكس الآن، وازِن بنفسك: نفّذ `systemctl cat sshd` (أو `ssh`) واقرأ وِحدةَ systemd المنسّقة. ثم تخيّل مقابلها في BSD: سكربتُ صدفةٍ نصيٌّ صريحٌ في `/etc/rc.d/sshd` تقرؤه سطرًا سطرًا. أيُّهما أوضحُ لك؟ لا جوابَ صحيحًا واحدًا — والخلاف بينهما من أعرق خلافات المجتمع.
]

#section[الجدار الناريّ: pf]

في لِينُكس مررت بـ `iptables` أو `nftables` لضبط الجدار الناريّ. في عالم BSD المعيارُ أداةٌ أخرى، تُعدّ من أنظف ما صُمّم في هذا الباب: *pf* (اختصار Packet Filter)، وُلدت في OpenBSD ثم انتقلت إلى بقيّة العائلة، بل إلى macOS نفسه.

#define("pf", [
  الجدار الناريّ الأصيل في BSD (Packet Filter): يُرشّح حزم الشبكة بقواعدَ تُكتب بلغةٍ قريبةٍ من اللغة الطبيعيّة في ملفّ `/etc/pf.conf`، وتُدار بأداة `pfctl`. يُشتهر بوضوح قواعده مقارنةً بـ iptables.
])

قوّة `pf` في أنّ قواعده تُقرأ كالجُمَل. هذا ملفُّ `pf.conf` مبسَّطٌ يمنع كلَّ وارد، ويسمح بالصادر، ويفتح فقط منافذَ الاتصال الآمن والوِب:

```sh
# /etc/pf.conf
block in all
pass out all keep state
pass in proto tcp to port { ssh http https }
```

لاحظ كلمة `block` و `pass` الصريحتين، والمجموعة `{ ssh http https }` التي تفهمها الأداةُ بأسماء الخدمات لا بأرقامها. بعد الكتابة تُحمِّل القواعد وتفعّل الجدار هكذا:

```sh
pfctl -f /etc/pf.conf   # حمّل القواعد من الملفّ
pfctl -e                # فعّل pf (‏‎-d‎ لتعطيله)
pfctl -sr               # اعرض القواعد الفعّالة الآن
```

ولجعله يقلع مع النظام، عدنا إلى درسنا السابق: `sysrc pf_enable="YES"`.

#warn[
  إن كنت متّصلًا بخادمٍ بعيدٍ عبر `ssh`، فقاعدةٌ خاطئةٌ في `pf` قد تقطع اتّصالك بنفسك وتقفلك خارج جهازك. القاعدة الذهبيّة: تأكّد دائمًا أنّ منفذ `ssh` مسموحٌ به *قبل* تفعيل الجدار على خادمٍ لا تجلس أمامه فيزيائيًّا. وجود سطرٍ يفتح `ssh` في المثال أعلاه ليس تفصيلًا؛ إنه طوقُ نجاتك.
]

#section[العزل: jails — الحاويات قبل الحاويات]

في لِينُكس تسمع كثيرًا عن الحاويات (Docker وأمثاله). ما لا يعرفه كثيرون أنّ الفكرة سبقت لِينُكس في بيت BSD بسنوات، باسمٍ آخر: *jails* (السجون). قدّمها FreeBSD عام ٢٠٠٠، لتعزل بيئةً كاملةً — عمليّاتٍ وملفّاتٍ وشبكةً — عن بقيّة النظام، فتشغّل داخل خادمٍ واحدٍ عدّةَ «خوادمَ» منفصلةٍ لا يرى أحدُها الآخر.

#define("jail", [
  آليّةُ عزلٍ في FreeBSD تحبس مجموعةً من العمليّات في بيئةٍ مستقلّةٍ لها نظامُ ملفّاتها وعنوانُها الشبكيّ ومستخدمُها الجذر الخاصّ، دون أن تمسّ بقيّة النظام. هي سلفُ فكرة الحاويات، أقوى من `chroot` وأخفُّ من الجهاز الظاهريّ الكامل.
])

تُعرَّف السجون في ملفّ `/etc/jail.conf`. هذا تعريفٌ مصغَّرٌ لسجنٍ اسمه `web`:

```sh
# /etc/jail.conf
web {
    host.hostname = "web.local";
    ip4.addr      = "192.168.1.10";
    path          = "/jails/web";
}
```

ثم تديره بأوامرَ مألوفةِ الروح:

```sh
service jail start web    # شغّل السجن
jls                       # اعرض السجون العاملة
jexec web sh              # ادخل إليه بصدفةٍ في داخله
```

#note[
  الفرق الفلسفيّ عن Docker مفيد: حاويات لِينُكس بُنيت بلصق تقنيّاتٍ منفصلة (namespaces و cgroups) أضيفت إلى النواة تباعًا. أمّا `jails` فصُمّمت ميزةً واحدةً متماسكةً في قلب النظام منذ البداية. ولمن يريد راحةَ أدوات Docker فوق قوّة jails، ثمّة أطرٌ حديثةٌ مثل `bastille` و `iocage` تبسّط إدارتها.
]

#try-it[
  هذا يحتاج FreeBSD فعليًّا. جرّب أبسط عزلٍ يشبه روح jails ولو على لِينُكس: أنشئ مجلّدًا ونفّذ فيه `chroot`. ستلمس فكرة «حبس عمليّةٍ في جزءٍ من الشجرة». ثم تخيّل `jail` وقد أضاف إلى هذا الحبسِ عزلَ الشبكة والعمليّات والمستخدمين — تلك هي القفزة.
]

#section[أدوات BSD مقابل GNU: الشيطان في الرايات]

أخطرُ ما يفاجئ القادمَ من لِينُكس ليس الأوامرَ الغريبة، بل الأوامرَ *المألوفة* التي تتصرّف تصرّفًا مختلفًا قليلًا. أدواتُ لِينُكس اليوميّة (`ls`، `sed`، `grep`...) هي من مشروع GNU: أُعيد بناؤها بميزاتٍ وفيرةٍ وخياراتٍ طويلة. أمّا أدوات BSD فتنحدر من يونِكس الأصليّ: أقلُّ ميزاتٍ، وأقربُ إلى المعيار، وبراياتٍ تختلف في التفاصيل. والخلط بينها مصدرُ أخطاءٍ صامتةٍ في السكربتات.

#table(
  columns: (auto, auto, auto),
  align: (x, y) => if x == 0 { right + horizon } else { center + horizon },
  table.header([المهمّة], [GNU (لِينُكس)], [BSD (‏FreeBSD/ماك‏)]),
  [تلوين `ls`],       [`ls --color=auto`], [`ls -G`],
  [تعديل ملفٍّ بمكانه], [`sed -i '...'`],   [`sed -i '' '...'`],
  [تاريخُ الغد],      [`date -d tomorrow`], [`date -v+1d`],
  [مسارٌ مُطلق لرابط], [`readlink -f x`],   [`realpath x`],
)

انظر إلى السطر الثاني خاصّةً، فهو أشهرُ مصيدة: `sed -i` في GNU يعدّل الملفّ في مكانه مباشرة. أمّا في BSD وmacOS فالرايةُ `-i` *تشترط* لاحقةَ نسخةٍ احتياطيّة بعدها، ولو فارغة. فإن نسيتَ العلامتين `''` انهار الأمر برسالة خطأ، أو — أسوأُ — عبثَ بالملفّ التالي في سطرك ظنًّا أنه اللاحقة:

```sh
sed -i    's/foo/bar/' f.txt   # GNU: ينجح.  BSD: يفشل أو يخطئ!
sed -i '' 's/foo/bar/' f.txt   # BSD/ماك: الصواب — لاحقة فارغة صريحة
```

#define("‏Darwin‏", [
  الأساس المفتوح لنظام macOS من آبل. نواتُه (XNU) وأدواتُه في سطر الأوامر مبنيّةٌ إلى حدٍّ كبيرٍ على FreeBSD. لهذا فإنّ طرفيّة الماك في جوهرها بيئةُ BSD؛ ورخصةُ BSD المتساهلة هي ما سمح لآبل بذلك.
])

#note[
  هذه ليست نظريّةً بعيدة: إن كان لديك جهاز ماك، فأنت تحمل BSD في جيبك. طرفيّة macOS تشغّل أدوات BSD ذاتها، لا GNU. ولهذا يلجأ كثيرٌ من مطوّري الماك إلى مدير الحزم الخارجيّ `brew` (Homebrew) لتثبيت نسخ GNU: `brew install coreutils gnu-sed` يجلب `gls` و `gsed` بأسمائها مسبوقةً بحرف `g`. وإدارةُ الخدمات هناك ليست `systemctl` ولا `service`، بل `launchctl` فوق نظام `launchd` الخاصّ بآبل — وله فصلُه القادم.
]

#warn[
  إذا نسخت سكربتًا كُتب على لِينُكس وشغّلته على BSD أو ماك، فلا تتعجّب إن انهار عند `sed` أو `date` أو `readlink`. المشكلة غالبًا ليست في منطقك، بل في رايةٍ تعني في GNU غير ما تعنيه في BSD. عند الشكّ، افتح `man` الأداةِ *على النظام الذي تشغّل عليه*، لا على لِينُكس.
]

#section[التثبيت ومتى تختار BSD]

يُثبَّت FreeBSD بمثبِّتٍ نصيٍّ بسيطٍ اسمه *bsdinstall*: قوائمُ نصيّةٌ بالأسهم و #kbd("Enter")، تسألك عن القرص والشبكة والمستخدم، بلا واجهةٍ رسوميّةٍ مزخرفة — يشبه في روحه مثبّت دبيان النصيّ لا مثبّتَ أوبونتو الرسوميّ.

#define("bsdinstall", [
  المثبِّت النصيّ الرسميّ لـ FreeBSD: يقودك عبر قوائمَ بسيطةٍ لتقسيم القرص وإعداد الشبكة والمستخدمين وتفعيل الخدمات الأولى. صريحٌ ومباشر، على عادة BSD في تفضيل الوضوح على الزخرفة.
])

يبقى السؤال الأهمّ: متى تختار BSD أصلًا وأنت تعرف لِينُكس؟ الجواب في الميدان:

- *خادمٌ يحتاج أعلى أداءِ شبكةٍ وثباتًا طويل الأمد* — فكّر في FreeBSD؛ فبنيتُه الموحّدة ونظامُ ملفّاته ZFS الأصيل خيارٌ متينٌ للتخزين والبثّ.
- *نظامٌ الأمنُ فيه فوق كلّ اعتبار* — OpenBSD؛ يُدقَّق بصرامةٍ ويأتي مقفلًا افتراضيًّا، بأقلّ ما يمكن من خدماتٍ مفتوحة.
- *عتادٌ قديمٌ أو معماريّةٌ نادرة* — NetBSD؛ يُقلع حيث يتعثّر غيرُه.
- *ترخيصٌ متساهلٌ لمنتجٍ تجاريٍّ مغلق* — رخصة BSD تتيح ما لا تتيحه GPL.

#note[
  وفي المقابل: يبقى لِينُكس أوسعَ دعمًا للعتاد الحديث (خاصّةً بطاقات الرسوميّات وحواسيب سطح المكتب)، وأغزرَ برمجيّاتٍ جاهزة، وأكبرَ مجتمعًا. اختيارُ BSD قرارُ ميدانٍ مدروس، لا موضةٌ ولا تعصّب. أفضلُ المهندسين يعرف الأسرتين، ويختار لكلّ مهمّةٍ أهلَها.
]

#section[خلاصة الفصل]

اكتشفت أنّ للِينُكس عائلةً شقيقة: BSD، المنحدرةُ مباشرةً من يونِكس بِركلي، حيث وُلد `TCP/IP` و `vi` و `OpenSSH`. وعرفت الفرق الجوهريّ: BSD *نظامٌ واحدٌ متكامل* (نواةٌ وأدواتٌ معًا برخصةٍ متساهلة)، لا نواةً ملفوفةً بأدوات GNU. وميّزت القبائل الخمس: FreeBSD للخوادم، وOpenBSD للأمن، وNetBSD للنقل، وGhostBSD لسطح المكتب، وDragonFly. ثم لمست الفروق اليوميّة عمّا اعتدته: `pkg` وشجرة `ports` بدل `apt`، ونظام `rc.d` مع `/etc/rc.conf` و `service` و `sysrc` بدل systemd، والجدار `pf` بقواعده الواضحة بدل iptables، والعزل عبر `jails` سلفِ الحاويات، ومثبّت `bsdinstall` النصيّ. وأخيرًا حذّرت نفسك من الشيطان الكامن في الرايات: `sed -i` و `date` و `ls` تتصرّف في BSD غيرَ ما تتصرّف في GNU — وأنّ ماك نفسه بيتُ BSD في جيبك، وهو موضوعُ فصلنا التالي.

