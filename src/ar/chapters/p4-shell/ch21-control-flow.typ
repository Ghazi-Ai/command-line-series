#chapter[التحكّم بالتدفّق]

#objectives((
  [تفهم «حالة الخروج»، وكيف يبني عليها كلُّ قرارٍ في الصدفة حكمَه.],
  [تكتب الجملة الشرطية `if`/`elif`/`else` وتغلقها بـ `fi`، فتفرّع مسار سكربتك.],
  [توازن الأعداد والنصوص، وتفحص وجود الملفّات، بأمر الاختبار `[ ]` و`[[ ]]`.],
  [تختصر التفرّعات الكثيرة بجملة `case` الأنيقة.],
  [تكرّر العمل بحلقات `for` و`while` و`until`، وتتحكّم بمسارها بـ `break` و`continue`.],
))

سكربتاتُك حتى الآن تسير في خطٍّ مستقيمٍ كقطارٍ على سكّةٍ واحدة: تبدأ من أعلى الملفّ، وتنفّذ سطرًا بعد سطر، حتى تبلغ آخره. لا مفترقاتٍ ولا دوران. لكنّ العملَ الحقيقيَّ مليءٌ بالمفترقات: «إن كان الملفّ موجودًا فافتحه، وإلّا فأنشئه»، «كرّر هذا على كلِّ صورةٍ في المجلّد». تخيّل سائقًا يقف عند إشارةٍ ضوئيّة: يقرأ اللون، فيقرّر أن يقف أو يمضي؛ ويدور في الميدان مرّةً بعد مرّةٍ حتى يجد مخرجه. هذا هو *التحكّم بالتدفّق*: أن نمنح السكربتَ عينين يقرأ بهما الموقف، وعقلًا يقرّر، وقدمين تكرّران. وبه يتحوّل من قائمةِ أوامرَ صمّاء إلى برنامجٍ يفكّر.

#section[أساسُ كلِّ قرار: حالة الخروج]

قبل أن يقرّر السكربتُ شيئًا، يحتاج أن يعرف: هل نجح ما قبله أم فشل؟ ولحسن الحظّ، كلُّ أمرٍ في لِينُكس — حين ينتهي — يترك خلفه رقمًا صغيرًا يخبر عن مصيره. هذا الرقم اسمه *حالة الخروج*.

#define("حالة الخروج (Exit status)", [
  رقمٌ بين 0 و255 يتركه كلُّ أمرٍ حين ينتهي، يخبر هل نجح أم فشل. القاعدة تبدو مقلوبةً لكنها ثابتة: *الصفر يعني النجاح*، وأيُّ رقمٍ غيرِه يعني فشلًا (أو نوعًا من الفشل). تجد حالةَ آخر أمرٍ في المتغيّر الخاصّ `$?`.
])

لماذا الصفر نجاح؟ لأنّ النجاح واحدٌ لا يتعدّد («تمّ»)، أمّا الفشل فأنواعٌ كثيرة (لم يُوجد الملفّ، رُفض الإذن، خطأ في الصياغة...)، فخُصِّص الصفرُ للنجاح، وتُرِكت بقيّةُ الأرقام لتمييز أصناف الفشل. لنرَ ذلك بأعيننا عبر المتغيّر `$?`:

```bash
ls /etc
echo $?          # يطبع 0 — نجح الأمر

ls /لا-يوجد
echo $?          # يطبع رقمًا غير الصفر — فشل الأمر
```

جرّبها الآن: بعد أمرٍ ناجحٍ يطبع `echo $?` صفرًا، وبعد أمرٍ فاشلٍ يطبع رقمًا آخر (غالبًا 1 أو 2). هذا الرقمُ الخفيُّ هو الحجرُ الذي يُبنى عليه كلُّ ما يأتي في هذا الفصل: فالجملةُ الشرطية لا «تفهم» كلامَك، بل تنظر إلى حالة الخروج لا غير.

#note[
  حالةُ الخروج تخصُّ آخرَ أمرٍ نُفِّذ فقط. فإن أردتَ فحصها، افحصها فورًا في السطر التالي؛ لأنّ أيَّ أمرٍ جديدٍ — ولو كان `echo` — يكتب حالتَه هو فوق القديمة.
]

#section[الجملة الشرطية: if و then و fi]

الآن نبني أوّل مفترق. *الجملةُ الشرطية* تسأل سؤالًا نعم/لا، فإن كان الجواب «نعم» نفّذت كتلةً من الأوامر، وإلّا تخطّتها.

#define("الجملة الشرطية (if)", [
  بنيةٌ تنفّذ أمرًا (الشرط)، فإن كانت حالةُ خروجه صفرًا (نجاحًا) نفّذت الأوامرَ التي بين `then` و`fi`؛ وإلّا تجاوزتها. تُفتَح بـ `if` وتُغلَق دائمًا بـ `fi` (وهي `if` مقلوبة).
])

أبسطُ صورةٍ لها:

```bash
#!/bin/bash
if mkdir مشروع
then
  echo "أُنشئ المجلّد بنجاح"
fi
```

اقرأها كجملةٍ عربيّة: «*إنْ* (`if`) نجح إنشاءُ المجلّد، *فحينئذٍ* (`then`) اطبع رسالة النجاح، *انتهى الشرط* (`fi`)». ما يجري تحت الغطاء: تنفّذ الصدفةُ الأمرَ `mkdir مشروع`، وتنظر إلى حالة خروجه؛ فإن كانت صفرًا (نجح الإنشاء) دخلت كتلة `then`، وإن كانت غير صفرٍ (فشل، كأن يكون المجلّد موجودًا أصلًا) قفزت مباشرةً إلى ما بعد `fi` دون أن تطبع شيئًا.

لاحظ ثلاثة أركانٍ لا بدّ منها: كلمة `if` تفتح، وكلمة `then` تسبق كتلة العمل، وكلمة `fi` تُغلق. ويمكن — إن شئت الاختصار — أن تجمع `if` و`then` في سطرٍ واحدٍ بفاصلةٍ منقوطة: `if mkdir مشروع; then`. الفاصلةُ المنقوطة تقوم مقام نهاية السطر.

#warn[
  نسيانُ `fi` من أشيع أخطاء المبتدئين. كلُّ `if` يجب أن تُقابلها `fi` تغلقها، تمامًا كما يُغلَق كلُّ قوسٍ فُتِح. إن نسيتَها، انتظرت الصدفةُ بقيّةَ الجملة ولم تنفّذ شيئًا، أو شكت من «نهايةٍ غير متوقّعة».
]

لكنّ الشروط النافعة نادرًا ما تكون أمرًا كـ `mkdir`؛ نريد غالبًا أن نسأل عن قيمةٍ: هل هذا العددُ أكبر؟ هل هذا النصُّ يساوي ذاك؟ هل الملفُّ موجود؟ لهذا وُجِد *أمرُ الاختبار*.

#section[أمر الاختبار: القوسان المربّعان [ ]]

كيف نحوّل سؤالًا مثل «هل ٥ أكبر من ٣؟» إلى أمرٍ له حالةُ خروج؟ الجواب أداةٌ اسمها `test`، ولها وجهٌ أجملُ وأشهرُ هو القوسان المربّعان `[ ]`.

#define("أمر الاختبار ([ ])", [
  أمرٌ يقيّم شرطًا منطقيًّا، فيخرج بالحالة 0 إن كان الشرط صحيحًا، وبغيرها إن كان خاطئًا. `[` ليس رمزًا بل *اسمُ أمرٍ* حقيقيّ (مرادفٌ لـ `test`)، ولذلك يجب أن يُحاط بمسافاتٍ من الجانبين، وأن يُختَم بقوسٍ مغلقٍ `]`.
])

هذه أدقُّ نقطةٍ في الفصل، فتأمّلها: لأنّ `[` أمرٌ مستقلّ، فإنّ ما بعده *مُعطياتٌ* له، والمُعطياتُ تُفصَل بالمسافات. فهذه الجملةُ صحيحة:

```bash
#!/bin/bash
if [ 5 -gt 3 ]
then
  echo "خمسة أكبر من ثلاثة"
fi
```

بينما `[5 -gt 3]` بلا مسافاتٍ خطأٌ فادح؛ إذ تراها الصدفةُ كلمةً واحدةً `[5` فلا تجد أمرًا بهذا الاسم. القاعدةُ الحديديّة: *مسافةٌ بعد `[` ومسافةٌ قبل `]`* بلا استثناء. الرمز `-gt` (من greater than) يعني «أكبر من». ولنتعرّف الآن على عائلة المقارنات.

#subsection[موازنة الأعداد]

لموازنة عددين بعضِهما ببعض، تستعمل هذه الرموز الستّة (كلُّها من أوائل حروف معانيها الإنجليزية):

```text
-eq   يساوي        (equal)
-ne   لا يساوي     (not equal)
-lt   أصغر         (less than)
-le   أصغر أو يساوي (less or equal)
-gt   أكبر         (greater than)
-ge   أكبر أو يساوي (greater or equal)
```

مثالٌ عمليّ يسأل المستخدمَ عن عمره ويحكم عليه:

```bash
#!/bin/bash
read -p "كم عمرك؟ " age
if [ "$age" -ge 18 ]
then
  echo "أنت راشد"
fi
```

سيّجنا `"$age"` بالاقتباس المزدوج عمدًا: فلو ضغط المستخدمُ #kbd("Enter") دون أن يكتب شيئًا، صار المتغيّرُ فارغًا، ولولا الاقتباسُ لانهار الشرطُ برسالة خطأٍ غامضة. الاقتباسُ يجعل الفراغَ يبقى مُعطًى واحدًا (فارغًا) لا عدمًا.

#warn[
  رموزُ الأعداد الستّة *للأعداد فقط*. فلا تكتب `[ "$age" > 18 ]` ظنًّا أنّ `>` تعني «أكبر»؛ فداخل `[ ]` تُفهَم `>` على أنها *إعادةُ توجيهٍ* لملفّ، فتُنشئ ملفًّا اسمه `18` وتُفسِد شرطَك صامتةً. للأعداد استعمل `-gt` و`-lt` لا `>` و`<`.
]

#subsection[موازنة النصوص]

النصوصُ لها رموزُها هي الأخرى:

```text
=     يتساوى النصّان        (مثال: [ "$a" = "$b" ])
!=    يختلف النصّان
-z    النصّ فارغ (طوله صفر)  (z من zero)
-n    النصّ غير فارغ
```

مثالٌ يفحص كلمة سرٍّ بسيطة:

```bash
#!/bin/bash
read -p "الكلمة السرّيّة: " pass
if [ "$pass" = "سمسم" ]
then
  echo "افتح يا سمسم!"
fi
```

انتبه إلى فرقٍ يخلط بين الاثنين: علامةُ يساوي *واحدة* `=` هنا معناها «هل النصّان متساويان؟» (موازنة)، وهي غيرُ علامة الإسناد في `name=قيمة` التي رأيتَها في الفصل السابق (وتلك بلا مسافاتٍ حولها). هنا نحن داخل `[ ]` نوازن، فالمسافاتُ حول `=` مطلوبة.

والرمز `-z` نافعٌ جدًّا للتحقّق من أنّ المستخدم أدخل شيئًا فعلًا:

```bash
#!/bin/bash
read -p "ما اسمك؟ " name
if [ -z "$name" ]
then
  echo "لم تُدخل اسمًا!"
fi
```

يُقرأ الشرطُ: «إن كان `$name` فارغًا (`-z`)، فنبّه المستخدم».

#try-it[
  اكتب سكربتًا يسأل المستخدمَ عن درجته في اختبار (من 100)، فإن كانت 60 أو أكثر (`-ge 60`) طبع «ناجح». جرّبه بدرجاتٍ مختلفة. ثم أضِف شرطًا ثانيًا منفصلًا يطبع «علامة كاملة!» إذا ساوت الدرجةُ 100 بالضبط (`-eq 100`).
]

#subsection[فحص الملفّات والمجلّدات]

كثيرًا ما يحتاج السكربتُ أن يسأل عن ملفّ: أموجودٌ هو؟ أملفٌّ هو أم مجلّد؟ لهذا رموزٌ خاصّة تأخذ مسارًا واحدًا:

```text
-e   الشيء موجود، أيًّا كان نوعه   (e من exists)
-f   موجودٌ وهو ملفٌّ عاديّ        (f من file)
-d   موجودٌ وهو مجلّد             (d من directory)
```

مثالٌ يتحقّق قبل أن يعمل:

```bash
#!/bin/bash
if [ -f "$HOME/.bashrc" ]
then
  echo "ملفّ إعداداتك موجود"
else
  echo "لا يوجد ملفّ إعدادات"
fi
```

(استعملنا `else` هنا استباقًا؛ وسنفصّلها بعد قليل، ومعناها بديهيّ: «وإلّا».) هذا النمط — «افحص قبل أن تعمل» — من أنفع عادات كتابة السكربتات: لا تفتح ملفًّا حتى تتأكّد أنه موجود، ولا تنشئ مجلّدًا حتى تتأكّد أنه غير موجود.

#tip[
  اجمع بين `-d` والنفي لتُنشئ مجلّدًا فقط إن لم يكن موجودًا. النفي في `[ ]` رمزُه تعجّبٌ `!` قبل الشرط: `if [ ! -d "$dir" ]` تعني «إن لم يكن `$dir` مجلّدًا موجودًا». لاحظ المسافات حول `!` أيضًا.
]

#section[القوسان المزدوجان [[ ]]: صيغةٌ أذكى]

للـ `[ ]` أخٌ أحدثُ وأقوى في bash هو `[[ ]]` (قوسان مربّعان مزدوجان). يفعل كلَّ ما يفعله القديم، ويزيد عليه أمانًا وراحة.

#define("الاختبار المزدوج ([[ ]])", [
  صيغةُ اختبارٍ خاصّةٌ بـ bash (وليست في كلّ الصَدفات)، أذكى من `[ ]`: لا تنكسر إن كان المتغيّرُ فارغًا أو فيه مسافات، وتفهم أدوات الربط `&&` (و) و`||` (أو) مباشرةً داخلها، وتقبل `<` و`>` لموازنة النصوص بلا لبس.
])

أوضحُ فوائدها أنها تجمع شرطين بأداة الربط `&&` (تعني «و») أو `||` (تعني «أو») في جملةٍ واحدة:

```bash
#!/bin/bash
read -p "أدخل عددًا: " n
if [[ "$n" -ge 1 && "$n" -le 10 ]]
then
  echo "العدد بين 1 و10"
fi
```

قرأتُها: «إن كان `$n` أكبرَ أو يساوي 1 *و* أصغرَ أو يساوي 10». بالـ `[ ]` القديمة كان هذا يحتاج حِيلةً أعقد؛ أمّا `[[ ]]` فتفهم `&&` في صميمها. لأجل هذه الراحة والأمان، *نوصيك في سكربتات bash أن تعتمد `[[ ]]` افتراضيًّا*، وتحتفظ بـ `[ ]` لموضعٍ سنذكره.

#warn[
  القوسان المزدوجان `[[ ]]` ميزةٌ في bash تحديدًا، وليست في صدفة `sh` الأساسيّة الموجودة على كلّ نظام. فما دام سطرُ صدارتك `#!/bin/bash` فأنت في أمان. لكن لو نقلتَ السكربت إلى نظامٍ يشغّله بـ `/bin/sh`، فالتزم `[ ]` القديمة لأنها المعياريّة في كلّ مكان.
]

#section[التفرّع الكامل: elif و else]

حتى الآن سؤالُنا نعم/لا بمسارٍ واحد. لكنّ الحياة أكثرُ من احتمالين. لهذا نضيف طرفين: `else` («وإلّا») لمسارٍ يُسلَك حين يفشل الشرط، و`elif` (اختصار else if، «وإلّا إن») لطرح سؤالٍ آخرَ إذا فشل الأوّل. بهما نبني سُلَّمًا من الاحتمالات تُفحَص واحدًا تلو الآخر، فيُنفَّذ *أوّلُ* ما يصدق منها لا غير.

```bash
#!/bin/bash
read -p "أدخل درجتك (من 100): " grade
if [ "$grade" -ge 90 ]
then
  echo "ممتاز"
elif [ "$grade" -ge 75 ]
then
  echo "جيّد جدًّا"
elif [ "$grade" -ge 60 ]
then
  echo "مقبول"
else
  echo "راسب"
fi
```

تتبّع المنطق بدرجة 82: يفشل الشرطُ الأوّل (ليست 90 فأكثر)، فيُطرَح الثاني (75 فأكثر؟ نعم)، فيُطبع «جيّد جدًّا»، ثم *تُتخطّى بقيّةُ السُّلَّم كلُّها* — لأنّ أوّل شرطٍ صادقٍ يحسم الأمر. لهذا رتّبنا الشروطَ من الأعلى إلى الأدنى: لو بدأنا بـ 60 لصدَقت على الدرجات العالية أيضًا وأخطأنا الحكم. أمّا `else` في القاع فمظلّةٌ تلتقط كلَّ ما لم يصدق عليه شرطٌ قبلها.

#note[
  الترتيب: `if` أوّلًا (مرّةً واحدة)، ثم `elif` بقدر ما تشاء (صفرًا أو أكثر)، ثم `else` أخيرًا (مرّةً واحدةً على الأكثر، وهي اختياريّة)، ثم `fi` تُغلق الجميع. لا تحتاج `then` بعد `else` (فهو مسارٌ لا شرطَ فيه)، لكنك تحتاجها بعد كلّ `elif`.
]

#try-it[
  اكتب سكربتًا يسأل عن الوقت الحاليّ بالساعة (رقمًا من 0 إلى 23) عبر `read`، ثم يحيّي المستخدم: «صباح الخير» إن كانت أقلَّ من 12، و«مساء الخير» إن كانت أقلَّ من 18، و«ليلة سعيدة» فيما عدا ذلك. استعمل `if` و`elif` و`else`.
]

#section[جملة case: حين تكثر الاحتمالات]

حين تفحص *قيمةً واحدةً* في مقابل قيمٍ كثيرةٍ محدّدة، يصير سُلَّمُ `elif` طويلًا مُتعِبًا. لهذه الحالة بالذات وُجِدت جملةٌ أنيقة اسمها `case`: تأخذ قيمةً وتطابقها بأنماطٍ مرتّبة، فتنفّذ ما يوافق أوّلَ نمطٍ يطابقها.

#define("جملة case", [
  بنيةُ تفريعٍ تطابق قيمةً واحدةً بعدّة أنماطٍ محتملة، وتنفّذ الكتلةَ المرتبطة بأوّل نمطٍ يوافقها. تُفتَح بـ `case ... in`، وكلُّ فرعٍ نمطٌ يتبعه قوسٌ `)` ثم أوامرُه ثم فاصلتان منقوطتان `;;`، وتُغلَق كلُّها بـ `esac` (وهي `case` مقلوبة).
])

مثالٌ يفهم جواب المستخدم بنعم أو لا، بعدّة صيغ:

```bash
#!/bin/bash
read -p "أتوافق؟ (y/n) " answer
case "$answer" in
  y|Y|نعم)
    echo "شكرًا لموافقتك"
    ;;
  n|N|لا)
    echo "حسنًا، لا بأس"
    ;;
  *)
    echo "جوابٌ غير مفهوم"
    ;;
esac
```

فكّك الجملة: `case "$answer" in` تفتحُ الفحص على قيمة `$answer`. ثم كلُّ فرعٍ يبدأ بنمطٍ (أو عدّةِ أنماطٍ يفصل بينها `|` بمعنى «أو») يليه قوسٌ `)`. فالفرعُ الأوّل `y|Y|نعم)` يطابق أيًّا من هذه الثلاث. تحت النمط تأتي أوامرُه، ثم *فاصلتان منقوطتان* `;;` تُعلِنان نهاية الفرع (نظيرُ `break`؛ فبدونهما تتسرّب الجملةُ إلى الفرع التالي). والنمطُ الأخير `*)` نجمةٌ تطابق *أيَّ شيء*، فهو شبكةُ الأمان التي تلتقط كلَّ جوابٍ لم توافقه الفروعُ السابقة — كأنه `else` في `case`. وأخيرًا `esac` تُغلق الجملة.

#tip[
  رتّب فروع `case` من الأخصّ إلى الأعمّ، واجعل `*)` آخرَها دائمًا؛ لأنّ المطابقة تتوقّف عند أوّل نمطٍ يوافق. ولو وضعتَ `*)` أوّلًا لالتقط كلَّ شيءٍ وعطّل ما بعده. `case` أوضحُ وأسرعُ من سلسلة `elif` حين تكون المقارنةُ على قيمةٍ واحدةٍ مقابل قيمٍ ثابتة.
]

#try-it[
  اكتب سكربتًا يسأل المستخدم أن يكتب اسم فاكهةٍ، ثم يستعمل `case` ليطبع لونها: «تفاح» ← أحمر، «موز» ← أصفر، «عنب» ← أخضر، وأيُّ شيءٍ آخر ← «لا أعرف لون هذه الفاكهة». لا تنسَ `;;` في كلّ فرعٍ و`*)` في آخرها.
]

#section[حلقة for: كرّر على قائمة]

القرارُ نصفُ التحكّم، والنصفُ الآخر *التكرار*. أوّلُ الحلقات وأكثرُها استعمالًا `for`: تأخذ قائمةً من العناصر، وتنفّذ كتلةً من الأوامر *مرّةً لكلِّ عنصر*، واضعةً العنصرَ الحاليَّ في متغيّرٍ تختاره.

#define("الحلقة (Loop)", [
  بنيةٌ تكرّر تنفيذَ كتلةٍ من الأوامر أكثرَ من مرّة. حلقةُ `for` تكرّرها مرّةً لكلِّ عنصرٍ في قائمةٍ تعطيها إيّاها، وتغلق كتلتها الأوامرُ بين `do` و`done`.
])

أبسطُ مثال:

```bash
#!/bin/bash
for fruit in تفاح موز عنب
do
  echo "أحبّ $fruit"
done
```

يُقرأ: «*لكلِّ* (`for`) عنصرٍ نسمّيه `fruit` *في* (`in`) هذه القائمة، *افعل* (`do`) ما بينها وبين `done`». تدور الحلقةُ ثلاثَ مرّات: في الأولى يحمل `$fruit` قيمة «تفاح»، وفي الثانية «موز»، وفي الثالثة «عنب»، فتُطبَع ثلاثةُ أسطر. الكلمتان `do` و`done` تحدّان جسمَ الحلقة كما حدّت `then`/`fi` جسمَ الشرط.

وإذا أردتَ العدَّ في مجالٍ متتابعٍ من الأرقام، فلا تكتبها يدويًّا؛ استعمل *توسيع الأقواس المعقوفة* `{بداية..نهاية}`:

```bash
#!/bin/bash
for i in {1..5}
do
  echo "التكرار رقم $i"
done
```

الصيغةُ `{1..5}` تتوسّع تلقائيًّا إلى `1 2 3 4 5`، فتدور الحلقةُ خمسَ مرّات. وأقوى استعمالات `for` أن تدور على *ملفّاتٍ* عبر رمز البدل `*`:

```bash
#!/bin/bash
for file in *.txt
do
  echo "وجدتُ الملفّ: $file"
done
```

هنا يتوسّع `*.txt` إلى كلِّ الملفّات النصّيّة في المجلّد الحاليّ، فتعالجها الحلقةُ واحدًا واحدًا. بهذه اللبنة تكتب سكربتاتٍ تعمل على عشرات الملفّات بالجهد نفسه الذي تعمل به على ملفٍّ واحد — وهنا تبدأ الأتمتةُ الحقيقيّة.

#warn[
  توسيعُ الأقواس `{1..5}` يعمل بأرقامٍ *ثابتة* فقط. فلو كتبتَ `{1..$n}` بمتغيّرٍ لم يتوسّع، بل بقي نصًّا حرفيًّا. للعدِّ إلى حدٍّ متغيّرٍ استعمل حلقة `while` التي تأتي بعد قليل، أو صيغةَ `for` الحسابيّة `for ((i=1; i<=n; i++))`.
]

#try-it[
  اكتب سكربتًا يطبع جدول ضرب العدد 7: يدور بـ `for` على `{1..10}`، ويطبع في كلّ دورةٍ حاصلَ ضرب 7 في العدد الحاليّ. (ستحتاج الحساب؛ الأمرُ عليه في القسم التالي: `echo $((7 * i))`.)
]

#section[حلقة while: كرّر ما دام الشرط قائمًا]

بينما تدور `for` على قائمةٍ معلومةِ الطول، تدور `while` («طالما») ما دام *شرطٌ* صادقًا، ولو لم نعرف عددَ الدورات سلفًا. تفحص الشرطَ قبل كلِّ دورة: فإن صدَق دارت، وإن كذَب توقّفت.

لكنّ حلقةً كهذه تحتاج عادةً عدّادًا يتغيّر، وهنا نلتقي أداةً جديدة: *التوسيع الحسابيّ* لإجراء العمليّات الحسابيّة.

#define("التوسيع الحسابيّ ($(( )))", [
  صيغةٌ تحسب تعبيرًا رياضيًّا وتستبدل نفسها بنتيجته. تكتب العمليّة بين `$(( ))`، فتفهم `+` و`-` و`*` و`/` و`%` (باقي القسمة). وداخلها تذكر أسماء المتغيّرات بلا حاجةٍ إلى علامة `$` قبلها.
])

مثالُ العدِّ الكلاسيكيّ:

```bash
#!/bin/bash
count=1
while [ "$count" -le 5 ]
do
  echo "التكرار رقم $count"
  count=$((count + 1))
done
```

تتبّعه بعناية: نبدأ `count` بـ 1. يفحص `while` الشرطَ `[ "$count" -le 5 ]` (أهو أصغرُ أو يساوي 5؟): صادق، فتدور، فتطبع، ثم — وهذا مفتاح النجاة — يزيد السطرُ `count=$((count + 1))` العدّادَ واحدًا. تتكرّر الدورةُ بـ 2 ثم 3 ثم 4 ثم 5، وعند 6 يكذب الشرطُ فتقف الحلقة. لاحظ أنّ `$((count + 1))` حسبت القيمة الجديدة وأسندناها إلى `count` بالإسناد المعتاد (بلا مسافاتٍ حول `=`).

#danger[
  في كلّ حلقة `while` *تأكّد أنّ شيئًا يقرّب الشرطَ من الكذب* — كزيادة العدّاد هنا. فلو نسيتَ سطرَ الزيادة، بقي الشرطُ صادقًا أبدًا، ودارت الحلقةُ إلى ما لا نهاية («حلقةٌ لا نهائيّة») تشلّ طرفيّتك. إن وقعتَ فيها، أوقفها بالضغط على #kbd("Ctrl") + #kbd("C").
]

#note[
  من أجمل استعمالات `while` قراءةُ ملفٍّ سطرًا سطرًا بضمّها إلى الأمر `read` مع إعادة توجيهٍ من الملفّ: `while read line; do ...; done < ملف.txt`. تدور الحلقةُ مرّةً لكلّ سطر، واضعةً إيّاه في `$line`، حتى ينتهي الملفّ. تذكّرها حين تحتاج معالجة ملفٍّ نصيّ.
]

#section[حلقة until: كرّر حتى يصدق الشرط]

`until` («إلى أن») توأمُ `while` المعكوس: تدور ما دام الشرطُ *كاذبًا*، وتتوقّف حين *يصدق*. أي أنها تنتظر حدوثَ شيءٍ بدل أن تستمرّ ما دام قائمًا. نفس عدّادِنا السابق بـ `until`:

```bash
#!/bin/bash
count=1
until [ "$count" -gt 5 ]
do
  echo "$count"
  count=$((count + 1))
done
```

انظر كيف انقلب الشرطُ: بدل `-le 5` («طالما أصغرَ أو يساوي 5») صار `-gt 5` («إلى أن يصير أكبرَ من 5»). النتيجةُ نفسها (طباعة 1 إلى 5)، لكن بمنطقٍ مقلوب. متى تختار أيًّا منهما؟ اختر ما يجعل الشرطَ أقربَ إلى العربية الطبيعيّة: «طالما بقي عملٌ» تناسب `while`، و«انتظر إلى أن يجهز» تناسب `until`. كلاهما يعبّر عن المعنى نفسه، والوضوحُ هو المرجّح.

#section[التحكّم بمسار الحلقة: break و continue]

أحيانًا نريد أن نقطع الحلقةَ في منتصفها، أو نتخطّى دورةً بعينها. لهذا أداتان دقيقتان: `break` تكسر الحلقةَ وتخرج منها فورًا، و`continue` تتخطّى بقيّةَ الدورة الحاليّة وتقفز إلى الدورة التالية.

`break` — نتوقّف عند شرط:

```bash
#!/bin/bash
for i in {1..10}
do
  if [ "$i" -eq 5 ]
  then
    break
  fi
  echo "$i"
done
```

يطبع هذا `1 2 3 4` ثم يتوقّف: فحين يبلغ `i` القيمةَ 5، ينفّذ `break` فيخرج من الحلقة كلِّها فورًا، تاركًا الأرقامَ من 5 إلى 10 دون طباعة. `break` تعني «كفى، اخرج الآن».

`continue` — نتخطّى ونكمل:

```bash
#!/bin/bash
for i in {1..10}
do
  if [ $((i % 2)) -eq 0 ]
  then
    continue
  fi
  echo "$i عدد فرديّ"
done
```

يطبع هذا الأعدادَ الفرديّة فقط (1، 3، 5، 7، 9). الشرطُ `[ $((i % 2)) -eq 0 ]` يسأل: «أباقي قسمة `i` على 2 يساوي صفرًا؟» أي أزوجيٌّ هو؟ فإن كان زوجيًّا نفّذ `continue`، فتخطّى بقيّةَ الدورة (سطرَ الطباعة) وقفز مباشرةً إلى العدد التالي. `continue` تعني «تجاوز هذه الدورة، وأكمِل الحلقة».

#tip[
  `break` و`continue` تعملان في `for` و`while` و`until` سواءً. والفرقُ بينهما جوهريّ: `break` تُنهي *الحلقة كلَّها*، بينما `continue` تُنهي *الدورة الحاليّة فقط* وتُبقي الحلقةَ دائرة. تذكّرهما بجملة: «`break` يكسر الحلقة، و`continue` يكمل الدوران».
]

#try-it[
  اكتب سكربتًا يدور بـ `for` على `{1..20}` ويطبع الأعداد التي تقبل القسمة على 3 فقط (استعمل `continue` لتخطّي ما لا يقبلها: شرطُه `[ $((i % 3)) -ne 0 ]`). ثم عدّله ليتوقّف تمامًا بـ `break` أوّلَ ما يبلغ عددًا أكبر من 15.
]

#section[خلاصة الفصل]

منحتَ سكربتك في هذا الفصل عقلًا يقرّر وقدمين تكرّران. عرفتَ أنّ *حالة الخروج* (الصفرُ نجاح) هي أساسُ كلِّ قرار، وأنّ *الجملة الشرطية* `if`/`elif`/`else`/`fi` تفرّع المسار بحسبها. وأتقنتَ *أمر الاختبار* `[ ]` وقاعدتَه الحديديّة (مسافةٌ داخل القوسين)، وموازناتِ الأعداد (`-eq` `-ne` `-lt` `-gt` وأخواتِها) والنصوص (`=` `!=` `-z`) والملفّات (`-f` `-d` `-e`)، وعرفتَ أنّ `[[ ]]` أذكى وأأمن في bash. واختصرتَ التفرّعات الكثيرة بجملة `case`. ثم دخلتَ عالم التكرار: `for` تدور على قائمة، و`while` تدور ما دام الشرطُ قائمًا، و`until` تدور حتى يصدق، وضبطتَ مسارها بـ `break` و`continue`. بهذه اللبنات صار سكربتُك قادرًا على أن يفكّر ويعيد — وهذا جوهرُ البرمجة. في الفصل التالي نغلّف هذه المنطقَ في *دوالَّ* نسمّيها ونستدعيها، فيصير كودُك أنظفَ وأقبلَ لإعادة الاستعمال.

