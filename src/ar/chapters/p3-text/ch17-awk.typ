#chapter[awk: لغة معالجة النصوص]

#objectives((
  [تفهم فلسفة `awk`: يرى كلّ سطرٍ صفًّا مقسّمًا إلى *حقول* (أعمدة)، فتصل إلى أيّها باسمه `$1` و`$2` و`$NF`.],
  [تكتب برنامج `awk` بالنموذج «`نمط { فعل }`»، وتضبط الفاصل بين الحقول بالخيار `-F`.],
  [توظّف المتغيّرين المدمجين `NR` (رقم السطر) و`NF` (عدد الحقول في السطر).],
  [تستعمل كتلتَي `BEGIN` و`END`، وتطبع بأمرَي `print` و`printf`.],
  [تُجري حساباتٍ وشروطًا بسيطة على الجداول النصّية كملفّ `/etc/passwd`.],
))

في الفصل الماضي رأينا `sed` يعامل النصّ سطرًا سطرًا، كأنه شريطٌ من الكلمات لا يفرّق بين موضعٍ وآخر فيه. لكن تأمّل دفترَ محاسبٍ قديم: صفحته مسطّرةٌ *أعمدةً* — عمودٌ للاسم، وعمودٌ للتاريخ، وعمودٌ للمبلغ. المحاسب لا يقرأ السطر ككتلةٍ واحدة؛ بل يمدّ إصبعه إلى العمود الذي يريده وحده فيقرأ منه، ويجمع أرقام عمودٍ بعينه، ويقارن قيمةً بأخرى. هذا بالضبط ما يفعله `awk`: لا يرى الأسطر خيوطًا مصمتة، بل *جداول* لها صفوفٌ وأعمدة، فيصل إلى كلّ خانةٍ باسمها، ويحسب، ويقرّر. هنا تنتقل من «تحرير النصّ» إلى *فهمه*.

#section[ما awk؟ ولماذا هو لغة؟]

كلّ ما رأيناه قبله — `grep` و`sed` — أدواتٌ لكلٍّ منها مهمّةٌ واحدة. أمّا `awk` فأكبر: إنه *لغة برمجةٍ صغيرة* كاملةٌ، متخصّصةٌ في معالجة النصوص المنظَّمة في أعمدة. له متغيّرات، وشروط، وحساب، وحلقات — لكنك ستحتاج في تسعين بالمئة من حياتك اليوميّة إلى قشرته البسيطة التي نتعلّمها هنا، وهي وحدها تكفي لعجائب.

#define("awk", [
  لغةٌ وأداةٌ لمعالجة النصوص المقسَّمة إلى حقولٍ (أعمدة). تقرأ المدخل سطرًا سطرًا، وتقسّم كلّ سطرٍ إلى حقولٍ آليًّا، ثم تطبّق عليها ما تأمرها به من طباعةٍ وحسابٍ وشرط. اسمها من أوائل أسماء مؤلّفيها الثلاثة: أهو (Aho) وواينبرغر (Weinberger) وكيرنيهان (Kernighan).
])

#subsection[‏النموذج: نمط ثم فعل]

كلّ برنامج `awk` — مهما طال أو قصر — مبنيٌّ على وحدةٍ واحدةٍ تتكرّر: *نمطٌ* يتبعه *فعلٌ* بين قوسين معقوفين.

```bash
awk 'النمط { الفعل }' ملف
```

يقرأ `awk` كلّ سطرٍ من الملفّ، ويسأل: هل يوافق هذا السطر *النمط*؟ فإن وافقه، نفّذ عليه *الفعل*. القاعدتان الذهبيّتان اللتان تفتحان لك نصف الأداة:

- إن حذفتَ *النمط* وأبقيت الفعل وحده، انطبق الفعل على *كلّ* سطر. فـ `'{ print }'` يطبع كلّ الأسطر.
- إن حذفتَ *الفعل* وأبقيت النمط وحده، كان الفعل الافتراضيّ هو *طباعة السطر كاملًا*. فـ `'/error/'` يطبع كلّ سطرٍ فيه `error`، تمامًا كـ `grep`.

#session("echo \"مرحبا بالعالم\" | awk '{ print }'", output: "مرحبا بالعالم")

هنا لا نمط، فانطبق الفعل `print` على السطر الوحيد فطُبع كما هو. يبدو هذا تافهًا الآن، لكنّه حجر الأساس: كلّ ما بعده مجرّد تلوينٍ لهذين الركنين — نمطٍ يختار، وفعلٍ يعمل.

#note[
  لاحظ أنّنا نحيط برنامج `awk` بعلامتَي *تنصيصٍ مفردٍ* `'...'` دائمًا. السبب أنّ البرنامج يعجّ بالرموز `$` و`{` و`}` التي تفسّرها الصدفة لو تركناها عاريةً؛ فالتنصيص المفرد يحمي البرنامج كلّه ويسلّمه إلى `awk` حرفًا بحرف. اجعلها عادةً لا تنساها.
]

#section[الحقول: كيف يرى awk النصّ أعمدةً]

هنا جوهر `awk` كلّه. حين يقرأ سطرًا، يقسّمه تلقائيًّا عند كلّ فراغٍ إلى قطعٍ يسمّيها *الحقول*، ويعطي كلّ حقلٍ اسمًا: `$1` للأوّل، و`$2` للثاني، وهكذا. والرمز `$0` اسمٌ خاصٌّ يعني *السطر بأكمله*.

#define("الحقل والسجلّ (Field & Record)", [
  *السجلّ* (Record) هو السطر الواحد الذي يعالجه `awk` في المرّة — وافتراضًا كلّ سطرٍ سجلّ. أمّا *الحقل* (Field) فكلّ قطعةٍ من السجلّ يفصلها فراغ. تصل إلى الحقل رقم `n` بالرمز `$n`، وإلى السجلّ كلّه بالرمز `$0`. فالرمز `$` هنا معناه «الحقلُ ذو الرقم»، لا علاقةَ له بمحثّ الصدفة.
])

جرّب سطرًا من ثلاث كلمات، واطلب الحقل الثاني وحده:

#session("echo \"واحد اثنان ثلاثة\" | awk '{ print $2 }'", output: "اثنان")

انتقى `awk` الكلمة الثانية بدقّة. وتستطيع أن تطبع أكثر من حقلٍ، تفصل بينها بفاصلة `,`:

#session("echo \"غازي 34 مبرمج\" | awk '{ print $1, $3 }'", output: "غازي مبرمج")

طلبنا الحقلين الأوّل والثالث فتخطّى الثاني. والفاصلة `,` بين الحقلين تجعل `awk` يضع بينهما فراغًا في المخرج. هذه القدرة على *انتقاء الأعمدة وإعادة ترتيبها* هي ما يجعل `awk` سيّد الجداول.

#subsection[‏الحقل الأخير `$NF`]

كثيرًا لا تعرف كم حقلًا في السطر، لكنك تريد *آخرها* مهما كان عددها. لهذا اسمٌ جاهز: `$NF`. سنرى بعد قليلٍ أنّ `NF` عددُ حقول السطر، فيصير `$NF` هو «الحقل ذو الرقم الأخير»، أي الأخير دومًا.

#session("echo \"a b c d e\" | awk '{ print $NF }'", output: "e")

مهما زاد عدد الكلمات أو نقص، يظلّ `$NF` مصيبًا الأخيرة. وبالمثل `$(NF-1)` هو ما قبل الأخير. هذه حيلةٌ يوميّةٌ لا غنى عنها حين تكون آخر الأعمدة هو المهمّ — كالصدفة في `/etc/passwd`، وسنراها بعد قليل.

#try-it[
  نفّذ `echo "الشمس تشرق من الشرق" | awk '{ print $1, $NF }'` وتأمّل كيف التقط أوّل كلمةٍ وآخرها متجاوزًا ما بينهما. ثم بدّل `$NF` بـ `$0` وراقب كيف يعود إليك السطر كلّه. هذان الطرفان — الحقل المفرد والسطر الكامل — بينهما تعيش كلّ قدرة `awk`.
]

#section[الفاصل الحقليّ ‎-F: حين لا يكون الفاصل فراغًا]

افتراضًا يقسّم `awk` السطر عند *الفراغات* (المسافات وعلامات الجدولة). لكنّ كثيرًا من ملفّات النظام تفصل حقولها بمحرفٍ آخر — كالنقطتين `:` أو الفاصلة `,`. لتخبر `awk` بالفاصل الصحيح، استعمل الخيار `-F` متبوعًا بالمحرف.

#define("الفاصل الحقليّ (Field Separator)", [
  المحرف الذي يقسّم `awk` السطرَ عنده إلى حقول. افتراضه أيُّ فراغٍ (مسافةٌ أو جدولة، وتتوالياتُها تُعدّ فاصلًا واحدًا). تغيّره بالخيار `-F` قبل البرنامج، مثل `-F:` أو `-F,`. وله داخل البرنامج اسمٌ هو المتغيّر `FS`.
])

خير ميدانٍ لهذا ملفُّ الحسابات `/etc/passwd`؛ فكلّ سطرٍ فيه سجلُّ مستخدمٍ، وحقولُه السبعة مفصولةٌ بنقطتين `:`، أوّلها اسمُ المستخدم والأخير صدفتُه. لنطبع أسماء المستخدمين وحدها (الحقل الأوّل):

```bash
awk -F: '{ print $1 }' /etc/passwd
```

#session("awk -F: '{ print $1 }' /etc/passwd", output: "root
daemon
bin
sys
sync
...
ghazi")

جعل `-F:` النقطتين فاصلًا، فصار الحقل الأوّل `$1` هو الاسم بالضبط. ولو نسينا `-F` لعدّ `awk` السطرَ كلَّه حقلًا واحدًا (إذ لا فراغَ فيه)، فطبع السطر بأكمله. جرّب الآن أن تطبع الاسم وصدفته معًا — الأوّل والسابع:

```bash
awk -F: '{ print $1, $7 }' /etc/passwd
```

#session("awk -F: '{ print $1, $7 }' /etc/passwd", output: "root /bin/bash
daemon /usr/sbin/nologin
...
ghazi /bin/bash")

في سطرٍ واحدٍ استخرجنا من ملفٍّ معقّدٍ عمودين مهمّين ونسّقناهما جنبًا إلى جنب. تخيّل كم يكلّفك هذا لو حاولته بـ `sed` وحده.

#distro[
  ملفّ `/etc/passwd` وبنيتُه ذات الحقول السبعة المفصولة بـ `:` واحدةٌ في أوبونتو وأرش وفيدورا جميعًا؛ فهي من معايير يونِكس الثابتة. وكذلك `awk` وخياره `-F` حاضران في كلّ توزيعةٍ بلا فرق. (على أغلب أنظمة لِينُكس يكون `awk` في الحقيقة نسخة GNU المسمّاة `gawk`، لكنّ ما نتعلّمه هنا قياسيٌّ يعمل في كلّ النسخ.)
]

#try-it[
  نفّذ `awk -F: '{ print $1 }' /etc/passwd` لترى كلّ الأسماء، ثم بدّل `$1` بـ `$3` (رقم المستخدم UID) وبـ `$6` (مجلّد المنزل). أخيرًا جرّب `awk -F: '{ print $NF }' /etc/passwd` وقارنه بـ `$7` — ستجدهما سيّان، لأنّ الصدفة هي الحقل الأخير دائمًا.
]

#section[المتغيّران المدمجان: NR وNF]

يمسك `awk` وهو يعمل عدّاداتٍ يحدّثها تلقائيًّا في كلّ سطر، ويضعها في متغيّراتٍ *مدمجةٍ* جاهزة. أنفعُها اثنان: `NR` و`NF`.

#define("‏NR و‏NF", [
  `NR` (من Number of Records) عددُ السجلّات المقروءة حتى الآن — أي *رقم السطر الحاليّ* أثناء المرور، وهو في نهاية الملفّ عددُ أسطره كلِّها. و`NF` (من Number of Fields) عددُ الحقول في السطر الحاليّ. لاحظ أنّهما يُكتبان بلا `$`؛ فـ `NF` عددٌ، أمّا `$NF` فمحتوى الحقل الأخير.
])

المتغيّر `NR` يجعل `awk` يرقّم لك الأسطر بلا عناء:

#session("awk '{ print NR, $0 }' /etc/hostname", output: "1 my-imac")

طبعنا رقم السطر `NR` ثم السطر كاملًا `$0`، فحصلنا على ترقيمٍ كما يفعل `cat -n`. وأمّا `NF` فيخبرك بعدد أعمدة كلّ سطر — مفيدٌ للتحقّق من سلامة جدولك:

#session("echo \"واحد اثنان ثلاثة\" | awk '{ print NF }'", output: "3")

ثلاث كلماتٍ، فكان `NF` يساوي 3. وبدمج الاثنين تصنع فحوصاتٍ لطيفة؛ مثلًا: كم مستخدمًا في النظام؟ ما علينا إلا أن نطبع `NR` عند *آخر* سطرٍ فقط، وسنتعلّم «آخر سطر» في القسم التالي.

#tip[
  الفرق بين `NF` و`$NF` مصدرُ حيرةٍ للمبتدئ، فرسّخه: `NF` *رقمٌ* (كم حقلًا؟)، و`$NF` *محتوى* (ما الحقل الأخير؟). القاعدة عامّة: أيُّ اسمٍ سبقه `$` صار «الحقلَ ذا هذا الرقم»؛ فلو كان `NF` يساوي 5، فإنّ `$NF` هو `$5` نفسه.
]

#section[النمط شرطًا: تصفية الأسطر بالحساب]

عرفنا أنّ النمط قد يكون تعبيرًا نمطيًّا كـ `/error/`. لكنّ قوّة `awk` الكبرى أن يكون النمط *شرطًا منطقيًّا* على الحقول: قارِن حقلًا برقمٍ أو بنصّ، فلا يُطبع إلا ما تحقّق فيه الشرط. هنا يتفوّق `awk` على `grep` تفوّقًا حاسمًا: `grep` يبحث في النصّ، أمّا `awk` فيفهم *قيمة* العمود ويقارنها.

خذ الحقل الثالث في `/etc/passwd` وهو رقم المستخدم (UID). حسابات النظام تحمل أرقامًا صغيرة، وأمّا المستخدمون الحقيقيّون (من لحمٍ ودم) فأرقامهم تبدأ عادةً من 1000. لنطبع المستخدمين ذوي الأرقام من 1000 فأعلى — وهم البشر غالبًا:

```bash
awk -F: '$3 >= 1000 { print $1 }' /etc/passwd
```

#session("awk -F: '$3 >= 1000 { print $1 }' /etc/passwd", output: "nobody
ghazi")

قرأ `awk` كلّ سطر، فحسب `$3` (الرقم)، فإن كان `>=` من 1000 نفّذ الفعل `print $1`. النمط هنا شرطٌ حسابيّ، لا بحثٌ نصّيّ.

#note[
  دقّقْ في المخرج: ظهر `nobody` مع أنّه ليس مستخدمًا بشريًّا، بل حسابٌ خدميٌّ رقمه ضخمٌ جدًّا (‎65534‎ عادةً) يتجاوز الألف فينطبق عليه الشرط. فحدُّ الألف قاعدةٌ تقريبيّةٌ مريحة، لا قانونٌ صارم؛ ولو أردت إقصاء هذا الحساب الخاصّ لأضفت شرطًا ثانيًا مثل `$3 < 65534`.
]

وتستطيع مقارنة النصوص أيضًا؛ لنطبع أسماء من صدفتهم `bash` بالضبط:

```bash
awk -F: '$7 == "/bin/bash" { print $1 }' /etc/passwd
```

#session("awk -F: '$7 == \"/bin/bash\" { print $1 }' /etc/passwd", output: "root
ghazi")

العلامة `==` تعني «يساوي تمامًا» (لا تخلطها بـ `=` المفردة التي هي إسناد). وتجمع الشروط بـ `&&` (و) و`||` (أو)؛ فمثلًا `$3 >= 1000 && $7 == "/bin/bash"` يعني «مستخدمٌ حقيقيّ صدفتُه bash».

#warn[
  احذر الخلط بين `=` و`==`. المفردة `=` *إسنادٌ*: `$3 = 0` تعني «اجعل الحقل الثالث صفرًا» فتغيّره! والمزدوجة `==` *مقارنةٌ*: `$3 == 0` تسأل «أهو صفر؟». وضعُ `=` مكان `==` في الشرط خطأٌ صامتٌ يفسد نتيجتك دون رسالة. القاعدة: للمقارنة دائمًا حرفان.
]

#try-it[
  ابحث عن حساب المدير `root` بالرقم لا بالاسم: `awk -F: '$3 == 0 { print $1 }' /etc/passwd` — سيطبع `root` وحده، لأنّ رقمه صفر. ثم اطلب الحسابات ذات الأرقام بين 1 و999 (حسابات النظام): `awk -F: '$3 >= 1 && $3 < 1000 { print $1, $3 }' /etc/passwd`. لاحظ كيف صار `awk` أداة استعلامٍ عن جدولٍ لا مجرّد باحثٍ عن كلمة.
]

#section[كتلتا BEGIN وEND: قبل الأولى وبعد الأخيرة]

حتى الآن ينفّذ `awk` فعله *في أثناء* مروره على الأسطر. لكنّك تحتاج أحيانًا إلى فعلٍ *قبل* أن يبدأ القراءة (كطباعة عنوانٍ للجدول)، وفعلٍ *بعد* أن يفرغ منها (كطباعة مجموعٍ نهائيّ). لهذا نمطان خاصّان: `BEGIN` و`END`.

#define("‏BEGIN و‏END", [
  `BEGIN { ... }` كتلةٌ تُنفَّذ مرّةً واحدةً *قبل* قراءة أوّل سطر — لتهيئة الأمور وطباعة الرؤوس. و`END { ... }` كتلةٌ تُنفَّذ مرّةً واحدةً *بعد* آخر سطر — لطباعة الخلاصات والمجاميع. وبينهما تعمل الكتلة الوسطى على كلّ سطر.
])

أشهرُ استعمالٍ لـ `END`: عدّ الأسطر. فالمتغيّر `NR` يظلّ يكبر مع كلّ سطر، وعند `END` يكون قد بلغ عددها الكلّيّ:

```bash
awk 'END { print NR }' /etc/passwd
```

#session("awk 'END { print NR }' /etc/passwd", output: "48")

طُبع رقمٌ واحدٌ فقط — إجماليّ الأسطر — لأنّ الفعل في `END` يجري بعد انتهاء المرور. هذا يكافئ `wc -l`. ولنجمع الثلاثة في برنامجٍ أنيقٍ يطبع رأسًا، ثم الأسماء، ثم عددها:

```bash
awk -F: 'BEGIN { print "== المستخدمون ==" } { print $1 } END { print "العدد:", NR }' /etc/passwd
```

#session("awk -F: 'BEGIN { print \"== المستخدمون ==\" } { print $1 } END { print \"العدد:\", NR }' /etc/passwd", output: "== المستخدمون ==
root
daemon
...
ghazi
العدد: 48")

هكذا يصير برنامج `awk` تقريرًا متكامل الشكل: مقدّمةٌ من `BEGIN`، وجسمٌ يتكرّر لكلّ سطر، وخاتمةٌ من `END`. هذا الهيكل الثلاثيّ هو قالب أغلب سكربتات `awk` العمليّة.

#note[
  كتلة `BEGIN` تُنفَّذ حتى لو لم يكن هناك ملفٌّ أو مدخلٌ إطلاقًا؛ فهي مستقلّةٌ عن القراءة. لهذا يستعملها بعضهم كآلةٍ حاسبةٍ سريعة: جرّب `awk 'BEGIN { print 3 * 7 + 1 }'` فيطبع `22` دون أن يقرأ أيّ ملفّ. تذكّر أنّ `awk` لغةٌ حسابيّةٌ كاملة، لا مجرّد مصفاةٍ للنصّ.
]

#section[الطباعة: print وprintf]

للطباعة في `awk` أمران: `print` البسيط، و`printf` المنسّق. عرفنا `print`: يطبع ما تعطيه ويُنهي السطر تلقائيًّا، والفاصلة `,` بين أجزائه تضع فراغًا. هذا يكفي غالبًا. لكنْ حين تريد *محاذاةً* أنيقةً في أعمدة، يأتي دور `printf`.

#define("printf", [
  أمرُ طباعةٍ *منسَّقة* يأخذ أوّلًا نصَّ *قالبٍ* فيه رموزٌ نائبة تبدأ بـ `%`، ثم القيمَ التي تحلّ محلّها. أشهر الرموز: `%s` لنصّ، و`%d` لعددٍ صحيح، و`%f` لعددٍ عشريّ. وخلافًا لـ `print`، لا يُنهي `printf` السطرَ تلقائيًّا، فعليك أن تضع `\n` (محرف السطر الجديد) بنفسك حيث تريد.
])

الرمز `%s` يعني «ضع هنا نصًّا»، وتستطيع أن تحدّد له *عرضًا* ثابتًا لتصطفّ الأعمدة: `%-12s` يعني «نصٌّ في عرض 12 خانةً، مُحاذًى إلى اليسار» (الشرطة `-` للمحاذاة يسارًا). لنطبع جدول الأسماء والأصداف مصطفًّا:

```bash
awk -F: '{ printf "%-12s %s\n", $1, $7 }' /etc/passwd
```

#session("awk -F: '{ printf \"%-12s %s\\n\", $1, $7 }' /etc/passwd", output: "root         /bin/bash
daemon       /usr/sbin/nologin
bin          /usr/sbin/nologin
...
ghazi        /bin/bash")

انظر كيف اصطفّ عمود الأصداف على مسافةٍ واحدةٍ رغم اختلاف أطوال الأسماء، لأنّ `%-12s` حجز لكلّ اسمٍ اثنتي عشرة خانة. لاحظ أيضًا `\n` في آخر القالب: لولاه لالتصقت كلّ السطور في سطرٍ واحدٍ طويل، إذ لا يُنهي `printf` السطر من تلقائه.

#warn[
  أكثر خطأٍ يقع فيه المبتدئ مع `printf` نسيانُ `\n` في آخر القالب، فتخرج كلّ النتائج ملتصقةً في سطرٍ واحد. تذكّر القاعدة: `print` يُنهي السطر تلقائيًّا، و`printf` لا يُنهيه أبدًا — أنت مسؤولٌ عن `\n`.
]

#section[الحساب على الأعمدة: المتغيّرات والمجاميع]

نصل إلى ما يميّز `awk` عمّا سواه حقًّا: أن يجمع عمودًا من الأرقام ويحسب معدّله، وهو ما لا تحلم به الأدوات النصّية الأخرى. `awk` يجمع الأرقام كأرقام؛ فحين يكون الحقل رقمًا، يتعامل معه في الحساب عددًا لا نصًّا.

الحيلة أن تعرّف *متغيّرًا* تراكم فيه عبر الأسطر (لا تحتاج إلى الإعلان عنه؛ ينشأ صفرًا أوّل ذكره)، ثم تطبع نتيجته في `END`. لنفترض ملفًّا `scores.txt` فيه اسمٌ ودرجةٌ في كلّ سطر:

```bash
أحمد 85
سارة 92
خالد 78
```

لنجمع الدرجات (الحقل الثاني)، ونطبع المجموع في النهاية:

```bash
awk '{ sum = sum + $2 } END { print "المجموع:", sum }' scores.txt
```

#session("awk '{ sum = sum + $2 } END { print \"المجموع:\", sum }' scores.txt", output: "المجموع: 255")

في كلّ سطرٍ أضاف `awk` قيمة `$2` إلى المتغيّر `sum`، فتراكم فيه 85 ثمّ 177 ثمّ 255، وطبعناه في `END`. والمعدّل خطوةٌ واحدةٌ أبعد: اقسم المجموع على عدد الأسطر `NR`، ونسّقه بـ `printf` إلى منزلةٍ عشريّةٍ واحدةٍ بـ `%.1f`:

```bash
awk '{ sum = sum + $2 } END { printf "المعدّل: %.1f\n", sum / NR }' scores.txt
```

#session("awk '{ sum = sum + $2 } END { printf \"المعدّل: %.1f\\n\", sum / NR }' scores.txt", output: "المعدّل: 85.0")

قسمنا المجموع 255 على عدد الأسطر 3 فكان المعدّل 85.0. في سطرٍ واحدٍ صار `awk` جدولَ حساباتٍ صغيرًا: يجمع عمودًا، ويعدّ صفوفًا، ويقسم، وينسّق الناتج. لا `sed` ولا `grep` يقترب من هذا.

#tip[
  الصيغة `sum = sum + $2` لها اختصارٌ شائعٌ في كلّ لغات هذه العائلة: `sum += $2`، ومعناهما واحد («زِد على `sum` قيمةَ `$2`»). وبالمثل `count++` تزيد `count` واحدًا. ستراهما كثيرًا في سكربتات `awk`، فاعتَدْهما.
]

#try-it[
  أنشئ الملفّ بأمرٍ واحد: `printf 'أحمد 85\nسارة 92\nخالد 78\n' > scores.txt`. ثم احسب المجموع والمعدّل بالأمرين أعلاه. بعدها أضف شرطًا: اطبع أسماء من تجاوزت درجتُهم 90 فقط عبر `awk '$2 > 90 { print $1 }' scores.txt` — ستحصل على `سارة` وحدها. جمعتَ بذلك كلّ أركان الفصل: حقولٌ، وشرطٌ، وحسابٌ، وطباعة.
]

#section[خلاصة الفصل]

تعرّفت في هذا الفصل إلى `awk`، اللغةِ التي ترى النصّ *جدولًا* من صفوفٍ وأعمدة لا مجرّد أسطرٍ صمّاء. رأيت نموذجه الجوهريّ «`نمط { فعل }`»: النمطُ يختار الأسطر، والفعلُ يعمل عليها، وحذفُ أيّهما له معنًى (بلا نمطٍ يعمّ الفعل، وبلا فعلٍ يُطبع السطر). وأتقنت الوصول إلى الحقول بـ `$1` و`$2` و`$NF` والسطرِ كلّه بـ `$0`، وضبطَ الفاصل بالخيار `-F` كما في `/etc/passwd`. ووظّفت المتغيّرين المدمجين `NR` (رقم السطر وعددُ الأسطر) و`NF` (عددُ الحقول). وجعلت النمطَ شرطًا حسابيًّا أو نصّيًّا (`$3 >= 1000`, `$7 == "/bin/bash"`) فصار `awk` أداة استعلامٍ تتفوّق على `grep`. وتعلّمت كتلتَي `BEGIN` و`END` للرؤوس والخلاصات، والطباعةَ بـ `print` و`printf` المنسّق، وأخيرًا الحسابَ على الأعمدة: مجاميعُ ومعدّلاتٌ في سطرٍ واحد.

بهذا اكتمل ثالوث معالجة النصوص: `grep` يبحث، و`sed` يحرّر، و`awk` يفهم الأعمدة ويحسب. وثلاثتُها تتّصل بالأنابيب `|` التي تعلّمناها لتصير مصنعًا نصّيًّا لا يُقهر. في الفصل التالي ننتقل من معالجة النصّ آليًّا إلى تحريره بأيدينا: نفتح *محرّرًا* حقيقيًّا نكتب فيه ونعدّل مباشرةً على الشاشة.

#challenge[
  خذ ملفّ `/etc/passwd` ميدانًا. أوّلًا، اطبع جدولًا أنيقًا بعمودين مصطفّين — اسمُ المستخدم ومجلّدُ منزله (الحقلان الأوّل والسادس) — مستعملًا `printf` ورمز العرض `%-15s`. ثانيًا، اعدد كم مستخدمًا صدفتُه `/bin/bash` بالضبط، بأن تزيد عدّادًا في الكتلة الوسطى ضمن شرطٍ على `$7`، ثم تطبعه في `END`. ثالثًا وأخيرًا، خمّن قبل أن تجرّب: ماذا يطبع `awk -F: '{ if ($3 > max) max = $3 } END { print max }' /etc/passwd`؟ (تلميح: يتتبّع أكبر قيمةٍ رآها في الحقل الثالث — فما أكبر رقم مستخدمٍ في نظامك؟)
]
