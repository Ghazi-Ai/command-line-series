#chapter[الحزم ومديروها]

#objectives((
  [تفهم ما «الحزمة» وما «الاعتماديّة»، ولماذا لا نثبّت البرامج بجمع ملفّاتها يدويًّا.],
  [تعرف العائلات الثلاث الكبرى — `apt` و`dnf` و`pacman` — وتجد الأمر المكافئ في كلٍّ منها.],
  [تحدّث الفهرس، وتبحث، وتثبّت، وتعرض المعلومات، وتزيل الحزم على أيّ توزيعة.],
  [ترقّي نظامك كاملًا بأمان، وتفهم فخّ «الترقية الجزئيّة» على أرش.],
  [تدرك ما «المستودع»، وكيف يأتي منه كلُّ ما تثبّته، وكيف تضيف مصدرًا جديدًا بحذر.],
))

حين تريد دواءً لا تذهب إلى المختبر لتركّبه بنفسك من موادّه الخام. تدخل صيدليّةً منظّمة: للصيدليّ *فهرسٌ* يعرف به ما لديه، ومخزنٌ *موثوقٌ* تأتيه منه العلب مختومةً سليمة. وإذا احتاج دواؤك دواءً آخر يرافقه، ناولك الاثنين معًا دون أن تطلب. تثبيت البرامج في لِينُكس يجري بالطريقة نفسها تمامًا: لا تطارد الملفّات في زوايا الإنترنت وتلصقها بيدك، بل تطلب اسم البرنامج من *مدير حزمٍ* أمين، فيجلبه ومرافقاته من *مستودعٍ* موثوق، ويركّبه في مكانه الصحيح. هذا الفصل يعلّمك مخاطبة ذلك الصيدليّ — بلهجاته الثلاث.

#section[ما الحزمة، وما الاعتماديّة؟]

البرنامج في لِينُكس ليس ملفًّا واحدًا تنقره، بل مجموعةٌ من الملفّات: الملفّ التنفيذيّ، وصفحات المساعدة، وملفّات الإعداد، وأيقونات، وربّما مكتباتٌ مشتركة. كلّ هذا يُلَفُّ في علبةٍ واحدةٍ منظّمة اسمها *الحزمة*.

#define("الحزمة (Package)", [
  علبةٌ واحدةٌ تجمع كلّ ما يحتاجه برنامجٌ ليعمل: ملفّاته، ووصفٌ لاسمه وإصداره، وقائمةٌ بما يعتمد عليه. تركّبها بأمرٍ واحد، وتزيلها بأمرٍ واحد، فلا تترك خلفها فوضى.
])

لكنّ البرامج نادرًا ما تعيش وحدها. برنامجُ تحرير الصور قد يعتمد على مكتبةٍ لقراءة صيغة `PNG`، وتلك المكتبة قد تعتمد على أخرى لضغط البيانات. هذه السلسلة من «يحتاج إلى» تسمّى *الاعتماديّات*.

#define("الاعتماديّة (Dependency)", [
  حزمةٌ أخرى تحتاجها حزمتُك كي تعمل. فإذا طلبتَ برنامجًا يعتمد على مكتبة، تولّى مديرُ الحزم جلبَ المكتبة معه تلقائيًّا — فلا يقع على عاتقك تتبّع السلسلة بنفسك.
])

تخيّل لو وجب عليك أن تجمع بيدك برنامجًا ومكتباته الاثنتي عشرة، كلٌّ بإصداره الصحيح المتوافق مع الآخر. هذا الكابوس اسمه «جحيم الاعتماديّات»، ومديرُ الحزم هو من يحمله عنك.

#define("مدير الحزم (Package Manager)", [
  البرنامج الذي يثبّت الحزم ويزيلها ويرقّيها، ويحلّ اعتماديّاتها آليًّا، ويحفظ سجلًّا بكلّ ما هو مثبّتٌ على نظامك. هو الصيدليّ في مثالنا.
])

#section[العائلات الثلاث]

لكلّ عائلةٍ من توزيعات لِينُكس مديرُ حزمٍ خاصّ وصيغةُ علبةٍ خاصّة. ثلاثٌ منها تغطّي عمليًّا كلّ ما ستلقاه:

#table(
  columns: (auto, 1fr, 1fr),
  table.header([العائلة], [أبرز توزيعاتها], [مدير الحزم (صيغة العلبة)]),
  [دبيان],  [دبيان، أوبونتو، منت], [`apt` — صيغة `.deb`],
  [ريدهات], [فيدورا، ريل، روكي],   [`dnf` — صيغة `.rpm`],
  [أرش],    [أرش، مانجارو],        [`pacman` — صيغة `.pkg.tar.zst`],
)

سنعتمد في المتن على `apt` (دبيان وأوبونتو) لأنه الأوسع انتشارًا بين المبتدئين، ثم نضع مكافئه في `dnf` و`pacman` في *جدول مقارنةٍ* عند كلّ مهمّة — فهذا الفصل مرجعُك حين تنتقل بين العائلات.

#note[
  أسماء الأوامر تختلف، لكنّ *الأفكار* واحدة: عندك دائمًا فهرسٌ تحدّثه، ومستودعٌ تجلب منه، وأمرٌ للتثبيت وآخر للإزالة. تعلّم الفكرة مرّةً، وترجمها إلى أيّ لهجةٍ متى شئت.
]

#section[أولًا: تحديث الفهرس]

قبل أن تثبّت شيئًا، تذكّر الصيدليّ وفهرسه. مديرُ الحزم لا يحفظ عن ظهر قلبٍ كلَّ ما في المستودعات، بل يحتفظ بنسخةٍ محليّةٍ من قائمة المتوفّر وإصداراته اسمها *الفهرس* (أو الذاكرة المؤقّتة). ومع الوقت تصير هذه النسخة قديمة، فيجب تحديثها من المستودع.

#define("الفهرس (Package Index)", [
  قائمةٌ محليّةٌ يحفظها مديرُ الحزم بأسماء الحزم المتوفّرة في المستودعات وإصداراتها. تحديثُ الفهرس *لا يثبّت شيئًا*؛ إنما يجدّد معرفة مديرك بما هو متاح.
])

على دبيان وأوبونتو، تحديثُ الفهرس أمرٌ مستقلٌّ تجريه بنفسك:

```bash
sudo apt update        # يجلب أحدث قائمةٍ من المستودعات (لا يثبّت ولا يرقّي)
```

انتبه للتمييز الجوهريّ: `apt update` يحدّث *القائمة* فقط، لا البرامج. أمّا ترقية البرامج نفسها فأمرٌ آخر (`apt upgrade`) سنصل إليه. اخلطْ بينهما ولن تفهم لماذا «حدّثتُ ولم يتغيّر شيء».

#table(
  columns: (auto, 1fr, 1fr, 1fr),
  table.header([المهمّة], [دبيان/أوبونتو], [فيدورا], [أرش]),
  [تحديث الفهرس], [`apt update`], [تلقائيّ / `dnf check-update`], [`pacman -Sy`],
)

#distro[
  *فيدورا:* لا تحتاج عادةً إلى تحديثٍ يدويّ للفهرس؛ فـ `dnf` يجدّد بياناته آليًّا عند الحاجة. ولو أردتَ استعراض ما يمكن ترقيته فقط، فـ `dnf check-update`.

  *أرش:* `pacman -Sy` يزامن قواعد البيانات وحدها، لكنّ استعماله منفردًا خطِرٌ (انظر تحذير الترقية الجزئيّة لاحقًا)؛ فالمعتاد أن تدمج المزامنة مع الترقية في أمرٍ واحد `pacman -Syu`.
]

#try-it[
  نفّذ `sudo apt update` وراقب الأسطر المارّة: كلُّ سطرٍ مستودعٌ يُستشار. في آخر المخرجات جملةٌ تخبرك كم حزمةً صارت لها ترقيةٌ متاحة (`... packages can be upgraded`). لم نرقِّ شيئًا بعد — فقط عرفنا ما الجديد.
]

#section[البحث عن حزمة]

عرفتَ اسم برنامجٍ وتريد التأكّد من توفّره؟ أو تبحث عن أداةٍ تؤدّي غرضًا ولا تعرف اسمها بالضبط؟ ابحث في الفهرس بكلمةٍ مفتاحيّة:

```bash
apt search htop        # يبحث في الأسماء والأوصاف عن الكلمة htop
```

تعرض لك النتيجةُ اسمَ كلّ حزمةٍ مطابقةٍ ووصفًا موجزًا لها. لاحظ أنّ البحث *لا يحتاج* صلاحيّة الجذر، فهو قراءةٌ من فهرسٍ محليّ لا تغييرٌ للنظام.

#table(
  columns: (auto, 1fr, 1fr, 1fr),
  table.header([المهمّة], [دبيان/أوبونتو], [فيدورا], [أرش]),
  [البحث عن حزمة], [`apt search <كلمة>`], [`dnf search <كلمة>`], [`pacman -Ss <كلمة>`],
)

#tip[
  في `pacman`، الحرف الكبير `-S` بابُ المزامنة والتثبيت (Sync)؛ وإضافة `s` صغيرةً إليه (`-Ss`) تعني «ابحث» (search). ستلاحظ أنّ `pacman` لغةٌ من أحرفٍ مختصرة: `-S` جلب، و`-R` إزالة (Remove)، و`-Q` استعلام (Query). أتقنها تُتقن الأداة.
]

#section[التثبيت]

وصلنا إلى الفعل الأهمّ. لتثبيت حزمةٍ، ناوِل مديرَك اسمها. وبما أنّ التثبيت *يغيّر النظام* (يكتب ملفّاتٍ في مجلّداتٍ محميّة)، فهو يتطلّب صلاحيّة الجذر عبر `sudo` الذي تعلّمناه في الفصل العاشر:

```bash
sudo apt install htop      # يثبّت htop، ويجلب معه اعتماديّاته تلقائيًّا
```

سيعرض لك مديرُك قائمةً بما سيثبّته (حزمتُك ومرافقاتها)، وحجمَ التنزيل، ثم يسألك `[Y/n]` للتأكيد. اكتب `y` واضغط #kbd("Enter"). خلال ثوانٍ يصير البرنامج جاهزًا في نظامك.

#table(
  columns: (auto, 1fr, 1fr, 1fr),
  table.header([المهمّة], [دبيان/أوبونتو], [فيدورا], [أرش]),
  [تثبيت حزمة], [`apt install <حزمة>`], [`dnf install <حزمة>`], [`pacman -S <حزمة>`],
)

#note[
  حذفنا `sudo` من خلايا الجدول اختصارًا للعرض، لكنّ كلّ أمرٍ *يغيّر* النظام — تثبيتًا أو إزالةً أو ترقيةً — يحتاج `sudo` في مقدّمته. أمّا أوامر القراءة (البحث، عرض المعلومات) فلا تحتاجه.
]

#try-it[
  ثبّت أداةً صغيرةً مرحة: `sudo apt install cowsay` (أو `sudo pacman -S cowsay` على أرش، أو `sudo dnf install cowsay` على فيدورا). ثم نفّذ `cowsay مرحبا` وشاهد بقرةً تنطق كلامك. أوّل برنامجٍ تثبّته بيدك — احتفِ به.
]

#section[عرض معلومات حزمة]

قبل أن تثبّت — أو لتفهم شيئًا مثبّتًا — قد تريد بطاقةً تعريفيّةً كاملة: ما وظيفة الحزمة؟ ما إصدارها؟ كم حجمها؟ على ماذا تعتمد؟

```bash
apt show htop      # يعرض الوصف والإصدار والحجم والاعتماديّات
```

#table(
  columns: (auto, 1fr, 1fr, 1fr),
  table.header([المهمّة], [دبيان/أوبونتو], [فيدورا], [أرش]),
  [عرض المعلومات], [`apt show <حزمة>`], [`dnf info <حزمة>`], [`pacman -Si <حزمة>`],
)

#distro[
  *أرش:* ميّز بين مصدرَين. `pacman -Si` يعرض معلومات الحزمة من *المستودع* (متاحةً للتثبيت)، بينما `pacman -Qi` يعرض معلومات حزمةٍ *مثبّتةٍ فعلًا* على جهازك (الحرف `Q` من Query). التمييز نفسه في البحث: `-Ss` يبحث في المستودع، و`-Qs` يبحث فيما هو مثبّت.
]

#tip[
  لسرد كلّ ما هو مثبّتٌ على نظامك: `apt list --installed` على أوبونتو، و`dnf list --installed` على فيدورا، و`pacman -Q` على أرش. القائمة طويلةٌ عادةً، فمرّرها إلى أداة بحثٍ لاحقًا حين نتعلّم الأنابيب في الفصل القادم.
]

#section[الإزالة]

ما يُثبَّت يُزال. إزالةُ حزمةٍ تحذف ملفّاتها وتعيد المساحة، لكنّ هنا فرقًا دقيقًا مهمًّا: هل تحذف ملفّات إعدادها أيضًا، أم تُبقيها لو أردتَ إعادة التثبيت لاحقًا؟

```bash
sudo apt remove htop       # يزيل البرنامج ويُبقي ملفّات إعداده
sudo apt purge htop        # يزيل البرنامج وإعداداته معًا (تطهيرٌ كامل)
```

#table(
  columns: (auto, 1fr, 1fr, 1fr),
  table.header([المهمّة], [دبيان/أوبونتو], [فيدورا], [أرش]),
  [إزالة (إبقاء الإعداد)], [`apt remove <حزمة>`], [`dnf remove <حزمة>`], [`pacman -R <حزمة>`],
  [إزالة الحزمة وما عاد يلزم من اعتماديّاتها], [`apt remove` ثم `apt autoremove`], [`dnf remove <حزمة>`], [`pacman -Rs <حزمة>`],
)

هنا فكرةٌ لطيفة: حين تُثبّت برنامجًا، يجلب معه اعتماديّاتٍ لم تطلبها أنت. فإذا أزلتَ البرنامج، تبقى تلك المرافقات معلّقةً بلا صاحبٍ يحتاجها — نسمّيها *اعتماديّاتٍ يتيمة*. لاحظ في الجدول أعلاه أنّ `dnf` و`pacman -Rs` يكنسان هذه اليتامى في الأمر نفسه، بينما يفصلها `apt` في أمرٍ ثانٍ مستقلّ. لتكنيسها على دبيان وأوبونتو:

```bash
sudo apt autoremove        # يحذف الاعتماديّات اليتيمة التي لم يعُد أحدٌ يحتاجها
```

#warn[
  تمهّل قبل تأكيد `autoremove` (وكذلك `dnf autoremove`): اقرأ قائمة ما سيُحذف. أحيانًا يظنّ المدير حزمةً «يتيمةً» وأنت ما زلتَ تريدها. الحذف ليس كارثةً — تستطيع إعادة التثبيت — لكنّ القراءة قبل الضغط عادةٌ تقيك مفاجآت.
]

#distro[
  *أرش:* `pacman -R` يزيل الحزمة وحدها. أضف `s` لتزيل معها اعتماديّاتها اليتيمة (`-Rs`)، وأضف `n` لتحذف ملفّات الإعداد كذلك (`-Rns`) — وهذا أقربُ ما يكون إلى `apt purge`.
]

#section[ترقية النظام]

تصدر تحديثاتٌ للأمان وإصلاحاتٌ للعلل باستمرار. ترقيةُ النظام تجلب أحدث إصدارٍ لكلّ حزمةٍ مثبّتةٍ لديك. وهي على خطوتين في ذهنك دائمًا: *حدِّث الفهرس أولًا* لتعرف ما الجديد، *ثم رقِّ*.

```bash
sudo apt update            # (١) جدِّد قائمة المتوفّر
sudo apt upgrade           # (٢) رقِّ الحزم المثبّتة إلى أحدث إصداراتها
```

يوجد شكلٌ أقوى: `sudo apt full-upgrade`، وهو يقبل *إزالة* حزمةٍ قديمةٍ إن لزم لإتمام الترقية (مثلًا حين تحلّ حزمةٌ محلَّ أخرى). استعمله بوعيٍ حين تعلق ترقيةٌ عاديّة.

#table(
  columns: (auto, 1fr, 1fr, 1fr),
  table.header([المهمّة], [دبيان/أوبونتو], [فيدورا], [أرش]),
  [ترقية كلّ الحزم], [`apt update` ثم `apt upgrade`], [`dnf upgrade`], [`pacman -Syu`],
)

#distro[
  *فيدورا:* أمرٌ واحدٌ يكفي: `sudo dnf upgrade` يجدّد بياناته ويرقّي في خطوةٍ واحدة (و`dnf update` مرادفٌ له).

  *أرش:* الترقية دائمًا `sudo pacman -Syu`: الحرف `S` مزامنة، و`y` تحديث الفهرس، و`u` ترقية النظام — مدمجةً كلُّها كي لا تقع في الفخّ التالي.
]

#warn[
  *فخّ الترقية الجزئيّة على أرش:* لا تحدّث الفهرس ثم تثبّت حزمةً واحدةً دون ترقية الباقي (أي لا `pacman -Sy <حزمة>` منفردًا). أرش نظامٌ «متجدّدٌ باستمرار» (rolling)، وحزمُه مبنيّةٌ لتتوافق مع أحدث إصدارات جاراتها؛ فتثبيتُ حزمةٍ جديدةٍ فوق نظامٍ قديمٍ قد يكسر التوافق. القاعدة الذهبيّة: *رقِّ النظام كاملًا* بـ `-Syu` قبل أن تثبّت جديدًا.
]

#try-it[
  على جهازك، نفّذ سلسلة الترقية الآمنة كاملةً: `sudo apt update` ثم `sudo apt upgrade` (أو مكافئها في عائلتك). راقب كم حزمةً رُقِّيَت. اجعلها عادةً أسبوعيّة — فالنظام المُحدَّث نظامٌ أكثر أمانًا.
]

#section[من أين يأتي كلُّ هذا؟ المستودعات]

بقي أن نجيب عن سؤال: من أين يجلب مديرُك كلَّ هذه الحزم؟ الجواب: *المستودعات*.

#define("المستودع (Repository)", [
  خادومٌ على الإنترنت تحتفظ عليه التوزيعةُ بآلاف الحزم المفحوصة والموقّعة رقميًّا. مديرُ حزمك مضبوطٌ مسبقًا ليثق بمستودعات توزيعتك ويجلب منها — ولهذا كان التثبيت آمنًا لا كتنزيلٍ عشوائيّ من موقعٍ مجهول.
])

قوائمُ المستودعات التي يثق بها مديرُك محفوظةٌ في ملفّاتٍ على نظامك. على دبيان وأوبونتو تجدها في `/etc/apt/sources.list` وفي مجلّد `/etc/apt/sources.list.d/`. نادرًا ما تحرّرها بيدك؛ فالأدوات تتكفّل بذلك. مثلًا، لإضافة مستودعٍ خارجيٍّ من نوع «أرشيف الحزم الشخصيّ» (PPA) على أوبونتو:

```bash
sudo add-apt-repository ppa:اسم-المصدر/اسم-المستودع
sudo apt update            # حدّث الفهرس ليشمل المصدر الجديد
```

#table(
  columns: (auto, 1fr, 1fr, 1fr),
  table.header([المهمّة], [دبيان/أوبونتو], [فيدورا], [أرش]),
  [موضع إعداد المستودعات], [`/etc/apt/sources.list.d/`], [`/etc/yum.repos.d/`], [`/etc/pacman.conf`],
)

#danger[
  لا تُضِف مستودعًا من مصدرٍ لا تثق به. المستودع يستطيع تقديم *أيّ* برنامجٍ بصلاحيّة الجذر عند التثبيت — وهذا بابٌ واسعٌ للاختراق إن كان المصدر خبيثًا. الْزم مستودعات توزيعتك الرسميّة، ولا تُضِف غيرها إلّا لجهةٍ معروفةٍ موثوقة، وبعد قراءةٍ لما تفعل.
]

#note[
  *أرش* لها ساحةٌ إضافيّة اسمها AUR (مستودع أرش للمستخدمين): وصفاتُ بناءٍ يقدّمها المجتمع لبرامج ليست في المستودعات الرسميّة. `pacman` وحده لا يتعامل معها؛ يحتاج أدواتٍ مساعِدةً مثل `yay`. إنها قوّةُ أرش وخطرُها معًا — فالوصفات غير مدقّقةٍ رسميًّا، فاقرأها قبل بنائها.
]

#section[بطاقةٌ مرجعيّة جامعة]

هذه خلاصةُ الفصل في جدولٍ واحدٍ علّقه أمامك حتى ترسخ اللهجات الثلاث:

#table(
  columns: (auto, 1fr, 1fr, 1fr),
  table.header([المهمّة], [`apt` (دبيان)], [`dnf` (فيدورا)], [`pacman` (أرش)]),
  [تحديث الفهرس], [`apt update`], [`dnf check-update`], [`pacman -Sy`],
  [بحث],          [`apt search`], [`dnf search`],      [`pacman -Ss`],
  [تثبيت],         [`apt install`],[`dnf install`],     [`pacman -S`],
  [إزالة],         [`apt remove`], [`dnf remove`],      [`pacman -Rs`],
  [معلومات],       [`apt show`],   [`dnf info`],        [`pacman -Si`],
  [ترقية النظام], [`apt upgrade`], [`dnf upgrade`],     [`pacman -Syu`],
  [سرد المثبّت],  [`apt list --installed`], [`dnf list --installed`], [`pacman -Q`],
)

#note[
  الملحق «ب» في آخر الكتاب يوسّع هذا الجدول بمزيدٍ من المهامّ النادرة — اجعله مرجعك حين تلقى مهمّةً غير مألوفة على عائلةٍ لا تعتادها.
]

#section[خلاصة الفصل]

تعلّمتَ أنّ البرامج تأتي في *حزمٍ* منظّمة، وأنّ لكلّ حزمةٍ *اعتماديّاتٍ* يحملها عنك *مديرُ الحزم* من *مستودعٍ* موثوق. وأتقنتَ الدورة الكاملة على العائلات الثلاث: تحديثُ الفهرس، فالبحث، فالتثبيت، فعرض المعلومات، فالإزالة، فترقية النظام. ورأيتَ أنّ الأسماء تختلف بين `apt` و`dnf` و`pacman`، لكنّ الأفكار واحدةٌ لا تتبدّل — فمن فهم الفكرة أتقن أيّ لهجة. بهذا نختم *الجزء الثاني* في إدارة النظام. وفي الفصل القادم نفتح بابًا جديدًا تمامًا: كيف تتدفّق مخرجات الأوامر وتُعاد توجيهها، وكيف نصل أمرًا بأمرٍ عبر *الأنابيب* لنؤلّف منها أدواتٍ لم يصنعها أحد — أول أسرار قوّة سطر الأوامر الحقيقيّة.

#challenge[
  اختر برنامجًا لم تجرّبه من قبل (`tree` أداةٌ لطيفة تعرض المجلّدات كشجرة). أولًا `apt show tree` (أو مكافئه) لتقرأ بطاقته قبل التثبيت. ثم حدّث الفهرس وثبّته. جرّبه بأمر `tree`. أخيرًا أزِله إزالةً كاملةً تشمل إعداده واعتماديّاته اليتيمة. اكتب — دون النظر إلى الجدول — الأوامرَ الأربعةَ التي استعملتها بلهجة عائلتك، ثم ترجمها إلى العائلتين الأخريين. إن استطعت ذلك، فقد صرتَ ثلاثيَّ اللسان في الحزم.
]
