#chapter[الأرشفة والنسخ الاحتياطي]

#objectives((
  [تجمع عشرات الملفّات في أرشيفٍ واحدٍ بـ `tar`، وتفكّه وتسرد محتواه دون أن تفتحه.],
  [تضغط بياناتك بـ `gzip` و `bzip2` و `xz`، وتعرف متى تختار كلًّا منها.],
  [تبني أرشيف `tar.gz` مضغوطًا في أمرٍ واحد، وتستخرج منه بثقة.],
  [تُزامن مجلّدًا كاملًا محليًّا وعبر `ssh` بـ `rsync`، وتدرك سرّ الشرطة المائلة الختامية.],
  [تصوغ استراتيجيّة نسخٍ احتياطيّ بسيطةً وموثوقة تحميك يوم الكارثة.],
))

تخيّل أنك مسافر. أمامك خزانةٌ مليئة بالثياب متناثرةً على الرفوف، وعليك أن تنقلها كلّها. لن تحمل كلَّ قطعةٍ وحدها في يدك؛ بل تجمعها أوّلًا في حقيبةٍ واحدة تسهُل حملها. ثم — لتوفّر المساحة — تكبسها وتضغط عليها حتى ينكمش حجمها. وحين تصل، قد لا تعيد نقل الخزانة كلّها في كلّ مرّة، بل تكتفي بما تغيّر منها فقط. هذه الأفعال الثلاثة — الجمعُ في حقيبة، والكبسُ لتصغير الحجم، والنقلُ الذكيّ لما تغيّر — هي بالضبط ما نتعلّمه في هذا الفصل: الأرشفةُ بـ `tar`، والضغطُ بـ `gzip` وأخواته، والمزامنةُ والنسخُ الاحتياطيّ بـ `rsync`. وهي — بلا مبالغة — الفصل الذي يقف بينك وبين فقدان عملِ سنواتٍ في لحظةٍ واحدة.

#section[الفكرتان اللتان يخلط بينهما الجميع]

قبل أوّل أمر، لِنفصل بوضوحٍ بين فكرتين يظنّهما المبتدئ شيئًا واحدًا، وهما مختلفتان تمامًا:

#define("الأرشفة (Archiving)", [
  جمعُ عدّة ملفّاتٍ ومجلّداتٍ في *ملفٍّ واحد* يحفظ أسماءها وبنيتها الشجرية وأذوناتها. الأرشفة وحدها *لا تصغّر الحجم*؛ هي كوضع عشرة كتبٍ في صندوقٍ واحد: صار حملها أسهل، لكنّ وزنها كما هو. أداةُ الأرشفة في لِينُكس اسمها `tar`.
])

#define("الضغط (Compression)", [
  إعادةُ ترميز البيانات بخوارزميّةٍ تجد الأنماط المكرّرة فتختصرها، فيصغُر الحجم فعلًا. الضغط كَبْسُ الهواء من كيسٍ مفرَّغ: المحتوى نفسه، لكنه يشغل مكانًا أقلّ. أدواتُه: `gzip` و `bzip2` و `xz`.
])

الجميل أنّ الأداتين تعملان معًا في تناغم: نجمع بـ `tar` أوّلًا، ثم نضغط النتيجة. هكذا تولد الصيغة الشهيرة `.tar.gz` — أرشيفُ `tar` مضغوطٌ بـ `gzip` — وهي أشهر حزمةِ توزيعٍ للبرمجيّات والنسخ في عالم لِينُكس كلّه.

#section[أداة الجمع: tar]

اسم `tar` اختصارٌ قديمٌ لـ «Tape Archive» (أرشيف الشريط)، من زمنٍ كانت النسخ تُحفظ على أشرطةٍ مغناطيسية. بقي الاسم، وتغيّر كلُّ شيءٍ حوله. الأمر يقوم على *أفعالٍ* رئيسة تختار واحدًا منها في كلّ مرّة، وخيارٍ لا يفارقك أبدًا هو `-f`:

- `-c` أنشئ أرشيفًا جديدًا (Create).
- `-x` استخرج من أرشيف (eXtract).
- `-t` اسرد المحتوى دون استخراج (lisT).
- `-f` حدّد اسم ملفّ الأرشيف (File) — ويأتي بعده الاسم *مباشرةً* دائمًا.
- `-v` اعرض ما يجري ملفًّا ملفًّا (Verbose).

#warn[
  الخيار `-f` قاعدةٌ ذهبية: *ما بعده هو اسم الأرشيف*. لذلك اجعله آخر الخيارات دائمًا (`-cvf` لا `-cfv`)، وإلّا ظنّ `tar` أنّ حرف `v` هو اسم ملفّك. تذكّر: `f` تصافح اسم الملفّ، فلا تدع شيئًا يفصل بينهما.
]

#subsection[إنشاء أرشيف وسرده]

لنجمع مجلّدًا كاملًا في أرشيفٍ واحد (بلا ضغطٍ بعد). نضيف `-v` لنشاهد الملفّات تدخل الحقيبة:

#session("tar -cvf documents.tar Documents/", output: "Documents/
Documents/notes.txt
Documents/report.pdf
Documents/photos/")

نتج ملفٌّ واحدٌ اسمه `documents.tar` يحوي المجلّد بكامل شجرته. والآن — قبل أن تثق بأيّ أرشيف — اسرد محتواه بالفعل `-t` لتتأكّد أنّ ما بداخله هو ما تتوقّع، دون أن تستخرج شيئًا:

#session("tar -tvf documents.tar", output: "drwxr-xr-x ghazi/ghazi   0  Documents/
-rw-r--r-- ghazi/ghazi 812  Documents/notes.txt
-rw-r--r-- ghazi/ghazi 45120  Documents/report.pdf
drwxr-xr-x ghazi/ghazi   0  Documents/photos/")

لاحظ أنّ الأرشيف حفظ الأذونات والملكيّة والأحجام — لا مجرّد الأسماء. هذا ما يجعل `tar` أداةَ النسخ الأمينة: يعيد بناء كلّ شيءٍ كما كان.

#subsection[الاستخراج]

للاستخراج نبدّل الفعل إلى `-x`. ينشر `tar` محتوى الأرشيف في المجلّد الحاليّ:

#session("tar -xvf documents.tar", output: "Documents/
Documents/notes.txt
Documents/report.pdf
Documents/photos/")

#danger[
  الاستخراج *يكتب فوق* أيّ ملفٍّ يحمل الاسم نفسه في وجهته دون سؤال. إن استخرجت أرشيفًا قديمًا فوق عملٍ جديدٍ يحمل الأسماء ذاتها، ضاع الجديد. القاعدة: اسرد أوّلًا بـ `-t` لتعرف ماذا سيخرج وأين، ثم استخرج. وإن شككت، استخرج داخل مجلّدٍ فارغٍ جديد.
]

#tip[
  لتستخرج إلى مجلّدٍ محدّدٍ بدل المجلّد الحاليّ، استعمل الخيار `-C` (بحرفٍ كبير) متبوعًا بالمسار: `tar -xvf documents.tar -C /mnt/backup/`. أنشئ المجلّد أوّلًا؛ فـ `tar` لا يخترعه لك.
]

#warn[
  بعض الأرشيفات «مبعثرة» (tarbomb): تنشر ملفّاتها في المجلّد الحاليّ مباشرةً بلا مجلّدٍ جامعٍ يحتويها، فتختلط بملفّاتك. لهذا السبب بالذات نعتاد السرد بـ `-t` قبل الاستخراج: إن رأيت الأسماء تبدأ كلّها بمجلّدٍ واحدٍ فأنت آمن، وإلّا فاستخرج داخل مجلّدٍ فارغٍ تصنعه بنفسك.
]

#try-it[
  أنشئ مجلّد تجربةٍ فيه ملفّان: `mkdir demo && echo one > demo/a.txt && echo two > demo/b.txt`. اجمعه: `tar -cvf demo.tar demo/`. اسرده: `tar -tvf demo.tar`. ثم احذف المجلّد الأصليّ `rm -r demo` واستخرجه من جديد `tar -xvf demo.tar`. هل عاد كلّ شيءٍ كما كان؟
]

#section[أدوات الضغط الثلاث]

الأرشيف `.tar` جمعَ الملفّات لكنه لم يصغّرها. الآن نكبسه. في لِينُكس ثلاث أدواتِ ضغطٍ شهيرة، تعمل كلُّها على الفكرة نفسها لكن بموازنةٍ مختلفة بين *السرعة* وبين *نسبة الانكماش*:

لنقس حجم ملفٍّ نصّيٍّ كبير قبل ضغطه (سجلُّ خادمٍ مثلًا):

#session("ls -lh access.log", output: "-rw-r--r-- 1 ghazi ghazi 26M  access.log")

الآن نضغطه. الأمر لا يطبع شيئًا عند نجاحه، لكنه *يستبدل* الملفّ `access.log` بنسخةٍ مضغوطةٍ اسمها `access.log.gz`، ويحذف الأصل:

#session("gzip access.log", output: "")

لننظر إلى النتيجة — انكمش المحتوى نفسه إلى جزءٍ يسير:

#session("ls -lh access.log*", output: "-rw-r--r-- 1 ghazi ghazi 3.2M  access.log.gz")

#warn[
  أدوات الضغط المفردة (`gzip`, `bzip2`, `xz`) *تحذف الأصل* افتراضيًّا وتُبقي المضغوط فقط. إن أردت الاحتفاظ بالنسختين، أضف الخيار `-k` (اختصار keep): `gzip -k access.log`. وتذكّر أنّها تضغط ملفًّا *واحدًا* فقط، لا مجلّدًا — ولهذا نجمع بـ `tar` أوّلًا حين تكون الملفّات كثيرة.
]

لفكّ الضغط، لكلّ أداةٍ نظيرتها، أو ببساطة الخيار `-d` (اختصار decompress):

```bash
gunzip access.log.gz      # يعيد access.log
gzip -d access.log.gz     # المكافئ تمامًا
bunzip2 data.bz2          # لملفّات bzip2
unxz backup.xz            # لملفّات xz
```

#subsection[أيّها أختار؟]

الفرق بينها موازنةٌ عمليّة، لا أفضليّةٌ مطلقة. هذا جدولٌ يلخّص متى تختار كلًّا منها:

#table(
  columns: (auto, auto, 1fr),
  [الأداة], [اللاحقة], [متى تفضّلها],
  [`gzip`], [`.gz`], [الأسرع، انكماشٌ متوسّط — الخيار الافتراضيّ اليوميّ للنسخ والنقل],
  [`bzip2`], [`.bz2`], [أبطأ، لكنه يضغط أكثر — وسطٌ بين السرعة والحجم],
  [`xz`], [`.xz`], [الأبطأ، لكنه *الأصغر حجمًا* — مثاليّ للأرشفة طويلة الأمد],
)

القاعدة العمليّة: `gzip` لعملك اليوميّ لأنه سريعٌ ومدعومٌ في كلّ مكان، و `xz` حين تؤرشف شيئًا لن تلمسه طويلًا وتريد أقلّ حجمٍ ممكن (كنسخةِ سنةٍ كاملةٍ من السجلّات). أمّا `bzip2` فقد صار أقلّ شيوعًا، وتجده في أرشيفاتٍ قديمة.

#tip[
  لكلّ أداةٍ درجاتُ ضغطٍ من `-1` (الأسرع، الأقلّ كبسًا) إلى `-9` (الأبطأ، الأشدّ كبسًا). مثلًا `xz -9 huge.tar` يعصر آخر قطرة، لكنه يستغرق وقتًا أطول. للاستعمال اليوميّ الدرجة الافتراضية كافيةٌ وموازنةٌ حسنة.
]

#section[الجمع والضغط في أمرٍ واحد: tar.gz]

لسنا مضطرّين لخطوتين منفصلتين. يفهم `tar` خيارات الضغط مباشرةً، فيجمع ويضغط دفعةً واحدة. ثلاثة خياراتٍ لثلاث أدوات:

- `-z` اضغط بـ `gzip` ‏(‏‎.tar.gz‏‏).
- `-j` اضغط بـ `bzip2` ‏(‏‎.tar.bz2‏‏).
- `-J` اضغط بـ `xz` ‏(‏‎.tar.xz‏‏) — لاحظ أنها `J` كبيرة.

فلبناء أرشيف `tar.gz` مضغوطٍ من مجلّدٍ كامل، نضمّ `-z` إلى فعل الإنشاء:

#session("tar -czvf backup.tar.gz Documents/", output: "Documents/
Documents/notes.txt
Documents/report.pdf")

اقرأ الخيارات كجملة: `c` أنشئ، `z` مضغوطًا بـ gzip، `v` وأرِني، `f` في الملفّ التالي `backup.tar.gz`. وللاستخراج، أبدل `c` بـ `x` فقط:

#session("tar -xzvf backup.tar.gz", output: "Documents/
Documents/notes.txt
Documents/report.pdf")

وللسرد قبل الاستخراج — عادتُنا الحميدة — أبدلها بـ `t`:

```bash
tar -tzf backup.tar.gz    # اسرد محتوى أرشيف مضغوط دون فكّه
tar -tJf archive.tar.xz   # ونظيره لأرشيف xz
```

#note[
  في إصدارات `tar` الحديثة (وهي ما ستلقاه) يستطيع `tar` أن *يستشعر* نوع الضغط من الملفّ تلقائيًّا عند الاستخراج، فيكفيك `tar -xvf backup.tar.gz` بلا `-z`. لكنّ ذكرَ الخيار الصريح عادةٌ حسنة توضّح نيّتك وتعمل على كلّ نظام. أمّا عند *الإنشاء* فالخيار إلزاميٌّ دائمًا، إذ لا يخمّن `tar` أنك تريد ضغطًا.
]

#try-it[
  اجمع مجلّد المستندات مرّتين: مرّةً بلا ضغط `tar -cf plain.tar Documents/`، ومرّةً مضغوطًا `tar -czf packed.tar.gz Documents/`. ثم قارن الحجمين بـ `ls -lh plain.tar packed.tar.gz`. كم وفّر الضغط؟ النسبة تعتمد على نوع محتواك: النصوص تنكمش كثيرًا، والصور والفيديو المضغوطة أصلًا لا تكاد تنكمش.
]

#section[المزامنة الذكيّة: rsync]

`tar` ممتازٌ لصنع لقطةٍ واحدةٍ مجمّدة. لكن ماذا لو أردت نسخ مجلّدٍ يتغيّر يوميًّا إلى قرصٍ احتياطيّ، كلَّ يوم؟ نسخُه كلَّه في كلّ مرّةٍ بـ `cp` هدرٌ للوقت والمساحة. هنا يتألّق `rsync`.

#define("rsync (المزامنة)", [
  أداةٌ تجعل مجلّدًا في الوجهة *مطابقًا* لمجلّدٍ في المصدر، لكنها لا تنقل إلّا *ما تغيّر فعلًا*: الملفّات الجديدة والمعدّلة فقط، بل وأجزاء الملفّات المتغيّرة أحيانًا. هذا يجعل النسخة الثانية وما بعدها أسرعَ بمراتٍ من الأولى. تعمل محليًّا وعبر الشبكة (`ssh`) بالكفاءة نفسها.
])

الصيغة الأساس: `rsync [خيارات] المصدر الوجهة`. وأشهر خياراتها ثلاثة تكاد لا تفارقها:

- `-a` وضع الأرشفة (Archive): يَنسخ بتكرارٍ في كلّ المجلّدات الفرعية، ويحفظ الأذونات والأوقات والروابط الرمزية والملكيّة. هو باختصارٍ «انسخ كلّ شيءٍ كما هو».
- `-v` أرِني ما يُنقل (Verbose).
- `--delete` احذف من الوجهة ما لم يعد موجودًا في المصدر (نبلغه بعد قليل، وله بابُ حذرٍ خاصّ).

نبدأ بمزامنةٍ محليّةٍ آمنة (بلا حذف): انسخ مجلّد المستندات إلى قرصٍ احتياطيّ مركّبٍ على `/mnt/backup`:

#session("rsync -av ~/Documents/ /mnt/backup/Documents/", output: "sending incremental file list
notes.txt
report.pdf
photos/vacation.jpg

sent 4,812,004 bytes  received 88 bytes  9,624,184.00 bytes/sec
total size is 4,810,772  speedup is 1.00")

في المرّة الأولى يُنقل كلُّ شيء. جرّب الأمر نفسه مرّةً ثانيةً بعد لحظات، دون تغيير أيّ ملفّ:

#session("rsync -av ~/Documents/ /mnt/backup/Documents/", output: "sending incremental file list

sent 1,204 bytes  received 18 bytes  2,444.00 bytes/sec
total size is 4,810,772  speedup is 3,936.80")

لم يُنقل شيء! أدرك `rsync` أنّ الوجهة مطابقةٌ للمصدر، فاكتفى بفحصٍ سريعٍ ولم يُتعب القرص. هذا هو جوهر قوّته: أنت تشغّله كلّ يومٍ بأمان، وهو لا يعمل إلّا بقدر ما تغيّر.

#subsection[سرّ الشرطة المائلة الختامية]

هنا أكثرُ ما يُعثِر المبتدئين في `rsync`، وهو دقيقٌ فاحفظه جيّدًا. الفرق بين وجود الشرطة المائلة `/` في آخر *المصدر* وغيابها يغيّر المعنى كلَّه:

#table(
  columns: (auto, 1fr),
  [الأمر], [النتيجة],
  [`rsync -a src/ dest/`], [ينسخ *محتويات* `src` إلى داخل `dest` مباشرة],
  [`rsync -a src dest/`], [ينسخ *المجلّد نفسه*، فينشئ `dest/src/`],
)

فكّر في الشرطة الختامية على أنها تقول: «خذ *ما بداخل* هذا المجلّد». فـ `src/` تعني «محتويات src»، و `src` (بلا شرطة) تعني «مجلّد src ككتلة». لو أخطأت هنا حصلت على `‎/mnt/backup/Documents/Documents/` — مجلّدٌ متداخلٌ داخل نفسه.

#tip[
  القاعدة التي تُريحك: *ضع الشرطة الختامية على المصدر والوجهة معًا دائمًا*، واقرأها «انسخ محتوى هذا إلى داخل ذاك». التزم بها في كلّ أوامرك تسلَم من هذا الخطأ إلى الأبد. أمّا الوجهة فوجودُ الشرطة عليها لا يغيّر شيئًا يُذكر — العبرة كلّها بشرطة *المصدر*.
]

#warn[
  قبل أيّ أمر `rsync` مصيريّ، شغّله بالخيار `-n` (أو `--dry-run`): يُظهر لك *ما كان سينقله ويحذفه دون أن يفعل شيئًا فعلًا*. هذه بروفةٌ مجّانية تكشف خطأ الشرطة المائلة أو الوجهة الخاطئة قبل وقوعه. اجعلها عادةً: `rsync -avn ...` أوّلًا، فإذا أعجبك الناتج، احذف `n`.
]

#subsection[المزامنة عبر الشبكة بـ ssh]

جمال `rsync` أنّ الوجهة قد تكون خادمًا بعيدًا، والصيغة تتغيّر بحرفٍ واحد: نكتب الوجهة على شكل `user@host:path`، تمامًا كما في `ssh` الذي تعلّمته. يمرّ كلُّ شيءٍ حينها مشفَّرًا عبر نفق `ssh`:

#session("rsync -avz ~/Documents/ ghazi@server:/home/ghazi/backup/", output: "sending incremental file list
notes.txt
report.pdf

sent 4,801,120 bytes  received 62 bytes  1,920,472.80 bytes/sec
total size is 4,810,772  speedup is 1.00")

أضفنا هنا الخيار `-z` (اختصار compress): يضغط البيانات *أثناء النقل عبر الشبكة* فقط، فيسرّع الإرسال على الاتصالات البطيئة. وهو مفيدٌ عبر الشبكة تحديدًا؛ أمّا في النسخ المحليّ من قرصٍ إلى قرصٍ فلا داعي له. وبالطبع تعمل في الاتجاهين: اجعل المصدر بعيدًا والوجهة محليّةً لتسحب من الخادم بدل أن تدفع إليه.

#try-it[
  جرّب المزامنة المحليّة أوّلًا (لا تحتاج خادمًا): `mkdir -p /tmp/src /tmp/dst && echo hello > /tmp/src/f.txt`، ثم `rsync -av /tmp/src/ /tmp/dst/`. عدّل الملفّ `echo world >> /tmp/src/f.txt` وأعد الأمر: لاحظ أنه نقل الملفّ الواحد المتغيّر فقط. أخيرًا جرّب `-avn` لترى البروفة الجافّة.
]

#section[الخيار الحادّ: `--delete`]

حتى الآن كانت مزامناتُنا *مضيفةً* فقط: تضيف الجديد وتحدّث المعدّل، لكنها لا تحذف. لكن ماذا لو حذفت ملفًّا من المصدر وأردت أن يختفي من النسخة أيضًا، لتبقى النسخة مرآةً وفيّة؟ هنا يأتي `--delete`.

#session("rsync -av --delete ~/Documents/ /mnt/backup/Documents/", output: "sending incremental file list
deleting old-draft.txt

sent 1,402 bytes  received 44 bytes  2,892.00 bytes/sec
total size is 4,806,701  speedup is 3,324.14")

الآن صارت الوجهة *مرآةً* دقيقة للمصدر: كلُّ ما حُذف هنا يُحذف هناك.

#danger[
  الخيار `--delete` سيفٌ ذو حدّين! فهو يحذف من الوجهة كلَّ ما ليس في المصدر — وإن كتبت *مصدرًا خاطئًا أو فارغًا*، حوّلت نسختك الاحتياطية إلى مجلّدٍ فارغ في لحظة. تخيّل خطأً مثل `rsync -av --delete ~/Docs/ /mnt/backup/` بينما اسم المجلّد الحقيقيّ `Documents` لا `Docs`: المصدر غير موجودٍ فيراه `rsync` فارغًا، فيمسح النسخة كلَّها لتطابقه. *لا تشغّل `--delete` أبدًا* دون أن تسبقه ببروفة `-avn --delete` تقرأ سطور `deleting` فيها بعينك أوّلًا.
]

#warn[
  خطأٌ شائعٌ آخر: نسيان الشرطة الختامية *مع* `--delete`. لو كتبت المصدر بلا شرطة، تغيّر معنى ما يُزامَن، وقد يحذف `rsync` أشياء لم تقصدها. اجتماع `--delete` مع خطأ الشرطة المائلة هو أخطر تركيبةٍ في هذا الفصل، والبروفة الجافّة هي حزامُ أمانك منها.
]

#section[من الأوامر إلى الاستراتيجية]

تعلّمنا الأدوات؛ لكنّ النسخ الاحتياطيّ ليس أمرًا تكتبه، بل *عادةً* تبنيها. مدير النظام الذي «ينوي» أن ينسخ ولا يفعل، سيّان ومَن لا نسخة له. إليك قاعدةً عالميّةً بسيطةً يعمل بها المحترفون:

#define("قاعدة ٣-٢-١", [
  استراتيجيّةٌ ذهبيّةٌ للنسخ الاحتياطيّ: احتفظ بـ *ثلاث* نسخٍ من بياناتك المهمّة (الأصل ونسختان)، على *نوعين* مختلفين من الوسائط (قرصٌ داخليّ وقرصٌ خارجيّ مثلًا)، مع *واحدةٍ* منها في *موقعٍ بعيد* (خادمٌ أو سحابة). هكذا لا يمحوك عطلُ قرصٍ واحد، ولا حريقٌ ولا سرقةٌ في مكانٍ واحد.
])

لماذا كلُّ هذا التكرار؟ لأنّ الكوارث لا تستأذن: قرصٌ يتعطّل فجأةً، أو أمرُ `rm -rf` طائشٌ في اللحظة الخطأ، أو برمجيّةُ فديةٍ تشفّر ملفّاتك، أو ببساطةٍ حاسوبٌ يُسرق. النسخة الواحدة على القرص نفسه لا تحميك من أيٍّ من هذه؛ ولهذا نوزّع النسخ على وسائط وأماكن.

#subsection[نسخة يوميّة بسيطة وموثوقة]

لنترجم القاعدة إلى شيءٍ تشغّله فعلًا. أبسط نسخةٍ احتياطيّةٍ نافعة هي مزامنة `rsync` يوميّةٍ لمجلّد منزلك إلى قرصٍ خارجيّ:

```bash
#!/bin/bash
# نسخة احتياطية يومية بسيطة لمجلد المنزل إلى قرص خارجي
# نستعمل --dry-run أولًا يدويًا للتأكد، ثم نزيله
SRC="$HOME/"
DST="/mnt/backup/home/"
rsync -av --delete "$SRC" "$DST"
echo "اكتملت النسخة: $(date)"
```

#note[
  تعلّمنا في فصل الأتمتة كيف نحفظ نصًّا كهذا في ملفٍّ، ونمنحه صلاحية التنفيذ بـ `chmod +x backup.sh`، ونشغّله. ولجعله يعمل *تلقائيًّا* كلّ ليلةٍ دون تدخّلك، نجدوله بـ `cron` أو مؤقّتات `systemd` (وقد مرّ بك ذكرهما في فصل الإقلاع والخدمات). النسخة التي تعمل وحدها هي النسخة التي تنجو فعلًا.
]

#tip[
  للأرشفة طويلة الأمد (نسخة شهرٍ أو سنةٍ تحفظها بعيدًا)، الأنسب لقطةٌ مضغوطةٌ واحدةٌ مؤرّخةٌ باسمها، لا مزامنةٌ حيّة:

  `tar -czf home-$(date +%Y-%m-%d).tar.gz ~/`

  فينتج ملفٌّ اسمه مثل `home-2026-07-20.tar.gz` تنقله إلى مكانٍ آمن. الجمع بين مزامنة `rsync` اليوميّة ولقطات `tar` الدوريّة استراتيجيّةٌ متينةٌ تكفي أغلب الأفراد.
]

#danger[
  نسخةٌ احتياطيّةٌ *لم تختبر استعادتها* ليست نسخةً احتياطية — بل وهمٌ يطمئنك زورًا. كثيرون اكتشفوا يوم الكارثة أنّ أرشيفهم تالفٌ أو ناقص. اجعلها عادةً دوريّة: استخرج نسخةً إلى مجلّدٍ مؤقّتٍ (`tar -xzf backup.tar.gz -C /tmp/test-restore/`) وتحقّق أنّ ملفّاتك سليمةٌ كاملة. الثقة تُختبر، لا تُفترض.
]

#distro[
  كلُّ أدوات هذا الفصل — `tar` و `gzip` و `bzip2` و `xz` و `rsync` — قياسيّةٌ حاضرةٌ في كلّ توزيعات لِينُكس بالأسماء والخيارات نفسها تمامًا، بلا أيّ اختلاف. إن غاب `rsync` عن نظامٍ مقتضبٍ فثبّته: `sudo apt install rsync` على دبيان/أوبونتو، و `sudo pacman -S rsync` على أرش، و `sudo dnf install rsync` على فيدورا.
]

#section[خلاصة الفصل]

فرّقنا بين فكرتين: *الأرشفة* (جمعٌ بلا تصغير) وبين *الضغط* (تصغيرٌ فعليّ). جمعنا بـ `tar` مستعملين أفعاله `-c` و `-x` و `-t` مع رفيقه الدائم `-f`، وضغطنا بـ `gzip` و `bzip2` و `xz`، ثم دمجناهما في صيغة `.tar.gz` بخيارٍ واحد (`-z` أو `-j` أو `-J`). ثم انتقلنا إلى `rsync`، فتعلّمنا وضع الأرشفة `-a`، وأهمّية *الشرطة المائلة الختامية* التي تحسم ماذا يُنسخ إلى أين، والمزامنة عبر `ssh` بحرفٍ واحد، وخطورة `--delete` وحزامَ الأمان `--dry-run`. وأخيرًا رفعنا رؤوسنا من الأوامر إلى الاستراتيجية: قاعدة ٣-٢-١، والنسخة الآليّة التي تعمل وحدها، والحقيقة التي تنقذ يوم الكارثة — أنّ نسخةً لم تُختبر استعادتها ليست نسخة. في الفصل التالي نغوص أعمق في النظام الحيّ: ضبط النواة ومعاملاتها.

#challenge[
  ابنِ نظام نسخٍ صغيرًا كاملًا بيديك. (١) أنشئ مجلّد `~/important` وضع فيه ملفّين أو ثلاثة. (٢) اصنع لقطةً مضغوطةً مؤرّخة: `tar -czvf important-$(date +%F).tar.gz ~/important/`، ثم اسرد محتواها بـ `tar -tzf` للتأكّد. (٣) أنشئ وجهةً `mkdir ~/backup-dest`، وزامن إليها بـ `rsync -av ~/important/ ~/backup-dest/` — ثم *قبل* إضافة `--delete`، جرّبها بروفةً جافّة `rsync -avn --delete ~/important/ ~/backup-dest/` واقرأ ماذا كانت ستحذف. (٤) أخيرًا اختبر الاستعادة: احذف ملفًّا من `~/important`، واستخرجه وحده من لقطتك المضغوطة. هل استعدته سالمًا؟ إن نجحت، فأنت الآن تملك ما يفتقده كثيرٌ من المحترفين: نسخةً *مُختبَرة*.
]
