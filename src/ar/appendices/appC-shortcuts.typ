  [#kbd("Ctrl") + #kbd("C")], [أوقِف الأمر الجاري (يرسل إشارة الإنهاء SIGINT).],
  [#kbd("Ctrl") + #kbd("D")], [أرسِل نهاية الإدخال؛ وعلى سطرٍ فارغٍ يُنهي الصدفة (مثل `exit`).],
  [#kbd("Ctrl") + #kbd("Z")], [علّق الأمر الجاري وأعِده إلى الخلفيّة (استأنفه بـ `fg`).],
  [#kbd("Ctrl") + #kbd("L")], [امسح الشاشة مع إبقاء السطر الذي تكتبه (مثل `clear`).],
)

#warn[
  إن جمّدت طرفيّتك فجأةً بعد ضغط #kbd("Ctrl") + #kbd("S") فلا تظنّها تعطّلت: هذا الاختصار يوقف عرض المخرجات مؤقّتًا. اضغط #kbd("Ctrl") + #kbd("Q") ليعود كلّ شيءٍ إلى طبيعته.
]

#section[لمحة عن tmux]

‏tmux مُقسّمٌ للطرفيّة يبقي جلساتك حيّةً بعد انقطاعك (يفصّله الفصل الثامن والثلاثون). كلّ اختصاراته تبدأ بالمفتاح *البادئ* #kbd("Ctrl") + #kbd("b")، تضغطه ثم تُفلته، ثم تضغط المفتاح التالي.

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 0 { center + horizon } else { right + horizon },
  table.header([بعد البادئ], [الوظيفة]),
  [#kbd("d")], [افصِل عن الجلسة مع بقائها تعمل (أعِد الوصل بـ `tmux attach`).],
  [#kbd("c")], [افتح نافذةً جديدة.],
  [#kbd("n") / #kbd("p")], [انتقل إلى النافذة التالية أو السابقة.],
  [#kbd("0") … #kbd("9")], [اقفز إلى النافذة بهذا الرقم.],
  [#kbd("%")], [اقسِم اللوح عموديًّا (يمينًا ويسارًا).],
  [#kbd("\"")], [اقسِم اللوح أفقيًّا (أعلى وأسفل).],
  [#kbd("←") #kbd("→") #kbd("↑") #kbd("↓")], [تنقّل بين الألواح باتجاه السهم.],
  [#kbd("z")], [كبّر اللوح الحالي لملء الشاشة، ثم أعِده بالضغط ثانيةً.],
  [#kbd("[")], [ادخل نمط التمرير والنسخ (اخرج بحرف `q`).],
  [#kbd("x")], [أغلِق اللوح الحالي (بعد تأكيد).],
)

#section[أساسيّات vim]

‏vim محرّرٌ ذو *أنماط*: تدخل بنمط الأمر لا الإدراج، فالحروف حركاتٌ لا نصّ. اضغط #kbd("Esc") دائمًا لتعود إلى نمط الأمر، ومنه تكتب الأوامر التالية. يكفيك هذا القدر لتنقذ نفسك على أيّ خادم (والفصل الثامن عشر يفصّله).

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 0 { center + horizon } else { right + horizon },
  table.header([الأمر], [الوظيفة]),
  [`i`], [ادخل نمط الإدراج قبل المؤشّر (اخرج منه بـ #kbd("Esc")).],
  [`:w`], [احفظ الملفّ دون خروج.],
  [`:q`], [اخرج (إن لم تكن هناك تغييراتٌ غير محفوظة).],
  [`:wq`], [احفظ ثم اخرج (ويكافئه `ZZ`).],
  [`:q!`], [اخرج قسرًا متجاهلًا كلّ التغييرات.],
  [`x`], [احذف الحرف الذي عند المؤشّر.],
  [`dd`], [احذف السطر كاملًا.],
  [`yy` / `p`], [انسخ السطر / ألصِقه بعد السطر الحالي.],
  [`u`], [تراجَع؛ و#kbd("Ctrl") + #kbd("r") يعيد ما تراجعتَ عنه.],
  [`gg` / `G`], [اقفز إلى أوّل الملفّ / آخره.],
  [`/نصّ`], [ابحث عن نصٍّ للأمام؛ و`n` للنتيجة التالية.],
  [`:%s/قديم/جديد/g`], [استبدل «قديم» بـ«جديد» في كلّ الملفّ.],
)

#tip[
  إن دخلتَ vim دون قصدٍ ولم تعرف كيف تخرج، اضغط #kbd("Esc") ثم اكتب `:q!` واضغط #kbd("Enter"). هذا يخرجك بأمانٍ دون حفظ مهما كان ما فعلتَه.
]
