#appendix("ج", "اختصارات لوحة المفاتيح")

يدُك على لوحة المفاتيح أسرعُ منها على الفأرة، والمحترف يكاد لا يغادرها. هذا الملحق يجمع أنفع اختصارات الصدفة التي تختصر عليك حركاتٍ كثيرة؛ اختر منها كلّ يومٍ اثنين حتى تصير في أصابعك، ولا تحاول حفظها دفعةً واحدة.

#note[
  اختصارات تحرير السطر أدناه من مكتبةٍ اسمها *Readline*، وهي عقل الصدفة في التحرير. تعمل افتراضيًّا في نمط «إيماكس» في bash، وتعمل كذلك في كثيرٍ من الأدوات الأخرى مثل `psql` وواجهة python. من فضّل مفاتيح vim فليكتب `set -o vi` في ملفّ `~/.bashrc`.
]

#section[تحرير السطر: تنقّلٌ وحذفٌ ولصق]

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 0 { center + horizon } else { right + horizon },
  table.header([المفتاح], [الوظيفة]),
  [#kbd("Ctrl") + #kbd("A")], [انقل المؤشّر إلى بداية السطر.],
  [#kbd("Ctrl") + #kbd("E")], [انقل المؤشّر إلى نهاية السطر.],
  [#kbd("Ctrl") + #kbd("←") \ #kbd("Alt") + #kbd("B")], [ارجع بالمؤشّر كلمةً واحدةً إلى الخلف.],
  [#kbd("Ctrl") + #kbd("→") \ #kbd("Alt") + #kbd("F")], [تقدّم بالمؤشّر كلمةً واحدةً إلى الأمام.],
  [#kbd("Ctrl") + #kbd("U")], [احذف من المؤشّر إلى بداية السطر.],
  [#kbd("Ctrl") + #kbd("K")], [احذف من المؤشّر إلى نهاية السطر.],
  [#kbd("Ctrl") + #kbd("W")], [احذف الكلمة التي قبل المؤشّر.],
  [#kbd("Alt") + #kbd("D")], [احذف الكلمة التي بعد المؤشّر.],
  [#kbd("Ctrl") + #kbd("Y")], [ألصِق آخر ما حذفتَه بالاختصارات أعلاه.],
  [#kbd("Ctrl") + #kbd("T")], [بادِل الحرفَ عند المؤشّر بالذي قبله.],
  [#kbd("Ctrl") + #kbd("_")], [تراجَع عن آخر تعديلٍ على السطر.],
)

#tip[
  اجتماع #kbd("Ctrl") + #kbd("W") ثم #kbd("Ctrl") + #kbd("Y") يقصّ كلمةً ثم يلصقها في موضعٍ آخر — قصٌّ ولصقٌ بلا فأرة. وحين تكتب سطرًا طويلًا ثم تريد إلغاءه كلّه، #kbd("Ctrl") + #kbd("U") أسرع من الإبقاء على مفتاح المسح.
]

#section[سجلّ الأوامر: لا تكتب ما كتبتَه مرّة]

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 0 { center + horizon } else { right + horizon },
  table.header([المفتاح], [الوظيفة]),
  [#kbd("↑") / #kbd("↓")], [تنقّل بين الأوامر السابقة واللاحقة في السجلّ.],
  [#kbd("Ctrl") + #kbd("R")], [ابحث في السجلّ رجوعًا بالكتابة؛ كرّره لتقفز أقدم، و#kbd("Enter") ينفّذ، و#kbd("Ctrl") + #kbd("G") يلغي.],
  [#kbd("Alt") + #kbd(".")], [أدرِج آخر مُعطًى من الأمر السابق؛ كرّره لتستدعي أوامر أقدم.],
  [`!!`], [كرّر الأمر السابق كاملًا (مثال: `sudo !!`).],
  [`!$`], [آخر مُعطًى من الأمر السابق.],
  [`!*`], [كلّ مُعطيات الأمر السابق.],
  [`!نصّ`], [كرّر آخر أمرٍ بدأ بهذا النصّ.],
  [`^قديم^جديد`], [أعِد تنفيذ الأمر السابق بعد استبدال أوّل «قديم» بـ«جديد».],
)

