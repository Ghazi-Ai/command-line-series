  set text(size: SIZE.small)
  table(
    columns: (auto, 1fr, auto),
    inset: 6pt,
    align: (x, y) => if x == 2 { center + horizon } else { right + horizon },
    table.header([البرنامج], [متى تختاره], [الأساس]),

    [GNOME Boxes],
    [الأبسط والأنسب للمبتدئ: واجهةٌ نظيفةٌ تُنشئ جهازًا بثلاث نقرات، وتنزّل صور بعض التوزيعات نيابةً عنك. أقلّ خياراتٍ لكن أسهل بداية.],
    [QEMU/KVM],

    [virt-manager],
    [الأقوى والأكثر تحكّمًا: يكشف كلّ تفاصيل العتاد الافتراضيّ (المعالجات، الشبكات، الأقراص) ويدير لقطاتٍ متقدّمة. خيار من يريد الاحتراف.],
    [QEMU/KVM],

    [VirtualBox],
    [من أوراكل، ويعمل بالطريقة نفسها على ويندوز وماك أيضًا، فهو مألوفٌ إن جئت منهما. عمليٌّ لكنّه ليس أصيلًا في لِينُكس مثل الخيارين قبله.],
    [VirtualBox],
  )
})

#note[
  الخياران الأوّلان (Boxes و virt-manager) يبنيان على تقنية KVM المدمجة في نواة لِينُكس نفسها، فهما الأسرع والأخفّ على هذا النظام. توصيتنا: ابدأ بـ GNOME Boxes، وانتقل إلى virt-manager حين تضيق بك خياراته.
]

#section[التثبيت عبر apt]

كلّ هذه البرامج في مستودعات دبيان وأوبونتو الرسميّة، فالتثبيت أمرٌ واحد. اختر واحدًا مما يلي:

#table(
  columns: (auto, 1fr),
  align: right + horizon,
  table.header([البرنامج], [أمر التثبيت]),
  [GNOME Boxes],  [`sudo apt install gnome-boxes`],
  [virt-manager], [`sudo apt install virt-manager qemu-kvm libvirt-daemon-system`],
  [VirtualBox],   [`sudo apt install virtualbox`],
)

بعد تثبيت virt-manager، أضِف مستخدمك إلى مجموعتَي `libvirt` و`kvm` كي تدير الأجهزة دون طلب صلاحيّة الجذر في كلّ مرّة، ثم أعِد تسجيل الدخول ليسري التغيير:

```bash
sudo usermod -aG libvirt,kvm $USER
```

#distro[
  على أرش: `sudo pacman -S gnome-boxes`، أو `sudo pacman -S virt-manager qemu-full libvirt` لمنظومة virt-manager. وعلى فيدورا: `sudo dnf install gnome-boxes`، أو `sudo dnf install @virtualization` لمنظومة virt-manager. وحزمة VirtualBox على فيدورا تأتي من مستودع RPM Fusion لا من المستودع الرسميّ.
]

#warn[
  حزمة `virtualbox` في أوبونتو تسكن مستودع «multiverse»؛ فإن لم يجدها `apt` فعّله أوّلًا بأمر `sudo add-apt-repository multiverse` ثم `sudo apt update`. وكثيرًا ما تحتاج بعد التثبيت إلى إضافة مستخدمك لمجموعة `vboxusers` بأمر `sudo usermod -aG vboxusers $USER`.
]

#section[تنزيل صورة النظام (ISO)]

لتثبّت نظامًا داخل الجهاز الافتراضيّ تحتاج «صورة قرصٍ» بامتداد `.iso`، وهي ملفٌّ واحدٌ يحوي مثبّت التوزيعة. نزّلها من الموقع الرسميّ للتوزيعة حصرًا — لا من مواقع وسيطة:

#table(
  columns: (auto, 1fr),
  align: right + horizon,
  table.header([التوزيعة], [رابط التنزيل الرسميّ]),
  [أوبونتو], [`https://ubuntu.com/download/desktop`],
  [دبيان],   [`https://www.debian.org/distrib/`],
)

للمبتدئ نوصي بإصدار أوبونتو ذي الدعم الطويل (LTS)؛ فهو مستقرٌّ ومدعومٌ سنوات، ووثائقه أوفر. احفظ الملفّ في مجلّد تنزيلاتك؛ حجمه بضعة غيغابايت.

#tip[
  ينشر كلّ موقعٍ رسميٍّ بصمةً تعميّةً (SHA256) لصورته. تحقّق أنّ تنزيلك سليمٌ وغير مبتور بمطابقة بصمة ملفّك مع المنشورة: `sha256sum ubuntu-24.04-desktop-amd64.iso`. تطابُق السلسلتين ضمانُ سلامة الملفّ.
]

#note[
  GNOME Boxes يختصر هذه الخطوة أحيانًا: يعرض قائمةً بالتوزيعات الشائعة وينزّل صورتها نيابةً عنك، فلا تحتاج إلى زيارة الموقع يدويًّا. لكنّ معرفة الطريقة اليدويّة تنفعك مع أيّ توزيعةٍ غير مدرجة.
]

#section[إنشاء الجهاز وتخصيص موارده]

الخطوات متشابهةٌ في البرامج الثلاثة: تنشئ جهازًا جديدًا، وتشير إلى صورة الـ ISO، وتخصّص له ذاكرةً وقرصًا، ثم تُقلعه ليبدأ المثبّت. في GNOME Boxes مثلًا: افتح البرنامج، انقر «+» ثم «Install from file»، اختر صورة الـ ISO، اضبط الموارد، ثم «Create». وفي virt-manager: «New Virtual Machine» ‏ثم «Local install media» ‏ثم أشِر إلى الصورة.

أمّا مقدار الموارد فهذا دليلٌ متوازنٌ لتثبيت لِينُكس سطحِ مكتبٍ للتعلّم:

#table(
  columns: (auto, auto, 1fr),
  align: (x, y) => if x == 2 { right + horizon } else { center + horizon },
  table.header([المورد], [قيمةٌ مريحة], [ملاحظة]),
  [الذاكرة (RAM)],
  [٤ غيغابايت],
  [لا تمنح الجهاز الافتراضيّ أكثر من نصف ذاكرة جهازك الحقيقيّ، وإلّا اختنق النظامان معًا. غيغابايتان يكفيان لسطح مكتبٍ خفيف.],

  [المعالجات (vCPU)],
  [نواتان],
  [نواةٌ واحدةٌ تكفي للتجارب النصّية، ونواتان تجعلان الواجهة الرسوميّة أسلس.],

  [القرص],
  [٢٥ غيغابايت],
  [أغلب البرامج تُنشئ قرصًا «متمدّدًا» لا يحجز المساحة كاملةً دفعةً واحدة، بل ينمو مع الاستعمال، فكن سخيًّا في الرقم دون قلق.],
)

بعد ضبط الموارد يُقلع الجهاز من صورة الـ ISO ويظهر مثبّت التوزيعة داخل النافذة؛ اتبع خطواته كأنّك تثبّت على حاسوبٍ حقيقيّ. حين ينتهي ويطلب إعادة التشغيل، يُقلع الجهاز هذه المرّة من قرصه الافتراضيّ إلى نظامٍ كاملٍ جاهزٍ للعبث.

#section[اللقطات: شبكة الأمان]

هنا جوهر المختبر. *اللقطة* تجميدٌ لحالة الجهاز الافتراضيّ كاملةً — قرصه وذاكرته — في لحظةٍ بعينها، تعود إليها متى شئت. خذ لقطةً «نظيفة» فور انتهاء التثبيت وقبل أيّ تجربةٍ خطيرة، فإن انهار كلّ شيءٍ رجعت إليها في ثوانٍ.

#subsection[في الواجهة الرسوميّة]

في virt-manager: افتح نافذة الجهاز، ثم أيقونة اللقطات في الشريط، ثم «+» لإنشاء لقطةٍ باسمٍ تختاره؛ وللرجوع اخترها من القائمة واضغط «Run selected snapshot». وفي GNOME Boxes: من إعدادات الجهاز، لسان «Snapshots»، زر «+» لأخذ لقطة، وسهم الرجوع لاستعادتها.

#subsection[في سطر الأوامر]

لعشّاق الطرفيّة، تدير أداة `virsh` (مع virt-manager/KVM) اللقطات بأوامر واضحة. لنفترض أنّ جهازك اسمه `ubuntu-lab`:

```bash
# خذ لقطةً باسمٍ ووصف
virsh snapshot-create-as --domain ubuntu-lab \
      --name clean-base --description "تثبيتٌ نظيف"

# اعرض كلّ لقطات الجهاز
virsh snapshot-list ubuntu-lab

# ارجع إلى اللقطة (تراجعٌ فوريّ)
virsh snapshot-revert --domain ubuntu-lab --snapshotname clean-base

# احذف لقطةً لم تعُد تحتاجها
virsh snapshot-delete --domain ubuntu-lab --snapshotname clean-base
```

أمّا في VirtualBox فالأداة `VBoxManage`، والمنطق نفسه:

```bash
VBoxManage snapshot "ubuntu-lab" take clean-base
VBoxManage snapshot "ubuntu-lab" list
VBoxManage snapshot "ubuntu-lab" restore clean-base
```

#danger[
  الرجوع إلى لقطةٍ يمحو كلّ ما جدّ على الجهاز بعد أخذها محوًا لا رجعة فيه: ملفّاتٌ أنشأتها، وبرامج ثبّتّها، وإعداداتٌ غيّرتها — كلّها تزول. هذا هو المقصود بالضبط في مختبر التعلّم، لكن لا تحفظ داخل الجهاز الافتراضيّ عملًا مهمًّا تخشى فقده؛ انسخه خارجه أوّلًا.
]

#tip[
  عادةٌ ذهبيّة: قبل كلّ تجربةٍ توصف بأنّها «خطيرة» في هذا الكتاب — تقسيم قرص، أو `dd`، أو حذفٌ واسع، أو تعديل ملفّات النظام — خذ لقطةً سريعة. جرّب بحريّةٍ مطلقة، فإن ساءت الأمور فاللقطة تعيدك سالمًا. هكذا يتحوّل الخوف من الخطأ إلى فضولٍ للتجربة.
]

#section[خلاصة]

بنيتَ الآن ملعبًا آمنًا: عرفت لماذا يعزلك الجهاز الافتراضيّ عن الكارثة، واخترت برنامجًا مضيفًا وثبّتّه، ونزّلت صورة نظامٍ رسميّة، وأنشأت جهازًا وخصّصت موارده، وتعلّمت أهمّ مهارةٍ فيه: اللقطة التي تعيدك إلى نقطة الصفر. لم يبقَ إلا أن تفتح طرفيّة الجهاز الافتراضيّ وتجرّب كلّ ما في هذا الكتاب بلا خوف — فأسوأ ما قد يحدث لقطةٌ ترجع إليها.
