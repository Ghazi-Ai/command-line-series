// ═══════════════════════════════════════════════════════════════════════════
//  رموز التصميم (Design Tokens) — «من الصِّفر إلى الجذر»
//  المصدر الوحيد للحقيقة في الألوان والخطوط والمقاسات.
//  غيّر هنا، يتغيّر الكتاب كله. لا تكتب لونًا أو اسم خطٍّ مباشرة في أي مكان آخر.
// ═══════════════════════════════════════════════════════════════════════════

// ── لوحة الألوان ──────────────────────────────────────────────────────────
// فلسفة اللون: حبرٌ دافئ على ورقٍ دافئ (راحة للعين في القراءة الطويلة)،
// وأخضرٌ صنوبريّ هادئ يوحي بالطرفية دون ابتذال، وطوبيّ للحظات «جرّب بنفسك».
#let COLOR = (
  ink:        rgb("#26242E"),  // نص المتن الأساسي
  paper:      rgb("#FCFBF9"),  // خلفية الصفحة (أبيض دافئ يخفّف الوهج)
  muted:      rgb("#6E6B78"),  // تعليقات، أرقام، نص ثانوي
  rule:       rgb("#E4E1D9"),  // خطوط فاصلة خفيفة

  primary:      rgb("#1F6F5C"),  // الأخضر الصنوبري — العناوين والقواعد
  primaryDeep:  rgb("#164A3E"),  // أعمق — أرقام الفصول والأجزاء
  primaryTint:  rgb("#E9F1EE"),  // خلفيات خضراء خفيفة

  accent:     rgb("#C0592B"),  // الطوبي — «جرّب بنفسك» واللمسات
  accentTint: rgb("#FBEDE5"),

  info:       rgb("#2C6084"),  // أزرق — الملاحظات وصناديق التوزيعات
  infoTint:   rgb("#E9F0F5"),

  warn:       rgb("#9C6B10"),  // كهرماني — التحذيرات
  warnTint:   rgb("#FAF1DC"),

  danger:     rgb("#A5342B"),  // أحمر — الأخطاء والأخلاقيات والقانون
  dangerTint: rgb("#F9EAE7"),

  codeBg:     rgb("#F5F3EC"),  // خلفية كتل الكود (رماديّ دافئ)
  codeBorder: rgb("#E5E1D5"),
  codeInline: rgb("#164A3E"),  // لون الكود المضمّن في السطر
)

// ── الخطوط ────────────────────────────────────────────────────────────────
// bodyAr:    متن العربية — IBM Plex Sans Arabic: عصري، تقنيّ، عالي الوضوح.
// displayAr: عناوين الأجزاء والفصول — Noto Kufi Arabic: هندسيّ، مميّز، فخم.
// classicAr: بديل كلاسيكي (Amiri) — بدّل bodyAr إليه إن أردت طابعًا كتابيًا.
// mono:      الأكواد — JetBrains Mono: أوضح خط برمجيّ (صفر منقّط، I l 1 مميّزة).
//            وهو خالٍ من العربية، والتعليقات داخل الأكواد عربيّة؛ فيُتبَع صراحةً
//            بـIBM Plex Sans Arabic ليكون احتياطيَّها. لولا هذا التصريح لاختار
//            Typst بديلًا من تلقائه فيختلف التصفيف بين جهازٍ وآخر.
// bodyLatin: النص اللاتيني ونسخة الإنجليزية — IBM Plex Sans (نفس عائلة المتن).
#let FONT = (
  bodyAr:    "IBM Plex Sans Arabic",
  displayAr: "Noto Kufi Arabic",
  classicAr: "Amiri",
  mono:      ("JetBrains Mono", "IBM Plex Sans Arabic"),
  bodyLatin: "IBM Plex Sans",
  serifLatin: "IBM Plex Serif",
)

// ── المقاسات (مضبوطة لصفحة A5) ────────────────────────────────────────────
#let SIZE = (
  body:     10.5pt,   // متن مريح على A5
  small:    9pt,      // صناديق، حواشٍ
  tiny:     8pt,      // تسميات، رؤوس الصفحات
  code:     9.5pt,    // الكود أصغر قليلًا ليتّسع السطر
  h1:       22pt,     // عنوان الفصل
  h2:       15pt,
  h3:       12pt,
  h4:       11pt,
  chapterNum: 60pt,   // رقم الفصل الضخم في صفحة العنوان
  partNum:  110pt,    // رقم الجزء في الفاصل
)

// leading = تباعد الأسطر. العربية تتنفّس مع تباعد أوسع من اللاتينية،
// وتحتاج هامشًا إضافيًّا كي لا يلامس التشكيل (الشدّة والتنوين) السطرَ المجاور.
#let LEADING = 1.05em
#let PAR_SPACING = 1.3em

// ── هندسة الصفحة (A5 = 148×210mm) ──────────────────────────────────────────
// هوامش كتاب مجلّد: الداخل (جهة التجليد) أوسع من الخارج.
#let PAGE_MARGIN = (
  inside:  18mm,
  outside: 14mm,
  top:     16mm,
  bottom:  17mm,
)
