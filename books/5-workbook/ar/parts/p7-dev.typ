// ═══ الجزء السابع · مسار المطوّر ═══
#import "/lib/book.typ": part, chapter
#import "/books/5-workbook/ar/lib-workbook.typ": win, linux, mac, bsd, ex, goal, doit, diff, ex-challenge

#part("السابع", "مسار المطوّر")

إن كنت تكتب برمجيّاتٍ فالطرفيّةُ ورشتُك. في هذا الجزء تتعلّم Git (حافظَ تاريخِ كودك)، وإدارةَ بيئات اللغات، وأدواتِ الإنتاجيّة التي توفّر ساعاتٍ من عمرك. وأجملُ ما هنا أنّ أكثرَ هذه الأدوات — وعلى رأسها Git — *برامجُ مستقلّةٌ* تُثبَّت فوق النظام لا جزءٌ منه، فتتطابق أوامرُها في الأنظمة الأربعة تطابقًا تامًّا: تعلّمها مرّةً، واعمل بها في كلّ مكان.

// ───────────────────────── الفصل 25 ─────────────────────────
#chapter("Git: حافظُ تاريخِ كودك")

#ex("25.1", "ابدأ مستودعًا", "أساسيّ")
#goal[أن تحوّل مجلّدًا عاديًّا إلى مستودعٍ يحفظ Git تاريخَه.]
#doit[حوّلْ مجلّدك الحاليَّ إلى مستودع Git.]
#win(`git init`)
#linux(`git init`)
#mac(`git init`)
#bsd(`git init`)
#diff[`git` أداةٌ واحدةٌ عابرةٌ للأنظمة — لا فرقَ بين الأربعة حرفًا واحدًا، لأنّ Git برنامجٌ مستقلٌّ يُثبَّت فوق النظام لا جزءٌ منه. فكلُّ ما تتعلّمه هنا ينتقل كما هو. (ثبّتْه إن لم يكن: `winget install Git.Git` أو `apt install git` أو `brew install git` أو `pkg install git`.)]

#ex("25.2", "سجّلْ لقطةً", "متوسّط")
#goal[أن تحفظ لقطةً من عملك في تاريخ المستودع.]
#doit[جهّزْ كلَّ تغييراتك وسجّلها برسالةٍ واحدة.]
#win(`git add . && git commit -m "first commit"`)
#linux(`git add . && git commit -m "first commit"`)
#mac(`git add . && git commit -m "first commit"`)
#bsd(`git add . && git commit -m "first commit"`)
#diff[خطوتان في Git: `git add .` يجهّز التغييراتِ في «منطقة التجهيز»، ثمّ `git commit -m` يحفظها لقطةً برسالة. الأمرُ نفسُه في الأنظمة الأربعة. والرمز `&&` يصل الأمرين فيعمل الثاني إن نجح الأوّل — وهو يعمل في PowerShell الحديث كما في صدفة يونِكس.]

#ex("25.3", "ارفعْ إلى الخادم البعيد", "متقدّم")
#goal[أن ترفع عملك إلى مستودعٍ بعيدٍ كـGitHub.]
#doit[ادفعْ فرعك الحاليَّ إلى المستودع البعيد.]
#win(`git push origin main`)
#linux(`git push origin main`)
#mac(`git push origin main`)
#bsd(`git push origin main`)
#diff[`git push origin main` يرفع إيداعاتك إلى الخادم البعيد المسمّى `origin` على الفرع `main`. واحدٌ في الأربعة. صُمّم Git من أوّل يومٍ ليكون *موزّعًا* وعابرًا للأنظمة، فصار لغةَ المطوّرين المشتركةَ في الأرض كلِّها.]

// ───────────────────────── الفصل 26 ─────────────────────────
#chapter("بيئات اللغات")

#ex("26.1", "ما إصدارُ المفسّر؟", "أساسيّ")
#goal[أن تعرف إصدارَ لغةٍ مثبَّتةٍ قبل أن تعتمد عليها.]
#doit[اعرف إصدارَ Python المثبَّت.]
#win(`python --version`)
#linux(`python3 --version`)
#mac(`python3 --version`)
#bsd(`python3 --version`)
#diff[العَلَم `--version` عرفٌ شبه عالميّ. لكن *انتبه:* ويندوز يسمّيه `python` عادةً، واليونِكس الحديثُ يصرّح بـ`python3` (لأنّ `python` المجرّدةَ قد تعني الإصدارَ الثاني القديم أو لا تكون موجودةً أصلًا). Python — كـGit — تُثبَّت فوق النظام لا معه.]

#ex("26.2", "بيئةٌ معزولة", "متقدّم")
#goal[أن تحبس مكتباتِ مشروعك عن النظام فلا تتصادم المشاريع.]
#doit[أنشئْ بيئة Python معزولةً في مجلّد `.venv`.]
#win(`python -m venv .venv`)
#linux(`python3 -m venv .venv`)
#mac(`python3 -m venv .venv`)
#bsd(`python3 -m venv .venv`)
#diff[البيئةُ المعزولة (virtualenv) تعطي كلَّ مشروعٍ مكتباتِه الخاصّةَ بعيدًا عن النظام، فلا يفسد مشروعٌ آخر. الأمرُ متطابقٌ (عدا `python`/`python3`). وتفعيلُها بعد الإنشاء يفترق: `.venv\Scripts\activate` في ويندوز، و`source .venv/bin/activate` في اليونِكس الثلاثة.]

// ───────────────────────── الفصل 27 ─────────────────────────
#chapter("أدوات الإنتاجيّة")

#ex("27.1", "ابحثْ في كلّ كودك", "متوسّط")
#goal[أن تبحث عن نصٍّ في كلّ ملفّات مشروعك دفعةً واحدة.]
#doit[ابحثْ عن كلمة `TODO` في كلّ ملفّات المجلّد وما تحته.]
#win(`Get-ChildItem -Recurse | Select-String TODO`)
#linux(`grep -r TODO .`)
#mac(`grep -r TODO .`)
#bsd(`grep -r TODO .`)
#diff[البحثُ المتكرّرُ في الشجرة كلِّها: `grep -r` في اليونِكس (r=recursive). وويندوز `Get-ChildItem -Recurse | Select-String`. والأداةُ الحديثةُ `ripgrep` (الأمر `rg`) تعمل في الأنظمة الأربعة، وهي أسرع عادةً وتحترم `.gitignore`: يكفي `rg TODO`.]

#ex("27.2", "أينَ يقعُ هذا الأمر؟", "أساسيّ")
#goal[أن تعرف مسارَ البرنامج الذي يعمل حين تكتب أمرًا.]
#doit[اعرف مسارَ الملفّ التنفيذيّ لأمر `git`.]
#win(`Get-Command git`)
#linux(`which git`)
#mac(`which git`)
#bsd(`which git`)
#diff[اليونِكس `which git` يخبرك بمسار البرنامج الذي سيُشغَّل فعلًا. وويندوز `Get-Command git` (واختصار `gcm`؛ ويعمل `where.exe git` أيضًا). مفيدٌ حين تشكّ أيُّ نسخةٍ من أمرٍ تعمل، أو هل هو مثبَّتٌ من الأساس.]
