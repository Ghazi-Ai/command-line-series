// ═══ الجزء الرابع · الصدفة والأتمتة ═══
#import "/lib/book.typ": part, chapter
#import "/books/5-workbook/ar/lib-workbook.typ": win, linux, mac, bsd, ex, goal, doit, diff, ex-challenge

#part("الرابع", "الصدفة والأتمتة")

حين تكرّر مهمّةً مرّتين، أتمِتها. في هذا الجزء تتعلّم أن تخزّن قيمًا في متغيّرات، وتجمع أوامرَك في سكربتاتٍ تشغّلها بأمرٍ واحد، وتتحكّم في مسارها بالشروط والحلقات، وتنظّمها في دوالّ. وهنا تفترق صياغةُ ويندوز (PowerShell) عن صدفة يونِكس (POSIX) افتراقًا واضحًا — فانتبه للبنية لا للفكرة، فالفكرةُ واحدة.

// ───────────────────────── الفصل ١٢ ─────────────────────────
#chapter("المتغيّرات والبيئة")

#ex("12.1", "عرّفْ متغيّرًا", "أساسيّ")
#goal[أن تخزّن قيمةً في متغيّرٍ وتقرأها لاحقًا.]
#doit[عرّفْ متغيّرًا اسمه `name` قيمتُه `Ahmad`، ثمّ اطبع قيمته.]
#win(`$name = "Ahmad"; echo $name`)
#linux(`name="Ahmad"; echo $name`)
#mac(`name="Ahmad"; echo $name`)
#bsd(`name="Ahmad"; echo $name`)
#diff[الفرقُ في التعريف: اليونِكس *لا فراغَ* حول `=` (`name="Ahmad"` — والفراغُ يكسرها!)، والمتغيّرُ اسمٌ مجرّد. وويندوز يبدأ المتغيّرَ بـ`$` حتى عند التعريف (`$name = ...`), والفراغُ حوله مسموح. لكنّ *القراءةَ* بـ`$name` في الاثنين.]

#ex("12.2", "اقرأ متغيّرَ بيئة", "متوسّط")
#goal[أن تقرأ قيمةً يعرفها كلُّ برنامجٍ في النظام.]
#doit[اطبعْ مسارَ مجلّد منزلك من متغيّر البيئة.]
#win(`echo $env:USERPROFILE`)
#linux(`echo $HOME`)
#mac(`echo $HOME`)
#bsd(`echo $HOME`)
#diff[اليونِكس يسمّي منزلَك `$HOME`. وويندوز يسمّيه `$env:USERPROFILE` — ومتغيّراتُ البيئة كلُّها تحت البادئة `$env:` في PowerShell. ولعرض كلّ متغيّرات البيئة دفعةً: `env` أو `printenv` في اليونِكس، و`Get-ChildItem env:` في ويندوز.]

// ───────────────────────── الفصل ١٣ ─────────────────────────
#chapter("السكربتات")

#ex("13.1", "شغّلْ سكربتًا", "أساسيّ")
#goal[أن تشغّل ملفَّ سكربتٍ يجمع عدّة أوامر.]
#doit[شغّلْ سكربتًا في مجلّدك الحاليّ (اليونِكس: `hello.sh`، ويندوز: `hello.ps1`).]
#win(`.\hello.ps1`)
#linux(`./hello.sh`)
#mac(`./hello.sh`)
#bsd(`./hello.sh`)
#diff[لتشغيل سكربتٍ في مجلّدك تسبقه بمساره `./` (أو `.\` في ويندوز)، لتقول «من هنا، لا من مسار النظام». ولاحظِ الامتداد العرفيّ: `.sh` في اليونِكس، و`.ps1` لسكربتات PowerShell. وأوّلُ سطرٍ في سكربت اليونِكس `#!/bin/sh` (يُسمّى shebang) يخبر النظامَ بأيّ مفسّرٍ يشغّله.]

#ex("13.2", "اجعلِ السكربتَ قابلًا للتنفيذ", "متوسّط")
#goal[أن تأذن للسكربت بأن يعمل.]
#doit[هيّئِ السكربتَ للتشغيل (اليونِكس: امنحه إذنَ التنفيذ؛ ويندوز: اسمح بالسياسة).]
#win(`Set-ExecutionPolicy -Scope Process RemoteSigned`)
#linux(`chmod +x hello.sh`)
#mac(`chmod +x hello.sh`)
#bsd(`chmod +x hello.sh`)
#diff[اختلافٌ فلسفيّ: اليونِكس يمنح *الملفَّ* إذنَ التنفيذ `chmod +x`. وويندوز لا أذونَ تنفيذٍ بهذا المعنى، لكنّه يمنع تشغيلَ السكربتات افتراضيًّا حمايةً لك، فتأذن بـ«سياسةِ تنفيذٍ» للجلسة (`-Scope Process`) فلا تفتح البابَ على مصراعيه دائمًا.]

// ───────────────────────── الفصل ١٤ ─────────────────────────
#chapter("التحكّم: شرطٌ وتكرار")

#ex("14.1", "كرّرْ على قائمة", "متوسّط")
#goal[أن تنفّذ عملًا لكلّ عنصرٍ في مجموعة.]
#doit[اطبعْ اسمَ كلّ ملفٍّ `.txt` في المجلّد سطرًا سطرًا بحلقة.]
#win(`foreach ($f in Get-ChildItem *.txt) { echo $f.Name }`)
#linux(`for f in *.txt; do echo "$f"; done`)
#mac(`for f in *.txt; do echo "$f"; done`)
#bsd(`for f in *.txt; do echo "$f"; done`)
#diff[تختلف الصياغةُ جوهريًّا: اليونِكس `for f in ...; do ... ; done` (كلماتٌ مفتاحيّة). وويندوز `foreach ($f in ...) { ... }` (أقواسٌ معقوفة). لكنّ الفكرةَ واحدة: كرّرِ الجسمَ لكلّ عنصر. ولاحظِ الاقتباسَ `"$f"` في اليونِكس — يحمي الأسماءَ ذاتَ الفراغات من التفكّك.]

#ex("14.2", "نفّذْ بشرط", "متقدّم")
#goal[أن تجعل الأمرَ يعمل فقط إن تحقّق شرط.]
#doit[اطبعْ `found` إن كان ملفّ `config.txt` موجودًا.]
#win(`if (Test-Path config.txt) { "found" }`)
#linux(`if [ -f config.txt ]; then echo found; fi`)
#mac(`if [ -f config.txt ]; then echo found; fi`)
#bsd(`if [ -f config.txt ]; then echo found; fi`)
#diff[اليونِكس يختبر بـ`[ -f FILE ]` (والعَلَم `-f` يعني «ملفٌّ عاديٌّ موجود»)، وبنيتُه `if ...; then ...; fi`. وويندوز `if (Test-Path FILE) { ... }` بأقواسٍ معقوفة. طُرفةٌ خفيّة: `[` في اليونِكس *برنامجٌ فعليٌّ* اسمه `test`، لا مجرّد رمز!]
#ex-challenge[أضِفْ بديلًا: `else` في الاثنين. اليونِكس `... ; then echo found; else echo missing; fi`، وويندوز `if (...) { "found" } else { "missing" }`.]

// ───────────────────────── الفصل ١٥ ─────────────────────────
#chapter("الدوال")

#ex("15.1", "عرّفْ دالّةً ونادِها", "متقدّم")
#goal[أن تجمع أوامرَ متكرّرةً في دالّةٍ تناديها باسمها.]
#doit[عرّفْ دالّةً اسمها `greet` تطبع `hi`، ثمّ نادِها.]
#win(`function greet { "hi" }; greet`)
#linux(`greet() { echo hi; }; greet`)
#mac(`greet() { echo hi; }; greet`)
#bsd(`greet() { echo hi; }; greet`)
#diff[اليونِكس: `اسم() { ... }` (قوسان فارغان ثمّ الجسمُ بين معقوفتين). وويندوز: `function اسم { ... }` (بكلمة `function` صريحة). وكلاهما يُنادى بكتابة اسمه مجرّدًا. والدوالُّ أساسُ تنظيم السكربتات الطويلة: تكتب المنطقَ مرّةً وتستدعيه مرارًا، فيقصُر السكربتُ ويسهُل إصلاحه.]
