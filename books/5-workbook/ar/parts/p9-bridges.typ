// ═══ الجزء التاسع · الجسور ═══
#import "/lib/book.typ": part, chapter
#import "/lib/theme.typ": COLOR, FONT
#import "/books/5-workbook/ar/lib-workbook.typ": win, linux, mac, bsd, ex, goal, doit, diff, ex-challenge

#part("التاسع", "الجسور")

وصلتَ إلى الخاتمة. مررتَ بثمانية أجزاءٍ رأيتَ فيها المهمّةَ الواحدةَ بأربعة ألسنة، فصار في يدك ما هو أثمنُ من حفظ الأوامر: *الحدْس*. صرتَ تعرف أنّ لكلّ نظامٍ أمينَ حزمٍ، ورافعَ صلاحيّة، ونظامَ خدمات — فإذا جلستَ أمام نظامٍ جديدٍ لم تبدأ من الصفر، بل سألتَ: «أين أمينُه؟ كيف أرفع صلاحيّتي هنا؟». هذا الجزءُ الأخيرُ جسورٌ تربط ما تعلّمت: مهامُّ مركّبةٌ تجمع مهاراتِ عدّة أجزاء، وفخاخُ العبور بين الأنظمة، وطريقةُ استكشافك لأيّ نظامٍ تلقاه.

// ───────────────────────── الفصل ٣٢ ─────────────────────────
#chapter("أوجهُ الشبه والخلاف")

#ex("32.1", "مهمّةٌ مركّبة: أكبرُ الملفّات", "متقدّم")
#goal[أن تصل مهاراتِ عدّة أجزاءٍ (قائمة + فرز + قصّ) في حلٍّ واحد.]
#doit[اعرض أكبرَ 3 ملفّاتٍ حجمًا في المجلّد الحاليّ.]
#win(`Get-ChildItem | Sort-Object Length -Descending | Select-Object -First 3`)
#linux(`ls -lS | head -4`)
#mac(`ls -lS | head -4`)
#bsd(`ls -lS | head -4`)
#diff[مهمّةٌ تجمع مهاراتِ أجزاءٍ عدّة: اليونِكس يختصرها بـ`ls -lS` (العَلَم `S` يفرز بالحجم تنازليًّا) ثمّ `head`. وويندوز يبني أنبوبَ كائنات: `Get-ChildItem` ثمّ `Sort-Object Length` ثمّ `Select-Object`. لاحظ كيف صارت لديك الآن *لغةٌ* تفكّر بها الحلَّ في أيّ نظام، لا مجرّد أوامرَ محفوظة.]

#ex("32.2", "اعرفْ أيَّ نظامٍ أنت عليه", "أساسيّ")
#goal[أن تكتشف نظامَ التشغيل وإصداره من الطرفية.]
#doit[اطبعِ اسمَ النظام وإصداره ومعماريّته.]
#win(`Get-ComputerInfo -Property OsName, OsVersion`)
#linux(`uname -a`)
#mac(`uname -a`)
#bsd(`uname -a`)
#diff[اليونِكس الثلاثة أداتُهم الموحّدةُ `uname -a`. وفيها مفاجأةٌ جميلةٌ تكشف نسبَ العائلة: على ماك يقول `uname` إنّ النظامَ *`Darwin`* — وهو اسمُ نواة ماك المشتقّةِ من BSD! وعلى BSD يقول `FreeBSD`، وعلى لِينُكس `Linux`. وويندوز لا `uname`، فتستعلم بـ`Get-ComputerInfo` أو `systeminfo`.]

// ───────────────────────── الفصل ٣٣ ─────────────────────────
#chapter("العبورُ بين الأنظمة")

#ex("33.1", "الفخّ الأشهر: sed في المكان", "متقدّم")
#goal[أن تنتبه لأخطر فخٍّ في العبور: أمرٌ واحدُ الاسم مختلفُ السلوك.]
#doit[عدّلْ ملفّ `f.txt` في مكانه مبدّلًا `foo` بـ`bar`.]
#win(`(Get-Content f.txt) -replace 'foo','bar' | Set-Content f.txt`)
#linux(`sed -i 's/foo/bar/' f.txt`)
#mac(`sed -i '' 's/foo/bar/' f.txt`)
#bsd(`sed -i '' 's/foo/bar/' f.txt`)
#diff[هذا أشهرُ فخٍّ في العبور على الإطلاق! `sed -i` (التعديلُ في المكان) يختلف: لِينُكس (GNU) لا يلزمه معامل، لكنّ ماك وBSD (نسخة BSD الأصيلة) *يلزمهما* لاحقةٌ ولو فارغةٌ `''`، وإلّا فسّرا النصَّ التاليَ لاحقةً وأفسدا الأمر. فسكربتٌ يعمل على لِينُكس قد يتعطّل على ماك وBSD. القاعدة: على ماك/BSD اكتب `sed -i ''` دائمًا (فصّله ملحقُ كتاب BSD).]

#ex("33.2", "جهّزْ نظامًا جديدًا", "متقدّم")
#goal[أن تطبّق كلَّ ما تعلّمتَه لتجهيز جهازٍ جديدٍ من الصفر.]
#doit[على نظامٍ جديد: حدّثِ الحزم، ثبّتْ `git` و`htop`، ثمّ تحقّقْ من إصدار git.]
#win(`winget upgrade --all; winget install Git.Git; git --version`)
#linux(`sudo apt update && sudo apt install -y git htop && git --version`)
#mac(`brew update && brew install git htop && git --version`)
#bsd(`doas pkg update && doas pkg install -y git htop && git --version`)
#diff[هذا ما ستفعله فعلًا على كلّ جهازٍ جديد: حدّثْ، ثبّتْ أدواتك، تحقّقْ. تُوصَل الأوامرُ بـ`&&` (تعمل التاليةُ إن نجحت السابقة). وتأمّلْ: صرتَ تعرف لكلّ نظامٍ أمينَه (`winget`/`apt`/`brew`/`pkg`) ورافعَ صلاحيّته (`sudo`/`doas`) دون أن تُخبَر. *هذه* هي الطلاقةُ التي وعدناك بها في أوّل الكتاب.]

// ───────────────────────── الخاتمة ─────────────────────────
#block(width: 100%, fill: COLOR.primary.lighten(90%), radius: 6pt,
  inset: (x: 14pt, y: 13pt), above: 20pt, breakable: false, {
  text(font: FONT.displayAr, size: 13pt, weight: 800, fill: COLOR.primaryDeep)[وفي الختام: مهارةٌ واحدة، أربعةُ ألسنة]
  v(5pt)
  set par(justify: false, leading: 0.9em)
  text(size: 10pt)[
    حين بدأتَ هذا الدفتر كانت الأنظمةُ الأربعةُ في عينك أربعةَ عوالمَ منفصلة. والآن تراها ما هي عليه حقًّا: إخوةً من أبٍ واحدٍ هو يونِكس (وابنُ عمٍّ هو ويندوز)، يقولون المعنى نفسه بألسنةٍ تختلف قليلًا. رأيتَ أنّ `chmod a+r` واحدةٌ في اليونِكس الثلاثة، وأنّ `ssh` تتطابق في الأربعة، وأنّ Git لا يعرف الحدود. ورأيتَ أين تفترق: أمينُ الحزم، ونظامُ الخدمات، وفخُّ `sed -i`. #linebreak() لم تعُد تحفظ أوامرَ، بل صرتَ تفكّر بلغةٍ. وهذا وعدُ السلسلة الذي أوفيناه: أنّ المهارةَ تنتقل، وأنّ من أتقن نظامًا صار أقربَ إلى البقيّة. أغلقِ الدفترَ الآن، وافتحْ طرفيّتك على أيّ نظامٍ شئت — ستجد يدك تعرف الطريق.
  ]
})
