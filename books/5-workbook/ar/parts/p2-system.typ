// ═══ الجزء الثاني · النظام والمستخدمون ═══
#import "/lib/book.typ": part, chapter
#import "/books/5-workbook/ar/lib-workbook.typ": win, linux, mac, bsd, ex, goal, doit, diff, ex-challenge

#part("الثاني", "النظام والمستخدمون")

هنا تنتقل من ملفّاتك إلى النظام نفسِه: من يملك ماذا، ومن يُسمح له بأن يفعل ماذا، وكيف ترفع صلاحيّتك عند الحاجة، وكيف ترى البرامجَ العاملة وتوقفها، وكيف تثبّت جديدًا. في هذا الجزء يفترق ويندوز عن اليونِكس أكثرَ ما يفترق — فتأمّلْ «لاحظِ الفرق» في كلّ تمرين.

// ───────────────────────── الفصل 4 ─────────────────────────
#chapter("الصلاحيات والملكية")

#ex("4.1", "من يملك هذا الملفّ؟", "أساسيّ")
#goal[أن تعرف مالكَ ملفٍّ ومَن يُسمح له بقراءته أو تعديله.]
#doit[اعرضْ تفاصيلَ الملكيّة والأذون لملفٍّ اسمه `report.txt`.]
#win(`Get-Acl report.txt | Format-List`)
#linux(`ls -l report.txt`)
#mac(`ls -l report.txt`)
#bsd(`ls -l report.txt`)
#diff[اليونِكسيّاتُ الثلاثةُ تعرض المالكَ والمجموعةَ والأذونَ `rwx` في سطرٍ واحدٍ مختصرٍ بـ`ls -l`. أمّا ويندوز فعالمٌ آخر: لا `rwx` بل *قوائمُ تحكّمٍ بالوصول* (ACL) يعرضها `Get-Acl`، وكلُّ إذنٍ يُمنح لكيانٍ باسمه لا برمزٍ مختصر.]

#ex("4.2", "افتحِ البابَ للجميع", "متوسّط")
#goal[أن تجعل ملفًّا يقرؤه كلُّ من على الجهاز، بعد أن كان خاصًّا.]
#doit[اجعل `report.txt` مقروءًا لكلّ المستخدمين.]
#win(`icacls report.txt /grant *S-1-1-0:R`)
#linux(`chmod a+r report.txt`)
#mac(`chmod a+r report.txt`)
#bsd(`chmod a+r report.txt`)
#diff[اليونِكسيّاتُ الثلاثةُ تتكلّم اللغةَ نفسها تمامًا: `chmod a+r` («للجميع، أضِف قراءة»). أمّا ويندوز فيمنح الإذنَ بـ`icacls` لكيانٍ معرّفٍ أمنيًّا؛ و`*S-1-1-0` هو SID العالمي لمجموعة Everyone، فيعمل مهما كانت لغة واجهة النظام. والحرف `R` يعني القراءة.]
#ex-challenge[امنعِ الآخرين من الكتابة مع إبقاء القراءة: `chmod go-w report.txt` في اليونِكس، وفي ويندوز راجع الإدخالات أولًا بـ`icacls report.txt` ثم أبقِ لـ`*S-1-1-0` إذن القراءة وحده.]

#ex("4.3", "غيّرِ المالك", "متوسّط")
#goal[أن تنقل ملكيّة ملفٍّ إلى مستخدمٍ آخر.]
#doit[اجعل المستخدمَ `sara` مالكًا لملفّ `report.txt` (يحتاج صلاحيّةً مرتفعة).]
#win(`icacls report.txt /setowner sara`)
#linux(`sudo chown sara report.txt`)
#mac(`sudo chown sara report.txt`)
#bsd(`doas chown sara report.txt`)
#diff[تغييرُ المالك يحتاج صلاحيّةً مرتفعةً في الجميع. اليونِكس أمرُه `chown` (اختصار _change owner_) مسبوقًا برافع الصلاحيّة: `sudo` في لِينُكس وماك، و`doas` في BSD. وويندوز `icacls ... /setowner` بصلاحيّة مسؤول.]

// ───────────────────────── الفصل 5 ─────────────────────────
#chapter("الجذر والصلاحيات المرتفعة")

#ex("5.1", "حدّثْ فهرسَ مدير الحزم", "أساسيّ")
#goal[أن تحدّث مصادرَ مدير الحزم قبل البحث عن برامج أو ترقيتها.]
#doit[حدّث فهرسَ الحزم أو مصادرَ مدير الحزم في نظامك.]
#win(`winget source update`)
#linux(`sudo apt update`)
#mac(`brew update`)
#bsd(`doas pkg update`)
#diff[المهمّة واحدةٌ وإن اختلفت الحاجة إلى رفع الصلاحيّة: `apt` و`pkg` يحدّثان فهرسًا نظاميًّا فيُسبقان بـ`sudo` أو `doas`، بينما يدير `winget` وHomebrew مصادرَ المستخدم عادةً بلا صدفةٍ مرتفعة. هذه الأوامر تحدّث الفهرس؛ لا تثبّت ترقيات البرامج نفسها.]

#ex("5.2", "صِرْ جذرًا في جلسة", "متوسّط")
#goal[أن تفتح جلسةً كاملةً بصلاحيّة الجذر حين تحتاج عدّة أوامرَ متتابعة.]
#doit[افتح صدفةً تعمل فيها كجذرٍ حتى تخرج منها.]
#win(`Start-Process pwsh -Verb RunAs`)
#linux(`sudo -i`)
#mac(`sudo -i`)
#bsd(`doas -s`)
#diff[لفتح جلسةِ جذرٍ كاملة: `sudo -i` في لِينُكس وماك، و`doas -s` (أو `su -` التقليديّ) في BSD، و«تشغيل كمسؤول» في ويندوز. *انتبه:* جلسةُ الجذر بلا شبكة أمان — كلُّ خطأٍ فيها ينفَّذ فورًا؛ فاخرج منها بـ`exit` فورَ انتهائك، ولا تُطِلِ المكوث.]
#ex-challenge[تأكّدْ أنّك صرتَ جذرًا فعلًا: اكتب `whoami` داخل الجلسة المرتفعة — ستجدها `root` في اليونِكس، و`...\Administrator` في ويندوز.]

// ───────────────────────── الفصل 6 ─────────────────────────
#chapter("العمليّات")

#ex("6.1", "ماذا يعمل الآن؟", "أساسيّ")
#goal[أن ترى البرامجَ العاملة في نظامك هذه اللحظة.]
#doit[اعرضْ قائمةَ العمليّات العاملة الآن.]
#win(`Get-Process`)
#linux(`ps aux`)
#mac(`ps aux`)
#bsd(`ps aux`)
#diff[اليونِكس `ps aux` (الحروفُ تعني: `a` كلُّ المستخدمين، `u` تفصيلٌ بشريّ، `x` حتى ما لا طرفيّةَ له). وويندوز `Get-Process` (واختصاره `ps` أيضًا). لاحظ أنّ الأعمدة تختلف، لكنّ الفكرة واحدة: معرّفُ العمليّة (PID) واسمُها وما تستهلك.]

#ex("6.2", "أنهِ برنامجًا متعلّقًا", "متوسّط")
#goal[أن توقف برنامجًا توقّف عن الاستجابة، بالاسم.]
#doit[أنهِ عمليّةً اسمها `firefox`.]
#win(`Stop-Process -Name firefox`)
#linux(`pkill firefox`)
#mac(`pkill firefox`)
#bsd(`pkill firefox`)
#diff[اليونِكس `pkill NAME` (بالاسم) أو `kill PID` (بالرقم). وويندوز `Stop-Process -Name` أو `-Id`. تطلب الأوامرُ الإنهاءَ بلطفٍ أوّلًا؛ فإن أبى البرنامجُ فالإجبارُ القسريّ: `kill -9 PID` في اليونِكس، و`Stop-Process -Force` في ويندوز — وهو ملاذٌ أخيرٌ لا أوّل.]

#ex("6.3", "من يلتهم المعالج؟", "متوسّط")
#goal[أن تكتشف أيُّ برنامجٍ يُبطئ جهازك بالتهامه المعالج.]
#doit[اعرضِ العمليّاتِ مرتّبةً بالأثقل استهلاكًا للمعالج.]
#win(`Get-Process | Sort-Object CPU -Descending`)
#linux(`top`)
#mac(`top -o cpu`)
#bsd(`top`)
#diff[الأداةُ الحيّةُ `top` في اليونِكس تعرض العمليّات مرتّبةً بالاستهلاك وتتجدّد لحظةً بلحظة (ماك يرتّب بالمعالج صراحةً بـ`-o cpu`). ويندوز لا `top` مدمج، فترتّب لقطةً بـ`Get-Process | Sort-Object`. والبديلُ الحديثُ الجميل `htop` (يُثبَّت حزمةً) يعمل في اليونِكس الثلاثة.]

// ───────────────────────── الفصل 7 ─────────────────────────
#chapter("مديرو الحزم")

#ex("7.1", "ثبّتْ برنامجًا", "أساسيّ")
#goal[أن تثبّت برنامجًا جديدًا بأمرٍ واحدٍ من مصدرٍ موثوق.]
#doit[ثبّتِ المحرّرَ `vim`.]
#win(`winget install vim`)
#linux(`sudo apt install vim`)
#mac(`brew install vim`)
#bsd(`doas pkg install vim`)
#diff[لكلّ نظامٍ أمينُه: ويندوز `winget` (المدمج الحديث)، ولِينُكس `apt` (دبيان/أوبونتو)، وماك `brew` (Homebrew المجتمعيّ)، وBSD `pkg` (الأصيل). ولاحظِ الترقّي: اليونِكس يحتاج `sudo`/`doas` لأنّ الحزم تُكتب في مجلّداتٍ محميّة، بينما `brew` يملك مجلّدَه فيتفادى ذلك.]

#ex("7.2", "ابحثْ عن حزمة", "أساسيّ")
#goal[أن تجد اسمَ حزمةٍ قبل تثبيتها.]
#doit[ابحثْ عن حزمةٍ اسمها `htop`.]
#win(`winget search htop`)
#linux(`apt search htop`)
#mac(`brew search htop`)
#bsd(`pkg search htop`)
#diff[البحثُ لا يحتاج صلاحيّةً مرتفعةً (تقرأ فهرسًا فقط، لا تكتب شيئًا). والصيغةُ متشابهةٌ في الجميع: الأداة + `search` + الاسم. فمعرفتك بواحدٍ تنتقل إلى البقيّة.]

#ex("7.3", "حدّثْ كلَّ البرامج", "متوسّط")
#goal[أن ترفع كلَّ برامجك إلى أحدث إصداراتها دفعةً واحدة.]
#doit[رقِّ كلَّ الحزم المثبَّتة إلى آخر إصداراتها.]
#win(`winget upgrade --all`)
#linux(`sudo apt update && sudo apt upgrade`)
#mac(`brew upgrade`)
#bsd(`doas pkg upgrade`)
#diff[الترقيةُ تكتب في النظام فتحتاج صلاحيّةً مرتفعةً (عدا `brew`). ولِينُكس يفصلها إلى خطوتين: `apt update` يجلب الفهرسَ الجديد، ثمّ `apt upgrade` يرقّي فعلًا — أمّا البقيّةُ فتجمعهما في أمرٍ واحد. اجعلها عادةً أسبوعيّةً فهي أبسطُ ما يحفظ أمنَ جهازك.]
