// ═══ الجزء السادس · الشبكات ═══
#import "/lib/book.typ": part, chapter
#import "/books/5-workbook/ar/lib-workbook.typ": win, linux, mac, bsd, ex, goal, doit, diff, ex-challenge

#part("السادس", "الشبكات")

الطرفيّةُ نافذتُك على الشبكة كلِّها: تختبر الاتّصال، وتستعلم عن العناوين، وتنزّل وترفع، وتدخل خوادمَ بعيدةً في أقصى الأرض، وتضبط الجدارَ الناريّ. وفي هذا الجزء تلمس أجملَ ثمار يونِكس: أدوات الشبكة التي وُلد أكثرُها في عالم BSD ثمّ صارت معيارَ العالم — حتى إنّ ويندوز أدمج بعضها أخيرًا. فبعضُ التمارين هنا تتطابق في الأنظمة الأربعة تطابقًا تامًّا.

// ───────────────────────── الفصل ٢١ ─────────────────────────
#chapter("الاتّصال والتشخيص")

#ex("21.1", "هل الشبكة تعمل؟", "أساسيّ")
#goal[أن تختبر وصولَك إلى خادمٍ بإرسال نبضاتٍ وانتظار صداها.]
#doit[تحقّقْ من الوصول إلى `example.com`.]
#win(`ping example.com`)
#linux(`ping example.com`)
#mac(`ping example.com`)
#bsd(`ping example.com`)
#diff[`ping` مشترَكٌ في الأربعة (يرسل نبضةً وينتظر عودةَ صداها، فيقيس الوصولَ وزمنَه). لكن *انتبه لفرقٍ عمليّ:* ويندوز يرسل 4 نبضاتٍ ثمّ يقف، واليونِكس يرسل بلا توقّفٍ حتى تكبحه بـ`Ctrl+C` — أو حدّدِ العددَ بـ`ping -c 4`.]

#ex("21.2", "ما عنوانُ هذا الموقع؟", "متوسّط")
#goal[أن تحوّل اسمَ موقعٍ إلى عنوان IP الذي تفهمه الشبكة.]
#doit[اعرف عنوانَ IP لـ`example.com`.]
#win(`nslookup example.com`)
#linux(`dig example.com`)
#mac(`dig example.com`)
#bsd(`drill example.com`)
#diff[استعلامُ DNS يترجم الاسمَ إلى رقم. الأداةُ العريقةُ `nslookup` تعمل في الجميع (ومنها عمودُ ويندوز). واليونِكس يفضّل الأحدثَ الأغنى: `dig` في لِينُكس وماك، و`drill` في نظام FreeBSD الأساس (و`dig` يأتي بحزمة `bind-tools`).]

// ───────────────────────── الفصل ٢٢ ─────────────────────────
#chapter("النقل: تنزيلٌ ورفع")

#ex("22.1", "نزّلْ ملفًّا من الوِب", "متوسّط")
#goal[أن تجلب ملفًّا من رابطٍ إلى قرصك من الطرفية مباشرة.]
#doit[نزّلْ ملفًّا من رابطٍ واحفظه على قرصك.]
#win(`Invoke-WebRequest URL -OutFile file.zip`)
#linux(`curl -O URL`)
#mac(`curl -O URL`)
#bsd(`fetch URL`)
#diff[اليونِكس أدواتُه: `curl -O` في لِينُكس وماك (العَلَم `-O` الكبير يحفظ باسم الملفّ الأصليّ من الرابط)، و`fetch URL` الأصيلُ المدمج في FreeBSD. وويندوز `Invoke-WebRequest -OutFile` (واختصار `iwr`؛ ومنذ ويندوز 10 يتوفّر `curl.exe` حقيقيٌّ أيضًا). و`wget` بديلٌ شائعٌ للتنزيل غير التفاعليّ.]

// ───────────────────────── الفصل ٢٣ ─────────────────────────
#chapter("SSH: الدخول الآمن عن بُعد")

#ex("23.1", "ادخلْ خادمًا بعيدًا", "متوسّط")
#goal[أن تفتح صدفةً على حاسوبٍ آخرَ في أقصى الأرض، مشفّرةً وآمنة.]
#doit[اتّصلْ بخادمٍ عنوانُه `server.com` باسم المستخدم `ahmad`.]
#win(`ssh ahmad@server.com`)
#linux(`ssh ahmad@server.com`)
#mac(`ssh ahmad@server.com`)
#bsd(`ssh ahmad@server.com`)
#diff[لحظةُ تطابقٍ كاملةٍ بديعة: `ssh USER@HOST` في الأنظمة الأربعة حرفًا بحرف! وليس عجبًا — فـSSH (بل `OpenSSH` تحديدًا) وُلد في OpenBSD من عالم BSD، ثمّ صار معيارَ الاتّصال الآمن في الأرض كلِّها، حتى أدمجه ويندوز أخيرًا. تعلّمْه مرّةً تعرفه في كلّ مكان.]

#ex("23.2", "انسخْ ملفًّا إلى خادم", "متقدّم")
#goal[أن تنقل ملفًّا إلى خادمٍ بعيدٍ عبر قناةٍ مشفّرة.]
#doit[انسخْ ملفّ `data.zip` إلى منزلك على الخادم `server.com`.]
#win(`scp data.zip ahmad@server.com:~`)
#linux(`scp data.zip ahmad@server.com:~`)
#mac(`scp data.zip ahmad@server.com:~`)
#bsd(`scp data.zip ahmad@server.com:~`)
#diff[`scp` (اختصار _secure copy_) يركب على قناة SSH نفسِها لينقل الملفّاتِ مشفّرة، وصيغتُه واحدةٌ في الأربعة: `scp مصدر USER@HOST:وجهة`. النقطتان `:` تفصلان اسمَ الخادم عن المسار داخله، و`~` تعني منزلك هناك. وللمزامنة الأكبر عبر SSH: `rsync -e ssh`.]

// ───────────────────────── الفصل ٢٤ ─────────────────────────
#chapter("الجدار الناريّ")

#ex("24.1", "اعرض حالة الجدار", "متوسّط")
#goal[أن تعرف هل جدارُك الناريُّ مفعّل، وما قواعده.]
#doit[اعرض حالةَ الجدار الناريّ وقواعدَه.]
#win(`Get-NetFirewallProfile`)
#linux(`sudo ufw status`)
#mac(`sudo pfctl -s rules`)
#bsd(`doas pfctl -s rules`)
#diff[هنا قرابةٌ لطيفة: ماك وBSD يتشاركان الجدارَ الناريَّ نفسه `pf` (وُلد في OpenBSD!)، فأمرُه `pfctl -s` واحدٌ فيهما. أمّا لِينُكس (أوبونتو) فواجهتُه المبسّطة `ufw` فوق nftables، وويندوز `Get-NetFirewallProfile`. تأمّلْ: نظامان من عائلتين يديران جدارَهما بالأداة عينها.]
#ex-challenge[افتحْ منفذًا: في `ufw` الأمرُ `sudo ufw allow 22`، وفي `pf` تُضاف قاعدةٌ إلى `/etc/pf.conf` ثمّ `pfctl -f`. راجعِ الفصلَ المختصَّ في كتاب نظامك للتفصيل.]
