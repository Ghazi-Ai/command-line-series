// ═══ الجزء الثالث · النصوص وتدفّق البيانات ═══
#import "/lib/book.typ": part, chapter
#import "/books/5-workbook/ar/lib-workbook.typ": win, linux, mac, bsd, ex, goal, doit, diff, ex-challenge

#part("الثالث", "النصوص وتدفّق البيانات")

قلبُ سطر الأوامر أن تصل أدواتٍ صغيرةً في أنبوبٍ واحد، فتصنع من بضع كلماتٍ آلةً تعالج آلافَ الأسطر. هنا تتعلّم النقلَ بالأنبوب `|`، والترشيحَ والفرزَ والعدّ، والبحثَ بالأنماط، ثمّ التحرير بـ`sed` وawk. وفي هذا الجزء يفترق ويندوز عن اليونِكس بأدواتٍ مختلفةِ الأسماء لكن متقاربةِ الروح.

// ───────────────────────── الفصل ٨ ─────────────────────────
#chapter("الأنابيب")

#ex("8.1", "كم سطرًا؟", "أساسيّ")
#goal[أن تعدّ أسطرَ ملفٍّ دون أن تفتحه.]
#doit[اعرف كم سطرًا في ملفّ `access.log`.]
#win(`Get-Content access.log | Measure-Object -Line`)
#linux(`wc -l access.log`)
#mac(`wc -l access.log`)
#bsd(`wc -l access.log`)
#diff[اليونِكس أداتُه المختصرة `wc -l` (اختصار _word count_، والعَلَم `-l` للأسطر). وويندوز يبني أنبوبًا: `Get-Content` يقرأ الملفَّ ثمّ `Measure-Object -Line` يعدّ. والفلسفةُ الجوهريّة: اليونِكس ينقل *نصًّا* عبر الأنبوب `|`، وويندوز ينقل *كائناتٍ* — لكنّ الرمز `|` نفسه في الاثنين.]

#ex("8.2", "أوّلُ الملفّ", "أساسيّ")
#goal[أن تعاين بداية ملفٍّ كبيرٍ دون تحميله كلِّه.]
#doit[اعرض أوّل 10 أسطرٍ من `access.log`.]
#win(`Get-Content access.log -Head 10`)
#linux(`head access.log`)
#mac(`head access.log`)
#bsd(`head access.log`)
#diff[اليونِكس `head` (وافتراضُها 10 أسطر؛ و`head -n 20` لعشرين). وويندوز `Get-Content -Head 10` (واختصار `gc`). ولآخر الملفّ بدل أوّله: `tail` في اليونِكس، و`Get-Content -Tail 10` في ويندوز — ومنه `tail -f` الشهيرُ لمتابعة سجلٍّ حيًّا.]

#ex("8.3", "صِلْ أداتين بأنبوب", "متوسّط")
#goal[أن تمرّر خرجَ أمرٍ إلى أمرٍ آخر عبر الأنبوب.]
#doit[اعرض عددَ الملفّات ذات الامتداد `.txt` في المجلّد الحاليّ.]
#win(`Get-ChildItem *.txt | Measure-Object`)
#linux(`ls *.txt | wc -l`)
#mac(`ls *.txt | wc -l`)
#bsd(`ls *.txt | wc -l`)
#diff[الأنبوبُ يصل خرجَ الأوّل بدخل الثاني: `ls` يعطي الأسماء و`wc -l` يعدّها. وويندوز `Get-ChildItem` يعطي كائناتٍ و`Measure-Object` يعدّها. وهذا جوهرُ فلسفة يونِكس: أدواتٌ صغيرةٌ تُتقن عملًا واحدًا، تُركَّب بالأنبوب فتصنع ما لا نهاية له.]

// ───────────────────────── الفصل ٩ ─────────────────────────
#chapter("الترشيح والفرز والعدّ")

#ex("9.1", "ابحثْ عن كلمة", "أساسيّ")
#goal[أن تجد الأسطرَ التي تحوي كلمةً بعينها في ملفّ.]
#doit[اعرض أسطرَ `access.log` التي تحوي كلمة `error`.]
#win(`Select-String error access.log`)
#linux(`grep error access.log`)
#mac(`grep error access.log`)
#bsd(`grep error access.log`)
#diff[اليونِكس أداتُه الأسطوريّة `grep` (اسمُها من أمرٍ قديمٍ في محرّر `ed`). وويندوز `Select-String` (واختصار `sls`). كلاهما يطبع الأسطرَ المطابقة. وللبحث دون حساسيّةٍ لحالة الأحرف: `grep -i` في اليونِكس، و`Select-String` (لا يبالي بالحالة افتراضيًّا).]

#ex("9.2", "رتّبْ وأزلِ المكرّر", "متوسّط")
#goal[أن ترتّب أسطرًا أبجديًّا وتحذف المتكرّر.]
#doit[رتّبْ أسطرَ `names.txt` أبجديًّا وأزلِ المكرّر منها.]
#win(`Get-Content names.txt | Sort-Object -Unique`)
#linux(`sort -u names.txt`)
#mac(`sort -u names.txt`)
#bsd(`sort -u names.txt`)
#diff[اليونِكس `sort -u` (فرزٌ مع إزالة التكرار دفعةً). وويندوز `Sort-Object -Unique`. *تنبيه:* أداةُ `uniq` في اليونِكس لا تزيل إلّا المكرّرَ *المتجاور*، فيُسبَق بـ`sort` عادةً — ولهذا جمعهما `sort -u` في أمرٍ واحد.]

#ex("9.3", "كم مرّةً تكرّر كلٌّ؟", "متقدّم")
#goal[أن تعدّ تكرارَ كلّ قيمةٍ فريدةٍ وترتّبها بالأكثر.]
#doit[اعرض كم مرّةً تكرّر كلُّ سطرٍ في `names.txt`، مرتّبًا بالأكثر تكرارًا.]
#win(`Get-Content names.txt | Group-Object | Sort-Object Count -Descending`)
#linux(`sort names.txt | uniq -c | sort -rn`)
#mac(`sort names.txt | uniq -c | sort -rn`)
#bsd(`sort names.txt | uniq -c | sort -rn`)
#diff[أنبوبٌ كلاسيكيٌّ يلخّص فلسفةَ يونِكس: `sort` يجمع المتماثلَ متجاورًا، و`uniq -c` يعدّه (c=count)، و`sort -rn` يرتّب بالأكثر عدديًّا (r=معكوس، n=رقميّ). وويندوز يفعلها بكائنٍ واحد: `Group-Object` يجمع ويعدّ معًا، ثمّ `Sort-Object Count`.]
#ex-challenge[اعرض أكثرَ 3 قيمٍ تكرارًا فقط بإضافة `| head -3` في اليونِكس، و`| Select-Object -First 3` في ويندوز.]

// ───────────────────────── الفصل ١٠ ─────────────────────────
#chapter("البحث بالتعابير النمطية")

#ex("10.1", "طابقْ بدايةَ السطر", "متوسّط")
#goal[أن تبحث بنمطٍ لا بكلمةٍ حرفيّة.]
#doit[اعرض أسطرَ `log.txt` التي *تبدأ* بكلمة `ERROR` فقط.]
#win(`Select-String '^ERROR' log.txt`)
#linux(`grep '^ERROR' log.txt`)
#mac(`grep '^ERROR' log.txt`)
#bsd(`grep '^ERROR' log.txt`)
#diff[الرمز `^` يعني «بداية السطر» في لغة التعابير النمطية — وهي لغةٌ مشتركةٌ بين `grep` و`Select-String`. فـ`^ERROR` يطابق الأسطرَ المبتدئةَ بها فقط، لا التي تحويها في وسطها. ونظيرُه `$` يعني «نهاية السطر»، فـ`done$` يطابق ما ينتهي بـdone.]

#ex("10.2", "استخرجْ ما يشبه رقمًا", "متقدّم")
#goal[أن تجد أنماطًا كأرقام الهواتف أو المعرّفات.]
#doit[اعرض أسطرَ `data.txt` التي تحوي رقمًا من ثلاث خاناتٍ فأكثر متتاليةً.]
#win(`Select-String '\d{3,}' data.txt`)
#linux(`grep -E '[0-9]{3,}' data.txt`)
#mac(`grep -E '[0-9]{3,}' data.txt`)
#bsd(`grep -E '[0-9]{3,}' data.txt`)
#diff[`\d` يعني «رقمًا» و`{3,}` يعني «ثلاثًا فأكثر». يفهم ويندوز `\d` مباشرةً. أمّا `grep` فيحتاج العَلَمَ `-E` (تعابيرُ ممتدّة) ليفهم `{3,}`، ويُؤثِر `[0-9]` على `\d` لأنّها أوثقُ عبر إصدارات grep (خاصّةً على BSD).]

// ───────────────────────── الفصل ١١ ─────────────────────────
#chapter("sed وawk: التحرير والمعالجة")

#ex("11.1", "استبدلْ نصًّا في مجرًى", "متوسّط")
#goal[أن تبدّل كلمةً بأخرى في محتوى ملفٍّ دون فتح محرّر.]
#doit[بدّلْ كلَّ `error` بـ`ERROR` في مخرَج `log.txt`.]
#win(`(Get-Content log.txt) -replace 'error','ERROR'`)
#linux(`sed 's/error/ERROR/g' log.txt`)
#mac(`sed 's/error/ERROR/g' log.txt`)
#bsd(`sed 's/error/ERROR/g' log.txt`)
#diff[أداةُ اليونِكس لتحرير المجرى `sed`، وصيغتُها `s/قديم/جديد/g` (s=استبدال، g=كلُّ التطابقات في السطر لا الأوّل فقط). وويندوز يستعمل المعامل `-replace`. وكلاهما يطبع النتيجةَ ولا يمسّ الملفَّ الأصل؛ وللتعديل في المكان `sed -i` — لكن *احذرْ*: صياغتُه تختلف بين BSD وGNU (راجع ملحق كتاب BSD).]

#ex("11.2", "اجمعْ عمودًا من أرقام", "متقدّم")
#goal[أن تعالج بياناتٍ منظّمةً في أعمدة وتحسب عليها.]
#doit[اجمعْ قيمَ العمود الثاني في `sales.txt` (الأعمدةُ مفصولةٌ بفراغ).]
#win(`Get-Content sales.txt | ForEach-Object { ($_ -split '\s+')[1] } | Measure-Object -Sum`)
#linux(`awk '{sum+=$2} END {print sum}' sales.txt`)
#mac(`awk '{sum+=$2} END {print sum}' sales.txt`)
#bsd(`awk '{sum+=$2} END {print sum}' sales.txt`)
#diff[هنا يتألّق `awk` — لغةٌ صغيرةٌ كاملةٌ لمعالجة الأعمدة: `$2` هو الحقلُ الثاني من كلّ سطر، و`sum+=$2` يراكمه، و`END {print sum}` يطبع المجموعَ بعد آخر سطر. وويندوز يفكّك السطرَ بـ`-split` ثمّ يجمع بـ`Measure-Object -Sum`. `awk` أوجزُ وأقوى في هذا الصنف، ولذلك بقيَ حيًّا نصفَ قرن.]
