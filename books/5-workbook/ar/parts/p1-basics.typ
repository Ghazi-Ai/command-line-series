// ═══ الجزء الأوّل · الأساسات ═══  (الجزءُ المرجعيّ — نموذجٌ لبقيّة الأجزاء)
#import "/lib/book.typ": part, chapter
#import "/books/5-workbook/ar/lib-workbook.typ": win, linux, mac, bsd, ex, goal, doit, diff, ex-challenge

#part("الأول", "الأساسات")

في هذا الجزء تبني الأرضَ التي تقف عليها: كيف تعرف موضعك، وترى ما حولك، وتتنقّل، وتُنشئ وتقرأ وتنقل وتحذف، وتطلب المساعدةَ حين تحتاجها. مهاراتٌ صغيرةٌ تتكرّر في كلّ ما بعدها — أتقِنها هنا، يسهُلْ عليك الباقي.

// ───────────────────────── الفصل 1 ─────────────────────────
#chapter("التنقّل والاستكشاف")

#ex("1.1", "أين أنا؟", "أساسيّ")
#goal[أن تعرف موضعك الحاليّ في شجرة الملفّات — أوّلُ ما تحتاجه حين تفتح طرفيّة.]
#doit[اطبعِ المسارَ الكاملَ للمجلّد الذي تقف فيه الآن.]
#win(`Get-Location`)
#linux(`pwd`)
#mac(`pwd`)
#bsd(`pwd`)
#diff[الأنظمةُ اليونِكسيّةُ الثلاثةُ تقولها بكلمةٍ واحدةٍ `pwd` (اختصار _print working directory_)؛ وويندوزُ الأصيلُ بفعلٍ صريحٍ `Get-Location` — وله في PowerShell الاسمُ المختصر `pwd` أيضًا. لاحظ اختلافَ جذر المسار: `/home` في لِينُكس وBSD، و`/Users` في ماك، و`C:\Users` في ويندوز.]

#ex("1.2", "ماذا حولي؟", "أساسيّ")
#goal[أن ترى ما في مجلّدك من ملفّاتٍ ومجلّدات.]
#doit[اعرضْ قائمةَ محتويات المجلّد الحاليّ.]
#win(`Get-ChildItem`)
#linux(`ls`)
#mac(`ls`)
#bsd(`ls`)
#diff[`ls` لغةُ اليونِكس المشترَكة؛ وويندوزُ الأصيلُ `Get-ChildItem` — وله الاسمانِ المختصرانِ `ls` و`dir`. للتفصيل الطويل (الحجمِ والتاريخِ والأذون): `ls -l` في اليونِكس، و`Get-ChildItem | Format-List` في ويندوز.]

#ex("1.3", "انتقِل إلى مجلّد", "أساسيّ")
#goal[أن تتحرّك بين المجلّدات، نزولًا إلى داخلها.]
#doit[انتقِل إلى مجلّد `Documents` الموجود في مجلّد منزلك.]
#win(`cd ~\Documents`)
#linux(`cd ~/Documents`)
#mac(`cd ~/Documents`)
#bsd(`cd ~/Documents`)
#diff[`cd` (اختصار _change directory_) مشترَكةٌ في الجميع — وهي في ويندوز اسمٌ مختصرٌ لـ`Set-Location`. الفرقُ في فاصل المسار: اليونِكس يفصل بـ`/` وويندوز بـ`\`، وإن كان PowerShell متسامحًا يقبل الاثنين. والرمزُ `~` يعني «مجلّد منزلك» في الأنظمة الأربعة.]
#ex-challenge[ارجعْ خطوةً واحدةً إلى المجلّد الأعلى. (تلميح: نقطتان.) الجوابُ نفسُه في الأنظمة الأربعة: `cd ..`]

// ───────────────────────── الفصل 2 ─────────────────────────
#chapter("الإنشاء والقراءة والحذف")

#ex("2.1", "أنشئ مجلّدًا", "أساسيّ")
#goal[أن تصنع مكانًا جديدًا تنظّم فيه عملك.]
#doit[أنشئ مجلّدًا جديدًا اسمه `project` في مكانك الحاليّ.]
#win(`mkdir project`)
#linux(`mkdir project`)
#mac(`mkdir project`)
#bsd(`mkdir project`)
#diff[لحظةٌ جميلة: `mkdir` (اختصار _make directory_) تعمل بالحرف نفسه في الأنظمة الأربعة — وهي في PowerShell غلافٌ أنيقٌ للأمر الأصيل `New-Item -ItemType Directory`. والأسماءُ العربيّةُ تعمل أيضًا (`mkdir مشروعي`) لأنّ الأنظمة الحديثة كلَّها تدعم Unicode.]

#ex("2.2", "اقرأ محتوى ملفّ", "أساسيّ")
#goal[أن تعرض محتوى ملفٍّ نصّيٍّ على الشاشة دون فتح محرّر.]
#doit[اطبعْ محتوى ملفٍّ اسمه `notes.txt`.]
#win(`Get-Content notes.txt`)
#linux(`cat notes.txt`)
#mac(`cat notes.txt`)
#bsd(`cat notes.txt`)
#diff[اليونِكسُ يختصرها في `cat` (اختصار _concatenate_)؛ وويندوزُ يسمّيها بوضوحٍ `Get-Content` — وله الاختصارانِ `cat` و`type`. ولملفٍّ طويلٍ لا تسعه شاشةٌ واحدة: `less notes.txt` في اليونِكس، و`Get-Content notes.txt | more` في ويندوز.]

#ex("2.3", "انسخ ثمّ احذف", "متوسّط")
#goal[أن تصنع نسخةً احتياطيّةً من ملفّ، وتتعلّم الحذفَ الحذِر.]
#doit[انسخ `notes.txt` إلى `notes.bak`، ثمّ احذفِ النسخةَ الأصليّة.]
#win(`Copy-Item notes.txt notes.bak`)
#linux(`cp notes.txt notes.bak`)
#mac(`cp notes.txt notes.bak`)
#bsd(`cp notes.txt notes.bak`)
#diff[النسخُ: `cp` في اليونِكس، و`Copy-Item` في ويندوز (وله الاختصارانِ `cp` و`copy`). والحذفُ على المنوال: `rm notes.txt` في اليونِكس، و`Remove-Item notes.txt` في ويندوز. *انتبه:* الحذفُ في الطرفيّة لا يمرّ بسلّة المهملات — يمضي فورًا وبلا رجعة، فتأنَّ قبل `rm`.]
#ex-challenge[انسخ مجلّدًا كاملًا بما فيه. ستحتاج علَمًا إضافيًّا: `cp -r` في اليونِكس، و`Copy-Item -Recurse` في ويندوز.]

// ───────────────────────── الفصل 3 ─────────────────────────
#chapter("المحارف البدلية والمساعدة")

#ex("3.1", "طابِق بالنجمة", "متوسّط")
#goal[أن تستعمل المحرفَ البدليَّ `*` لتطابق عدّة أسماءٍ دفعةً واحدة.]
#doit[اعرضْ كلَّ الملفّات ذات الامتداد `.txt` في المجلّد الحاليّ.]
#win(`Get-ChildItem *.txt`)
#linux(`ls *.txt`)
#mac(`ls *.txt`)
#bsd(`ls *.txt`)
#diff[النجمةُ `*` تعني «أيَّ شيءٍ مهما طال» في الأنظمة الأربعة. الفرقُ خلف الستار: في اليونِكس تفكُّها الصدفةُ نفسُها قبل تسليمها للأمر (يُسمّى _globbing_)، وفي PowerShell يفكُّها الأمرُ المستقبِل — والنتيجةُ لك واحدةٌ في الحالين.]

#ex("3.2", "اطلبِ المساعدة", "أساسيّ")
#goal[أن تقرأ دليلَ أمرٍ لا تعرفه — أنفعُ مهارةٍ في هذا الكتاب كلِّه.]
#doit[اعرضِ المساعدةَ الرسميّةَ لأمرِ عرضِ المحتويات (`ls` أو `Get-ChildItem`).]
#win(`Get-Help Get-ChildItem`)
#linux(`man ls`)
#mac(`man ls`)
#bsd(`man ls`)
#diff[اليونِكسُ يسمّي دليلَه `man` (اختصار _manual_)؛ وويندوزُ `Get-Help`. وBSD يُفاخِر هنا: صفحاتُ `man` فيه جزءٌ أصيلٌ من النظام تُكتب بعنايةٍ ودقّة، لا إضافةً لاحقة. جرّب للاختصار السريع: `ls --help` في لِينُكس، و`Get-Help Get-ChildItem -Examples` في ويندوز.]
#ex-challenge[لا تذكر اسمَ الأمر الذي تريد؟ ابحثْ عنه بكلمة: `man -k copy` (أو `apropos copy`) في اليونِكس، و`Get-Help *copy*` في ويندوز.]
