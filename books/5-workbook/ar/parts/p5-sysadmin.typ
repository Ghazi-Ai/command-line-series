// ═══ الجزء الخامس · إدارة النظام ═══
#import "/lib/book.typ": part, chapter
#import "/books/5-workbook/ar/lib-workbook.typ": win, linux, mac, bsd, ex, goal, doit, diff, ex-challenge

#part("الخامس", "إدارة النظام")

هنا تصير مسؤولًا: تدير الخدماتِ الخلفيّةَ التي لا تراها، وتجدولُ مهامَّ تعمل وأنت نائم، وتراقب الأقراصَ والموارد، وتحفظ عملك بالأرشفة والنسخ. وفي هذا الجزء يبلغ افتراقُ الأنظمة ذروتَه — فلكلّ نظامٍ نظامُ خدماتٍ مختلفٌ تمامًا (systemd، launchd، rc، وخدمات ويندوز) — لكنّ المهامَّ التي تُنجزها بها واحدة.

// ───────────────────────── الفصل 16 ─────────────────────────
#chapter("الخدمات")

#ex("16.1", "شغّلْ خدمة", "أساسيّ")
#goal[أن تشغّل خدمةً خلفيّةً (كخادم ويب) الآن.]
#doit[شغّلْ خدمةً اسمها `nginx`.]
#win(`Start-Service nginx`)
#linux(`sudo systemctl start nginx`)
#mac(`brew services start nginx`)
#bsd(`doas service nginx start`)
#diff[أربعةُ أنظمةِ خدماتٍ مختلفةٍ تمامًا: لِينُكس (systemd) بـ`systemctl start`، وماك (launchd) عبر Homebrew بـ`brew services start`، وBSD (rc) بـ`service NAME start`، وويندوز بـ`Start-Service`. لكنّ الفعلَ واحد: أيقظِ العفريتَ الخلفيّ ليخدمك.]

#ex("16.2", "فعّلْها عند الإقلاع", "متوسّط")
#goal[أن تجعل الخدمة تعمل تلقائيًّا بعد كلّ إعادة تشغيل.]
#doit[اجعل `nginx` تبدأ وحدها عند كلّ إقلاع.]
#win(`Set-Service nginx -StartupType Automatic`)
#linux(`sudo systemctl enable nginx`)
#mac(`sudo brew services start nginx`)
#bsd(`doas sysrc nginx_enable=YES`)
#diff[«التشغيلُ الآن» غيرُ «التفعيل عند الإقلاع» — فرّقْ دائمًا! لِينُكس `systemctl enable`، وBSD `sysrc NAME_enable=YES` (يكتب في `/etc/rc.conf`)، وويندوز `Set-Service -StartupType Automatic`، وماك يرفعها لمستوى النظام بـ`sudo brew services` (فتبدأ عند الإقلاع لا الدخول فقط). خدمةٌ تعمل الآن قد لا تعود بعد إعادة التشغيل ما لم تُفعّلها.]

// ───────────────────────── الفصل 17 ─────────────────────────
#chapter("الجدولة")

#ex("17.1", "جدولْ مهمّةً دوريّة", "متقدّم")
#goal[أن يشغّل النظامُ أمرَك نيابةً عنك في وقتٍ محدّدٍ كلَّ يوم.]
#doit[جدولْ سكربتًا يعمل كلَّ يومٍ منتصفَ الليل.]
#win(`schtasks /create /tn backup /tr "pwsh.exe -NoProfile -File C:\path\script.ps1" /sc daily /st 00:00`)
#linux(`(crontab -l 2>/dev/null; echo '0 0 * * * /path/script.sh') | crontab -`)
#mac(`(crontab -l 2>/dev/null; echo '0 0 * * * /path/script.sh') | crontab -`)
#bsd(`(crontab -l 2>/dev/null; echo '0 0 * * * /path/script.sh') | crontab -`)
#diff[اليونِكس يقرأ الجدولَ الحاليّ ثمّ يضيف إليه سطرَ `cron` ويعيد تثبيته؛ حقول السطر الخمسة هي الدقيقة والساعة ويوم الشهر والشهر ويوم الأسبوع. وويندوز يصرّح بالمهمّة كاملةً، ويستدعي `pwsh.exe` صراحةً حتى لا يعتمد تشغيل ملفّ `.ps1` على اقتران الامتداد. استبدل المسارات النموذجيّة بمساراتٍ مطلقة حقيقية.]
#ex-challenge[افهمِ الحقولَ الخمسة: `30 8 * * 1` تعني «الثامنةَ ونصفًا صباحَ كلِّ اثنين». جرّبْ موقع `crontab.guru` ليشرح لك أيَّ سطر.]

// ───────────────────────── الفصل 18 ─────────────────────────
#chapter("الأقراص والتخزين")

#ex("18.1", "كم بقيَ من مساحة؟", "أساسيّ")
#goal[أن تعرف المساحة الحرّة على أقراصك قبل أن تمتلئ.]
#doit[اعرض المساحةَ المستعمَلةَ والحرّةَ على كلّ الأقراص.]
#win(`Get-PSDrive -PSProvider FileSystem`)
#linux(`df -h`)
#mac(`df -h`)
#bsd(`df -h`)
#diff[اليونِكس `df -h` (اختصار _disk free_، والعَلَم `-h` يعطي أحجامًا بشريّةً كـ`12G` بدل بايتاتٍ خام). وويندوز `Get-PSDrive` (أو `Get-Volume` الأغنى). كلاهما يعرض لكلّ قرصٍ حجمَه والمستعمَلَ والباقي.]

#ex("18.2", "ما الذي يملأ القرص؟", "متوسّط")
#goal[أن تكتشف أيُّ مجلّدٍ يلتهم مساحتك.]
#doit[احسبِ الحجمَ الكلّيَّ للمجلّد الحاليّ بما فيه.]
#win(`Get-ChildItem -Recurse | Measure-Object -Property Length -Sum`)
#linux(`du -sh .`)
#mac(`du -sh .`)
#bsd(`du -sh .`)
#diff[اليونِكس `du -sh .` (اختصار _disk usage_، s=مجموعٌ واحد، h=بشريّ) يعطيك حجمَ المجلّد كلِّه؛ و`du -sh *` يفصّله لكلّ عنصرٍ داخله. وويندوز لا `du` مدمج، فتجمع بـ`Get-ChildItem -Recurse | Measure-Object`. والبديلُ التفاعليّ الجميل `ncdu` (يُثبَّت حزمةً) يستكشف ما يملأ قرصك بصريًّا في اليونِكس الثلاثة.]

// ───────────────────────── الفصل 19 ─────────────────────────
#chapter("المراقبة")

#ex("19.1", "منذ متى يعمل النظام؟", "أساسيّ")
#goal[أن تعرف منذ متى يعمل جهازك، وكم هو مزدحم.]
#doit[اعرض مدّةَ تشغيل النظام منذ آخر إقلاع.]
#win(`Get-Uptime`)
#linux(`uptime`)
#mac(`uptime`)
#bsd(`uptime`)
#diff[اليونِكس `uptime` سطرٌ واحدٌ غنيّ: منذ متى يعمل، وكم مستخدمًا متّصل، و«متوسّطُ الحِمل» (load average) في آخر 1 و5 و15 دقيقة — مقياسٌ يونِكسيٌّ أنيقٌ لازدحام المعالج. وويندوز `Get-Uptime` (في PowerShell 6 فأحدث).]

#ex("19.2", "من متّصلٌ الآن؟", "أساسيّ")
#goal[أن تعرف من يستعمل النظام هذه اللحظة (مهمٌّ على خادمٍ مشترَك).]
#doit[اعرض المستخدمين المتّصلين بالنظام الآن.]
#win(`query user`)
#linux(`who`)
#mac(`who`)
#bsd(`who`)
#diff[اليونِكس `who` يعرض من دخل ومتى ومن أين؛ ونظيرُه الأغنى `w` يضيف ما يفعله كلُّ متّصلٍ الآن. وويندوز `query user` (أو `quser`). على خادمٍ يخدم كثيرين، هذه أوّلُ نافذةٍ تطلّ منها على من معك.]

// ───────────────────────── الفصل 20 ─────────────────────────
#chapter("الأرشفة والنسخ الاحتياطيّ")

#ex("20.1", "اضغطْ مجلّدًا", "متوسّط")
#goal[أن تجمع مجلّدًا في ملفٍّ واحدٍ مضغوطٍ لحفظه أو نقله.]
#doit[اضغطْ مجلّد `docs` في أرشيفٍ واحد.]
#win(`Compress-Archive docs docs.zip`)
#linux(`tar czf docs.tar.gz docs`)
#mac(`tar czf docs.tar.gz docs`)
#bsd(`tar czf docs.tar.gz docs`)
#diff[اليونِكس أداتُه التقليديّة `tar` (اختصار _tape archive_، من عصر الأشرطة الممغنطة!): الأعلامُ `czf` تعني إنشاء (c) وضغط بـgzip (z) وإلى ملفّ (f)، فتنتج `docs.tar.gz` (تُدعى «تاربول»). وويندوز `Compress-Archive` ينتج `.zip` القياسيّ. لاحظ أنّ `tar` يجمع أوّلًا ثمّ يضغط، فصار للناتج امتدادان.]

#ex("20.2", "فُكَّ الأرشيف", "أساسيّ")
#goal[أن تستخرج محتوى أرشيفٍ ضغطتَه أو نزّلته.]
#doit[فُكَّ محتوى الأرشيف الذي أنشأته.]
#win(`Expand-Archive docs.zip`)
#linux(`tar xzf docs.tar.gz`)
#mac(`tar xzf docs.tar.gz`)
#bsd(`tar xzf docs.tar.gz`)
#diff[اليونِكس `tar xzf` (العَلَم x=استخراج، بدل c=إنشاء). وويندوز `Expand-Archive`. حيلةُ تذكّرِ `tar`: `c`reate للإنشاء و`x`tract للفكّ، مع `z` للضغط و`f` للملفّ. وهو أصيلٌ في اليونِكس الثلاثة بالحرف نفسه، فمعرفتُه تنتقل كما هي.]

#ex("20.3", "انسخْ احتياطيًّا بالمزامنة", "متقدّم")
#goal[أن تنسخ مجلّدًا احتياطيًّا بنقل التغييرات فقط، لا كلّ شيءٍ كلَّ مرّة.]
#doit[زامِنْ مجلّد `data` إلى `backup` بنقل ما تغيّر فقط.]
#win(`robocopy data D:\backup /MIR`)
#linux(`rsync -a --delete data/ backup/`)
#mac(`rsync -a --delete data/ backup/`)
#bsd(`rsync -a --delete data/ backup/`)
#diff[جوهرةُ النسخ المتكرّر في اليونِكس `rsync`: ينقل *الفروقَ* فقط لا كلَّ الملفّات، فيسرع جدًّا في النسخ اليوميّ (`-a` يحفظ الأذونَ والتواريخ، `--delete` يزيل من الوجهة ما حُذف من المصدر). وويندوز نظيرُه المدمج `robocopy` مع `/MIR` (مرآة). *تنبيه:* `rsync` قد يحتاج تثبيتًا على FreeBSD (`pkg install rsync`).]
