  columns: (auto, auto, 1fr),
  align: (x, y) => if x <= 1 { center + horizon } else { right + horizon },
  table.header([الأمر الموحّد], [المستعارات], [الوظيفة]),
  [`Get-Module`],     [`gmo`],  [اعرض الوحدات المحمّلة، أو المتاحة بـ `-ListAvailable`.],
  [`Import-Module`],  [`ipmo`], [حمّل وحدةً لتتاح أوامرها في الجلسة.],
  [`Remove-Module`],  [`rmo`],  [أزِل وحدةً محمّلةً من الجلسة الحاليّة.],
  [`Find-Module`],    [`—`],    [ابحث عن وحدةٍ في معرض PowerShell (PSGallery).],
  [`Install-Module`], [`—`],    [نزّل وحدةً وثبّتها من المعرض.],
)
