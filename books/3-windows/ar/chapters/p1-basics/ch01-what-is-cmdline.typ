#chapter[ما سطر الأوامر في ويندوز؟]

#objectives((
  [تعرف ما «سطر الأوامر»، ولماذا يوجد بجوار الفأرة والنوافذ في ويندوز.],
  [تميّز بين ثلاث أدوات يخلط بينها الكثيرون: موجّه الأوامر، وPowerShell، وWindows Terminal.],
  [تفتح كلًّا منها بنفسك، وتكتب أوّل أمرٍ في حياتك.],
  [تقرأ «تشريح الأمر»: الفعل، والخيار، والمُعطى — في الصدفتين معًا.],
  [تدرك أنّ لويندوز فلسفةً تخصّه، تختلف عن عالم يونِكس.],
))

تخيّل فندقًا كبيرًا. أغلب النزلاء يتنقّلون بالمصاعد واللافتات المضيئة: يضغطون الأزرار، ويتبعون الأسهم، ولا يحتاجون أن يعرفوا ما خلف الجدران. لكنْ خلف بابٍ صغيرٍ مكتوبٍ عليه «للموظّفين» يمتدّ ممرٌّ خدميّ، يتحرّك فيه العاملون بسرعة، يحملون أشياء كثيرة دفعةً واحدة، ويصلون إلى غرفٍ لا يبلغها النزيل العاديّ. ويندوز مثل هذا الفندق تمامًا: الواجهة الملوّنة بالفأرة والنوافذ هي بهو النزلاء، وسطر الأوامر هو ذلك الممرّ الخدميّ. في هذا الكتاب سنفتح ذلك الباب.

#section[ويندوز: واجهةٌ تراها، وأخرى تكتبها]

حين تشغّل حاسوبك يستقبلك *سطح المكتب*: أيقوناتٌ، ونوافذ، وزرُّ ابدأ. تحرّك الفأرة وتنقر، فيستجيب النظام. هذه تُسمّى *الواجهة الرسوميّة*، وهي الطريقة التي صار بها ويندوز مشهورًا في العالم كلّه.

#define("الواجهة الرسوميّة (GUI)", [
  طريقة التعامل مع الحاسوب بالصور والأزرار والنوافذ عبر الفأرة. اختصارها ‏GUI (‏Graphical User Interface). هي الأسهل للمبتدئ، لكنها ليست الوحيدة.
])

خلف هذه الواجهة الجميلة توجد طريقةٌ أخرى للتعامل مع الجهاز: أن *تكتب* له ما تريد بدل أن تنقر. تفتح نافذةً بسيطة، تكتب فيها كلمةً، تضغط #kbd("Enter")، فينفّذ الجهاز أمرك ويردّ عليك بنصّ. هذه هي *سطر الأوامر*.

#define("سطر الأوامر (Command Line)", [
  طريقةٌ لقيادة الحاسوب بكتابة أوامر نصّية بدل النقر بالفأرة. تكتب أمرًا، فيفعله الجهاز ويعرض لك الجواب نصًّا. تُسمّى أيضًا *واجهة سطر الأوامر* (‏CLI).
])

قد تسأل: ولمَ أكتب وأنا أستطيع النقر؟ لأنّ الكتابة أدقّ وأسرع وأقوى في مواطن كثيرة. الأمر الواحد يعالج ألف ملفٍ دفعةً واحدة، ويُحفظ ليُعاد تشغيله متى شئت، ويصل إلى إعداداتٍ لا زرَّ لها في الواجهة أصلًا. لذلك يعيش كلّ محترفٍ في ويندوز — من مدير الخوادم إلى المبرمج — نصف يومه في هذا الممرّ.

#note[
  الأمر ليس اختيارًا بين الواجهة وسطر الأوامر، بل تعاونٌ بينهما. تفتح مستنداتك بالفأرة، وتضبط النظام بالأوامر. المحترف يستعمل الأنسب لكلّ مهمّة، لا يتعصّب لأداة.
]

#section[الأداة والصدفة: مصطلحان لا بدّ منهما]

قبل أن نمضي، لا بدّ من كلمتين تتردّدان كثيرًا، وكثيرٌ يخلط بينهما. حين تكتب أمرًا، هناك برنامجان يعملان: *نافذةٌ* تكتب فيها وترى النتيجة، *وعقلٌ* خفيٌّ يفهم أمرك وينفّذه.

#define("الصدفة (Shell)", [
  البرنامج الذي يقرأ الأمر الذي تكتبه، ويفهم معناه، ويأمر النظام بتنفيذه، ثم يعرض لك النتيجة. في ويندوز صدفتان مشهورتان: *موجّه الأوامر* #box[*وPowerShell*].
])

#define("الطرفية (Terminal)", [
  النافذة التي تُظهر لك الصدفة: تكتب فيها بلوحة المفاتيح، وتقرأ فيها الناتج. الطرفيةُ هي النافذة المرئيّة؛ والصدفةُ هي العقل الذي يعمل خلفها.
])

الفرق دقيقٌ لكنه يوضّح كلّ ما يأتي: *الطرفيةُ نافذة، والصدفةُ مترجم*. والنافذة الواحدة قد تحتضن أكثر من صدفة. تذكّر هذا التمييز الآن، وسيُريحك لاحقًا حين نتحدّث عن Windows Terminal.

#section[ثلاث أدواتٍ لبابٍ واحد]

يقدّم ويندوز ثلاث أدواتٍ لكتابة الأوامر. الخلط بينها أوّل ما يحيّر المبتدئ، فلنفصّلها.

#subsection[موجّه الأوامر (CMD): الجدّ]

أقدمها. صدفةٌ ورثها ويندوز عن نظامٍ قديمٍ اسمه ‏DOS من ثمانينيّات القرن الماضي. بسيطةٌ، سريعةٌ، محدودةٌ. تعرف عددًا ثابتًا من الأوامر مثل `dir` و `copy` و `del`، وتتعامل مع كلّ شيءٍ بوصفه *نصًّا*. لا تزال موجودةً في كلّ نسخة ويندوز حتى اليوم للتوافق مع البرامج القديمة.

#define("موجّه الأوامر (CMD)", [
  أقدم صدفة في ويندوز، ملفّها `cmd.exe`. بسيطةٌ ومحدودة، مناسبةٌ للمهامّ السريعة وسكربتات *الباتش* القديمة (ملفّاتٌ نصّية تجمع أوامر تُنفَّذ دفعةً واحدة، امتدادها `.bat`). تُسمّى اختصارًا CMD.
])

#subsection[PowerShell: الوريث الحديث]

صدفةٌ حديثةٌ صمّمتها مايكروسوفت لتكون أقوى بكثير. لا تتعامل مع النصوص وحدها، بل مع *الكائنات* — وهذا فرقٌ جوهريٌّ سنعود إليه. أسماء أوامرها منظّمةٌ على نسقٍ واحد (فعل-اسم مثل `Get-Date`)، وتقدر على أتمتة أعقد المهامّ الإداريّة. هي أداة المحترف اليوم.

#define("PowerShell", [
  صدفة ويندوز الحديثة والأقوى. تنقل بين الأوامر *كائناتٍ* لا نصوصًا مجرّدة، وأسماء أوامرها على نسق *فعل-اسم* منتظم. هي المحور الأكبر في هذا الكتاب.
])

#subsection[Windows Terminal: النافذة الحاضنة]

هنا يظهر التمييز الذي مهّدنا له. Windows Terminal ليس صدفةً، بل *طرفيةٌ* حديثة: نافذةٌ أنيقةٌ تحتضن الصدفات كلّها في ألسنةٍ (tabs) — لسانٌ لـ CMD، ولسانٌ لـ PowerShell، وثالثٌ لـ WSL (نظام لِينُكس الفرعيّ داخل ويندوز) إن وُجد. هو البهو الأنيق الذي تدخل منه إلى أيّ ممرّ.

#note[
  الخلاصة في سطر: *CMD* #box[*وPowerShell*] صدفتان (عقلان ينفّذان)، #box[*وWindows Terminal*] طرفيةٌ (نافذةٌ تعرض). حين تسمع «افتح الطرفية»، فالمقصود النافذة؛ وحين تسمع «شغّله في PowerShell»، فالمقصود الصدفة.
]

#section[كيف تفتح كلًّا منها]

لنفتحها عمليًّا. عندك أكثر من طريق، وأسرعها اختصارٌ ذهبيّ.

*لفتح موجّه الأوامر (CMD):* اضغط #kbd("Win") + #kbd("R") معًا. تظهر نافذةٌ صغيرةٌ اسمها *تشغيل* (Run). اكتب فيها `cmd` ثم اضغط #kbd("Enter"). ستُفتح نافذةٌ سوداء ينتهي سطرها بالرمز `>`، ومؤشّرٌ يومض.

*لفتح PowerShell:* اضغط زرّ #kbd("Win") لفتح قائمة ابدأ، واكتب `powershell`، ثم اختر «‏Windows PowerShell» من النتائج. ستُفتح نافذةٌ (زرقاء غالبًا) يبدأ سطرها بالحرفين `PS`.

*لفتح Windows Terminal:* اكتب في بحث ابدأ `terminal`، أو انقر بالزرّ الأيمن على زرّ ابدأ واختر «‏Terminal».

#define("نافذة تشغيل (Run)", [
  صندوقٌ صغيرٌ تفتحه بالاختصار #kbd("Win") + #kbd("R")، تكتب فيه اسم برنامجٍ لتشغيله فورًا. أسرع طريقٍ لفتح موجّه الأوامر: اكتب `cmd` واضغط #kbd("Enter").
])

المؤشّر الوامض على السطر يُسمّى *المحثّ* (Prompt): الصدفة تقول لك «أنا مستعدّة، أَملِ عليّ». في موجّه الأوامر يظهر المحثّ كمسارٍ ينتهي بالرمز `>`، هكذا `C:\Users\Ahmad>`؛ وفي PowerShell يسبقه الحرفان `PS`.

#try-it[
  افتح الأدوات الثلاث الآن، كلًّا بطريقته: #kbd("Win") + #kbd("R") ثم `cmd` للأولى، وبحثُ `powershell` للثانية، وبحثُ `terminal` للثالثة. تأمّل شكل المحثّ في كلٍّ منها ولاحظ الفرق بين `>` و `PS`. لا تكتب أمرًا بعد، فقط افتحها وتعرّف عليها.
]

#section[أوّل أمرٍ في حياتك]

يكفي نظريًّا. لنكتب أوّل أمر. في نافذة موجّه الأوامر اكتب الكلمة التالية ثم اضغط #kbd("Enter"):

#session("whoami", output: "desktop-7h2k9q\\ahmad")

`whoami` تعني «مَن أنا؟». أجابت الصدفة باسم الجهاز ثمّ اسم المستخدم الذي دخلتَ به، يفصل بينهما الشرطة العكسية `\`. مبروك — هذا أوّل حوارٍ لك مع النظام. جرّب أمرين آخرين في موجّه الأوامر:

```bat
ver          :: ما إصدار ويندوز؟
echo مرحبا   :: ردّد ورائي هذه الكلمة
```

الطريف أنّ الأمر `whoami` نفسه يعمل في PowerShell أيضًا. افتح PowerShell واكتبه:

#session("whoami", output: "desktop-7h2k9q\\ahmad", prompt: "PS>")

نفس الجواب، لكنّ المحثّ تغيّر إلى `PS`. هذا يذكّرك أنّ الأمر الواحد قد يعمل في صدفتين، والمحثّ وحده يخبرك أين أنت.

#try-it[
  في موجّه الأوامر نفّذ `whoami` ثم `ver` ثم `echo` متبوعًا باسمك. ثمّ افتح PowerShell وأعد `whoami`. راقب: هل تغيّر الجواب؟ وهل تغيّر المحثّ؟
]

#warn[
  إن كتبتَ كلمةً لا تعرفها الصدفة، ردّت برسالةٍ مثل `'xyz' is not recognized...` (لا يُعرَف هذا الأمر). لا تقلق؛ ليست كارثة، بل مجرّد خطأٍ في الإملاء غالبًا. صحّحه وأعد المحاولة.
]

#section[الفرق الجوهريّ: نصٌّ مقابل كائنات]

هنا يفترق الجدّ عن الوريث. موجّه الأوامر يرى كلّ شيءٍ *نصًّا*: حين يعرض لك تاريخًا، فهو عندك مجرّد حروفٍ وأرقام، إن أردت منها السنة وحدها اقتطعتها يدويًّا. أمّا PowerShell فيتعامل مع *الكائنات*.

#define("الكائن (Object)", [
  في PowerShell، ليست النتيجة نصًّا مجرّدًا، بل *شيءٌ* له خصائص تسأله عنها. التاريخ كائنٌ له خاصيّةٌ اسمها السنة، وأخرى اسمها اليوم — تطلب أيّها مباشرةً بلا اقتطاع.
])

لنرَ ذلك عيانًا. في PowerShell اكتب `Get-Date`:

#session("Get-Date", output: "Monday, July 20, 2026 11:01:00 AM", prompt: "PS>")

يبدو نصًّا، لكنه في الحقيقة كائنٌ كاملٌ عن اللحظة الحاضرة. اسأله عن سنته وحدها بوضع الأمر بين قوسين ثمّ نقطةٍ فاسم الخاصيّة:

#session("(Get-Date).Year", output: "2026", prompt: "PS>")

هذه قوّةٌ لا يعرفها موجّه الأوامر: لا تقطيع نصوصٍ ولا تخمين. تطلب الخاصيّة باسمها فتأتيك. سنبني على هذه الفكرة كتابًا كاملًا في الجزء الثالث.

#note[
  لاحظ أسماء أوامر PowerShell: `Get-Date`، `Get-Location`، `Get-Process`... كلّها على نسق *فعل-اسم* (‏Verb-Noun): فعلٌ يقول ماذا تريد (`Get` أي «اجلب»)، واسمٌ يقول على ماذا. هذا النظام يجعلك تحزر أسماء أوامرٍ لم ترها قطّ.
]

#tip[
  كثيرٌ من أوامر موجّه الأوامر القديمة تعمل في PowerShell أيضًا، لكنها هناك مجرّد *أسماء بديلة* (aliases) لأوامرٍ حديثة: `dir` اسمٌ بديلٌ لـ `Get-ChildItem`، و`cd` لـ `Set-Location`، و`echo` لـ `Write-Output`. تكتب القديم فيُشغّل الحديث. هذا يسهّل عليك الانتقال.
]

#section[تشريح الأمر: فعلٌ وخيارٌ ومُعطى]

قد يبدو كلّ أمرٍ طلسمًا يُحفظ، لكنّ الحقيقة أجمل: الأوامر *جُمَلٌ* في لغةٍ لها نحو، وأركانها ثلاثة. لنأخذ مثالًا من موجّه الأوامر يعرض محتوى مجلّدٍ بتخطيطٍ عريض:

```bat
dir /w C:\Users
```

- `dir` هو *الفعل*: اسم الأمر، أي ما تريد فعله (هنا: اعرض قائمة الملفّات).
- `/w` هو *خيار* (Option): يعدّل سلوك الفعل. في موجّه الأوامر تبدأ الخيارات بشَرطةٍ مائلة `/`؛ و`/w` يعني «عرضٌ عريض».
- `C:\Users` هو *المُعطى* (Argument): الشيء الذي يقع عليه الفعل، هنا المجلّد المطلوب عرضه.

فالجملة تُقرأ: «اعرض (`dir`) عريضًا (`/w`) محتوى المجلّد (`C:\Users`)». والأمر نفسه في PowerShell له الأركان الثلاثة، لكنّ الخيار يبدأ بشَرطةٍ عاديّة `-` واسمٍ صريح:

```powershell
Get-ChildItem -Path C:\Users
```

- `Get-ChildItem` الفعل (فعل-اسم).
- `-Path` خيارٌ باسمٍ واضح، وقيمته `C:\Users` هي المُعطى.

حين تستوعب هذا التقسيم، تتوقّف عن حفظ الأوامر ككتلٍ مصمتة، وتبدأ في *تأليفها*: تتعلّم أفعالًا، وتركّب بها جملك بنفسك.

#tip[
  للاستفهام عن خيارات أمرٍ في موجّه الأوامر، اكتب اسمه ثمّ `/?` هكذا: `dir /?`. أمّا في PowerShell فالبديل `Get-Help` أو الخيار `-?`. سنفرد للمساعدة الذاتيّة فصلًا كاملًا لاحقًا.
]

#section[ويندوز ليس يونِكس: فلسفةٌ تخصّه]

إن سمعتَ عن لِينُكس أو ماك من قبل، فاعلم أنّ ويندوز يسلك في سطر أوامره مسلكًا مختلفًا، نابعًا من تاريخٍ مختلف. أربعة فروقٍ تلقاها من أوّل يوم:

- *الشرطة في المسارات عكسيّة.* ويندوز يفصل مجلّدات المسار بالشرطة العكسية `\`، هكذا `C:\Users\Ahmad`. أمّا يونِكس فيستعمل الشرطة الأماميّة `/`.
- *أحرف الأقراص.* يبدأ المسار في ويندوز بحرف قرصٍ متبوعٍ بنقطتين، مثل `C:` للقرص الأساس و `D:` لقرصٍ آخر. لا وجود لهذا في يونِكس؛ فكلّ شيءٍ هناك تحت جذرٍ واحد.
- *الخيارات بشَرطةٍ مائلة.* أوامر موجّه الأوامر تكتب خياراتها بـ `/` مثل `/w`، بينما يونِكس يستعمل `-`.
- *لا يفرّق بين كبير الحرف وصغيره.* في ويندوز `DIR` و `dir` سواء، والملفّ `Report.txt` و `report.txt` اسمٌ واحد. يونِكس يفرّق بينها بدقّة.

#distro[
  على لِينُكس وماك: المسارات بالشرطة الأماميّة `/` بلا أحرف أقراص (كلّ شيءٍ تحت `/`)، والخيارات بالشَرطة `-`، والنظام يفرّق بين كبير الحرف وصغيره، والمحثّ ينتهي غالبًا بالرمز `$` لا `>`. فلسفتان وُلدتا في بيئتين مختلفتين.
]

هذه ليست عيوبًا ولا مزايا، بل *لهجاتٌ* مختلفة. من عرف أصلها لم تربكه، ومن جهله ظنّها أخطاء.

#danger[
  في هذا الكتاب أوامر عظيمة القوّة تحذف بلا سلّة محذوفات ولا رجعة: `del` يمحو الملفّات، و`rmdir /s` يمحو مجلّدًا بكلّ ما فيه، و`format` يمسح قرصًا كاملًا، و`taskkill /f` يقتل برنامجًا قسرًا، و`shutdown` يطفئ الجهاز. لن نستعملها الآن؛ وحين نصل إليها سنقف عندها طويلًا. القاعدة الذهبيّة: لا تكتب أمرًا لا تفهمه.
]

#section[خلاصة الفصل]

تعلّمت أنّ لويندوز واجهتين: رسوميّةً تنقر فيها، وسطرَ أوامر تكتب فيه، والمحترف يمزج بينهما. وأنّ خلف الأوامر *صدفةً* تفهم وتنفّذ، تعرضها *طرفيةٌ* هي النافذة. وأنّ ويندوز يقدّم صدفتين — موجّه الأوامر القديم البسيط، وPowerShell الحديث القويّ الذي ينقل الكائنات لا النصوص — وطرفيةً حاضنةً هي Windows Terminal. وفتحتَ الثلاث، وكتبتَ أوّل أوامرك، وعرفتَ أنّ كلّ أمرٍ جملةٌ من فعلٍ وخيارٍ ومُعطى، وأنّ لويندوز فلسفةً تخصّه تختلف عن يونِكس. في الفصل التالي سنتعلّم التنقّل بين مجلّدات النظام وأقراصه.

#challenge[
  أوّلًا، دون أن تنظر أعلاه، أجب: ما الفرق بين الصدفة والطرفية؟ وأيُّ الثلاثة طرفيةٌ لا صدفة؟ ثانيًا، افتح موجّه الأوامر ونفّذ أمرًا واحدًا يجمع فعلًا وخيارًا ومُعطى (تلميح: جرّب `dir /w` متبوعًا بمسارٍ مثل `C:\`). ثالثًا، افتح PowerShell وخمّن ماذا يعطيك `(Get-Date).DayOfWeek` قبل أن تجرّبه، ثم جرّبه: هل صحّ حدسك؟
]
