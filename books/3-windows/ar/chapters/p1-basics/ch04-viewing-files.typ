#chapter[عرض الملفّات وقراءتها]

#objectives((
  [تعرض محتوى أيّ ملفٍّ نصّيٍّ على الشاشة بأمرٍ واحدٍ هو `type`.],
  [تقرأ الملفّات الطويلة صفحةً صفحةً بالأمر `more`، وتتحكّم في تصفّحه بالمفاتيح.],
  [تبحث عن كلمةٍ داخل ملفٍّ — أو داخل مجلّدٍ بأكمله — بالأمر `findstr` وأبرز خياراته.],
  [تميّز الملفّ النصّيّ من الملفّ الثنائيّ، وتفهم لماذا يتلعثم `type` أمام الثاني.],
))

في الفصل الماضي تعلّمتَ أن تسأل الغرفة: «ماذا فيك؟» فيجيبك `dir` بأسماء الملفّات. لكنّ معرفة اسم الكتاب على الرفّ شيء، وفتحَه لتقرأ صفحاته شيءٌ آخر. الاسم يقول لك «هنا ملفٌّ اسمه `notes.txt`»، ولا يقول حرفًا عمّا بداخله. في هذا الفصل نفتح الكتب: نعرض محتوى الملفّات على الشاشة، ونتصفّح الطويلَ منها على مهل، ونبحث في صفحاتها عن كلمةٍ بعينها دون أن نقلّبها بأعيننا سطرًا سطرًا.

#section[نظرةٌ خاطفة: الأمر type]

أبسط طريقةٍ لرؤية ما في ملفٍّ نصّيّ أن تصبّه كاملًا على الشاشة دفعةً واحدة. هذا عمل الأمر `type`: تعطيه اسم ملفٍّ فيطبع محتواه كما هو، من أوّله إلى آخره.

```bat
type notes.txt
```

يقرأ ويندوز الملفّ ويعرض أسطره على الشاشة، ثم يعيدك إلى المحثّ في سطرٍ جديدٍ منتظرًا أمرَك التالي. لا يفتح نافذةً، ولا يستدعي برنامجًا؛ مجرّد نصٍّ ينسكب أمامك:

#session("type notes.txt", output: "Meeting at 9:00
Buy: milk, bread, coffee
Call Ahmed about the report")

الأمر يقبل أكثر من ملفٍّ في السطر الواحد، فيطبعها بالترتيب واحدًا إثر آخر:

```bat
:: اعرض الملفّين متتابعَين
type notes.txt todo.txt
```

#define("الملفّ النصّيّ (Text File)", [
  ملفٌّ محتواه حروفٌ وأرقامٌ ورموزٌ مقروءةٌ للإنسان مباشرةً، كالملاحظات وملفّات الإعداد والشيفرة البرمجيّة. امتداده غالبًا `.txt` أو `.log` أو `.ini` أو `.csv`. هذا هو النوع الذي صُنع له `type`.
])

#subsection[حين يتلعثم type: الملفّات الثنائيّة]

جرّب أن تصبّ ملفًّا ليس نصًّا — صورةً `.jpg` أو برنامجًا `.exe` — بالأمر `type photo.jpg`، وسترى الشاشة تمتلئ برموزٍ غريبةٍ وطقطقةٍ وربّما صفيرٍ من السمّاعة. لم يُعطب شيء؛ ما جرى أنّ `type` لا يفهم إلّا النصّ، فحين يلقى *ملفًّا ثنائيًّا* يترجم بايتاته العمياء إلى محارفَ لا معنى لها.

#define("الملفّ الثنائيّ (Binary File)", [
  ملفٌّ محتواه بياناتٌ مُرمّزةٌ للحاسوب لا للعين — كالصور والفيديو والبرامج التنفيذيّة. لا يُقرأ بعرضه نصًّا؛ يحتاج إلى البرنامج المخصّص له (مُعاين صور، مشغّل فيديو...).
])

#warn[
  إن امتلأت شاشتك بطلاسمَ بعد `type`، فغالبًا صببتَ ملفًّا ثنائيًّا بالخطأ. اضغط #kbd("Ctrl") + #kbd("C") لإيقاف السيل، وإن بقيت المحارف مشوّشةً بعدها فاكتب `cls` (مسح الشاشة) لتعود نظيفة. لا ضرر وقع على الملفّ ولا على النظام؛ إنّما تشوّش العرض لا غير.
]

#danger[
  الأمر `type` نفسه آمنٌ يقرأ ولا يكتب. لكنّ الخطر يكمن في مرافقه: علامة التوجيه `>`. فحين تكتب `type a.txt > b.txt` ظانًّا أنّك تعرض، فأنت في الحقيقة *تكتب فوق* `b.txt` وتمحو كلّ ما كان فيه بلا سؤالٍ ولا سلّة محذوفات. علامة `>` تدمّر وجهة التوجيه صمتًا. اعرض الملفّ بـ`type` وحده، ولا تضع `>` بعده إلّا وأنت متيقّنٌ من الملفّ الذي ستكتب فوقه.
]

#try-it[
  أنشئ ملفًّا صغيرًا بسرعة عبر `echo مرحبا > hello.txt`، ثم اعرضه بـ`type hello.txt` وتأكّد أنّ كلمتك ظهرت. بعدها جرّب `type` على ملفٍّ حقيقيٍّ من النظام مثل `type C:\Windows\System32\drivers\etc\hosts` وتأمّل محتواه. أخيرًا — على سبيل التجربة فقط — صبّ صورةً بـ`type` ولاحظ الطلاسم، ثم امسح الشاشة بـ`cls`.
]

#distro[
  نظير `type` في لِينُكس وماك هو `cat` (اختصار Concatenate، أي «الوصل»)، ويعمل تمامًا كمثيله: `cat notes.txt` يصبّ الملفّ على الشاشة، و`cat a.txt b.txt` يعرض ملفّين متتابعين. حتّى الفخّ نفسه قائم: علامة التوجيه `>` هناك أيضًا تكتب فوق وجهتها. فكرةٌ واحدةٌ باسمين.
]

#section[على مهل: الأمر more]

يصلح `type` للملفّات القصيرة، لكن ماذا لو كان الملفّ سجلًّا من آلاف الأسطر؟ سيمرّ كالبرق أمام عينيك، وتضيع بدايته قبل أن تُدركها، فلا ترى إلّا ذيله. الحلّ أمرٌ يعرض الملفّ *صفحةً صفحة*، ويتوقّف عند امتلاء الشاشة منتظرًا إشارتَك. اسمه `more`:

```bat
more longfile.log
```

يملأ `more` الشاشة بأوّل صفحةٍ من الملفّ، ثم يقف ويعرض في أسفلها سطرًا فيه `-- More --` (أي «المزيد»)، وهو دعوةٌ للتحكّم: أنت الآن سيّد الوتيرة.

#define("الترقيم الصفحيّ (Paging)", [
  عرض نصٍّ طويلٍ مقسومًا إلى شاشاتٍ متتابعة، يتوقّف بين كلّ شاشةٍ والتالية بانتظار المستخدم، بدل تمريره كاملًا دفعةً واحدة. البرنامج الذي يفعل هذا يُسمّى «مُرقِّمًا» (Pager).
])

عند وقفة `-- More --` تتحكّم بهذه المفاتيح:

- #kbd("Space") (مسافة): اعرض الشاشة *التالية* كاملة.
- #kbd("Enter"): انزل سطرًا *واحدًا* فقط.
- #kbd("Q"): اخرج فورًا (Quit) دون إكمال العرض.

فبالمسافة تقفز صفحةً صفحة، وبالإدخال تتقدّم سطرًا سطرًا حين تريد التدقيق، وبحرف `Q` تنصرف متى وجدتَ مرادك.

#subsection[أنبوبٌ يصبّ في more]

قوّة `more` الحقيقيّة تظهر حين لا يقرأ ملفًّا، بل يستقبل ناتج أمرٍ آخر طويل. فبدل أن يفرّ ناتج `dir /s` بمئات الأسطر، تصبّه في `more` عبر *الأنبوب* — العلامة `|` — فيتوقّف صفحةً صفحة:

```bat
:: اعرض سردًا طويلًا صفحةً صفحة
dir /s | more
```

#define("الأنبوب (Pipe)", [
  العلامة `|` التي تأخذ ناتج الأمر على يسارها فتصبّه *مُدخلًا* للأمر على يمينها، بدل أن يُطبع على الشاشة. بها تصل الأوامر بعضها ببعضٍ كأنابيبَ ماءٍ متّصلة، فيغذّي الأوّلُ الثانيَ. سنتوسّع فيها كثيرًا لاحقًا.
])

#tip[
  الأنبوب `|` ليس حِكرًا على `more`؛ إنّه من أعظم أفكار سطر الأوامر كلّه. أيُّ أمرٍ يطبع ناتجًا طويلًا يمكن أن يُصبَّ في `more` ليُقرأ على مهل: `type huge.log | more`، أو `findstr error log.txt | more`. احفظ هذا النمط، فستستعمله كثيرًا.
]

#try-it[
  اعرض ملفًّا طويلًا من النظام صفحةً صفحة: `more C:\Windows\win.ini` (أو أيّ ملفٍّ طويلٍ تعرفه)، وتنقّل فيه بالمسافة ثم بالإدخال، ثم اخرج بـ#kbd("Q"). بعدها جرّب صبّ سردٍ طويلٍ في المُرقّم: `dir C:\Windows /s | more`، وتصفّحه بالمسافة، واخرج متى شئت.
]

#distro[
  في لِينُكس وماك يوجد `more` بالاسم نفسه، لكنّ الشائع هناك أخوه الأقوى `less` — وطُرفة اسمه أنّ «less» صُمّم ليتفوّق على «more» (مِن المثل: less is more). يتيح `less` التمرير إلى الأعلى والأسفل بالأسهم، والبحث داخل النصّ بالضغط على `/`. فحيث تكتب هنا `type f | more`، تكتب هناك `cat f | less` أو `less f` مباشرة.
]

#section[البحث داخل النصّ: الأمر findstr]

تصفّحُ الملفّ بعينك ممكنٌ إن قصُر، أمّا إن طال إلى آلاف الأسطر وأردتَ سطرًا واحدًا يذكر كلمة «error»، فالعين تكِلّ. هنا يتألّق `findstr`: أداةٌ تمرّ على الملفّ نيابةً عنك، وتطبع *فقط* الأسطر التي تحوي ما تبحث عنه، وتطوي ما عداها. اسمُه من «Find String» أي «جِد النصّ».

```bat
findstr error server.log
```

يطبع هذا كلَّ سطرٍ في `server.log` يحوي كلمة `error`، ويهمل البقيّة. صِيغته العامّة: `findstr` ثمّ كلمةُ البحث ثمّ اسمُ الملفّ.

#session("findstr error server.log", output: "[10:31] error: disk full
[10:47] error: timeout on port 8080")

#subsection[خيارات findstr التي لا غنى عنها]

عاريًا مفيد، لكنّ خيارات `findstr` — كسائر خيارات CMD تبدأ بشَرطةٍ أماميّة `/` — تضاعف قوّته:

- `/I` تجاهُل حالة الأحرف (Ignore case): فيطابق `Error` و`ERROR` و`error` سواء. الافتراض أنّ البحث حسّاسٌ لحالة الحرف، وهذا الخيار يلغي الحساسيّة.
- `/N` ترقيم الأسطر (Number): يسبق كلَّ سطرٍ مطابقٍ برقمه في الملفّ، فتعرف *أين* وقع لا أنّه وقع فقط.
- `/S` النزول في الفروع (Subdirectories): يبحث في المجلّد الحاليّ وكلّ ما تحته من مجلّداتٍ فرعيّة — لا في ملفٍّ واحدٍ فحسب.
- `/V` العكس (inVert): يطبع الأسطر التي *لا* تحوي الكلمة، عكسَ الأصل. نافعٌ لاستبعاد ضجيجٍ متكرّر.
- `/C:"..."` سلسلةٌ حرفيّة (literal string): يعامل ما بين علامتَي الاقتباس نصًّا واحدًا بحروفه، ويسمح بأن تحوي الكلمةُ فراغات.

```bat
:: تجاهَل حالة الأحرف
findstr /I error server.log
:: أضِف رقم السطر
findstr /N error server.log
:: الخياران معًا
findstr /I /N error server.log
```

#warn[
  افتراضًا يعامل `findstr` الفراغَ بين الكلمات كـ«أو»: فالأمر `findstr "disk full" log.txt` يبحث عن الأسطر التي تحوي `disk` *أو* `full`، لا التي تحويهما معًا متجاورتين. وانتبه: لا بدّ من الاقتباس المحيط بالكلمتين، فلو كتبتَها بلا اقتباس `findstr disk full log.txt` عدَّ `findstr` أوّلَ كلمةٍ نصَّ البحث وما بعدها أسماءَ ملفّات، فبحث عن `disk` في ملفَّين اسمُهما `full` و`log.txt`. ولتبحث عن العبارة كاملةً بفراغها متجاورةً، أحِطْها بـ`/C:` هكذا: `findstr /C:"disk full" log.txt`. نسيانُ هذا سببٌ شائعٌ لنتائجَ محيّرة.
]

#subsection[البحث في مجلّدٍ كامل]

هنا تتجلّى قدرة `findstr` الفريدة: أن يفتّش ملفّاتٍ كثيرةً دفعةً واحدة. أعطه نمطًا بالنجمة `*` بدل اسم ملفٍّ واحد، فيمرّ على كلّ ما يطابقه:

```bat
:: ابحث عن TODO في كل ملفّات txt نزولًا
findstr /I /S TODO *.txt
```

يبحث هذا عن كلمة `TODO` (بأيّ حالة أحرف، بفضل `/I`) في كلّ ملفّات `.txt` داخل المجلّد الحاليّ وكلّ فروعه (بفضل `/S`)، ويطبع لكلّ نتيجةٍ اسمَ الملفّ الذي وجدها فيه ثمّ السطر. بأمرٍ واحدٍ فتّشتَ شجرةً كاملةً من الملفّات.

#session("findstr /I /S TODO *.txt", output: "project\\notes.txt:TODO: fix the login bug
project\\ideas.txt:todo: call the designer")

#tip[
  يدعم `findstr` أنماطًا محدودةً تُسمّى *التعابير النمطيّة* عبر الخيار `/R`: مثلًا `findstr /R "^error" log.txt` يطابق الأسطر التي *تبدأ* بكلمة `error` (العلامة `^` تعني «بداية السطر»). هذا بابٌ واسعٌ للبحث الذكيّ، وسنطرقه بتوسّعٍ في فصولٍ لاحقة؛ يكفيك الآن أن تعرف أنّ الأداة أعمق ممّا تبدو.
]

#try-it[
  انتقل إلى مجلّدٍ فيه ملفّاتٌ نصّيّة (أو أنشئ بضعةً بـ`echo`)، وابحث فيها عن كلمةٍ تعرف وجودها: `findstr /I /N كلمتك *.txt`. لاحظ أرقام الأسطر التي أضافها `/N`، واسمَ الملفّ الذي سبق كلَّ نتيجة. ثمّ اعكس البحث بـ`/V` وشاهد كيف يطبع كلَّ ما *لا* يحوي كلمتك.
]

#distro[
  نظير `findstr` في لِينُكس وماك هو `grep`، وهو أشهرُ أدوات البحث النصّيّ على الإطلاق. تتشابه الفكرة والخيارات وإن اختلفت الحروف: `grep -i` يوافق `/I` (تجاهُل الحالة)، و`grep -n` يوافق `/N` (ترقيم الأسطر)، و`grep -r` يوافق `/S` (النزول في الفروع)، و`grep -v` يوافق `/V` (العكس). فمن أتقن `findstr` هنا وجد `grep` هناك أليفًا.
]

#section[خلاصة الفصل]

انتقلتَ في هذا الفصل من *رؤية* أسماء الملفّات إلى *قراءة* ما فيها. تعلّمتَ أنّ `type` يصبّ ملفًّا نصّيًّا على الشاشة دفعةً واحدة — عظيمٌ للقصير، عاجزٌ أمام الثنائيّ. وأنّ `more` يعرض الطويلَ صفحةً صفحة، تتنقّل فيه بالمسافة والإدخال وتخرج بـ`Q`، ويستقبل ناتج أوامرَ أخرى عبر الأنبوب `|`. وأنّ `findstr` يفتّش داخل النصّ فيطبع الأسطر المطابقة وحدها، وتضبطه خياراته `/I` و`/N` و`/S` و`/V` و`/C:`، حتّى يجوب مجلّدًا كاملًا بنمطٍ كـ`*.txt`. ورأيتَ في كلّ محطّةٍ شقيقَ الأمر في أنظمةٍ أخرى: `cat` و`less` و`grep`. في الفصل التالي ننتقل من قراءة الملفّات إلى *تعديلها*: إنشاؤها ونسخها ونقلها وحذفها.

#challenge[
  دون أن تنظر إلى الأعلى: أنشئ ملفًّا نصّيًّا بأسطرٍ عدّة (بـ`echo` مع التوجيه `>` ثم `>>` للإضافة)، واعرضه كاملًا بـ`type`. بعدها اعرضه صفحةً صفحة بـ`more`. ثم ابحث فيه عن كلمةٍ تعرفها مع ترقيم الأسطر وتجاهُل الحالة معًا. أخيرًا: خمّن قبل أن تجرّب — ماذا يطبع `findstr /V error server.log`؟ ثم حقّق حدسك.
]
