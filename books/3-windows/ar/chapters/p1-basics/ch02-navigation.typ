#chapter[التنقّل في نظام ملفات ويندوز]

#objectives((
  [تفهم كيف يرتّب ويندوز ملفاته في أقراصٍ منفصلة (`C:` و`D:`) ومجلّداتٍ متداخلة.],
  [تستعرض محتويات أيّ مجلّدٍ بالأمر `dir`، وتضبط شكل الناتج بخياراته `/w` و`/p` و`/a` و`/s`.],
  [تتنقّل بين المجلّدات بالأمر `cd`، وتميّز المسار المطلق من النسبيّ، وتصعد إلى الأعلى بـ`..`.],
  [تنتقل بين الأقراص بكتابة حرف القرص، وتفهم أنّ لكلّ قرصٍ «ذاكرةً» لموقعك فيه.],
  [تقفز إلى مجلّدك الشخصيّ فورًا عبر المتغيّر `%USERPROFILE%`.],
))

تخيّل مبنًى إداريًّا ضخمًا يتكوّن من عدّة أبراجٍ منفصلة، لكلِّ برجٍ مدخلُه الخاصّ. داخل كلّ برجٍ طوابق، وفي كلّ طابقٍ غرف، وفي الغرف خزائن، وفي الخزائن أدراج. لو أردتَ ورقةً بعينها لقلتَ: البرج الأوّل، الطابق الثالث، الغرفة السابعة، الدرج الثاني. هكذا تمامًا ينظّم ويندوز ملفاتك: الأبراج هي *الأقراص*، والطوابق والغرف هي *المجلّدات*، والأوراق هي *الملفّات*. وفي هذا الفصل نتعلّم كيف نتجوّل في هذا المبنى بلا فأرةٍ ولا نقر — بالكلمة وحدها.

#section[المبنى وأبراجه: الأقراص والمجلّدات]

حين تفتح «الكمبيوتر» في ويندوز، ترى أيقوناتٍ مثل `C:` و`D:`. كلٌّ منها *قرص*: مساحة تخزينٍ مستقلّة لها اسمٌ من حرفٍ واحدٍ يتبعه نقطتان. القرص `C:` هو موطن ويندوز نفسه وبرامجك عادةً، و`D:` قد يكون قرصًا صلبًا آخر، أو قسمًا للبيانات، أو ذاكرةً محمولة (فلاشة).

#define("القرص (Drive)", [
  وحدة تخزينٍ مستقلّة في ويندوز، يُشار إليها بحرفٍ ونقطتين مثل `C:` و`D:` و`E:`. لكلّ قرصٍ شجرةُ مجلّداتٍ خاصّةٌ به تبدأ من جذره.
])

داخل القرص تتفرّع المجلّدات بعضها في بعض، كالغرف داخل الغرف. المجلّد صندوقٌ يحوي ملفّاتٍ ومجلّداتٍ أخرى.

#define("المجلّد (Folder / Directory)", [
  حاوٍ يجمع ملفّاتٍ ومجلّداتٍ أخرى تحته. الكلمتان «مجلّد» (Folder) و«دليل» (Directory) تعنيان الشيء نفسه؛ الأولى لغةُ الواجهة الرسوميّة، والثانية لغةُ سطر الأوامر.
])

لتصف موقع ملفٍّ أو مجلّدٍ بدقّة، تكتب *المسار* إليه: سلسلة الأبراج والغرف مفصولةً بالشَّرطة العكسيّة `\`. فمثلًا المسار `C:\Users\Heitham\Documents` يُقرأ: في القرص `C:`، ادخل مجلّد `Users`، ثم `Heitham`، ثم `Documents`.

#define("المسار (Path)", [
  العنوان الكامل لملفٍّ أو مجلّدٍ، تُفصَل حلقاته بالشَّرطة العكسيّة `\`. يبدأ المسار *المطلق* من حرف القرص (مثل `C:\Windows`)، فيصف الطريق كاملًا لا لبس فيه.
])

#warn[
  علامة الفصل في ويندوز هي الشَّرطة العكسيّة `\` (تنحدر إلى اليسار)، لا الشَّرطة الأماميّة `/` التي اعتادها من جاء من الويب أو من أنظمةٍ أخرى. اخلطْ بينهما وقد يرفض الأمرُ العمل. تذكّر: مسارات ويندوز «تتّكئ إلى الخلف».
]

#distro[
  في لِينُكس وماك لا توجد أحرفُ أقراصٍ أصلًا، ولا أبراجٌ منفصلة: كلُّ شيءٍ يتفرّع من جذرٍ واحدٍ اسمه `/`، وتُفصَل المسارات بالشَّرطة الأماميّة، فيصير المسار مثلًا `/home/heitham/Documents`. مبنى ويندوز عدّةُ أبراج، ومبنى لِينُكس برجٌ واحدٌ عملاق.
]

#section[استعراض المحتويات: الأمر dir]

الآن وقد عرفتَ المبنى، لنقف في غرفةٍ ونسأل: «ماذا في هذه الغرفة؟». هذا عمل الأمر `dir` (اختصار Directory): يسرد لك ما في المجلّد الحاليّ من ملفّاتٍ ومجلّدات.

```bat
dir
```

يعرض `dir` قائمةً بأعمدة: تاريخ التعديل ووقتُه، وهل العنصر مجلّدٌ (يظهر بجانبه `<DIR>`) أم ملفّ، وحجم الملفّ بالبايت، ثم اسمه. ويختم بسطرٍ يلخّص عدد الملفّات والمجلّدات والمساحة الفارغة. صياغةُ هذه السطور تختلف قليلًا بين إصدارات ويندوز ولغة النظام، فلا تقلق إن رأيتَ ترتيبًا مغايرًا لما هنا؛ المعنى واحد.

#session("dir", output: " Directory of C:\\Users\\Heitham

19/07/2026  09:14    <DIR>          Documents
19/07/2026  09:14    <DIR>          Downloads
18/07/2026  22:01             1,024 notes.txt
               1 File(s)          1,024 bytes
               2 Dir(s)  84,300,000,000 bytes free")

العمود الأهمّ الآن هو `<DIR>`: كلُّ سطرٍ يحمله هو مجلّدٌ تستطيع الدخول إليه، وما عداه ملفّات.

#subsection[خيارات dir الأربعة]

الأمر مفيدٌ عاريًا، لكنّ خياراته تجعله طيّعًا. وخيارات ويندوز في CMD تبدأ بشَرطةٍ أماميّة `/` (لا `-` كما في أنظمةٍ أخرى):

- `/w` عرضٌ عريض (Wide): الأسماء فقط مصفوفةً في أعمدةٍ متجاورة، بلا تواريخَ ولا أحجام. مثاليٌّ لرؤية «ما هنا» بسرعة.
- `/p` صفحةً صفحة (Page): يتوقّف بعد كلّ شاشةٍ ممتلئة وينتظر ضغطة مفتاحٍ لتكملة العرض. لا غنى عنه في المجلّدات الطويلة.
- `/a` الكلّ (All): يُظهر حتى الملفّات المخفيّة وملفّات النظام التي يخفيها `dir` افتراضيًّا.
- `/s` الفروع (Subdirectories): يسرد محتوى المجلّد الحاليّ وكلَّ ما تحته من مجلّداتٍ فرعيّةٍ نزولًا. قويٌّ جدًّا — واسِعُ الأثر.

```bat
:: أسماء فقط في أعمدة عريضة
dir /w
:: توقّفٌ عند كل شاشة
dir /p
:: أظهِر المخفيّ وملفّات النظام أيضًا
dir /a
:: انزل في كل المجلّدات الفرعية
dir /s
```

تستطيع دمج الخيارات: `dir /a /w` يعرض كلَّ شيءٍ بما فيه المخفيّ بأسلوبٍ عريض. ويمكن أن يطبع `dir /s` على قرصٍ كاملٍ آلافَ السطور؛ لذا قرِنْه بـ`/p` أو أوقفه بـ#kbd("Ctrl") + #kbd("C") إن طال.

#tip[
  لتوجيه ناتج `dir` كي تبحث فيه لاحقًا، اسبقه بمرشّح. مثلًا `dir /s /b` يطبع المسارات فقط سطرًا سطرًا (`/b` أي Bare، صيغةٌ عاريةٌ بلا زينة)، وهي مثاليّةٌ حين تريد قائمةً نظيفةً بالمسارات.
]

#try-it[
  افتح موجّه الأوامر (CMD)، ثم نفّذ `dir` وحده وتأمّل الأعمدة. بعدها جرّب `dir /w` ولاحظ كيف تقلّص العرض، ثم `dir /a` وابحث عن أسماءٍ لم تكن ظاهرة. أخيرًا: `dir /s /p` وشاهد كيف ينزل في الفروع صفحةً صفحة — واضغط #kbd("Ctrl") + #kbd("C") لإيقافه.
]

#distro[
  نظيرُ `dir` في لِينُكس وماك هو `ls`، وخياراته تبدأ بشَرطةٍ واحدة: `ls -l` للتفصيل، و`ls -a` للمخفيّ (يوافق `/a`)، و`ls -R` للنزول في الفروع (يوافق `/s`). فكرةٌ واحدة، لهجتان.
]

#section[التنقّل: الأمر cd]

معرفةُ ما في الغرفة شيء، والانتقالُ إلى غرفةٍ أخرى شيءٌ آخر. أداةُ التنقّل هي `cd` (اختصار Change Directory، أي «غيّر المجلّد»). تكتب `cd` متبوعًا باسم المجلّد الذي تريد الدخول إليه:

```bat
cd Documents
```

انتقلتَ الآن إلى داخل `Documents`، وسيتغيّر المحثّ ليعكس موقعك الجديد. وإن كتبتَ `cd` وحده بلا اسم، طبع لك ويندوز موقعك الحاليّ — سؤالٌ مفيدٌ متى ضللتَ: «أين أنا الآن؟».

#session("cd", output: "C:\\Users\\Heitham\\Documents")

#subsection[الصعود إلى الأعلى: النقطتان ..]

للدخول ننزل، وللخروج نصعد. المجلّد الأعلى (الأب) له اسمٌ مختصرٌ ثابت: نقطتان `..`. فأينما كنت، ينقلك `cd ..` درجةً واحدةً إلى الوراء نحو الجذر:

```bat
:: اصعد مجلّدًا واحدًا نحو الأعلى
cd ..
:: اصعد مجلّدين دفعةً واحدة
cd ..\..
```

#define("النقطتان ..", [
  رمزٌ يعني «المجلّد الأب»، أي المجلّد الذي يحوي مجلّدك الحاليّ. تكتبه في أيّ مسارٍ لتصعد درجةً إلى الأعلى، وتكرّره بالشَّرطة العكسيّة لتصعد أكثر.
])

#subsection[المطلق والنسبيّ]

هنالك طريقتان لتصف الوِجهة. المسار *المطلق* يبدأ من حرف القرص ويصف الطريق كاملًا، فيصلح من أيّ مكانٍ كنت فيه:

```bat
cd C:\Windows\System32
```

والمسار *النسبيّ* يبدأ من موقعك الحاليّ، فيصف الطريق منه لا من الجذر. لو كنتَ في `C:\Users\Heitham` فإنّ `cd Documents` يفهمها ويندوز نسبةً إليك، أي `C:\Users\Heitham\Documents`.

#define("المسار النسبيّ (Relative Path)", [
  مسارٌ يُحسب انطلاقًا من مجلّدك الحاليّ لا من جذر القرص، فلا يبدأ بحرف قرصٍ ولا بشَرطةٍ عكسيّة. `Documents\Reports` مسارٌ نسبيّ؛ و`C:\Users` مسارٌ مطلق.
])

قاعدةٌ ذهبيّة: إن بدأ المسار بحرفِ قرصٍ أو بشَرطةٍ عكسيّةٍ فهو مطلق، وإلّا فهو نسبيّ إلى مكانك. و`cd \` وحدها تقفز بك إلى جذر القرص الحاليّ مباشرةً — أعلى نقطةٍ في البرج.

#try-it[
  من مجلّدك الشخصيّ، انزل إلى `Documents` بـ`cd Documents`، ثم تحقّق بموقعك بكتابة `cd` وحده. بعدها اصعد بـ`cd ..` وتحقّق ثانيةً. أخيرًا اقفز إلى الجذر بـ`cd \` وشاهد أين حطّ بك المحثّ.
]

#danger[
  أمرا `cd` و`dir` آمنان تمامًا: يقرآن ولا يكتبان، فتجوّل بهما بلا خوفٍ ما شئت. لكن احذر: في الفصول القادمة ستلقى أوامرَ *تحذف* بلا سلّة محذوفاتٍ ولا رجعة — مثل `del` لحذف الملفّات، و`rmdir /s` لمسح مجلّدٍ بكامل ما تحته، و`format` لمحو قرصٍ بأسره. تأكّد دومًا من موقعك بـ`cd` قبل أن تطلق أمرًا مدمّرًا؛ حذفُ الملفّ الصحيح في المجلّد الخطأ كارثة.
]

#distro[
  الأمر `cd` نفسه موجودٌ في لِينُكس وماك بالاسم ذاته والمعنى ذاته، والنقطتان `..` تعنيان المجلّد الأب هناك أيضًا. الفرق الوحيد أنّ فاصل المسار شَرطةٌ أماميّة، فتكتب `cd /etc` بدل `cd C:\Windows`.
]

#section[التنقّل بين الأقراص]

هنا مفاجأةٌ تربك القادمين الجدد. لو كنتَ في القرص `C:` وكتبتَ `cd D:\Projects` طامعًا في القفز إلى القرص `D:`، فقد لا ينتقل بك المحثّ كما تتوقّع. السبب أنّ `cd` وحده — افتراضيًّا — يغيّر المجلّد *داخل القرص الحاليّ فقط*، ولا يقفز بين الأبراج.

للانتقال إلى قرصٍ آخر، اكتب حرفه ونقطتيه وحدَهما، كأنّهما أمرٌ قائمٌ بذاته:

```bat
:: انتقل إلى القرص D
D:
:: عُد إلى القرص C
C:
```

والأعجب أنّ ويندوز يحفظ لكلّ قرصٍ *مجلّدَه الحاليَّ على حِدة*. فحين تغادر `C:` وأنت في `C:\Users\Heitham`، ثم تعود إليه لاحقًا، يعيدك إلى المكان نفسه لا إلى الجذر. كأنّ لكلّ برجٍ حارسًا يتذكّر آخر غرفةٍ وقفتَ فيها:

```bat
C:\Users\Heitham> D:
D:\Projects> cd D:\Games
D:\Games> C:
C:\Users\Heitham> _
```

لاحظ في السطر الأخير: العودةُ إلى `C:` أرجعتك إلى `C:\Users\Heitham`، حيث كنت، لا إلى `C:\`.

#define("متغيّر البيئة (Environment Variable)", [
  اسمٌ محجوزٌ يحمل قيمةً يوفّرها النظام أو تعرّفها أنت، وتُكتب في CMD محاطةً بعلامتَي نسبةٍ مئويّة هكذا `%NAME%`. حين يرى موجّه الأوامر الاسم بين العلامتين، يستبدله بقيمته قبل تنفيذ الأمر.
])

#tip[
  للانتقال بين قرصٍ ومجلّدٍ فيه في خطوةٍ واحدة، استعمل الخيار `/d` مع `cd`: فالأمر `cd /d D:\Games` يبدّل القرص والمجلّد معًا دفعةً واحدة، ويوفّر عليك كتابة `D:` ثم `cd` في سطرين.
]

#try-it[
  إن كان لديك قرصٌ ثانٍ أو فلاشة (فلتكن `D:`)، فانتقل إليه بكتابة `D:`، ثم `dir` لترى ما فيه، ثم عُد بـ`C:` ولاحظ أنّه أعادك إلى موقعك السابق لا إلى الجذر. جرّب أيضًا `cd /d D:\` من داخل `C:` ولاحظ كيف نقلك القرصَ والمجلّد معًا.
]

#section[قفزةٌ إلى البيت: المتغيّر %USERPROFILE%]

لكلّ مستخدمٍ في ويندوز مجلّدٌ شخصيّ يحوي سطح المكتب والمستندات والتنزيلات، عنوانُه عادةً `C:\Users\اسمك`. لكنّ الاسم يختلف من جهازٍ لآخر، فكيف تشير إلى «بيتك» بأمرٍ واحدٍ يصلح في كلّ مكان؟ الجواب متغيّرُ بيئةٍ جاهزٌ اسمه `%USERPROFILE%`، يحمل دائمًا مسارَ مجلّدك الشخصيّ.

اطبع قيمته أوّلًا لتراها بعينك بأمر `echo` (يردّد ما تعطيه):

#session("echo %USERPROFILE%", output: "C:\\Users\\Heitham")

والآن استعمله وِجهةً لـ`cd`، فيقفز بك إلى بيتك أينما كنت في المبنى:

```bat
:: عُد إلى مجلّدك الشخصيّ فورًا
cd %USERPROFILE%
:: أو ادخل مباشرةً إلى تنزيلاتك
cd %USERPROFILE%\Downloads
```

جمالُ هذا أنّه لا يعتمد على اسمك ولا على موقعك الحاليّ: النظام يستبدل `%USERPROFILE%` بمسار بيتك قبل التنفيذ، فيعمل الأمرُ نفسُه على أيّ حاسوبٍ لأيّ مستخدم. وهنالك متغيّراتٌ شقيقةٌ نافعة مثل `%HOMEPATH%` و`%TEMP%` (مجلّد الملفّات المؤقّتة)، سنعود إليها بتوسّعٍ في فصل متغيّرات البيئة.

#note[
  إن كتبتَ اسم المتغيّر خطأً — مثل `%USRPROFILE%` — لن يحدث خطأٌ صريح، بل يطبع `echo` النصَّ كما هو محاطًا بالعلامتين، لأنّ CMD لم يجد متغيّرًا بهذا الاسم فتركه على حاله. فإن رأيت العلامتين `%..%` في الناتج، فاعلم أنّ الاسم بينهما غير معرّف.
]

#distro[
  نظيرُ `%USERPROFILE%` في لِينُكس وماك هو المتغيّر `$HOME`، وله اختصارٌ ألطف: المَحرف `~` (التيلدة). فالأمر `cd ~` هناك يكافئ `cd %USERPROFILE%` هنا. ولاحظ الفرق الشكليّ: ويندوز يحيط المتغيّر بعلامتَي `%`، وتلك الأنظمة تسبقه بعلامة `$`.
]

#try-it[
  نفّذ `echo %USERPROFILE%` واقرأ مسار بيتك. ثم تنقّل إلى أيّ مجلّدٍ بعيدٍ مثل `cd C:\Windows`، وبعدها اكتب `cd %USERPROFILE%` وتحقّق بـ`cd` أنّك عدتَ إلى مجلّدك الشخصيّ في قفزةٍ واحدة.
]

#note[
  الأمر `cd` نفسه يعمل داخل PowerShell أيضًا (فهو اسمٌ بديلٌ للأمر الأصليّ `Set-Location`)، لكنّ لغة المتغيّرات تختلف: في PowerShell تُكتب بيئةُ النظام هكذا `$Env:USERPROFILE` لا بين علامتَي `%`. سنفصّل هذا في القسم الخاصّ بـPowerShell.
]

