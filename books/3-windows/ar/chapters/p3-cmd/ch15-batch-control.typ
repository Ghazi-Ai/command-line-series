#chapter[التحكّم بالتدفّق في الباتش]

#objectives((
  [تجعل سكربتك يقرّر بنفسه بـ`if`: يفحص وجود ملفّ، ونجاح أمرٍ، ويقارن نصّين.],
  [تكرّر خطوةً مرارًا بـ`for`: على قائمة ملفّات، وعلى عدّادٍ، وعلى مجلّدات، وعلى سطور ملفّ.],
  [تقفز داخل السكربت بـ`goto` إلى علامةٍ `:label` تسمّيها بنفسك.],
  [تستدعي سكربتًا آخر أو مقطعًا داخليًّا بـ`call` ثم تعود من حيث انطلقت.],
))

سكربت الفصل الماضي كان كقطارٍ على سكّةٍ واحدة: يبدأ من أوّل سطرٍ، ويمرّ على كلّ محطّةٍ بالترتيب، حتى يبلغ آخرها. لا يختار طريقًا، ولا يعيد محطّةً، ولا يقفز فوق أخرى. لكنّ العمل الحقيقيّ ليس خطًّا مستقيمًا: «*إن* وُجد الملفّ فانسخه، *وإلّا* فأنشئه»، «كرّر هذه الخطوة على *كلّ* ملفّاتِ المجلّد»، «*عُد* إلى البداية وأعد السؤال». هذه القرارات والتكرارات هي *التحكّم بالتدفّق*: أن نمنح السكربت مفاتيحَ تحويلٍ على السكّة، فيختار مساره بنفسه حسب ما يجده. بها تتحوّل الوصفةُ الجامدة إلى برنامجٍ حيٍّ يفكّر.

#define("التحكّم بالتدفّق (Control flow)", [
  ترتيبُ تنفيذ أوامر السكربت: هل تسير في خطٍّ مستقيمٍ من أوّلها لآخرها، أم تتفرّع عند شرطٍ، أم تكرّر مقطعًا، أم تقفز إلى موضعٍ آخر. أدواتُه في الباتش ثلاث: `if` للقرار، و`for` للتكرار، و`goto` للقفز — يعاونها `call` للاستدعاء.
])

#section[القرار: الأمر if]

أوّل ما يحتاجه سكربتٌ ذكيّ أن *يفحص* شيئًا ثم يتصرّف حسب النتيجة. الأمر `if` يقول: «إن تحقّق هذا الشرط، فنفّذ ذاك الأمر». تكتبه متبوعًا بالشرط، ثم الأمر الذي يُنفَّذ عند تحقّقه. وله في الباتش ثلاث صيغٍ تفحص ثلاثة أشياء مختلفة، نأخذها واحدةً واحدة.

#subsection[هل الملفّ موجود؟ if exist]

كثيرًا ما تريد أن تتأكّد من وجود ملفٍّ أو مجلّدٍ قبل أن تعمل عليه — فنسخُ ملفٍّ غير موجودٍ خطأ، وإنشاءُ مجلّدٍ موجودٍ خطأ. الصيغة `if exist` تفحص ذلك، يليها اسم الملفّ ثم الأمر:

```bat
@echo off
if exist report.txt echo The report is here
if not exist report.txt echo No report yet
```

السطر الأوّل: «إن وُجد `report.txt` فاطبع أنّه موجود». والثاني يستعمل `not` ليقلب الشرط: «إن *لم* يوجد فاطبع أنّه مفقود». وحين تريد أن تنفّذ *عدّة* أوامرٍ عند تحقّق الشرط، تجمعها بين قوسين `(` و`)`، وتضع `else` لِما يُفعَل عند عدم تحقّقه:

```bat
@echo off
if exist data.txt (
  echo Found the file, copying it
  copy data.txt backup.txt
) else (
  echo File is missing, creating an empty one
  echo. > data.txt
)
```

اقرأها كجملةٍ واحدة: «إن وُجد `data.txt` فانسخه إلى نسخةٍ احتياطيّة، وإلّا فأنشئ ملفًّا فارغًا مكانه». لاحظ القوس المفتوح `(` في آخر سطر `if`، والقوس المغلق `)` قبل `else` — هذا شكلُ *الكتلة* التي تجمع أوامر متعدّدة تحت شرطٍ واحد.

#warn[
  موضعُ الأقواس دقيق: القوس المفتوح `(` يجب أن يكون في *آخر* سطر `if` نفسِه، لا في سطرٍ جديد. وكلمة `else` يجب أن تكون على سطر القوس المغلق `)` هكذا `) else (`، لا في سطرٍ مستقلّ. مخالفة هذا الشكل من أشيع أسباب رسالة الخطأ الغامضة `else was unexpected at this time`.
]

#subsection[هل نجح الأمر؟ errorlevel]

كلُّ أمرٍ ينفّذه ويندوز يترك خلفه *رمز خروجٍ* رقميّ: صفرٌ يعني «نجحتُ»، وأيُّ رقمٍ أكبر يعني «أخفقتُ» (وكلُّ رقمٍ معناه خطأٌ مختلف). هذا الرمز اسمه `errorlevel`، وبه يعرف سكربتك هل تمّت الخطوة السابقة أم فشلت، فيقرّر ماذا يفعل بعدها.

#define("رمز الخروج (errorlevel)", [
  رقمٌ يتركه كلُّ أمرٍ بعد تنفيذه ليخبر عن حصيلته: `0` نجاحٌ تامّ، وما فوقه إخفاقٌ من نوعٍ ما. تقرؤه في الباتش بصيغة `if errorlevel N` أو عبر المتغيّر `%errorlevel%`. هو حاسّةُ سكربتك التي يدرك بها ما إذا سار الأمر على ما يُرام.
])

الصيغة `if errorlevel N` لها معنًى خاصٌّ يجب أن تحفظه: تتحقّق أنّ الرمز يساوي `N` *أو أكبر منه*. فـ`if errorlevel 1` تعني «إن كان الرمز `1` فما فوق»، أي «إن أخفق الأمر»:

```bat
@echo off
copy important.txt D:\Backup\
if errorlevel 1 (
  echo Copy failed!
) else (
  echo Copy succeeded.
)
```

هنا يحاول السكربت نسخَ ملفٍّ، ثم يفحص فورًا: إن كان `errorlevel` واحدًا فأكثر فالنسخُ فشل (ربّما القرص `D:` غير موجود)، وإلّا فقد نجح. الطريقة الأوضح للتحقّق من النجاح التامّ أن تسأل عن الصفر صراحةً بالمقارنة النصّية: `if "%errorlevel%"=="0"` — وهي الصيغة التي نلقاها الآن.

#tip[
  رتّب فحوص `errorlevel` من الأكبر إلى الأصغر إن كنت تميّز بين عدّة أخطاء. لأنّ `if errorlevel 1` تشمل `2` و`3` كذلك، فلو فحصتَ `1` أوّلًا التقطتَ كلَّ الأخطاء دفعةً واحدة. افحصِ الأخصَّ (الأكبر) قبل الأعمّ (الأصغر).
]

#subsection[هل النصّان متساويان؟ المقارنة بـ‎==‎]

الفحص الثالث يقارن *قيمتين* نصّيتين: هل هذه تساوي تلك؟ تستعمل له علامة المساواة المزدوجة `==` بين القيمتين. أكثر ما يُستعمل هذا في فحص الوسائط التي مرّرها المستخدم (تذكر `%1` من الفصل الماضي):

```bat
@echo off
if "%1"=="start" echo Starting the service...
if "%1"=="stop"  echo Stopping the service...
if "%1"==""      echo Please pass start or stop
```

يقارن السكربت الوسيطَ الأوّل `%1` بالكلمات `start` و`stop`، ويطبع الرسالة الموافقة. والسطر الأخير يلتقط حالة أن يُشغَّل السكربت بلا وسيطٍ أصلًا (فيكون `%1` فارغًا).

#warn[
  أحِطْ طرفَي المقارنة بعلامتَي اقتباس دائمًا: `if "%1"=="start"` لا `if %1==start`. لماذا؟ لأنّ المستخدم قد لا يمرّر وسيطًا، فيصير `%1` فراغًا، فينهار السطر بلا الاقتباس ويعطي خطأً. الاقتباس يضمن وجود *شيءٍ* على الطرفين ولو كان نصًّا فارغًا `""`. اجعلها عادةً راسخة.
]

#tip[
  المقارنة بـ`==` حسّاسةٌ لحالة الأحرف افتراضيًّا، فـ`Start` غير `start`. لتجاهل الحالة أضف الخيار `/i` (اختصار Ignore) بعد `if` مباشرة: `if /i "%1"=="start"` تقبل `START` و`Start` و`start` سواء. وهو ما تريده غالبًا حين تفحص مدخلات المستخدم المتقلّبة.
]

#distro[
  في صدفات لِينُكس وماك (مثل Bash) يؤدّي هذه المهامَّ الثلاثَ أمرٌ اسمه `test` بصيغةٍ مختلفة: `[ -f file ]` لوجود ملفّ، و`[ "$1" = "start" ]` للمقارنة، ويُقرأ رمزُ الخروج من المتغيّر `$?`. الفكرة واحدة — قرارٌ بناءً على فحص — لكنّ اللهجة بعيدة، فلا تخلط بين الصيغتين.
]

#section[التكرار: الأمر for]

حين تريد أن تفعل الشيء نفسه على *أشياء كثيرة* — تعالج كلَّ ملفّات المجلّد، أو تعدّ من واحدٍ إلى مئة — لا تكتب الأمر مئة مرّة، بل تكتبه مرّةً داخل *حلقةٍ* تدور عليها. الأمر `for` هو حلقة الباتش: يأخذ مجموعةً من العناصر، ويكرّر أمرًا على كلٍّ منها، واضعًا العنصرَ الحاليّ في *متغيّر حلقة* تشير إليه بعلامتَي نسبةٍ يليهما حرفٌ واحدٌ تختاره أنت، مثل `%%i` أو `%%f`.

#define("الحلقة (Loop)", [
  بنيةٌ تكرّر أمرًا (أو كتلةً) على كلّ عنصرٍ من مجموعة عناصر، فتنوب عن كتابته يدويًّا لكلّ عنصر. في الباتش أداتُها `for`، والعنصر الجاري في كلّ دورةٍ يُحفظ في متغيّرٍ خاصٍّ اسمه *متغيّر الحلقة*، يُكتب داخل الملفّ بعلامتَي نسبةٍ يليهما حرفٌ واحدٌ من اختيارك، هكذا `%%i`. والحرف حسّاسٌ لحالته، فـ`%%f` غير `%%F`.
])

#warn[
  متغيّر الحلقة يُكتب بعلامتَي نسبةٍ `%%i` *داخل ملفّ الباتش*، وبعلامةٍ واحدةٍ `%i` حين تجرّب `for` مباشرةً في موجّه الأوامر. سببُ التكرار أنّ ملفّ الباتش يقرأ `%%` علامةَ نسبةٍ واحدةً حرفيّة، فتصل إلى `for` كما يريدها. القاعدة العمليّة: في السكربت ضاعِفِ العلامة دائمًا `%%i`، وإلّا واجهتَ خطأً محيّرًا.
]

في أبسط صورةٍ للحلقة، تعطيها قائمةَ عناصر بين قوسين، فتدور على كلٍّ منها. وأشهرُ استعمالٍ أن تكون تلك القائمة نمطَ ملفّاتٍ مثل `*.txt`، فتدور الحلقة على كلّ ملفٍّ يطابقه:

```bat
@echo off
for %%f in (*.txt) do echo Found: %%f
```

يبحث ويندوز عن كلّ ملفٍّ ينتهي بـ`.txt` في المجلّد الحاليّ، ومع كلّ واحدٍ يضع اسمَه في `%%f` وينفّذ ما بعد `do`، فيطبع سطرًا لكلّ ملفّ. بدّل `echo` بأمرٍ آخر، تُنجِز على كلّ الملفّات ما تشاء.

#subsection[العدّاد: for /l]

الخيار `/l` (اختصار Loop) يحوّل `for` إلى عدّادٍ رقميّ، تعطيه ثلاثة أرقامٍ بين قوسين: البداية، والخطوة (مقدار الزيادة كلَّ دورة)، والنهاية:

```bat
@echo off
for /l %%i in (1,1,5) do echo Number %%i
```

اقرأ الأرقام الثلاثة `(1,1,5)`: ابدأ من `1`، وزِدْ `1` كلَّ دورة، وقِف عند `5`. فتُطبع الأعداد من واحدٍ إلى خمسة. ولو جعلتَ الخطوة `2` لعدَّ الأعدادَ الفرديّة `1,3,5`. وللعدِّ تنازليًّا اعكسِ الحدّين واجعلِ الخطوةَ سالبة: `(5,-1,1)` يطبع من خمسةٍ إلى واحد — إذ لا يكفي أن تجعل الخطوة `-1` وحدها، فالبدايةُ يجب أن تكون أكبرَ من النهاية. هذه حلقتُك حين تعرف *كم مرّةً* تريد التكرار.

#subsection[المجلّدات وحدها: for /d]

الخيار `/d` (اختصار Directory) يجعل الحلقة تدور على *المجلّدات* فقط، متجاهلةً الملفّات. مفيدٌ حين تريد أن تعالج كلَّ مجلّدٍ فرعيٍّ في موضعٍ ما:

```bat
@echo off
for /d %%D in (*) do echo Folder: %%D
```

النمط `*` هنا يعني «كلَّ شيء»، لكنّ `/d` يصرفه إلى المجلّدات، فتُطبع أسماء المجلّدات الفرعيّة دون الملفّات. ولو حذفتَ `/d` لانقلبت الآية: تدور الحلقةُ على الملفّات وحدها ولا تلتفت إلى المجلّدات، لأنّ `for` بلا خيارٍ لا تطابق بالنمط إلّا أسماءَ الملفّات. فالخيار `/d` يبدّل هدف المطابقة، لا يضيف إليه.

#subsection[سطور الملفّات ومخرجات الأوامر: for /f]

أقوى صور `for` وأكثرها إثارةً هي `/f` (اختصار File): تقرأ *محتوى* ملفٍّ نصّيٍّ سطرًا سطرًا، أو تلتقط *مخرجات* أمرٍ آخر، فتعالجها. في أبسط استعمالٍ تدور على سطور ملفّ:

```bat
@echo off
for /f "delims=" %%L in (names.txt) do echo Line: %%L
```

تفتح الحلقة `names.txt`، وتضع كلَّ سطرٍ في `%%L` بدوره، فتطبعه مسبوقًا بكلمة. العبارة `"delims="` بين علامتَي اقتباسٍ تقول: «لا تقسم السطر عند الفراغات، بل خذه كاملًا» — فبدونها يأخذ `for /f` أوّلَ كلمةٍ فقط من كلّ سطر.

#note[
  لـ`for /f` خياراتٌ دقيقةٌ تتحكّم في *كيف* تُقرأ السطور: `tokens` تختار أيَّ أعمدةٍ من السطر تلتقط، و`delims` تحدّد الفواصل بين الأعمدة، و`skip` تتخطّى سطورًا من الأعلى. تفصيلُها يطول، وهي أداةُ المتقدّمين لتقطيع الجداول النصّية. يكفيك الآن أن تعرف أنّ `for /f` بابُك إلى قراءة الملفّات والمخرجات؛ وستعمّقه حين تحتاجه.
]

#try-it[
  أنشئ في مجلّدٍ فارغٍ ثلاثةَ ملفّاتٍ نصّيّةٍ بأيّ أسماء (تلميح: `echo. > a.txt` وهكذا). ثم اكتب سكربتًا فيه `for %%f in (*.txt) do echo %%f` وشغّله؛ يجب أن يطبع الأسماء الثلاثة. بعدها جرّب عدّادًا: `for /l %%i in (1,1,3) do echo Pass %%i`، وتأمّل كيف عدَّ من واحدٍ إلى ثلاثة. غيّر الخطوة الوسطى إلى `2` وراقب ماذا يتغيّر.
]

#distro[
  في Bash على لِينُكس وماك تؤدّي الحلقةُ `for` المهمّة ذاتها بصيغةٍ ألطف: `for f in *.txt; do echo $f; done`، والعدُّ الرقميّ بـ`for i in {1..5}`. الفكرة والاسم متطابقان تقريبًا، لكنّ لهجة الباتش تتفرّد بخيارات `/l` و`/d` و`/f` وبمضاعفة علامة المتغيّر `%%`.
]

#section[القفز: goto والعلامات ‎:label‎]

حتى الآن يسير سكربتك للأمام فقط. الأمر `goto` يكسر هذا: يقفز التنفيذُ به إلى موضعٍ آخر في السكربت تسمّيه أنت بعلامةٍ (Label). والعلامة سطرٌ يبدأ بنقطتين رأسيّتين ثم اسمٍ، هكذا `:label`، وهي محضُ لافتةٍ لا تُنفَّذ، بل تعلّم موضعًا يقفز إليه `goto`.

#define("العلامة (Label)", [
  سطرٌ في السكربت يبدأ بنقطتين `:` يليهما اسمٌ تختاره، مثل `:menu`. لا يفعل شيئًا بذاته؛ إنّما يضع *لافتةً* على موضعٍ في الملفّ ليقفز إليها `goto`. بها تبني قوائمَ متكرّرة، وتتخطّى مقاطع، وتنهي السكربت مبكّرًا.
])

أبسط ما تصنعه بها *حلقةٌ لا نهائيّةٌ محكومة*: علامةٌ في الأعلى، وقفزةٌ إليها في الأسفل، فيدور السكربت حتى يقرّر الخروج:

```bat
@echo off
:menu
echo 1) Say hello
echo 2) Exit
set /p choice=Choose:
if "%choice%"=="1" echo Hello there!
if "%choice%"=="2" goto end
goto menu
:end
echo Goodbye
```

تتبّع المسار: عند `:menu` يعرض السكربت خيارين، ويسأل المستخدم. إن اختار `1` طبع التحيّة، ثم بلغ `goto menu` فقفز إلى الأعلى معيدًا القائمة. وإن اختار `2` قفز بـ`goto end` إلى العلامة `:end` فطبع الوداع وانتهى. هكذا صنعتَ *قائمةً تفاعليّةً* تدور حتى يطلب المستخدم الخروج — وهذا نمطٌ تلقاه في سكربتاتٍ لا تُحصى.

#tip[
  هناك علامةٌ جاهزةٌ لا تحتاج أن تعرّفها: `goto :eof` تقفز إلى *نهاية الملفّ* (End Of File) فتنهي السكربت فورًا من أيّ موضع. استعملها للخروج المبكّر بدل بناء علامة `:end` بنفسك — لكن انتبه إلى النقطتين قبل `eof`: `goto :eof` بالنقطتين، وهي حالةٌ خاصّة.
]

#warn[
  حذارِ من حلقةٍ لا مخرج لها: لو نسيتَ شرطَ الخروج، ظلّ `goto` يقفز إلى الأعلى بلا توقّف، وعلق سكربتك في دورانٍ أبديّ لا يُوقفه إلّا #kbd("Ctrl") + #kbd("C"). تأكّد دائمًا أنّ في الحلقة طريقًا يقود إلى `goto end` أو `goto :eof` تحت شرطٍ يتحقّق يومًا.
]

#section[الاستدعاء: الأمر call]

يكبر السكربت فتودّ تقسيمه: مقاطعُ صغيرةٌ لكلّ مهمّة، تستدعي كلًّا حين تحتاجه ثم *تعود* لتكمل. أو تودّ تشغيل سكربتٍ آخر من داخل سكربتك. الأمر `call` لهذا: ينفّذ سكربتًا أو مقطعًا، وحين يفرغ، *يرجع* التنفيذُ إلى السطر التالي لموضع الاستدعاء.

#define("الاستدعاء (call)", [
  الأمر الذي يشغّل سكربت باتش آخر — أو مقطعًا داخليًّا معلّمًا بعلامة — ثم يعيد التنفيذ إلى ما بعد سطر `call`. الفرقُ الجوهريّ عن `goto` أنّ `call` *يعود*، بينما `goto` يقفز بلا رجعة. به تبني «دوالَّ» صغيرة — والدالّة مقطعٌ مسمًّى تكتبه مرّةً وتناديه كلّما احتجتَه — فلا تكرّر الشيء نفسه مرارًا.
])

الاستعمال الأوّل: أن يشغّل سكربتٌ سكربتًا آخر. لنقل عندك `setup.bat` يهيّئ بيئةً، وتريد استدعاءه من سكربتك الرئيس:

```bat
@echo off
echo Preparing environment...
call setup.bat
echo Back in the main script, continuing...
```

حين يبلغ التنفيذُ `call setup.bat`، يذهب فينفّذ `setup.bat` كاملًا، وحين ينتهي هذا، يعود إلى سطر `echo Back...` فيكمل. ولو استعملتَ اسم السكربت بلا `call` — أي `setup.bat` وحدها — لانتقل التنفيذ إليه ولم *يعُد* أبدًا إلى سكربتك الأصليّ. لذا `call` هي مفتاح العودة.

#warn[
  هذا فخٌّ كلاسيكيّ: مناداةُ سكربت باتش من داخل آخر *بلا* `call` تسلّم التحكّم إليه ولا تستردّه، فيُهمَل كلُّ ما بعد سطر النداء في سكربتك الأصليّ ولا يعمل. القاعدة الصارمة: لتشغيل سكربتٍ من داخل سكربتٍ وتُكمِل بعده، ابدأ السطر بـ`call` دائمًا.
]

والاستعمال الأرشق: أن تستدعي *مقطعًا داخليًّا* في السكربت نفسِه، معلّمًا بعلامةٍ، كأنّه دالّةٌ صغيرة. تكتب `call :name` فيقفز إلى العلامة `:name`، ينفّذ ما تحتها حتى يلقى `goto :eof`، ثم يعود:

```bat
@echo off
call :greet Ahmad
call :greet Sara
echo All greetings done.
goto :eof

:greet
echo Hello, %1
goto :eof
```

سطرا `call` الأوّلان يستدعيان المقطعَ `:greet` مرّتين بوسيطين مختلفين — ولاحظ أنّ المقطع يقرأ وسيطَه بـ`%1` كأنّه سكربتٌ مستقلّ. بعد الاستدعاءين يطبع «تمّت التحيّات». أمّا `goto :eof` الأوّل (قبل العلامة) فحاجزٌ ضروريّ يمنع التنفيذَ من الانزلاق إلى `:greet` مرّةً ثالثةً بلا استدعاء. بهذا كتبتَ دالّةً واحدةً واستعملتَها مرارًا — وهذه أولى خطواتك نحو سكربتاتٍ منظّمةٍ لا تكرّر نفسها.

#section[سكربتٌ يجمع أدوات الفصل]

لنؤلّف من كلّ ما مضى أداةً صغيرةً واقعيّة: سكربتُ نُسخٍ احتياطيّةٍ يفحص، ويكرّر، ويقرّر، ويستدعي:

```bat
@echo off
:: نسخة احتياطية لملفّات .txt إلى مجلّد Backup
if not exist Backup (
  echo Creating Backup folder...
  md Backup
)
set /a count=0
for %%f in (*.txt) do call :backup "%%f"
echo.
echo Done. Copied %count% file(s).
goto :eof

:backup
copy %1 Backup\ >nul
if errorlevel 1 (
  echo FAILED: %1
) else (
  set /a count+=1
  echo OK: %1
)
goto :eof
```

اقرأه بعين ما تعلّمت: يبدأ بـ`if not exist` فيُنشئ مجلّد `Backup` إن غاب. ثم يصفّر عدّادًا اسمه `count`. ثم تدور حلقة `for` على كلّ ملفّ `.txt`، وتُسلّم كلًّا للمقطع `:backup` بـ`call`. داخل المقطع يُنسخ الملفّ — والزيادة `>nul` تصبّ رسالة `copy` المعتادة في `nul`، وهو جهازٌ وهميٌّ في ويندوز يبتلع كلَّ ما يُوجَّه إليه، فتختفي الرسالة عن الشاشة — ثم يُفحص `errorlevel`: إن فشل النسخ طُبع `FAILED`، وإلّا زِيد العدّاد واحدًا بـ`set /a count+=1` وطُبع `OK`. أخيرًا يطبع الإجماليّ. أربعُ أدوات الفصل — `if` و`for` و`call` و`goto :eof` — تعمل معًا في عشرين سطرًا.

#danger[
  حين يقرّر سكربتك ويكرّر، يصير أقوى — وأخطر. حلقةٌ مثل `for /d %%D in (*) do rmdir /s /q "%%D"` تحذف *كلَّ* مجلّدٍ فرعيٍّ بمحتوياته بلا سؤالٍ وبلا سلّة محذوفات، في طرفة عين. وسطرٌ فيه `del` أو `format` داخل حلقةٍ يضاعف أثره المدمّر بعدد الدورات. قبل أن تشغّل حلقةً فيها حذفٌ أو كتابةٌ فوق ملفّات، بدّلِ الأمرَ المدمّرَ مؤقّتًا بـ`echo` يطبع ما *كان* سيُحذف، فتراجع القائمة بأمان، ثم أعِد الأمر الحقيقيّ حين تطمئنّ. الحلقةُ لا تسامح خطأً واحدًا؛ تكرّره على كلّ عنصر.
]

#try-it[
  انسخ سكربت النُّسخ الاحتياطيّة أعلاه إلى ملفّ `backup.bat` في مجلّدٍ فيه بضعةُ ملفّاتِ `.txt`. لكن *قبل* أن تثق به، افتحه وبدّل سطر `copy %1 Backup\ >nul` مؤقّتًا بـ`echo Would copy: %1`، وشغّله لترى أيَّ الملفّات كان سيُنسخ دون أن يلمس شيئًا. حين تطمئنّ، أعِد سطر `copy`، وشغّله فعلًا، وتحقّق بـ`dir Backup` أنّ الملفّات نُسخت وأنّ العدّاد صحيح.
]

#section[خلاصة الفصل]

منحتَ سكربتاتك في هذا الفصل عقلًا يقرّر ويكرّر ويقفز. تعلّمتَ `if` بصيغه الثلاث: `if exist` لفحص وجود ملفّ (مع `not` و`else` والأقواس لكتلةٍ متعدّدة)، و`if errorlevel N` لفحص نجاح الأمر السابق (تذكّر أنّها «`N` فأكثر»)، والمقارنة `==` بين نصّين (مع الاقتباس دائمًا، و`/i` لتجاهل حالة الأحرف). وتعلّمتَ `for` حلقةً على قائمة ملفّاتٍ، وبخياراتها: `/l` عدّادًا رقميًّا، و`/d` على المجلّدات، و`/f` على سطور الملفّات ومخرجات الأوامر — واضعةً العنصرَ الجاري في `%%i` (بعلامتين في السكربت). وتعلّمتَ `goto` يقفز إلى علامةٍ `:label` تسمّيها، فتبني قوائمَ متكرّرةً وتخرج بـ`goto :eof`. وأخيرًا `call` يستدعي سكربتًا آخر أو مقطعًا داخليًّا *ثم يعود* — بخلاف `goto` الذي يقفز بلا رجعة. بهذه الأربع صار الباتش لغةَ برمجةٍ حقيقيّةً بين يديك. في الفصل التالي ننزل من كتابة السكربتات إلى *أوامر النظام* في CMD: كيف نفحص الشبكة، ونرى العمليّات الجارية، ونصلح النظام — بأوامرَ يستعملها محترفو ويندوز كلَّ يوم.

#challenge[
  اكتب سكربتًا اسمه `organize.bat` يرتّب مجلّدًا. يبدأ بـ`@echo off` وتعليقٍ يشرح غرضه. أوّلًا: إن لم يوجد مجلّدٌ اسمه `Texts` فأنشئه بـ`if not exist` و`md`. ثانيًا: بحلقة `for` على `*.txt`، انقل كلَّ ملفٍّ نصّيٍّ إلى `Texts` (تلميح: `move`)، لكن اجعل النقل داخل مقطعٍ تستدعيه بـ`call :moveone "%%f"` ليعود بعد كلّ ملفّ. ثالثًا: بعد الحلقة، إن نجح كلُّ شيءٍ اطبع `Organized successfully`، وإلّا اطبع تحذيرًا — وافحص النجاح بالمقارنة `if "%errorlevel%"=="0"`، ولا تكتب `if errorlevel 0` فهي صادقةٌ أبدًا لأنّ معناها «صفرٌ فما فوق». جرّبه أوّلًا بعد إبدال `move` بـ`echo` لتعاين أثره بأمان، ثم فعّله. أخيرًا: لماذا كان `call` هنا أنسبَ من كتابة أمر `move` مباشرةً في الحلقة — وماذا يفيدك فصلُ المهمّة في مقطعٍ مستقلّ؟
]
