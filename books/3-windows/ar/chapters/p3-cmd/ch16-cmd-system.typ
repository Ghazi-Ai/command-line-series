#chapter[أوامر النظام في CMD]

#objectives((
  [تفحص شبكتك بأمر `ipconfig`، وتحرّر عنوانك وتجدّده بـ`/release` و`/renew`.],
  [ترى البرامج العاملة بـ`tasklist`، وتُنهي المتمرّد منها بـ`taskkill` بحذر.],
  [تقرأ بطاقة هويّة جهازك كاملةً بأمر `systeminfo`.],
  [تُصلح ملفّات النظام التالفة بـ`sfc /scannow`، وتفحص قرصك بـ`chkdsk`.],
  [تُطفئ الجهاز وتعيد تشغيله بأمانٍ عبر `shutdown` بخياراته.],
))

حتى الآن كنتَ *ساكنًا* في جهازك: تتنقّل بين مجلّداته، وتنسخ ملفّاته، وتكتب سكربتاته. في هذا الفصل ترتدي قبّعةً جديدة، وتصير *مهندس المبنى*: الرجل الذي لا يسكن الغرف فحسب، بل يفحص الأسلاك، ويقرأ عدّادات الكهرباء، ويعرف مَن يعمل في أيّ طابق، ويوقف آلةً تعطّلت، ويرمّم شرخًا في الجدار، ثم يُطفئ الأنوار في آخر اليوم. أوامر هذا الفصل هي لوحةُ قيادة النظام وصندوقُ عدّته معًا: بعضها *يفحص* ويُطلعك على الحال، وبعضها *يتصرّف* فيغيّره. ولأنّ بعضها ذو أثرٍ لا رجعة فيه، سنتعلّم متى نمسك اليد قبل أن نتعلّم كيف نمدّها.

#section[الشبكة تحت عينك: ipconfig]

أوّل ما يسأل عنه مهندس المبنى: هل الأسلاك موصولة؟ نظير ذلك في الحاسوب أمرُ `ipconfig` (اختصار IP Configuration، أي «إعداد بروتوكول الإنترنت»). يعرض لك كيف يرى جهازُك الشبكةَ: ما عنوانه فيها، ومن أين يخرج إلى الإنترنت. اكتبه وحده أوّلًا:

#session("ipconfig", output: "Windows IP Configuration\n\nEthernet adapter Ethernet:\n\n   ...\n   IPv4 Address. . . . . . . . . : 192.168.1.42\n   Subnet Mask . . . . . . . . . : 255.255.255.0\n   Default Gateway . . . . . . . : 192.168.1.1")

يعرض لكلّ *مُحَوِّل شبكة* (بطاقة إيثرنت أو واي فاي) بضعةَ أسطر — طوينا أوائلها في المثال بثلاث نقاطٍ اختصارًا — أهمُّها ثلاثة: عنوان `IPv4`، وقناع الشبكة الفرعيّة (الذي يرسم حدود شبكتك المحليّة فيميّز جيرانك القريبين عن سائر الشبكات)، والبوّابة الافتراضيّة (طريقك إلى بقيّة العالم).

#define("عنوان الـ IP", [
  رقمٌ يميّز جهازك على الشبكة، كرقم منزلك في الحيّ. الصيغة الشائعة اليوم `IPv4` تتكوّن من أربعة أعدادٍ مفصولةٍ بنقاطٍ مثل `192.168.1.42`. به تعرف الأجهزةُ الأخرى أين ترسل إليك البيانات.
])

#subsection[التفاصيل الكاملة: `/all`]

الصيغة المختصرة تكفي لنظرةٍ سريعة، لكن حين تريد كلَّ شيء — اسم الجهاز، والعنوان الفيزيائيّ للبطاقة، وخوادم الأسماء (التي تترجم أسماء المواقع مثل `google.com` إلى عناوين رقميّة)، ومصدر العنوان — أضِف الخيار `/all`:

#session("ipconfig /all", output: "Windows IP Configuration\n\n   Host Name . . . . . . . . . . : ABU-HAITHAM-PC\n   ...\n\nEthernet adapter Ethernet:\n\n   Physical Address. . . . . . . : A4-B1-C2-D3-E4-F5\n   DHCP Enabled. . . . . . . . . : Yes\n   ...\n   DNS Servers . . . . . . . . . : 8.8.8.8")

يظهر هنا سطرٌ مهمّ هو `DHCP Enabled` وقيمته `Yes`. ومعناه أنّ عنوانك ليس ثابتًا كتبتَه بيدك، بل *مُستأجَرٌ* تلقائيًّا من جهاز التوجيه (الراوتر).

#define("بروتوكول DHCP", [
  نظامٌ يوزّع فيه الراوترُ عناوينَ الـ IP على الأجهزة تلقائيًّا حين تتّصل، بدل أن تضبط كلَّ جهازٍ يدويًّا. كأنّ فندقًا يمنح كلَّ نزيلٍ رقمَ غرفةٍ عند وصوله بدل أن يحجزها مسبقًا. الاسم اختصار Dynamic Host Configuration Protocol.
])

#subsection[تحرير العنوان وتجديده: `/release` و`/renew`]

ولأنّ العنوان مُستأجَر، تملك أن *تُعيده* ثم *تطلب واحدًا جديدًا* — وهذه أوّل حيلةٍ يجرّبها كلُّ فنّيِّ دعمٍ حين تتعطّل الشبكة. الخيار `/release` يُسلِّم عنوانك الحاليَّ للراوتر فتفقد الاتّصال مؤقّتًا:

```bat
ipconfig /release
```

ثم `/renew` يطلب عنوانًا جديدًا من الراوتر، فيعود اتّصالك — وكثيرًا ما يُصلح هذا عطلًا عابرًا في الشبكة:

```bat
ipconfig /renew
```

#note[
  في العادة تشغّلهما متتابعَين: `/release` لتُفلت العنوان القديم، ثم `/renew` لتأخذ جديدًا. وهناك خيارٌ ثالثٌ شائع `ipconfig /flushdns` يمسح ذاكرة أسماء المواقع المخزّنة، ويفيد حين يفتح موقعٌ بعنوانٍ قديمٍ خطأً.
]

#warn[
  الخياران `/release` و`/renew` يغيّران إعداد الشبكة لا يقرآنه فحسب، فيحتاجان موجّه أوامرٍ مفتوحًا بصلاحيّة *المسؤول*: انقر على أيقونته بالزرّ الأيمن واختر «تشغيل كمسؤول» (Run as administrator). وإلّا ردَّ عليك الأمر برسالة `The requested operation requires elevation`. ثمّ إنّ `/release` يقطع اتّصالك بالشبكة فورًا حتى تشغّل `/renew`؛ لا مشكلة في ذلك على جهازٍ أمامك، لكن احذر تشغيله على حاسوبٍ تتحكّم فيه *عن بُعد* عبر الشبكة، فقد تقطع الغصن الذي تجلس عليه ولا تستطيع العودة!
]

#distro[
  على لِينُكس يقابل `ipconfig` أمرُ `ip addr` الحديث (وقديمًا `ifconfig`)، وعلى ماك `ifconfig`. أمّا تجديد عنوان DHCP فيتمّ على لِينُكس بأدواتٍ مثل `dhclient`، وعلى ماك بإعادة تفعيل الواجهة. الفكرة واحدةٌ واللهجة مختلفة.
]

#try-it[
  افتح موجّه الأوامر ونفّذ `ipconfig` وحده، وابحث عن سطر `Default Gateway`: هذا عنوان راوترك. ثم نفّذ `ipconfig /all` وابحث عن `Physical Address` — هذا العنوان الفيزيائيّ الفريد لبطاقتك. لا تشغّل `/release` الآن إلّا إن كنت مستعدًّا لقطع الشبكة ثم إعادتها بـ`/renew`.
]

#section[من يعمل الآن؟ tasklist]

في أيّ لحظةٍ يشتغل داخل جهازك عشراتُ البرامج — بعضها فتحتَه بنفسك، وكثيرٌ منها يعمل في الخفاء. أمرُ `tasklist` هو كشفُ الحضور: يعرض قائمةً بكلّ *عمليّةٍ* عاملةٍ الآن.

#session("tasklist", output: "Image Name                     PID Session Name\n========================= ======== ================\nchrome.exe                    4821 Console\nnotepad.exe                   7710 Console\nexplorer.exe                  3204 Console")

كلُّ سطرٍ برنامجٌ عامل، وأهمُّ عمودَين فيه: `Image Name` وهو اسم البرنامج، و`PID` وهو رقمُه المميّز. وقد اقتصرنا هنا على الأعمدة الثلاثة الأولى لضيق الصفحة؛ وعلى شاشتك يتبعها عمودان آخران: `Session#` رقمُ جلسة المستخدم، و`Mem Usage` مقدارُ الذاكرة الذي يشغله البرنامج بالكيلوبايت.

#define("العمليّة (Process) والـ PID", [
  *العمليّة* نسخةٌ من برنامجٍ قيدَ التشغيل في الذاكرة الآن. حين تفتح المفكّرة مرّتين، تعمل عمليّتان من `notepad.exe`. وكلُّ عمليّةٍ يمنحها النظام رقمًا فريدًا اسمه *معرّف العمليّة* أو `PID` (اختصار Process ID)، كرقمٍ تسلسليٍّ يميّز كلَّ عاملٍ عن أخيه ولو حملا الاسم نفسه.
])

القائمة طويلة، فقد تصفّيها. الخيار `/fi` (اختصار Filter، أي «مُرشِّح») يعرض ما يطابق شرطًا فقط. لعرض نسخ المتصفّح وحدها مثلًا:

```bat
tasklist /fi "IMAGENAME eq chrome.exe"
```

#tip[
  *الخدمات* (Services) برامجُ ويندوز الصامتة التي تعمل في الخلفية بلا نافذةٍ ولا أيقونة: الطباعة، والتحديث، والشبكة، وأشباهها. ولرؤية أيّ خدماتٍ يشغّلها كلُّ برنامجٍ خفيّ، أضِف الخيار `/svc`. وهو نافعٌ حين تجد عمليّةً غامضةً باسم `svchost.exe` وتريد أن تعرف ما الذي تخدمه فعلًا في النظام.
]

#try-it[
  افتح المفكّرة (`notepad`)، ثم نفّذ `tasklist` وابحث في القائمة عن `notepad.exe`، وسجّل رقم `PID` المقابل له. سنستعمل هذا الرقم في القسم التالي لنُنهي المفكّرة من سطر الأوامر. أبقِ نافذة المفكّرة مفتوحة.
]

#section[إنهاء عمليّةٍ متمرّدة: taskkill]

يحدث أن يتجمّد برنامجٌ فلا يستجيب لزرّ الإغلاق. هنا يأتي `taskkill` (أي «اقتل المهمّة»): يُنهي عمليّةً من سطر الأوامر مباشرة. تخاطبه بإحدى طريقتين — بالاسم أو بالرقم. بالاسم عبر الخيار `/im` (اختصار Image Name):

```bat
taskkill /im notepad.exe
```

فيُنهي كلَّ نسخةٍ مفتوحةٍ من المفكّرة. وبالرقم عبر `/pid` مستعملًا الـ PID الذي التقطتَه:

```bat
taskkill /pid 7710
```

بهذه الصيغة اللطيفة، يطلب `taskkill` من البرنامج أن يُغلق نفسه *بأدب*، فيحفظ ما يلزم ثم يختفي. وقد يسألك البرنامج أوّلًا — كما تفعل المفكّرة إن كان فيها نصٌّ لم يُحفَظ — فيبقى مفتوحًا حتى تجيبه.

#subsection[الإنهاء القسريّ: `/f`]

لكن ماذا لو كان البرنامج متجمّدًا لا يستجيب حتى لطلب الإغلاق المؤدّب؟ عندها تضيف الخيار `/f` (اختصار Force، أي «إجبار»)، فيُقتل البرنامج قسرًا في الحال بلا مهلة:

```bat
taskkill /f /im notepad.exe
```

#danger[
  الخيار `/f` يقتل البرنامج *فورًا* دون أن يمهله لحظةً ليحفظ عمله. كلُّ ملفٍّ مفتوحٍ لم يُحفَظ يضيع بلا رجعة، وكلُّ عمليّةٍ ناقصةٍ تُقطَع في منتصفها. ولا تُنهِ أبدًا عمليّةً لا تعرف ما هي — فقد تكون جزءًا من النظام نفسه، وقتلُها قد يُجمّد ويندوز أو يفسد بياناتٍ. استعمل `/f` آخرَ الحلول، وعلى برنامجٍ تعرفه وتيقّنتَ أنّه متجمّد، لا عادةً في كلّ إنهاء.
]

#warn[
  الخيار `/t` (اختصار Tree) يُنهي العمليّةَ *وكلَّ العمليّات المتفرّعة عنها*. مفيدٌ لإغلاق برنامجٍ فتح نوافذ فرعيّة، لكن انتبه إلى اتّساع أثره: قد يُغلق أكثر ممّا نويت إن كانت العمليّة أمًّا لشجرةٍ كبيرة.
]

#distro[
  على لِينُكس وماك يقابل `taskkill` أمرُ `kill` (بالـ PID) و`killall` (بالاسم). والإنهاءُ القسريّ `/f` يوازيه هناك الإشارةُ `kill -9`. المفهوم متطابق: طلبٌ مؤدّبٌ أوّلًا، وقتلٌ قسريٌّ عند اللزوم.
]

#try-it[
  أنهِ المفكّرة التي فتحتَها بالطريقة المؤدّبة `taskkill /im notepad.exe` ولاحظ اختفاءها. ثمّ افتحها ثانيةً، وأنهِها هذه المرّة بالـ PID الذي سجّلتَه سابقًا (بعد التأكّد أنّه ما زال صحيحًا بـ`tasklist`). جرّب الطريقتين لتألف كلتيهما، وتجنّب `/f` ما دام البرنامج يُغلق بالطريقة اللطيفة.
]

#section[بطاقة هويّة النظام: systeminfo]

حين يسأل فنّيُّ الدعم «ما مواصفات جهازك؟»، لا داعي أن تنقر عشر نوافذ. أمرٌ واحدٌ اسمه `systeminfo` يطبع بطاقة هويّةٍ كاملةً للجهاز: اسم نظام التشغيل ونسخته، والشركة المصنّعة، وتاريخ التثبيت، ووقت آخر إقلاع، وحجم الذاكرة، وبطاقات الشبكة، والتحديثات المثبّتة.

#session("systeminfo", output: "Host Name:                 ABU-HAITHAM-PC\nOS Name:                   Microsoft Windows 11 Pro\nOS Version:                10.0.22631 N/A Build 22631\n...\nSystem Boot Time:          7/19/2026, 8:14:03 AM\nSystem Manufacturer:       Dell Inc.\n...\nTotal Physical Memory:     16,270 MB\n...")

يأخذ الأمر ثوانيَ ليجمع معلوماته، ثم يسكب عشرات الأسطر. المخرجات تختلف بين جهازٍ وآخر وبين نسخةٍ وأخرى من ويندوز، فاقرأها بوصفها *نموذجًا* لا نصًّا حرفيًّا.

#tip[
  المخرجات طويلة تتجاوز الشاشة. مرّرها صفحةً صفحةً بإسنادها إلى `more` هكذا `systeminfo | more`، أو احفظها في ملفٍّ لترسلها للدعم: `systeminfo > info.txt`. وستتعلّم هذا التوجيه بتوسّعٍ في فصلٍ لاحق.
]

#distro[
  على لِينُكس تتوزّع هذه المعلومات على أوامر: `uname -a` للنواة، و`hostnamectl` لنظام التشغيل، وملفّ `/proc/cpuinfo` للمعالج. وعلى ماك يجمعها أمرُ `system_profiler`، وباختصارٍ `sw_vers` لنسخة النظام. ويندوز يجمعها كلَّها في أمرٍ واحد.
]

#try-it[
  نفّذ `systeminfo`، وابحث عن ثلاثة أسطر: `OS Name` (اسم نظامك)، و`Total Physical Memory` (حجم ذاكرتك)، و`System Boot Time` (متى أُقلع الجهاز آخر مرّة). كم مضى على آخر إقلاعٍ لجهازك؟
]

#section[طبيب ملفّات النظام: sfc /scannow]

مع طول الاستعمال قد يتلف ملفٌّ من ملفّات ويندوز الأساسيّة — بسبب انقطاع كهرباء، أو برنامجٍ سيّئ، أو قطاعٍ معطوبٍ في القرص — فيبدأ النظام يتصرّف بغرابة. لهذا صُنع `sfc` (اختصار System File Checker، أي «مدقّق ملفّات النظام»). بالخيار `/scannow` يفحص كلَّ ملفّات ويندوز المحميّة، ويستبدل التالفَ منها بنسخةٍ سليمة:

```bat
sfc /scannow
```

#define("ملفّات النظام المحميّة", [
  الملفّات الأساسيّة التي يتكوّن منها ويندوز نفسه، ويحفظ النظامُ نسخةً سليمةً منها ليقارن بها. إن اكتُشف أنّ إحداها تغيّرت أو تلفت، استعادها من النسخة السليمة. هي كالأعمدة الحاملة للمبنى: لا يلمسها الساكن، ويراقبها المهندس.
])

الفحص يأخذ عدّة دقائق، ويعرض شريطَ تقدّمٍ بالنسبة المئويّة، ثم يخبرك بالنتيجة: إمّا أنّه لم يجد خللًا، وإمّا أنّه وجد ملفّاتٍ تالفةً وأصلحها، وإمّا أنّه وجدها ولم يقدر على إصلاح بعضها.

#warn[
  الأمر يحتاج *صلاحيّات المسؤول*. افتح موجّه الأوامر بالنقر عليه بالزرّ الأيمن ثم «تشغيل كمسؤول» (Run as administrator)، وإلّا رفض العملَ برسالةٍ تقول إنّك تحتاج صلاحيّةً أعلى. وهذا يصدق على `sfc` و`chkdsk` معًا — بل `chkdsk` يطلبها حتى في فحص القراءة وحده بلا خيارات.
]

#try-it[
  افتح موجّه الأوامر *كمسؤول*، ونفّذ `sfc /scannow`، ودعه يكمل الفحص (قد يطول). اقرأ رسالة الختام: هل كانت `did not find any integrity violations` (سليم)، أم أصلح شيئًا؟ هذا فحصٌ آمنٌ تمامًا يحسُن إجراؤه حين يتصرّف الجهاز بغرابة.
]

#section[فحص القرص: chkdsk]

إن كان `sfc` طبيبًا لملفّات النظام، فإنّ `chkdsk` (اختصار Check Disk، أي «افحص القرص») طبيبٌ للقرص نفسه: يفحص بنية *نظام الملفّات* — أي الفهرس الذي يعرف به ويندوز أين يقع كلُّ ملفٍّ على القرص — بحثًا عن أخطاء، ويقدر إن طلبتَ منه أن يفتّش عن *القطاعات* التالفة في العتاد (والقطاع أصغرُ وحدةٍ يُقسَّم إليها سطح القرص). نفّذه وحده على قرصٍ لتفحصه فحصًا للقراءة فقط، بلا تعديل:

```bat
chkdsk C:
```

يجوب القرص ويطبع تقريرًا عن حالته وعدد أخطائه إن وُجدت — دون أن يُصلح شيئًا. للفحص والإصلاح معًا تضيف خيارَين: `/f` (اختصار Fix) لإصلاح الأخطاء المنطقيّة، و`/r` (اختصار Recover) للبحث عن القطاعات التالفة واستعادة ما يمكن قراءته منها:

```bat
chkdsk C: /f /r
```

#danger[
  إصلاح القرص بـ`/f` أو `/r` يتطلّب *قفل القرص* حصريًّا أثناء العمل. وإذا كان القرص المطلوب هو قرص النظام (`C:` غالبًا)، فلا يمكن قفله وويندوز يعمل، فيعرض عليك جدولةَ الفحص عند الإقلاع القادم برسالةٍ تسألك `(Y/N)`. اكتب `Y` واعلم أنّ الفحص عند الإقلاع التالي *قد يستغرق وقتًا طويلًا* والجهاز خلاله غير مستعمَل — فلا تجدوله قبل اجتماعٍ أو سفر. ولا تُطفئ الجهاز أثناء فحصٍ جارٍ للقرص أبدًا، فقطعُه في المنتصف قد يفسد بياناتك.
]

#distro[
  على لِينُكس وماك يقابل `chkdsk` أمرُ `fsck` (اختصار File System Check). ومثلَ `chkdsk` تمامًا، لا يُفحص القرصُ الجذر وهو مُركَّبٌ يعمل، بل يُجدوَل الفحصُ عند الإقلاع. القاعدة كونيّة: لا يُصلَح القرصُ وهو تحت الاستعمال.
]

#try-it[
  افتح موجّه الأوامر *كمسؤول*، ونفّذ الفحص الآمن للقراءة فقط `chkdsk C:` (بلا خيارات)، واقرأ التقرير في آخره: كم مساحةً كليّة، وهل ذكر أخطاءً؟ لا تُضِف `/f` الآن إلّا إن كنتَ مستعدًّا لجدولة فحصٍ عند الإقلاع القادم وتخصيص وقتٍ له.
]

#section[إطفاء وإعادة تشغيل: shutdown]

آخر ما يفعله مهندس المبنى في يومه أن يُطفئ الأنوار. أمرُ `shutdown` يتحكّم في إطفاء الجهاز وإعادة تشغيله من سطر الأوامر — وهو أدقُّ من زرّ القائمة لأنّك تتحكّم في *التوقيت*. ولا يفعل شيئًا وحده؛ فإن كتبتَه مجرّدًا عرض عليك قائمة خياراته لتختار منها. وأشهر خيارَيه `/s` للإطفاء (Shutdown):

```bat
shutdown /s
```

و`/r` لإعادة التشغيل (Restart) — وهما بديلان لا يُجمعان:

```bat
shutdown /r
```

ويرافقهما عادةً الخيار `/t` (اختصار Time) يتبعه عددُ *الثواني* قبل التنفيذ. وإن أغفلتَه أمهلك ويندوز ثلاثين ثانيةً افتراضًا. فلإعادة تشغيلٍ فوريّةٍ بلا مهلة:

```bat
shutdown /r /t 0
```

ولإطفاءٍ بعد دقيقةٍ كاملة (60 ثانية) يمنحك وقتًا لحفظ عملك:

```bat
shutdown /s /t 60
```

#subsection[التراجع: `/a`]

جدولتَ إطفاءً بعد دقيقةٍ ثم عدلتَ؟ ما دامت المهلة لم تنتهِ، يمكنك إلغاؤها بالخيار `/a` (اختصار Abort، أي «إلغاء»):

```bat
shutdown /a
```

#danger[
  أمر `shutdown /s` أو `/r` يُطفئ الجهاز أو يعيد تشغيله *فعلًا*، وكلُّ عملٍ غير محفوظٍ في أيّ برنامجٍ مفتوحٍ يضيع. الخطر الأكبر في المهلة الصفريّة `/t 0`: تُنفَّذ فورًا بلا فرصةٍ للتراجع بـ`/a`. اعتَدْ أن تمنح مهلةً معقولةً (`/t 60` مثلًا) لتحفظ وتتراجع إن لزم. ولا تجدول إطفاءً على جهازٍ يشاركك فيه غيرُك دون إعلامه، فقد تُفقده عمله.
]

#distro[
  الأمر `shutdown` موجودٌ على لِينُكس وماك أيضًا لكن بلهجةٍ مختلفة: `shutdown -h now` للإطفاء الفوريّ، و`shutdown -r now` لإعادة التشغيل، والمهلة تُكتب دقائقَ لا ثوانيَ (`shutdown -h +1` بعد دقيقة). الاسم واحدٌ والخيارات تختلف — فتحقّق دائمًا من لهجة نظامك.
]

#note[
  كلُّ ما سبق يعمل في *موجّه الأوامر* وفي *PowerShell* سواءً، فالأوامر أدواتٌ للنظام لا للصدفة وحدها. غير أنّ لِـPowerShell محثًّا مختلفًا شكلًا:
]

#session("shutdown /s /t 60", prompt: "PS>", output: none)

#try-it[
  جرّب دورةً آمنة: نفّذ `shutdown /s /t 120` لجدولة إطفاءٍ بعد دقيقتين، ولاحظ التنبيه الذي يظهره ويندوز. ثمّ — قبل انقضاء المهلة — ألغِ الجدولة بـ`shutdown /a`، وتأكّد أنّها أُلغيت فعلًا: إمّا برسالة إلغاءٍ يعرضها ويندوز، وإمّا بأن تمضي الدقيقتان ولا يُطفأ جهازك. هكذا تتمرّن على الجدولة والتراجع دون أن يُطفأ جهازك فعلًا.
]

#section[خلاصة الفصل]

انتقلتَ في هذا الفصل من ساكنٍ إلى مهندسٍ يفحص النظام ويتصرّف فيه. رأيتَ شبكتك بـ`ipconfig`، وتفاصيلها الكاملة بـ`/all`، وحرّرتَ عنوانك وجدّدتَه بـ`/release` و`/renew`. واستعرضتَ العمليّات العاملة بـ`tasklist` وعرفتَ الـ`PID`، ثم أنهيتَ ما تجمّد منها بـ`taskkill` بالاسم `/im` أو بالرقم `/pid`، وحذرتَ من الإجبار `/f` الذي يقتل بلا حفظ. وقرأتَ بطاقة هويّة جهازك كلَّها بـ`systeminfo`. ثمّ لبستَ ثوب الطبيب: تُصلح ملفّات النظام بـ`sfc /scannow`، وتفحص القرص بـ`chkdsk` وتُصلحه بـ`/f` و`/r` بحذر. وأخيرًا أمسكتَ مفتاح الطاقة بـ`shutdown` وخياراته `/s` و`/r` و`/t`، ومعها طوقُ النجاة: التراجع بـ`/a`. والخيط الذي يجمعها كلَّها: بعض الأوامر تفحص فلا ضرر منها، وبعضها يتصرّف فتُمسك يدك وتتيقّن قبل الضغط. بهذا صرتَ تُملي على موجّه الأوامر وتكتب سكربتاته وتُدير نظامه. في الفصل التالي نشحذ أداةً نصّيّةً حادّة: *النصوص والمرشِّحات في CMD*، حيث يغربل `findstr` سطورَ مخرجاتك بالتعابير النمطيّة، فتلتقط الإبرة من كومة السطور.

#challenge[
  اجمع أدوات الفصل في «تقرير صحّة النظام». أوّلًا، نفّذ `systeminfo` واستخرج منه اسم نظامك وحجم ذاكرتك. ثانيًا، شغّل `ipconfig` واكتب عنوان `Default Gateway`. ثالثًا، افتح المفكّرة، وجِد `PID`ها بـ`tasklist`، ثم أنهِها بالطريقة المؤدّبة (بلا `/f`). رابعًا، افتح موجّه الأوامر كمسؤول ونفّذ الفحص الآمن `chkdsk C:` واقرأ نتيجته. أخيرًا، جدوِل إعادة تشغيلٍ بعد دقيقتين بـ`shutdown /r /t 120`، ثم — بعد أن تتأمّل التنبيه — ألغِها بـ`shutdown /a`. سؤالٌ ختاميّ: أيُّ أوامر هذه الجولة *يفحص فقط* وأيّها *يتصرّف*؟ ولماذا كان إلغاؤك للإطفاء ممكنًا بينما لا يمكن التراجع عن `taskkill /f`؟
]
