#chapter[التحكّم بالتدفّق ومعالجة الأخطاء]

#objectives((
  [تجعل السكربت *يقرّر* بنفسه بجملة `if`/`elseif`/`else`، فيسلك مسارًا دون آخر بحسب الحال.],
  [توازن بين القيم بعوامل المقارنة `-eq` و`-ne` و`-lt` و`-gt` وأخواتها.],
  [تختار من قائمة احتمالاتٍ كثيرةٍ في أناقةٍ بجملة `switch`.],
  [تكرّر عملًا مرّاتٍ كثيرةً بالحلقات `for` و`foreach` و`while` و`do`.],
  [تُمسك بالأخطاء قبل أن تُسقط سكربتك بـ `try`/`catch`/`finally`، فتفشل في هدوءٍ لا في انهيار.],
))

تخيّل سائقًا يقود سيّارته في مدينةٍ بلا إشاراتٍ ولا مفترقات: طريقٌ واحدٌ مستقيمٌ يمشي فيه إلى الأبد. كلُّ ما تعلّمناه حتى الآن كان طريقًا كهذا — أمرٌ يتبع أمرًا في خطٍّ واحد. لكنّ الحياة ليست خطًّا مستقيمًا؛ فيها مفترقاتٌ تختار عندها يمينًا أو شمالًا، ودوّاراتٌ تلفّ فيها مرّاتٍ حتى تخرج، وحوادثُ مفاجئةٌ تُحسن التصرّف عندها بدل أن تصطدم. *التحكّم بالتدفّق* (Flow Control) هو أن تعطي سكربتك هذه القدرة: أن يقرّر، وأن يكرّر، وأن ينجو من الخطأ. وبه يتحوّل السكربت من قائمة أوامرَ صمّاء إلى برنامجٍ يفكّر.

#define("التحكّم بالتدفّق (Flow Control)", [
  توجيه مسار تنفيذ السكربت بحسب الظروف بدل أن يمشي سطرًا سطرًا حتى النهاية. أدواته ثلاث: *القرار* (تنفيذ كتلةٍ دون أخرى)، *والتكرار* (إعادة كتلةٍ مرّاتٍ)، *ومعالجة الأخطاء* (اعتراض الخطأ والتصرّف بدل الانهيار).
])

#section[القرار الأوّل: جملة if]

المفترق الأبسط سؤالٌ جوابه نعم أو لا: «إن تحقّق شرطٌ، فافعل كذا». في PowerShell تكتب هذا بكلمة `if` (أي «إنْ»)، تتبعها *الشرط* بين قوسين هلاليّين `()`، ثمّ *الكتلة* التي تُنفَّذ إن صحّ الشرط بين قوسين معقوفين `{}`. تأمّل قرارًا في سنّ شخص:

```powershell
$age = 20
if ($age -ge 18) { "بالغ" } else { "قاصر" }
```

#session("if ($age -ge 18) { \"بالغ\" } else { \"قاصر\" }", prompt: "PS>", output: "بالغ")

قرأها PowerShell هكذا: «انظر في الشرط `$age -ge 18` — هل العمر أكبر من ثمانية عشر أو يساويه؟ إن كان صوابًا فنفّذ الكتلة الأولى، وإلّا فنفّذ كتلة `else`». وبما أنّ العمر عشرون، صحَّ الشرط فطبع «بالغ». كلمة `else` (أي «وإلّا») اختياريّة: تكتبها حين يكون لديك بديلٌ للحالة المعاكسة، وتتركها إن كنت لا تريد فعل شيءٍ عند فشل الشرط.

#define("الشرط (Condition)", [
  تعبيرٌ نتيجته منطقيّة: إمّا `$true` (صواب) وإمّا `$false` (خطأ). جملة `if` تنفّذ كتلتها إن كانت النتيجة `$true`. والشرط يُبنى غالبًا بعامل *مقارنة* كـ `-ge`، يوازن قيمتين ويردّ صوابًا أو خطأً.
])

#subsection[عوامل المقارنة]

الشرط قلبُه *مقارنةٌ* بين قيمتين. وهنا مفاجأةٌ للقادم من لغاتٍ أخرى: PowerShell لا يستعمل الرمزين `<` و`>` للمقارنة، لأنّ `>` محجوزٌ لإعادة التوجيه كما رأينا في فصلٍ سابق، و`<` محجوزٌ هو الآخر في الصدفة فلا تقبله أصلًا. بدلًا منهما عواملُ من حرفين تبدأ بشَرطة، مأخوذةٌ من اختصاراتٍ إنجليزيّة سهلة الحفظ:

#table(
  columns: (auto, 1fr, auto),
  align: (center, right, center),
  table.header([العامل], [معناه], [مثال يصحّ]),
  [`-eq`], [يساوي (equal)], [`5 -eq 5`],
  [`-ne`], [لا يساوي (not equal)], [`5 -ne 2`],
  [`-gt`], [أكبر من (greater than)], [`10 -gt 3`],
  [`-ge`], [أكبر أو يساوي (greater/equal)], [`5 -ge 5`],
  [`-lt`], [أصغر من (less than)], [`3 -lt 10`],
  [`-le`], [أصغر أو يساوي (less/equal)], [`3 -le 3`],
)

كلُّ واحدٍ منها يوازن طرفيه بترتيب كتابتهما في الأمر — فـ `10 -gt 3` تُقرأ «عشرةٌ أكبر من ثلاثة» لا العكس — ويردّ قيمةً منطقيّة. جرّبها عاريةً في الطرفية لترى نتيجتها المجرّدة:

#session("10 -gt 3", prompt: "PS>", output: "True")

#session("7 -ne 2", prompt: "PS>", output: "True")

ردّ `True` (صواب) في الحالتين، لأنّ عشرةً أكبر من ثلاثة فعلًا، وسبعةً لا تساوي اثنين. وهذه القيمة `True` هي بالضبط ما تبحث عنه جملة `if`. تستطيع أيضًا أن تجمع شرطين بـ `-and` (وَ) أو `-or` (أو): يصحّ `-and` إن صحّ الطرفان معًا، ويصحّ `-or` إن صحّ أحدهما:

```powershell
$temp = 25
if ($temp -gt 20 -and $temp -lt 30) { "طقس معتدل" }
```

#session("if ($temp -gt 20 -and $temp -lt 30) { \"طقس معتدل\" }", prompt: "PS>", output: "طقس معتدل")

#warn[
  لا تكتب `=` مكان `-eq` في الشرط. علامة `=` المفردة تعني *الإسناد* (ضع قيمةً في متغيّر)، أمّا المقارنة فهي `-eq` دائمًا. الخلط بينهما من أشهر أخطاء المبتدئ في كلّ اللغات، وPowerShell لا ينبّهك إليه: لو كتبت `if ($score = 60)` لأسند ستّين إلى `$score` بدل أن يقارن، ثمّ عدَّ النتيجة صوابًا فنفّذ الكتلة دائمًا — خطأٌ صامتٌ يعمل ولا يشتكي. تذكّر: `=` تُسنِد، و`-eq` توازن.
]

#try-it[
  خزّن درجةً في `$score = 60`. اكتب جملة `if` تطبع «ناجح» إن كانت `-ge 50` و«راسب» فيما عدا ذلك. ثمّ بدّل قيمة `$score` إلى `40` وأعد التنفيذ. جرّب بعدها كلَّ عاملٍ من الجدول عاريًا: `50 -le 50` و`50 -lt 50` — لماذا اختلف الجوابان مع تساوي العددين؟
]

#section[أكثر من مسارين: elseif]

المفترق ذو الطريقين لا يكفي دائمًا؛ فأحيانًا أمامك سلالمُ من الاحتمالات: ممتاز، فجيّد جدًّا، فمقبول، فراسب. هنا تأتي `elseif` (أي «وإن كان») تضعها بين `if` و`else` بقدر ما تشاء، فيفحص PowerShell الشروط *بالترتيب* ويقف عند أوّل شرطٍ يصحّ:

```powershell
$grade = 78
if ($grade -ge 90) { "ممتاز" }
elseif ($grade -ge 75) { "جيد جدًّا" }
elseif ($grade -ge 60) { "مقبول" }
else { "راسب" }
```

#session("if ($grade -ge 90) { ... } elseif ($grade -ge 75) { ... }", prompt: "PS>", output: "جيد جدًّا")

الدرجة ثمانيةٌ وسبعون: لم تبلغ التسعين فتجاوز الشرط الأوّل، لكنّها بلغت الخامسة والسبعين فتوقّف عند الثاني وطبع «جيد جدًّا» — ولم ينظر إلى ما بعده أصلًا. وهذا هو مربط الفرس: PowerShell يمشي في السلالم من أعلى، وينفّذ أوّل درجةٍ تصدق، *ويتجاهل الباقي* حتى لو صدق. لذا رتّب شروطك من الأخصّ إلى الأعمّ؛ فلو بدأت بـ `-ge 60` لالتقط الدرجات العالية كلَّها خطأً.

#tip[
  عدد `elseif` غير محدود، لكنّ كثرتها علامةٌ على أنّ `switch` — قريبنا التالي — قد يكون أوضح. القاعدة العمليّة: إن كنت توازن *المتغيّر نفسه* بقيمٍ كثيرةٍ مختلفة، ففكّر في `switch`؛ وإن كانت شروطك *متنوّعةً* (هذا أكبر، وذاك يساوي، وثالثٌ يحتوي)، فـ `elseif` أنسب.
]

#section[الاختيار من قائمة: switch]

حين يصير القرار «طابِق هذا المتغيّر بواحدةٍ من قيمٍ معدودة»، تصبح سلسلة `elseif` مرهقةً للعين. جملة `switch` (أي «بدّل/وزّع») صُنعت لهذا بالضبط: تعطيها قيمةً بين قوسين، ثمّ تسرد الاحتمالات، كلُّ احتمالٍ قيمةٌ تتبعها كتلته. تُقرأ: «طابِق القيمة بهذه، فإن لم تجد فبتلك...». خُذ تحويل رقم يومٍ إلى اسمه:

```powershell
$day = 3
switch ($day) {
  1 { "الاثنين" }
  2 { "الثلاثاء" }
  3 { "الأربعاء" }
  default { "يوم آخر" }
}
```

#session("switch ($day) { ... }", prompt: "PS>", output: "الأربعاء")

وازن PowerShell قيمة `$day` — وهي `3` — بالخيارات واحدًا واحدًا، فلم يطابقها إلّا الخيار `3`، فنفّذ كتلته وحدها. أمّا `default` (أي «الافتراضيّ») فكتلةٌ تُنفَّذ إن لم يطابق أيُّ خيار، تمامًا كـ `else` في `if`؛ وهي شبكةُ أمانٍ تلتقط ما لم تتوقّعه.

#define("جملة الاختيار (switch)", [
  جملة قرارٍ توازن قيمةً واحدةً بعدّة احتمالاتٍ مسرودة، فتنفّذ كتلة كلِّ احتمالٍ يطابقها — لا الأوّلَ وحده — ما لم توقفها بـ `break`. كلُّ سطرٍ فيها: `قيمة { كتلة }`. و`default` كتلةٌ لِما لم يطابق شيئًا. أوجزُ وأنظفُ من سلسلةٍ طويلةٍ من `elseif` حين يكون المقيسُ متغيّرًا واحدًا.
])

وقوّة `switch` لا تقف عند مطابقة القيم الحرفيّة. أضِف `-Wildcard` فتطابق *أنماطًا* فيها النجمة `*` (تعني «أيّ شيء»)، وهو مثاليٌّ لتصنيف أسماء الملفّات بامتدادها:

```powershell
$file = "report.txt"
switch -Wildcard ($file) {
  "*.txt" { "ملف نصّي" }
  "*.jpg" { "صورة" }
  default { "نوع غير معروف" }
}
```

#session("switch -Wildcard ($file) { ... }", prompt: "PS>", output: "ملف نصّي")

طابَقَ `report.txt` النمطَ `*.txt` لأنّه ينتهي بـ `.txt`، فأعلن أنّه ملفٌّ نصّيّ. وأبعد من ذلك، تستطيع أن تجعل الخيار *شرطًا* كاملًا بوضعه بين `{}`، فتحصل على مرونة `if` داخل نظافة `switch`:

```powershell
switch (4) {
  { $_ -lt 5 } { "أقل من خمسة" }
  { $_ -gt 2 } { "أكبر من اثنين" }
}
```

#session("switch (4) { ... }", prompt: "PS>", output: "أقل من خمسة\nأكبر من اثنين")

لاحظ أمرين: الرمز `$_` يشير إلى القيمة الجاري فحصها (هنا `4`) — وهو المتغيّر التلقائيّ الذي التقيناه في الأنبوب. والأهمّ: `switch` طبع *سطرين*! فهي — بخلاف `if` — لا تتوقّف عند أوّل مطابقةٍ افتراضيًّا، بل تجرّب كلَّ الخيارات، وأربعةٌ فعلًا أقلُّ من خمسةٍ وأكبرُ من اثنين. لو أردت التوقّف عند أوّل مطابقةٍ، أضِف `break` في نهاية كتلتها.

#try-it[
  اكتب `switch` تحوّل رمز درجةٍ حرفيًّا إلى وصف: `"A"` تطبع «امتياز»، و`"B"` «جيّد جدًّا»، و`"C"` «جيّد»، و`default` «غير معروف». جرّبها بقيمة `"B"`. ثمّ اكتب `switch -Wildcard` تصنّف اسم ملفٍّ: `*.mp3` صوت، و`*.mp4` فيديو، والباقي «ملفّ».
]

#section[التكرار: حلقة for]

الحاسوب لا يملّ ولا يخطئ في التكرار — وهذه أعظم مزاياه. حين تريد تنفيذ عملٍ عددًا *معلومًا* من المرّات، فحلقة `for` أداتك. صياغتها تجمع ثلاثة أجزاءٍ بين قوسين، تفصلها فاصلتان منقوطتان `;`: *البداية* (من أين نعدّ)، ثمّ *الشرط* (إلى متى نستمرّ)، ثمّ *الخطوة* (كيف ننتقل للدورة التالية):

```powershell
for ($i = 1; $i -le 5; $i++) { "العدّة $i" }
```

#session("for ($i = 1; $i -le 5; $i++) { \"العدّة $i\" }", prompt: "PS>", output: "العدّة 1\nالعدّة 2\nالعدّة 3\nالعدّة 4\nالعدّة 5")

فكّكها: بدأنا بـ `$i = 1`، وقلنا «استمرّ ما دام `$i -le 5`»، وفي كلّ دورةٍ نفّذنا `$i++` (أي زِد واحدًا). فطبع من واحدٍ إلى خمسة ثمّ توقّف حين صار `$i` ستّةً فبطُل الشرط. الرمز `$i++` اختصارٌ أنيقٌ لـ `$i = $i + 1`، وهو *العدّاد* الذي يقود الحلقة.

#define("الحلقة (Loop)", [
  بنيةٌ تُعيد تنفيذ كتلةٍ من الشِّفرة مرّاتٍ متتالية. `for` تكرّر عددًا معلومًا بعدّادٍ صريح، و`foreach` تكرّر على عناصر قائمةٍ واحدًا واحدًا، و`while` تكرّر ما دام شرطٌ صادقًا. لكلٍّ موضعٌ يتألّق فيه.
])

#section[المرور على قائمة: foreach]

كثيرًا ما لا تريد عدًّا مجرّدًا، بل *المرور على عناصر قائمةٍ* لديك: ملفّاتٍ، أسماءٍ، أسطرٍ. هنا `foreach` (أي «لكلّ») أوضح من `for` وأقلّ عرضةً للخطأ، إذ تعفيك من العدّاد كلَّه. صيغتها تُقرأ كجملةٍ إنجليزيّة: «لكلّ عنصرٍ `$f` في المجموعة `$fruits`، افعل...»:

```powershell
$fruits = @("تفاح", "موز", "عنب")
foreach ($f in $fruits) { "أحبّ $f" }
```

#session("foreach ($f in $fruits) { \"أحبّ $f\" }", prompt: "PS>", output: "أحبّ تفاح\nأحبّ موز\nأحبّ عنب")

في كلّ دورةٍ التقط PowerShell عنصرًا من المصفوفة ووضعه في المتغيّر `$f`، فمرّ على الثلاثة تباعًا. لست بحاجةٍ أن تعرف كم عددها ولا أن تديره بنفسك؛ تتوقّف الحلقة تلقائيًّا عند آخر عنصر. وتقدر أن تدمج القرار داخل التكرار، فتفحص كلَّ عنصرٍ وأنت تمرّ عليه. مرّ على مدًى من الأعداد وصنّف كلًّا زوجيًّا أو فرديًّا بعامل الباقي `%`:

```powershell
foreach ($num in 1..6) {
  if ($num % 2 -eq 0) { "$num زوجيّ" }
  else { "$num فرديّ" }
}
```

#session("foreach ($num in 1..6) { ... }", prompt: "PS>", output: "1 فرديّ\n2 زوجيّ\n3 فرديّ\n4 زوجيّ\n5 فرديّ\n6 زوجيّ")

استعملنا `1..6` لتوليد المدى من واحدٍ إلى ستّة (كما تعلّمنا في فصل المتغيّرات)، والعامل `%` يعطي باقي القسمة؛ فإن كان باقي القسمة على اثنين صفرًا فالعدد زوجيّ. هكذا تلتقي الحلقة بالقرار في بنيةٍ واحدةٍ صغيرةٍ عظيمة الأثر.

#danger[
  الحلقة تُضاعف قوّتها — وقوّة خطئها. سطرٌ مثل `foreach ($f in Get-ChildItem) { Remove-Item $f }` يحذف *كلَّ* ملفٍّ في المجلّد الحاليّ في طرفة عين، وحذف PowerShell لا سلّةَ محذوفاتٍ له. قبل أن تُطلق أيّ حلقةٍ تحذف أو تعدّل، استبدل الفعل المدمّر مؤقّتًا بـ `Write-Host` — وهو أمرٌ لا يفعل شيئًا سوى طباعة نصٍّ على الشاشة — ليطبع ما *سيفعله* فقط، فتراه بعينك آمنًا، ثمّ فعّل الحذف حين تثق. وتذكّر الراية `-WhatIf` التي عرفتها مع `Remove-Item`: تريك ما كان سيُحذَف دون أن تحذف شيئًا. جرّب على مجلّدٍ تجريبيّ، لا على مستنداتك.
]

#try-it[
  اكتب حلقة `for` تطبع الأعداد من عشرةٍ إلى واحدٍ تنازليًّا (تلميح: ابدأ من `10`، والشرط `-ge 1`، والخطوة `$i--`). ثمّ أنشئ مصفوفة `$names` بثلاثة أسماء، ومُرّ عليها بـ `foreach` تطبع لكلّ اسمٍ «مرحبًا يا ...». أخيرًا: مُرّ على `1..10` واطبع مربّع كلّ عددٍ بـ `$n * $n`.
]

#section[التكرار المشروط: while و do]

`for` و`foreach` تعرفان *كم مرّةً* ستدوران. لكن أحيانًا لا تعرف العدد سلفًا؛ كلُّ ما لديك شرطٌ تستمرّ ما دام صادقًا: «استمرّ حتى ينفد الرصيد»، «كرّر حتى يُدخل المستخدم كلمةً صحيحة». هنا حلقة `while` (أي «طالما»): تفحص الشرط *قبل* كلّ دورة، وتدور ما دام صادقًا:

```powershell
$n = 3
while ($n -gt 0) { "العدّ التنازليّ: $n"; $n-- }
"انطلق!"
```

#session("while ($n -gt 0) { ... }; \"انطلق!\"", prompt: "PS>", output: "العدّ التنازليّ: 3\nالعدّ التنازليّ: 2\nالعدّ التنازليّ: 1\nانطلق!")

بدأنا بـ `$n = 3`، ودارت الحلقة ثلاثًا: في كلّ دورةٍ طبعت القيمة ثمّ أنقصتها بـ `$n--`، حتى صار `$n` صفرًا فبطُل الشرط `$n -gt 0` فخرجت. لاحظ الأمر الحاسم: *لا بدّ أن يتغيّر داخل الحلقة شيءٌ يقرّبها من نهايتها* (هنا `$n--`)، وإلّا دارت إلى الأبد.

#warn[
  *الحلقة اللانهائيّة* أشهر مصائد الحلقات: إن نسيت أن تُنقص `$n` في المثال أعلاه، بقي الشرط صادقًا أبدًا ودار السكربت بلا توقّف يلتهم المعالج. إن وقعت فيها، أوقف التنفيذ بالضغط على #kbd("Ctrl") + #kbd("C") — وهو مفتاح النجاة الذي يقاطع أيّ أمرٍ جامح في الطرفية. ثمّ راجع: ما الذي كان ينبغي أن يتغيّر ولم يتغيّر؟
]

وثمّة قريبٌ لـ `while` اسمه `do`...`while`، يختلف في نقطةٍ دقيقةٍ مهمّة: يفحص الشرط *بعد* الدورة لا قبلها، فيضمن تنفيذ الكتلة *مرّةً واحدةً على الأقلّ* مهما كان الشرط. تأمّل هذا العدّ القصير:

```powershell
$x = 10
do { "القيمة $x"; $x-- } while ($x -gt 8)
```

#session("do { \"القيمة $x\"; $x-- } while ($x -gt 8)", prompt: "PS>", output: "القيمة 10\nالقيمة 9")

دارت مرّتين: طبعت `10` ثمّ `9`، وحين صار `$x` ثمانيةً بطُل الشرط `$x -gt 8`. ولترى الفرق بين الاثنين بعينك، ابدأ بـ `$x = 8` — أي بشرطٍ كاذبٍ منذ اللحظة الأولى: حلقة `while` لن تطبع شيئًا البتّة، أمّا `do`...`while` فتطبع القيمة مرّةً واحدةً ثمّ تخرج. القاعدة: استعمل `while` إن أردت أن يُفحص الشرط قبل أيّ تنفيذ (قد لا تدور أصلًا)، و`do`...`while` إن أردت ضمان دورةٍ واحدةٍ على الأقلّ.

#tip[
  للتحكّم الدقيق داخل أيّ حلقةٍ أمْرَان ذهبيّان: `break` يكسر الحلقة ويخرج منها فورًا، و`continue` يقفز إلى الدورة التالية متجاوزًا بقيّة الكتلة. مثلًا `if ($n -gt 3) { break }` يوقف العدّ عند تجاوز الثلاثة، و`if ($n -eq 3) { continue }` يتخطّى الرقم ثلاثةً وحده ويكمل. بهما تصوغ حلقاتٍ ذكيّةً تعرف متى تقف ومتى تتخطّى.
]

#distro[
  المفاهيم كلُّها — القرار والتكرار — موجودةٌ في صدفة Bash على لِينُكس وماك، لكنّ الصياغة تختلف. المقارنة هناك `[ "$age" -ge 18 ]` (بالأقواس المربّعة)، والحلقة `for f in *.txt; do ...; done` تُغلَق بكلمة `done` لا بقوسٍ معقوف، والشرط `if ...; then ...; fi`. الفكرة واحدةٌ في العالمَين، لكنّ PowerShell يستعمل الأقواس المعقوفة `{}` على طراز لغات البرمجة العامّة. وعواملُه `-eq` و`-lt` تشبه ما تراه في Bash داخل `[ ]` — فكلتا الصدفتين تجنّبت الرمزين `<` و`>` لأنّهما محجوزان — غير أنّ عوامل Bash هذه للأعداد وحدها، أمّا في PowerShell فتوازن النصوص كذلك.
]

#section[حين يقع الخطأ: try و catch و finally]

في عالمٍ مثاليٍّ تصحّ كلُّ الأوامر. لكن في الواقع: الملفّ الذي تريده محذوف، والشبكة مقطوعة، والقسمة على صفرٍ مستحيلة. إن تركت الخطأ يقع دون تدبير، انهار سكربتك في رسالةٍ حمراء مخيفة وتوقّف. *معالجة الأخطاء* هي أن تحيط العمل الخطير بشبكة أمان: «*جرّب* هذا؛ فإن وقع خطأٌ *فأمسِكْه* وتصرّف؛ *وأخيرًا* نظّف مهما حدث». هذه بالضبط كلمات PowerShell الثلاث: `try` و`catch` و`finally`.

```powershell
try {
  $result = 10 / 0
}
catch {
  "وقع خطأ: لا يمكن القسمة على صفر"
}
```

#session("try { 10 / 0 } catch { ... }", prompt: "PS>", output: "وقع خطأ: لا يمكن القسمة على صفر")

لولا `try` لأسقطت القسمةُ على صفرٍ السكربتَ كلَّه برسالةِ خطأٍ فظّة. لكنّنا وضعنا العمل الخطير في كتلة `try`، فلمّا وقع الخطأ لم ينهر البرنامج، بل قفز التنفيذ فورًا إلى كتلة `catch` (أي «أمسِكْ») التي طبعت رسالةً لطيفةً مفهومة. هكذا يفشل سكربتك *برشاقةٍ* لا بانهيار.

#define("معالجة الأخطاء (Error Handling)", [
  اعتراض الأخطاء وقت وقوعها والتصرّف حيالها بدل ترك البرنامج ينهار. `try` تحيط بالشِّفرة المعرَّضة للخطأ، و`catch` تُنفَّذ *فقط* إن وقع خطأ في `try`، و`finally` تُنفَّذ *دائمًا* — نجح العمل أم فشل — وموضعها التنظيف وإغلاق الموارد.
])

والكتلة `catch` لا تعرف فقط أنّ خطأً وقع، بل تملك تفاصيله. الخطأُ الجاري محفوظٌ في المتغيّر التلقائيّ `$_`، وتقرأ رسالته الأصليّة من `$_.Exception.Message`:

```powershell
try {
  1 / 0
}
catch {
  "الرسالة: $($_.Exception.Message)"
}
```

#session("try { 1 / 0 } catch { \"الرسالة: $($_.Exception.Message)\" }", prompt: "PS>", output: "الرسالة: Attempted to divide by zero.")

كشف لنا PowerShell نصَّ الخطأ الأصليّ: «حاولتَ القسمة على صفر». هذا كنزٌ عند التشخيص، إذ يخبرك *بماذا* أخفق بالضبط. أمّا الضلع الثالث `finally` (أي «وفي الختام») فكتلةٌ تُنفَّذ في كلّ الأحوال، سواءٌ نجحت `try` أو سقطت في `catch` — موضعها الأعمال التي *يجب* أن تتمّ مهما جرى، كإغلاق ملفٍّ أو إعلان انتهاء العمليّة:

```powershell
try {
  Get-Item "C:\ملف-غير-موجود.txt" -ErrorAction Stop
}
catch {
  "لم أجد الملف"
}
finally {
  "انتهت المحاولة على كلّ حال"
}
```

#session("try { ... } catch { ... } finally { ... }", prompt: "PS>", output: "لم أجد الملف\nانتهت المحاولة على كلّ حال")

فشلت `try` لأنّ الملفّ غير موجود، فطبعت `catch` «لم أجد الملف»، ثمّ طبعت `finally` سطرها الختاميّ. ولو نجحت `try` لتخطّى التنفيذُ `catch` ومضى إلى `finally` مباشرة — فهي جسرٌ يمرّ عليه الجميع.

#warn[
  كثيرٌ من أوامر PowerShell — وخاصّةً الأوامر الموحّدة (cmdlets) مثل `Get-Item` — لا يُطلق خطأً «قاطعًا» يمسكه `try` افتراضًا، بل ينبّه ويكمل. لتُجبره على التوقّف فيُمسكه `catch`، أضِف `-ErrorAction Stop` كما في المثال أعلاه. بدونها قد تجد كتلة `catch` لا تُنفَّذ رغم ظهور خطأٍ أحمر — وهي حَيْرةٌ شائعةٌ للمبتدئ. القاعدة: إن أردت اعتراض خطأ أمرٍ موحّد، اقرنه بـ `-ErrorAction Stop`.
]

#try-it[
  أحِط `[int]"نصّ ليس رقمًا"` بكتلة `try`، والتقط الخطأ في `catch` بطباعة «فشل التحويل إلى عدد». هل نُفِّذت `catch`؟ ثمّ أضِف `finally` تطبع «تمّ». أخيرًا اطبع في `catch` رسالة الخطأ الأصليّة بـ `$_.Exception.Message` وتأمّل بماذا اشتكى PowerShell.
]

#section[خلاصة الفصل]

في هذا الفصل منحتَ سكربتك عقلًا يقرّر ويكرّر وينجو. عرفتَ أنّ `if`/`elseif`/`else` تختار مسارًا بحسب *شرطٍ* نتيجته منطقيّة، وأنّ الشرط يُبنى بعوامل المقارنة `-eq` و`-ne` و`-gt` و`-ge` و`-lt` و`-le` — لا بالرمزين `<` و`>` المحجوزين في الصدفة — وأنّها تُجمع بـ `-and` و`-or`. ورأيت أنّ `switch` تطابق قيمةً واحدةً بقائمة احتمالاتٍ في أناقةٍ، وتقبل الأنماط بـ `-Wildcard` والشروط بين `{}`. ثمّ كرّرت العمل بأربع حلقات: `for` بعدّادٍ صريحٍ لعددٍ معلوم، و`foreach` للمرور على عناصر قائمةٍ بلا عدّاد، و`while` للتكرار ما دام شرطٌ صادقًا يُفحَص قبل الدورة، و`do`...`while` الذي يضمن دورةً واحدةً على الأقلّ — وتحكّمت فيها بـ `break` و`continue`. وأخيرًا أحطتَ العمل الخطير بشبكة `try`/`catch`/`finally`: تجرّب، فتمسك بالخطأ إن وقع وتقرأ تفاصيله من `$_.Exception.Message`، فتُنهي بالتنظيف مهما جرى — مع تذكّر `-ErrorAction Stop` لتجبر الأمر الموحّد على التوقّف. بهذه الأدوات الثلاث — القرار والتكرار والمعالجة — تكفّ سكربتاتك عن كونها قوائمَ أوامرَ عمياء، وتصير برامجَ تفكّر وتصمد. في الفصل التالي ننقل هذه القوّة إلى إدارة النظام: نراقب العمليّات والخدمات ونتحكّم فيها.

#challenge[
  اكتب سكربتًا يمرّ بـ `foreach` على المدى `1..20`، ولكلّ عددٍ يقرّر: إن قبِل القسمة على `15` (باقي `%` صفر لِـ `3` و`5` معًا) يطبع «FizzBuzz»، وإن قبل القسمة على `3` وحده يطبع «Fizz»، وإن قبل القسمة على `5` وحده «Buzz»، وإلّا يطبع العدد نفسه — وهذه لعبة برمجيّةٌ شهيرة تجمع الحلقة والقرار وعامل `%`. ثانيًا، لُفّ العمليّة كلَّها في `try`/`catch` بحيث لو وقع أيُّ خطأٍ طُبعت رسالةٌ لطيفة بدل الانهيار، و`finally` تُعلن «انتهى الفحص». سؤالٌ أخير للتأمّل: لماذا كان لا بدّ أن نفحص القسمة على `15` *قبل* القسمة على `3` و`5`؟ ماذا كان سيحدث لو عكسنا الترتيب؟
]
