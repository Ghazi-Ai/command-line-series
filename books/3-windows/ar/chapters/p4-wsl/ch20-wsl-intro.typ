#chapter[ما WSL ولماذا]

#objectives((
  [تفهم ما «نظام لِينُكس»، ولماذا قد تريده أن يعمل داخل ويندوز نفسه.],
  [تعرف ما WSL، وما الفرق بين نسختيه، ولماذا صار WSL2 هو المعياريّ.],
  [تثبّت نظام لِينُكس كاملًا بأمرٍ واحد: `wsl --install`.],
  [تستعرض التوزيعات المتاحة بـ `wsl --list --online`، وتثبّت أوبونتو.],
  [تدخل إلى لِينُكس بالأمر `wsl`، وتعرف أين تلتقي ملفّات النظامَين.],
))

تخيّل أنّ لك بيتًا واسعًا تسكنه بلغتك وعاداتك. ثم جاءك صديقٌ من بلدٍ آخر، يتكلّم لغةً أخرى، ويطبخ طبخًا مختلفًا. قديمًا كان عليك أن تختار: إمّا أن يسكن بيتك فتتغيّر كلّ العادات، وإمّا أن يبني بيتًا منفصلًا فتنقطع الزيارة. لكنّ الحلّ الأذكى أن تُفرد له جناحًا كاملًا في بيتك: مطبخه ولغته وأثاثه كما اعتاد، وبابٌ داخليٌّ يصل جناحه بصالتك فتتزاوران متى شئتما. هذا الجناح بالضبط هو ما تفعله أداة WSL: تُسكِن نظام لِينُكس جناحًا كاملًا داخل ويندوز، لا في بيتٍ منفصل، فتعمل باللغتين معًا دون أن تغادر جهازك.

#section[ما نظام لِينُكس، ولماذا تريده أصلًا؟]

قبل WSL، لا بدّ من كلمةٍ عن الضيف. *لِينُكس* نظام تشغيلٍ مستقلٌّ، شأنه شأن ويندوز وماك: يدير العتاد ويشغّل البرامج. لكنه مجّانيٌّ ومفتوح المصدر، ويشغّل اليوم أغلب خوادم العالم والمواقع التي تزورها ومعظم الهواتف عبر أندرويد.

#define("نظام لِينُكس (Linux)", [
  نظام تشغيلٍ مستقلٌّ عن ويندوز، مجّانيٌّ ومفتوح المصدر. الحزمة الكاملة الجاهزة للاستعمال منه تُسمّى *توزيعة* (Distribution)، وأشهرها *أوبونتو* (Ubuntu). هو نظام أغلب الخوادم في العالم.
])

فلماذا يريد مستخدم ويندوز لِينُكس؟ لأنّ كثيرًا من أدوات البرمجة والخوادم وُلدت في عالم لِينُكس وتعمل فيه أنقى وأسهل: أدوات المطوّرين، ولغات البرمجة، والحاويات (وهي طريقةٌ لتغليف البرنامج مع كلّ ما يحتاجه ليعمل كما هو على أيّ جهاز)، وأوامرُ الشبكة والنصوص التي يعتمد عليها المحترفون. إن كنت تتعلّم البرمجة أو إدارة الخوادم، فستقابل لِينُكس عاجلًا؛ وأن يكون بين يديك داخل ويندوز يعني أنك تتدرّب على البيئة الحقيقيّة التي سيعمل فيها عملك لاحقًا.

#note[
  هذا كتابٌ عن ويندوز، وهو مستقلٌّ بذاته لا يفترض أنك تعرف لِينُكس. لذا لن نعلّمك أوامر لِينُكس هنا؛ هذا الفصل يعلّمك فقط كيف *تُحضِر* لِينُكس إلى جهازك وتدخل إليه. أمّا أوامره فلها كتابٌ مستقلٌّ في هذه السلسلة نفسها.
]

#section[ما WSL؟]

كان تشغيل لِينُكس على جهاز ويندوز قديمًا يمرّ بطريقين، كلاهما ثقيل. إمّا *الإقلاع المزدوج*: تقسّم قرصك وتختار عند كلّ تشغيلٍ نظامًا واحدًا فقط، فلا يعملان معًا. وإمّا *آلةٌ افتراضيّة* كاملة: برنامجٌ يحاكي حاسوبًا بأكمله داخل نافذة، بطيءٌ ونهِمٌ للذاكرة. جاءت مايكروسوفت بحلٍّ ثالثٍ أنيق اسمه WSL.

#define("WSL", [
  اختصار *نظام ويندوز الفرعيّ للِينُكس* (Windows Subsystem for Linux). ميزةٌ رسميّةٌ من مايكروسوفت تشغّل نظام لِينُكس كاملًا *داخل* ويندوز مباشرة، دون إقلاعٍ مزدوجٍ ولا آلةٍ افتراضيّةٍ ثقيلة. تفتح نافذة، فإذا أنت في لِينُكس.
])

الفكرة أنّ لِينُكس وويندوز يعملان *في الوقت نفسه* على الجهاز الواحد. تكتب في نافذةٍ أمرًا ويندوزيًّا، وفي أخرى أمرًا لِينُكسيًّا، وينتقل الملفّ بينهما. لا تختار أحدهما على حساب الآخر؛ يجتمعان لك في مكانٍ واحد، وهذا هو جوهر قوّة WSL.

#section[لماذا WSL2 لا WSL1؟]

مرّت الأداة بجيلين. أمّا الأوّل WSL1 فكان يترجم طلبات لِينُكس إلى ويندوز ترجمةً، وهو سريعٌ في بعض المواطن لكنه غير كامل. وأمّا الجيل الثاني WSL2 فنقلةٌ جذريّة: يشغّل *نواة لِينُكس حقيقيّة* داخل آلةٍ افتراضيّةٍ خفيفةٍ جدًّا، فتحصل على توافقٍ تامٍّ وأداءٍ أعلى.

#define("النواة (Kernel)", [
  قلب نظام التشغيل: البرنامج الأعمق الذي يدير العتاد مباشرة وتُبنى عليه بقيّة البرامج. WSL2 يشغّل نواة لِينُكس أصليّةً حقيقيّة، لا محاكاةً لها، وهذا سرّ توافقه الكامل.
])

الفرق العمليّ أنّ WSL2 يشغّل كلّ برامج لِينُكس تقريبًا كما لو كنت على جهاز لِينُكس أصيل، وبأداءٍ ممتازٍ في مهامّ المطوّرين. لذلك هو الافتراضيّ اليوم، وهو ما يثبّته الأمر الحديث تلقائيًّا، وعليه يقوم هذا الفصل كلّه.

#note[
  «آلةٌ افتراضيّةٌ خفيفة» هنا لا تشبه الآلة التقليديّة الثقيلة. WSL2 يديرها لك في الخلفية: تبدأ في لحظاتٍ عند أوّل أمر، وتتقاسم الذاكرة بذكاء، ولا تراها نافذةً منفصلة. أنت تشعر أنّ لِينُكس مجرّد نافذةٍ أخرى في ويندوز.
]

#section[التثبيت بأمرٍ واحد: `wsl --install`]

هنا يبدأ العمل. تثبيت لِينُكس كاملًا صار أمرًا واحدًا على ويندوز 11 وعلى الإصدارات الحديثة من ويندوز 10. لكنه يغيّر في النظام، فيحتاج صلاحيّة *المسؤول* (Administrator). افتح موجّه الأوامر أو PowerShell «كمسؤول»: انقر بالزرّ الأيمن على أيقونته واختر «تشغيل كمسؤول» (Run as administrator). ثم اكتب:

#session("wsl --install")

هذا الأمر وحده يفعل كلّ شيء: يفعّل مكوّنات WSL في ويندوز، وينزّل نواة لِينُكس، ويثبّت التوزيعة الافتراضيّة *أوبونتو* على النسخة WSL2. حين ينتهي، سيطلب منك *إعادة تشغيل الجهاز*؛ أعد تشغيله لتكتمل التهيئة.

#define("المسؤول (Administrator)", [
  حساب الصلاحيّات الكاملة في ويندوز، الذي يُسمح له بتغيير النظام نفسه. تثبيت WSL يحتاجه، لذا تفتح الصدفة بخيار «تشغيل كمسؤول» قبل الأمر.
])

بعد إعادة التشغيل، تُفتح نافذة أوبونتو تلقائيًّا لتُكمل تهيئتها لأوّل مرّة، فتطلب منك اختيار *اسم مستخدمٍ* لِينُكسيٍّ وكلمةِ مرورٍ له. اختر ما شئت؛ هذا حساب داخل لِينُكس، مستقلٌّ عن حساب ويندوز.

#warn[
  حين تكتب كلمة المرور لأوّل مرّة، لن ترى على الشاشة نجومًا ولا نقاطًا ولا شيئًا يتحرّك أصلًا. هذا سلوك لِينُكس المقصود لإخفاء طول الكلمة، وليس تعطّلًا. اكتبها بثقةٍ ثم اضغط #kbd("Enter").
]

#try-it[
  افتح PowerShell «كمسؤول»، ونفّذ `wsl --install`. راقب مراحل التنزيل، ثم أعد تشغيل الجهاز حين يُطلب منك. عند عودة النظام، أنشئ اسم مستخدمٍ وكلمة مرورٍ للِينُكس حين تُسأل. أنت الآن تملك نظامَي تشغيلٍ في جهازٍ واحد.
]

#section[استعراض التوزيعات المتاحة: `wsl --list --online`]

أوبونتو هي الافتراضيّة، لكنها ليست الوحيدة. لترى قائمة التوزيعات التي تستطيع تثبيتها، اسأل WSL أن يجلب القائمة من الإنترنت بالأمر:

#session(
  "wsl --list --online",
  output: "NAME                  FRIENDLY NAME
Debian                Debian GNU/Linux
Ubuntu                Ubuntu
Ubuntu-24.04          Ubuntu 24.04 LTS
archlinux             Arch Linux
kali-linux            Kali Linux Rolling
openSUSE-Tumbleweed   openSUSE Tumbleweed",
)

القائمة عندك أطول من هذه؛ اقتصرنا على أشهر ما فيها. العمود الأوّل `NAME` هو الاسم المختصر الذي تكتبه للتثبيت، والثاني اسمٌ معروضٌ للقراءة فحسب لا تكتبه في الأمر. ولهذا الأمر صيغةٌ مختصرةٌ شائعة، `wsl -l -o`، تعطي القائمة نفسها؛ فالخيار `--list` يختصر إلى `-l`، و`--online` إلى `-o`.

#tip[
  أغلب خيارات WSL لها صورتان: صورةٌ طويلةٌ واضحة تبدأ بشَرطتين مثل `--online`، وصورةٌ مختصرةٌ بحرفٍ واحدٍ وشَرطةٍ مثل `-o`. اكتب الطويلة حتى ترسخ في ذهنك، ثم انتقل للمختصرة حين تألفها.
]

لتثبيت توزيعةٍ بعينها بدل الافتراضيّة، أضِف الخيار `-d` (اختصار `--distribution`) متبوعًا باسمها من العمود الأوّل. لتثبيت أوبونتو صراحةً مثلًا:

#session("wsl --install -d Ubuntu")

#try-it[
  نفّذ `wsl -l -o` وتأمّل التوزيعات المتاحة. ما الأسماء التي تعرفها؟ لا تثبّت شيئًا جديدًا الآن؛ يكفينا أوبونتو. الهدف أن تعرف أنّ الباب مفتوحٌ لأكثر من توزيعة.
]

#section[الدخول إلى لِينُكس والخروج منه: `wsl`]

ثبّتنا التوزيعة، فكيف ندخلها في أيّ وقت؟ افتح موجّه الأوامر أو PowerShell العاديّ (لا يلزم المسؤول الآن)، واكتب كلمةً واحدة:

#session("wsl")

في اللحظة نفسها يتغيّر المحثّ أمامك: كان محثّ ويندوز `C:\>`، فصار محثّ لِينُكس، وهو على هيئة `اسمك@الجهاز`، ثم النقطتان الرأسيّتان `:`، ثم المجلّد الذي أنت فيه، ثم الرمز `$`. وهذا الرمز `$` في آخره علامةُ أنك الآن *داخل* لِينُكس، وأنّ ما تكتبه بعده أوامرُ لِينُكس لا ويندوز.

ولأنّ الأمر `wsl` يفتح لِينُكس على المجلّد الويندوزيّ الذي كنت فيه، فستجد نفسك أوّل الأمر في مقابله اللِينُكسيّ: خرجتَ من `C:\` فحططتَ في `/mnt/c` — وسيأتي شرح هذا المسار في آخر الفصل. انتقل الآن إلى *منزلك* في لِينُكس، وهو مجلّدك الخاصّ هناك ورمزه `~`:

#session("cd ~", prompt: "abuhaitham@win:/mnt/c$ ")

فصار المحثّ يعرض `~` مكان اسم المجلّد، أي أنك في منزلك. جرّب أمرًا لِينُكسيًّا يسألك عن هويّتك هناك:

#session("whoami", output: "abuhaitham", prompt: "abuhaitham@win:~$ ")

وللخروج من لِينُكس والعودة إلى محثّ ويندوز، اكتب داخل لِينُكس كلمةً واحدة:

#session("exit", prompt: "abuhaitham@win:~$ ")

فيعود المحثّ `C:\>` كما كان. والآن وأنت في ويندوز، تحقّق من أنّ التثبيت تمّ وعلى أيّ نسخة: اسأل WSL عن توزيعاته المثبّتة بالخيار `-v` (اختصار `--verbose`):

#session(
  "wsl --list --verbose",
  output: "  NAME      STATE           VERSION
* Ubuntu    Running         2",
)

النجمة `*` تشير إلى التوزيعة الافتراضيّة، والعمود `VERSION` يؤكّد أنها تعمل على WSL2 كما أردنا.

#note[
  إن ثبّتَّ أكثر من توزيعة، تدخل واحدةً بعينها بالخيار `-d` هكذا: `wsl -d Debian`. أمّا `wsl` وحدها فتدخلك التوزيعة الافتراضيّة (المعلَّمة بالنجمة). ولتغيير الافتراضيّة استعمل `wsl --set-default <الاسم>`.
]

#try-it[
  ادخل لِينُكس بـ `wsl`، ولاحظ كيف تغيّر المحثّ من `C:\>` إلى محثٍّ ينتهي بـ `$`. نفّذ `whoami` لترى اسم مستخدمك اللِينُكسيّ. ثم اكتب `exit` وراقب عودتك إلى محثّ ويندوز. كرّرها مرّتين حتى تألف الانتقال بين العالمين.
]

#section[جسرٌ بين نظامَي الملفّات: `/mnt/c` والمسار `\\wsl$`]

آخر ما يدهش المبتدئ: أين ملفّاتي؟ الجميل أنّ WSL يصل كلًّا من النظامين بالآخر في الاتجاهين، فترى ملفّات كلّ نظامٍ من داخل الآخر.

من *داخل لِينُكس*، تظهر أقراص ويندوز موصولةً تحت مجلّدٍ اسمه `/mnt`. فالقرص `C:` تجده في المسار `/mnt/c`، والقرص `D:` في `/mnt/d`، وهكذا. تنتقل إليها بأوامر لِينُكس فتتصفّح ملفّات ويندوز كما لو كانت جزءًا من لِينُكس.

#define("نقطة الوصل (Mount point)", [
  في لِينُكس، كلّ قرصٍ يُربَط بمجلّدٍ يظهر فيه محتواه، ويُسمّى ذلك المجلّد *نقطة وصل*. WSL يصل أقراص ويندوز تلقائيًّا تحت `/mnt`، فيصير القرص `C:` هو المجلّد `/mnt/c`.
])

وفي الاتجاه المعاكس، من *داخل ويندوز*، تصل إلى ملفّات لِينُكس عبر مسارٍ خاصٍّ يبدأ بشَرطتين عكسيّتين: `\\wsl$` أو الأحدث `\\wsl.localhost`. اكتبه في شريط عنوان *مستكشف الملفّات* (File Explorer) فتظهر لك توزيعاتك كأنها مجلّدات شبكة، وتتصفّح داخلها بالفأرة كأيّ مجلّد.

#distro[
  الشَّرطة العكسيّة `\` والقرص `C:` من عالم ويندوز؛ أمّا لِينُكس فكلّ شيءٍ فيه تحت جذرٍ واحدٍ يبدأ بالشرطة الأماميّة `/` بلا أحرف أقراص. لذلك يترجم WSL بينهما: يجعل قرص ويندوز `C:` مجلّدًا لِينُكسيًّا اسمه `/mnt/c`. هذا الجسر بالذات موضوع الفصل التالي بتفصيلٍ أوسع.
]

#danger[
  الأمر `wsl --unregister <الاسم>` يحذف التوزيعة *بكلّ ملفّاتها وإعداداتها* حذفًا نهائيًّا بلا سلّة محذوفاتٍ ولا رجعة. يُستعمل أحيانًا لبدايةٍ نظيفة، لكنه يمحو عملك داخل لِينُكس كلَّه. لا تكتبه إلّا وأنت متيقّنٌ أنك لا تريد شيئًا من تلك التوزيعة، وبعد أن تنسخ ملفّاتك المهمّة إلى قرص ويندوز أوّلًا.
]

#section[خلاصة الفصل]

عرفتَ أنّ لِينُكس نظام تشغيلٍ آخر تحتاجه غالبًا لأدوات البرمجة والخوادم، وأنّ WSL يُسكِنه جناحًا كاملًا داخل ويندوز بلا إقلاعٍ مزدوجٍ ولا آلةٍ ثقيلة. وميّزتَ بين WSL1 وWSL2، وعرفتَ أنّ الثاني — بنواته اللِينُكسيّة الحقيقيّة — هو المعياريّ اليوم. وثبّتَّ نظامًا كاملًا بأمرٍ واحد `wsl --install`، واستعرضتَ المتاح بـ `wsl --list --online`، ودخلتَ لِينُكس بـ `wsl` وخرجتَ بـ `exit`، ورأيتَ أين تلتقي ملفّات النظامَين: أقراص ويندوز تحت `/mnt/c` من داخل لِينُكس، وملفّات لِينُكس عبر المسار `\\wsl$` من داخل ويندوز. في الفصل التالي نعبر هذا الجسر بتفصيلٍ أوسع: كيف تنقل الملفّات وتشغّل أوامر كلّ نظامٍ من الآخر.

#challenge[
  أوّلًا، دون أن تنظر أعلاه، أجب: ما الفرق بين WSL2 والإقلاع المزدوج؟ ولماذا نفضّل WSL2 على WSL1؟ ثانيًا، نفّذ `wsl -l -v` وتأكّد أنّ توزيعتك تعمل على النسخة `2`؛ فإن ظهرت `1`، فابحث عن أمر ترقيتها. ثالثًا، ادخل لِينُكس بـ `wsl`، وانتقل إلى مجلّد سطح مكتب ويندوز عبر المسار الذي يبدأ بـ `/mnt/c` — فأين تظنّه يقع؟ خمّن المسار قبل أن تجرّبه.
]
