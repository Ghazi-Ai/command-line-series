#import "/lib/book.typ": chapter, section, subsection
#import "/lib/components.typ": note, tip, warn, try-it, define, challenge, objectives, session

#chapter[تحديثٌ أمني لا يفاجئك]

#objectives((
  [تفهم وظيفة التحديثات غير المراقبة وحدودها.],
  [تقرأ سياسة أوبونتو الفعلية ومؤقتاتها وسجلاتها.],
  [تختبر تشغيلًا جافًا قبل تغيير السياسة.],
  [تفصل تثبيت التحديث عن قرار إعادة التشغيل.],
))

إغلاق الباب كل ليلة عادة أمنية، لكنه قد يحبس شخصًا إذا لم تعرف من
بقي في الداخل. التحديث الآلي عادة نافعة، بشرط أن تعرف مصدره
ونطاقه ووقت تشغيله وما يحدث حين يحتاج النظام إعادة تشغيل.

#define("التحديثات غير المراقبة", [
  آلية في أوبونتو تفحص حزمًا من مصادر مسموحة وتطبق تحديثات وفق
  سياسة دون تدخل يدوي في كل مرة. لا تحل محل مراقبة النتيجة أو
  إدارة أسطول كامل.
])

#section[اعرف الموجود]

```bash
dpkg-query -W unattended-upgrades
systemctl list-timers 'apt-daily*'
grep -RhsE 'APT::Periodic|Unattended-Upgrade::Allowed-Origins|Automatic-Reboot' \
  /etc/apt/apt.conf.d
```

في إصدارات أوبونتو الحديثة تكون تحديثات أمنية آلية مفعلة افتراضيًا
في حالات كثيرة. لا تثبت الحزمة مرة ثانية ولا تفترض أن السياسة
الافتراضية باقية؛ اقرأها.

#section[اختبر بلا تطبيق]

```bash
sudo unattended-upgrade --dry-run --debug
```

المخرج طويل. ابحث عن:

- المصادر المسموحة.
- الحزم المرشحة.
- الحزم المحظورة.
- أخطاء القفل أو المستودع.
- قرار إعادة التشغيل.

التشغيل الجاف لا يضمن أن تحديثًا مستقبليًا لن يفشل، لكنه يكشف
الإعداد الحالي من دون تطبيق الحزم.

#section[أضف سياسة محلية]

لا تعدل الملف الذي تملكه الحزمة إن أمكن. استخدم ملف إسقاط ذي رقم
لاحق:

```bash
sudoedit /etc/apt/apt.conf.d/60local-unattended
```

مثال قرار محافظ يمنع إعادة التشغيل التلقائي:

```text
Unattended-Upgrade::Automatic-Reboot "false";
```

ثم تحقق من البنية والسياسة بتشغيل جاف. اختيار `false` ليس أفضل
دائمًا؛ يعني أنك مسؤول عن مراقبة `/run/reboot-required` وجدولة
الإعادة. تشغيل تلقائي قد يناسب خدمة قابلة للتوقف وتعود وحدها،
لكنه يحتاج اختبار إقلاع وتنبيهًا.

#warn[
  إضافة مستودع خارجي إلى APT لا تعني أن التحديثات غير المراقبة
  ستأخذ تحديثاته تلقائيًا، ولا أن ذلك مرغوب. يجب قرار صريح في
  المصادر المسموحة وثقة بصاحب المستودع.
]

#section[اقرأ ما حدث]

```bash
sudo tail -n 80 /var/log/unattended-upgrades/unattended-upgrades.log
sudo journalctl -u unattended-upgrades \
  --since "7 days ago" --no-pager
```

وقد تسجل عمليات APT في ملفات أخرى. لا تجعل غياب تنبيه يعني
النجاح؛ اجعل فحص آخر تشغيل جزءًا من مراقبتك.

#subsection[حين يتعارض التحديث مع العمل]

قد ترى قفلًا لأن المؤقت يعمل أثناء تثبيت يدوي. لا تحذف ملفات القفل
عشوائيًا. افحص العمليات والوحدات:

```bash
systemctl status apt-daily.service apt-daily-upgrade.service --no-pager
ps -ef | grep -E '[a]pt|[d]pkg|unattended'
```

انتظر العملية الشرعية أو عالج فشلها بعد فهمه.

#section[الحزمة الحرجة]

منع تحديث حزمة قد يشتري وقتًا لتوافق تطبيق، لكنه يبقي مخاطر
معروفة. الحل التشغيلي الأفضل قد يكون اختبارًا على خادم مرحلي،
ونشرًا على دفعات، ونسخة قابلة للاستعادة، بدل إطفاء التحديثات كلها.

#try-it[
  نفّذ التشغيل الجاف في المختبر، وسجل المصادر المسموحة وآخر وقت
  للمؤقت وما إذا كانت إعادة التشغيل تلقائية. لا تغير السياسة قبل
  أن تكتب من سيراقب النتيجة ومن سيعيد التشغيل عند الحاجة.
]

#section[خلاصة الفصل]

التحديث الآلي سياسة قابلة للقراءة والاختبار، لا صندوقًا أسود.
رأينا المؤقت والمصادر والسجل والتشغيل الجاف، وفصلنا تثبيت التصحيح
من قرار إعادة التشغيل.

ويبقى السؤال الذي يسبق كل شجاعة: إذا كسر التحديث أو الخطأ بياناتك،
هل لديك نسخة؟ في الفصل التالي نثبت أن كلمة «نسخة احتياطية» لا
تكتمل حتى تنجح الاستعادة.

#challenge[
  صمّم سياسة تحديث لخدمة صغيرة: ماذا يثبت آليًا، متى تفحص السجل،
  من يقرر إعادة التشغيل، وما اختبارات ما بعد الإقلاع؟ لا تستعمل
  عبارة «تلقائي بالكامل».
]
