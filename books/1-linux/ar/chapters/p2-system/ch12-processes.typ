#chapter[العمليّات: نبض النظام]

#objectives((
  [تفرّق بين البرنامج السّاكن على القرص والعمليّة الحيّة في الذاكرة، وتفهم معرّفها `PID`.],
  [ترى كلَّ ما يعمل في نظامك بلمحةٍ ثابتة (`ps`) وبمراقبةٍ حيّة (`top` و `htop`).],
  [تخاطب العمليّات بالإشارات، وتوقف المتعطّل منها بـ `kill` و `killall` و `pkill`.],
  [تُدير المهامّ: تدفعها إلى الخلفيّة بالرمز `&`، وتنقلها بـ `jobs` و `fg` و `bg`، وتُبقيها حيّةً بـ `nohup`.],
  [تضبط تزاحمَ البرامج على المعالج بأولويّة `nice` و `renice`.],
))

في كتاب الطبخ تقبع الوصفة ساكنةً على الورق: مقاديرُ وخطواتٌ لا حراك فيها، مهما تركتها سنين. لكنّها حين يقرؤها الطبّاخ ويشعل النار وتبدأ القِدر تغلي، تتحوّل إلى شيءٍ حيٍّ يفوح ويتغيّر ويستهلك الغاز والوقت، ثم ينتهي إلى طبقٍ يُقدَّم. الوصفةُ واحدة، لكن قد يطبخها ثلاثة طبّاخين في وقتٍ واحدٍ فتصير ثلاث قدورٍ مستقلّة. هذا الفرقُ نفسه — بين الوصفة الساكنة والطبخة الحيّة — هو الفرق بين *البرنامج* و *العمليّة*. وهذا الفصل عن الطبخات الحيّة التي تغلي في نظامك في هذه اللحظة.

#section[من البرنامج إلى العمليّة]

البرنامجُ ملفٌّ على قرصك: سلسلةٌ من التعليمات ساكنةٌ لا تفعل شيئًا بذاتها، تمامًا كالوصفة على الورق. مثالُه ملفُّ متصفّح الوِب في `/usr/bin/firefox`. حين تشغّله، ينسخ النظامُ تعليماته إلى الذاكرة، ويخصّص له حصّةً من المعالج والذاكرة، ويبدأ في تنفيذها خطوةً خطوة. هذا الكائنُ الحيّ الجاري — نسخةٌ من البرنامج تعمل فعلًا — اسمه *العمليّة*.

#define("العمليّة (Process)", [
  برنامجٌ قيد التنفيذ: نسخةٌ حيّةٌ منه محمّلةٌ في الذاكرة، لها حصّتها من المعالج، وحالتُها الخاصّة. البرنامجُ الواحد قد تعمل منه عدّةُ عمليّاتٍ مستقلّةٍ في آنٍ (كثلاث نوافذ لمحرّرٍ واحد)، كما تُطبخ الوصفةُ الواحدة في قدورٍ عدّة.
])

ولأنّ عشرات — بل مئات — العمليّات تعمل معًا، يحتاج النظامُ إلى أن يميّز كلَّ واحدةٍ عن أخواتها. فيمنح كلَّ عمليّةٍ عند ولادتها رقمًا فريدًا لا يتكرّر، كرقم التذكرة الذي يأخذه كلُّ طلبٍ في مطبخٍ مزدحم. هذا الرقم اسمه *معرّف العمليّة*:

#define("معرّف العمليّة (PID)", [
  رقمٌ صحيحٌ فريدٌ يمنحه النظامُ لكلّ عمليّةٍ عند بدئها (اختصارُ Process ID). به تشير إلى العمليّة في كلّ أمر: لتراقبها، أو ترفع أولويّتها، أو توقفها. لا تتشارك عمليّتان الرقمَ نفسه في اللحظة ذاتها.
])

لكلّ عمليّةٍ كذلك *أبٌ* أنجبها: فحين شغّلتَ المتصفّحَ من صدفتك، صارت الصدفةُ أبًا للمتصفّح. ومعرّفُ الأب يسمّى `PPID` (الأب Parent). وتتسلسل الأبوّةُ صعودًا حتى تصل إلى عمليّةٍ واحدةٍ هي أمُّ الجميع: أوّلُ عمليّةٍ يبدؤها النظامُ عند الإقلاع، معرّفُها دائمًا `1`، واسمها اليوم `systemd`. منها تنحدر كلُّ عمليّةٍ أخرى، كشجرةٍ جذرُها واحد.

تريد أن ترى معرّف صدفتك أنت في هذه اللحظة؟ الصدفةُ تحفظه في متغيّرٍ خاصٍّ اسمه `$$`:

```bash
echo $$          # يطبع معرّف الصدفة التي تكتب فيها الآن
```

#try-it[
  نفّذ `echo $$` وسجّل الرقم الذي ظهر. ثم أغلق الطرفيّة وافتح نافذةً جديدة، ونفّذه ثانية. لاحظ أنّ الرقم اختلف: كلُّ طرفيّةٍ صدفةٌ مستقلّةٌ بمعرّفٍ خاصّ. أنت الآن ترى نبضةً واحدةً من نبضات نظامك.
]

#section[لمحةٌ ثابتة: الأمر ps]

أوّلُ ما تريده أن ترى ما يعمل. الأمرُ `ps` (اختصار process status) يلتقط *صورةً ثابتة* للعمليّات في لحظة تنفيذه — كأنّك صوّرت المطبخ بكاميرا: تجميدٌ للمشهد لا فيديو متحرّك.

`ps` وحده يعرض عمليّاتِ صدفتك أنت فقط، وهي قِلّة. لرؤية *كلّ* العمليّات في النظام بتفصيلها، الصيغةُ الأشهر — التي تحفظها بيدك — هي `ps aux`:

```bash
ps aux
```

```text
USER   PID  %CPU %MEM    VSZ   RSS TTY   STAT START  TIME COMMAND
root     1   0.0  0.1 168404 11460 ?     Ss   09:14  0:02 /sbin/init
root   412   0.0  0.3 254100 25600 ?     Ss   09:14  0:01 /usr/lib/systemd/...
ghazi 1877   3.4  6.2 3841200 512000 ?   Sl   09:20  1:12 /usr/bin/firefox
ghazi 2402   0.0  0.0  12144  4600 pts/0 Ss   09:31  0:00 bash
ghazi 2560   0.0  0.0  14180  3320 pts/0 R+   09:45  0:00 ps aux
```

#define("ps", [
  أداةٌ تعرض لمحةً ثابتةً عن العمليّات الجارية لحظةَ تنفيذها. الصيغةُ `ps aux` تُظهر كلَّ عمليّات كلّ المستخدمين بتفصيلٍ وافٍ. (الأحرف `aux` هنا على الطراز القديم بلا شَرطة: `a` كلُّ المستخدمين، `u` بتنسيقٍ مفصّل، `x` حتى ما لا طرفيّةَ له.)
])

#subsection[قراءة الأعمدة]

كلُّ سطرٍ عمليّةٌ واحدة، وأعمدتُه تحكي قصّتها:

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 1 { right + horizon } else { center + horizon },
  table.header([العمود], [ما يخبرك به]),
  [`USER`],    [صاحبُ العمليّة — المستخدم الذي يعمل باسمه.],
  [`PID`],     [معرّفها الفريد؛ هذا ما ستستعمله لمخاطبتها.],
  [`%CPU`],    [نسبةُ ما تستهلكه من المعالج الآن.],
  [`%MEM`],    [نسبةُ ما تشغله من الذاكرة الحيّة.],
  [`RSS`],     [حجمُ الذاكرة الفعليّة التي تحتلّها بالكيلوبايت.],
  [`TTY`],     [الطرفيّةُ المرتبطة بها؛ والرمز `?` يعني «بلا طرفيّة» (خدمةٌ تعمل في الخفاء).],
  [`STAT`],    [حالتُها الآن (نشرحها تحت).],
  [`TIME`],    [مجموعُ زمن المعالج الذي استهلكته منذ بدأت.],
  [`COMMAND`], [الأمرُ الذي شغّلها، بمساره وخياراته.],
)

عمودُ `STAT` وحده يستحقّ وقفة، فحرفُه الأوّل يلخّص حياة العمليّة:

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 1 { right + horizon } else { center + horizon },
  table.header([الرمز], [الحالة]),
  [`R`], [تعمل الآن أو تنتظر دورها على المعالج (Running).],
  [`S`], [نائمةٌ تنتظر حدثًا (وصولَ بيانات، ضغطةَ مفتاح) — حالةُ أغلب العمليّات.],
  [`D`], [نومٌ عميقٌ لا يُقاطَع، تنتظر القرص عادةً؛ لا تستجيب مؤقّتًا.],
  [`T`], [موقوفةٌ (مجمّدة) بإشارةٍ، تنتظر من يوقظها.],
  [`Z`], [«زومبي»: انتهت لكنّ أباها لم يلتقط خبرَ موتها بعد.],
)

وقد يلحق بالحرف الأوّل رمزٌ مكمّل: `+` تعني أنها في الواجهة الأماميّة، و `s` أنها قائدةُ جلسة، و `l` أنها متعدّدة الخيوط. في المثال أعلاه، تجد `ps aux` نفسها بحالة `R+`: فهي تعمل الآن (`R`) في الواجهة (`+`)، إذ إنها العمليّة التي صوّرت المشهد وظهرت في صورتها.

#note[
  حالةُ «الزومبي» (`Z`) تبدو مخيفةً باسمها، لكنّها غالبًا غيرُ ضارّة: عمليّةٌ انتهت وتنتظر أباها أن «يدفنها» بقراءة نتيجتها. لا تستهلك معالجًا ولا ذاكرةً تُذكر. تختفي وحدها عادةً؛ ولو تراكمت بكثرة فالمشكلةُ في برنامج الأب لا فيها.
]

#subsection[البحث عن عمليّةٍ بالاسم]

قائمةُ `ps aux` طويلة، وقد تريد معرّفَ برنامجٍ بعينه دون أن تفتّش بعينك. الأمرُ `pgrep` يبحث عن العمليّات باسمها ويعطيك معرّفاتها مباشرة:

```bash
pgrep firefox        # يطبع معرّف (أو معرّفات) كل عملية اسمها firefox
pgrep -a firefox     # مع سطر الأمر كاملًا، لا الرقم وحده
pgrep -u ghazi       # كل عمليات المستخدم ghazi
```

#define("pgrep", [
  أداةٌ تبحث عن العمليّات الجارية بمطابقة اسمها (أو خصائصها) وتطبع معرّفاتها. تريحك من تصفّح `ps` بالعين حين تعرف اسمَ ما تبحث عنه. الخيار `-a` يُظهر سطرَ الأمر كاملًا، و `-u` يحصر البحثَ في مستخدمٍ بعينه.
])

#try-it[
  نفّذ `ps aux` وتأمّل كم عمليّةً تعمل في نظامك «الساكن» ظاهريًّا — ستُدهش من العدد. ثم جرّب `pgrep -a bash`: هل ترى صدفتك أنت بينها؟ قارن الرقمَ الذي يظهر بناتج `echo $$` من القسم السابق.
]

#section[مراقبةٌ حيّة: الأمر top]

`ps` صورةٌ مجمّدة، لكنك أحيانًا تريد *فيديو*: أن ترى العمليّات تتنفّس وتتبدّل لحظةً بلحظة — أيُّها يلتهم المعالج الآن؟ ولماذا تباطأ الجهاز فجأة؟ لهذا وُجد `top`: لوحةٌ حيّةٌ تتجدّد كلَّ ثانيتين تلقائيًّا.

```bash
top
```

```text
top - 09:52:14 up 38 min,  1 user,  load average: 0.42, 0.30, 0.21
Tasks: 214 total,   1 running, 213 sleeping,   0 stopped,   0 zombie
%Cpu(s):  4.7 us,  1.2 sy,  0.0 ni, 93.8 id
MiB Mem :   7842.5 total,   2103.8 free,   3120.4 used,   2618.3 buff/cache

  PID USER    %CPU  %MEM     TIME+ COMMAND
 1877 ghazi   12.3   6.2   1:48.20 firefox
 2560 ghazi    0.7   0.1   0:00.14 top
  412 root     0.0   0.3   0:01.07 systemd-journal
```

#define("top", [
  أداةٌ تعرض العمليّات الأنشطَ وتحدّث القائمة حيًّا كلَّ بضع ثوانٍ، مرتّبةً افتراضيًّا حسب استهلاك المعالج. صدرُها يلخّص صحّة النظام كلّه: عددَ المهامّ، ونسبَ المعالج، والذاكرةَ المستعملة والحرّة.
])

سطرُ `load average` في الأعلى يستحقّ فهمًا: أرقامُه الثلاثة متوسّطُ عدد العمليّات المتزاحمة على المعالج خلال آخر دقيقةٍ، وخمسِ دقائق، وخمسَ عشرة دقيقة. فإن كان لجهازك أربعُ أنوية، فالقيمة `4.0` تعني امتلاءً تامًّا، وما فوقها يعني ازدحامًا وانتظارًا.

`top` تفاعليّ: وأنت داخله تضغط مفاتيح تغيّر العرض حالًا:

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 1 { right + horizon } else { center + horizon },
  table.header([المفتاح], [الأثر]),
  [`P`], [رتّب حسب استهلاك المعالج (الافتراضيّ).],
  [`M`], [رتّب حسب استهلاك الذاكرة — لمعرفة مَن يلتهمها.],
  [`k`], [أوقِف عمليّةً: يسألك عن معرّفها ثم عن الإشارة.],
  [`1`], [افصِل عرضَ كلّ نواةٍ على حدة.],
  [`q`], [اخرج من `top`.],
)

#try-it[
  شغّل `top`، ثم اضغط #kbd("M") لترى مَن أكثرُ العمليّات نهمًا للذاكرة (المتصفّح غالبًا في الصدارة). ثم #kbd("P") للعودة إلى ترتيب المعالج. راقب رقمَ عمليّةٍ يتغيّر أمامك. حين تكتفي اضغط #kbd("q") للخروج. لا شيء يوضّح معنى «العمليّة الحيّة» كمشاهدتها تتنفّس.
]

#section[أجمل وأسهل: الأمر htop]

`top` عمليٌّ لكنّه خشن. وثمّة بديلٌ حديثٌ أوضحُ وأودُّ اسمه `htop`: يلوّن الأعمدة، ويرسم أشرطةً لكلّ نواةٍ وللذاكرة، ويتيح لك التمرير بالأسهم واختيارَ عمليّةٍ بالفأرة، وكلُّ وظائفه معروضةٌ في شريطٍ سفليٍّ من مفاتيح `F`:

```bash
htop
```

- #kbd("F6") لترتيب العمليّات حسب أيّ عمود.
- #kbd("F3") للبحث عن عمليّةٍ بالاسم، و #kbd("F4") لتصفية القائمة.
- #kbd("F5") لعرضها كشجرةٍ تُظهر مَن أنجب مَن (الأب والأبناء).
- #kbd("F9") لإيقاف العمليّة المختارة، و #kbd("F10") للخروج.

#distro[
  `top` مثبّتٌ في كلّ توزيعةٍ تقريبًا، أمّا `htop` فقد تحتاج إلى تثبيته (وتفصيلُ التثبيت في الفصل الثالث عشر):
  - دبيان/أوبونتو: `sudo apt install htop`
  - أرش: `sudo pacman -S htop`
  - فيدورا: `sudo dnf install htop`
]

#tip[
  إن جرّبت `htop` مرّةً واحدة، فقلّما تعود إلى `top`. اجعله أوّلَ ما تفتحه حين يتباطأ جهازك: نظرةٌ واحدةٌ إلى أشرطته الملوّنة تكشف لك في ثانيةٍ أيُّ عمليّةٍ هي الجانية.
]

#section[مخاطبةُ العمليّات: الإشارات]

كيف تقول لعمليّةٍ «توقّفي» أو «أعيدي قراءة إعدادك» وهي لا تملك نافذةً تضغط فيها زرًّا؟ عبر *الإشارات*: رسائلُ قصيرةٌ محدّدةُ المعنى يبعثها النظام إلى العمليّة، فتقاطعها لتقول لها كلمةً واحدة. أنت تُرسل الإشاراتِ كلَّ يومٍ دون أن تدري: حين تضغط #kbd("Ctrl") + #kbd("C") لإيقاف أمرٍ جارٍ، فأنت ترسل إشارةً اسمها `SIGINT`.

#define("الإشارة (Signal)", [
  رسالةٌ قصيرةٌ يبعثها النظام إلى عمليّةٍ ليخبرها بحدثٍ أو يطلب منها تصرّفًا. لكلّ إشارةٍ اسمٌ (يبدأ بـ `SIG`) ورقم. بعضُها يمكن للعمليّة أن تتجاهله أو تتصرّف حياله، وبعضُها الآخر لا يُردّ ولا يُتجاهل.
])

الإشاراتُ كثيرةٌ (تراها كلَّها بـ `kill -l`)، لكن يكفيك في يومك حفنةٌ منها:

#table(
  columns: (auto, auto, 1fr),
  align: (x, y) => if x == 2 { right + horizon } else { center + horizon },
  table.header([الإشارة], [الرقم], [المعنى]),
  [`SIGTERM`], [`15`], [«اطلب منها أن تنتهي بأدب» — تُمهِل العمليّةَ لتحفظ عملها وتغلق. *الافتراضيّة*.],
  [`SIGKILL`], [`9`],  [«اقتلها فورًا» — لا تُمهِل ولا تُناقَش، ولا تستطيع العمليّةُ تجاهلَها.],
  [`SIGINT`],  [`2`],  [مقاطعةٌ لطيفة، هي ما ترسله #kbd("Ctrl") + #kbd("C").],
  [`SIGHUP`],  [`1`],  [«أُغلق طرفُك» أو «أعِد قراءة إعدادك» للخدمات.],
  [`SIGSTOP`], [`19`], [«تجمّدي مكانك» — تُوقف العمليّة، ولا تستطيع تجاهلَها.],
  [`SIGCONT`], [`18`], [«استأنفي» — تُكمل عمليّةً موقوفة.],
)

الفرقُ بين `SIGTERM` و `SIGKILL` هو الدرسُ الأهمّ هنا. الأولى طلبٌ مهذّب: تصل إلى العمليّة فتحفظ ملفّاتها وتغلق اتصالاتها ثم تخرج بسلام — لكنّها قد تختار تأخير الخروج أو تجاهله لو كانت معلّقة. أمّا `SIGKILL` فأمرٌ للنظام نفسه بأن يقتلع العمليّة من الذاكرة فورًا؛ لا تراها العمليّةُ ولا تملك ردًّا، لكنّها تموت دون أن تحفظ شيئًا — وقد تترك خلفها ملفّاتٍ نصفَ مكتوبة.

#section[الإيقاف بالمعرّف: الأمر kill]

الأمرُ `kill` — رغم اسمه المخيف — لا «يقتل» بالضرورة؛ إنما يُرسل إشارةً إلى عمليّةٍ تحدّدها بمعرّفها. وبلا تحديدٍ للإشارة يرسل `SIGTERM` (الطلبَ المهذّب):

```bash
kill 1877          # أرسل SIGTERM إلى العملية 1877 (اطلب منها الخروج بأدب)
kill -9 1877       # أرسل SIGKILL (اقتلها فورًا) — الملاذ الأخير
kill -HUP 1877     # أرسل SIGHUP (أعد قراءة الإعداد)
kill -l            # اعرض قائمة كل الإشارات وأرقامها
```

#define("kill", [
  أداةٌ تُرسل إشارةً إلى عمليّةٍ محدّدةٍ بمعرّفها `PID`. بلا خيارٍ ترسل `SIGTERM` (رقمها `15`). تحدّد الإشارةَ برقمها (`kill -9`) أو باسمها (`kill -KILL` أو `kill -SIGKILL`) — والثلاثةُ سواء.
])

القاعدةُ الذهبيّة: *جرّب المهذّب أوّلًا*. ابدأ دائمًا بـ `kill` وحده (`SIGTERM`)؛ فهو يمنح العمليّة فرصةَ الإغلاق النظيف. لا تلجأ إلى `kill -9` إلا إذا استعصت وتجمّدت تمامًا ولم تستجب.

#warn[
  `kill -9` (أي `SIGKILL`) هو الملاذُ الأخير لا الأوّل. لأنه لا يمهل العمليّةَ لحظةً، فقد يقطعها في منتصف كتابةِ ملفّ فيفسد، أو يترك موارد معلّقة. كثيرٌ من المبتدئين يبدؤون به عادةً؛ والصوابُ أن يكون آخرَ ما تجرّب، بعد أن يخذلك `SIGTERM`.
]

#danger[
  لا ترسل إشاراتٍ إلى عمليّاتٍ لا تعرفها، وبخاصّةٍ عمليّاتِ الجذر أو معرّفاتٍ منخفضةٍ جدًّا. إيقافُ عمليّةِ نظامٍ حسّاسة (أو الرقم `1`) قد يجمّد جلستك أو يُسقط جهازك ويجبرك على إعادة تشغيلٍ قسريّة تفقد فيها عملك. أوقِف ما تملكه وتعرفه فقط.
]

#subsection[الإيقاف بالاسم: killall و pkill]

أحيانًا لا تعرف المعرّف، أو تريد إيقاف *كلّ* نُسخ برنامجٍ دفعةً واحدة. هنا تُوقف بالاسم لا بالرقم، بأداتين متقاربتين:

```bash
killall firefox        # أوقف كل عملية اسمها بالضبط "firefox"
pkill firefox          # أوقف كل عملية يحتوي اسمها "firefox"
pkill -9 firefox       # وبإشارة SIGKILL عند الاستعصاء
```

#define("killall / pkill", [
  أداتان تُرسلان إشارةً إلى العمليّات *بالاسم* بدل المعرّف. الفرقُ الجوهريّ: `killall` يطلب مطابقةً *تامّة* للاسم، بينما `pkill` يطابق أيَّ اسمٍ يحتوي النمطَ الذي أعطيتَه. كلتاهما تفترضان `SIGTERM` ما لم تحدّد غيرَه.
])

#warn[
  انتبه لأثر `pkill` الأوسع: `pkill fire` سيطابق `firefox` وأيَّ برنامجٍ آخر يحتوي «fire» في اسمه، فتوقف ما لم تقصد. جرّب أوّلًا `pgrep fire` لترى ما ستطاله *قبل* أن توقفه. القاعدة: عايِن بـ `pgrep` قبل أن تفتك بـ `pkill`.
]

#try-it[
  شغّل عمليّةً وهميّةً آمنةً تنام مئة ثانيةٍ في الخلفيّة: `sleep 100 &`. سيطبع النظامُ معرّفها. أوقفها أوّلًا بالمعرّف `kill <المعرّف>`، ثم كرّر `sleep 100 &` وأوقفها هذه المرّة بالاسم `pkill sleep`. جرّبتَ الطريقين على عمليّةٍ لا تؤذي شيئًا.
]

#section[المهامّ: الواجهة والخلفيّة]

حتى الآن كلُّ أمرٍ نفّذتَه احتلّ طرفيّتَك حتى ينتهي: هذا هو تشغيلُ *الواجهة الأماميّة* — تنتظر وأنت مشلولُ اليد. لكنّ بعض الأوامر تطول (نسخُ ملفٍّ ضخم، أو خادمٌ يعمل بلا توقّف)، ولا تريد أن تحبس طرفيّتك عليها. الحلُّ أن تدفعها إلى *الخلفيّة*: تعمل صامتةً بينما تستردّ أنت المحثَّ لتكتب غيرها. والمفتاحُ رمزٌ واحدٌ تختم به الأمر: العطف `&`.

#define("المهمّة (Job)", [
  عمليّةٌ (أو سلسلةُ عمليّات) شغّلتها من صدفتك، وتتابعها الصدفةُ برقمٍ صغيرٍ خاصٍّ بها بين قوسين مثل `[1]`. تختلف المهمّةُ عن العمليّة في أنّ ترقيمها محليٌّ في صدفتك أنت، لتديرها بـ `fg` و `bg` و `jobs`.
])

```bash
sleep 300 &        # شغّلها في الخلفية؛ يعود المحث فورًا
```

```text
[1] 2571
```

الرقمُ `[1]` رقمُ المهمّة في صدفتك، و `2571` معرّفُ العمليّة الحقيقيّ. الآن طرفيّتُك حرّةٌ والعمليّةُ تعمل. وتديرها بثلاثة أوامر:

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 1 { right + horizon } else { center + horizon },
  table.header([الأمر], [الوظيفة]),
  [`jobs`],   [يسرد مهامَّ هذه الصدفة وحالتَها (تعمل أم موقوفة).],
  [`fg %1`],  [يُعيد المهمّة `[1]` إلى الواجهة لتنتظرها من جديد.],
  [`bg %1`],  [يستأنف مهمّةً *موقوفة* لتكمل في الخلفيّة.],
)

وبينهما مفتاحٌ مهمّ: #kbd("Ctrl") + #kbd("Z") يُوقف (يجمّد) الأمرَ الجاري في الواجهة ويعيدك إلى المحثّ. عندئذٍ تختار: `bg` ليكمل في الخلفيّة، أو `fg` ليعود كما كان. تخيّل السيناريو: بدأتَ نسخًا طويلًا ونسيتَ العطف `&`، فحبس طرفيّتك — لا تلغِه، بل اضغط #kbd("Ctrl") + #kbd("Z") ثم `bg`، فينزلق إلى الخلفيّة وتسترجع يدك.

#try-it[
  نفّذ `sleep 200` *بلا* عطف، فتُحبس طرفيّتك. اضغط #kbd("Ctrl") + #kbd("Z"): سترى `[1]+ Stopped`. اكتب `jobs` لتراها موقوفة، ثم `bg %1` ليكمل نومَه في الخلفيّة، ثم `jobs` ثانيةً لترى حالتها تبدّلت إلى `Running`. أخيرًا `fg %1` لإعادتها، ثم أوقفها بـ #kbd("Ctrl") + #kbd("C").
]

#subsection[تبقى حيّةً بعد رحيلك: nohup]

في المهامّ الخلفيّة عيبٌ خفيّ: هي مربوطةٌ بصدفتك، فإذا أغلقت الطرفيّة أرسل النظامُ إلى أبنائها الإشارةَ `SIGHUP` (تذكّرها من جدول الإشارات: «أُغلق طرفُك»)، فتموت معها. هذا يزعجك حين تشغّل مهمّةً طويلةً على خادمٍ بعيدٍ ثم تريد قطعَ الاتصال دون أن تقتلها. الحلُّ أن تحصّنها ضدّ تلك الإشارة بـ `nohup`:

```bash
nohup ./نسخة-احتياطية.sh &     # يعمل، ويصمد بعد إغلاق الطرفية
```

#define("nohup", [
  أداةٌ تُشغّل أمرًا محصّنًا ضدّ إشارة `SIGHUP`، فيبقى حيًّا بعد إغلاق الطرفيّة أو قطع الاتصال. لأنه لا طرفيّةَ يطبع فيها، يحوّل `nohup` مخرجاتِ الأمر تلقائيًّا إلى ملفٍّ اسمه `nohup.out` في مجلّدك الحاليّ.
])

#tip[
  اجمع الاثنين معًا: `nohup <أمر> &` هو الوصفةُ المثاليّة لمهمّةٍ طويلةٍ على خادمٍ بعيد — تعمل في الخلفيّة (`&`) وتصمد بعد خروجك (`nohup`). وبعد عودتك، تقرأ ما جرى من ملفّ `nohup.out`.
]

#section[من يتقدّم؟ الأولويّة بـ nice و renice]

حين تتزاحم العمليّاتُ على معالجٍ واحد، مَن يتقدّم؟ يوزّع النظامُ الدورَ حسب *الأولويّة*، ولكلّ عمليّةٍ قيمةٌ اسمُها «اللُّطف» (niceness): كلّما كانت العمليّةُ «ألطفَ» تنازلت عن دورها لغيرها أكثر. القيمةُ تمتدّ من `-20` (أنانيّةٌ قصوى، أعلى أولويّة) إلى `19` (لطفٌ أقصى، أدنى أولويّة)، والافتراضيّ `0`.

#define("اللطف / الأولويّة (niceness)", [
  رقمٌ يحدّد مدى تنازل العمليّة عن المعالج لصالح غيرها. مداه من `-20` (الأعلى أولويّة، الأشدّ إلحاحًا) إلى `19` (الأدنى، الأكثر تنازلًا). الرقمُ الأعلى يعني أولويّةً أدنى — تذكّرها: «كلّما زاد لطفُك، تأخّر دورُك».
])

تبدأ عمليّةً بلطفٍ معيّنٍ بـ `nice`، وتغيّر لطفَ عمليّةٍ *تعمل بالفعل* بـ `renice`:

```bash
nice -n 15 ./مهمة-ثقيلة.sh     # ابدأها بلطف 15 (أولوية منخفضة، لا تزعج غيرها)
renice -n 5 -p 2571            # ارفع لطف العملية 2571 القائمة إلى 5
```

المثالُ العمليّ: تُشغّل عمليّةً ثقيلةً تطول ساعاتٍ (ضغطُ فيديو، مثلًا) ولا تريدها أن تُبطئ عملك اليوميّ. ابدأها بـ `nice -n 15`، فتأخذ المعالجَ حين يفرغ فقط، وتتنحّى فورَ احتياجك إليه، فتُنجَز في الخلفيّة دون أن تشعر بها.

#warn[
  خفضُ اللطف (رفعُ الأولويّة) نحو القيم السالبة يحتاج صلاحيّة الجذر: فلا يستطيع مستخدمٌ عاديٌّ أن يجعل عمليّتَه أشدَّ إلحاحًا من عمليّات غيره. بل حتى على عمليّاتك أنت، تستطيع *رفعَ* اللطف (`0 → 5 → 19`) وحدَه — أي أن تزيد الرقمَ فتخفض أولويّتك — لكن لا تُرجعه إلى الأدنى بعد ذلك؛ فالتنازلُ سهلٌ والاستئثارُ يحتاج إذنًا. لذا `renice -n -5` يحتاج `sudo`.
]

#try-it[
  شغّل `nice -n 10 sleep 200 &`، ثم افتح `top` وابحث عن `sleep`: ستجد في عمود اللطف (`NI`) القيمةَ `10`. جرّب رفعَها أكثر بـ `renice -n 15 -p <المعرّف>` — سينجح. ثم جرّب خفضَها بـ `renice -n 0 -p <المعرّف>` بلا `sudo`، ولاحظ رفضَ النظام. أوقِف العمليّة بعدها بـ `kill`.
]

#section[خلاصة الفصل]

عرفتَ أنّ البرنامج ملفٌّ ساكن، وأنّ العمليّة نسخةٌ منه حيّةٌ في الذاكرة، يميّزها معرّفٌ فريد `PID`، ولها أبٌ تتسلسل أبوّتُه حتى العمليّة `1`. ورأيتَ العمليّاتِ بلمحةٍ ثابتةٍ عبر `ps aux` (بأعمدتها وحالات `STAT`)، وبحثتَ عنها بالاسم بـ `pgrep`، وراقبتها حيّةً بـ `top` وأخيه الأودّ `htop`. ثم تعلّمتَ لغةَ مخاطبتها: *الإشارات* — وميّزتَ `SIGTERM` المهذّبة (الافتراضيّة) عن `SIGKILL` الغاشمة (`kill -9`، الملاذ الأخير) — وأرسلتها بالمعرّف عبر `kill`، وبالاسم عبر `killall` و `pkill` (بعد المعاينة بـ `pgrep`). وأدرتَ المهامّ: دفعتَها إلى الخلفيّة بالعطف `&`، وجمّدتَها بـ #kbd("Ctrl") + #kbd("Z")، ونقلتها بـ `jobs` و `fg` و `bg`، وحصّنتَها ضدّ إغلاق الطرفيّة بـ `nohup`. وأخيرًا ضبطتَ تزاحمها على المعالج بلطف `nice` و `renice`.

بهذا صار النظامُ في يدك حيًّا شفّافًا: ترى نبضَه، وتخاطب عمليّاته، وتوقف المتعطّل، وترتّب أولويّاته. في الفصل التالي ننتقل من *إدارة* ما يعمل إلى *جلب* ما تريد تشغيله: عالمُ مديري الحزم — كيف تثبّت البرامج وتحدّثها وتحذفها في كلّ عائلةٍ من عائلات لِينُكس.

#challenge[
  على جهازٍ آمن: (1) شغّل ثلاثَ مهامَّ خلفيّة `sleep 500 &` وسرِّدها بـ `jobs`. (2) أوقف الأولى بمعرّفها عبر `kill`، والثانية باسمها عبر `pkill sleep` — انتبه: ماذا حدث للثالثة؟ ولماذا؟ (3) شغّل `sleep 300` بلا عطف، جمّدها بـ #kbd("Ctrl") + #kbd("Z")، وأرسلها إلى الخلفيّة بـ `bg`. (4) قبل أن تجرّب، خمّن: أيُّهما أعلى أولويّةً، عمليّةٌ لطفُها `-5` أم عمليّةٌ لطفُها `10`؟ ثم تحقّق: ابدأ الأولى بـ `sudo nice -n -5 sleep 300 &` (القيمةُ السالبة تحتاج الجذر، كما مرّ)، والثانية بـ `nice -n 10 sleep 300 &`، وعايِن قيمتَي `NI` في `top`. (5) أخيرًا أجب بجملة: لماذا يُنصح ببدء الإيقاف بـ `kill` قبل `kill -9`؟
]
