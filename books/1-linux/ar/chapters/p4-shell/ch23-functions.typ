#section[المتغيّرات المحلّية: `local`]

حين يكبر السكربت وتكثر دوالُّه، يقع خطرٌ خفيّ: دالّتان تستعملان متغيّرًا بالاسم نفسه `i` أو `name`، فتدهس إحداهما قيمةَ الأخرى دون أن تدري، لأنّ المتغيّرات في bash *عامّةٌ* بطبيعتها — يراها الجميع ويعدّلها الجميع. العلاج كلمةٌ واحدة: `local`.

#define("المتغيّر المحلّي (local)", [
  متغيّرٌ تُعلنه بـ `local` داخل دالّة، فيعيش داخلها *وحدها* ويموت بخروجها، ولا يمسّ أيَّ متغيّرٍ بالاسم نفسه خارجها. يمنع الدوالَّ من أن تدوس بعضها، ويجعل كلَّ دالّةٍ صندوقًا مغلقًا آمنًا.
])

قارن بين حالتين. بلا `local` يتسرّب متغيّر الدالّة إلى الخارج:

```bash
name="خالد"

change() {
  name="سارة"        # عدّل المتغيّر العامّ نفسه!
}

change
echo "$name"          # يطبع: سارة  (تغيّر من تحتك)
```

والآن بـ `local` تُحبَس القيمةُ داخل الدالّة فلا تُفسد الخارج:

```bash
name="خالد"

change() {
  local name="سارة"   # نسخةٌ محلّيّةٌ خاصّةٌ بالدالّة
  echo "بالداخل: $name"
}

change                # بالداخل: سارة
echo "بالخارج: $name" # بالخارج: خالد  (سالمٌ لم يُمسّ)
```

اجعلها عادةً راسخة: *كلُّ متغيّرٍ تستعمله داخل دالّةٍ أعلِنه `local`*، إلّا ما تقصد مشاركته عمدًا. بهذا تصير كلُّ دالّةٍ مستقلّةً بذاتها، يمكنك نقلُها إلى سكربتٍ آخر دون أن تحمل معها مفاجآت.

#distro[
  كلمة `local` من مزايا bash، وليست جزءًا من معيار POSIX الأدنى. فإن كان سطر صدارتك `#!/bin/sh` (وهي على دبيان وأوبونتو صدفة `dash` المقتصدة)، فقد لا تعمل `local` كما تتوقّع. اجعل الصدارة `#!/bin/bash` صراحةً كلّما استعملتَ `local` أو `$FUNCNAME` أو غيرها من مزايا bash.
]

#section[البناء الكامل: سكربتٌ منظّمٌ بدوالٍّ]

الآن نجمع كلَّ ما سبق في سكربتٍ حقيقيٍّ مرتّب. سنكتب أداةً صغيرةً تفحص مجلّدًا وتخبرنا بعدد عناصره، مبنيّةً على *دوالٍّ صغيرةٍ لكلٍّ منها مهمّةٌ واحدة* — وهذا هو أسلوب المحترفين: دوالٌّ قصيرةٌ واضحة، ودالّةٌ رئيسةٌ `main` تنسّق بينها.

```bash
#!/bin/bash
# report.sh — تقريرٌ مبسّطٌ عن مجلّد، مبنيٌّ بدوالّ

# تطبع رسالةً مسبوقةً بالوقت
log() {
  echo "[$(date +%H:%M:%S)] $1"
}

# تتحقّق أنّ الوسيط مجلّدٌ موجود
require_dir() {
  if [[ ! -d "$1" ]]; then
    log "ليس مجلّدًا موجودًا: $1"
    return 1
  fi
  return 0
}

# تُرجع عدد العناصر في المجلّد (بيانٌ، لا حالة)
count_items() {
  local dir="$1"
  local n
  n=$(ls -1 "$dir" | wc -l)
  echo "$n"
}

# الدالّة الرئيسة: تنسّق العمل
main() {
  local target="$1"

  if [[ -z "$target" ]]; then
    log "الاستعمال: report.sh <مجلد>"
    exit 1
  fi

  require_dir "$target" || exit 1

  local total
  total=$(count_items "$target")
  log "المجلّد $target يحوي $total عنصرًا"
}

main "$@"          # مرّر وسائط السكربت كلَّها إلى main
```

اقرأ السطر الأخير بتأنٍّ: `main "$@"` يستدعي الدالّة الرئيسة ويمرّر إليها *كلَّ وسائط السكربت* بأمانةٍ عبر `"$@"`. فحين تشغّل `bash report.sh /etc`، يصل `/etc` إلى `main` بوصفه `$1`، ومنها إلى الدوالّ الأخرى. لاحظ كيف تعاونت كلُّ الأفكار: `require_dir` تُرجع *حالةً* (`return`) فنستعملها في `|| exit 1` أي «إن فشلت فأنهِ السكربت»، بينما `count_items` تُرجع *بيانًا* (`echo`) نلتقطه بـ `$(...)`. وكلُّ متغيّراتها `local` فلا تتصادم. شغّله:

#session("bash report.sh /etc", output: "[14:07:33] المجلّد /etc يحوي 221 عنصرًا")

هذا الترتيب — دوالٌّ صغيرةٌ مسمّاةٌ ودالّةُ `main` في الأسفل تستدعيها — هو هيكل السكربتات الاحترافيّة. تقرؤه فتفهم القصّة من `main` نزولًا، وتصلح أيّ جزءٍ في مكانه دون أن تخشى على البقيّة.

#tip[
  اجعل كلَّ دالّةٍ تفعل *شيئًا واحدًا* يُفهَم من اسمها. الدالّة التي طال جسمُها حتى لا تراها في شاشةٍ واحدة تستحقّ أن تُقسَّم إلى دالّتين. الاسمُ الواضح خيرٌ من تعليقٍ طويل: `require_dir` تشرح نفسها بنفسها.
]

#try-it[
  وسّع `report.sh`: أضف دالّةً جديدةً `dir_size` تطبع حجم المجلّد (تلميح: `du -sh "$1"`)، ونادِها من `main` بعد سطر العدد. ثم أضف في `main` تحقّقًا: إن كان `$#` أكبر من واحد، سجّل تحذيرًا بأنّ الوسائط الزائدة ستُهمَل. شغّله على مجلّداتٍ مختلفة وتأكّد أنّ رسائل `log` تظهر بأوقاتها.
]

#deep[
  دقّةٌ للمتقدّم: كتبنا `local n` ثم `n=$(...)` في سطرين لا سطرٍ واحد. لِمَ؟ لأنّ `local n=$(cmd)` في سطرٍ واحدٍ يجعل قيمةَ خروج `$?` هي حالةَ `local` نفسها (تنجح دائمًا) لا حالةَ `cmd`، فتضيع منك معرفةُ هل فشل الأمر أم لا. فصلُ الإعلان عن الإسناد يحفظ قيمة خروج الأمر سليمةً حين تحتاج فحصها.
]

#section[خلاصة الفصل]

تعلّمتَ أن تصنع أفعالك بيدك: تُعرّف *دالّةً* بـ `name() { ... }` وتستدعيها باسمها، فتضيف إلى لغة الصدفة كلمةً من عندك. وتغذّيها بـ *الوسائط* تقرؤها بالداخل عبر `$1` و`$2`، وتعرف عددها بـ `$#`، وتجمعها بـ `"$@"`، وتذكّرتَ أنّ `$0` يبقى اسمَ السكربت لا الدالّة. وأدركتَ *قيمة الخروج* (`$?`): الصفر نجاحٌ وغيرُه فشل، وأنّ `return` تُرجع حالةً وتخرج من الدالّة، بينما `echo` + `$(...)` تُرجع بيانًا، وأنّ `exit` تُنهي السكربت كلَّه لا الدالّة وحدها. وحميتَ متغيّراتك بـ `local`، وبنيتَ سكربتًا منظّمًا بدالّة `main` تنسّق دوالَّ صغيرة. بهذا صارت سكربتاتك بناءً لا كومةً. في الفصل التالي نأخذ هذه اللبنات ونؤلّف بها *سكربتاتٍ واقعيّةً* تحلّ مسائل حقيقيّةً من يومك.

#challenge[
  اكتب سكربتًا `greeter.sh` مبنيًّا بالكامل بدوالّ. عرّف: دالّةً `usage` تطبع طريقة الاستعمال وتُنهي بـ `exit 1`؛ ودالّةً `is_valid` تأخذ اسمًا وتُرجع `return 0` إن كان غيرَ فارغٍ و`return 1` إن كان فارغًا؛ ودالّةً `build_greeting` تأخذ اسمًا وتطبع (بـ `echo`) جملةَ ترحيبٍ لطيفة. ثم دالّة `main` تفعل التالي: إن كان `$#` صفرًا فنادِ `usage`؛ وإلّا فتحقّق بـ `is_valid "$1"`، فإن صحّ التقط ناتج `build_greeting "$1"` في متغيّرٍ محلّيٍّ واطبعه، وإلّا فاطبع رسالةَ خطأٍ وأنهِ بـ `exit 2`. اختم السكربت بـ `main "$@"`. جرّبه باسمٍ، وبلا وسائط، وتحقّق من `$?` في كلّ حالة. إن نجح، فقد صرتَ تكتب السكربتات كما يكتبها المحترفون.
]
