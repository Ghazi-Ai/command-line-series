// الفصل السابع: أن تساعد نفسك
#import "/lib/book.typ": chapter, section, subsection
#import "/lib/components.typ": note, tip, warn, danger, distro, try-it, define, challenge, objectives, kbd, session

#chapter[أن تساعد نفسك]

#objectives((
  [تقرأ صفحة الدليل `man` وتفهم بنيتها وأقسامها التسعة.],
  [تتنقّل داخل الدليل وتبحث فيه عن كلمةٍ بلمحة عين.],
  [تستخرج المساعدة السريعة بـ `--help` و `tldr`، وتفتّش عن أمرٍ نسيتَ اسمه بـ `apropos`.],
  [تعرف من أين يأتي أمرٌ ما عبر `type` و `which`، وتوثّق أوامر الصدفة بـ `help`.],
  [تبني لنفسك منهجيّةً تجد بها الجواب وحدك، دون سؤال أحد.],
))

تخيّل أنك اشتريتَ جهازًا منزليًّا معقّدًا — غسّالةً بعشرات الأزرار. لن تتّصل بالمصنع كلّما احترتَ في زر؛ فالجهاز جاء ومعه *كُتيّب إرشادات* يشرح كلَّ زرٍّ ووظيفته. لِينُكس أكرم من ذلك: كلُّ أمرٍ فيه يحمل كُتيّبه في جيبه، جاهزًا في أيّ لحظةٍ دون إنترنت. مَن يتعلّم فتح هذه الكتيّبات يصير مستقلًّا؛ لا ينتظر جوابًا من أحد، بل يجده بنفسه. هذا الفصل ليس عن أمرٍ جديد، بل عن أثمن مهارةٍ في الرحلة كلّها: أن تساعد نفسك.

#section[الدليل الكامل: الأمر man]

في قلب كلّ نظام لِينُكس تقبع مكتبةٌ صامتة: صفحاتٌ مرجعيّةٌ مكتوبةٌ بعناية لكلّ أمرٍ وملفٍّ وإعداد. تُسمّى *صفحات الدليل* (Manual Pages)، وبوّابتها أمرٌ واحد اسمه `man` (اختصار Manual، أي الدليل).

#define("صفحة الدليل (man page)", [
  وثيقةٌ مرجعيّةٌ رسميّةٌ تأتي مرفقةً مع الأمر نفسه، تشرح ماذا يفعل، وكلَّ خياراته، وأمثلةً على استعماله. هي المصدر الأدقّ والأحدث دائمًا، لأنّ كاتب الأمر هو من كتبها.
])

لنقرأ دليل أمرٍ نعرفه من فصلٍ سابق، وهو `ls`:

```bash
man ls
```

تفتح لك صفحةٌ كاملةٌ تملأ الشاشة. لا تُذعر من طولها؛ لكلّ صفحة بنيةٌ ثابتةٌ تتكرّر، فمتى ألِفتَها قرأتَ أيَّ دليلٍ في ثوانٍ. أبرز أقسامها:

- `NAME` — اسم الأمر وجملةٌ تلخّص وظيفته.
- `SYNOPSIS` — صيغة الاستعمال: الفعل وخياراته ومُعطياته بترتيبها.
- `DESCRIPTION` — الشرح المفصّل، وفيه سردٌ لكلّ خيارٍ ومعناه.
- `EXAMPLES` — أمثلةٌ جاهزة (لا توجد في كلّ صفحة، لكنها كنزٌ حين توجد).
- `SEE ALSO` — أوامر ذات صلة، تقودك إلى ما يكمّل حاجتك.

#note[
  في `SYNOPSIS` تعني الأقواس المربّعة `[..]` أنّ ما بداخلها *اختياريّ*، والشرطة العموديّة `|` تعني «أو» (اختَر أحد البدائل). هذا عُرفٌ ثابتٌ في كلّ صفحات الدليل، فاحفظه مرّةً واحدة.
]

#try-it[
  افتح `man ls` الآن. اقرأ سطر `NAME`، ثم انزل إلى `DESCRIPTION` وابحث عن معنى الخيار `-h`. حين تنتهي، اضغط `q` للخروج. لا تكتفِ بالنظر — تجوّل في الصفحة بيدك.
]

#subsection[التنقّل داخل الدليل]

`man` لا يعرض الصفحة دفعةً واحدة، بل يسلّمها إلى *عارضٍ تفاعليّ* (Pager) يعرضها صفحةً صفحة، اسمه غالبًا `less`. وهذا يعني أنّ التحكّم كلَّه بلوحة المفاتيح:

#define("العارض التفاعليّ (Pager)", [
  برنامجٌ يعرض نصًّا أطول من الشاشة على دفعات، ويتيح لك التنقّل صعودًا ونزولًا والبحث فيه. `man` يستعمله تلقائيًّا كي لا يفرّ النصّ أمام عينيك.
])

أهمّ مفاتيح التنقّل:

- #kbd("Space") تنزل شاشةً كاملة، و #kbd("b") تصعد شاشةً كاملة.
- #kbd("↓") و #kbd("↑") تتحرّك سطرًا سطرًا.
- #kbd("g") يقفز إلى أوّل الصفحة، و #kbd("G") إلى آخرها.
- #kbd("q") يُغلق الدليل ويعيدك إلى المحثّ.

أمّا الجوهرة فهي البحث: اكتب `/` متبوعةً بكلمةٍ ثم #kbd("Enter")، فيقفز بك إلى أوّل موضعٍ ظهرت فيه. اضغط #kbd("n") للانتقال إلى الموضع التالي، و #kbd("N") (بحرفٍ كبير) للرجوع إلى السابق. تخيّل أنك تريد معنى الخيار `-t` في `ls`:

```bash
man ls
# داخل الدليل، اكتب:
/-t
# ثم Enter، ثم n للنتيجة التالية
```

#tip[
  هذا البحث بـ `/` و #kbd("n") ليس خاصًّا بـ `man` وحده، بل هو من صميم العارض `less`. المهارة نفسها تعمل حين تفتح أيّ ملفٍّ طويلٍ بـ `less`. تتعلّمها مرّةً، فتنفعك في عشرات المواضع.
]

#try-it[
  افتح `man ls`، واكتب `/sort` ثم #kbd("Enter")، وتنقّل بين النتائج بـ #kbd("n"). كم مرّةً وردت كلمة sort؟ اخرج بـ #kbd("q").
]

#subsection[أقسام الدليل التسعة]

هنا سرٌّ يجهله كثيرون. صفحات الدليل مقسّمةٌ إلى تسعة أقسامٍ مرقّمة، لأنّ الاسم الواحد قد يخصّ شيئين مختلفين: أمرًا تكتبه، وملفَّ إعداداتٍ يحمل الاسم نفسه. الأقسام:

- ‏١ — الأوامر التي ينفّذها المستخدم العاديّ.
- ‏٢ — نداءات النظام (وظائف النواة، للمبرمجين).
- ‏٣ — دوالّ المكتبات البرمجيّة (للمبرمجين).
- ‏٤ — الملفّات الخاصّة (أجهزة `‎/dev`).
- ‏٥ — صيغ الملفّات وملفّات الإعداد.
- ‏٦ — الألعاب.
- ‏٧ — المتنوّعات والأعراف والمعايير.
- ‏٨ — أوامر إدارة النظام (لمدير الجهاز).
- ‏٩ — إجراءات النواة الداخليّة.

المثال الكلاسيكيّ: `passwd` أمرٌ يغيّر كلمة المرور (القسم ١)، و `passwd` أيضًا اسم ملفٍّ يخزّن حسابات المستخدمين (القسم ٥). لتطلب القسم المحدّد، ضع رقمه قبل الاسم:

```bash
man 1 passwd        # دليل الأمر: كيف تغيّر كلمة المرور
man 5 passwd        # دليل الملف: بنية /etc/passwd وحقوله
```

حين ترى في كتابٍ أو موقعٍ إشارةً مثل `printf(3)`، فالرقم بين القوسين يخبرك بالقسم: هنا دالّة المكتبة، لا أمر الطرفية `printf(1)`. صار الرمز مفهومًا الآن.

#note[
  إن كتبتَ `man passwd` دون رقم، أعطاك `man` أوّل قسمٍ يجد فيه الاسم (القسم ١ عادةً). ولترى كلَّ الأقسام التي تحمل الاسم تباعًا، استعمل `man -a passwd`: يعرض واحدةً تلو الأخرى.
]

#section[المساعدة السريعة: الخيار `--help`]

فتحُ الدليل الكامل رائعٌ حين تريد التعمّق، لكنك أحيانًا تحتاج تذكيرًا خاطفًا: «ما الخيار الذي يعرض الحجم بصيغةٍ مقروءة؟». لهذا وُجد الخيار `--help`. أغلب الأوامر الحديثة تفهمه، فتطبع ملخّصًا موجزًا لخياراتها ثم تعود بك إلى المحثّ فورًا — بلا عارضٍ ولا تنقّل.

```bash
ls --help
```

يسرد لك الأمرُ خياراته في شاشةٍ أو اثنتين. الفرق عن `man`: `--help` سريعٌ ومختصرٌ يخرج تلقائيًّا، و `man` أعمق وأشمل ويحتاج `q` للخروج. استعمل `--help` للتذكير، و `man` للفهم.

#tip[
  لو كان ناتج `--help` أطول من الشاشة وفرّ أمام عينيك، مرّره إلى عارض: اكتب `ls --help | less`، فتقرأه على مهلٍ بالمفاتيح نفسها التي تعلّمتها. سنشرح الرمز `|` (الأنبوب) في فصلٍ لاحق؛ يكفيك الآن أنه «يمرّر الناتج إلى برنامجٍ آخر».
]

#warn[
  ليست كلُّ الأوامر تفهم `--help` بشرطتين. بعض الأدوات القديمة تستعمل `-h` أو `-?` بدلًا منها، وقليلٌ منها لا يقبل إلّا `man`. إن أعطاك `--help` خطأً، جرّب `-h`، فإن فشل فارجع إلى `man`.
]

#try-it[
  نفّذ `mkdir --help`، واقرأ ماذا يفعل الخيار `-p`. ثم نفّذ `man mkdir` وابحث عن الخيار نفسه بـ `/-p`. لاحظ الفرق في العمق بين المصدرين.
]

#section[دليلٌ يتفرّع كالشجرة: الأمر info]

بعض أدوات مشروع جنو (GNU) تأتي بدليلٍ أوسع من صفحة `man`، اسمه `info`. هو نصٌّ مترابطٌ كصفحات الوِب: تنتقل بين *عُقده* (Nodes) عبر روابط، فتقرأ كتابًا صغيرًا لا صفحةً واحدة.

```bash
info coreutils
```

التنقّل فيه يختلف قليلًا: #kbd("n") تذهب إلى العقدة التالية، و #kbd("p") إلى السابقة، و #kbd("u") تصعد إلى العقدة الأعلى، و #kbd("Enter") تتبع الرابط الذي عند المؤشّر، و #kbd("q") تخرج.

#note[
  للمبتدئ، `man` و `--help` يكفيان في تسعٍ من كلّ عشر حالات. لا تُثقِل نفسك بـ `info` الآن؛ يكفي أن تعرف بوجوده كي لا يفاجئك حين تُحال إليه في وثيقة. متى احتجتَ تعمّقًا في أدوات جنو، تذكّر أنّ بابه مفتوح.
]

#distro[
  قارئ `info` قد لا يكون مثبّتًا في التوزيعات المصغّرة. إن ردّ النظام بـ `command not found`، ثبّته: على دبيان/أوبونتو `sudo apt install info`، وعلى فيدورا `sudo dnf install info`، وعلى أرش `sudo pacman -S texinfo` (فاسم الحزمة عندها هو `texinfo`).
]

#section[لا أعرف اسم الأمر أصلًا: apropos و whatis]

كلُّ ما سبق يفترض أنك تعرف *اسم* الأمر. لكن ماذا لو كنتَ تعرف *الحاجة* وتجهل الاسم؟ «أريد أمرًا يعرض استهلاك الذاكرة... ما اسمه؟». هنا يلمع أمران توأمان.

`apropos` يبحث بكلمةٍ مفتاحيّةٍ في عناوين كلّ صفحات الدليل، فيعطيك قائمةً بكلّ أمرٍ له صلة:

```bash
apropos memory
```

فتظهر لك أسطرٌ مثل `free (1) - Display amount of free and used memory`، فتلتقط الاسم الذي تريد. أمّا توأمه `whatis` فيعمل عكسيًّا: تعطيه اسمًا يعرفه فيردّ بالجملة الواحدة التي تلخّص وظيفته:

```bash
whatis free
# free (1) - Display amount of free and used memory in the system
```

#define("قاعدة الفهرسة (mandb)", [
  `apropos` و `whatis` لا يفتّشان الصفحات كلَّها في كلّ مرّة — ذلك بطيء. بل يقرآن فهرسًا جاهزًا يُبنى مسبقًا. يُبنى هذا الفهرس بالأمر `mandb`، ويحدّثه النظام دوريًّا من تلقاء نفسه.
])

#warn[
  إن ردّ `apropos` أو `whatis` بـ `nothing appropriate`، فالسبب غالبًا أنّ الفهرس لم يُبنَ بعد (نظامٌ حديث التثبيت مثلًا). ابنِه يدويًّا مرّةً واحدة: `sudo mandb`، ثم أعِد المحاولة. الأمران في جوهرهما اختصاران لـ `man -k` (أي apropos) و `man -f` (أي whatis).
]

#try-it[
  جرّب `apropos "list directory"` وتأمّل النتائج — هل يظهر `ls` بينها؟ ثم اسأل `whatis cd` و `whatis mkdir`. أيُّ جملةٍ لخّصت الأمر أفضل؟
]

#section[أمثلةٌ عمليّةٌ في لمح البصر: tldr]

صفحات `man` دقيقةٌ وشاملة، لكنها أحيانًا مرهقةٌ حين تريد فقط «كيف أضغط مجلّدًا في ملفّ tar؟» دون قراءة ثلاث صفحاتٍ من الخيارات. لهذا وُلدت `tldr`: صفحاتٌ مجتمعيّةٌ مبسّطة، تعرض *الأمثلة الأكثر شيوعًا* لكلّ أمرٍ في بضعة أسطر.

#define("tldr", [
  اختصار «Too Long; Didn't Read» (أطول من أن يُقرأ). أداةٌ تعرض أمثلةً عمليّةً جاهزةً للنسخ لأشهر استعمالات أيّ أمر، بديلًا خفيفًا وسريعًا عن قراءة الدليل الكامل.
])

```bash
tldr tar
```

فتحصل على أمثلةٍ مباشرة: «فُكّ ضغط ملف»، «اضغط مجلّدًا»، كلٌّ مع الأمر الجاهز تحته. هي أوّل ما تلجأ إليه حين تعرف الأمر وتريد صيغة استعماله فورًا، دون الغوص في التفاصيل.

#note[
  `tldr` ليست بديلًا عن `man` بل مكمّلةً لها. `tldr` تجيب «كيف أستعمله بسرعة؟»، و `man` تجيب «ماذا يفعل كلُّ خيارٍ فيه بالتفصيل؟». الخبير يستعمل الاثنتين، كلًّا في موضعها.
]

#distro[
  `tldr` ليست مثبّتةً افتراضيًّا، وتحتاج تثبيتًا. عميلها السريع اسمه `tealdeer`، وهو ما نثبّته على التوزيعات الثلاثة: على دبيان/أوبونتو `sudo apt install tealdeer`، وعلى أرش `sudo pacman -S tealdeer`، وعلى فيدورا `sudo dnf install tealdeer`. (لاحظ أنّ اسم الحزمة `tealdeer` بينما اسم الأمر بعد التثبيت يبقى `tldr`.) بعد التثبيت، حمّل قاعدة الصفحات أوّل مرّة بـ `tldr --update` (فهي تعمل دون إنترنت بعدها).
]

#try-it[
  إن كانت `tldr` مثبّتةً، جرّب `tldr cp` و `tldr mkdir`. قارن: أيُّهما أسرع في إعطائك ما تريد — `tldr cp` أم قراءة `man cp` كاملًا؟
]

#section[من أين يأتي هذا الأمر؟ which و type]

حين تكتب `ls` وتضغط #kbd("Enter")، من أين تأتي الصدفة بهذا الأمر؟ ولماذا يعمل `ls` من أيّ مجلّدٍ كنتَ فيه؟ أداتان تجيبان.

`which` يخبرك بمسار الملفّ التنفيذيّ للأمر على القرص (باحثًا عنه في مسارات النظام المعروفة، وهي قائمةٌ اسمها `PATH` نعود إليها في جزءٍ لاحق):

```bash
which ls
# /usr/bin/ls
```

فهذا يكشف أنّ `ls` برنامجٌ حقيقيٌّ يقبع في `‎/usr/bin`. لكنّ `type` — وهو أداةٌ مدمجةٌ في الصدفة — أذكى وأشمل: يميّز بين البرنامج، والأمر المدمج في الصدفة، والاسم المستعار (Alias) — وهو لقبٌ مختصرٌ تجعله الصدفة يشير إلى أمرٍ أطول، كأن يصير `ls` مختصرًا لـ `ls --color=auto`:

```bash
type ls
# ls is aliased to `ls --color=auto`
type cd
# cd is a shell builtin
type type
# type is a shell builtin
```

لاحظ المفاجأة: `cd` ليس برنامجًا في القرص، بل *أمرٌ مدمجٌ* داخل الصدفة نفسها. لهذا لا يعثر له `which` على مسارٍ أحيانًا، بينما `type` يفهم طبيعته.

#define("الأمر المدمج (builtin)", [
  أمرٌ منفّذٌ داخل الصدفة ذاتها، لا برنامجًا مستقلًّا على القرص. أمثلته `cd` و `echo` و `type`. الصدفة تنفّذه بنفسها فورًا دون البحث عنه في النظام.
])

#tip[
  حين تحتار «هل هذا الأمر برنامجٌ أم مدمجٌ أم اسمٌ مستعار؟» فـ `type` هو الحَكَم. واستعمل `type -a اسم` لترى *كلَّ* التعريفات معًا: الاسم المستعار، والمدمج، والبرنامج، إن وُجدت جميعًا لاسمٍ واحد.
]

#subsection[توثيق الأوامر المدمجة: help]

وهنا مأزقٌ يقع فيه المبتدئ: يجرّب `man cd` فيُحبَط، إذ لا يجد صفحةً مفيدة. السبب أنّ `cd` مدمجٌ في الصدفة، والأوامر المدمجة لا تملك صفحات `man` مستقلّة. لتوثيقها أداةٌ خاصّة اسمها `help`:

```bash
help cd
help type
help help
```

فتحصل على شرح الأمر المدمج وخياراته. القاعدة البسيطة: إن قال لك `type` إنّ الأمر `builtin`، فوثّقه بـ `help` لا بـ `man`.

#try-it[
  نفّذ `type echo` ثم `type pwd`. أهما مدمجان أم برنامجان؟ ثم استعمل `help` أو `man` (حسب جواب `type`) لتقرأ توثيق كلٍّ منهما. لاحظ كيف يوجّهك `type` إلى الأداة الصحيحة.
]

#section[منهجيّة: كيف تجد الجواب وحدك؟]

الأدوات وحدها لا تكفي؛ المهارة في *ترتيب* استعمالها. حين تقف أمام مشكلةٍ في الطرفية، اسلك هذا السلّم بالترتيب، فأنت في الغالب لن تحتاج الإنترنت البتّة:

- ‏١) *أعرف الأمر وأريد مثالًا سريعًا؟* → `tldr الأمر`.
- ‏٢) *أريد تذكيرًا بخيارٍ معيّن؟* → `الأمر --help`.
- ‏٣) *أريد الفهم العميق والدقيق؟* → `man الأمر`، وابحث داخله بـ `/`.
- ‏٤) *لا أعرف اسم الأمر أصلًا؟* → `apropos كلمة‑مفتاحية`.
- ‏٥) *أخبرني `type` أنه مدمج؟* → `help الأمر`.

هذا السلّم يحوّلك من متلقٍّ ينتظر الجواب، إلى باحثٍ يصنعه. ومع الوقت تصير قراءة `man` عادةً لا عبئًا، ويصير كلُّ أمرٍ جديدٍ بابًا تفتحه بنفسك.

#tip[
  حتى `man` نفسه له `man`. جرّب `man man` لتتعمّق في خيارات الدليل، و `man --help` لملخّصٍ سريع. الأدوات في لِينُكس توثّق نفسها بنفسها — وهذه هي روح استقلالك.
]

#section[خلاصة الفصل]

تعلّمتَ في هذا الفصل أثمن مهارة: أن تُجيب نفسك بنفسك. عرفتَ أنّ `man` هو الدليل الكامل بأقسامه التسعة، وأنّك تتنقّل فيه وتبحث بـ `/` و #kbd("n")، وتخرج بـ #kbd("q"). ورأيتَ أنّ `--help` تذكيرٌ سريع، و `info` دليلٌ متفرّع، و `tldr` أمثلةٌ خاطفة. وحين يغيب عنك اسم الأمر يجده `apropos`، ويلخّصه `whatis`. وعرفتَ من أين تأتي الأوامر عبر `which` و `type`، وأنّ المدمجة منها توثّقها `help` لا `man`. وفوق ذلك كلّه، بنيتَ سلّمًا منهجيًّا تصعد به إلى الجواب وحدك. في الفصل التالي ننتقل من *قراءة* المساعدة إلى *كتابة* أوامرك بثقة، وربطِ بعضها ببعض لتؤدّي عملًا أكبر من مجموع أجزائه.

#challenge[
  دون فتح الإنترنت، أجب عمليًّا: (١) استعمل `apropos` لتجد أمرًا يعرض «التقويم» (تلميح: جرّب كلمة `calendar`)، ثم شغّله. (٢) افتح `man` للأمر الذي وجدتَه، وابحث داخله عن كيفية عرض سنةٍ كاملة. (٣) نفّذ `type cal` و `which cal`: أبرنامجٌ هو أم مدمج؟ (٤) أخيرًا، خمّن ماذا يفعل `man 5 crontab` قبل أن تفتحه، ثم افتحه: أهو دليل أمرٍ أم دليل ملفّ إعداد؟ اكتب ما تعلّمتَه في جملةٍ واحدة.
]
