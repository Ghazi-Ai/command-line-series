  [`pkg stats`], [إحصاءاتٌ: عدد المثبَّت والمساحة المستهلكة.],
)

#section[الصيانة والتدقيق الأمنيّ]

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 0 { center + horizon } else { right + horizon },
  table.header([الأمر], [الوظيفة]),
  [`pkg clean`], [احذف الحزم المخزّنة مؤقّتًا لتوفير المساحة.],
  [`pkg clean -a`], [نظّف الذاكرة المؤقّتة كاملةً.],
  [`pkg audit -F`], [اجلب قاعدة الثغرات وافحص المثبَّت أمنيًّا.],
  [`pkg check -d NAME`], [تأكّد من اكتمال اعتمادات الحزمة.],
  [`pkg check -s NAME`], [تحقّق من سلامة ملفّات الحزمة بالبصمة.],
)

#warn[
  اعتَدْ `pkg audit -F` دوريًّا (أو اجعله مهمّةً في `periodic`)؛ فهو يخبرك إن كان في المثبَّت لديك برنامجٌ اكتُشفت فيه ثغرةٌ أمنيّةٌ معلَنة، وهو من أبسط ما يرفع أمنَ خادمك.
]

#section[شجرة ports: البناء من المصدر]

حين تحتاج خيارَ بناءٍ لا توفّره الحزمة الجاهزة (كتفعيل ميزةٍ أو نزع اعتماد)، تلجأ إلى شجرة ports. أوّلًا تجلبها، ثم تدخل مجلّد البرنامج وتبنيه.

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 0 { center + horizon } else { right + horizon },
  table.header([الأمر], [الوظيفة]),
  [`git clone https://git.FreeBSD.org/ports.git /usr/ports`], [اجلب شجرة ports (الطريقة الحديثة).],
  [`cd /usr/ports/CAT/NAME`], [ادخل مجلّد المنفَذ (مثل `/usr/ports/editors/vim`).],
  [`make config`], [اختر خيارات البناء من قائمةٍ تفاعليّة.],
  [`make install clean`], [ابنِ البرنامج وثبّته ثم نظّف ملفّات البناء.],
  [`make deinstall`], [أزِل ما بُني من هذا المنفَذ.],
  [`make search name=NAME`], [ابحث عن منفَذٍ في الشجرة باسمه.],
)

#note[
  الأداةُ `portsnap` القديمة لجلب الشجرة أُزيلت في FreeBSD 14، والمعتمَدُ الآن `git`. ولترقية ما بُنيَ من المصدر أدواتٌ مساعِدةٌ من الحزم مثل `portmaster` و`ports-mgmt/portupgrade`. وتذكّر: البناء من المصدر أبطأُ بكثيرٍ من `pkg`، فلا تلجأ إليه إلّا لحاجة.
]

#distro[
  على OpenBSD لا `pkg` بل عائلةٌ من الأوامر: التثبيت `pkg_add NAME`، والإزالة `pkg_delete NAME`، والاستعلام `pkg_info`، والبحث `pkg_info -Q NAME`، والترقية `pkg_add -u`. وتُضبط مرآةُ الحزم بمتغيّر البيئة `PKG_PATH` أو ملفِّ `/etc/installurl`. أمّا NetBSD فمنظومتُه `pkgsrc` المحمولةُ وأداتُها `pkgin` (`pkgin install NAME`).
]
