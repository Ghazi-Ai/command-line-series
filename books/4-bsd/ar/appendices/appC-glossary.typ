#section[عائلة BSD: النظام والفروع]

#gloss(
  [بي إس دي], [BSD], [توزيعة بِركلي للبرمجيّات؛ فرعٌ عريقٌ من يونِكس وُلد بجامعة كاليفورنيا، ومنه انحدرت الفروع الأربعة الحديثة.],
  [فري بي إس دي], [FreeBSD], [أشهر فروع BSD وأوسعها انتشارًا خادميًّا، ومحورُ هذا الكتاب؛ يوازن بين الأداء وسعة العتاد.],
  [أوبن بي إس دي], [OpenBSD], [فرعٌ يجعل الأمن والتدقيق أولويّةً قصوى؛ منه وُلدت `pf` و`OpenSSH` و`doas`.],
  [نت بي إس دي], [NetBSD], [فرعٌ يجعل قابليّة النقل غايتَه: يعمل على أكبر عددٍ من المعماريّات، ومنظومةُ حزمه `pkgsrc`.],
  [دراغون فلاي], [DragonFly BSD], [فرعٌ انشقّ عن FreeBSD متّجهًا إلى تصميمٍ مختلفٍ للتوازي ونظام ملفّاته HAMMER.],
  [النواة], [Kernel], [قلب النظام الذي يخاطب العتاد ويدير الذاكرة والعمليّات؛ في BSD تُبنى مع الأدوات من مصدرٍ واحد.],
  [النظام الأساس], [Base System], [النواةُ والأدواتُ الأساسيّة والوثائق، تُطوَّر وتُصدَر كقطعةٍ واحدةٍ متماسكة — أبرزُ ما يميّز BSD عن لِينُكس.],
  [فضاء المستخدم], [Userland], [كلُّ ما يعمل خارج النواة من أوامرَ ومكتباتٍ وبرامج؛ في BSD جزءٌ من النظام الأساس نفسِه.],
  [العفريت], [Daemon], [برنامجٌ يعمل في الخلفيّة بلا واجهةٍ يخدم النظام؛ وشعارُ BSD عفريتٌ صغيرٌ لطيفٌ اسمه Beastie.],
  [معيار بوزكس], [POSIX], [مواصفةٌ تحدّد سلوك واجهات يونِكس وأوامره، فتضمن نقل السكربتات بين الأنظمة المطابِقة لها.],
)

#section[الصدفة والطرفية]

#gloss(
  [الصدفة], [Shell], [البرنامج الذي يقرأ أوامرك ويشغّلها؛ الافتراضيّ في FreeBSD `sh` للسكربتات و`tcsh` للجذر تفاعليًّا.],
  [إس إتش], [sh], [صدفة POSIX الأصيلة (نسخةُ Almquist في BSD)؛ خفيفةٌ ومحمولةٌ، بها تُكتب سكربتات النظام.],
  [تي سي إس إتش], [tcsh / csh], [صدفة بِركلي التفاعليّة (سليلة C shell)، صدفةُ الجذر الافتراضيّة في FreeBSD؛ صياغتُها تختلف عن `sh`.],
  [المحثّ], [Prompt], [الرمز الذي ينتهي به سطر الصدفة (`$` للمستخدم و`#` للجذر) معلنًا استعدادها لأمرٍ جديد.],
  [الملفّ الشخصيّ], [.shrc / .profile], [ملفّات إعداد الصدفة في دليل البيت، تُقرأ عند بدء الجلسة لضبط البيئة والاختصارات.],
  [في تي], [vt], [مُشغِّل طرفيّة النظام (console) الحديث في FreeBSD، يدعم Unicode والخطوطَ الرحبة (خلَفَ `syscons`).],
  [إي إي], [ee], [محرّرٌ نصّيٌّ بسيطٌ مدمجٌ في FreeBSD (easy editor)، ملائمٌ للمبتدئ مقابل `vi`.],
  [إن في آي], [nvi], [نسخةُ BSD الأصيلة من محرّر `vi`، هي المدمجةُ في النظام (لا Vim الذي يُثبَّت حزمةً).],
)

#section[الإقلاع والخدمات: نظام rc]

#gloss(
  [آر سي], [rc], [نظام الإقلاع وإدارة الخدمات في BSD؛ سكربتاتٌ متسلسلةٌ واضحةٌ في `/etc/rc.d` تُقرأ عند البدء.],
  [آر سي دوت كونف], [rc.conf], [ملفُّ الإعداد المركزيُّ `/etc/rc.conf` الذي يقرّر أيّ الخدمات تعمل عند الإقلاع وكيف.],
  [سيرفس], [service], [الأمر الذي يشغّل الخدمات ويوقفها ويستعلم عن حالتها (`service NAME start`).],
  [سيس آر سي], [sysrc], [الأداةُ التي تعدّل `rc.conf` بأمانٍ من سطر الأوامر بدل تحريره يدويًّا (`sysrc NAME_enable=YES`).],
  [المُحمِّل], [loader], [برنامج الإقلاع في FreeBSD الذي يحمّل النواة، ويعرض قائمةً يُضبط سلوكها في `loader.conf`.],
  [آر سي كتل], [rcctl], [أداة OpenBSD التي تجمع تشغيل الخدمات وتفعيلها عند الإقلاع في أمرٍ واحد.],
)

#section[التخزين ونظام الملفّات]

#gloss(
  [يو إف إس], [UFS / FFS], [نظام الملفّات العريق في BSD (Unix/Fast File System)؛ بسيطٌ ومتينٌ وخفيف.],
  [زد إف إس], [ZFS], [نظام ملفّاتٍ ومدير أحجامٍ متقدّمٌ يجمع سلامة البيانات واللقطات والضغط والتجميع؛ ميزةُ BSD الكبرى.],
  [جيوم], [GEOM], [إطار FreeBSD المرن لطبقات الأقراص: تقسيمٌ وتشفيرٌ ومرايا وRAID، كلٌّ طبقةٌ فوق أخرى.],
  [جي بارت], [gpart], [أداة تقسيم الأقراص الموحّدة في FreeBSD، تنشئ جداول الأقسام وتحرّرها (`gpart show`).],
  [زد بول], [zpool], [«التجمّع»: مجموعةُ أقراصٍ يوحّدها ZFS في مخزنٍ واحدٍ تُقتطع منه الأحجام (`zpool status`).],
  [مجلّد البيانات], [Dataset], [الوحدةُ المنطقيّةُ في ZFS (نظام ملفّاتٍ أو حجم)، لها خصائصُها المستقلّةُ من ضغطٍ وحصصٍ ولقطات.],
  [اللقطة], [Snapshot], [صورةٌ لحظيّةٌ للقراءة فقط لحالة مجلّدٍ في ZFS، تتيح الرجوع إليه بلا كلفةٍ تُذكر (`zfs snapshot`).],
  [بيئة الإقلاع], [Boot Environment], [نسخةٌ كاملةٌ قابلةٌ للإقلاع من النظام عبر لقطات ZFS؛ تُدار بـ`bectl` فتُرقّي بأمانٍ وتعود إن ساء التحديث.],
  [التحديثات الليّنة], [Soft Updates], [آليّةٌ في UFS ترتّب كتابة بيانات التعريف لتحفظ اتّساق نظام الملفّات بعد انقطاعٍ مفاجئ.],
)

#section[العزل والحاويات]

#gloss(
  [السجن], [Jail], [آليّة عزلٍ أصيلةٌ في FreeBSD تحبس عمليّةً في بيئةٍ منفصلةٍ لها جذرُها وشبكتُها، سابقةٌ لفكرة الحاويات.],
  [جيل دوت كونف], [jail.conf], [ملفُّ إعداد السجون في `/etc/jail.conf`، يصف كلَّ سجنٍ ومساره وشبكته.],
  [باستيل], [Bastille / ezjail], [أدواتٌ من الحزم تبسّط إنشاء السجون وإدارتها بأوامرَ مختصرة.],
)

#section[الأمن]

#gloss(
  [دواس], [doas], [أداة OpenBSD لتنفيذ أمرٍ بصلاحيّة الجذر، أبسطُ وأصغرُ من `sudo`، بملفِّ إعدادٍ من سطر (`/etc/doas.conf`).],
  [ويل], [wheel], [مجموعةُ المستخدمين المخوّلين الترقّي إلى الجذر؛ لا يصير المستخدم جذرًا بـ`su` إلّا إن كان فيها.],
  [تشفلاغز], [chflags], [أمرٌ يضع أعلامًا على الملفّات تتجاوز الأذون، أشهرُها `schg` الذي يمنع حتى الجذر من تغيير الملفّ.],
  [إس تش جي], [schg], [«علَم النظام الثابت» (system immutable)؛ يجمّد الملفّ فلا يُعدَّل ولا يُحذف إلّا بخفض `securelevel`.],
  [مستوى الأمان], [securelevel], [مستوًى يرفعه النظام تدريجيًّا فيقيّد حتى الجذر (يمنع نزع `schg` مثلًا)؛ حصنٌ ضدّ اختراقٍ يصل للجذر.],
  [كابسيكم], [Capsicum], [إطار FreeBSD لعزل القدرات: يحبس البرنامج في «وضع القدرة» فلا يصل إلّا لما مُنح صراحةً.],
  [إطار ماك], [MAC Framework], [التحكّم الإلزاميّ بالوصول (Mandatory Access Control): سياساتٌ قابلةٌ للتركيب تقيّد ما يفعله كلُّ برنامج.],
  [جيلي], [GELI], [طبقة GEOM لتعمية القرص الكامل في FreeBSD؛ تحمي البيانات إن فُقد الجهاز أو سُرق.],
  [بليدج], [pledge], [نداءُ نظامٍ في OpenBSD يَعِد به البرنامجُ أن يقتصر على قدراتٍ معيّنة، فإن تجاوزها قُتل.],
  [أنفيل], [unveil], [نداءُ نظامٍ في OpenBSD يحصر رؤية البرنامج في مساراتٍ محدّدةٍ من نظام الملفّات فقط.],
  [بي إف], [pf], [جدار BSD الناريُّ الأصيل (وُلد في OpenBSD)، يُدار بملفٍّ واضحٍ `/etc/pf.conf` والأداة `pfctl`.],
)

#section[الجسر مع يونِكس ولِينُكس]

#gloss(
  [بِركلي], [Berkeley / CSRG], [جامعة كاليفورنيا حيث وُلدت BSD في مجموعة أبحاث الحوسبة (CSRG)، مهدُ `vi` و`csh` وحزمة الشبكة.],
  [أربعة نقطة أربعة], [4.4BSD], [آخر إصدارٍ رسميٍّ من بِركلي (1994)، أصلُ الفروع الحديثة كلِّها بعد تحرّرها من شفرة AT&T.],
  [جنو], [GNU], [مشروع الأدوات الحرّة الذي يزوّد لِينُكس بأوامره؛ نسخُه تختلف أحيانًا عن نظائرها الأصيلة في BSD.],
  [لِينُكس], [Linux], [نواةٌ حرّةٌ تُلبَس أدوات GNU وتُغلَّف في توزيعات؛ تحاكي يونِكس دون أن تنحدر من شفرته كـBSD.],
  [إي إل إف], [ELF], [صيغة الملفّات التنفيذيّة والمكتبات المشتركة بين BSD ولِينُكس الحديثين.],
  [طبقة توافق لِينُكس], [Linuxulator], [آليّةٌ في FreeBSD تشغّل بعض ثنائيّات لِينُكس أصليًّا بترجمة نداءات نظامها.],
)
