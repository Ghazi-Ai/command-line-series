#chapter[سكربتاتٌ للعالم الحقيقيّ]

#objectives((
  [تُلبِس سكربتك درعًا من ثلاثة أسطر: `set -eu` و`IFS` و`trap`، فيتوقّف عند أوّل عطبٍ ولا يخلّف وراءه فوضى.],
  [تستقبل الوسائط والخيارات كما تفعل أوامر النظام: `"$@"` و`getopts` ودالّة `usage`.],
  [تبني أدواتٍ كاملةً تعمل: نسخةً احتياطيّةً مؤرّخة، وتقريرَ حالةٍ للنظام، وإعادةَ تسميةٍ بمعاينةٍ قبل التنفيذ.],
  [تكتب أوّل سكربت `rc.d` لك، فتصنع خدمةً يشغّلها النظام نفسه عند الإقلاع — بلغة الصدفة عينِها.],
  [تنقّح سكربتك حين يعصى بـ`sh -n` و`sh -x`، وتفحصه قبل تشغيله بـ`shellcheck`.],
))

في الفصلين السابقين — «أساسيات كتابة السكربتات» و«التحكّم بالتدفّق والدوال» — تعلّمتَ حروف الصدفة: المتغيّر، والشرط، والحلقة، والدالّة. والسكربت الذي لا يزيد على تشغيل بضعة أوامرَ في نسقٍ كطفلٍ يهجئ الحروف: صحيحٌ، لكنّك لا تأمنه على أمرٍ ذي بال. أمّا السكربت الذي *تثق* به فتتركه يعمل وأنت نائم، على خادمٍ لا تراه، فهو كصانعٍ مدرَّبٍ تُرسله وحده فيعود بالعمل تامًّا — والفرق بينهما ليس ذكاءً بل *انضباطًا*: درعٌ يحرسه من نفسه.

وهنا لطفٌ من طبيعة BSD يخصّنا: اللغة التي تُتقنها الآن — صدفة `sh` — هي عينُها لغةُ *النظام نفسه*. فحين يُقلع جهازك، لا يشغّل خدماتِه مارِدٌ غامض، بل سلسلةٌ من سكربتات `sh` في نظام `rc`، مكتوبةٌ بالحروف التي تكتب بها الآن. سكربتاتُك إذن ليست إضافاتٍ غريبةً تُلصَق بالنظام من خارجه، بل كلامٌ بلسانه الأصليّ — وهذا من صميم فلسفة BSD: نظامٌ واحدٌ متماسك، نواتُه وأدواتُه وسكربتاتُه تتكلّم لغةً واحدة. وبنهاية هذا الفصل تكتب أوّل خدمةٍ يشغّلها النظام لك عند الإقلاع.

#section[درعُ السكربت: ثلاثة أسطرٍ تفصل الهاوي عن المحترف]

السكربت الساذج يمضي في طريقه مهما حدث: إن فشل الأمرُ الثالث مضى إلى الرابع كأن شيئًا لم يكن، وإن أخطأتَ في اسم متغيّرٍ عاملَه كأنه فراغ، وإن انقطع في منتصفه ترك خلفه مجلّدًا مؤقّتًا يتراكم إلى الأبد. الدرع يُغلق هذه الأبواب الثلاثة، وكلُّ بابٍ منها سطرٌ واحد.

#subsection[`set -eu`: توقّفْ عند أوّل عطب]

سطرٌ واحدٌ يجمع أمرين للصدفة، لكلّ حرفٍ منهما معنًى مستقلّ:

- `-e` (اختصار errexit): إن خرج أيُّ أمرٍ بقيمةٍ غير الصفر فتوقّفْ فورًا. هذا يمنع أسوأ ما قد يقع: أن يفشل أمرُ النسخ ثم يمضي السكربت فيحذف الأصل.
- `-u` (اختصار nounset): استعمالُ متغيّرٍ لم يُعرَّف خطأٌ يوقف السكربت. حرفٌ ناقصٌ في اسم متغيّرٍ لن يمرّ صامتًا بعد اليوم.

ولعلّك قرأتَ في كتبٍ أخرى سطرًا أطول: `set -euo pipefail`. الحرف الثالث `pipefail` يعالج مفاجأةً في الأنابيب: في الأنبوب `a | b` القاعدةُ الأصليّة أنّ قيمة الخروج هي قيمة *آخر* أمرٍ وحده، فلو فشل `a` ونجح `b` عُدَّ الأنبوب ناجحًا! لكنّ `pipefail` *ليس مضمونًا في كلّ صَدَفات `sh`*، وصدفةُ `sh` الأساسيّة هي صدفةُ هذا الكتاب وصدفةُ سكربتات النظام. لذلك درعُنا المحمول عبر فروع BSD الأربعة هو `set -eu`، ونعالج فشل الأنبوب صراحةً حين يهمّنا.

#distro[
  أضافت صدفةُ `sh` على FreeBSD خيار `set -o pipefail`، فتستطيع استعماله إن كان سكربتُك لن يغادر FreeBSD. أمّا إن أردتَه محمولًا إلى OpenBSD وNetBSD وDragonFly — أو إلى أيّ نظام يونِكس — فالتزِم `set -eu` وحدها. وعلى لِينُكس صدفةُ `bash` تعرف `pipefail` منذ القِدم، ومنها شاع السطرُ الأطول في كتبها؛ لكنّ ما يصحّ في `bash` قد لا يصحّ في `sh` القياسيّة.
]

#subsection[`IFS` و`trap`: أين ينتهي الحقل، ومَن ينظّف بعدك؟]

#define([فاصل الحقول `IFS`], [
  متغيّرٌ خاصّ اسمه Internal Field Separator، يحوي المحارف التي تقسّم بها الصدفةُ نصًّا إلى حقول. قيمته الافتراضيّة ثلاثة: الفراغ، والجدولة (Tab)، وسطرٌ جديد. وحين تضبطه بنفسك، تُملي على `read` وعلى تقسيم الكلمات أين يقطعان.
])

كون الفراغ فاصلًا افتراضيًّا مصدرُ بلاءٍ حين تكثر الملفّاتُ ذات الأسماء المكوّنة من كلمتين؛ لذلك يضبط المحترفون `IFS` على السطر والجدولة وحدهما، فلا تنشطر الأسماءُ عند فراغاتها. والصيغة المحمولة أن تبنيَه بـ`printf`:

```sh
IFS=$(printf '\n\t')      # اقسم عند السطر الجديد والجدولة فقط، لا عند الفراغ
```

#note[
  دقّةٌ لمستها بنفسي على هذا الجهاز: لماذا جاءت الجدولةُ *بعد* السطر الجديد في `printf '\n\t'` لا قبله؟ لأنّ استبدال الأمر `$(...)` يبتلع الأسطرَ الجديدة من *آخر* النتيجة. فلو كتبتَ `printf '\t\n'` لضاع السطرُ الجديد وبقيت الجدولةُ وحدها. أمّا والجدولةُ آخِرًا فالسطرُ الجديد في الوسط محفوظٌ سالم. تفصيلٌ صغيرٌ، لكنّه فرقٌ بين درعٍ يعمل ودرعٍ نصفِ معطوب.
]

ويبقى البابُ الثالث: السكربت الذي يموت في منتصفه — بخطأٍ أو بضغطك #kbd("Ctrl") + #kbd("C") — تاركًا مجلّدًا مؤقّتًا لا يزيله أحد. وقد لمحتَ علاج ذلك في فصل «العمليات»، حين علّمنا سكربتًا أن يحفظ عمله قبل أن يُنهيَه النظام بإشارة. وهنا نستوفي الأداة.

#define("المصيدة (trap)", [
  أمرٌ يسجّل عند الصدفة أمرًا آخر — دالّةً في الغالب — يُنفَّذ *حتمًا* حين يقع حدثٌ بعينه. أشهر أحداثها `EXIT` أي «عند خروج السكربت بأيّ سببٍ كان»، وتليها إشارتان عرفتهما في فصل العمليات: `INT` مقاطعةُ المستخدم بـ#kbd("Ctrl") + #kbd("C")، و`TERM` طلبُ الإنهاء المهذّب من النظام. تكتبها مرّةً في أعلى الملفّ، فتطمئنّ أنّ التنظيف واقعٌ لا محالة.
])

ولَبِنةٌ أخيرةٌ تمرّ بك: `mktemp -d`. أمرٌ يطلب من النظام مجلّدًا مؤقّتًا باسمٍ عشوائيٍّ لا يصطدم باسم غيره، فتُملي عليه قالبًا تنتهي بستّ `X` يبدّلها بأحرفٍ عشوائيّة. وهذا هو الدرع الكامل الذي أنصحك أن تبدأ به كلَّ سكربتٍ تكتبه:

```sh
#!/bin/sh
set -eu                          # قِف عند أوّل عطب
IFS=$(printf '\n\t')             # لا تقسم عند الفراغ

# مجلّد عملٍ مؤقّتٌ لا يتكرّر اسمه
work=$(mktemp -d "${TMPDIR:-/tmp}/job.XXXXXX")

cleanup() {
  code=$?                        # احفظ الرمز أوّلًا
  rm -rf "$work"
  [ "$code" -eq 0 ] || echo "error $code -- cleaned up temp dir" >&2
  exit "$code"                   # أعِد رمز الخروج
}
trap cleanup EXIT                # عند أيّ خروج: نظِّف
trap 'exit 130' INT              # مقاطعةٌ بلوحة المفاتيح
trap 'exit 143' TERM             # طلبُ إنهاءٍ من النظام

echo "working in: $work"         # ثم يبدأ العمل
```

جرّبتُ هذا القالب على هذا الجهاز (وهو داروين، سليلُ BSD)، ثم أفشلتُه عمدًا بسطرٍ يقرأ ملفًّا لا وجود له، فطُبع هذا:

#session("./job.sh", output: "working in: /tmp/job.31DtWD
cat: /etc/no-such-config: No such file or directory
error 1 -- cleaned up temp dir")

خرج السكربتُ عند أوّل عطب (لم يُطبع ما بعد السطر الفاشل)، ونادت مصيدةُ `EXIT` دالّةَ `cleanup` فمحت المجلّد المؤقّت وأعادت رمز الخطأ `1`. وبحثتُ عن المجلّد بعده فلم أجد له أثرًا: نُظِّف كما وُعد.

ولِمَ ثلاثةُ أسطرٍ من `trap` لا سطرٌ واحدٌ يجمع الأحداث الثلاثة؟ لأنّ الجمع يخدع مرّتين: `trap cleanup EXIT INT TERM` يشغّل `cleanup` *مرّتين* حين تضغط #kbd("Ctrl") + #kbd("C") — مرّةً لأنّ `INT` وقعت ومرّةً لأنّ الخروج تلاها؛ ثمّ إنّ مصيدةَ `INT` التي لا تخرج بنفسها تعيد السكربتَ إلى حيث قُوطع فيمضي كأنّ شيئًا لم يكن. ولذلك نفصل: `EXIT` وحدها تحمل التنظيف، وأختاها لا تفعلان شيئًا إلّا أن تخرجا فتوقظاها.

#note[
  ومن أين جاء الرقمان `130` و`143`؟ من عُرفٍ قديمٍ في يونِكس رأيتَه في فصل العمليات: البرنامج الذي يموت بإشارةٍ يخرج بالقيمة `128` مضافًا إليها رقمُ تلك الإشارة. ورقم `INT` هو `2` فيكون الخارج `130`، ورقم `TERM` هو `15` فيكون `143`. فحين ترى `130` في `echo $?` تعرف بلا سؤالٍ أنّ أحدًا ضغط #kbd("Ctrl") + #kbd("C").
]

#try-it[
  انسخ القالب في ملفّ `job.sh` وامنحه `chmod +x` كما تعلّمتَ في فصل «الصلاحيات والملكية والأعلام». شغّله، ثم أضف قبل نهايته سطرًا فاشلًا مثل `cat /no-such` وشغّله ثانيةً: هل رأيت رسالة التنظيف ورمزَ الخطأ؟ ثم ضع مكان السطر الفاشل `sleep 30` وشغّله واضغط #kbd("Ctrl") + #kbd("C") في منتصفه، واقرأ `echo $?` بعده: أهو `130`؟ أخيرًا احذف سطر `trap cleanup EXIT` وأعِد التجربة، ثم فتّش عن المجلّد المؤقّت في `/tmp`: ستجده باقيًا معلّقًا. الفرق سطرٌ واحد.
]

#section[الوسائط: كيف يكلّمك مستخدمُ سكربتك؟]

عرفتَ في فصل «التحكّم بالتدفّق والدوال» أنّ `$1` أوّلُ وسيطٍ و`"$@"` جميعُها و`$#` عددُها. والأداةُ الناضجة تزيد على ذلك أنها تقبل *خياراتٍ* تُكتب بأيّ ترتيب: `-n` و`-c 3` و`-h`. والأداة التي تفكّها لك مبنيّةٌ في الصدفة نفسها، وهي من معيار POSIX فتعمل في كلّ صدفةٍ قياسيّة.

#define("getopts", [
  أمرٌ مدمجٌ في الصدفة يقرأ خيارات سطر الأمر واحدًا واحدًا. تعطيه *نصَّ صيغةٍ* مثل `":n:c:vh"`: كلُّ حرفٍ خيارٌ مقبول، والنقطتان بعد الحرف تعنيان «هذا الخيار يأخذ قيمة»، والنقطتان في أوّل النصّ تُسكتان رسائله الافتراضيّة لتكتب أنت رسائلك.
])

```sh
usage() {
  cat <<'HELP'
usage: greet.sh [-n name] [-c count] [-v] [-h] files...
  -n name    name to greet        -v   verbose mode
  -c count   how many times       -h   show this help
HELP
}

name="friend"; count=1; verbose=0

while getopts ':n:c:vh' opt; do
  case $opt in
    n)  name=$OPTARG ;;           # القيمة تصل في OPTARG
    c)  count=$OPTARG ;;
    v)  verbose=1 ;;
    h)  usage; exit 0 ;;
    :)  echo "option -$OPTARG needs a value" >&2; exit 2 ;;
    \?) echo "unknown option: -$OPTARG" >&2; usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))             # تخطَّ الخيارات المستهلَكة
```

الصيغة `cat <<'HELP' ... HELP` تسمّى *الوثيقة هنا* (here-document): كتلةُ نصٍّ متعدّدةُ الأسطر تنتهي بالكلمة التي سمّيتها، وإحاطةُ `'HELP'` بالاقتباس المفرد تمنع استبدال المتغيّرات داخلها فتُطبع كما هي. أمّا `OPTIND` فعدّادٌ تحرّكه `getopts`، و`shift $((OPTIND - 1))` تزيح الخيارات المستهلَكة فيبقى في `"$@"` ما بعدها من ملفّات. شغّلتُ السكربت على هذا الجهاز بصيغٍ عدّة، وهذا ما طبع:

#session("./greet.sh -n Ghazi -c 2 -v a b", output: "[verbose] remaining args: 2
hello, Ghazi (1)
hello, Ghazi (2)")

#session("./greet.sh -z", output: "unknown option: -z
usage: greet.sh [-n name] [-c count] [-v] [-h] files...  ...")

الخيار المجهول `-z` أخرج السكربتَ بالرمز `2`، والخيار `-c` بلا قيمةٍ أخرجه كذلك برسالةٍ صريحة. اخترنا الرمز `2` للخطأ في الاستعمال (لا `1`) لأنّ عُرف يونِكس يخصّ `2` بسوء الاستعمال، ويترك `1` للفشل في العمل نفسه.

#warn[
  أحِطْ `"$@"` بالاقتباس المزدوج دائمًا، ووجّه رسائل الأخطاء إلى تيّار الأخطاء بـ`>&2` لا إلى المخرَج القياسيّ — وقد فرّقتَ بينهما في فصل «التدفّقات وإعادة التوجيه والأنابيب». أمّا الاقتباس فليس ترفًا: `"$@"` بلا اقتباسٍ ينشطر عند الفراغات، فيصير الملفُّ «صور الرحلة» ملفَّين وهميَّين `صور` و`الرحلة`. ولأنّ سكربتاتك ستُقرأ وتُنسَخ، اجعل الاقتباس عادةً لا اجتهادًا.
]

#try-it[
  انسخ `greet.sh` وشغّله أربع مرّات: بلا وسائط، ثم بـ`-h`، ثم بـ`-n Abu-Haitham -c 3`، ثم بخيارٍ مجهولٍ مثل `-z`. واقرأ رمز الخروج بعد كلّ مرّةٍ بـ`echo $?`: ما الفرق بين رمز `0` ورمز `2`؟ ولماذا اخترنا `2` للخطأ في الاستعمال دون غيره؟
]

#section[سكربتٌ أوّل: نسخةٌ احتياطيّةٌ مؤرَّخة]

تأخذ مجلّدًا، فتضغطه في أرشيفٍ اسمُه يحمل تاريخ اللحظة، وتحفظه في `~/Backups`، ثم تحذف ما زاد عن آخر ثلاث نسخ.

```sh
#!/bin/sh
set -eu
KEEP=3
DEST="$HOME/Backups"

[ $# -eq 1 ] || { echo "usage: backup.sh <dir>" >&2; exit 2; }
src=${1%/}                                # احذف الشَّرطة الأخيرة إن كُتبت
[ -d "$src" ] || { echo "not a directory: $src" >&2; exit 1; }

mkdir -p "$DEST"
base=$(basename "$src")
stamp=$(date '+%Y-%m-%d_%H%M%S')          # مثال: 2026-07-24_174424
archive="$DEST/${base}_${stamp}.tar.gz"

tar -czf "$archive" -C "$(dirname "$src")" "$base"
echo "backup done: $archive ($(du -h "$archive" | cut -f1))"

# أبقِ أحدث KEEP نسخة، واحذف ما دونها
ls -1t "$DEST/${base}"_*.tar.gz | tail -n +$((KEEP + 1)) | while IFS= read -r old; do
  rm -f "$old"
  echo "pruned old backup: $(basename "$old")"
done
```

أربعة مواضعَ تستحقّ وقفة. الأوّل `${1%/}`: يقصّ الشَّرطة المائلة من آخر الوسيط، فلا يفرّق السكربتُ بين `proj` و`proj/`. والثاني أمران صغيران يقسمان المسار: `basename` يعطيك اسم آخر جزءٍ منه، و`dirname` ما قبله. والثالث خيار `tar` الموسوم `-C`: ينقل `tar` إلى مجلّد الأب قبل الأرشفة، فيُحفظ داخل الأرشيف مسارٌ نسبيٌّ نظيف لا مسارٌ مطلقٌ طويل. والرابع سطرُ الحذف، وهو ألطف ما في السكربت: `ls -1t` يسرد النسخ من الأحدث إلى الأقدم سطرًا لكلٍّ، و`tail -n +4` يبدأ من السطر الرابع فصاعدًا — أي *يتخطّى الثلاثة الأحدث* ويسلّم ما بقي إلى الحذف. شغّلته على هذا الجهاز خمس مرّاتٍ متتالية، فطبع في الأخيرة:

#session("./backup.sh proj", output: "backup done: /home/ghazi/Backups/proj_2026-07-24_174446.tar.gz (4.0K)
pruned old backup: proj_2026-07-24_174442.tar.gz")

وتحقّقتُ بعدها أنّ المجلّد استقرّ عند ثلاث نسخٍ لا أكثر، وأنّها الأحدث. لاحظ `while IFS= read -r`: صفّرنا `IFS` أمام `read` وحدها فلا يقصّ فراغًا من أوّل السطر أو آخره، و`-r` يمنع الشَّرطة المائلة من أن تُفسَّر — عادتان تجعلان قراءة الأسطر أمينةً حتى للأسماء الغريبة.

#distro[
  نسخة `tar` على FreeBSD (وسائر فروع BSD وماك) هي `bsdtar` المبنيّة على مكتبة `libarchive`، من نظام الأساس. أمّا على لِينُكس فالسائدة `GNU tar`. والصيغة `tar -czf` تعمل في العائلتين، لكنّ بعض الخيارات الطويلة تختلف. فإن كتبتَ سكربتًا يسافر إلى لِينُكس فالزم الخيارات القصيرة القياسيّة، ولا تفترض أنّ خياراتِ `bsdtar` الخاصّة مفهومةٌ هناك.
]

#danger[
  كلُّ سكربتٍ فيه `rm` يجب أن يُجرَّب أوّلًا على بياناتٍ لا تبكي عليها. أنشئ مجلّدًا تجريبيًّا فيه ملفّاتٌ وهميّة، وشغّله عليه عشر مرّاتٍ متتالية، وتحقّق بعينك أنّ العدد استقرّ عند `KEEP`، ولا توجّهه إلى مجلّد عملك الحقيقيّ إلّا بعد ذلك. القاعدة التي لا تُخالَف: بياناتك الحقيقيّة ليست ساحةَ تجربة.
]

