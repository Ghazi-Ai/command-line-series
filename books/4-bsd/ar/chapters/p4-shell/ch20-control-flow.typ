#chapter[التحكّم بالتدفّق والدوال]

#objectives((
  [تقرأ *قيمة الخروج* من `$?`، وتفهم كيف تبني عليها `&&` و`||` وكلَّ قرارٍ في الصدفة.],
  [تُفرّع طريقك بجملة `if` وأداةِ الاختبار `[ ]`، وتختار بين حالاتٍ كثيرةٍ بـ`case`.],
  [تكرّر العمل بحلقات `for` و`while` و`until`، وتضبطها بـ`break` و`continue`.],
  [تصنع *دوالَّك* الخاصّة، تمرّر إليها مُعطياتٍ في `$1` وتُرجِع منها قيمةَ خروج.],
  [تُلبس سكربتك درعًا — `set -e` و`set -u` والفخّ `trap` — بلغةِ `sh` النقيّة (POSIX) التي تعمل على فروع BSD الأربعة بلا تبديل.],
))

حتى الآن سار سكربتك كسفينةٍ على وجهةٍ واحدةٍ ثابتة: أمرٌ بعد أمرٍ من أعلى الملفّ إلى أسفله، لا يحيد ولا يعيد. لكنّ الرُّبّان الحاذق لا يكتفي بوجهةٍ واحدة؛ فبين يديه دفّةٌ يحرف بها المسار حين تتبدّل الريح — وهذا *القرار*، وقدرةٌ على أن يدور بالسفينة حول موضعٍ واحدٍ حتى يتمّ عملَه فيه — وهذا *التكرار*، ولفظٌ واحدٌ يطلقه فينفّذ بحّارتُه مناورةً كاملةً حفظوها — وتلك *الدالة*. وفوق ذلك عُدّةُ نجاةٍ: إن انقطع حبلٌ في عرض البحر توقّف فورًا وأمّن السطح قبل أن يستفحل الخطر — وذلك *درع السكربت*. في هذا الفصل تصير رُبّان سكربتك: تمنحه دفّةً تُفرّع، وحلقاتٍ تدور، ومناوراتٍ باسمٍ تُستدعى، وعُدّةَ طوارئ تحفظه حين يسوء الجوّ. وستكتب هذا كلَّه بلغة `sh` — لسانِ BSD الأمّ الذي كُتبت به سكربتاتُ إقلاع النظام كلِّها — فما تتعلّمه هنا يجري على FreeBSD وOpenBSD معًا بحرفه.

#section[قيمة الخروج: كيف يعرف النظام أنّ الأمر نجح؟]

قبل أن يقرّر أيُّ برنامجٍ شيئًا، يحتاج معلومةً واحدةً بسيطة: هل نجح الأمر السابق أم فشل؟ في عالم يونِكس، كلُّ أمرٍ يُنهي عمله يترك خلفه رقمًا صغيرًا يخبر عن مصيره؛ اسمه *قيمة الخروج*.

#define("قيمة الخروج (Exit status)", [
  عددٌ صحيحٌ بين `0` و`255` يتركه كلُّ أمرٍ بعد انتهائه. والعُرف مقلوبٌ عمّا تظنّ: `0` يعني *نجاحًا*، وأيُّ قيمةٍ غير الصفر تعني *فشلًا* (ونوعَه أحيانًا). تذكّرها هكذا: للنجاح طريقٌ واحدٌ (صفر)، وللفشل طرقٌ كثيرة.
])

الصدفة تحفظ لك قيمة خروج آخر أمرٍ في متغيّرٍ خاصٍّ اسمه `$?`. جرّبتُ على هذا الجهاز — وهو سليلُ BSD — أن أُنجح أمرًا ثم أُفشله عمدًا، وأقرأ الرقم في الحالتين:

```text
$ ls /etc >/dev/null; echo $?
0
$ ls /no-such-dir 2>/dev/null; echo $?
1
```

على هذه القيمة الصامتة يقوم كلُّ ما بعدها في هذا الفصل: جملة `if` ليست إلّا سؤالًا عن قيمة الخروج، وحلقة `while` ليست إلّا تكرارًا يستمرّ ما دامت القيمة صفرًا. وقبل أن نصل إليهما، هناك اختصاران يبنيان على `$?` مباشرة: `&&` معناه «نفّذ التالي فقط إن *نجح* السابق»، و`||` معناه «نفّذ التالي فقط إن *فشل* السابق».

```sh
mkdir رحلة && cd رحلة        # لا تدخل المجلّد إلّا إن نجح إنشاؤه
command -v git || echo "git غير مثبّت"   # البديل يعمل فقط إن فشل الأوّل
```

جرّبتُ الطرفين فعلًا لأُريَك متى يُطبع كلٌّ ومتى يُبتَلع:

```text
$ true && echo "طُبع بعد true"
طُبع بعد true
$ false && echo "لن يظهر"
$ false || echo "طُبع بعد false"
طُبع بعد false
```

لاحظ السطر الأوسط: `false` فشل، فابتلع `&&` ما بعده فلم يُطبع شيء. الأمران `true` و`false` أداتان صغيرتان لا تفعلان إلّا أن تُرجعا `0` و`1` على الترتيب — وُجدتا خصّيصًا لتجربة هذا المنطق.

#try-it[
  نفّذ `date` ثم `echo $?` وسجّل الرقم. ثم نفّذ أمرًا خاطئًا كـ`cat ملفّ-وهميّ` ثم `echo $?` وقارن. أخيرًا جرّب `true && echo نجح` ثم `false && echo نجح`: لماذا طُبعت الكلمة مرّةً واحدةً فقط؟
]

#section[القرار: جملة if]

الآن نضع اليد على الدفّة. جملة `if` تطرح سؤالًا، فإن كان الجواب «نعم» سلكت طريقًا، وإلّا سلكت آخر. لكنّ المفتاح الذي يفاجئ المبتدئ: `if` لا تفهم «صح» و«خطأ» مجرَّدين، بل تنظر إلى *قيمة خروج* أمرٍ تشغّله — فإن كانت صفرًا مضت في الطريق الأوّل.

#define("الشرط (Condition)", [
  أمرٌ تشغّله `if` لتقرّر: إن خرج بالقيمة `0` (نجاح) عُدّ الشرطُ متحقّقًا. وأشهرُ أمرٍ يُستعمل شرطًا هو أداةُ الاختبار `test`، ولها اسمٌ ثانٍ أقصر هو القوس `[ `؛ مهمّتها الوحيدة فحصُ شيءٍ وإرجاعُ `0` أو `1`.
])

هيكل الجملة أربعُ كلماتٍ مفتاحيّة: `if` ثم `then` ثم (اختياريًّا) `else` ثم `fi` التي تُغلقها — وهي `if` مقلوبةً، لطيفةٌ تُسهّل تذكّرها. هذا سكربتٌ يفحص وجود ملفّ إعداد `sh` في بيتك (واسمه على BSD `.profile`):

```sh
if [ -f "$HOME/.profile" ]; then
  echo "ملفّ إعداد sh موجود."
else
  echo "لا يوجد ملفّ إعداد بعد."
fi
```

الرمز `-f` سؤالٌ معناه «هل هذا ملفٌّ عاديٌّ موجود؟». وهناك أسئلةٌ أخرى تكثر الحاجة إليها: `-d` (أمجلّدٌ هو؟)، و`-e` (أموجودٌ أصلًا، ملفًّا كان أو مجلّدًا؟)، و`-r` و`-w` و`-x` (أمقروءٌ؟ أمكتوبٌ فيه؟ أقابلٌ للتنفيذ؟). أمّا للموازنة بين قيمتين فتُقارن النصوصُ بالعلامة `=` (تساوٍ) و`!=` (اختلاف)، وتُختبر خواءُ النصّ بـ`-z` (أفارغٌ؟) و`-n` (أغيرُ فارغ؟)، وتُقارن الأعدادُ بالرموز الحرفيّة `-eq` (يساوي) و`-ne` (لا يساوي) و`-lt` (أصغر) و`-le` (أصغر أو يساوي) و`-gt` (أكبر) و`-ge` (أكبر أو يساوي). ولاختبار عدّة احتمالاتٍ متتابعة، ضع `elif` (اختصار «else if») بين `if` و`else`. جرّبتُ هذا فعلًا بحسب ساعة تنفيذي:

```text
$ hour=$(date +%H)
$ if [ "$hour" -lt 12 ]; then echo "صباح ($hour)"
> elif [ "$hour" -lt 18 ]; then echo "مساء ($hour)"
> else echo "طابت ليلتك"; fi
صباح (09)
```

#warn[
  المسافات داخل القوسين *إلزاميّة*، لأنّ `[ ` ليس علامةً بل *أمرٌ قائمٌ بذاته* — بل هو برنامجٌ حقيقيٌّ على قرصك. تحقّقتُ على هذا الجهاز فوجدتُ ملفَّيه فعلًا: `/bin/test` و`/bin/[`، كلٌّ منهما نحوُ مئةِ كيلوبايت، وصفحةُ دليلٍ واحدةٌ تصفهما معًا: `test(1), [(1)`. ولأنّه أمرٌ يحتاج أن تفصله عن مُعطياته بفراغ، فلو كتبتَ `[-f x]` ملتصقةً لظنّتها الصدفةُ اسمَ أمرٍ غريب:
  ```text
  $ if [-f /etc/hosts]; then echo x; fi
  sh: [-f: not found
  ```
  اكتبها إذًا `[ -f x ]` بفراغٍ بعد `[ ` وقبل `]`.
]

#distro[
  في `sh` النقيّة، تساوي النصوص علامةٌ *واحدة* `=`، لا مزدوجةٌ `==`. المزدوجةُ من إضافات `bash` على لِينُكس، وكذلك القوسان المزدوجان `[[ ... ]]` (يعرفهما `bash` وصدفةُ OpenBSD‏ `ksh`، لكن لا تعرفهما `sh` المجرّدة). فإن أردت سكربتًا يجري على فروع BSD كلِّها بلا مفاجأة، فالزم القوسَ المفرد `[ ]` والعلامةَ المفردة `=` — هما المعيار (POSIX)، وهما ما يفهمه كلُّ `sh` في الدنيا.
]

#try-it[
  اكتب في محرّرٍ سكربتًا صغيرًا يسأل: إن كان مجلّد `/etc` موجودًا فليطبع «مجلّد الإعدادات جاهز»، وإلّا «لم أجده». استعمل `[ -d /etc ]`. شغّله، ثم بدّل `-d` بـ`-f` وأعِد التشغيل: لماذا تغيّر الجواب مع أنّ المسار واحد؟
]

#section[الاختيار المتعدّد: case]

جملة `if` مثاليّةٌ لسؤالٍ جوابُه فرعان. لكنْ حين تكثر الاحتمالات، تصير سلسلةُ `elif` طويلةً ثقيلة. هنا تلمع أداةٌ أنظف اسمها `case`: تعرض قيمةً واحدة، وتقابلها بعدّة أنماطٍ محتملة، فتنفّذ ما يطابق أوّلَها. تُفتح بـ`case` وتُغلق بـ`esac` (اسمُها مقلوبًا، كعادة الصدفة). جرّبتها فعلًا لتصنيف ملفٍّ بامتداده:

```text
$ name="photo.png"
$ case "$name" in
>   *.png|*.jpg) echo "صورة" ;;
>   *.txt|*.md)  echo "نصّ" ;;
>   *)           echo "مجهول" ;;
> esac
صورة
```

لاحظ ثلاثة أشياء: النجمة `*` في النمط تعني «أيّ شيء» (فـ`*.png` أيُّ اسمٍ ينتهي بـ`.png`)، والقضيب `|` يفصل بدائل النمط الواحد، والفاصلتان المنقوطتان `;;` تختمان كلَّ حالة. والنمط الأخير `*)` شبكةُ أمانٍ تلتقط كلَّ ما لم يطابقه سواه — ضعها دائمًا كي لا يمرّ المجهول بلا معالجة.

وليست `case` أداةً هامشيّة في BSD؛ بل هي عمودُ كلِّ سكربت خدمةٍ في النظام. فكلُّ سكربتات الإقلاع في `/etc/rc.d` تفتح على `case` تقرأ أوّلَ مُعطًى (`$1`) لتقرّر: أتبدأ الخدمة أم توقفها أم تعيد تشغيلها؟

```sh
case "$1" in
  start)   echo "بدء الخدمة" ;;
  stop)    echo "إيقاف الخدمة" ;;
  restart) echo "إعادة التشغيل" ;;
  *)       echo "الاستعمال: $0 {start|stop|restart}" ;;
esac
```

حين تصل إلى «الخدمات وrc» في جزءٍ لاحق، ستفتح سكربتًا حقيقيًّا من هذا الطراز فتجده مألوفًا — لأنك كتبتَه بيدك هنا.

#try-it[
  عدّل قيمة `name` في المثال الأوّل إلى `"lecture.mp3"` ثم `"notes.md"` ثم `"archive.zip"`، وشغّله في كلّ مرّة بعد أن تضيف نمطًا للصوت `*.mp3`. تابِعْ أيَّ فرعٍ التقط كلَّ قيمة، وتأكّد أنّ `archive.zip` سقط في شبكة الأمان `*)`.
]

#section[التكرار: حلقات for وwhile وuntil]

نصل إلى الحلقات: الجزء الذي يجعل السكربت يوفّر ساعاتٍ من عملك. بدل أن تكرّر أمرًا بيدك على عشرة ملفّات، تكتبه مرّةً وتدع الصدفة تدور به عليها. ثلاثُ حلقاتٍ تكفيك، تختار منها بحسب ما تعرفه سلفًا عن عدد الدورات.

#subsection[حلقة for: كرِّرْ على قائمة]

حلقة `for` تأخذ *قائمةً* من الكلمات، وتنفّذ الكتلة نفسها مرّةً لكلّ كلمة، واضعةً الكلمةَ الحاليّة في متغيّر. هيكلها: `for` … `in` … `do` … `done`. جرّبتها فعلًا:

```text
$ for n in أحمد سارة عليّ; do
>   echo "مرحبًا يا $n"
> done
مرحبًا يا أحمد
مرحبًا يا سارة
مرحبًا يا عليّ
```

والقائمة لا يلزم أن تكتبها بيدك؛ قد تكون ملفّاتٍ في مجلّد يوسّعها القوس النجميّ `*`:

```sh
for f in *.txt; do          # كلّ ملفّات النصّ في المجلّد الحاليّ
  echo "وجدتُ الملفّ: $f"
done
```

أمّا مجالٌ من الأرقام فهنا فرقٌ عن لِينُكس يجب أن تعرفه: صيغة القوسين `{1..5}` من إضافات `bash`، ولا تعمل في `sh` النقيّة. لك في BSD طريقان محمولان: إمّا أن تكتب الأرقام صراحةً `for i in 1 2 3 4 5`، وإمّا أن تستعين بأداة `seq` (متوفّرةٌ في نظام BSD الأساس) لتولّدها لك:

```text
$ for i in $(seq 1 3); do echo "دورة $i"; done
دورة 1
دورة 2
دورة 3
```

#subsection[حلقة while: كرِّرْ ما دام الشرط قائمًا]

بينما تدور `for` على قائمةٍ معلومةٍ سلفًا، تدور `while` ما دام *شرطٌ* متحقّقًا — أيْ ما دام أمرُ الشرط يخرج بالقيمة `0`. تُستعمل حين لا تعرف عدد الدورات مسبقًا:

```text
$ count=1
$ while [ "$count" -le 3 ]; do
>   echo "محاولة $count"
>   count=$((count + 1))
> done
محاولة 1
محاولة 2
محاولة 3
```

الصيغة `$(( ... ))` تحسب حسابًا رقميًّا، وهي جزءٌ من `sh` القياسيّة. وانتبه للسطر قبل الأخير: لولا رفع العدّاد لبقي الشرط متحقّقًا إلى الأبد ودارت الحلقة بلا توقّف — وهذا خطأٌ شائع. لإيقاف حلقةٍ هاربةٍ يدويًّا اضغط #kbd("Ctrl") + #kbd("C"). ولضبطها من داخل الكود كلمتان: `break` تكسر الحلقة وتخرج منها فورًا، و`continue` تتخطّى بقيّة الدورة الحاليّة وتقفز إلى التالية. جرّبتهما معًا:

```text
$ for i in 1 2 3 4 5; do
>   [ "$i" -eq 3 ] && continue    # تخطَّ الثلاثة
>   [ "$i" -eq 5 ] && break       # وقِفْ عند الخمسة
>   echo "$i"
> done
1
2
4
```

#subsection[حلقة until: كرِّرْ حتى يتحقّق الشرط]

`until` مرآةُ `while`: تدور ما دام الشرطُ *فاشلًا*، وتقف حين *ينجح*. أيْ تكرّر «حتى» يصير الشرط صحيحًا. تنفع حين يكون التفكير في «متى أتوقّف» أوضحَ من «ما دام»:

```text
$ n=1
$ until [ "$n" -gt 3 ]; do
>   echo "حتى: $n"
>   n=$((n + 1))
> done
حتى: 1
حتى: 2
حتى: 3
```

توقّفت عند `4` لأنّه أوّلُ عددٍ يجعل `-gt 3` صحيحًا. كلُّ حلقة `until` يمكن قلبها إلى `while` بعكس شرطها؛ فاختر ما يقرأ أوضحَ في موضعه.

#danger[
  الحلقات تضاعف قوّتك — وقوّةَ الخطأ معها. تأمّل `for f in *.tmp; do rm "$f"; done`: يحذف كلَّ ملفّات `.tmp` بلا سؤالٍ ولا سلّةِ مهملات على BSD. حرفٌ زائدٌ في النمط قد يمحو ما لم تقصد. القاعدة الذهبيّة: *جرّبها أوّلًا بـ`echo` بدل `rm`* لتقرأ ما سيُحذف قبل أن يُحذف فعلًا. وابتعد كلّيًّا عن `rm -rf` داخل حلقةٍ إلّا وأنت واثقٌ من كلّ عنصرٍ فيها.
]

#try-it[
  اكتب حلقة `for` تطبع مربّعات الأعداد من `1` إلى `5` (لكلّ `i` اطبع `$((i * i))`) مستعينًا بـ`seq`. ثم حوّلها إلى `while` تفعل الشيء نفسه بعدّاد. أيُّهما بدا لك أوضح لهذه المهمّة، ولماذا؟
]

#section[الدوال: أعطِ مقطعًا اسمًا]

حين تجد نفسك تكرّر الكتلة نفسها في مواضع، فقد حان وقت *الدالة*: تجمع عدّة أوامرٍ تحت اسمٍ واحد، ثم تستدعيها بذلك الاسم كأنها أمرٌ جديدٌ صنعتَه بيدك — تمامًا كما يحفظ البحّارةُ مناورةً كاملةً تحت اسمٍ واحدٍ ينادي به الرُّبّان.

#define("الدالة (Function)", [
  اسمٌ تطلقه على كتلةٍ من الأوامر، فتصير كأمرٍ مستقلّ. تكتبها مرّةً بالصيغة `name() { ... }`، ثم تناديها بكتابة اسمها. تقبل *مُعطياتٍ* حين تناديها، وتُرجِع *قيمةَ خروجٍ* حين تنتهي — تمامًا كأوامر النظام.
])

المُعطيات التي تمرّرها عند النداء تصل الدالةَ في متغيّراتٍ مرقّمة: `$1` أوّلها، و`$2` ثانيها، و`$@` جميعها، و`$#` عددها. جرّبتُ دالّةً تحيّي باسمٍ، وأخرى تعدّ مُعطياتها:

```text
$ greet() { echo "مرحبًا يا $1 ($# مُعطى)"; }
$ greet "أبا هيثم"
مرحبًا يا أبا هيثم (1 مُعطى)
```

والدالة تُرجِع قيمةَ خروجٍ بكلمة `return` (كما يُرجعها الأمر تلقائيًّا)، فيقدر مُناديها أن يبني عليها قرارًا بـ`&&` و`||`. جرّبتُ دالّةً تفحص أزوجيٌّ العددُ أم فرديّ، وتُرجِع `0` للزوجيّ:

```text
$ is_even() { [ $(( $1 % 2 )) -eq 0 ] && return 0 || return 1; }
$ is_even 4 && echo "4 زوجيّ"
4 زوجيّ
$ is_even 7 || echo "7 فرديّ"
7 فرديّ
```

اجمع ما تعلّمته كلَّه في دالّةٍ تنسخ ملفًّا احتياطيًّا، لكن فقط إن وُجد:

```sh
backup() {
  if [ -f "$1" ]; then
    cp "$1" "$1.bak"
    echo "نُسخ $1 إلى $1.bak"
    return 0                 # نجاح
  else
    echo "لا يوجد ملفّ اسمه $1"
    return 1                 # فشل
  fi
}

backup "$HOME/.profile" && echo "تمّت النسخة الاحتياطيّة"
```

#tip[
  أحِطْ مُعطياتك دائمًا بعلامتَي اقتباس: `"$1"` و`"$f"`، لا `$1` عاريةً. فبلا الاقتباس تُقسّم `sh` قيمةَ المتغيّر على الفراغات، فاسمُ ملفٍّ كـ`"ملاحظات المشروع.txt"` يصير ثلاثَ كلماتٍ منفصلةٍ فينكسر أمرك. الاقتباس عادةٌ تحميك من عللٍ يصعب تفسيرها لاحقًا، وهو ألزمُ في `sh` منه في صَدَفات لِينُكس المتساهلة.
]

#note[
  افتراضيًّا، متغيّراتُ الدالة *مشتركةٌ* مع بقيّة السكربت؛ فإن غيّرتها داخل الدالة تغيّرت في الخارج. لعزل متغيّرٍ داخل دالّةٍ وحدها، تسبقه بالكلمة `local`. جرّبتُها على هذا الجهاز فعملت: متغيّرٌ أُعلن `local` داخل دالّةٍ لم يُرَ خارجها. لكن انتبه: `local` ليست في معيار POSIX نصًّا، وإن كانت مدعومةً في `sh` على FreeBSD وفي `ksh` على OpenBSD وفي `dash` على لِينُكس. فاستعملها بلا قلقٍ على BSD؛ ولو أردت أقصى المحموليّة النظريّة فتجنّبها أو أعِدْ ضبط المتغيّر بعد الدالة.
]

#try-it[
  اكتب دالّةً اسمها `biggest` تأخذ عددين في `$1` و`$2`، وتطبع الأكبر منهما مستعينةً بـ`if` والموازنة `-gt`. ناديها: `biggest 8 3` ثم `biggest 5 9`. هل أصابت في الحالتين؟
]

#section[دروع السكربت: set و trap]

كلُّ ما سبق يمنح سكربتك عقلًا يقرّر ويكرّر. لكنّ العقل بلا حذرٍ متهوّر: سكربتٌ يمضي في طريقه بعد أن فشل أوّلُ أمرٍ فيه قد يبني على أنقاض. هنا تأتي *الدروع* — ثلاثةُ أسطرٍ تحوّل سكربتًا هشًّا إلى آخرَ يقف عند أوّل عطبٍ وينظّف خلفه. وهذه صناعةٌ يتقنها كتّابُ سكربتات BSD خاصّة، لأنّ سكربتاتهم تدير أنظمةً حيّة.

#subsection[‏`set -e`: قِفْ عند أوّل فشل]

افتراضيًّا، تمضي `sh` في تنفيذ سطورك سطرًا سطرًا ولو فشل بعضُها؛ لا تتوقّف إلّا في نهاية الملفّ. الخيار `set -e` يقلب هذا: يجعل السكربت يتوقّف فورًا عند أوّل أمرٍ يُرجِع قيمةً غير الصفر.

#define([`set -e` (errexit)], [
  أمرٌ يُوضَع في رأس السكربت فيغيّر سلوكه: يصبح كلُّ فشلٍ (قيمةُ خروجٍ غير صفر) سببًا لإيقاف السكربت في الحال. اسمُه الكامل `errexit` («اخرج عند الخطأ»). يقيك من أن يمضي سكربتٌ في خطواتٍ تعتمد على خطوةٍ فشلت.
])

جرّبتُ الفرق فعلًا. كتبتُ سكربتًا فيه أمرٌ فاشل، ثم سطرٌ بعده:

```sh
#!/bin/sh
set -e
echo "قبل الخطأ"
cp /no-such-file /tmp/x     # سيفشل
echo "بعد الخطأ"           # لن يُنفَّذ بسبب set -e
```

```text
$ sh نسخة.sh
قبل الخطأ
cp: /no-such-file: No such file or directory
$ echo $?
1
```

توقّف السكربت عند `cp` الفاشل، فلم يُطبع «بعد الخطأ»، وخرج بالقيمة `1`. بلا `set -e` كان سيتابع ويطبع السطر الأخير كأنّ شيئًا لم يكن.

#warn[
  لِـ`set -e` استثناءٌ مقصودٌ يجب أن تعرفه كي لا يربكك: لا يتوقّف السكربت إذا كان الأمرُ الفاشل *مُختبَرًا* أصلًا — أيْ شرطًا لـ`if` أو `while` أو `until`، أو طرفًا في سلسلة `&&` أو `||`، أو مسبوقًا بالنفي `!`. وهذا سليم: أنت في تلك المواضع تسأل عن النجاح والفشل قصدًا، لا تنتظر النجاح. فلا تظنّ `set -e` معطّلًا حين ترى `if` يجرّب أمرًا فاشلًا ويمضي؛ ذلك هو الصواب.
]

#subsection[‏`set -u`: لا تتساهل مع متغيّرٍ لم يُضبط]

الدرع الثاني `set -u`: يجعل استعمالَ متغيّرٍ لم تُسنِد إليه قيمةً خطأً يوقف السكربت، بدل أن يمرّ صامتًا كنصٍّ فارغ.

#define([`set -u` (nounset)], [
  خيارٌ يجعل الإشارةَ إلى متغيّرٍ غير مضبوطٍ خطأً فوريًّا. اسمُه `nounset` («لا متغيّرَ بلا ضبط»). يمسك أخطرَ غلطةٍ مطبعيّة: أن تكتب اسم متغيّرٍ خطأً فتحصل على فراغٍ صامتٍ بدل قيمته — وقد يعني ذلك في سكربتٍ حسّاسٍ كارثة.
])

تخيّل سكربتَ حذفٍ فيه `rm -rf "$DIR/"*` وقد أخطأتَ فكتبتَ `$DIRR` بحرفين. بلا `set -u` يصير المتغيّرُ فراغًا، فيتمدّد الأمر إلى `rm -rf /*` — هلاكٌ محقّق. ومع `set -u` يتوقّف السكربت فورًا ويشكو من المتغيّر غير المضبوط قبل أن يقع الأذى. تحقّقتُ من هذا السلوك على هذا الجهاز: سكربتٌ يقرأ متغيّرًا لم يُضبط توقّف في الحال وخرج بقيمةٍ غير الصفر.

```text
$ sh نسخة.sh
نسخة.sh: name: parameter not set
$ echo $?
1
```

#note[
  نصُّ رسالة الخطأ يختلف قليلًا بين نسخ `sh` (تقول `ksh` على OpenBSD صيغةً، و`sh` على FreeBSD أخرى، وهذا الجهازُ ثالثة)، لكنّ السلوك واحدٌ حرفيًّا: توقّفٌ عند المتغيّر غير المضبوط، وخروجٌ بقيمةٍ غير الصفر. تحقّقتُ من السلوك نفسِه هنا؛ فهو ثابتٌ عبر الفروع.
]

الدرعان معًا يُكتبان سطرًا واحدًا في رأس كلّ سكربتٍ جادّ:

```sh
#!/bin/sh
set -eu            # قِفْ عند أوّل فشل، وامنع المتغيّر غير المضبوط
```

#subsection[‏`trap`: نظِّفْ خلفك مهما حدث]

الدرعان السابقان يوقفان السكربت عند العطب. لكن ماذا عن الفوضى التي خلّفها قبل أن يقف — ملفٌّ مؤقّتٌ نصفُ مكتوب، مورِدٌ لم يُغلَق؟ هنا يأتي `trap`: يربط أمرًا يُنفَّذ *مهما كانت طريقة الخروج* — نجاحًا أو فشلًا أو مقاطعةً بـ#kbd("Ctrl") + #kbd("C").

#define("trap", [
  أمرٌ يسجّل «فخًّا»: كتلةً من الأوامر تُنفَّذ تلقائيًّا حين يتلقّى السكربت *إشارةً* بعينها أو حين يخرج. أشهرُ استعمالاته التنظيف عند الخروج: `trap 'أوامر التنظيف' EXIT`. والإشارةُ رسالةٌ يبعثها النظامُ إلى البرنامج، مثل `INT` (المقاطعة من لوحة المفاتيح) و`TERM` (طلب الإنهاء المؤدّب).
])

النمط الذهبيّ: أنشئ ملفًّا مؤقّتًا بأداة `mktemp` (وهي بِرْكليّةُ الأصل، تولّد اسمًا فريدًا آمنًا)، وسجّل فورًا فخًّا يحذفه عند الخروج. جرّبتُ هذا فعلًا:

```sh
#!/bin/sh
tmp=$(mktemp /tmp/demo.XXXXXX)
trap 'rm -f "$tmp"; echo "نُظّف: $tmp"' EXIT
echo "أعمل في الملفّ المؤقّت: $tmp"
echo "بيانات" > "$tmp"
echo "انتهى العمل"
```

```text
$ sh نسخة.sh
أعمل في الملفّ المؤقّت: /tmp/demo.3k8nLT
انتهى العمل
نُظّف: /tmp/demo.3k8nLT
```

لاحظ أنّ سطر «نُظّف» طُبع *بعد* «انتهى العمل» بلا أن أستدعيَه صراحة: الفخّ أطلقه الخروجُ وحده. ولو قاطعتُ السكربت في منتصفه بـ#kbd("Ctrl") + #kbd("C") لأطلقه ذلك الخروجُ أيضًا، فلا يبقى ملفٌّ يتيمٌ خلفه. ولالتقاط المقاطعة تحديدًا ومعالجتها بلطف، تُدرِج الإشارة `INT`. جرّبتُ سكربتًا يمسك مقاطعتَه ويخرج بهدوءٍ بالقيمة `130` (وهي القيمةُ المتعارَفة لمن قُوطع بـ`INT`):

```text
$ sh نسخة.sh
أمسكتُ المقاطعة، أخرج بهدوء
$ echo $?
130
```

#note[
  هذا النمطُ — `mktemp` ثم `trap ... EXIT` — هو نفسُه ما تفعله سكربتاتُ BSD في نظامها الأساس حين تحتاج ملفًّا مؤقّتًا: تضمن ألّا تترك أثرًا حتى لو انقطع التنفيذ. حين تفتح سكربتات `/etc` يومًا ستجد هذا الفخّ حاضرًا في مطالعها؛ فأنت الآن تكتب بأسلوب النظام نفسِه.
]

#try-it[
  اكتب سكربتًا يبدأ بـ`set -eu`، ينشئ ملفًّا مؤقّتًا بـ`mktemp`، ويسجّل `trap` يحذفه عند `EXIT`. اجعله يطبع اسم الملفّ ثم ينتهي طبيعيًّا، وتأكّد أنّ الملفّ اختفى بعده (`ls` عليه). ثم أضف سطرًا يشير إلى متغيّرٍ لم تُضبطه ولاحظ كيف يوقفه `set -u` — ومع ذلك يعمل الفخّ فيُنظّف. لماذا نُظّف رغم الفشل؟
]

#section[أيّ صدفةٍ تكتب لها؟ نقاء POSIX جواز سفرك بين الفروع]

كلُّ بُنى هذا الفصل — `if` و`case` والحلقات الثلاث والدوال و`set` و`trap` — من صميم معيار POSIX الذي تلتزمه `sh` على الفروع الأربعة. فإن بدأتَ سكربتك بالسطر `#!/bin/sh` والتزمت هذا المعيار، جرى سكربتك على FreeBSD وOpenBSD وNetBSD وDragonFly بحرفه، بل وعلى لِينُكس وماك. وهذا ليس ترفًا في BSD؛ فـ`sh` هي لسانُ النظام الأساس نفسِه: سكربتاتُ الإقلاع في `/etc/rc.d`، وأدواتُ التثبيت، وخيوطُ الإدارة — كلُّها `sh`. فحين تتقنها، لا تكتب سكربتاتك فحسب، بل تقرأ سكربتات النظام وتصلحها.

ولتبقى في هذا النقاء، تجنّبْ ما هو خاصٌّ بصدفةٍ بعينها: القوسان المزدوجان `[[ ]]`، والتساوي المزدوج `==`، ومجالاتُ الأقواس `{1..5}`، والمصفوفاتُ، وتحويلاتُ النصّ كـ`${var,,}` — كلُّها إضافاتُ `bash` أو `ksh`، مُغريةٌ لكنّها تكسر المحموليّة. والزمْ بدلها: `[ ]` و`=` و`seq` أو القوائم الصريحة، و`$( ... )` بدل العلامات المائلة القديمة للأوامر المتشعّبة.

#distro[
  على لِينُكس، الصدفةُ الافتراضيّة `bash`، وهي غنيّةٌ بإضافاتٍ فوق POSIX: `[[ ]]` بمزايا مطابقةٍ للأنماط، والمصفوفاتُ، و`{1..100}`، وتحويلُ حالة الأحرف. كثيرٌ من سكربتات الإنترنت تعتمدها ثم تبدأ — مخادِعةً — بالسطر `#!/bin/sh`، فتعمل على كثيرٍ من توزيعات لِينُكس (حيث `sh` هي `bash` متنكّرة) وتنكسر على BSD (حيث `sh` هي `sh` الحقّة). فإن نقلتَ سكربتًا من لِينُكس وشكا على FreeBSD من `[[` أو `{1..5}`، فتلك «بَشِّيّاتٌ» (bashisms) تسلّلت؛ عالِجْها بردّها إلى POSIX النقيّ.
]

#tip[
  كيف تكشف البَشِّيّات قبل أن تعضّك؟ استعمل مُدقّقًا اسمه `shellcheck` (تثبّته من `pkg`)؛ يقرأ سكربتك ويشير إلى كلّ ما يخالف `#!/bin/sh` من إضافاتٍ غير محمولة، سطرًا سطرًا. أداةٌ واحدةٌ تغنيك عن مفاجآتٍ كثيرة حين تنقل سكربتك بين الفروع.
]

#section[خلاصة الفصل]

منحتَ سكربتك في هذا الفصل عقلًا ودرعًا. عرفتَ أنّ كلَّ أمرٍ يترك خلفه *قيمة خروجٍ* في `$?`: صفرٌ للنجاح وغيرُه للفشل، وأنّ عليها يقوم كلُّ قرار، وأنّ `&&` و`||` أوّلُ ما يُبنى عليها. فرّعتَ طريقك بـ`if` وأداةِ الاختبار `[ ]` — التي رأيتَها برنامجًا حقيقيًّا على قرصك — وأغلقتها بـ`fi`، وصنّفتَ حالاتٍ كثيرةً بـ`case` وأغلقتها بـ`esac` كما تفعل سكربتاتُ الخدمات. كرّرتَ العمل بـ`for` على قائمةٍ معلومة، وبـ`while` ما دام شرطٌ قائمًا، وبـ`until` حتى يتحقّق، وضبطتها بـ`break` و`continue`. ثم أطلقتَ أسماءً على كتل أوامرك فصارت *دوالَّ* تقبل `$1` وتُرجِع قيمة. وأخيرًا ألبستَ سكربتك درعًا: `set -e` يوقفه عند أوّل فشل، و`set -u` يمنع المتغيّر غير المضبوط، و`trap` ينظّف خلفه مهما كانت طريقة الخروج. وفعلتَ ذلك كلَّه بـ`sh` النقيّة (POSIX) — جوازِ سفرك بين فروع BSD الأربعة. في الفصل التالي — سكربتاتٌ للعالم الحقيقيّ — ننتقل من إتقان اللبنات إلى بناء ما يقف على أرجله: نجمع القرارَ والتكرارَ والدوالَّ والدروعَ في أدواتٍ تعمل في يومك فعلًا، من نسخٍ احتياطيٍّ مؤرَّخٍ إلى تقرير حالةٍ لخادمك.

#challenge[
  ثلاثُ مسائلَ، كلٌّ تختبر ركنًا من الفصل، وكلُّها بلغة `sh` النقيّة تبدأ بـ`#!/bin/sh`:
  (1) *التركيب*: اكتب سكربتًا اسمه `classify.sh` يمرّ بحلقة `for` على ملفّات المجلّد الحاليّ، ويصنّف كلَّ ملفٍّ بـ`case` حسب امتداده (صورة / صوت / نصّ / غيرها)، ويعدّ كم في كلّ صنفٍ بعدّاداتٍ ترفعها بـ`$(( ))`، ثم يطبع الملخّص عبر *دالّةٍ* اسمها `report` تأخذ الصنف في `$1` وعدده في `$2`. جرّبه في مجلّدٍ تجريبيٍّ، واستعمل `echo` قبل أيّ فعلٍ يغيّر شيئًا.
  (2) *التدريع*: خذ سكربتًا هشًّا ينشئ ملفًّا مؤقّتًا بـ`mktemp` ويعمل عليه، وألبسه الدرع: أضف `set -eu` في رأسه، و`trap` يحذف الملفّ عند `EXIT`. ثمّ أدخِلْ عمدًا إشارةً إلى متغيّرٍ لم تُضبطه، وبيّن كيف أوقفه `set -u` — ومع ذلك نُظّف الملفّ. لماذا نُظّف رغم الفشل؟
  (3) *المحموليّة*: أمامك مقطعٌ كُتب لـ`bash` فيه `[[ $x == a ]]` وحلقةٌ على `{1..5}`؛ أعِد كتابته بـ`sh` نقيّةٍ تعمل على FreeBSD وOpenBSD، وفسّر بكلماتك لماذا لزم تغييرُ كلٍّ من `[[ ]]` و`==` و`{1..5}`. (تحقّقْ بـ`shellcheck` إن استطعت.)
]
