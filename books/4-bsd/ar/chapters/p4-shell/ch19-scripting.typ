#chapter[أساسيات كتابة السكربتات]

#objectives((
  [تفهم ما هو «السكربت»، وتكتب أوّل ملفٍّ ينفّذ عدّة أوامرَ دفعةً واحدة.],
  [تضبط سطر الصدارة `#!/bin/sh`، وتعرف لماذا يفضّل أهل BSD صدفةَ `sh` المعياريّة (POSIX) للمحموليّة بين الفروع الأربعة.],
  [تمنح ملفّك إذن التنفيذ بـ`chmod +x` وتشغّله بـ`./`.],
  [تميّز الاقتباس المفرد من المزدوج، وتحاور مستخدمك بالصيغة المحمولة: `printf` ثمّ `read -r`.],
  [تلتقط ناتج أمرٍ باستبدال الأوامر `$(...)`، وتقرأ وسائط سكربتك عبر `$1` و`$@` و`$#`.],
))

تخيّل طبّاخًا ماهرًا يقف إلى جانبك، تُملي عليه كلَّ خطوةٍ خطوة: «قطّع البصل، ثمّ أشعِل النار، ثمّ أضِف الزيت...». يعمل بإتقان، لكنّك مضطرٌّ إلى إعادة الإملاء كاملًا كلَّما اشتهيت الطبق. فماذا لو كتبتَ الوصفةَ مرّةً على بطاقةٍ، ثمّ ناولتَه إيّاها كلَّما جعت؟ تلك البطاقة هي *السكربت*: قائمةُ أوامرَ تكتبها مرّةً، فتنفّذها الصدفةُ كلَّما شئتَ من أوّلها إلى آخرها دون أن تعيد كتابتها.

وفي BSD لهذه البطاقة شأنٌ أرفعُ ممّا تظنّ. فأنت عرفتَ في «الطرفية والصدفة على BSD» أنّ النظام نسيجٌ واحد؛ وأنّ صدفة `sh` هي لغةُ سكربتات النظام كلِّها. بل إنّ BSD *يستيقظ* على سكربتات `sh`: كلُّ خطوات إقلاعه — تشغيل الخدمات، وتركيب الأقراص، وضبط الشبكة — سكربتاتٌ مكتوبةٌ بلغة `sh` تعيش في `/etc/rc.d` (ولها فصلٌ لاحقٌ هو «نظام rc وrc.conf والخدمات»). فحين تتعلّم كتابة السكربتات، لا تتعلّم حيلةً جانبيّة، بل تتعلّم اللغةَ التي كُتب بها النظامُ نفسه في طبقته العليا. في هذا الفصل تكتب أولى بطاقاتك.

#section[ما السكربت؟]

كلُّ ما تعلّمتَه حتى الآن كتبتَه سطرًا سطرًا في الطرفية، فتنفّذه الصدفةُ فورًا. السكربت لا يغيّر هذه القاعدة؛ هو فقط يجمع تلك الأسطر في *ملفٍّ نصّيٍّ* واحد، فتقرؤه الصدفةُ من أعلاه إلى أسفله وتنفّذ كلَّ سطرٍ بالترتيب كأنّك كتبتَه بيدك.

#define("السكربت (Script)", [
  ملفٌّ نصّيٌّ يحوي سلسلةً من الأوامر، تقرؤها الصدفةُ سطرًا بعد سطرٍ وتنفّذها بالترتيب. تكتبه مرّةً وتشغّله كلَّما احتجت — فهو يؤتمت العملَ المتكرّر، ويحفظ خبرتَك في ملفٍّ لا ينساها.
])

لنصنع أوّل سكربت. افتح محرّرك المفضّل الذي تعرّفتَ إليه في «المحرّرات» (‏`ee` السهل على FreeBSD، أو `vi` الحاضرُ في كلّ نظام)، وسمِّ الملفّ `hello.sh`، واكتب فيه ثلاثة أسطر:

```sh
echo "أهلًا بك في أوّل سكربت"
echo "أنت الآن في المجلّد:"
pwd
```

اللاحقة `.sh` ليست شرطًا؛ النظام لا يلتفت إليها، لكنّها تذكّرك أنت بلغة الملفّ. وأبسطُ طريقةٍ لتشغيله الآن أن تمرّره إلى الصدفة مباشرةً، فتقرؤه `sh` كنصٍّ وتنفّذه:

```text
$ sh hello.sh
أهلًا بك في أوّل سكربت
أنت الآن في المجلّد:
/home/ghazi
```

نفّذتُ هذا فعلًا على أدوات BSD في هذا الجهاز، فطبع الأسطر الثلاثة كما ترى. صنعتَ وصفةً تعمل. لكن يبقى أن نعلّم النظامَ كيف يشغّلها *وحدها* بلا أن نسبقها بكلمة `sh` — وذلك موضوع القسمين التاليين.

#try-it[
  أنشئ `hello.sh` بالأسطر الثلاثة أعلاه واحفظه. لا تشغّله بعدُ؛ فقط تأكّد أنّه حُفظ عبر `cat hello.sh` الذي يطبع محتوى الملفّ. أترى أسطرك الثلاثة سليمةً كما كتبتها؟
]

#section[سطر الصدارة: `#!/bin/sh`]

الملفُّ النصّيّ وحده لا يخبر النظامَ بأيّ *مفسّرٍ* يقرؤه: أبِصدفة `sh` أم `tcsh` أم لغةِ بايثون؟ لذلك نضع في أوّل سطرٍ إشارةً خاصّةً اسمها سطر الصدارة، تبدأ بالرمزين `#!` يتلوهما مسارُ البرنامج الذي يشغّل بقيّة الملفّ.

#define("سطر الصدارة (shebang)", [
  أوّلُ سطرٍ في السكربت، يبدأ بالرمزين `#!` ثمّ مسارِ المفسّر الذي يقرأ الملفّ. حين تشغّل الملفّ، ينظر النظامُ إلى هذا السطر ليعرف بأيّ برنامجٍ ينفّذه. سُمّي كذلك اختصارًا لـ «hash-bang»: اسمَي الرمزين `#` (‏hash) و`!` (‏bang).
])

في كتاب BSD نختار المفسّرَ `/bin/sh` بلا تردّد، فيكون سطرُ صدارتنا هكذا، ويجب أن يكون *أوّل* سطرٍ في الملفّ بلا فراغٍ قبله:

```sh
#!/bin/sh
echo "أهلًا بك في أوّل سكربت"
pwd
```

ولِمَ `sh` تحديدًا لا `bash`؟ لثلاثة أسبابٍ بِرْكليّةٍ خالصة. أوّلها أنّ `sh` جزءٌ من *النظام الأساس*: تجدها في `/bin/sh` على كلّ نظام يونِكس بلا استثناء، فمسارُها ثابتٌ مضمون. أمّا `bash` فليست في الأساس — تُضاف من الحزم كما رأيت في «الطرفية والصدفة على BSD»، وتسكن `/usr/local/bin/bash`، وقد لا تكون مثبّتةً أصلًا على الخادم الذي تنقل سكربتك إليه. وثانيها أنّ `sh` صدفةُ النظام نفسِه: سكربتاتُ `rc.d` كلُّها بها، فسكربتُك يجاورها في اللغة. وثالثها المحموليّة: نسخةُ `sh` في FreeBSD *قريبةٌ من معيار POSIX* كما تصرّح صفحةُ دليلها، فما تكتبه بالمعيار يعمل على الفروع الأربعة معًا.

#note[
  أصولُ `sh` تكشف حكمةَ اختيارها. نسخةُ FreeBSD (‏وNetBSD) من `/bin/sh` منحدرةٌ من *صدفة ألمكويست* (‏Almquist shell، أو `ash`): صدفةٌ صغيرةٌ سريعةٌ صارمةُ الالتزام بـ POSIX، صُمّمت عمدًا بلا زوائد `bash`. أمّا OpenBSD فصدفةُ `/bin/sh` فيه هي `ksh` «متنكّرةً» (تقول صفحةُ دليلها حرفيًّا إنّها `ksh` في ثوبٍ آخر). المفسّران مختلفان في المحرّك، لكنّهما يلتقيان عند معيار POSIX. فإذا كتبتَ إلى ذلك المعيار المشترك، جرى سكربتُك على FreeBSD وOpenBSD وNetBSD وDragonFly دون تبديلِ حرف.
]

ثمّة صورةٌ أكثرُ تنقّلًا تستعمل أداة `env` لتبحث عن المفسّر في مسارك أينما كان، وتنفع خاصّةً للغاتٍ كبايثون التي يتغيّر موضعها:

```sh
#!/usr/bin/env sh
```

لكنّ `/bin/sh` نفسَه ثابتٌ في كلّ يونِكس، فالصورةُ المباشرة `#!/bin/sh` هي المتعارفة في سكربتات BSD، وهي التي نعتمدها.

#distro[
  على كثيرٍ من أنظمة لِينُكس تكتب المقالاتُ `#!/bin/bash`، فتغريك بمزايا `bash` الخاصّة (‏bashisms). احذرها: أوّلًا لأنّ `bash` قد لا توجد على BSD أصلًا؛ وثانيًا لأنّ صدفة `/bin/sh` على دبيان وأوبونتو نفسِها ليست `bash` بل `dash` الصغيرة الصارمة — فسكربتٌ يخلط `bashisms` مع `#!/bin/sh` ينكسر حتى على لِينُكس. أمّا على ماك فـ`/bin/sh` هي `bash` في وضع POSIX. الخلاصةُ واحدة: `#!/bin/sh` + التزامُ POSIX = سكربتٌ يجري في كلّ مكان.
]

#try-it[
  أضِف السطر `#!/bin/sh` في أعلى `hello.sh`، فوق الأسطر الثلاثة، واحفظ. لم يتغيّر شيءٌ ظاهرٌ بعد، لكنّك أخبرتَ النظامَ بمن يقرأ وصفتك. تأمّل: لو كتبتَ `#!/usr/local/bin/bash` بدلًا منها ونقلتَ الملفّ إلى خادمٍ بلا `bash`، فماذا يحدث حين تشغّله؟
]

#section[إذن التنفيذ: `chmod +x` والتشغيل بـ`./`]

عرفتَ في «الصلاحيات والملكية والأعلام» أنّ لكلّ ملفٍّ ثلاثةَ أذونٍ: القراءة، والكتابة، ثمّ *التنفيذ*. ملفُّك النصّيّ الجديد يُقرأ ويُكتب، لكنّه لا يملك بعدُ إذن أن يُنفَّذ كبرنامج. نمنحه إيّاه بأمر `chmod` الذي أتقنتَه هناك، ثمّ نشغّله.

#define("إذن التنفيذ (execute permission)", [
  علامةٌ (‏`x`) على الملفّ تسمح بتشغيله كبرنامج. بدونها يرفض النظامُ تنفيذ ملفّك ولو كان سكربتًا صحيحًا. تُضاف بـ`chmod +x` وتُنزع بـ`chmod -x`.
])

امنح ملفّك الإذن، ثمّ شغّله باسمه مسبوقًا بـ`./`:

```sh
chmod +x hello.sh     # أضِف علامة «قابل للتنفيذ»
./hello.sh            # شغّله الآن وحده
```

نفّذتُ هذا فعلًا فطبع الأسطرَ الثلاثة نفسها — لكنّ الملفّ الآن يشغّل نفسه بنفسه، دون كلمة `sh` قبله، لأنّ سطر الصدارة صار يدلّ النظامَ على مفسّره.

ولِمَ سبقناه بـ`./`؟ لأنّ الصدفة لا تبحث عن البرامج في مجلّدك الحاليّ افتراضيًّا، بل في مجلّدات `PATH` وحدها — وهي حمايةٌ مقصودةٌ لئلّا يُخدَع المستخدم بملفٍّ خبيثٍ اسمُه كاسم أمرٍ شائع. فبكتابة `./hello.sh` تقول للصدفة صراحةً: «شغّل الملفّ الموجود *هنا*». الرمز `.` يعني «المجلّد الحاليّ»، و`/` يفصله عن اسم الملفّ. جرّبتُ تشغيله بلا `./` فاعتذرت الصدفةُ بأنّها لم تجد أمرًا بهذا الاسم، وطبعت `not found` — لأنّها لم تبحث في مجلّدي الحاليّ أصلًا.

#tip[
  إن أردتَ تشغيل السكربت دون منحه إذن التنفيذ أصلًا، مرّره إلى الصدفة كما فعلنا أوّلًا: `sh hello.sh`. هنا `sh` هي البرنامج المنفَّذ، والملفُّ مجرّدُ مُعطًى نصّيٍّ تقرؤه، فلا يحتاج إلى إذنٍ ولا حتى إلى سطر صدارة. أمّا `./hello.sh` فيحتاج الاثنين معًا: الإذن، والصدارة.
]

#distro[
  أمرُ `chmod +x` والتشغيلُ بـ`./` واحدٌ حرفًا حرفًا في BSD ولِينُكس وماك؛ فهو من صميم يونِكس. الفرقُ الدقيق أنّ نسخة `chmod` في BSD من النظام الأساس البِرْكليّ، ونسختَها على أغلب توزيعات لِينُكس من مجموعة GNU؛ ويفترقان في تفاصيلَ متقدّمةٍ لا في `+x` الذي يعمل بالطريقة نفسها في الجميع.
]

#try-it[
  نفّذ `chmod +x hello.sh` ثمّ `./hello.sh`. أرأيتَ تحيّتك ومجلّدك؟ الآن جرّب تشغيله بلا `./`، أي اكتب `hello.sh` وحدها: ستقول لك الصدفةُ `not found`. لماذا؟ لأنّ مجلّدك الحاليّ ليس في `PATH` — وتلك حمايةٌ لا عطب.
]

#section[المتغيّرات داخل السكربت]

السكربت المفيد نادرًا ما يكرّر قيمةً ثابتة؛ بل يحفظ القيمَ في *متغيّرات* يعيد استعمالها ويبدّلها. المتغيّرُ اسمٌ تُسنِد إليه قيمة، ثمّ تستدعيها بوضع علامة الدولار `$` قبل الاسم — وقد لمحتَ هذا في `echo $SHELL`.

#define("المتغيّر (variable)", [
  اسمٌ يحفظ قيمةً في الصدفة. تُسنِد القيمة بالصيغة `name=value`، وتقرؤها بـ`$name`. الاسمُ حروفٌ وأرقامٌ وشَرطةٌ سفليّة، والقيمةُ أيُّ نص.
])

القاعدةُ الذهبيّة عند الإسناد: *لا فراغ حول علامة يساوي*. فـ`name=Ghazi` صحيح، أمّا `name = Ghazi` فخطأٌ تظنّه الصدفةُ أمرًا اسمُه `name`. لنطوّر سكربتنا:

```sh
#!/bin/sh
name="أبو هيثم"
city="الرياض"
echo "أهلًا ${name}، من ${city}"
```

شغّلتُه فطبع: `أهلًا أبو هيثم، من الرياض`. غيّرتَ الاسمَ في سطرٍ واحدٍ فتغيّر الناتج كلُّه — تلك قوّةُ المتغيّر.

#note[
  لاحظ القوسين في `${name}`. حين تلصق متغيّرًا بنصٍّ بعده مباشرةً — عربيٍّ أو حرفٍ أو شَرطة — أحِط اسمَه بقوسين معقوفين ليعرف أين ينتهي: `${name}_backup` واضح، بينما `$name_backup` يجعل الصدفةَ تبحث عن متغيّرٍ اسمُه `name_backup` كلُّه. القوسان عادةٌ نظيفةٌ تريحك من لبسِ الحدود، وتعمل في كلّ صَدَفات عائلة `sh`.
]

#try-it[
  عدّل `hello.sh` ليعرّف متغيّرًا باسمك ويحيّيك به. ثمّ جرّب كتابة `name = علي` بفراغاتٍ حول `=` عمدًا، وشغّل السكربت: ما رسالةُ الخطأ؟ ثمّ صحّحها بإزالة الفراغين، ولاحظ كيف استقام الأمر.
]

#section[الاقتباس: مفردٌ ومزدوج]

حين تحوي قيمةٌ فراغًا أو محرفًا خاصًّا، نحيطها بعلامتَي اقتباس. لكنّ نوعَي الاقتباس يتصرّفان تصرّفًا مختلفًا جوهريًّا، والخلطُ بينهما مصدرُ أخطاءٍ لا تُحصى.

#define("الاقتباس المزدوج والمفرد", [
  العلامةُ المزدوجة `"..."` تحفظ الفراغات لكنّها *تفتح الباب* لاستبدال المتغيّرات: `$name` بداخلها يصير قيمتَها. أمّا المفردةُ `'...'` فتحفظ كلَّ ما بينها *حرفيًّا* كما هو، فلا يُستبدل فيها شيء.
])

انظر الفرق في تجربةٍ نفّذتُها فعلًا:

```text
$ name="أبو هيثم"
$ echo "مرحبًا $name"     ← مرحبًا أبو هيثم   (استُبدل المتغيّر)
$ echo 'مرحبًا $name'     ← مرحبًا $name      (بقي حرفيًّا)
```

فالقاعدةُ العمليّة: استعمل المزدوجة حين تريد قيمَ متغيّراتك أن تظهر، والمفردة حين تريد النصَّ كما هو (كأن تطبع علامة `$` نفسها). وأحِط متغيّراتك بالمزدوجة دائمًا حين قد تحوي محرفًا خاصًّا كالنجمة `*`؛ فهذه ليست زينةً بل أمانٌ حقيقيّ. جرّبتُ الفرقَ في مجلّدٍ فيه ثلاثةُ ملفّاتٍ نصّيّة:

```text
$ ls
a.txt   b.txt   c.txt
$ file="*.txt"
$ echo $file        ← a.txt b.txt c.txt   (توسّعت النجمة إلى الأسماء!)
$ echo "$file"      ← *.txt               (بقيت النجمة حرفيّة)
```

المتغيّرُ غيرُ المقتبَس مرّ على النجمة فتوسّعت إلى كلّ الملفّات المطابقة؛ والمقتبَسُ حفظها حرفًا. تخيّل الآن الفرقَ لو كان الأمرُ `rm` لا `echo`.

#danger[
  المتغيّرُ غير المقتبَس في أمرٍ مدمّرٍ كارثةٌ صامتة. تخيّل متغيّرًا `dir` فرغَ لسببٍ ما، فصار سطرُك `rm -rf $dir/*` هو عمليًّا `rm -rf /*` — أمرٌ يمحو النظامَ كلَّه بلا رجعة. والأخطرُ منه أوامرُ القرص التي مرّت في «الصلاحيات والملكية والأعلام». لا تبنِ أمرًا مدمّرًا حول متغيّرٍ إلّا وقد اقتبستَه `"$dir"` وتحقّقتَ أنّه ليس فارغًا. الاقتباسُ هنا حاجزٌ بينك وبين الهاوية، لا تجميلٌ للسطر.
]

#try-it[
  عرّف `greeting='القيمة $name لا تُستبدل'` بالمفردة، ثمّ `echo "$greeting"`. أظهرت `$name` نصًّا كما هو؟ الآن بدّل المفردة بمزدوجةٍ (بعد تعريف `name`) وأعِد التجربة، وراقب كيف يتبدّل الناتج بتغيير نوع العلامة وحده.
]

#section[محاورة المستخدم: `read`]

السكربتات التي كتبناها حتى الآن صمّاء: تحوي قيمَها في داخلها. لنجعلها تحاور مستخدمها. الأمر `read` يتوقّف، وينتظر أن يكتب المستخدمُ سطرًا ويضغط #kbd("Enter")، ثمّ يحفظ ما كتبه في متغيّرٍ تسمّيه.

#define("القراءة (read)", [
  أمرٌ يقرأ سطرًا من إدخال المستخدم ويخزّنه في متغيّر. صيغتُه البسيطة `read name` تنتظر سطرًا ثمّ تضعه في المتغيّر `name`.
])

لكن كيف تعرض سؤالًا قبل القراءة؟ هنا مزلقٌ محموليّ مهمّ. الصورةُ المحمولةُ الوحيدة التي تعمل على *كلّ* صَدَفات BSD أن تطبع السؤال بـ`printf` أوّلًا (وهو لا يُنزل سطرًا جديدًا، فيبقى المؤشّر بجوار السؤال)، ثمّ تقرأ بـ`read -r`:

```sh
#!/bin/sh
printf 'ما اسمك؟ '
read -r name
echo "أهلًا بك يا ${name}"
```

نفّذتُه فعلًا فسألني، وحين كتبتُ اسمي ردّ:

```text
$ ./ask.sh
ما اسمك؟ غازي
أهلًا بك يا غازي
```

#warn[
  ربّما رأيتَ في مقالاتٍ صيغةَ `read -p "ما اسمك؟ " name`، فالخيار `-p` يطبع السؤالَ في خطوةٍ واحدة. تعمل هذه على FreeBSD (فصفحةُ دليل `sh` فيه تذكر `-p` صراحةً)، وعلى `bash`. لكنّها *لا تعمل* على `sh` في OpenBSD: فهي `ksh` متنكّرةً، و`read` فيها لا يعرف إلّا `-r` (فلا يطبع لك سؤالًا) كما تُبيّن صفحةُ دليلها. وبما أنّ أحد الفروع الأربعة لا يفهم `-p`، سقطت محموليّتها بينها؛ فتجنّبها واعتمد `printf` ثمّ `read -r`. هذا فرقٌ صغيرٌ يفصل السكربتَ المحمول من المقيّد بصدفةٍ واحدة.
]

#tip[
  أضِف الخيار `-r` دائمًا: `read -r name`. بدونه تعامل `read` الشَّرطةَ المائلة `\` معاملةً خاصّةً فتبتلعها؛ ومع `-r` تُقرأ الأسطرُ حرفيًّا كما كتبها المستخدم. الخيارُ `-r` مضمونٌ في صَدَفات BSD كلِّها (تذكره صفحاتُ دليل FreeBSD وOpenBSD معًا)، فاجعله عادةً في كلّ استعمالٍ لـ`read`.
]

#distro[
  لكلّ صدفةٍ اختصارُها المريح للسؤال: `bash` تكتب `read -p "السؤال" name`، و`zsh` على ماك تكتب `read "name?السؤال"`. كلاهما مريحٌ لكنّه محبوسٌ في صدفته. الصيغةُ المحمولةُ التي تنفع في كلّ مكانٍ — BSD ولِينُكس وماك — تبقى `printf` ثمّ `read -r`. حين تشكّ، اكتب المحمول.
]

#try-it[
  اكتب سكربتًا يسأل عن اسمك ومدينتك بسطرَي `printf`/`read -r` منفصلين، ثمّ يطبع جملةً تجمعهما. شغّله وأجِب عن السؤالين. أظهرت جملتُك مكتملة؟ ثمّ جرّب `read -p` على جهازك: أنجح أم شكا؟ وماذا يخبرك ذلك عن صدفتك؟
]

#section[استبدال الأوامر: التقاط ناتج أمر]

بقيت قدرةٌ تفتح لك بابًا واسعًا: أن تحفظ *ناتج* أمرٍ في متغيّرٍ لتستعمله. هذا هو استبدالُ الأوامر: تضع الأمر داخل `$(...)`، فتشغّله الصدفةُ أوّلًا، ثمّ تضع مخرجاته مكان القوسين.

#define("استبدال الأوامر (command substitution)", [
  آليّةٌ تشغّل أمرًا وتضع ناتجه مكانه في السطر. صيغتُها `$(command)`: كلُّ ما يطبعه الأمرُ يصير قيمةً تحفظها في متغيّرٍ أو تمرّرها لأمرٍ آخر.
])

مثلًا، `date` يطبع التاريخ، و`whoami` يطبع اسمَ مستخدمك. لنلتقط ناتجهما:

```sh
#!/bin/sh
today=$(date "+%Y-%m-%d")     # التاريخ: سنة-شهر-يوم
me=$(whoami)                   # اسم المستخدم الحاليّ
echo "${me}: أنشأ هذا التقرير في ${today}"
```

شغّلتُه على هذا الجهاز فطبع سطرًا حقيقيًّا:

#session("./report.sh", output: "ghazi: أنشأ هذا التقرير في 2026-07-24")

وتستطيع أن تعشّق الأوامرَ داخل النصّ: `echo "عدد الملفّات: $(ls | wc -l)"` يحسب عدد الملفّات في مجلّدك.

#note[
  تذكّر ما رأيتَه في «التدفّقات وإعادة التوجيه والأنابيب»: `wc` بنكهة BSD يحشو عددَه بفراغاتٍ إلى عرضٍ ثابت، فـ`$(ls | wc -l)` قد يعطيك الرقمَ مسبوقًا بفراغات. إن أردتَ الرقمَ مجرّدًا للطباعة أو المقارنة، نظّفه بـ`tr -d ' '` هكذا: `$(ls | wc -l | tr -d ' ')`، أو احسبه في سياقٍ رقميٍّ `$(( ... ))`. هذا فرقٌ بِرْكليٌّ صغيرٌ يوقع القادمَ من لِينُكس.
]

#note[
  ثمّة صورةٌ قديمةٌ لاستبدال الأوامر تستعمل العلامتين المائلتين للخلف (‏backticks) هكذا: `` `date` ``. تعمل، لكنّ صيغة `$(...)` أوضحُ وأسهلُ في التعشيق، وهي المعياريّةُ في POSIX. اعتَد `$(...)` واترك العلامتين للنصوص القديمة التي تقرؤها.
]

#try-it[
  اكتب سكربتًا يعرّف `count=$(ls ~ | wc -l | tr -d ' ')` — أي عدد العناصر في مجلّد بيتك — ثمّ يطبع «في بيتك `$count` عنصرًا». شغّله. أطابق الرقمُ ما تراه حين تنفّذ `ls ~` بنفسك؟
]

#section[الوسائط: `$1` و`$@` و`$#`]

السكربت الذي يسأل بـ`read` لطيف، لكنّ الأدوات الحقيقيّة تأخذ مُعطياتِها من *سطر الأوامر* مباشرةً، كما يفعل `cp a b`. حين تكتب `./greet.sh أحمد الرياض`، تصير الكلمتان بعد اسم السكربت *وسائطَ* يقرؤها بأسماءٍ خاصّة.

#define("الوسائط الموضعيّة (positional parameters)", [
  القيمُ التي تُمرّرها إلى السكربت بعد اسمه على سطر الأوامر. يقرأ السكربتُ الأولَ بـ`$1`، والثاني بـ`$2`، وهكذا. و`$#` عددُ الوسائط، و`$@` كلُّها مجتمعةً، و`$0` اسمُ السكربت نفسِه.
])

اكتب `greet.sh` هكذا:

```sh
#!/bin/sh
echo "اسم السكربت: $0"
echo "الوسيط الأول: $1"
echo "الوسيط الثاني: $2"
echo "عدد الوسائط: $#"
echo "كل الوسائط: $@"
```

شغّلتُه فعلًا بثلاثة وسائط، فقرأ كلَّ واحدٍ في موضعه:

```text
$ ./greet.sh أحمد الرياض BSD
اسم السكربت: ./greet.sh
الوسيط الأول: أحمد
الوسيط الثاني: الرياض
عدد الوسائط: 3
كل الوسائط: أحمد الرياض BSD
```

لاحظ `$0`: إنّه المسارُ الذي شغّلتَ به السكربت (`./greet.sh`)، لا وسيطٌ مرّرتَه. ولاحظ `$#`: طبع `3` لأنّنا مرّرنا ثلاث كلمات. أمّا حين تحوي قيمةٌ فراغًا فتريد أن تبقى وسيطًا واحدًا، فاقتبسها عند التمرير: `./greet.sh "أبها المدينة"` تُقرأ كلَّها في `$1`.

#warn[
  حين تمرّر `$@` إلى أمرٍ آخر، أحِطها بالمزدوجة دائمًا: `"$@"`. فهذه الصورةُ وحدها تحفظ كلَّ وسيطٍ سليمًا حتى لو حوى فراغًا (‏فتتوسّع «‏`"$@"`‏» إلى كلّ وسيطٍ محاطًا باقتباسه). أمّا `$@` عاريةً فتفتّت الوسائطَ ذاتَ الفراغ. القاعدةُ: `"$@"` بالمزدوجة، لا `$@` عارية.
]

#note[
  تجاور `$@` رفيقتُها `$*`: كلتاهما «كلُّ الوسائط»، لكنّ `"$@"` تبقيها وسائطَ منفصلةً، بينما `"$*"` تدمجها في نصٍّ واحدٍ يفصل بين أجزائه أوّلُ محرفٍ من `IFS` (‏فراغٌ عادةً). في أغلب حاجاتك `"$@"` هي الصواب. أمّا *اجتياز* هذه الوسائط واحدًا واحدًا بحلقةٍ فبابُه الفصلُ التالي «التحكّم بالتدفّق والدوال».
]

#try-it[
  اكتب سكربتًا يطبع «مرحبًا `$1`، مرّرتَ `$#` وسيطًا». شغّله مرّةً بوسيطٍ واحد، ومرّةً بثلاثة، ومرّةً بلا وسائطٍ أصلًا. كيف تغيّر `$#`؟ وماذا طبع `$1` حين لم تمرّر شيئًا؟
]

#section[نجمع القطع: سكربتٌ متكامل]

اجتمعت لدينا كلُّ اللبِنات: سطرُ الصدارة، والمتغيّرات، والاقتباس، و`read`، واستبدالُ الأوامر، والوسائط. لنبنِ بها سكربتًا صغيرًا يحيّي مستخدمه ويسجّل لقاءه:

```sh
#!/bin/sh
printf 'ما اسمك؟ '
read -r name
today=$(date "+%Y-%m-%d")
here=$(pwd)
echo "أهلًا يا ${name}"
echo "سُجّل لقاؤنا يوم ${today}"
echo "في المجلّد ${here}"
```

امنحه الإذن بـ`chmod +x` وشغّله بـ`./`. نفّذتُه فعلًا وأدخلتُ اسمي، فكانت الجلسة:

```text
$ ./meet.sh
ما اسمك؟ غازي
أهلًا يا غازي
سُجّل لقاؤنا يوم 2026-07-24
في المجلّد /home/ghazi
```

في ستّة أسطرٍ فقط صنعتَ برنامجًا يسأل، ويحسب، ويجيب — وكلُّه بلغةٍ محمولةٍ تجري على الفروع الأربعة بلا حرفٍ يتغيّر. وهذه نواةُ كلّ ما ستكتبه لاحقًا من أدوات أتمتةٍ أعقد، بل هو من طينة سكربتات `rc.d` التي يقوم عليها النظامُ نفسه.

#section[خلاصة الفصل]

انتقلتَ في هذا الفصل من إملاء الأوامر واحدًا واحدًا إلى كتابة الوصفة مرّةً وتشغيلها كلَّما شئت. تعلّمتَ أنّ السكربت ملفٌّ نصّيٌّ من أوامر، يبدأ بسطر صدارةٍ `#!/bin/sh` يخبر النظامَ بمن يقرؤه — واخترنا `sh` لأنّها في النظام الأساس دائمًا، وقريبةٌ من POSIX فتحمل سكربتك بين الفروع الأربعة (‏وعرفتَ أنّ `sh` في FreeBSD منحدرةٌ من `ash`، وفي OpenBSD هي `ksh` متنكّرة، ويجمعهما المعيار). ورأيتَ أنّه لا يُنفَّذ حتى تمنحه `chmod +x` وتشغّله بـ`./` لتدلّ الصدفةَ على مكانه. ثمّ أحكمتَ المتغيّراتِ وقاعدةَ «لا فراغ حول يساوي»، وميّزتَ الاقتباسَ المزدوجَ الذي يفتح باب القيم من المفردِ الذي يقفله — ورأيتَ كيف يكون الاقتباسُ حاجزَ أمانٍ أمام الأوامر المدمّرة وتوسّعِ النجمة. وجعلتَ سكربتك يحاور مستخدمه بالصيغة المحمولة `printf` ثمّ `read -r` (لا بصيغة `read -p` المحبوسةِ في صدفة)، ويلتقط ناتجَ الأوامر بـ`$(...)`، ويقرأ وسائطه بـ`$1` و`$@` و`$#`. في الفصل التالي — «التحكّم بالتدفّق والدوال» — نمنح سكربتاتنا عقلًا يقرّر: الشروطُ التي تجعلها تتفرّع، والحلقاتُ التي تكرّر، والدوالُّ التي تنظّم — فتتحوّل بطاقاتُك من قوائمَ مستقيمةٍ إلى برامجَ تفكّر.

#challenge[
  اكتب سكربتًا اسمه `taqrir.sh` يفعل التالي: يأخذ اسمَ صاحب التقرير من الوسيط الأوّل `$1`، ثمّ يعرّف `now=$(date "+%H:%M")` بالوقت الحاليّ، و`here=$(pwd)` بالمجلّد الحاليّ، ثمّ يطبع ثلاثةَ أسطرٍ تجمع الاسمَ والوقتَ والمجلّد — كلُّها مقتبسةٌ بالمزدوجة ومقوّسةٌ `${..}`. لا تنسَ سطر الصدارة، وامنحه الإذن، وشغّله `./taqrir.sh غازي`. ثمّ أجب: (1) لو شغّلتَه بلا وسيطٍ أصلًا، فماذا يطبع مكان الاسم، ولماذا؟ (2) لو كتبتَ في سكربتٍ آخر `read -p "الاسم؟ " n` ونقلتَه إلى خادم OpenBSD، فهل يعمل؟ وما الصيغةُ المحمولةُ التي تنجو في كلّ مكان؟ (3) لو أحطتَ `$(pwd)` باقتباسٍ *مفردٍ* `'$(pwd)'` بدل المزدوج، أيُطبع المسارُ أم النصُّ حرفيًّا؟ ولماذا؟
]
