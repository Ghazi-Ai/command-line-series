#chapter[الصلاحيات والملكية والأعلام]

#objectives((
  [تقرأ سطر `ls -l` محرفًا محرفًا: نوعَ العنصر، ثمّ ثلاثيّاتِ المالك والمجموعة والآخرين.],
  [تضبط الأذون بـ`chmod` رمزيًّا وعدديًّا، وتنقل الملكيّة بـ`chown` و`chgrp`، وتفهم `umask` والبتّات الخاصّة الثلاث.],
  [تُتقن ما تنفرد به BSD: أعلامَ الملفّات عبر `chflags` — `uchg` و`schg` و`sappnd` و`nodump` — وتقرأها بـ`ls -lo`.],
  [تدرك كيف يرفع `securelevel` العَلَمَ `schg` فوق سلطة الجذر نفسِه، ولماذا لا يُنزَع إلّا في الطور الأحاديّ.],
  [تكتب قوائم ACL على UFS وZFS بـ`setfacl` و`getfacl`، وتميّز نموذج POSIX من نموذج NFSv4.],
))

تخيّل متحفًا في مدينةٍ عتيقة. عند الباب حارسٌ يفحص بطاقتك: مَن أنت، وأيّ القاعات يحقّ لك دخولها. هذه بوّابةٌ تعرفها كلُّ المتاحف. لكنّ في هذا المتحف قطعةً نادرةً لا يكفيها الحارس: فهي مثبّتةٌ في أرضها بقفلٍ من حديد، وأغربُ ما فيه أنّ مدير المتحف نفسَه *سلّم مفتاحه* إلى جهةٍ أعلى لحظةَ فتح الأبواب صباحًا، فلا يملك هو ولا أيُّ موظّفٍ أن يحرّكها ما دام المتحف مفتوحًا للناس. لا تُفَكّ القطعة إلّا بعد أن تُغلَق الأبواب ويخلو المكان.

هكذا بالضبط يحرس BSD ملفّاتك. الحارس عند الباب هو نظام الأذون اليونِكسيّ العتيق الذي تراه في `ls -l`، وهو يشغل نصف هذا الفصل ومشتركٌ بين كلّ أنظمة يونِكس. أمّا القفل الحديديّ فهو *عَلَم الملفّ* (file flag) الذي تنفرد به عائلة BSD: رايةٌ تعلو على المالك، بل قد تعلو على الجذر نفسِه حين يُرفَع مستوى الأمان (securelevel) عند إقلاع النظام، فلا تُنزَع إلّا بعد أن يهبط النظام إلى طوره الأحاديّ. مَن عرف الحارس وحده حار كثيرًا؛ ومَن عرف القفل معه لم تعُد رسالتا `Permission denied` و`Operation not permitted` لغزًا عنده.

#section[سطر `ls -l`: بطاقةٌ في عشرة محارف]

كلُّ ملفٍّ ومجلّدٍ يحمل بطاقةً خفيّةً تجيب عن سؤالين: لِمَن هذا العنصر؟ وماذا يُسمح لكلّ فئةٍ أن تفعل به؟ ويعرض `ls -l` هذه البطاقة كاملة. أنشئ مجلّدًا تجريبيًّا وجرّب:

#session("ls -l", output: "total 8
drwxr-xr-x  2 ghazi  ghazi  512 Jul 24 09:38 docs
-rw-r--r--  1 ghazi  ghazi    3 Jul 24 09:38 note.txt")

يبدو السطر طلسمًا، لكنّه سبعةُ حقولٍ تُقرأ من اليسار (فالمخرجات إنجليزيّةٌ يساريّة): كتلةُ الأذون، فعددُ الروابط الصُّلبة، فاسمُ المالك، فاسمُ المجموعة، فالحجمُ بالبايت، فتاريخُ آخر تعديل، فالاسم. الحقلان الثالث والرابع هما *الملكيّة*، والحقل الأوّل هو *الأذون*.

#define("الملكيّة (Ownership)", [
  لكلّ عنصرٍ *مالكٌ* واحدٌ هو مُنشئه غالبًا، ثمّ *مجموعةٌ* واحدةٌ قد ينتمي إليها عدّة مستخدمين. ومَن ليس المالكَ ولا عضوًا في المجموعة فهو من *الآخرين*. ثلاثُ فئاتٍ لا رابعة لها، ورموزها `u` للمالك و`g` للمجموعة و`o` للآخرين، و`a` للثلاث مجتمعة.
])

على FreeBSD تكون مجموعتك الأساسيّة — بإعداد `adduser` الافتراضيّ — مجموعةً باسمك تُنشأ معك، ولذلك ترى `ghazi ghazi` أعلاه؛ وقد صافحتَ نظام المستخدمين والمجموعات كاملًا في فصل المستخدمين والمجموعات، وأداةُ `id` تكشف هويّتك ومجموعاتك جميعًا. أمّا كتلةُ الأذون فعشرةُ محارف: محرفٌ للنوع، ثمّ ثلاثُ ثلاثيّاتٍ متتالية.

#table(
  columns: (auto, auto, 1fr),
  align: (right, center, right),
  table.header([الموضع], [في مثالنا], [ما يعنيه]),
  [المحرف 1], [`-`], [نوعُ العنصر: ملفٌّ عاديّ],
  [من 2 إلى 4], [`rw-`], [ما يملك *المالكُ* فعله],
  [من 5 إلى 7], [`r--`], [ما تملك *المجموعةُ* فعله],
  [من 8 إلى 10], [`r--`], [ما يملك *الآخرون* فعله],
)

وداخل كلّ ثلاثيّةٍ الترتيبُ ثابتٌ أبدًا: `r` ثمّ `w` ثمّ `x`. فإن مُنِح الإذنُ ظهر حرفُه، وإن حُجب ظهرت مكانه شَرطة `-`. أمّا المحرف الأوّل فيخبرك بالنوع: `-` ملفٌّ عاديّ، و`d` مجلّد، و`l` رابطٌ رمزيّ، و`c` أو `b` جهازٌ من أجهزة النظام. فلنقرأ مثالنا تهجّيًا: `-rw-r--r--` تعني «ملفٌّ عاديّ، مالكه يقرأ ويكتب، والمجموعة تقرأ، والآخرون يقرؤون». وسطرُ المجلّد `drwxr-xr-x` يعني «مجلّدٌ، مالكه يفعل كلَّ شيء، والبقيّةُ يسردون ويدخلون».

#tip[
  إن كتبتَ `ls -l docs` عرض لك ما *بداخل* المجلّد، لا المجلّدَ نفسه. ولتفحص بطاقة المجلّد ذاتِه أضف `-d` هكذا: `ls -ld docs`. احفظ هذه الحيلة؛ ستحتاجها في كلّ فحصٍ لمجلّد.
]

#section[الأذون الثلاثة: ومعناها ينقلب على المجلّد]

#define("الأذون الثلاثة", [
  *القراءة* (`r` أي read)، ثمّ *الكتابة* (`w` أي write)، ثمّ *التنفيذ* (`x` أي execute). كلُّ إذنٍ إمّا ممنوحٌ أو ممنوع، ولا وسط بينهما.
])

وهنا المفاجأة التي يتعثّر فيها كلُّ مبتدئ: هذه الحروف الثلاثة تعني على المجلّد شيئًا مختلفًا تمامًا عمّا تعنيه على الملفّ.

#table(
  columns: (auto, 1fr, 1fr),
  align: (center, right, right),
  table.header([الإذن], [على ملفّ], [على مجلّد]),
  [`r`], [قراءةُ محتواه], [*سردُ أسماء* ما بداخله],
  [`w`], [تعديلُ محتواه], [إنشاءُ عناصرَ وحذفُها وإعادةُ تسميتها],
  [`x`], [تشغيلُه كبرنامج], [*الدخولُ إليه والعبورُ منه*],
)

تأمّل الصفّ الأخير: على المجلّد لا يعني `x` «تشغيلًا» — فالمجلّدات لا تُشغَّل — بل يعني *حقَّ العبور*. فلتصل إلى ملفٍّ داخل مجلّد لا بدّ لك من `x` على المجلّد، ولو كان الملفّ مقروءًا للعالم أجمع. والأعجب أنّ `r` و`x` مستقلّان: تملك أحدهما دون الآخر فيتبدّل سلوكُ النظام تبدّلًا حادًّا. انزع `x` وحدها عن مجلّدٍ فيه ملفّ، ثمّ حاول:

#session("chmod -x docs; ls docs", output: "ls: fts_read: Permission denied
inside.txt")
#session("cat docs/inside.txt", output: "cat: docs/inside.txt: Permission denied")

قرأ `ls` سجلَّ الأسماء فطبع `inside.txt`، ثمّ عجز عن العبور ليسأل عن تفاصيله فاشتكى `fts_read`؛ و`cat` لم يستطع أصلًا أن يعبر إلى الملفّ. الآن أعِد `x` وانزع `r` وحدها، وراقب كيف ينقلب كلُّ شيء:

#session("chmod +x docs; chmod -r docs; ls docs", output: "ls: docs: Permission denied")
#session("cat docs/inside.txt", output: "inside")

انظر العجب: رُفض السردُ ونجح الفتح! لأنّك تملك العبور (`x`) وتعرف الاسم، فتعبر إليه مباشرةً دون حاجةٍ إلى فهرس. والجملةُ التي تلخّص التجربة: `r` يعطيك *فهرس* المجلّد، و`x` يعطيك *مفتاح بابه*.

#warn[
  المفاجأة الأشيع: قد تملك `w` على *ملفٍّ* ولا تستطيع حذفه؛ لأنّ الحذف في الحقيقة تعديلٌ *للمجلّد* الحاوي — إذ يُزال اسمُ الملفّ من سجلّه — فيتطلّب `w` على المجلّد لا على الملفّ. تذكّر هذا حين يحيّرك رفضُ الحذف.
]

#try-it[
  أنشئ `mkdir docs && echo inside > docs/inside.txt`، ثمّ كرّر التجربتين أعلاه بيدك: انزع `x` بـ`chmod -x docs` وجرّب `ls docs` و`cat docs/inside.txt`؛ ثمّ `chmod +x docs; chmod -r docs` وأعِدهما. أعِد الحال بعدها بـ`chmod +rx docs`. لن تنسى الفرق بين الفهرس والمفتاح بعد اليوم.
]

#section[`chmod`: ضبط الأذون]

أمرُ تغيير الأذون اسمه `chmod`، اختصارُ change mode أي «غيّر النمط». وله صيغتان تفعلان الشيء نفسه: رمزيّةٌ سهلة القراءة، وعدديّةٌ سريعة الكتابة.

#subsection[الصيغة الرمزيّة: مَن، ثمّ العامل، ثمّ الأذون]

تركيبها ثلاثة أجزاءٍ متلاصقةٍ بلا مسافات: *مَن* (`u` أو `g` أو `o` أو `a`)، ثمّ *العامل* (`+` يضيف، و`-` يسحب، و`=` يثبّت ما ذكرتَ ويمحو ما عداه)، ثمّ *الأذون* (خليطٌ من `r` و`w` و`x`).

```sh
chmod u+x deploy.sh      # امنح المالك التنفيذ
chmod go-w report.txt    # اسحب الكتابة عن المجموعة والآخرين
chmod a=r public.txt     # للجميع قراءةٌ فقط، ولا شيء سواها
chmod ug+rw,o-rwx s.txt  # تعديلان تفصل بينهما فاصلة
```

اقرأ كلَّ سطرٍ كجملةٍ مفهومة. والفرق بين `+` و`=` جوهريّ: الأوّل *يُضيف* فوق الموجود، والثاني *يَجُبّ* ما قبله فيثبّت ما ذكرتَ وحده.

#subsection[الصيغة العدديّة: ثلاثة أرقامٍ لا أكثر]

هذه لغة المحترفين، وأساسها أنّ لكلّ إذنٍ وزنًا: `r` تساوي `4`، و`w` تساوي `2`، و`x` تساوي `1`. تجمع أوزان ما مُنِح في كلّ ثلاثيّةٍ فيخرج رقمٌ واحدٌ من `0` إلى `7`:

#table(
  columns: (auto, auto, auto, auto, auto, auto, auto, auto),
  align: center,
  table.header([`7`], [`6`], [`5`], [`4`], [`3`], [`2`], [`1`], [`0`]),
  [`rwx`], [`rw-`], [`r-x`], [`r--`], [`-wx`], [`-w-`], [`--x`], [`---`],
)

وبما أنّ الفئات ثلاث، فالأمر ثلاثةُ أرقام: الأوّل للمالك، والثاني للمجموعة، والثالث للآخرين:

```sh
chmod 755 script.sh          # rwx r-x r-x
chmod 644 note.txt           # rw- r-- r--
chmod 600 ~/.ssh/id_ed25519  # rw- --- ---  مفتاحٌ لك وحدك
chmod -R 755 site            # -R يغوص في المجلّد وكلّ ما تحته
```

فـ`755` شائعٌ للمجلّدات وللبرامج، و`644` للملفّات العاديّة، و`600` لمفتاحٍ سرّيّ. والجسر بين الصيغتين بسيط: حوّل كلّ ثلاثيّةٍ إلى رقمها، فـ`rw-r-xr--` تصير `654`. تمرّن على التحويل في الاتّجاهين حتى يصير آليًّا.

#danger[
  `chmod 777` يفتح العنصر للعالم أجمع: كلُّ مستخدمٍ يقرأ ويكتب وينفّذ. إيّاك أن تعتاده حلًّا سريعًا كلّما ضاق بك أمرٌ برسالة `Permission denied`؛ فهو ثغرةٌ صريحة، وكثيرٌ من الاختراقات بدأ بها. القاعدة دائمًا: امنح *أقلّ* إذنٍ يكفي للعمل، لا أوسعه.
]

#section[الملكيّة: `chown` و`chgrp`]

الأذون تجيب عن «ماذا يُسمح»، أمّا «لِمَن» فيضبطه أمران: `chown` يغيّر المالك (وقد يغيّر المجموعة معه)، و`chgrp` يغيّر المجموعة وحدها.

```sh
chown layla file.txt        # اجعل المالك layla
chown layla:staff file.txt  # مالكٌ ومجموعةٌ معًا
chgrp admin file.txt        # المجموعة وحدها
```

لكن جرّب أوّلَ أمرٍ على ملفٍّ تملكه، وانظر ماذا يحدث فعلًا:

#session("chown root note.txt", output: "chown: note.txt: Operation not permitted")

القاعدة صارمةٌ ومنطقيّة، وتنصّ عليها صفحةُ دليل `chown`: *إهداءُ ملفٍّ لمستخدمٍ آخر لا يجوز إلّا لمدير النظام*. ولو أمكن لأيّ أحدٍ أن ينسب ملفّاته لغيره لانهار نظام الملكيّة. لذا يسبق `chown` غالبًا أمرُ الصلاحيّة، وهو موضوع الفصل التالي: الجذر: su وdoas وwheel. أمّا `chgrp` فأرحم: ينقل ملفّك إلى مجموعةٍ *أنت عضوٌ فيها*، ويردّك عمّا سواها.

#danger[
  احذر `chown -R` و`chmod -R` على مسارٍ خاطئ. جملةٌ واحدةٌ في غير موضعها — كأن تكتب `/` بدل `./` — تقلب ملكيّة ملفّات النظام رأسًا على عقب فتتعطّل الخدمات وتسجيلُ الدخول. اقرأ المسار مرّتين قبل أن تضغط #kbd("Enter").
]

#distro[
  فرقٌ صامتٌ تذكره صفحةُ دليل `chmod` نفسها: على FreeBSD وسائر أنظمة BSD يرث الملفُّ الجديد *مجموعةَ المجلّد الحاوي*، لا مجموعةَ مُنشئه. وقد ترى هذا حيًّا في `/tmp`: أنشئ فيه ملفًّا فيخرج لمجموعة `wheel` وإن كانت مجموعتُك `ghazi`، لأنّ `/tmp` مملوكٌ لها فورّثها المولودَ فيه. أمّا لِينُكس فيمنح الملفَّ مجموعةَ مُنشئه الأساسيّة، ولا يرث مجموعةَ المجلّد إلّا إذا وُضعت عليه بتُّ `setgid`. ومعنى ذلك أنّ حيلة `setgid` الشهيرة على لِينُكس لمجلّدات الفرق أقلُّ حاجةً إليها هنا.
]

#section[`umask`: من أين جاء `644`؟]

لماذا يولد ملفُّك النصّيّ الجديد بـ`644`، ومجلّدُك الجديد بـ`755`؟ الجواب قناعٌ يُدعى `umask`.

#define("umask", [
  قناعٌ يحدّد الأذون التي *تُحجَب* آليًّا عن كلّ عنصرٍ جديد. لا يمنح شيئًا أبدًا؛ بل يطرح. وقيمته النمطيّة على BSD هي `022`.
])

يبدأ النظام من قاعدةٍ سخيّة — `666` للملفّات و`777` للمجلّدات — ثمّ يطرح ما يشير إليه القناع. فبقناع `022` تُسحَب الكتابة (وزنها `2`) من المجموعة والآخرين ولا يُمسّ المالك: فيصير الملفّ `644` والمجلّد `755`. ولاحظ لماذا لا يولد الملفّ العاديّ بإذن تنفيذٍ أبدًا: لأنّ قاعدته `666` خاليةٌ من `x` أصلًا، وهذا حكيمٌ فالنصوص لا تُشغَّل.

تكتب `umask` وحدها فتردّ بالرقم مجرّدًا؛ وتضيف `-S` (اختصار symbolic) فتردّ بما *يبقى* مسموحًا بعد الطرح لا بما حُجب:

#session("umask", output: "0022")
#session("umask -S", output: "u=rwx,g=rx,o=rx")

ولتشديد الخصوصيّة اضبط قناعًا أوسع: `umask 077` يجعل كلَّ جديدٍ لك وحدك (ملفٌّ `600` ومجلّدٌ `700`). لكنّ الضبط يدوم للجلسة الحاليّة؛ ولتثبيته يُوضع في إعداد صدفتك أو صنف دخولك، وذلك موضوع فصل البيئة وتخصيص الصدفة.

#try-it[
  في مجلّدٍ خالٍ: نفّذ `umask` و`umask -S` وسجّل جوابيهما. ثمّ `touch a.txt` و`mkdir d` وافحصهما بـ`ls -l a.txt` و`ls -ld d`: هل خرجا بـ`644` و`755`؟ الآن `umask 077` وكرّر بأسماءٍ جديدة وقارن. وأخيرًا تدرّب على الجسر: `chmod 640 a.txt` ثمّ اقرأ الناتج، وأعِد الأذون نفسها رمزيًّا `chmod u=rw,g=r,o= a.txt` وتأكّد أنّ السطر لم يتغيّر. وحين تغلق الجلسة يعود القناع إلى `022` وحده.
]

#section[البتّات الخاصّة الثلاث]

فوق الأذون التسعة، ثلاثُ بتّاتٍ خاصّةٍ تحلّ مشكلاتٍ دقيقة. لن تُنشئها كثيرًا، لكنّ قراءتها في `ls -l` مهارةٌ لازمة. أوّلها *setuid*: تجعل الملفَّ التنفيذيّ يعمل — أثناء تشغيله — بصلاحيّة *مالكه* لا بصلاحيّة مَن شغّله. افحص أمرًا حيًّا:

#session("ls -l /usr/bin/su", output: "-r-sr-xr-x  1 root  wheel  121904 Jul 24 09:38 /usr/bin/su")

انظر إلى `s` مكان `x` في ثلاثيّة المالك: هذا هو setuid. والأمر `su` — وله فصلٌ يليه هو فصل الجذر: su وdoas وwheel — يحتاج أن يبدّل هويّتك إلى الجذر، وذلك امتيازٌ لا تملكه أنت؛ فهو مملوكٌ لـ`root` وعليه هذه البتّة، فيستعير سلطة مالكه لحظةَ تشغيله. وتُضبَط رمزيًّا بـ`u+s` أو عدديًّا برقمٍ رابعٍ يسبق الثلاثة: `4755`.

وأمّا *setgid* فأختُها بصلاحيّة المجموعة، وتظهر `s` في ثلاثيّة المجموعة كما في `write`:

#session("ls -l /usr/bin/write", output: "-r-xr-sr-x  1 root  tty  119200 Jul 24 09:38 /usr/bin/write")

فالأمر `write` يرسل رسالةً إلى طرفيّة مستخدمٍ آخر، والكتابةُ إلى أجهزة الطرفيّات محصورةٌ في مجموعة `tty`؛ فمُنح `write` عضويّتها لحظةَ تشغيله. وأمّا *البتّة اللاصقة* (sticky) فتُوضَع على المجلّدات المشتركة: تمنع مَن يكتب في المجلّد أن يحذف ملفّات *غيره*، فلا يحذف الملفَّ إلّا مالكُه أو مالك المجلّد. وأشهر مثالٍ حيٍّ عليها `/tmp`:

#session("ls -ld /tmp", output: "drwxrwxrwt  22 root  wheel  512 Jul 24 09:39 /tmp")

الحرف الأخير `t` مكان `x` هو البتّة اللاصقة. `/tmp` مفتوحٌ للكتابة للجميع لأنّ كلّ برنامجٍ يحتاج مكانًا مؤقّتًا؛ ولولا اللصق لمحا أيُّ مستخدمٍ ملفّاتِ جاره المؤقّتة. وتُضبَط رمزيًّا بـ`+t` أو عدديًّا بـ`1777`.

#note[
  إن ظهر الحرف الخاصّ *كبيرًا* (`S` أو `T` بدل `s` و`t`) فذلك يعني أنّ إذن التنفيذ `x` الأصليّ *غيرُ* ممنوحٍ في تلك الثلاثيّة. فالحرف الصغير يجمع البتّة الخاصّة مع تنفيذٍ قائم، والكبير يشير إلى بتّةٍ بلا تنفيذ — وهي غالبًا خطأٌ غير مقصود.
]

#danger[
  بتّة setuid على ملفٍّ يملكه `root` سيفٌ حادّ: إن كان في البرنامج ثغرةٌ واحدة، صار بابًا لاختراق النظام كلِّه لأنّ المهاجم يرث سلطة `root` منه. لا تضعها إلّا حين تفهم تمامًا لماذا، وتجنّبها كليًّا على السكربتات — وكثيرٌ من أنظمة BSD تتجاهلها على السكربتات أصلًا لهذا السبب.
]

#section[ما تنفرد به BSD: أعلام الملفّات]

كلُّ ما مضى مشتركٌ بين BSD ولِينُكس وماك. أمّا ما يلي فهو ختمُ عائلة BSD: طبقةٌ ثانيةٌ تعلو على `rwx`، تُغرَز في العنصر فتقيّده بصرف النظر عن أذونه وعن مالكه.

#define("عَلَم الملفّ (file flag)", [
  رايةٌ تُلصَق بالعنصر في نظام الملفّات نفسِه، فتفرض قيدًا يعلو على أذون `rwx` كلِّها. منها ما يضبطه المالك (أعلامُ المستخدم، تبدأ بـ`u`)، ومنها ما لا يضبطه إلّا الجذر (أعلامُ النظام، تبدأ بـ`s`). تُضبَط بأمر `chflags` وتُقرأ بالخيار `-o` في `ls`.
])

أبسطُها `uchg` (اختصار user immutable أي «غير قابلٍ للتغيير»). ضعه على ملفٍّ تملكه، ثمّ حاول حذفه:

#session("chflags uchg a.txt", output: none)
#session("ls -lo a.txt", output: "-rw-r--r--  1 ghazi  ghazi  uchg 0 Jul 24 09:38 a.txt")
#session("rm a.txt", output: "rm: a.txt: Operation not permitted")

تأمّل السطر: الأذون `rw-r--r--` تقول إنّ المالك يكتب، والمالك أنت، ومع ذلك رُفض الحذفُ *وكذلك الكتابة* — لأنّ العَلَم يعلو على الأذون. وظهر العَلَمُ نصًّا (`uchg`) في عمودٍ جديدٍ بين المجموعة والحجم، أظهره الخيار `-o`. تنزعه بالبادئة `no`:

#session("chflags nouchg a.txt", output: none)

#note[
  عمودُ الأعلام يظهره الخيار `-o` على FreeBSD. لكن انتبه لفرقٍ حقيقيٍّ بين فروع العائلة: على ماك (Darwin) صار `-o` الصغير يعني «احذف عمود المجموعة»، ونقلوا إظهار الأعلام إلى `-O` الكبير؛ فإن جرّبتَ على ماك فاكتب `ls -lO`. وهذا مثالٌ حيٌّ على قيمة قاعدةٍ رسّخناها: عند الشكّ، `man ls` على *نظامك أنت*.
]

#subsection[`sappnd`: سجلٌّ يُكتَب ولا يُمحى]

عَلَمٌ آخر شديد النفع للسجلّات: `uappnd` (append-only للمستخدم) وأخوه `sappnd` (للنظام). يسمحان بالإضافة إلى نهاية الملفّ ويمنعان محوَ ما سبق أو الكتابةَ فوقه. جرّب نسخة المستخدم:

#session("chflags uappnd notes.log", output: none)
#session("echo line2 >> notes.log", output: "(نجح: الإلحاق مسموح)")
#session("echo wipe > notes.log", output: "notes.log: Operation not permitted")

الإلحاق (`>>`) نجح، والكتابةُ فوق الملفّ (`>`) رُفضت. وهنا تتجلّى قيمةُ `sappnd` الحقيقيّة: يضعه الجذرُ على سجلّات النظام في `/var/log` (لاحظ محثّ الجذر `#` في مقابل محثّك `$`):

#session("chflags sappnd /var/log/auth.log", output: none, prompt: "#")

فيصير السجلُّ *دليلًا لا يُعبَث به* — يستطيع مهاجمٌ اخترق الجذر أن يُلحق، لكنّه لا يستطيع أن يحذف أثره السابق. وهذا وحده أساسٌ من أسس التحقيق الجنائيّ الرقميّ.

#subsection[`schg` و`securelevel`: علمٌ يعلو على الجذر]

نبلغ الآن أعمق ما في الباب. `schg` (اختصار system immutable) هو `uchg` لكن *لا يضبطه إلّا الجذر*. حاوِله مستخدمًا عاديًّا فيُرَدّ:

#session("chflags schg secret.txt", output: "chflags: secret.txt: Operation not permitted")

فإذا وضعه الجذرُ على ملفٍّ حسّاسٍ — كثنائيّةٍ نظاميّةٍ أو ملفّ إعداد — صار الملفّ غيرَ قابلٍ للتغيير حتى للجذر نفسِه ما لم يُنزَع العَلَمُ أوّلًا. وهنا يدخل *مستوى الأمان*، وهو ما يجعل هذه الرايةَ مختلفةً عن كلّ ما رأيتَه:

#define("securelevel", [
  عددٌ في نواة BSD يرتفع كلّما اشتدّ التأمين. عند `1` فما فوق، *يعجز الجذرُ نفسُه عن نزع* أعلام `schg` و`sappnd`، ولا يُخفَض هذا العدد ما دام النظام يعمل، فلا سبيل إلى إعادته إلى قيمته الدنيا إلّا بإقلاع النظام في طوره الأحاديّ (single-user). يُقرأ بـ`sysctl kern.securelevel`، وتفصيله في فصل أمن BSD المدمج.
])

#session("sysctl kern.securelevel", output: "kern.securelevel: 0")

عند `securelevel` صفرٍ أو أقلّ (وهو حال محطّة العمل العاديّة) يستطيع الجذر أن ينزع `schg` متى شاء. لكنّ خادمًا محصَّنًا يُرفَع مستواه إلى `1` عند الإقلاع — يُضبَط ذلك في `rc.conf`، وهو موضوع فصل نظام rc — فيصير أثرُ `schg` هذا: ثنائيّاتُ النظام المختومةُ به لا يستطيع أحدٌ استبدالها، *ولا الجذر*، ما دام النظام يعمل عملَه المعتاد. ولو اقتحم مهاجمٌ الجذرَ عبر ثغرةٍ في خدمة، لَما استطاع أن يزرع بابًا خلفيًّا في `/bin/login` المختوم. هذا هو «القفل الذي سلّم مديرُ المتحف مفتاحه» في فاتحة الفصل.

#danger[
  هذا سلاحٌ ذو حدّين، ونقطةُ ارتباكٍ شهيرة. إن ختمتَ ملفًّا بـ`schg` ثمّ رفعتَ `securelevel`، فلن تستطيع تعديله ولا حذفه *بأيّ حال* والنظامُ يعمل — لا `sudo` ولا `doas` ينفعك، فالقيد في النواة لا في الأذون. السبيلُ الوحيد أن تُقلع في الطور الأحاديّ (حيث يهبط `securelevel` إلى `-1`)، فتنزع العَلَم، ثمّ تعود. فلا ترفع المستوى على خادمٍ بعيدٍ لا تصل إلى وحدة تحكّمه الفيزيائيّة إلّا وأنت تفهم تمامًا كيف ستُنزِله. رسالةُ `Operation not permitted` — لا `Permission denied` — هي علامةُ أنّ الرادَّ عَلَمٌ أو مستوى أمان، لا أذون.
]

وثمّة أعلامٌ أخرى تراها في المتن: `nodump` يُعفي الملفَّ من النسخ الاحتياطيّ بأداة `dump` (لملفّات الكاش والمؤقّتات الضخمة التي لا معنى لحفظها)، و`uunlnk` يمنع الحذف دون أن يمنع التعديل. وقد يجتمع على العنصر الواحد أكثرُ من عَلَمٍ معًا، فتقرأها كلَّها بأداة `stat` وصيغتها `-f` التي تنتقي الحقول: `%N` للاسم و`%Sf` للأعلام نصًّا. فلو حمل ملفٌّ عَلَمَي `uchg` و`nodump` معًا رأيتهما مفصولين بفاصلة:

#session("stat -f '%N: %Sf' a.txt", output: "a.txt: uchg,nodump")

#note[
  ليست صدفةً أنّ أسماء أعلام `chflags` تطابق أسماء رايات النواة (`UF_IMMUTABLE` و`SF_IMMUTABLE`)، وأنّ صفحةَ `chflags(1)` تحيل في «انظر أيضًا» إلى `security(7)` حيث يُشرَح مستوى الأمان. فهذا أثرٌ من فلسفة BSD المحوريّة: النواةُ وأدواتُ الأساس والتوثيق تُطوَّر معًا في *مستودعٍ واحد* كنظامٍ متكامل، لا «نواةٌ + أدواتٌ منفصلة» كلِينُكس. ومن هنا يأتي تماسكُ المنظومة ووضوحُ توثيقها.
]

#try-it[
  في مجلّدٍ تجريبيّ: `touch a.txt` ثمّ `chflags uchg a.txt`. افحصه بـ`ls -lo a.txt` (على ماك `ls -lO`) وابحث عن `uchg` في العمود الجديد. حاول `rm a.txt` و`echo x >> a.txt`: ستُرَدّ بـ`Operation not permitted` في الحالتين رغم ملكيّتك. اقرأ العَلَمَ أيضًا بـ`stat -f '%N: %Sf' a.txt`. ثمّ انزعه `chflags nouchg a.txt` واحذفه. جرّب بعدها `chflags schg b.txt` على ملفٍّ آخر وتأمّل الرفض: `schg` علمُ نظامٍ لا يضبطه إلّا الجذر.
]

#distro[
  على لِينُكس يقابل الأعلامَ أمرا `chattr` و`lsattr` على نظام ملفّات مثل ext4: فالسمة `+i` تشبه `uchg`/`schg` (immutable)، و`+a` تشبه `uappnd`/`sappnd` (append-only). لكنّ الفرق الجوهريّ أنّ لِينُكس لا `securelevel` فيه: الجذر يستطيع دائمًا أن ينزع `+i` (ما دام يملك القدرة `CAP_LINUX_IMMUTABLE`)، فلا رايةَ تعلو على الجذر كما تعلو `schg` عند مستوى أمانٍ مرتفع. هذا القيدُ الذي يُلجِم الجذرَ نفسَه من أخصّ ما يميّز نموذج BSD. أمّا OpenBSD فيمضي أبعد: يرفع `securelevel` إلى `1` تلقائيًّا في الطور متعدّد المستخدمين، فتكون أعلام `schg` مقفلةً افتراضًا لا اختيارًا.
]

#section[قوائم ACL: حين لا تكفي الفئات الثلاث]

نظام «مالكٍ ومجموعةٍ وآخرين» أنيقٌ لكنّه ضيّق: ماذا لو أردتَ أن تمنح *شخصًا واحدًا بعينه* — ليس المالك ولا في المجموعة — حقَّ القراءة، دون أن تفتح الملفّ للآخرين جميعًا؟ هنا تدخل قوائم ACL.

#define("قائمة التحكّم بالوصول (ACL)", [
  اختصار Access Control List: قائمةٌ من المُدخَلات تُلحَق بالعنصر، كلُّ مُدخَلةٍ تذكر مستخدمًا أو مجموعةً بعينها ثمّ أذونها. تُوسّع نظامَ `rwx` بلا أن تلغيه، وعلامتها في `ls -l` هي `+`. تُقرأ بـ`getfacl` وتُكتَب بـ`setfacl`.
])

وهنا يفترق نظاما ملفّات BSD الكبيران في *نموذج* القائمة. فعلى UFS النموذجُ هو POSIX (يُسمّى POSIX.1e): بسيطٌ، مبنيٌّ على `rwx` نفسها موزّعةً على أفرادٍ ومجموعات. أنشئ ملفًّا وامنح `layla` وحدها حقَّ الكتابة:

#session("setfacl -m u:layla:rw file.txt", output: none)
#session("getfacl file.txt", output: "# file: file.txt
# owner: ghazi
# group: ghazi
user::rw-
user:layla:rw-
group::r--
mask::rw-
other::r--")

ظهرت مُدخَلةٌ باسم `layla` صريحةً، وظهر سطرُ `mask` وهو سقفٌ يحدّ أقصى ما تمنحه المُدخَلاتُ المسمّاة. وستجد علامة `+` قد لحقت بأذون الملفّ في `ls -l` إشعارًا بوجود قائمة. تُحذَف المُدخَلة بـ`setfacl -x u:layla file.txt`، وتُمسح القائمة كلُّها بـ`setfacl -b file.txt`.

#note[
  على UFS قد تحتاج إلى تمكين ACL أوّلًا (خيارُ `acls` عند الوصل، أو `tunefs -a enable`)، وتفصيلُه في فصل الأقراص وUFS وGEOM. أمّا على ZFS فالقوائم حاضرةٌ دائمًا بلا إعداد.
]

أمّا على ZFS فالنموذج أغنى بكثير: NFSv4، وهو نفسه نموذج ماك ووِندوز. بدل ثلاثة أذونٍ فقط تملك أكثر من عشرة أذونٍ دقيقة، وتستطيع أن تمنع (`deny`) صراحةً لا أن تمنح فحسب:

#session("getfacl doc.txt", output: "# file: doc.txt
# owner: ghazi
# group: ghazi
    owner@:rw-p--aARWcCos:-------:allow
    group@:r-----a-R-c--s:-------:allow
 everyone@:r-----a-R-c--s:-------:allow")

كلُّ سطرٍ مُدخَلةٌ من أربعة حقولٍ يفصلها النقطتان: *مَن*، ثمّ *الأذون الدقيقة* (لكلّ إذنٍ حرفُه: `r` قراءة، `w` كتابة، `p` إلحاق، `a` قراءة السمات، `c` قراءة القائمة، `o` تغيير الملكيّة...)، ثمّ *الوراثة*، ثمّ الحكمُ `allow` أو `deny`. وتُضاف مُدخَلةٌ في موضعٍ معلومٍ برقمها:

#session("setfacl -a 0 user:layla:rwx::allow doc.txt", output: none)

والمُدخَلات تُقيَّم *بترتيب ظهورها*: أوّلُ ما ينطبق يحكم، والترتيبُ بيدك عبر رقم الموضع (لاحظ `0` أعلاه). فإن أردتَ لمُدخَلة `deny` أن تحسم، قدّمها بنفسك على مُدخَلات المنح. وهنا فرقٌ دقيقٌ عن ماك ووِندوز: هما يعيدان رصَّ القائمة تلقائيًّا ليتقدّم المنعُ دائمًا، أمّا FreeBSD فيحترم ترتيبك كما كتبتَه ويقيّم المُدخَلات بترتيبها الظاهر.

#distro[
  على لِينُكس تجد نموذج POSIX ACL نفسَه، وبالأمرين نفسيهما `getfacl` و`setfacl` — فالاصطلاح مشتركٌ ورثه الطرفان. لكنّ نموذج NFSv4 الغنيّ (بحقّ `deny` الصريح وأذونه العشرة) لا تراه على لِينُكس إلّا في أنظمة ملفّاتٍ خاصّةٍ كـZFS المنقول إليه؛ أمّا ext4 فيقف عند POSIX الأفقر الذي لا `deny` فيه. فحين تنتقل بين النظامين احذر أن تظنّ كلَّ ACL سواء.
]

#section[خلاصة الفصل]

صارت بطاقةُ كلِّ ملفٍّ مقروءةً بين يديك. تقرأ محارف `ls -l` العشرة: نوعًا ثمّ ثلاثيّاتٍ للمالك والمجموعة والآخرين، وتعرف أنّ `r` و`w` و`x` تنقلب معانيها على المجلّد فـ`r` فهرسُه و`x` مفتاحُ بابه. وتضبط الأذون بـ`chmod` رمزيًّا وعدديًّا وتحسب الثمانيّ في رأسك، وتنقل الملكيّة بـ`chown` و`chgrp` عالمًا متى يلزمك الجذر، وتفهم من أين جاء `644` عبر `umask`، وتميّز البتّات الخاصّة الثلاث ولماذا كان `/tmp` لاصقًا.

ثمّ بلغتَ ما تنفرد به عائلة BSD: أعلامَ الملفّات عبر `chflags` — `uchg` يعلو على المالك، و`sappnd` يصنع سجلًّا لا يُمحى، و`schg` يعلو على الجذر نفسِه حين يرتفع `securelevel` فلا يُنزَع إلّا في الطور الأحاديّ — تقرأها كلَّها بـ`ls -lo` وبـ`stat -f`. وأنهيتَ بقوائم ACL: نموذجُ POSIX البسيط على UFS، ونموذجُ NFSv4 الغنيّ على ZFS بحقّ المنع الصريح وأذونه الدقيقة، كلاهما بأمرَي `getfacl` و`setfacl`. وخرجتَ بقاعدةٍ تشخيصيّةٍ تختصر الفصل: `Permission denied` تعالجها بـ`chmod`، و`Operation not permitted` تبحث لها في عَلَمٍ أو مستوى أمان. وقد لاحظتَ أنّ كثيرًا من أفعال هذا الفصل يقف عند عتبةٍ واحدة: سلطةُ الجذر. وهي بالضبط موضوع الفصل التالي: الجذر: su وdoas وwheel.

#challenge[
  ثلاث مسائل، كلُّها في مجلّدٍ تجريبيٍّ تنشئه ثمّ تحذفه:

  (1) أنشئ `report.txt` واضبط أذونه بحيث يقرأه ويكتبه المالك، وتقرأه المجموعة فقط، ولا يملك الآخرون شيئًا — اكتب الأمر بالصيغتين الرمزيّة والعدديّة، وتحقّق بـ`ls -l` أنّ السطر واحدٌ في الحالتين. ثمّ اقلب السؤال: أيّ قناع `umask` يجعل هذه الأذون هي الافتراض لكلّ ملفٍّ جديد؟

  (2) اختبار العَلَم فوق الأذون: `touch lock.txt` ثمّ `chflags uchg lock.txt`. حاول الآن ثلاثة أشياء وسجّل نتيجة كلٍّ حرفيًّا: `echo x >> lock.txt`، و`rm lock.txt`، و`chmod 777 lock.txt`. أيُّها نجح وأيُّها رُدّ؟ وأيَّ رسالةٍ رأيتَ — `Permission denied` أم `Operation not permitted`؟ فسّر لماذا لم ينفعك حتى `chmod 777`. ثمّ انزع العَلَم واحذف الملفّ.

  (3) جرّب `chflags schg s.txt` على ملفٍّ تملكه مستخدمًا عاديًّا، وسجّل الرفض. الآن أجب نظريًّا مستعينًا بتعريف `securelevel`: لو كنتَ الجذرَ ووضعتَ `schg` ورفعتَ `securelevel` إلى `1`، فما *السبيلُ الوحيد* لنزع العَلَم بعدها؟ ولماذا لا ينفع `doas` ولا إعادةُ الإقلاع العاديّة؟ ارجِع إلى `man chflags` و`man 7 security` لتتحقّق من جوابك.
]
