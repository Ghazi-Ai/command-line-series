#chapter[العمليات]

#objectives((
  [تفرّق بين البرنامج الساكن على القرص والعملية الحيّة، وتتسلّق شجرة النسب بـ`PID` و`PPID` حتى الجدّ الأوّل `init` ذي الرقم 1.],
  [تقرأ لقطة النظام بـ`ps` بصيغتيه — البِرْكليّة `aux` والمعياريّة `-ef` — وتصطاد بالاسم بـ`pgrep`، وتراقب النبض حيًّا بـ`top` و`htop`.],
  [تخاطب العمليّات بالإشارات: `TERM` تطلب، و`KILL` تبطش، و`STOP` و`CONT` تجمّد وتُحيي؛ وتنقل مهامّك بين المقدّمة والخلفيّة.],
  [تكشف بأدوات BSD الأصيلة — `sockstat` و`fstat` و`procstat` — مَن يمسك منفذًا أو ملفًّا، وتفهم لماذا لا `/proc` في BSD.],
  [تضبط الأولويّة بـ`nice` و`renice`، وسقوفَ الموارد بـ`limits` و`ulimit`.],
))

تخيّل قبيلةً حيّةً لا سِجِلًّا من أسماء. الاسمُ في دفترٍ قديمٍ حبرٌ ساكن؛ أمّا الإنسانُ الذي يحمله فيمشي ويأكل ويُنجب، له مولدٌ ومنيّة، ويشغل من الأرض حيّزًا ومن الوقت نصيبًا. كذلك برنامجُك: ملفٌّ على القرص اسمٌ في دفتر، فإذا شغّلتَه دبّت فيه الحياةُ وصار *عمليّة* — كائنًا له هويّةٌ وذاكرةٌ ونسب. وفي جهازك الآن مئاتُ هذه الكائنات، تنحدر كلُّها من جدٍّ واحدٍ لا يموت ما دام النظامُ حيًّا، وتتقاسم معالجًا واحدًا توزّع عليه النواةُ لحظاتِها بالعدل. وهذا الفصل يُجلسك حيث تراها كلَّها: تتفقّد أنسابها، وتخاطبها، وتُسكت مَن طغى صوتُه، وترفع هذا وتخفض ذاك.

#section[العملية: البرنامج وقد دبّت فيه الحياة]

الملفُّ التنفيذيّ على قرصك جمادٌ ينتظر. وما إن تشغّله حتى تحجز له النواةُ ذاكرةً، وتمنحه هويّةَ مَن أطلقه، وتقسم له نصيبًا من المعالج. هذه النسخةُ الحيّةُ العاملة هي العملية.

#define("العملية (Process)", [
  برنامجٌ قيدَ التنفيذ في هذه اللحظة، بذاكرته الخاصّة التي لا يشاركه فيها أحد، وهويّته (مالكه)، ومجلّده الحاليّ، وملفّاته المفتوحة، وبيئته. والبرنامج الواحد قد يعمل في عدّة عمليّاتٍ معًا — كنسخةٍ لكلّ اتّصالٍ يخدمه خادم — ولكلٍّ منها ذاكرتُها المعزولة عن أختها.
])

ولأنّ العمليّات كثيرةٌ ومتشابهةُ الأسماء، لا يميّزها النظام بالاسم بل برقمٍ فريد.

#define("معرّف العملية (PID)", [
  رقمٌ صحيحٌ فريدٌ تمنحه النواةُ لكلّ عمليّةٍ عند ولادتها، اختصارًا لـ Process IDentifier. به تشير إليها بلا لبسٍ حين تراقبها أو تخاطبها. ولا يُعاد استعمال الرقم إلّا بعد أن تموت صاحبتُه ويدور العدّادُ دورةً كاملةً في جدول العمليّات — وسعتُه على FreeBSD قيمةُ `kern.maxproc` تقرؤها بـ`sysctl`.
])

#subsection[شجرة النسب حتى الجدّ الأوّل]

لا تولد عمليّةٌ من عدم: كلُّ عمليّةٍ تُنجبها أخرى، فيسجّل النظام لها مع معرّفها *معرّفَ أبيها* — `PPID`، أي Parent PID — فتنتظم العمليّاتُ كلُّها في شجرةِ نسبٍ واحدة. والمتغيّر `$$` يحمل معرّف صدفتك، تقرؤه بـ`echo $$` ثم تسأل عنه:

#session("echo $$", output: "1287")

#session("ps -o pid,ppid,comm -p 1287", output: "  PID  PPID COMM
 1287  1042 /bin/sh")

صدفتُك ابنةُ ما أطلقها — طرفيّةٍ، أو `login`، أو `sshd` عبر الشبكة — وذاك ابنُ غيره، صعودًا حتى جذرٍ لا أبَ له معرّفُه 1:

#session("ps -o pid,ppid,user,comm -p 1", output: "  PID  PPID USER COMM
    1     0 root /sbin/init")

#define("العملية الأولى (init)", [
  أوّلُ عمليّةٍ تُطلقها النواةُ بيدها عند الإقلاع على أنظمة BSD، ملفُّها `/sbin/init`، معرّفُها 1 ومالكها الجذر. منها تنحدر كلُّ عمليّةٍ أخرى، فهي جذرُ الشجرة الذي لا يموت ما دام الجهاز يعمل. تُشغّل نصوصَ الإقلاع في `rc`، وتُنشئ نوافذ الدخول من `/etc/ttys`، وتتبنّى اليتامى. ولها فصلٌ كاملٌ لاحقًا هو «نظام rc وrc.conf والخدمات».
])

وهنا فرقٌ جوهريٌّ: العمليّة الأولى برنامجٌ صغيرٌ عريقٌ اسمُه `init` — وهذا اتّساقُ نظام الأساس الواحد: أدواتٌ صغيرةٌ تتعاون، لا مارِدٌ يبتلع المهامّ.

#distro[
  الجذرُ رقمُه 1 في كلّ يونِكس، لكنّ ساكنَه يختلف. على كلِّ فروع BSD هو `/sbin/init` العريق. وعلى أكثر توزيعات لِينُكس الحديثة حلّ محلَّه `systemd` — عملاقٌ يدير الخدمات والسجلّات والأجهزة معًا. وعلى ماك (Darwin، سليلِ BSD) هو `launchd`. والجوهرُ واحد: عمليّةٌ أولى لا أبَ لها، تتبنّى كلَّ يتيم.
]

#deep[
  ماذا لو مات الأبُ قبل ابنه؟ لا يموت الابن، بل *يُيَتَّم* فيتبنّاه فورًا صاحبُ المعرّف 1، فترى `PPID` وقد تحوّل إلى 1. والحالُ المعاكسة *الزومبي* (`Z` في `STAT`): عمليّةٌ ماتت ولم يقرأ أبوها رمزَ خروجها بعد، فيبقى سجلُّها لا يستهلك شيئًا لكنّه يحجز رقمًا حتى ينتبه أبوه.
]

#try-it[
  نفّذ `echo $$` لتعرف معرّف صدفتك، ثم `ps -o pid,ppid,comm -p` متبوعًا بذلك الرقم. خذ `PPID` الذي ظهر لك واسأل عنه بالأمر نفسه، وكرّرها مع كلّ `PPID` جديدٍ حتى تبلغ 1. كم قفزةً لزمتك؟ لقد تسلّقتَ للتوّ شجرة نسب جهازك من ورقةٍ إلى جذر.
]

#section[`ps`: لقطةٌ لكلّ ما يجري]

الأداة الأمّ لرؤية العمليّات اسمها `ps` (اختصار Process Status)، وهي *لقطةٌ* لا فيلم: تصوّر حال النظام في لحظةٍ ثم تعيدك إلى المحثّ. ووحدَها بلا خيارات لا تُظهر إلّا عمليّاتِك المرتبطةَ بطرفيّة. وتقبل صيغتين ورثتْهما من عائلتين:

```sh
ps aux      # الصيغة البِرْكليّة: بلا شَرطة
ps -ef      # صيغة POSIX: بشَرطة
```

الصيغةُ *البِرْكليّة* (BSD) هي لغةُ هذا النظام الأصليّة، وفيها تلتصق الحروف بلا شَرطة: `a` كلُّ المستخدمين، و`u` عرضٌ غنيٌّ يُظهر المالك واستهلاك الموارد، و`x` حتى ما لا يرتبط بطرفيّة — وهي أغلبُ خدمات النظام. أمّا *المعياريّة* (POSIX) فبشَرطة: `-e` كلُّ العمليّات، و`-f` عرضٌ كامل يُظهر `PPID`. الأولى أعرقُ وأشهرُ هنا، والثانية أضمنُ في سكربتٍ ينتقل بين الأنظمة. ولا تخلط بينهما: فالشَّرطةُ في `ps -aux` تجعل `u` تعني «مستخدمًا بعينه»، فيظنّ `ps` أنّك تسأل عن مستخدمٍ اسمه `x`.

#note[
  على BSD ليست `ps` و`top` و`kill` و`sockstat` و`procstat` أدواتٍ متفرّقةً جمعها التوفيق، بل جزءٌ من *نظام الأساس الواحد* — نواةٌ وأدواتٌ وتوثيقٌ تُطوَّر معًا في مستودعٍ واحد — فتتكلّم لغةً واحدةً وتُوثَّق باتّساق. على لِينُكس تأتي `ps` و`top` من حزمة `procps`، و`lsof` و`htop` من مشاريعَ مستقلّة، فيتفاوت اصطلاحُها. تماسكُ أدوات هذا الفصل ثمرةُ فلسفة BSD.
]

#subsection[قراءة الأعمدة]

أعمدةُ `ps aux` هي لغةُ هذا الفصل كلِّه:

#table(
  columns: (auto, 1fr),
  [العمود], [ما يعنيه],
  [`USER`], [المستخدم المالك؛ بهويّته تعمل وبصلاحيّاته تُقيَّد.],
  [`PID`],  [معرّفها الفريد.],
  [`%CPU`], [نصيبها من المعالج، وهو *متوسّطٌ* لا لحظةٌ راهنة.],
  [`%MEM`], [نسبة ما تشغله من الذاكرة الفعليّة.],
  [`VSZ`],  [ذاكرةٌ افتراضيّةٌ محجوزةٌ لها — رقمٌ ضخمٌ ومضلّل.],
  [`RSS`],  [الذاكرة المقيمة في الرام فعلًا (بالكيلوبايت).],
  [`TT`],   [الطرفية المرتبطة بها، و`??` تعني: لا طرفية لها.],
  [`STAT`], [حالُها الآن (انظر أدناه).],
  [`STARTED`], [ساعةُ ولادتها، أو تاريخُها إن طال عمرُها.],
  [`TIME`], [مجموع ما استهلكته من زمن المعالج منذ ولادتها.],
  [`COMMAND`], [الأمر الذي أطلقها بمعطياته كاملة.],
)

#warn[
  لا تفزع من `VSZ` الضخم: الذاكرة الافتراضيّة عنوانٌ محجوزٌ على الورق لا رامٌ مستهلكة، فقد ترى برنامجًا صغيرًا «يحجز» غيغاباياتٍ وهو لا يشغل إلّا ميغاباياتٍ قليلة؛ والعمودُ الصادق هو `RSS`. ومثله `%CPU`: قد يتجاوز مجموعُه المئة على معالجٍ متعدّد النوى، لأنّ لكلّ نواةٍ مئةً كاملة.
]

#subsection[عمود `STAT`: ما الذي تفعله الآن؟]

حرفٌ واحدٌ يلخّص حال العملية، وقد يتبعه حرفٌ أو أكثر يزيده بيانًا:

#table(
  columns: (auto, 1fr),
  [الحرف], [الحال],
  [`R`], [جاهزةٌ للعمل أو تعمل الآن على المعالج.],
  [`S`], [نائمةٌ نومًا خفيفًا تنتظر شيئًا (أقلّ من عشرين ثانية).],
  [`I`], [خاملة: نائمةٌ منذ أكثر من عشرين ثانية.],
  [`D`], [في انتظارٍ لا يُقطع، غالبًا على قرصٍ بطيء.],
  [`T`], [موقوفةٌ مجمّدةٌ بإشارة: لا تعمل ولم تمت.],
  [`Z`], [ميّتةٌ لم يُرفع سجلُّها بعد — «زومبي».],
)

أمّا اللواحق فأشهرُها `+` أي أنّها في مقدّمة الطرفية، و`s` قائدةُ جلسة، و`N` مخفوضةُ الأولويّة، و`<` مرفوعتُها، و`L` قد أقفلت صفحاتٍ في الرام. فحالُ `S+` تعني «نائمةٌ في المقدّمة»، و`SN` «نائمةٌ متنازلةٌ عن أولويّتها».

#subsection[`-o`: اصنع جدولك بنفسك]

نادرًا ما تريد الأعمدة كلَّها، والخيار `-o` يجعلك تختار ما تعرض وترتيبَه:

```sh
ps -o pid,ppid,user,%cpu,stat,comm -p 4711
```

ويرتّب `-r` تنازليًّا حسب المعالج، و`-m` حسب الذاكرة. وانتبه للفرق بين `comm` و`command`: الأولى مسارُ الملفّ التنفيذيّ وحدَه (`/bin/sleep`)، والثانية سطرُ الأمر بمعطياته (`/bin/sleep 300`) — فرقٌ حاسمٌ حين تميّز عمليّتين من البرنامج نفسه. والاسمُ المجرّد كلمتُه `ucomm`.

#distro[
  على لِينُكس يقرأ `ps` بياناتِه من نظام ملفّاتٍ وهميٍّ اسمه `/proc`، فيه مجلّدٌ لكلّ عمليّةٍ تقرأ منه كملفٍّ عاديّ (مثل `cat /proc/1/status`). وفي BSD ليس `/proc` مركّبًا افتراضيًّا؛ فالنواةُ تُسأل عبر واجهاتٍ خاصّة، وكلُّ وصفةٍ تعتمده لن تعمل عندك كما هي.
]

#try-it[
  نفّذ `ps aux | wc -l` لتعرف كم عمليّةً تعمل في جهازك الآن دون أن تشعر — الرقم سيفاجئك. ثم نفّذ `ps -axo pid,%cpu,%mem,comm -r | head -8` وتأمّل الثمانية الأوائل: أتعرفهم كلَّهم؟ اختر أغربَ اسمٍ فيهم واسأل عنه جهازَك بـ`whatis` أو `man`، كما تعلّمتَ في فصل «أن تساعد نفسك».
]

#section[الصيد بالاسم: `pgrep` و`pkill` و`killall`]

تمريرُ `ps aux` إلى `grep` حيلةٌ معيبة: تصطاد سطرَ `grep` نفسه، وتعطيك نصًّا تنقّب فيه عن الرقم بعينك. والأنظفُ أداتان: `pgrep` يبحث فيعطيك المعرّفات، و`pkill` يبحث فيرسل الإشارة رأسًا.

```sh
pgrep -l sshd      # المعرّف والاسم معًا
pgrep -x sh        # مطابقةٌ تامّةٌ للاسم لا جزئيّة
pgrep -n sh        # أحدثُ المطابِقات ولادةً وحدَها
pgrep -o sh        # وأقدمُها ولادةً
pgrep -u ghazi     # ما يملكه مستخدمٌ بعينه
pgrep -P 1287      # أبناء العملية 1287 المباشرون
```

وافتراضًا يطابق `pgrep` *اسم البرنامج* وحده، ويكفيه أن يجد نصَّك جزءًا منه. فإن أردتَ البحث في سطر الأمر كاملًا بمعطياته فأضِف `-f`. و`pkill` توأمُه في الخيارات، لكنّه يرسل بدل أن يعرض:

```sh
pgrep -fl "sleep 500"    # ابحث في سطر الأمر كلِّه لا في الاسم وحده
pkill -x sleep           # أنهِ ما طابق الاسمَ تمامًا
pkill -HUP -x syslogd    # وأرسل HUP لا TERM
```

#warn[
  ما تكتبه لـ`pgrep` ليس نصًّا حرفيًّا بل *تعبيرٌ نمطيّ* موسّع (وله فصل «الترشيح والتعابير النمطية» لاحقًا)، فالنقطة فيه تعني «أيّ حرف» لا النقطة نفسها. ومع `-f` يصير سلاحًا ذا حدّين: لو كتبتَ `pkill -f 77` أصبتَ كلَّ عمليّةٍ يظهر فيها 77 في أيّ موضعٍ من سطرها، ولو في مسارٍ عارض. والقاعدة الذهبيّة: جرّب `pgrep` أوّلًا بالمعطيات نفسها، فإن رضيتَ بالصيد فبدّل الاسمَ إلى `pkill`.
]

#subsection[`killall`: الإنهاء بالاسم دفعةً واحدة]

حين يفتح تطبيقٌ عدّةَ عمليّاتٍ بالاسم نفسه، يصير الصيدُ بالرقم مملًّا. و`killall` يرسل الإشارة إلى *كلّ* عمليّةٍ تحمل الاسم الذي تعطيه؛ جرّبه على هدفٍ من صنعك بعد `sleep 500 &` ثلاث مرّات:

```sh
killall sleep        # TERM إلى كلّ ما اسمه كذلك
killall -9 sleep     # وقاصمةً عند الضرورة القصوى
```

والاسمُ عنده يجب أن يطابق تمامًا — لا جزءًا منه كما في `pgrep` — فإن أخطأتَ في حرفٍ قال لك ذلك صراحةً:

#session("killall SLEEP", output: "No matching processes belonging to you
were found")

#danger[
  `killall` واسعُ الأثر: كلمةٌ واحدةٌ تُنهي عائلةً كاملةً من العمليّات. لا تكتبه إلّا وقد تحقّقتَ من الاسم بـ`pgrep -x` قبله، ولا تسبقه بـ`doas` (رافعِ الصلاحيّة على BSD، وله فصل «الجذر: su وdoas وwheel») وأنت تجرّب فتبلغ به عمليّاتِ النظام لا عمليّاتك. واحذر مكيدةً تاريخيّة: على أنظمة يونِكس العتيقة من طراز System V كان `killall` بلا معطًى يُنهي *كلَّ* عمليّات النظام لإطفائه؛ فلا تجرّبه على نظامٍ غريبٍ ظنًّا أنّه كعادته على BSD حيث يلزمه اسمٌ صريح.
]

#section[`top`: النبض حيًّا]

عيبُ `ps` أنّه صورةٌ ساكنة. أمّا حين تريد أن *تشاهد* النبض وهو ينبض — أيُّ عمليّةٍ تلتهم المعالج الآن؟ ولماذا اشتغلت المراوح فجأة؟ — فأداتُك `top`: شاشةٌ تتجدّد وحدها كلّ ثانية. وهي من أعرق أدوات يونِكس، كتبها ويليام لوفيفر في ثمانينيّات القرن الماضي، وتحمل BSD نسلَها الأصيل في نظام الأساس.

```sh
top -o cpu      # مرتّبةً حسب المعالج تنازليًّا
top -o res      # مرتّبةً حسب الذاكرة المقيمة
```

ويعلو جدولَ العمليّات ملخّصٌ للنظام كلِّه:

#session("top -o cpu", output: "last pid:  4977;  load averages:  0.34,  0.28,  0.24  up 3+02:14:07
72 processes:  1 running, 71 sleeping
CPU:  4.1% user,  0.0% nice,  1.6% system,  0.2% interrupt, 94.1% idle
Mem: 318M Active, 1204M Inact, 512M Wired, 96M Buf, 5960M Free
Swap: 4096M Total, 4096M Free")

سطرُ `load averages` هو *معدّل الحِمل*: متوسّط عدد العمليّات المنتظرة دورَها على المعالج في دقيقةٍ، ثم خمسٍ، ثم خمس عشرة؛ اقرأه منسوبًا إلى عدد النوى عندك، فحِملُ 4 على أربع نوى راحةٌ وعلى نواةٍ واحدةٍ زحام. وسطرُ `CPU` يفصل نصيب برامجك (`user`) عن نصيب النواة (`system`) عن الفراغ (`idle`). وسطرُ `Mem` بلغةِ BSD يقسم الرام: `Active` قيدَ الاستعمال، و`Inact` صفحاتٌ تُسترجَع، و`Wired` مقفلةٌ للنواة، و`Free` حرّة.

وأنت داخل `top` لستَ متفرّجًا؛ فهو يقبل أوامرَ بحرفٍ واحد: `o` ثم مفتاح الترتيب و#kbd("Enter")، و`s` لمدّة التحديث، و`k` لإرسال إشارةٍ إلى معرّفٍ تحدّده، و#kbd("q") للخروج. وللقطةٍ ساكنةٍ تصلح للسكربتات بدل الشاشة الحيّة: `top -b -d 1` يطبع عرضًا واحدًا ثم ينتهي.

#subsection[`htop`: الحقيقةُ نفسها بوجهٍ أرحم]

`top` مقتضبةٌ سريعةٌ من نظام الأساس. وثمّة بديلٌ مجتمعيٌّ أوسعُ راحةً اسمه `htop`: ألوان، وتمريرٌ بالأسهم، واختيارٌ بالنقر، وأشرطةٌ لكلّ نواة. لا يأتي في نظام الأساس، بل تجلبه من مدير الحزم `pkg` الذي يشغل الفصل التالي «الحزم الثنائيّة: pkg»:

```sh
pkg install htop      # يحتاج doas أو الجذر
htop -t               # اعرضها شجرةَ نسبٍ لا قائمةً مسطّحة
```

وأجملُ ما فيه هنا الخيار `-t`: يعرض العمليّات شجرةً متداخلةً ترى فيها بعينك مَن أنجب مَن، حتى تبلغ `init` في القمّة. وداخله تفرز بـ#kbd("F6")، وتُنهي عمليّةً مختارةً بـ#kbd("F9")، وتخرج بـ#kbd("F10"). ولا تعوّد نفسك رفعَ الصلاحيّة لأداةِ عرض: `htop` بلا امتيازٍ يريك عمليّاتِك كاملةً.

#distro[
  على لِينُكس تجد `htop` في مستودعات كلّ توزيعة، ومعه `pstree` ترسم شجرة العمليّات بخطوطٍ في الطرفية. ولا `pstree` في نظام أساس BSD، وأقربُ ما يعوّضها `htop -t`. أمّا `top` نفسها فلكلٍّ نكهتُه: نسخةُ FreeBSD من نسل لوفيفر، وأعادت ماك كتابتَها كتابةً مغايرةً في المخرجات.
]

#try-it[
  شغّل `top -o cpu`، وافتح متصفّحًا أو أطلق عملًا ثقيلًا وراقب مَن يقفز إلى القمّة. ثم — وأنت داخله — اضغط `o` واكتب `res` واضغط #kbd("Enter")، ولاحظ كيف انقلب الترتيبُ كلُّه: أكبرُ آكلي الذاكرة غالبًا ليسوا أكبرَ آكلي المعالج. اخرج بـ#kbd("q").
]

#section[الإشارات: كيف تخاطب عمليّةً حيّة]

لا تُنهي عمليّةً في يونِكس بيدك، ولا تدخل عليها ذاكرتَها. أنت تُرسل إليها *إشارة*: رسالةً قصيرةً موحّدةً تحملها النواةُ نيابةً عنك.

#define("الإشارة (Signal)", [
  إخطارٌ رقميٌّ صغيرٌ ترسله النواةُ إلى عمليّةٍ لتقاطع سيرَها بطلب: أن تنتهي، أو تتجمّد، أو تعيد قراءة إعداداتها. لكلّ إشارةٍ رقمٌ واسمٌ رمزيّ. وأكثرُ الإشارات يستطيع البرنامجُ أن *يلتقطها* فيتصرّف بها كما يشاء — إلّا اثنتين لا تُلتقطان أبدًا.
])

تسرد قائمتها كلَّها بـ`kill -l`، فتراها بأسمائها على ترتيب ترقيمها:

#session("kill -l", output: "HUP INT QUIT ILL TRAP ABRT EMT FPE KILL BUS SEGV SYS
PIPE ALRM TERM URG STOP TSTP CONT CHLD TTIN TTOU ...")

وأهمُّها في العمل اليوميّ ستٌّ:

#table(
  columns: (auto, auto, 1fr),
  [الاسم], [الرقم], [معناها],
  [`HUP`],  [1],  [«أُغلِقت السمّاعة»، وصارت عرفًا تعني: أعِد قراءة إعداداتك.],
  [`INT`],  [2],  [مقاطعةٌ من لوحة المفاتيح — وهي ما يرسله #kbd("Ctrl") + #kbd("C").],
  [`KILL`], [9],  [إنهاءٌ فوريٌّ لا يُلتقط ولا يُردّ.],
  [`TERM`], [15], [طلبُ إنهاءٍ مهذّب، وهو الافتراض.],
  [`STOP`], [17], [جمّد العملية فورًا — لا يُلتقط أيضًا.],
  [`CONT`], [19], [أكمِل بعد التجميد.],
)

#subsection[`TERM` تطلب، و`KILL` تبطش]

الأمر الذي يرسل الإشارات اسمه — على غرابته — `kill`، وهو افتراضًا يرسل `TERM` لا `KILL`. والفرق بينهما في الأدب لا في الشدّة وحدها: `TERM` طَرْقٌ على الباب يقول «أنهِ عملك واخرج»، فتلتقطه العمليةُ فتحفظ ملفّاتِها وتغلق اتّصالاتِها ثم تخرج بكرامة. أمّا `KILL` فلا يصل إليها أصلًا؛ النواةُ تنزع الحياة منها في مكانها، فلا تحفظ ولا تنظّف ولا تودّع.

ولنرَ الفرق بأعيننا. اكتب هذا *السكربت* — أي ملفًّا نصّيًّا فيه أوامرُ تُنفَّذ بالترتيب — في `worker.sh`، واجعله تنفيذيًّا بـ`chmod +x worker.sh` كما تعلّمتَ في فصل «الصلاحيات والملكية والأعلام»:

```sh
#!/bin/sh
# يلتقط TERM فيحفظ عمله قبل أن يخرج
trap 'echo saved >> /tmp/work.log; exit 0' TERM
while true; do sleep 1; done
```

السطر `trap` يقول: «إن جاءتك `TERM` فنفّذ هذا قبل أن تخرج» (وله شرحٌ أوفى في فصل «أساسيات كتابة السكربتات»). شغّله بـ`./worker.sh &`، ثم أرسل إليه الطلبَ المهذّب بـ`kill %1`، واقرأ سجلّه:

#session("cat /tmp/work.log", output: "saved")

التقط السكربتُ الإشارةَ فحفظ ثم خرج. الآن احذف السجلّ وأعِد التجربة، لكن أنهِه بالقاصمة `kill -9 %1`:

#session("cat /tmp/work.log", output: "cat: /tmp/work.log: No such file or
directory")

لا سطرَ محفوظًا، ولا ملفَّ أصلًا: لم يُمهَل لحظةً واحدةً ليكتب. هذا هو الفرق بين أن *تطلب* وأن *تبطش*.

#warn[
  `kill -9` ملاذٌ أخير لا خيارٌ أوّل: جرّب `kill` المجرّدة وامنح العملية ثانيتين، فأغلبُ ما يبدو «معلّقًا» ينتهي بأدبٍ لو صبرتَ عليه. ولا تجعل `-9` عادةً في سكربتاتك: البرنامج الذي يُقتَل قسرًا قد يترك ملفّاتٍ نصفَ مكتوبة، أو أقفالًا لم تُرفَع. الأدبُ مع العمليّات حمايةٌ لبياناتك أنت.
]

#subsection[التجميد والإحياء: `STOP` و`CONT`]

ليست كلُّ الإشارات قتلًا. `STOP` تجمّد العملية في مكانها: تبقى في الذاكرة بكلّ حالها ولا تأخذ من المعالج شيئًا. و`CONT` تُعيدها من حيث توقّفت كأنّ شيئًا لم يكن. وعمود `STAT` يشهد بالتبدّل: كانت العملية 4711 نائمةً (`S`)، فانظر إليها الآن:

#session("kill -STOP 4711; ps -o stat= -p 4711", output: "T")

#session("kill -CONT 4711; ps -o stat= -p 4711", output: "S")

الحرف `T` هو التجميد، وهو مفيدٌ عمليًّا: لو رأيتَ عمليّةً تلتهم المعالج ولم تحسم أمرَها، جمّدها بـ`STOP` لتهدأ الحرارةُ وتفكّر على مهل، ثم أطلقها بـ`CONT` أو أنهِها بـ`TERM`. (والعلامة `=` بعد اسم العمود تعني: اطبع القيمة بلا عنوانٍ فوقها.)

و`KILL` و`STOP` وحدَهما لا يستطيع برنامجٌ التقاطَهما ولا تجاهلَهما؛ أمّا ما عداهما — حتى `TERM` و`INT` — فيعترضه البرنامج ويتصرّف به كما يشاء، وهو ما فعله سكربتُك قبل قليل.

#distro[
  أرقام الإشارات ليست واحدةً في كلّ الأنظمة، والأسماءُ هي الآمنة: `STOP` رقمُها 17 على BSD (وماك) و19 على لِينُكس، و`CONT` هي 19 هنا و18 هناك. فاكتبها بالاسم لا بالرقم، يعمل أمرُك أينما ذهبت.
]

#try-it[
  أطلق هدفًا آمنًا: `sleep 500 &`، ثم خذ معرّفه بـ`pgrep -n -x sleep`. اقرأ حاله بـ`ps -o stat= -p` متبوعًا بالمعرّف (سيكون `S`)، ثم جمّده بـ`kill -STOP` واقرأ حاله ثانيةً (`T`)، ثم أحيِه بـ`kill -CONT` واقرأه ثالثةً فيعود `S`. أخيرًا أنهِه بـ`kill` المجرّدة، وتأكّد أنّه ذهب فلم يعد `ps` يجد له أثرًا. ثلاث إشاراتٍ في دقيقة، ورأيتَ أثر كلٍّ منها بحرفٍ واحد.
]

#section[التحكّم بالمهامّ: في يديك أو خلف ظهرك]

حين تنفّذ أمرًا طويلًا تبقى الطرفيةُ مشغولةً به حتى ينتهي. لكنّ الصدفة تملك أن تشغّل أكثر من مهمّةٍ معًا: واحدةً في *المقدّمة* تمسك لوحةَ المفاتيح، وسواها في *الخلفيّة* تعمل صامتة.

#define("المهمّة (Job)", [
  عمليّةٌ — أو سلسلةُ عمليّاتٍ في أنبوبٍ واحد — أطلقتها صدفتُك وتتولّى هي إدارتها، فترقّمها ترقيمًا خاصًّا بها يبدأ من 1 وتشير إليه بعلامة النسبة: `%1` و`%2`. ولا تخلط بين رقم المهمّة الذي لا تعرفه إلّا صدفتُك، ومعرّف العملية الذي يعرفه النظام كلُّه.
])

تُلحق الأمرَ بعلامة `&` فيبدأ في الخلفيّة وتعود إليك الطرفيةُ فورًا، وتسرد ما لديك بـ`jobs`:

#session("jobs -l", output: "[1]- 33984 Running                 sleep 100 &
[2]+ 33985 Running                 sleep 200 &")

الرقم بين القوسين رقمُ المهمّة، و`+` تشير إلى المهمّة الحاليّة (التي تعنيها `fg` إن لم تسمِّ شيئًا) و`-` إلى التالية لها، و`-l` يضيف معرّف العملية الحقيقيّ. والانتقالُ بين الحالين بأربع أدوات:

#table(
  columns: (auto, 1fr),
  [الأداة], [ما تفعل],
  [`&`], [تُلحق بالأمر فيبدأ في الخلفيّة رأسًا.],
  [#kbd("Ctrl") + #kbd("Z")], [تجمّد مهمّة المقدّمة وتعيدك إلى المحثّ.],
  [`bg %1`], [تُكمل المهمّة المجمّدة، لكن في الخلفيّة.],
  [`fg %1`], [تجلب مهمّةً من الخلفيّة إلى المقدّمة.],
)

فحين تنسى `&` ويشغلك أمرٌ طويل، لا تقتله ولا تنتظر: اضغط #kbd("Ctrl") + #kbd("Z") ليتجمّد (وهي إشارة `TSTP`)، ثم `bg` ليكمل في الخلفيّة، فتسترجع طرفيّتك دون أن تُضيّع دقيقةً من عمله. وتقبل `kill` أرقامَ المهامّ: `kill %2` أوضحُ وأقلُّ خطرًا من تذكّر رقمٍ من خمس خانات.

#subsection[ما يبقى بعد أن تغلق الطرفية]

المهمّة في الخلفيّة ما تزال ابنةَ صدفتك. وحين تغلق نافذةَ الطرفية تُرسَل إشارة `HUP` إلى مهامّها — واسمُها من hang up، «أَغلِق السمّاعة»، من أيّام الطرفيّات المتّصلة بخطّ الهاتف — فتموت أغلبُها. وللنجاة أداتان:

```sh
nohup ./long-task.sh &   # حصّنه من HUP منذ البداية (كلّ صدفة)
disown %1                # في bash/zsh: انزع المهمّة من السجلّ
```

والفرق بينهما في التوقيت: `nohup` قرارٌ *مسبقٌ* لحظةَ الإطلاق، يحصّن البرنامج من `HUP` ويحوّل مخرجاتِه إلى ملفّ `nohup.out` إن كانت متّجهةً إلى الشاشة. و`disown` قرارٌ *لاحقٌ* بعد أن يبدأ: يمحو المهمّة من سجلّ الصدفة فلا تعود تُخطِرها عند الخروج. فبعد `disown %1` لا يجدها `jobs`، ويجدها `pgrep` حيّةً تعمل: خرجت من السجلّ لا من الوجود. (و`disown` مبنيّةٌ في صدفٍ غنيّةٍ كـ`bash` و`zsh`، ولا وجود لها في `sh` الأساسيّة؛ فعلى صدفة النظام جوابُك المضمون `nohup` من البداية.)

#tip[
  الأنظفُ أن توجّه المخرجات بنفسك بدل `nohup.out`: `nohup ./task.sh > run.log 2>&1 &`. وإن أردتَ أن *تعود إلى* مهمّتك لا أن تتركها، فحاجتُك مضاعِفُ طرفيّاتٍ مثل `tmux` من `pkg`.
]

#try-it[
  نفّذ `sleep 300 &` مرّتين لتصير لك مهمّتان، ثم `jobs -l` لتراهما بمعرّفيهما. اجلب الثانية إلى المقدّمة بـ`fg %2`، ثم جمّدها بـ#kbd("Ctrl") + #kbd("Z") ولاحظ ماذا يطبع لك، ثم أعِدها إلى الخلفيّة بـ`bg %2`. وإن كانت صدفتُك `bash` أو `zsh` فنفّذ `disown %1` ثم `jobs` (أين ذهبت الأولى؟) وتأكّد أنّها حيّةٌ بـ`pgrep -fl "sleep 300"`. ثم نظّف بـ`pkill -f "sleep 300"`.
]

#section[الأولويّة: مَن يتقدّم في الطابور؟]

النواةُ تقسم المعالج بين العمليّات، ولها في القسمة مقياسٌ اسمه *اللطف*: كلّما كانت العملية «ألطف» تنازلت لغيرها عن دورها أكثر.

#define("قيمة اللطف (nice)", [
  رقمٌ يرافق كلَّ عمليّةٍ يخبر النواةَ بمدى استعجالها، قيمتُه الافتراضيّة 0. فكلّما *ارتفع* الرقم قلّت أولويّةُ العملية (صارت ألطفَ فتنازلت أكثر)، وكلّما انخفض ارتفعت أولويّتُها. ومداه على BSD من `-20` (أشدُّ إلحاحًا) إلى `20` (أكثرُ تنازلًا).
])

تُطلق أمرًا بلطفٍ محدّدٍ بـ`nice`، وتغيّر لطفَ عمليّةٍ قائمةٍ بـ`renice`، وتقرأ النتيجة في عمود `NI`:

```sh
nice -n 10 ./heavy-task.sh   # أطلقه متنازلًا من أوّل لحظة
renice 15 -p 4711            # واجعل عمليّةً قائمةً ألطف
```

#session("renice 15 -p 4711; ps -o pid,ni,comm -p 4711", output: "  PID NI COMM
 4711 15 /bin/sleep")

وهذا مفيدٌ في عملٍ ثقيلٍ طويل — ترجمةِ شفرةٍ أو تحويلِ فيديو — تريده أن يمضي دون أن يُبطئ جهازك: يأخذ المعالجَ حين يفرغ، ويتنحّى حين تحتاجه.

#warn[
  رفعُ الأولويّة ليس كخفضها. المستخدم العاديّ يستطيع أن *يزيد* رقم اللطف متى شاء، لكنّه *لا يستطيع* أن ينقصه أبدًا: لا ليعيده إلى ما كان، ولا ليهبط به تحت الصفر. جرّبه ترَ المنع صراحةً:
]

#session("renice 0 -p 4711", output: "renice: 4711: setpriority: Permission denied")

فالعمليّةُ ما تزال عند 15 الذي رفعتَها إليه، وإنزالُها إلى الصفر خفضٌ للّطف يردّه النظام. وهذا حاجزٌ متعمّد: لولاه لأمكن أيُّ برنامجٍ أن يتقدّم على الجميع فيشلّ الجهاز. أمّا الجذرُ فلا يقيّده هذا الحاجز، ينزل باللطف تحت الصفر متى شاء:

#session("renice -5 -p 4711; ps -o pid,ni,comm -p 4711", output: "  PID NI COMM
 4711 -5 /bin/sleep", prompt: "#")

والقاعدة: التنازل مباحٌ لك ولا رجعة فيه، والتقدّم يحتاج إذن المدير بـ`doas`.

#distro[
  فرقان يوقعان المنتقلَ بين الأنظمة: أقصى لطفٍ على BSD (وماك) هو `20` وعلى لِينُكس `19`؛ و`renice` على BSD تأخذ القيمةَ المطلقةَ رأسًا (`renice 15 -p 4711`)، بينما تقبل على لِينُكس صيغة `renice -n 15 -p 4711`. اكتب القيمةَ المطلقةَ هنا، ولا تفترض تطابقَ الصيغتين.
]

#section[الفحص العميق: لا `/proc`، بل `sockstat` و`fstat` و`procstat`]

على لِينُكس، `/proc` نظامُ ملفّاتٍ وهميٌّ يفتح لك أحشاء كلّ عمليّةٍ كمجلّدٍ تقرأ ملفّاتِه بـ`cat`. اختارت BSD طريقًا آخر: نظامُ `procfs` موجودٌ لكنّه *غيرُ مركّبٍ افتراضيًّا* — أوقفتْه FreeBSD لأسباب أمنٍ، وأزالتْه OpenBSD من أصله. فلا تسأل الملفّات في BSD، بل تسأل النواةَ مباشرةً بعائلةٍ صغيرةٍ متّسقة: `sockstat` للمنافذ، و`fstat` للملفّات، و`procstat` للأحشاء. وهذا وجهٌ آخرُ لفلسفة الأساس الواحد.

#subsection[`sockstat`: مَن يجلس على المنفذ؟]

في يونِكس «كلُّ شيءٍ ملفّ»، وحتى اتّصالُ الشبكة مِقبَسٌ مفتوح. و`sockstat` تسرد المقابس المفتوحة، فتجيبك عن سؤالٍ يتكرّر: مَن يجلس على هذا المنفذ فلا يدع خادمي يبدأ؟

#define("المنفذ (Port)", [
  رقمٌ بين 1 و65535 يميّز بابًا من أبواب الشبكة في جهازك. فالعنوان يقول «أيّ جهاز»، والمنفذ يقول «أيّ برنامجٍ فيه». ولا يجلس على المنفذ الواحد — في العادة — إلّا برنامجٌ واحد، ولذلك تشكو الخوادمُ من «المنفذ مشغول». وله تفصيله في فصل «الشبكات على BSD».
])

```sh
sockstat -4 -l           # المنصتون على IPv4
sockstat -4 -l -p 8080   # مَن يجلس على المنفذ 8080؟
sockstat -u              # مقابس يونِكس المحليّة
```

#session("sockstat -4 -l -p 8080", output: "USER     COMMAND    PID   FD PROTO  LOCAL ADDRESS    FOREIGN ADDRESS
ghazi    node       4899  18 tcp4   *:8080           *:*")

الأعمدةُ من اليسار: المالك، فاسمُ البرنامج، فمعرّفُه `PID` (وهو ما تريده غالبًا)، فواصفُ الملفّ، فالبروتوكول، فالعنوانُ المحليّ فالبعيد. و`*:8080` تعني «أنصِتْ على 8080 من أيّ عنوان».

#tip[
  هذه الوصفة تحلّ أشهرَ إزعاجٍ يلقاه أهلُ الخوادم — رسالةَ «المنفذ مشغول»: انظر `sockstat -4 -l -p 8080` وتأكّد أنّ الجالس خادمُك التجريبيّ لا خدمةُ نظام، ثم خذ `PID` وأنهِه بـ`kill`.
]

#subsection[`fstat`: مَن يمسك هذا الملفّ؟]

وأختُها للملفّات `fstat` — نظيرُ `lsof` الأصيلُ في نظام أساس BSD — تجيبك: مَن يمسك هذا الملفّ؟ أو: أيَّ ملفٍّ تفتح هذه العملية؟

```sh
fstat -p 4711          # كلّ ما تفتحه العملية 4711
fstat -u ghazi         # كلّ ما يفتحه مستخدمٌ بعينه
fstat /var/log/messages  # مَن يمسك هذا الملفّ؟
```

#session("fstat -p 4711", output: "USER  CMD  PID   FD MOUNT  INUM MODE       SZ|DV R/W NAME
ghazi less 4711 text /usr 120763 -r-xr-xr-x 43008 r  /usr/bin/less")

وتذكّر أنّك ترى بقدر ما تملك: بلا صلاحيّة المدير لا تكشف لك هذه الأدواتُ إلّا ما يخصّ عمليّاتِك أنت، وهو حجبٌ مقصودٌ لا عطل.

#subsection[`procstat`: أحشاء العملية]

فإذا أردتَ ما هو أعمقُ من قائمة الملفّات — خريطةَ الذاكرة، وحالةَ الخيوط، وحدودَ الموارد، ومسارَ الملفّ التنفيذيّ الصحيح — فأداةُ FreeBSD المتخصّصة `procstat`. تعطيها كلمةً تصف ما تريد ثم المعرّف:

```sh
procstat files 4711    # الملفّات المفتوحة بتفصيلها
procstat binary 4711   # مسار الملفّ التنفيذيّ الحقيقيّ
procstat rlimit 4711   # حدود الموارد ليّنةً وصلبة
procstat -a threads    # خيوط كلّ العمليّات
```

هي عينُك على ما كان `/proc` سيريه على لِينُكس، لكن عبر أداةٍ واحدةٍ تسأل النواةَ بلغتها.

#distro[
  توزّعُ الفروع هذه الأدوات: `fstat` في نظام أساس FreeBSD وOpenBSD وNetBSD جميعًا. و`sockstat` أصيلةٌ في FreeBSD (منذ الإصدار 3.1) وNetBSD، أمّا OpenBSD فتعتمد `fstat` و`netstat` أو سكربتًا يحاكيها. و`procstat` حصريّةٌ لـFreeBSD. وعلى لِينُكس تقابلها `lsof` و`ss`/`netstat` وقراءةُ `/proc`. و`lsof` نفسُها متاحةٌ حزمةً على الجميع لمن اعتادها.
]

#try-it[
  افتح ملفًّا طويلًا بـ`less /etc/services`، ثم اسأل عنه من نافذةٍ أخرى: `fstat /etc/services` — سترى `less` ممسكًا به. ثم اسأل `fstat -p` عن معرّف `less` لترى كم ملفًّا يفتح برنامجٌ «بسيط»، وجرّب `procstat rlimit` على المعرّف نفسه لتقرأ سقوفَه — وذلك بابُ القسم التالي.
]

#section[`limits` و`ulimit`: سقفُ ما تستطيعه العملية]

للعملية حدودٌ لا تتعدّاها: كم ملفًّا تفتح معًا، وكم تكبر ذاكرتُها، وكم يطول زمنُها على المعالج. تُضبط من مصدرين على BSD: فئةُ الدخول في `login.conf` تمنح كلَّ مستخدمٍ سقوفَه عند الولوج، والصدفةُ ترثها فتورّثها كلَّ عمليّةٍ تولد منها. وأداتان تريانِها وتضبطانِها.

الأولى `limits`، أداةُ FreeBSD التي تعرض سقوفَك أو تطلق برنامجًا بسقوفٍ تحدّدها:

#session("limits", output: "Resource limits (current):
  cputime          infinity secs
  filesize         infinity kB
  datasize        33554432 kB
  stacksize         524288 kB
  coredumpsize     infinity kB
  memoryuse        infinity kB
  maxprocesses        6656
  openfiles          58554")

والثانية `ulimit`، وهي مبنيّةٌ في الصدفة لا برنامجًا مستقلًّا، تخدمك في السكربتات:

#session("ulimit -n", output: "58554")

ولكلّ سقفٍ قيمتان: قيمةٌ *ليّنةٌ* هي المطبّقة الآن وتستطيع أنت رفعها إلى حدّ الصلبة، وقيمةٌ *صلبةٌ* لا يرفعها إلّا المدير؛ تقرؤهما بـ`ulimit -Sn` و`ulimit -Hn`، وتغيّر اللّيّنة بـ`ulimit -Sn` متبوعًا بالقيمة. وأكثرُ السقوف إثارةً للمشاكل `-n`: عددُ الملفّات المفتوحة، فأدواتُ التطوير الحديثة تفتح آلافًا منها، وحين تضيق بها تسقط برسالةٍ محيّرةٍ نصُّها `too many open files`؛ وعلاجُها الأوّل رفعُ السقف اللّيّن:

#session("(ulimit -Sn 4096; ulimit -Sn)", output: "4096")

وانتبه للقوسين: رُفعت القيمة داخل *صدفةٍ فرعيّة*، فلمّا خرجنا منها عادت الأصليّة. وهذه طبيعةُ `ulimit`: يؤثّر في الصدفة الحاليّة وفيما تلده بعده لا فيما وُلد قبله، ولا يبقى أثرُه بعد إغلاق النافذة؛ ولذلك يوضع في ملفّ إعداد الصدفة إن أُريد له الدوام (كما في فصل «البيئة وتخصيص الصدفة»)، أو في فئة الدخول بـ`login.conf` إن أُريد له أن يعمّ كلَّ جلسات المستخدم.

#warn[
  رفعُ السقوف ليس علاجًا لكلّ داء. البرنامج الذي يستنفد آلافَ الملفّات المفتوحة غالبًا لا يغلق ما يفتح، وهذا خللٌ فيه لا ضيقٌ في نظامك؛ ورفعُ السقف يؤجّل السقوطَ ولا يمنعه. ارفعه حين تكون الحاجة مشروعةً — كخادمٍ يخدم آلافَ الاتّصالات — وابحث عن السبب حين تكون مريبة.
]

#try-it[
  نفّذ `ulimit -Sn` ثم `ulimit -Hn` وقارن سقفك اللّيّن بالصلب: كم يتّسع لك أن ترفع الأوّل قبل أن تبلغ الثاني؟ ثم افتح عمليّةً في الخلفيّة (`sleep 500 &`) واقرأ حدودَها من الخارج بـ`procstat rlimit` على معرّفها — أهي نفسُ ما رأيتَه بـ`limits`؟ وهكذا تلتقي الأداتان: واحدةٌ تضبط، وأخرى تكشف.
]

#section[خلاصة الفصل]

رأيتَ أنّ البرنامج على القرص اسمٌ ساكن، وأنّ *العملية* هي الكائنُ الحيّ: ذاكرةٌ وهويّةٌ ونسبٌ ونصيبٌ من المعالج. وتسلّقتَ شجرة النسب حتى الجدّ الأوّل `init` ذي الرقم 1 — لا `systemd` ولا مارِد، بل برنامجٌ صغيرٌ يليق بنظام الأساس الواحد. والتقطتَ اللقطة بـ`ps` بصيغتيه `aux` و`-ef` وصنعتَ جدولك بـ`-o`، وصدتَ بالاسم بـ`pgrep` و`pkill` و`killall`، وشاهدتَ النبض في `top` وشجرتَه في `htop -t`. وتعلّمتَ أنّ مخاطبة العمليّات *إشارة*: `TERM` تطرق الباب و`KILL` تخلعه، و`STOP` تجمّد و`CONT` تُحيي — ورأيتَ الفرق في سجلّ سكربتٍ حَفِظ مرّةً ولم يُمهَل مرّة. ونقلتَ مهامّك بين المقدّمة والخلفيّة، وحصّنتَ الباقيَ من `HUP` بـ`nohup`، وضبطتَ الأولويّة بـ`nice` و`renice` فاصطدمتَ بحاجز المنع حين حاولتَ التقدّم. وفهمتَ لماذا لا `/proc` في BSD، فكشفتَ بأدواتها الأصيلة — `sockstat` للمنافذ و`fstat` للملفّات و`procstat` للأحشاء — وقِستَ سقوفَك بـ`limits` و`ulimit`. ولأدوات المراقبة الأعمقِ فصلٌ لاحقٌ هو «المراقبة والأداء والسجلّات»؛ أمّا `htop` التي جرّبتَها فليست من نظام الأساس، بل تجلبها من مستودع الحزم — وذاك موضوع الفصل التالي «الحزم الثنائيّة: pkg»: أمينُ المستودع الذي يجلب أدوات العالم بأمرٍ واحد.

#challenge[
  (1) *الطبيب الشرعيّ:* أجلِس على المنفذ 8080 برنامجًا من نظام الأساس بـ`nc -l 8080 &` (و`nc` أداةُ شبكةٍ بسيطةٌ تنتظر اتّصالًا لا أكثر)، ثم — دون أن تنظر إلى ما طبعته الصدفة — اكتشف معرّفَه بطريقتين: مرّةً بـ`sockstat -4 -l -p 8080`، ومرّةً بـ`pgrep -fl "nc -l 8080"`. تأكّد أنّ الرقمين واحد، ثم أنهِ الجالسَ بأدبٍ بـ`kill` وتحقّق أنّ المنفذ صار حرًّا. (2) *الفرق بأصابعك:* أعِد بناء سكربت `worker.sh` من الفصل وشغّله مرّتين: أنهِ الأولى بـ`kill` والثانية بـ`kill -9`، وقارن `/tmp/work.log` في الحالين. ثم غيّر سطر `trap` ليلتقط `INT` بدل `TERM`، وشغّل السكربت في المقدّمة، وأنهِه بـ#kbd("Ctrl") + #kbd("C") — هل حفظ؟ ولماذا؟ (3) *المتنازل:* أطلق عملًا ثقيلًا في الخلفيّة (مثل `find / -type f > /tmp/out.txt 2>/dev/null &`)، واقرأ لطفَه في عمود `NI`، ثم اجعله ألطفَ بـ`renice`، ثم حاول أن تعيده إلى `0` — ماذا قال لك النظام، ولماذا هذا المنعُ في مصلحتك؟
]
