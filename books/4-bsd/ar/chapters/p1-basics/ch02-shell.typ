#chapter[الطرفية والصدفة على BSD]

#objectives((
  [تميّز ثلاث كلماتٍ يخلط بينها كثيرون — النواة، والصدفة، والطرفية — وتفهم لماذا هي في BSD نسيجٌ واحدٌ لا قطعٌ مركّبة.],
  [تعرف صَدَفات BSD: `sh` (البورنيّة) للنصوص وحساب الجذر، و`tcsh`/`csh` البِرْكليّة تراثيًّا للتفاعل على FreeBSD، و`ksh` صدفةَ OpenBSD.],
  [تكتشف صدفتك بـ`echo $SHELL`، وتبدّلها بأمانٍ بـ`chsh -s`، وتُضيف `bash` من `pkg` إن شئت.],
  [تكتب أوّل أمرٍ لك (`uname`)، وتشرّح كلّ أمرٍ إلى فعلٍ وخيارٍ ومُعطًى، وتلمس بيدك فرق `sh` و`tcsh` في المحثّ والصياغة.],
))

في الفصل الماضي، «ما BSD؟»، تعرّفتَ إلى العائلة وروحها: أنّ BSD نظامٌ متكاملٌ نُسِج في مكانٍ واحد. الآن حان أن تجلس إلى مائدته وتحادثه. لكنّك لن تخاطب الحاسوب مباشرةً أبدًا؛ بينك وبينه وسيطان لطيفان: نافذةٌ تكتب فيها كلامك، ومترجمٌ يفهم عنك ويأمر النظام نيابةً عنك. هذا الفصل يعرّفك إلى هذين الوسيطين، ويضع في يدك أوّل أمرٍ حقيقيّ، ويكشف لك سرًّا صغيرًا: أنّ في عالم BSD أكثر من مترجم، ولكلٍّ لهجته. مَن يعرف اللهجات لا يرتبك حين تختلف.

#section[BSD نسيجٌ واحد، لا نواةٌ وتوزيعات]

قبل أن نفتح الطرفية، ثبّتْ في ذهنك الفكرة التي تفسّر كلَّ ما يليها. في عالم لِينُكس، النظام قطعٌ يجمعها آخرون: نواةٌ يكتبها فريق، وأدواتُ أساسٍ (`ls` و`grep` وأخواتهما) يكتبها فريقٌ آخر تحت مظلّة GNU، وتوثيقٌ من جهةٍ ثالثة — ثم تأتي «توزيعةٌ» كدبيان أو فيدورا فتلمّ القطع في نظامٍ واحد. أمّا BSD فوُلد على العكس تمامًا.

#define("BSD", [
  عائلةٌ من أنظمة يونِكس نشأت في جامعة كاليفورنيا في بيركلي (‏Berkeley Software Distribution). أشهر أبنائها اليوم: FreeBSD (الأوسع انتشارًا)، وOpenBSD (المهووس بالأمن)، وNetBSD (سيّد المحموليّة)، وDragonFly BSD. وكلُّها — خلافًا للِينُكس — نظامٌ كاملٌ يُطوَّر من مصدرٍ واحد.
])

في BSD، النواةُ وأدواتُ الأساس والتوثيق تُكتب وتُختبر وتُصدَر معًا، في شجرة مصدرٍ واحدة، وتحت مظلّة مشروعٍ واحد. هذه الكتلة المتماسكة اسمها *النظام الأساس* (base system). فحين تثبّت FreeBSD، لا تجمع قطعًا من مصادر شتّى؛ بل تتلقّى نسيجًا واحدًا خِيطَ في مكانٍ واحد: الصدفة `sh` التي ستكتب فيها، وأمر `ls` الذي ستعرض به الملفّات، وصفحة الدليل التي تشرحهما — كلُّها من الإصدار نفسه، اختُبرت معًا، ووُثّقت معًا.

#note[
  هذا التماسك ليس ترفًا نظريًّا؛ إنه سرّ الوضوح الذي تشتهر به وثائق BSD (كتيّب FreeBSD، وأسئلة OpenBSD الشائعة). حين يكتب فريقٌ واحدٌ الأداةَ وصفحةَ دليلها في آنٍ واحد، يأتي التوثيق دقيقًا مطابقًا لسلوك النظام — لا مقالةً كُتبت لنظامٍ آخر. سنعتمد هذا في «أن تساعد نفسك» حين نفتح صفحات الدليل.
]

#section[ثلاث كلماتٍ لا تخلط بينها: النواة والصدفة والطرفية]

تخيّل مطعمًا. أنت لا تقتحم المطبخ لتطبخ بيدك، بل تخبر النادلَ بما تشتهي، فينقل طلبك إلى الطبّاخ، ثم يعود إليك بالطبق. هذا التقسيم نفسه يجري في جهازك، وفهمه يميّزك عن عامّة المستخدمين.

في القلب يقبع *الطبّاخ*: برنامجٌ واحدٌ هو الوحيد الذي يلمس العتاد مباشرةً — يوزّع المعالج، ويحجز الذاكرة، ويقرأ القرص.

#define("النواة (Kernel)", [
  البرنامج الأعمق في النظام؛ يدير العتاد كلَّه ويوزّع موارده على البرامج، وهو وحده المخوَّل بمخاطبة العتاد مباشرة. نواةُ FreeBSD اسمها ببساطة «kernel»، وتُطوَّر ضمن النظام الأساس نفسه؛ بينما نواةُ لِينُكس مشروعٌ مستقلٌّ عن أدواته.
])

لكنك لن تخاطب النواة مباشرةً؛ فهي كالطبّاخ منشغلةٌ لا تحبّ المقاطعة. بينك وبينها يقف *النادل*: برنامجٌ يأخذ كلماتك، ويفهمها، ويأمر النواة عنك، ثم يعود إليك بالجواب.

#define("الصدفة (Shell)", [
  برنامجٌ يقرأ الأوامر التي تكتبها، ويترجمها إلى طلباتٍ للنواة، ثم يعرض لك ما تُعيده. سُمّيت «صدفة» لأنها تحيط بالنواة كما تحيط القوقعةُ باللؤلؤة. وفي BSD صَدَفاتٌ عِدّة تتشارك المهمّة نفسها بلهجاتٍ مختلفة، كما سترى بعد قليل.
])

بقيت الطاولةُ التي تجلس إليها لتحادث النادل؛ تلك هي *الطرفية*.

#define("الطرفية (Terminal)", [
  النافذة التي تُظهر لك الصدفةَ: تكتب فيها أوامرك بلوحة المفاتيح، وتقرأ فيها النتائج. الطرفيةُ هي الوسيط المرئيّ، والصدفةُ هي العقل الذي يعمل خلفها. على خادم BSD بلا شاشةٍ رسوميّة، تكون الطرفيةُ هي كلَّ ما تراه — وهذا هو الشائع في عالم BSD.
])

فالترتيب من الخارج إلى الداخل: تكتب في *الطرفية*، فيقرأ كلامَك *الصدفة*، فتأمر *النواةَ*، فتحرّك *العتاد*. أربع طبقاتٍ كأربعة أدوارٍ في المطعم.

#warn[
  الكلمات الثلاث تُستعمل أحيانًا وكأنها مترادفة، وهذا شائعٌ ومربك. ثبّتها الآن: الطرفيةُ النافذة، والصدفةُ المترجم، والنواةُ المنفّذ. حين يقول أحدهم «افتح الطرفية» فهو يعني النافذة؛ وحين يقول «في الصدفة» فهو يعني المترجم العامل داخلها.
]

#section[صَدَفات BSD: أكثر من نادلٍ، لكلٍّ لهجة]

هنا يفترق طريقنا عن كتب ماك ولِينُكس. فلِينُكس يقدّم لك غالبًا صدفةً واحدةً افتراضيّةً اسمها `bash`، وماك يقدّم `zsh`. أمّا BSD فيأتي في نظامه الأساس بأكثر من صدفة، ولكلٍّ تاريخٌ وذوق.

#subsection[`sh`: صدفة النصوص والجذر]

#define([`sh` (صدفة بورن)], [
  الصدفةُ الأمّ في عالم يونِكس؛ كتبها ستيفن بورن في مختبرات بِل سنة 1979. نسختُها في FreeBSD متوافقةٌ مع معيار POSIX (وهو مواصفةٌ تضبط سلوك أنظمة يونِكس كي تتشابه). صدفةٌ رصينةٌ سريعة، هي لغةُ سكربتات النظام كلِّها في BSD، ومحثّها للمستخدم العاديّ العلامةُ `$`.
])

على FreeBSD الحديث (الإصدار الرابع عشر فما بعده)، صارت `sh` هي الصدفةَ الافتراضيّة للمستخدم العاديّ ولحساب الجذر (root) معًا. سببُ ذلك عمليّ: كلُّ سكربتات إقلاع النظام مكتوبةٌ بـ`sh`، فجعلُها صدفةَ الإدارة يُبقي الأدواتِ متجانسة. ومحثّ هذا الكتاب كلِّه هو `$`؛ لأننا نعمل في `sh`.

#subsection[`csh` و`tcsh`: لهجة بيركلي التفاعليّة]

#define([`csh` و`tcsh` (صدفة C)], [
  صدفةٌ كتبها بِل جُوي في جامعة بيركلي أواخر السبعينيّات، ضمن نظام BSD نفسه — فهي *بِرْكليّةُ المولد*! سُمّيت «صدفة C» لأنّ صياغتها تشبه لغة البرمجة C. و`tcsh` نسختُها المحسّنة التي أضافت تحرير سطر الأوامر والإكمال التلقائيّ. محثّها للمستخدم العلامةُ `%`.
])

هذه الصدفةُ فخرٌ بِرْكليٌّ خالص: وُلدت حيث وُلد BSD، وظلّت عقودًا الصدفةَ التفاعليّة المفضّلة على FreeBSD (بل كانت صدفةَ الجذر الافتراضيّة حتى الإصدار الثالث عشر). فإن جلستَ إلى خادم FreeBSD قديمٍ ووجدتَ محثًّا ينتهي بـ`%`، فتلك لهجةُ `csh` تحدّثك.

#note[
  تفصيلٌ لطيفٌ يربكك إن جهلتَه: على BSD (وعلى هذا الماك أيضًا) الأمران `csh` و`tcsh` *برنامجٌ واحد*، لا برنامجان. تحقّقتُ على هذا الجهاز فوجدتُ ملفَّيهما يتقاسمان الرقمَ التسلسليّ نفسه (inode): `1152921500312571386`. أي أنّ `/bin/csh` مجرّدُ اسمٍ ثانٍ لـ`/bin/tcsh`. حين تشغّل `csh` فأنت تشغّل `tcsh`.
]

#subsection[`ksh`: صدفة OpenBSD]

#define([`ksh` (صدفة كورن)], [
  صدفةٌ كتبها ديفيد كورن في مختبرات بِل، تجمع راحةَ `csh` في التفاعل إلى قوّة `sh` في السكربتات. وصدفةُ OpenBSD الافتراضيّة نسخةٌ حرّةٌ منها (pdksh) تعيش في `/bin/ksh`، وهي صدفةُ المستخدم والجذر معًا على OpenBSD.
])

فاختصارُ الخريطة: على FreeBSD صدفتُك `sh` (وبجوارها `tcsh` التراثيّة)، وعلى OpenBSD صدفتُك `ksh`. هذا التنوّع ليس فوضى، بل انعكاسٌ لفلسفة كلِّ فرع: FreeBSD يوازن بين التراث والعمليّة، وOpenBSD يختار صدفةً واحدةً متقنةً ويصقلها.

#distro[
  على لِينُكس الصدفةُ الافتراضيّة غالبًا `bash` (صدفة GNU الغزيرة المزايا)، وعلى ماك الحديث `zsh`. كلتاهما من عائلة `sh` البورنيّة، فصياغتُهما قريبةٌ مما تتعلّمه هنا. أمّا `csh`/`tcsh` فعائلةٌ أخرى بصياغةٍ مختلفة — وهذا أوّل ما يعثر فيه القادمون من لِينُكس إلى BSD.
]

#subsection[كيف تعرف صدفتك، وكيف تبدّلها]

لتعرف صدفتك المسجّلة، اسأل متغيّرًا اسمه `SHELL` يحتفظ بمسارها:

#session("echo $SHELL", output: "/bin/sh")

على FreeBSD حديثٍ يجيبك `/bin/sh`، وعلى OpenBSD `/bin/ksh`. والكلمة `echo` تعني «ردّد»، والعلامة `$` قبل الاسم تعني «قيمةَ هذا المتغيّر لا اسمَه» — وسيصحبنا هذا الرمز طويلًا.

ولتبديل صدفتك المسجّلة، استعمل أداةً بِرْكليّةً اسمها `chsh` (اختصار change shell). أعطِها الخيار `-s` ثم مسارَ الصدفة الجديدة:

#session("chsh -s /bin/tcsh", output: "(ستُطالَب بكلمة سرّك، ثم تصير tcsh صدفتَك عند الدخول القادم)")

يأخذ التبديلُ مفعولَه في *جلسة الدخول القادمة*، لا فورًا؛ فأغلِق الطرفية وافتحها من جديدٍ لتحادثَ صدفتك الجديدة.

#warn[
  لا تبدّل صدفة الجذر (root) إلى صدفةٍ خارج النظام الأساس — كـ`bash` المثبّتة في `/usr/local/bin`. فإن تعطّل النظام يومًا ولم يُركَّب القرصُ الذي يحوي `/usr/local`، بقي الجذر بلا صدفةٍ تعمل، وتعذّر عليك الإصلاح. أبقِ صدفة الجذر من النظام الأساس دائمًا (`sh` أو `tcsh`). هذه نصيحةُ كتيّب FreeBSD الصريحة.
]

#section[أوّل أمرٍ على BSD]

يكفي نظريًّا؛ لنكتب أمرًا. أنسبُ أوّلِ أمرٍ في كتاب BSD هو `uname` (اختصار Unix name)، فهو يطبع اسم النظام ونسخته، وبه تتأكّد من أيِّ فرعٍ تجلس أمامه. أضِف إليه الخيار `-a` (أي all: كلَّ التفاصيل):

#session("uname -a", output: "FreeBSD server 14.2-RELEASE FreeBSD 14.2-RELEASE GENERIC amd64")

اقرأ السطر حقلًا حقلًا: `FreeBSD` اسمُ النظام، و`server` اسمُ الجهاز على الشبكة، و`14.2-RELEASE` رقمُ الإصدار، وفي آخره `amd64` نوعُ المعالج. رأيتَ بعينك أنّك على FreeBSD — وهذا ما يعنيه أن تسأل جهازَك بدل أن تخمّن.

#note[
  هذا الجهاز الذي حُرِّر عليه الكتاب نظامُه macOS، وهو مشتقٌّ من BSD (اسمُه الداخليّ Darwin). فحين نفّذتُ `uname -a` عليه فعلًا، طبع: `Darwin MacBookPro 25.5.0 ... x86_64`. لاحظ أنّ الأمر نفسه، والخيار نفسه، والحقول نفسها — يتغيّر فقط اسمُ النظام. هذا يجسّد قرابة العائلة التي عرفتها في «ما BSD؟».
]

الآن ثلاثةٌ تعرّف بها نفسك ومكانك ووقتك:

```sh
whoami    # مَن أنا؟ اسمُ المستخدم الذي دخلتُ به
pwd       # أين أنا الآن؟ مسارُ المجلّد الحالي
date      # كم الساعة وما تاريخُ اليوم؟
```

#try-it[
  افتح طرفيّتك ونفّذ الأربعة بيدك — لا تكتفِ بالقراءة: `uname -a` ثم `whoami` ثم `pwd` ثم `date`. تأمّل جواب كلٍّ منها. إن كنتَ على FreeBSD أو OpenBSD فتحقّق من السطر الأوّل: أيَّ فرعٍ يقول لك إنّك تجلس أمامه؟
]

#section[`sh` و`tcsh` وجهًا لوجه]

عرفنا أنّ في BSD صَدَفاتٍ من عائلتين. لكنّ الفرق يبقى مجرّدًا حتى تلمسه بيدك. ولأنّ هذا الماك بِرْكليُّ الأصل، فيه `sh` و`tcsh` الحقيقيّتان — فشغّلتُهما فعلًا لأُريَك الفرق في أمرين: المحثّ، والصياغة.

أوّلًا المحثّ. حين تدخل `sh` ينتظرك محثٌّ ينتهي بـ`$`، وحين تدخل `tcsh` ينتهي بـ`%`. جرّبتُهما فعلًا فرأيت:

```text
$ echo لغتي البورنية
لغتي البورنية

% echo لغتي البركلية
لغتي البركلية
```

وثانيًا — وهو الأهمّ — الصياغة. العائلتان تختلفان في أبسط عمليّة: إسناد قيمةٍ إلى متغيّر. في عائلة `sh` تكتب الاسمَ فمساواةً فالقيمة بلا فراغات؛ وفي عائلة `csh` تستعمل كلمة `set` وتسمح بالفراغات:

#table(
  columns: (1fr, auto, auto),
  align: (right, right, right),
  table.header([المهمّة], [عائلة `sh`], [عائلة `csh`]),
  [متغيّرٌ محلّيّ],            [`name=world`],       [`set name = world`],
  [متغيّرُ بيئةٍ يراه الأبناء], [`export EDITOR=vi`],  [`setenv EDITOR vi`],
  [محثّ المستخدم العاديّ],     [`$`],                [`%`],
  [محثّ الجذر (في كلتيهما)],   [`#`],                [`#`],
)

الفرق ليس تجميليًّا؛ الخلط بينهما يوقعك في خطأ. جرّبتُ صياغة `sh` داخل `tcsh` فعلًا، فرفضَتها الصدفةُ لأنها ظنّت الاسمَ أمرًا تشغّله:

```text
% name=world
name=world: Command not found.
```

وبالعكس، جرّبتُ صياغة `csh` داخل `sh`:

```text
$ setenv EDITOR vi
sh: setenv: command not found
```

فكلُّ صدفةٍ تفهم لهجتها وحدها. القاعدة العمليّة: اعرف في أيّ صدفةٍ أنت (انظر إلى محثّك: `$` أم `%`)، واكتب بلهجتها.

#warn[
  أكثرُ ما يربك المبتدئ في BSD أن ينسخ سطرًا من مقالٍ كُتب لصدفةٍ غير صدفته. سطرٌ مثل `export PATH=...` سليمٌ في `sh` وخطأٌ في `tcsh` (صوابُه هناك `setenv PATH ...`). فحين يشكو أمرٌ من «Command not found» رغم صحّته، اسأل أوّلًا: أهذه لهجةُ صدفتي؟
]

#tip[
  أيُّ الصدفتين تستعمل؟ للسكربتات اكتب دائمًا بـ`sh`؛ فهي المعيار (POSIX) وتعمل في كلّ مكان، وسكربتات BSD كلُّها بها. أمّا للجلسة التفاعليّة فالأمر ذوق: كثيرٌ يحبّ راحة `tcsh` أو `ksh`. تعلَّمْ `sh` أوّلًا لأنها الأساس، ثم جرّب البقيّة على مهل.
]

#try-it[
  إن كانت صدفتُك `sh`، ادخل `tcsh` بكتابة اسمها ثم #kbd("Enter")؛ سيتحوّل محثّك إلى `%`. نفّذ `set x = بيركلي` ثم `echo $x`. ثم جرّب `x=خطأ` بلا `set` ولاحظ الشكوى. أخيرًا اكتب `exit` لتعود إلى `sh` ومحثّه `$`. لقد زرتَ لهجتين في دقيقة.
]

#section[تشريح الأمر: فعلٌ وخيارٌ ومُعطًى]

قد يبدو كلُّ أمرٍ طلسمًا يُحفظ، والحقيقةُ أجمل: الأوامر *جُمَلٌ* في لغةٍ لها نحو، والجملةُ ثلاثةُ أركان. انظر أمرًا مرّ بنا:

```sh
uname -s -m
```

- الركن الأوّل `uname` هو *الفعل*: اسمُ الأمر، أي ما تريد فعله.
- الركن الثاني `-s` و`-m` *خياران* (options): يعدّلان سلوك الفعل، ويبدأ كلٌّ بشَرطة. هنا `-s` يعني «اسمَ النظام وحده»، و`-m` «نوعَ المعالج».
- ما يقع عليه الفعل — إن وُجد — هو *المُعطى* (argument). لا مُعطى هنا، لكنّه يظهر في أوامرَ أخرى حين يتلوها اسمُ ملفٍّ أو مجلّد.

فتُقرأ الجملة: «اطبع (`uname`) اسمَ النظام (`-s`) ونوعَ معالجه (`-m`)». حين تستوعب هذا التقسيم تكفّ عن حفظ الأوامر ككتلٍ مصمتة، وتبدأ في *تأليفها*: تتعلّم أفعالًا وخياراتٍ وتركّب جملك بنفسك. وتلك نقطةُ التحوّل التي يصير عندها الحاسوبُ طوعَ يدك.

#tip[
  الخياراتُ القصيرة تبدأ بشَرطةٍ وحرفٍ (`-s`)، ويمكن دمجُ عدّةٍ منها: `uname -sm` يكافئ `uname -s -m`. وأدواتُ BSD الأساسيّة تفضّل هذا الشكلَ القصير، وقليلًا ما تعرف الخياراتِ الطويلةَ ذاتَ الشَّرطتين (`--all`) الشائعةَ في أدوات GNU على لِينُكس. فإن رفض أمرٌ بِرْكليٌّ خيارًا طويلًا، فذاك طبعُه لا خطؤك.
]

#danger[
  اللغةُ نفسها التي تعرض الملفّات تستطيع محوَها بلا رجعة. أوامرُ مثل `rm -rf` (احذف كلَّ شيءٍ في مسارٍ دون سؤال) لا سلّةَ بعدها ولا استعادة. لا تكتب أمرًا مدمّرًا للتجربة، ولا تنسخ من الإنترنت أمرًا لا تفهمه. سنميّز في هذا الكتاب كلَّ أمرٍ خطيرٍ بصندوقٍ كهذا.
]

#section[تثبيت `bash` إن شئت]

ربّما جئتَ من لِينُكس وأَلِفتَ `bash`، فتريدها هنا. لن تجدها في النظام الأساس؛ لأنّ فلسفة BSD أن يبقى الأساسُ صغيرًا متماسكًا يحوي ما يكفي لتشغيل النظام وإصلاحه، وما وراء ذلك يُضاف من *الحزم*. تثبّت `bash` بمدير حزم FreeBSD واسمه `pkg` (وله فصلٌ كامل لاحقًا)، وهذا أمرُ إدارةٍ يحتاج صلاحيّة الجذر، فمحثّه `#`:

#session("pkg install bash", output: "(يُنزّل bash ويضعها في /usr/local/bin/bash)", prompt: "#")

ثم تجعلها صدفتك — بحذرٍ، ولحسابك أنت لا للجذر كما حذّرنا:

#session("chsh -s /usr/local/bin/bash")

#note[
  لاحظ المسار: `/usr/local` هو موطن كلِّ ما تضيفه فوق النظام الأساس، تمييزًا له عن `/bin` و`/usr/bin` اللذَين للأساس وحده. هذا الفصلُ الصارم بين «ما جاء مع النظام» و«ما أضفتَه أنت» من أوضح ملامح BSD، وسنعود إليه في «شجرة نظام BSD».
]

#distro[
  على لِينُكس `bash` جزءٌ من التوزيعة افتراضيًّا، فلا تحتاج لتثبيتها. أمّا في BSD فغيابُها عن الأساس *قصدٌ لا نقص*: الأساسُ نسيجٌ مُحكَمٌ محدود، والزائدُ اختياريٌّ عبر `pkg`. هذا الفصلُ بين الجوهر والإضافة هو ما يمنح BSD تماسكَه.
]

#section[خلاصة الفصل]

عرفتَ أنّ BSD نسيجٌ واحد: نواةٌ وأدواتُ أساسٍ وتوثيقٌ تُخاط معًا في نظامٍ أساسٍ واحد، لا قطعًا يجمعها آخرون كما في توزيعات لِينُكس. وميّزتَ الطبقات: العتادُ تحرّكه النواة، والنواةَ تخاطبها الصدفة، والصدفةَ تراها في الطرفية. وتعلّمتَ أنّ في BSD صَدَفاتٍ من عائلتين: `sh` البورنيّة (صدفةُ النصوص والجذر ومحثُّها `$`) الافتراضيّةُ على FreeBSD، و`tcsh`/`csh` البِرْكليّةُ المولد (محثُّها `%`) التراثيّةُ للتفاعل، و`ksh` صدفةُ OpenBSD. وعرفتَ صدفتك بـ`echo $SHELL`، وبدّلتها بـ`chsh -s`، وأضفتَ `bash` من `pkg` إن شئت. ثم كتبتَ أوّل أمرٍ (`uname`) فأخبرك أيَّ فرعٍ تجلس أمامه، وشرّحتَ الأمرَ إلى فعلٍ وخيارٍ ومُعطًى، ولمستَ بيدك فرق `sh` و`tcsh` في المحثّ والصياغة. في الفصل التالي، «شجرة نظام BSD»، ننتقل من مخاطبة الصدفة إلى التجوال في بيت BSD: كيف نتحرّك بين مجلّداته، ولماذا رُتّبت شجرتُه هكذا، وأين يسكن ما تضيفه أنت.

#challenge[
  دون النظر في الأعلى، أجب عن هذه من جهازك: (1) ما الفرق بين النواة والصدفة والطرفية، ولماذا هي في BSD نسيجٌ واحدٌ لا قطعٌ مركّبة؟ (2) نفّذ `echo $SHELL` لتعرف اسمَ صدفتك، ثم `uname -s` لتعرف نظامَك: أيَّ فرعٍ من BSD تجلس أمامه، وأيَّ صدفةٍ يوافقه؟ (3) إن أمكنك، ادخل `tcsh` وأسنِد متغيّرًا بصياغة `set`، ثم جرّب صياغة `sh` (`name=قيمة`) بلا `set` ولاحظ الشكوى؛ ثم فسّر بكلماتك: لماذا لا تفهم كلُّ صدفةٍ إلّا لهجتها؟
]
