#chapter[لِينُكس وBSD من منظور مستخدم ماك]

#objectives((
  [تفهم موقع ماك من عائلة يونِكس، وكيف يقاربه لِينُكس وBSD ويفارقانه.],
  [تتّصل بخادم لِينُكس من ماك عبر `ssh` وتعمل فيه كأنّك جالسٌ أمامه.],
  [توازن الفروق الأربعة الكبرى: الحزم (`brew` مقابل `apt` و`pkg`)، والخدمات (`launchd` مقابل `systemd`)، والشبكة (`ifconfig` مقابل `ip`)، واللهجة (BSD مقابل GNU).],
  [تعرف أين تشعر أنّك في بيتك — الأدوات المشتركة — ومتى تنتبه للفخاخ الخفيّة.],
))

قضيتَ ثمانية عشر فصلًا تُتقن طرفيّة ماك. لكنّ ما تعلّمته ليس ملكًا لماك وحده؛ إنّه لغةُ *قبيلةٍ* كاملةٍ من الأنظمة اسمها يونِكس، تسكن بيوتًا متجاورة. أنت تفهم أهلَ البيوت كلِّهم، وتجلس بينهم كأنّك منهم — إلى أن يذكر أحدهم كلمةً محلّيّةً تُدهشك. بيتُك ماك، والقبيلة يونِكس، والبيت المجاور الأكبر لِينُكس (الذي يشغّل أغلب خوادم العالم)، وبيوت الأعمام BSD. هذا الفصل جسرُك إلى بيوت القبيلة: يأخذ كلَّ ما تعرفه، فيريك ما يعبر معك بلا عناء، وأين تتحوّل الأرض تحت قدميك.

#section[بيتان على أساسٍ واحد]

لماذا يشبه لِينُكس ماكَ أصلًا؟ لأنّ كليهما وريثٌ لنظامٍ عتيقٍ اسمه *يونِكس* وُلد في السبعينيّات. من ذلك الجذر الواحد تفرّع فرعان كبيران: فرعٌ حرٌّ مفتوحٌ بُني من الصفر ونواتُه *لِينُكس*، وفرعٌ أكاديميٌّ اسمه *BSD* خرج من جامعة بيركلي. ونظام ماك؟ لِبُّه — الذي اسمه Darwin — مأخوذٌ من فرع BSD. فماك أقرب نسبًا إلى أعمامه BSD منه إلى لِينُكس، وهذا سرٌّ يفسّر كثيرًا ممّا ستراه.

#define("التوزيعة (Distribution)", [
  في عالم لِينُكس، النواةُ وحدها لا تكفي للاستعمال؛ تُحزَم مع آلاف الأدوات في *توزيعةٍ* جاهزة. أشهرها *أوبونتو* ودبيان (عائلةٌ واحدة)، وفيدورا، وأرش. كلُّها «لِينُكس»، لكنّ لكلٍّ مديرَ حزمٍ وتقاليدَ تختلف قليلًا — تمامًا كما يختلف ماك عن ويندوز رغم أنّهما نظاما تشغيل.
])

كيف تعرف في أيّ بيتٍ أنت الآن؟ ثمّة أمرٌ واحدٌ يعمل في كلّ بيوت القبيلة، يخبرك باسم النظام الذي تقف عليه، اسمه `uname` (اختصار Unix name):

```bash
uname -s        # اسم النواة: من أنا الآن؟
```

على ماك يجيب `Darwin`، وعلى خادم أوبونتو يجيب `Linux`، وعلى خادم FreeBSD يجيب `FreeBSD`. حرفٌ واحدٌ في الجواب يقول لك أيّ لهجةٍ ينبغي أن تتكلّم.

#try-it[
  نفّذ على ماك `uname -s` وتأمّل الجواب `Darwin` — هذا اسم النظام المفتوح الذي يجمع نواة XNU ومكوّناتٍ من BSD تحت macOS. ثمّ جرّب `uname -a` لترى السطر كاملًا: اسم النظام وإصداره ومعماريّة معالجك. احفظ هذا الأمر؛ سيكون أوّل ما تسأله حين تهبط على خادمٍ غريب.
]

#section[الجسر نفسه: `ssh` إلى خادم لِينُكس]

قبل أن نوازن الفروق، لنعبر الجسر عمليًّا. الطريقة التي تصل بها من ماك إلى خادم لِينُكس هي `ssh` نفسها التي تعلّمتها في فصل الشبكات — لا تتغيّر صيغتها الأساسيّة. هذا أوّل موضعٍ تشعر فيه أنّك في بيتك: أمر `ssh` على ماك ولِينُكس يعمل بالطريقة نفسها.

#define("الخادم (Server)", [
  حاسوبٌ يعمل على الدوام في مركز بياناتٍ بعيد، بلا شاشةٍ ولا لوحة مفاتيح، ينتظر الطلبات فيخدمها: يستضيف موقعًا، أو يخزّن ملفّات، أو يشغّل تطبيقًا. أغلب الخوادم في العالم تعمل بلِينُكس، وتُدار كلُّها من الطرفية عن بُعدٍ عبر `ssh` — فلا مفرّ لك من إتقان هذا الجسر.
])

اكتب اسم مستخدمك على الخادم، ثمّ `@`، ثمّ عنوانه:

```bash
ssh abu-haitham@203.0.113.10      # ادخل الخادم البعيد
uname -s                          # ثمّ اسأله: أيّ نظامٍ أنت؟ → Linux
```

ما إن يقبلك الخادم حتى يصير محثُّك محثَّه: كلُّ أمرٍ تكتبه الآن يُنفَّذ *هناك* لا على ماك. ولأنّ لِينُكس نظام يونِكس، فإنّ `cd` و`ls` و`cat` و`grep` تعمل فورًا كما تعوّدت. للخروج والعودة إلى ماك، اكتب `exit`.

#tip[
  لنقل ملفٍّ بينك وبين الخادم، الأداة الشقيقة لـ`ssh` هي `scp` (نسخٌ آمن)، وتعمل هي الأخرى على ماك ولِينُكس بالصيغة نفسها: `scp file.txt abu-haitham@203.0.113.10:~` يرفع الملفّ إلى منزلك على الخادم. عكسُها بعكس الطرفين.
]

#try-it[
  إن كان لك خادم لِينُكس (أو حاسوبٌ صغيرٌ مثل Raspberry Pi في بيتك)، اتّصل به: `ssh مستخدمك@عنوانه`، ثمّ نفّذ هناك `uname -a` و`ls` و`pwd`. لاحظ كم من مهاراتك عبرت الجسر سليمة. اكتب `exit` للعودة. إن لم يكن لديك خادمٌ بعد، فاحتفظ بهذا التمرين ليوم تستأجر فيه أوّل خادمٍ سحابيّ.
]

#section[الفرق الأوّل: الحزم — `brew` مقابل `apt` و`pkg`]

على ماك تثبّت البرامج بـ *Homebrew*: تكتب `brew install`، ولا تحتاج `sudo`، لأنّ Homebrew يثبّت في مجلّدٍ يملكه مستخدمك. أمّا حين تهبط على لِينُكس فيستقبلك *مدير حزمٍ* مختلف، ولا بدّ من `sudo` لأنّ الحزم تُثبَّت في مجلّدات النظام.

#define("مدير الحزم", [
  برنامجٌ يثبّت البرامجَ ويحدّثها ويزيلها من *مستودعٍ* مركزيٍّ موثوق، بأمرٍ واحد، فيتولّى تنزيلها وحلَّ ما تعتمد عليه. لكلّ نظامٍ مديرُه: `brew` لماك، و`apt` لدبيان وأوبونتو، و`dnf` لفيدورا، و`pacman` لأرش، و`pkg` لـFreeBSD.
])

على أوبونتو ودبيان — وهما أشهر ما ستلقاه على الخوادم — المدير اسمه `apt`. القاعدة أن تحدّث الفهرس أوّلًا، ثمّ تثبّت:

```bash
sudo apt update             # حدّث فهرس الحزم المتاحة
sudo apt install htop       # ثبّت أداة htop
sudo apt remove htop        # أزلها
```

قارِنه بأمر ماك المكافئ الذي تعرفه: `brew install htop` بلا `sudo`. الفكرة واحدة، والصيغة والصلاحيّة مختلفتان.

#distro[
  اسم المدير يتبع بيتَ لِينُكس الذي تزوره: على *فيدورا* هو `sudo dnf install htop`، وعلى *أرش* هو `sudo pacman -S htop`، وعلى *FreeBSD* (بيت الأعمام BSD) هو `sudo pkg install htop`. أوّل ما تفعله على خادمٍ جديدٍ أن تعرف مديره: جرّب `apt` فإن لم يوجد فـ`dnf`، وهكذا. أمّا `brew` فلن تجده مثبّتًا على لِينُكس افتراضيًّا (وإن كان يوجد منه نسخةٌ اختياريّة).
]

#try-it[
  على ماك، اطلب من Homebrew أن يريك ما ثبّته: `brew list`. تخيّل الآن أنّك على أوبونتو؛ الأمر المكافئ لسرد الحزم المثبّتة هو `apt list --installed`. لاحظ كيف يتغيّر اسم الأداة بينما تبقى الفكرة — «أرِني ما لديّ» — واحدة.
]

#section[الفرق الثاني: الخدمات — `launchd` مقابل `systemd`]

تعلّمتَ أنّ المدير الأعظم في ماك — صاحب المعرّف 1 الذي يشغّل الخدمات ويُبقيها حيّة — اسمه `launchd`، وتخاطبه بـ`launchctl` ووصفاتِ `plist`. على لِينُكس الحديث يقوم بالدور نفسه مديرٌ آخر اسمه `systemd`، وله لسانُه الخاصّ.

#define("systemd", [
  نظام الإقلاع وإدارة الخدمات في معظم توزيعات لِينُكس الحديثة (أوبونتو، دبيان، فيدورا...). هو نظير `launchd` عند ماك: العمليّة الأولى صاحبة المعرّف 1، تُشغّل خدمات النظام عند الإقلاع وتُبقيها حيّة. تخاطبه بأمر `systemctl`، ووصفاتُه ملفّاتُ `.service` نصيّةٌ بسيطة، لا ملفّات XML.
])

على خادم لِينُكس، بدل `launchctl` تكتب `systemctl`. وهذه أشهر أفعاله — لاحظ كم هي مقروءة:

```bash
systemctl status nginx        # ما حال خدمة الخادم nginx؟
sudo systemctl start nginx    # شغّلها الآن
sudo systemctl enable nginx   # فعّلها عند كلّ إقلاع
sudo systemctl restart nginx  # أعِد تشغيلها بعد تعديل إعدادها
```

على ماك يكون المكافئ لسرد الخدمات `launchctl list`؛ وعلى لِينُكس تسرد الخدمات النشِطة بـ `systemctl list-units --type=service`. المفهوم واحدٌ نقلًا عن يونِكس: مديرٌ أوّلُ يرعى العفاريت؛ لكنّ الأمر والصيغة يختلفان.

#distro[
  ليس كلّ خارج ماك يتكلّم `systemd`. على بيوت الأعمام BSD (مثل FreeBSD) لا وجود لـ`systemd` إطلاقًا؛ تُدار الخدمات هناك بالنظام العتيق `rc` وأمرٍ اسمه `service` (مثل `service nginx start`)، وتُفعَّل بسطرٍ في ملفّ `/etc/rc.conf`. فتذكّر: `launchd` لماك وحده، و`systemd` للِينُكس الحديث، و`rc` لعائلة BSD. ثلاث لهجاتٍ لفكرةٍ واحدة.
]

#try-it[
  إن اتّصلتَ بخادم لِينُكس، اسأله عن حال خدمةٍ شائعة دون أن تغيّر شيئًا: `systemctl status ssh` (أو `sshd`). تأمّل السطر الأخضر `active (running)` — هي الخدمة التي أدخلتك للتوّ. قارن الشعور بأمر ماك `launchctl list | grep ssh`: مفهومٌ واحد، لسانان.
]

#section[الفرق الثالث: الشبكة — `ifconfig` مقابل `ip`]

على ماك تقرأ عنوانك وواجهاتك بـ`ifconfig`، وقد نبّهناك في فصل الشبكات أنّ `ip` غير موجودةٍ على ماك. الآن على الجهة الأخرى: على لِينُكس الحديث حدث العكس تمامًا — هُجرت `ifconfig` (بل قد لا تكون مثبّتةً أصلًا) لصالح أداةٍ أحدث وأقوى اسمها `ip`.

الأمر `ip` بابٌ واحدٌ لكلّ ما يخصّ الشبكة، تتبعه كلمةٌ تحدّد ما تريد:

```bash
ip addr          # عناوين كلّ الواجهات (نظير ifconfig)
ip addr show eth0  # واجهةٌ بعينها
ip route         # جدول التوجيه: من أين تخرج البيانات؟
ip link          # الواجهات وحالتها (up/down)
```

لاحظ فرقًا صغيرًا في الأسماء أيضًا: واجهاتُ ماك تُسمّى `en0` و`en1`، بينما تُسمّى على لِينُكس غالبًا `eth0` (سلكيّة) أو أسماءً أطول مثل `enp3s0`، والواي‑فاي `wlan0`. الفكرة — «بابٌ للشبكة له اسمٌ وعنوان» — هي هي، والتسمية تختلف.

#distro[
  المفارقة اللطيفة: `ifconfig` التي على ماك ليست «طريقة ماك» فحسب، بل طريقة BSD كلِّها. فلو دخلتَ خادم FreeBSD لوجدتَ `ifconfig` في انتظارك كأنّك في بيتك، لأنّه من عائلة BSD مثل ماك. أمّا `ip` فأداة لِينُكس الحديثة. فحين ترى `ip addr` فأنت على لِينُكس؛ لكنّ وجود `ifconfig` وحده لا يحسم النظام، إذ قد تُثبَّت الأدوات القديمة على لِينُكس أيضًا.
]

#try-it[
  على خادم لِينُكس نفّذ `ip addr` وابحث عن سطرٍ يبدأ بـ`inet` يحمل عنوان الخادم — كما بحثتَ عن `inet` في ناتج `ifconfig` على ماك. ضع الناتجين جنبًا إلى جنب في ذهنك: المعلومة واحدة، والتغليف مختلف. ثمّ جرّب `ip route` لترى البوّابة التي يخرج منها الخادم إلى الإنترنت.
]

#section[الفرق الرابع: اللهجة — BSD مقابل GNU]

هذا الفرق الأعمق، وقد أفردنا له فصلًا كاملًا من منظور ماك. الخلاصة الجسريّة: أدوات ماك (‏`ls`‏، `sed`، `date`...) تتبع لهجة *BSD*، بينما تأتي معظم توزيعات لِينُكس بأدوات لهجة *GNU*. فحين تعبر إلى لِينُكس تنقلب المعادلة التي اعتدتها.

خذ المثال الأشهر: على ماك يلزمك أن تكتب علامتَي اقتباسٍ فارغتين بعد `-i` في `sed`، وإلّا فشل الأمر. على لِينُكس (GNU) العكس تمامًا — `-i` وحدها تكفي، بل إنّ `''` قد تُربكه:

```bash
sed -i '' 's/x/y/' f.txt   # صحيحٌ على ماك (BSD)
sed -i 's/x/y/' f.txt      # صحيحٌ على لِينُكس (GNU)
```

لهذا لا يوجد سطرٌ واحدٌ «صحيحٌ في المطلق»؛ فما تحفظه لماك قد ينكسر على الخادم، والعكس. القاعدة الذهبيّة للعابر: اسأل `uname -s` أوّلًا، ثمّ تكلّم اللهجة المناسبة.

#distro[
  حين تعبر إلى لِينُكس تصبح لهجة GNU هي *الأصل* لا الاستثناء، فتعمل عندك كلُّ وصفات الإنترنت المكتوبة للِينُكس بلا ترجمة. وعلى بيوت الأعمام BSD تجد لهجة BSD نفسها التي في ماك، فتشعر أنّك في بيتك أكثر من لِينُكس. تذكّر أنّ الاختلاف في *خياراتٍ* معدودة (`sed -i`، `ls -G` مقابل `--color`، `date -v` مقابل `date -d`)، لا في الأوامر كلِّها.
]

#try-it[
  على ماك جرّب سطر GNU الذي يفشل: أنشئ `echo hi > f.txt` ثمّ نفّذ `sed -i 's/hi/bye/' f.txt` (بلا `''`) — وشاهد رسالة الخطأ. الآن تخيّل أنّك على خادم لِينُكس: هذا السطر بالذات هو الصحيح هناك، و`sed -i ''` هو الذي يفشل. لهجتان معكوستان لأمرٍ واحد.
]

#section[حيث تشعر أنّك في بيتك]

بعد كلّ هذه الفروق، إليك الخبر المطمئن: القدر الأكبر ممّا تعلّمته يعبر الجسر *بلا تغييرٍ إطلاقًا*. هذه الأدوات والمفاهيم واحدةٌ على ماك ولِينُكس وBSD، لأنّها من صميم يونِكس المشترك:

- التنقّل والملفّات: `cd`، `ls`، `pwd`، `cp`، `mv`، `rm`، `mkdir`، `cat`، `less`.
- البحث والنصّ: `grep`، `find`، `wc`، `sort`، `head`، `tail`، والأنابيب `|` وإعادة التوجيه.
- الصدفة نفسها: `bash` و`zsh` تعملان في كلّ مكان، وقواعد المتغيّرات و`export` و`PATH` واحدة.
- الشبكة والتطوير: `ssh`، `scp`، `curl`، `git`، `ping`، والمحرّران `vim` و`nano`.
- العمليّات: `ps`، `top`، `kill`، `killall` — المفاهيم نفسها التي أتقنتها في فصل العمليّات.

بعبارةٍ واحدة: مهارتك في الطرفية ليست «مهارة ماك»، بل *مهارة يونِكس*. تعلّمتَها على ماك، وتصلح لأغلب خوادم الكوكب. هذا هو المكسب الحقيقيّ من الكتاب كلِّه.

#try-it[
  اكتب على ورقةٍ خمسة أوامرَ تستعملها يوميًّا على ماك. ثمّ ضع بجانب كلٍّ منها: «يعبر كما هو» أم «يحتاج انتباهًا». ستُفاجأ أنّ الأغلب الأعمّ يعبر سليمًا. هذا هو رأس مالك حين تجلس أوّل مرّةٍ أمام خادم لِينُكس.
]

#section[متى تنتبه: الفخاخ الخفيّة]

تبقى فروقٌ صغيرةٌ لا تُعلن عن نفسها، فتعثّرك بهدوء. هذا جدول نجاةٍ سريع بأشهرها:

#table(
  columns: (auto, 1fr, 1fr),
  [*المهمّة*], [*ماك*], [*لِينُكس*],
  [فتح ملفٍّ بتطبيقه], [`open ملف`], [`xdg-open ملف`],
  [النسخ إلى الحافظة], [`pbcopy` / `pbpaste`], [`xclip` أو `wl-copy`],
  [مدير الحزم], [`brew`], [`apt` / `dnf` / `pacman`],
  [إدارة الخدمات], [`launchctl`], [`systemctl`],
  [الشبكة], [`ifconfig`], [`ip`],
  [مجلّد المنزل], [`/Users/اسمك`], [`/home/اسمك`],
  [الصدفة الافتراضيّة], [`zsh`], [`bash` غالبًا],
)

انتبه بخاصّةٍ إلى ثلاثة فخاخ: أوّلها *مجلّد المنزل* — على ماك هو `/Users/اسمك` وعلى لِينُكس `/home/اسمك`، فأيُّ سكربتٍ كتبتَ فيه المسار صراحةً سينكسر؛ استعمل `$HOME` أو `~` دائمًا فهما يعملان في البيتين. وثانيها *حسّاسيّة الأحرف*: نظام ملفّات ماك افتراضيًّا لا يفرّق بين `File.txt` و`file.txt`، بينما يفرّق لِينُكس بينهما بحزم — فملفٌّ عمل عندك قد لا «يُوجَد» على الخادم لمجرّد اختلاف حرفٍ كبير. وثالثها *الصلاحيّات*: على الخوادم تكثر الحاجة إلى `sudo`، وتلقى أحيانًا حساب *الجذر* مباشرةً.

#define("الجذر (root)", [
  المستخدم الأعلى صلاحيّةً في نظام يونِكس، لا حدود لما يفعل. على ماك تحميه *حماية سلامة النظام* (SIP) حتى من الجذر، أمّا على خوادم لِينُكس فكثيرًا ما تعمل جذرًا مباشرةً أو عبر `sudo` بلا شبكة أمانٍ تُذكر. صلاحيّةٌ مطلقةٌ تعني مسؤوليّةً مطلقة: أمرٌ خاطئٌ واحدٌ يمحو النظام بلا سؤال.
])

#danger[
  الأمر `rm -rf` مدمّرٌ في *كلّ* بيوت القبيلة بلا سلّة مهملاتٍ ولا تراجع، وخطرُه على خادم لِينُكس أعظم لأنّك قد تكون جذرًا. و`rm -rf ~` كارثةٌ لا رجعة فيها؛ أمّا حذف `/` فتحجبه تطبيقاتٌ حديثةٌ من `rm` افتراضيًّا، لكن لا تعتمد على هذا الحاجز ولا تحاول تجاوزه. كذلك تختلف أدوات الأقراص اختلافًا تامًّا: على ماك `diskutil` (و`diskutil eraseDisk` يمحو قرصًا كاملًا)، وعلى لِينُكس `lsblk` و`fdisk` و`mkfs` (و`mkfs` يهيّئ قسمًا فيمحو كلّ ما فيه). لا تشغّل أمر أقراصٍ على نظامٍ لا تتقنه، ولا تنسخ أمرًا مدمّرًا من الإنترنت دون أن تفهم كلَّ حرفٍ فيه — خصوصًا وأنت جذرٌ على خادمٍ فيه بياناتُ غيرك.
]

#try-it[
  على ماك نفّذ `echo $HOME` ولاحظ أنّه يبدأ بـ`/Users`. تخيّل الآن نتيجته على خادم لِينُكس: سيبدأ بـ`/home`. لهذا لا تكتب المسار صراحةً في سكربتاتك أبدًا. ثمّ جرّب مفارقةً آمنة: أنشئ `touch A.txt a.txt` في مجلّدٍ فارغ على ماك، وعُدّ الملفّات بـ`ls` — قد تجد ملفًّا واحدًا لأنّ ماك لا يفرّق؛ على لِينُكس ستجد اثنين حتمًا.
]

#section[خلاصة الفصل]

عبرتَ الجسر من ماك إلى القبيلة كلِّها. عرفتَ أنّ ماك ولِينُكس وBSD ثلاثةُ بيوتٍ على أساس يونِكس الواحد، وأنّ ماك أقرب نسبًا إلى أعمامه BSD، وأنّ `uname -s` يخبرك في أيّ بيتٍ أنت. عبرتَ الجسر عمليًّا بـ`ssh` — الأداة التي لا تتغيّر — إلى خادم لِينُكس. ثمّ وازنتَ الفروق الأربعة: الحزم (`apt`/`pkg` مقابل `brew`)، والخدمات (`systemctl` مقابل `launchctl`)، والشبكة (`ip` مقابل `ifconfig`)، واللهجة (GNU مقابل BSD وانقلاب `sed -i`). ثمّ اطمأننتَ إلى أنّ أغلب مهارتك — التنقّل والنصّ والصدفة والشبكة والعمليّات — يعبر بلا تغيير، لأنّها *مهارة يونِكس* لا مهارة ماك. وأخيرًا حفظتَ فخاخ العبور: المسارات، وحسّاسيّة الأحرف، وصلاحيّة الجذر، وأدوات الأقراص المدمّرة. لم يعد الخادم البعيد أرضًا غريبة؛ صار بيتًا آخر لعائلةٍ تعرف لغتها. بهذا تُطوى صفحةُ ماك على أفقٍ أوسع منها.

#challenge[
  دون النظر أعلاه: أيّ أمرٍ واحدٍ تسأله على أيّ نظامٍ لتعرف هل أنت على ماك أم لِينُكس أم BSD؟ ثمّ ترجم ثلاثة أوامرٍ من ماك إلى لِينُكس: `brew install git`، و`launchctl list`، و`ifconfig`. بعدها فكّر: لو نسختَ سطر `sed -i '' 's/a/b/' f` من درسٍ خاصٍّ بماك ولصقتَه على خادم أوبونتو، ماذا سيحدث ولماذا؟ أخيرًا اذكر فخًّا واحدًا من فخاخ العبور قد يكسر سكربتًا نقلتَه من ماك إلى خادم لِينُكس دون أن يظهر خطأٌ صريح.
]
