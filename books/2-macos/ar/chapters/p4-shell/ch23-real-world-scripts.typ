#section[سكربتٌ ثانٍ: رتّبِ الصورَ بتاريخ التقاطها]

مجلّد التنزيلات مقبرةُ الصور. لنبنِ أداةً تمرّ عليه وتقرأ لكلّ صورةٍ *تاريخ التقاطها* من بيانات ماك الوصفيّة، ثم تنقلها إلى مجلّدٍ باسم «سنة/شهر».

#define([البيانات الوصفيّة و `mdls`], [
  يحفظ ماك مع كلّ ملفٍّ صفاتٍ يفهرسها محرّك Spotlight: نوعَه، وأبعادَه، وتاريخَ إنشاء *محتواه* (وهو في الصور تاريخ التقاطها من الكاميرا، لا تاريخ نسخ الملفّ). والأمر `mdls` يعرض هذه الصفات، ومفتاحُ تاريخ الالتقاط اسمه `kMDItemContentCreationDate`.
])

#warn[
  فخٌّ يخصّ قرّاء هذا الكتاب تحديدًا، اصطدمنا به ونحن نختبر السكربت: `mdls` يطبع التواريخ بتقويم *لغة نظامك* لا بالميلاديّ. وعلى ماكٍ منطقتُه عربيّة (`en_SA` مثلًا) يطبعه *هجريًّا*: `1448-02-09` بدل `2026-07-23`! ولا ينفعك تغيير `LANG` ولا `LC_ALL`، لأنّ `mdls` يقرأ المنطقة من `defaults read -g AppleLocale` لا من متغيّرات البيئة. والحلّ الموثوق: اطلب المخرَج بصيغة plist عبر `-plist -`، فتأتيك التواريخ دائمًا بصيغة ISO الميلاديّة: `2026-07-23T14:44:43Z`.
]

```zsh
#!/bin/zsh
set -euo pipefail
SRC=${1:-$HOME/Downloads}
DEST=${2:-$HOME/Pictures/مرتّبة}

# يطبع «سنة/شهر»، ويرجع إلى تاريخ إنشاء الملفّ إن غابت البيانات الوصفيّة
capture_ym() {
  local ym
  ym=$(mdls -name kMDItemContentCreationDate -plist - "$1" 2>/dev/null |
       sed -n 's|.*<date>\(....\)-\(..\).*|\1/\2|p') || ym=""
  [[ -n $ym ]] || ym=$(stat -f '%SB' -t '%Y/%m' "$1")
  printf '%s\n' "$ym"
}

moved=0
for f in "$SRC"/*(N.); do            # (N) لا تشتكِ إن لم تجد، (.) ملفّات فقط
  case ${${f##*.}:l} in              # الامتداد مصغَّر الحروف: PNG صارت png
    jpg|jpeg|png|heic|tiff|gif) ;;
    *) continue ;;
  esac
  ym=$(capture_ym "$f")
  mkdir -p "$DEST/$ym"
  mv -n "$f" "$DEST/$ym/"            # -n لا يكتب فوق ملفٍّ موجود أبدًا
  printf '%s  ->  %s/\n' "${f:t}" "$ym"
  moved=$((moved + 1))
done
printf 'نُقل %d من الصور إلى %s\n' "$moved" "$DEST"
```

الصيغة `${1:-افتراضي}` تعني «استعمل الوسيط الأوّل، فإن غاب فاستعمل هذه القيمة» — بها صار السكربت يعمل بلا وسائطَ أصلًا. والقوسان `(N.)` بعد النمط *مؤهِّلاتُ توسيعٍ* من كنوز zsh: `N` تقول «إن لم يطابق النمطُ شيئًا فأعطني قائمةً فارغةً بدل رسالة الخطأ»، و`.` تقول «ملفّاتٍ عاديّةً فقط، لا مجلّدات». وبديلُ `mdls` حين تغيب البيانات الوصفيّة هو `stat -f '%SB' -t '%Y/%m'`: الرمز `%SB` يعني *تاريخ ميلاد الملفّ* على نظام APFS، و`-t` يحدّد صيغة طباعته.

#warn[
  ولا تُهمل `|| ym=""` في ذيل السطر؛ فهي ليست زينة. جرّبنا حذفها: أعطينا الدالّةَ مسارًا لا وجود له، ففشل `mdls`، فحوّل `pipefail` فشلَه إلى فشلٍ للأنبوب كلِّه، فحوّله `set -e` إلى موتٍ للسكربت من أوّل ملفٍّ عصيّ — قبل أن يبلغ سطرَ البديل أصلًا. تلك ضريبةُ الدرع العادلة: ما دمتَ أمرتَ سكربتك أن يقف عند أوّل عطب، فعليك أن تدلّه صراحةً على المواضع التي يتسامح فيها. وعلامةُ التسامح هي `||` يتبعها بديلٌ فارغ.
]

#session("./sort-photos.zsh ~/تجربة/وارد ~/تجربة/مرتّبة", output: "رحلة الطائف.png  ->  2026/07/
صورة العائلة.jpg  ->  2024/01/
لقطة شاشة.PNG  ->  2026/07/
نُقل 3 من الصور إلى /Users/ghazi/تجربة/مرتّبة")

#try-it[
  لا تجرّبه على تنزيلاتك الحقيقيّة أوّل مرّة. أنشئ `~/تجربة/وارد` وانسخ إليه ثلاث صور، وغيّر تاريخ إحداها بـ`touch -t 202401151200 صورة.jpg`، ثم شغّله واسرد النتيجة بـ`find ~/تجربة/مرتّبة -type f`: هل ظهر مجلّدان مختلفان؟ ثم نفّذ `mdls -name kMDItemContentCreationDate صورة.jpg` بلا `-plist` وقارن التقويم.
]

#section[سكربتٌ ثالث: تقريرُ حالةٍ للجهاز في نظرةٍ واحدة]

كلُّ معلوماتِ جهازك متاحةٌ في الطرفية، لكنها مبعثرةٌ في خمسة أوامر. لنجمعها في لوحةٍ واحدةٍ مرتّبة.

```zsh
#!/bin/zsh
set -euo pipefail
title() { printf '\n  %s\n  %s\n' "$1" "──────────────────────"; }
row()   { printf '  %-12s %s\n' "$1" "$2"; }

title "النظام"
row "الجهاز"  "$(scutil --get ComputerName)"
row "الإصدار" "$(sw_vers -productName) $(sw_vers -productVersion) ($(sw_vers -buildVersion))"
row "الطراز"  "$(sysctl -n hw.model)"
row "المعالج" "$(sysctl -n machdep.cpu.brand_string)"
row "منذ"     "$(uptime | sed 's/.*up *\([^,]*\),.*/\1/')"
row "الحِمل"  "$(sysctl -n vm.loadavg | tr -d '{}' | xargs)"

df -h / | awk 'NR==2 {print $2, $3, $4, $5}' | read -r total used avail pct
title "قرص النظام"
row "الكلّي" "$total"; row "المستعمَل" "$used ($pct)"; row "المتاح" "$avail"

title "الذاكرة"
row "الكلّية" "$(( $(sysctl -n hw.memsize) / 1073741824 )) GiB"
row "المتاحة" "$(vm_stat | awk '/page size of/{p=$8} /Pages free/{f=$3}
                 /Pages inactive/{i=$3} /Pages speculative/{s=$3}
                 END {printf "%.1f GiB", (f+i+s)*p/1073741824}')"
```

وهذا ما طبعه على الماك الذي كُتب عليه هذا الفصل:

#session("./status.zsh", output: "  النظام
  ──────────────────────
  الجهاز       Ghazi's MacBook Pro
  الإصدار      macOS 26.5.2 (25F84)
  الطراز       MacBookPro16,1
  المعالج      Intel(R) Core(TM) i9-9880H CPU @ 2.30GHz
  منذ          3:34
  الحِمل       2.64 2.40 2.25

  قرص النظام
  ──────────────────────
  الكلّي       932Gi
  المستعمَل    12Gi (2%)
  المتاح       815Gi

  الذاكرة
  ──────────────────────
  الكلّية      16 GiB
  المتاحة      6.6 GiB")

الدالّتان `title` و`row` هما سرُّ ترتيب المخرَج: عرّفتَ شكل السطر مرّةً واحدةً فصار كلُّ سطرٍ بعدها متناسقًا بلا جهد. أمّا `vm_stat` فيعدّ الذاكرة #emph[بالصفحات] لا بالبايتات، فيقرأ `awk` حجمَ الصفحة من ترويسة المخرَج ثم يضربه في عدد الصفحات الحرّة والخاملة والمضاربيّة ليعطيك رقمًا بالجيجابايت.

#note[
  في السطر `df -h / | awk '...' | read -r total used avail pct` فرقٌ جوهريٌّ بين الصدفتين تحقّقنا منه بأنفسنا: zsh تنفّذ *آخر أمرٍ* في الأنبوب داخل الصدفة نفسها، فتبقى المتغيّرات محفوظةً بعده؛ أمّا bash فتنفّذه في صدفةٍ فرعيّة، فتموت المتغيّرات مع نهاية الأنبوب وتخرج فارغة. شغّلنا `echo hello | read x` في الصدفتين: طبعت zsh القيمة، وطبعت bash فراغًا. فإن نقلتَ هذا السطر إلى سكربت bash فاستبدل به الصيغة `read ... <<< "$(...)"`.
]

#deep[
  ولماذا اضطربت محاذاة أعمدةٍ نسّقناها داخل `awk` بينما استقامت في `printf` الصدفة؟ لأنّ نسخة `awk` البِرْكليّة على ماك تحسب عرض الحقل #emph[بالبايتات]، والحرف العربيّ في ترميز UTF-8 بايتان لا واحد. قِسناها: `printf "[%-12s]" "الجهاز"` في zsh يملأ الفراغَ الباقي فيستقيم العمود، وفي `awk` وفي `/usr/bin/printf` لا يملؤه لأنّ الكلمة عندهما اثنا عشر بايتًا فقد امتلأ الحقل. والقاعدة العمليّة: نسّق العربيّة بـ`printf` الصدفة، ودع `awk` للحساب والاستخراج.
]

#try-it[
  انسخ `status.zsh` وشغّله، ثم فكّكه بيدك: نفّذ `sysctl -n hw.model` وحده، ثم `df -h /` وحده، ثم `vm_stat | head -5`. في أيّ حقلٍ من ترويسة `vm_stat` وجد `awk` حجمَ الصفحة؟ وهل هو نفسه على جهازك؟ ثم زد إلى اللوحة سطرًا جديدًا: `row "المستخدم" "$(whoami)"`. وأخيرًا اطبع سطرًا بـ`echo` عاريةً بدل الدالّة `row` وقارن الصفّين: كم فقدت اللوحة من استقامتها بسطرٍ واحدٍ خرج عن القالب؟
]

#section[سكربتٌ رابع: إعادة تسميةٍ بالجملة لا تندم عليها]

إعادة تسمية مئة ملفٍّ دفعةً واحدةً قوّةٌ عظيمة — وخطأٌ واحدٌ فيها يخلط أسماءها كلَّها بلا رجعة. لذلك مبدأُ هذه الأداة: *أرِني قبل أن تفعل*.

#define("وضع المعاينة (dry run)", [
  وضعُ تشغيلٍ يطبع فيه البرنامجُ كلَّ ما *كان سيفعله* دون أن يغيّر شيئًا في الواقع. عُرفٌ متّبعٌ في أدوات النظام الجادّة (تجده في `rsync` و`git` وغيرهما) واسمُه المتعارف `--dry-run`. اجعله في كلّ أداةٍ تكتبها تغيّر ملفّات.
])

```zsh
#!/bin/zsh
set -euo pipefail
usage() { echo "الاستعمال: rename.zsh -s <نصّ> -r <بديل> [--dry-run] ملفّات..."; }

# getopts لا يفهم الخيارات الطويلة، فنترجمها إلى قصيرةٍ قبل أن يراها
args=()
for a in "$@"; do
  case $a in
    --dry-run) args+=(-n) ;;
    --help)    args+=(-h) ;;
    *)         args+=("$a") ;;
  esac
done
set -- "${args[@]}"          # أعِد بناء قائمة الوسائط بعد الترجمة

find_str="" repl_str="" dry=0
while getopts ":s:r:nh" opt; do
  case $opt in
    s) find_str=$OPTARG ;;   r) repl_str=$OPTARG ;;
    n) dry=1 ;;              h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[[ -n $find_str && $# -gt 0 ]] || { usage >&2; exit 2; }

count=0
for f in "$@"; do
  [[ -f $f ]] || continue
  dir=${f:h}; old=${f:t}              # :h المجلّد، :t اسم الملفّ وحده
  new=${old//$find_str/$repl_str}     # //  تستبدل كلّ المواضع لا الأوّل فقط
  [[ $new != "$old" ]] || continue    # لم يتغيّر شيء؟ تخطَّ
  if (( dry )); then
    printf '[معاينة] %s  ->  %s\n' "$old" "$new"
  elif [[ -e $dir/$new ]]; then
    echo "تخطّيت (الاسم مشغول): $new" >&2; continue
  else
    mv -n "$f" "$dir/$new"; printf '%s  ->  %s\n' "$old" "$new"
  fi
  count=$((count + 1))
done

if (( dry )); then
  echo "معاينة: $count من الملفّات. أعد الأمر بلا --dry-run للتنفيذ."
else
  echo "أُعيدت تسمية $count من الملفّات."
fi
```

والحيلة الأنيقة أعلاه هي *ترجمة الخيارات الطويلة*: نمرّ على الوسائط فنبدّل `--dry-run` بـ`-n`، ثم يعيد `set --` بناءَ قائمة الوسائط من المصفوفة المترجَمة، فيرى `getopts` صيغةً يفهمها. بهذا تكسب راحةَ الخيارات الطويلة وبساطةَ `getopts` معًا.

#session("./rename.zsh -s IMG -r رحلة --dry-run *.jpg", output: "[معاينة] IMG 0003.jpg  ->  رحلة 0003.jpg
[معاينة] IMG_0001.jpg  ->  رحلة_0001.jpg
معاينة: 2 من الملفّات. أعد الأمر بلا --dry-run للتنفيذ.")

ولعلّك سألت: لِمَ سبق `IMG 0003.jpg` أخاه في المخرَج وأنت كتبتَ `*.jpg` وحدها؟ لأنّ الصدفة هي التي رتّبت الأسماء قبل أن يراها السكربت، وترتيبُها بقيمة المحارف لا بالألفة: قيمة الفراغ أصغر من قيمة الشَّرطة السفليّة فتَقدّمُ عليها. تذكّر هذا كلّما بدا لك مخرَجُ حلقةٍ «غيرَ مرتّب»؛ فالترتيب قائمٌ، لكنّه ترتيب الحاسوب لا ترتيبك.

وموضعٌ آخرُ يستحقّ الانتباه: الصيغة `${old//$find_str/$repl_str}` تبحث في zsh عن قيمة `$find_str` *نصًّا حرفيًّا*، فلو أعطيتَها نجمةً بحثت عن نجمة. أمّا bash فتعامل القيمة نمطًا، فالنجمة عندها «أيُّ شيء» فتبتلع الاسم كلَّه. جرّبنا الصيغة على النصّ `a*b` بقيمة `*` للبحث و`X` للبديل: أعطت zsh الجواب `aXb` وأعطت bash الجواب `X` وحده. فرقٌ صامتٌ يقلب أداةً آمنةً إلى ماحيةِ أسماء، وهو سببٌ ثانٍ لأن تكتب أداتك بلغةٍ واحدةٍ وتختبرها فيها.

#warn[
  وانتبه لِمَ ختمنا السكربت بجملة `if` كاملةٍ لا بالمختصر `(( dry )) && echo "..."`. جرّبنا المختصر ففضح نفسه: حين تكون `dry` صفرًا يخرج آخرُ أمرٍ في السكربت بالقيمة `1`، فيرث السكربتُ كلُّه هذه القيمة ويبدو فاشلًا مع أنه أدّى عمله كاملًا — وسجّلنا `exit=1` بأعيننا. القاعدة: احرص أن يكون *آخر* أمرٍ في سكربتك ناجحًا، وإلّا فاختم بـ`exit 0` صريحة.
]

ويبقى خطرٌ أخيرٌ لا يخصّ هذه الأداة وحدها، بل كلَّ سطرٍ كتبتَه في هذا الفصل وكلَّ سطرٍ ستكتبه بعده:

#danger[
  المتغيّر الفارغ في أمرٍ مدمّرٍ أخطرُ ما في السكربتات. نفّذنا هذا فعلًا مع `echo` أمام `rm` لنرى ماذا كان سيقع لو نُسيت: عرّفنا `dir=""` ثم كتبنا `echo rm -rf "$dir/"*` فطُبع على الشاشة: `rm -rf /Applications /Library /System /Users ...` — أي النظامَ كلَّه. والحارس سطرٌ واحدٌ تضعه قبل أيّ حذف: `: "${dir:?المجلّد غير محدَّد}"`؛ فالصيغة `${var:?رسالة}` توقف السكربت فورًا برسالتك إن كان المتغيّر فارغًا أو غير معرَّف. اكتبها، ثم نَمْ قرير العين.
]

#try-it[
  أنشئ مجلّدًا فيه أربعة ملفّاتٍ وهميّة: `touch IMG_1.jpg IMG_2.jpg "IMG 3.jpg" ملاحظات.txt`. شغّل الأداة بـ`--dry-run` أوّلًا واقرأ المعاينة، ثم شغّلها بلا الخيار واسرد المجلّد. وثلاثةُ أسئلة: لماذا لم تمسّ `ملاحظات.txt`؟ وماذا يحدث لو شغّلتَها مرّتين متتاليتين بالخيارات نفسها؟ وكيف تعيد الأسماء إلى حالتها الأولى؟
]

#section[أدوات ماك في خدمة سكربتك]

هنا يفترق سكربت ماك عن أخيه على لِينُكس فراقًا ظاهرًا: نظامُك يقدّم لك أدواتٍ صغيرةً تصل سطرَ الأمر بواجهة النظام الرسوميّة نفسها، فيتكلّم سكربتك ويُنبّه ويفتح النوافذ.

#subsection[أن يخاطبك سكربتك: التنبيه والحوار]

الجسر الأوّل اسمه `osascript`: أمرٌ يأخذ جملةً بلغة AppleScript — لغةِ أتمتة التطبيقات في ماك — فينفّذها ويعيد لك نتيجتها نصًّا.

```zsh
notify() { osascript -e "display notification \"$2\" with title \"$1\""; }

notify "backup.zsh" "اكتملت النسخة الاحتياطيّة"    # تنبيهٌ لا يوقف السكربت

# حوارٌ رسوميّ بمهلة. اكتب جملة AppleScript في سطرٍ واحد بلا شَرطة استمرار
osascript -e 'display dialog "أتريد المتابعة؟" buttons {"لا","نعم"} giving up after 10'
```

الفرق بين السطرين جوهريّ: `display notification` يومض في ركن الشاشة ويمضي السكربت في طريقه، أمّا `display dialog` فيقف منتظرًا جوابك. ولذلك تلزمه مهلة.

#tip[
  عبارة `giving up after 10` في `display dialog` ضرورةٌ لا زينة: السكربت الذي ينتظر ضغطةً لن تأتي — لأنك شغّلته من مهمّةٍ مجدولةٍ مثلًا — يعلّق إلى الأبد. ومع المهلة يستسلم الحوار ويعيد `button returned:, gave up:true` فيمضي سكربتك في طريقه. اجعل كلّ حوارٍ محدودًا بزمن.
]

#warn[
  لا تكسر جملة AppleScript على سطرين بشَرطةٍ مائلة `\` داخل الاقتباس المفرد. كتبناها هكذا أوّل مرّةٍ فردّ النظام: `syntax error: A unknown token can't go after this "}"`. والسبب أنّ الشَّرطة داخل `'...'` لا تعني للصدفة «تابعْ في السطر التالي»، بل تُمرَّر حرفًا حقيقيًّا إلى AppleScript فتفسد جملته. اكتب جملة `osascript` في سطرٍ واحدٍ مهما طال.
]

#subsection[الحافظة والفهرس والتفضيلات]

وبقيّة الجسور أصغر وأسرع، وكلُّها أوامر ماكيّةٌ محضة:

```zsh
echo "نتيجة: 42" | pbcopy         # ضع نصًّا في الحافظة
clip=$(pbpaste)                   # واقرأ ما فيها

# كم ملفّ PDF على سطح المكتب؟ mdfind يسأل فهرس Spotlight لا القرص
mdfind -onlyin ~/Desktop 'kMDItemContentType == "com.adobe.pdf"' | wc -l

# هل النظام في الوضع الداكن؟ الدالّة تُرجِع صفرًا (نجاحًا) إن كان كذلك
dark_mode() { [[ $(defaults read -g AppleInterfaceStyle 2>/dev/null) == Dark ]]; }

say "انتهى العمل"                 # ينطق النصّ بصوت النظام
open ~/Backups                    # يفتح المجلّد في Finder
open -a "Safari" https://ar.wikipedia.org
```

ولاحظ في `dark_mode` كيف صِيغت الدالّة *سؤالًا* لا مطبعةً للنصّ: هي لا تطبع شيئًا، بل تُرجِع قيمة خروجٍ تصلح شرطًا لـ`if` مباشرةً. وسرُّ هذا الصمت `2>/dev/null` بعد `defaults read`: فحين يكون النظام في الوضع الفاتح لا يوجد المفتاح أصلًا، فيشكو `defaults` — ونحن لا نريد شكواه، بل جوابه.

#distro[
  هذه الأدوات من صميم ماك ولا وجود لها على لِينُكس أو BSD. وما يقابلها هناك: `notify-send` بدل `display notification`، و`xclip` أو `wl-copy` بدل `pbcopy`، و`locate` بدل `mdfind` (وهو أضعف: يبحث في الأسماء لا في البيانات الوصفيّة)، و`xdg-open` بدل `open`، و`espeak` بدل `say`. أمّا `defaults` فلا نظير له، لأنّ نظام التفضيلات نفسه من ابتكار ماك.
]

#try-it[
  صِلْ ما بنيتَه بنظامك: أضف إلى آخر `backup.zsh` سطرًا واحدًا `notify "النسخ الاحتياطيّ" "اكتمل: $(basename "$archive")"` وشغّله، وراقب ركن شاشتك. ثم مرّر ملخّص النسخة إلى الحافظة بـ`pbcopy` والصقه في أيّ نافذة. وأخيرًا اسأل جهازك بـ`mdfind` عن عدد صور PNG في مجلّد تنزيلاتك، ثم اسأله السؤال نفسه بـ`find ~/Downloads -name "*.png" | wc -l`: أيُّهما أسرع؟ ولماذا — من أين يقرأ كلٌّ منهما؟
]

#section[أن يصير سكربتك أمرًا، وأن ينطق حين يعصيك]

ما دام سكربتك يُنادى بـ`./rename.zsh` فهو ملفٌّ في مجلّد. وحين تناديه باسمه المجرّد `rename` من أيّ مكانٍ في النظام، يصير *أمرًا* كسائر أوامرك. والطريق إلى ذلك ثلاث خطوات:

```zsh
mkdir -p ~/bin                       # 1. مجلّد أدواتك الخاصّة
cp rename.zsh ~/bin/rename           # 2. انسخه بلا لاحقة — الأوامر لا لواحق لها
chmod +x ~/bin/rename                # 3. امنحه إذن التنفيذ

echo 'export PATH="$HOME/bin:$PATH"' >> ~/.zprofile   # عرِّف الصدفةَ بمجلّدك
source ~/.zprofile                                    # فعِّل التعديل الآن
```

بعدها تكتب `rename -s IMG -r رحلة --dry-run *.jpg` من أيّ مجلّدٍ فيعمل، و`command -v rename` يطبع مساره الكامل ليطمئنك أنّ الصدفة وجدته. ولاحظ أنّنا كتبنا السطر في `~/.zprofile` لا في `~/.zshrc`: فقد عرفتَ في فصل البيئة وتخصيص zsh أنّ ماك يبني مسارك الأساسيّ بأداة `path_helper` عند تسجيل الدخول، وأنّ موضع المسار هو ملفّ الدخول لا ملفّ الجلسة التفاعليّة.

#tip[
  ولماذا `~/bin` لا `/usr/local/bin`؟ لأنّ `~/bin` ملكُك وحدك: تكتب فيه بلا `sudo`، ولا يرى أدواتِك أحدٌ غيرك على الجهاز. أمّا `/usr/local/bin` فمشتركٌ بين كلّ مستخدمي الجهاز، وهو مذكورٌ أصلًا في مسار النظام (اقرأه بـ`cat /etc/paths`) وفيه يضع Homebrew أدواته على معالجات Intel — فمزاحمتُه بسكربتاتك الشخصيّة سوءُ أدب. وإن لم تجد الصدفةُ سكربتك الجديد فورًا في جلستك المفتوحة فنفّذ `rehash`؛ فـzsh تحفظ جدولًا بأماكن الأوامر تسريعًا للبحث.
]

وسيأتي يومٌ يعمل فيه سكربتك عكسَ ما تتوقّع. عندها لا تُحدّق في الشيفرة، بل اطلب من الصدفة أن تريك ما تفعله بالضبط. والخيار `-n` يقرأ السكربت ويفحص نحوَه *دون أن ينفّذ منه شيئًا* — فحصٌ آمنٌ تمامًا يكشف القوس الناقص و`fi` المنسيّة في ثانية. أمّا `-x` فيطبع كلَّ سطرٍ *بعد استبدال المتغيّرات* قبيل تنفيذه:

#session("zsh -x dbg.zsh", output: "+dbg.zsh:2> name=غازي
+dbg.zsh:3> count=5
+dbg.zsh:4> echo 'غازي لديه 5 ملفّات'
غازي لديه 5 ملفّات")

انظر السطر الموسوم `dbg.zsh:3`: طُبع `count=5` لا `count=$(( 2 + 3 ))` — فأنت ترى القيمةَ التي وصلت فعلًا، لا ما كتبتَه أنت. (والرقم بعد النقطتين رقمُ السطر في ملفّك، فهو يدلّك على موضعك بلا عدٍّ.) وهذا بالضبط ما يكشف المتغيّر الفارغ والاقتباس المفقود. وإن كان سكربتك طويلًا ولا تريد تتبّعه كلَّه، فحاصِر المقطع المشكوك فيه بين `set -x` و`set +x`.

#note[
  الأداة الشهيرة `shellcheck` (تثبّتها بـ`brew install shellcheck`) تفحص سكربتك وتنبّهك إلى المتغيّرات غير المقتبَسة والأخطاء الشائعة قبل أن تشغّله. لكنْ لها حدٌّ مهمٌّ لا يُذكر كثيرًا: *لا تدعم zsh*؛ فهي مصمّمةٌ لـ`sh` وbash وksh. فإن أردت الاستفادة منها فاكتب سكربتك بلغة `#!/bin/bash` القياسيّة؛ وإن بقيتَ في zsh فسلاحك `zsh -n` و`zsh -x` وحُسنُ العادات التي تعلّمتها في هذا الفصل.
]

#try-it[
  انقل `status.zsh` إلى `~/bin/status` وامنحه الإذن، ثم ناده باسمه من مجلّدٍ آخر. بعدها احذف منه عمدًا قوسًا مغلقًا ونفّذ `zsh -n ~/bin/status`: أيَّ رقم سطرٍ ذكر؟ أصلحه، ثم نفّذ `zsh -x ~/bin/status 2>&1 | head -20` واقرأ الأسطر المسبوقة بعلامة `+`: كم أمرًا فرعيًّا شغّله سكربتك قبل أن يطبع أوّل سطرٍ من التقرير؟
]

#section[خلاصة الفصل]

عبرتَ في هذا الفصل من «أعرف الأدوات» إلى «أصنع بها». تعلّمتَ أوّلًا أنّ متانة السكربت ليست في طوله بل في درعه: `set -euo pipefail` يوقفه عند أوّل عطبٍ ولا يدعه يمضي أعمى، و`IFS` يحميه من الفراغات في أسماء ملفّات ماك، و`trap cleanup EXIT` مع أختيها `INT` و`TERM` تضمن أن ينظّف خلفه مهما كانت نهايته — ورأيتَ لماذا تُفصل الثلاث ولا تُجمع في سطر. ثم فتحتَ أبوابه لمستعمله بـ`$@` و`getopts` ودالّة `usage`. وبنيتَ بعدها أربع أدواتٍ تعمل: نسخةً احتياطيّةً مؤرَّخةً تُبقي آخر سبع نسخٍ بحيلة `ls -1t` و`tail`، ومرتِّبَ صورٍ يقرأ تاريخ الالتقاط بـ`mdls -plist` بعد أن تجاوزتَ فخّ التقويم الهجريّ، وتقريرَ حالةٍ يجمع `sw_vers` و`df` و`uptime` و`vm_stat` في لوحةٍ واحدة، وأداةَ إعادة تسميةٍ لا تلمس ملفًّا قبل أن تريك المعاينة. ووصلتَ سكربتك بنظامك عبر `osascript` و`pbcopy` و`mdfind` و`defaults` و`say` و`open`، ثم رفعتَه إلى مرتبة الأوامر بوضعه في `~/bin`، وتعلّمتَ أن تسأله عن نفسه بـ`zsh -n` و`zsh -x` حين يعصيك. بقي سؤالٌ واحد: مَن يشغّل هذه الأدوات نيابةً عنك كلّ ليلةٍ وأنت نائم؟ ذاك ما يفتحه الجزء التالي حين نلتقي بحارس المهامّ في ماك.

#challenge[
  ابنِ أداةً واحدةً اسمها `tidy` تجمع كلَّ ما في هذا الفصل، وضعها في `~/bin` لتناديها باسمها. (1) لتكن مدرَّعةً بالكامل: `set -euo pipefail` و`IFS` مضبوطٌ، و`trap` ينظّف مجلّدًا مؤقّتًا تصنعه بـ`mktemp -d`، ودالّةُ `usage` تُطبع عند `-h` وعند كلّ خطأٍ في الاستعمال. (2) ولتقبل بـ`getopts` ثلاثة خيارات: `-d` للمجلّد المستهدَف (افتراضه `~/Downloads`)، و`-k` لعدد النسخ المحفوظة، و`--dry-run` للمعاينة — ولتُترجم الخيار الطويل إلى قصيرٍ كما فعلنا. وليصنع أرشيفًا مؤرَّخًا للمجلّد قبل أن يمسّه، ثم يرتّب صوره في «سنة/شهر»، ثم يُبقي آخر `k` أرشيفًا. (3) ولْيختم بتقريرٍ يطبع عدد ما نُقل وحجمَ الأرشيف، ويضع الملخّص في الحافظة بـ`pbcopy`، ويعلنه بتنبيه `osascript`. جرّبه في `~/تجربة` أوّلًا وبـ`--dry-run` دائمًا، ولا توجّهه إلى تنزيلاتك الحقيقيّة إلّا بعد أن تراه يعمل مرّتين متتاليتين بلا مفاجأة.
]
