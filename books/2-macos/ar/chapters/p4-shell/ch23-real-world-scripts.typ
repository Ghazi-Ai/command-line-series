#section[الوسائط: كيف يكلّمك مستخدمُ سكربتك؟]

عرفتَ في فصل التحكّم بالتدفّق والدوال أنّ `$1` أوّلُ وسيطٍ و`$@` جميعُها و`$#` عددُها. والأداةُ الناضجة تزيد على ذلك أنها تقبل *خياراتٍ* تُكتب بأيّ ترتيب: `-n` و`-c 3` و`-h`. والأداة التي تفكّها لك موجودةٌ في الصدفة نفسها.

#define("getopts", [
  أمرٌ مدمجٌ في الصدفة يقرأ خيارات سطر الأمر واحدًا واحدًا. تعطيه *نصَّ صيغةٍ* مثل `":n:c:vh"`: كلُّ حرفٍ خيارٌ مقبول، والنقطتان بعد الحرف تعنيان «هذا الخيار يأخذ قيمة»، والنقطتان في أوّل النصّ تُسكتان رسائله الافتراضيّة لتكتب أنت رسائلك بلغتك.
])

```zsh
usage() {
  cat <<'HELP'
الاستعمال: greet.zsh [-n اسم] [-c عدد] [-v] [-h]
  -n اسم    الاسم الذي نحيّيه      -v   وضع الثرثرة
  -c عدد    كم مرّة نحيّيه         -h   اعرض هذه المساعدة
HELP
}

name="صديقي"; count=1; verbose=0

while getopts ":n:c:vh" opt; do
  case $opt in
    n)  name=$OPTARG ;;                                  # القيمة تصل في OPTARG
    c)  count=$OPTARG ;;
    v)  verbose=1 ;;
    h)  usage; exit 0 ;;
    \?) echo "خيار مجهول: -$OPTARG" >&2; usage; exit 2 ;;
    :)  echo "الخيار -$OPTARG يحتاج قيمة" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))    # تخطَّ الخيارات، فيصير "$@" هو الملفّات وحدها
```

الصيغة `cat <<'HELP' ... HELP` تسمّى *الوثيقة هنا*: كتلةُ نصٍّ متعدّدةُ الأسطر تنتهي بالكلمة التي سمّيتها، وإحاطةُ `'HELP'` بالاقتباس المفرد تمنع استبدال المتغيّرات داخلها. أمّا `OPTIND` فعدّادٌ تحرّكه `getopts`، و`shift $((OPTIND - 1))` تزيح الخيارات المستهلَكة فيبقى في `"$@"` ما بعدها.

#session("./greet.zsh -n غازي -c 2 -v ملف1 ملف2", output: "[ثرثرة] بقي من الوسائط: 2
مرحبًا يا غازي (1)
مرحبًا يا غازي (2)")

#warn[
  أحِطْ `"$@"` بالاقتباس المزدوج دائمًا، ووجّه رسائل الأخطاء إلى تيّار الأخطاء بـ`>&2` لا إلى المخرَج القياسيّ — وقد فرّقتَ بينهما في فصل التدفّقات وإعادة التوجيه والأنابيب. أمّا الاقتباس فجرّبنا تركه على هذا الجهاز: مرّرنا إلى سكربتٍ ملفَّين في اسمَيهما فراغ، فسلِم الاسمان في zsh مقتبَسَين وغيرَ مقتبَسَين، بينما قسّمتهما bash فصار «ملف أول.txt» ملفَّين وهميَّين: `ملف` و`أول.txt`. ولأنّ سكربتاتك ستُقرأ وتُنسَخ إلى صدفاتٍ أخرى، اجعل الاقتباس عادةً لا اجتهادًا.
]

