#chapter[العمليات: نبض النظام]

#objectives((
  [تفرّق بين البرنامج الساكن على القرص والعملية الحيّة، وتتسلّق شجرة النسب بـ`PID` و`PPID` حتى جذرها رقم 1.],
  [تستخرج ما تريد من `ps` بصيغتيه، وتصطاد بالاسم بـ`pgrep`، وتراقب النبض حيًّا بـ`top` و`htop`.],
  [تخاطب العمليّات بالإشارات: `TERM` تطلب، و`KILL` تبطش، و`STOP` و`CONT` تجمّد وتُحيي.],
  [تنقل مهامّك بين المقدّمة والخلفيّة، وتعرف ما يبقى حيًّا بعد إغلاق الطرفية وما يموت معها.],
  [تكشف بـ`lsof` مَن يمسك ملفًّا أو يجلس على منفذ، وتضبط الأولويّة بـ`nice` وسقوفَ الموارد بـ`ulimit`.],
))

تخيّل نوتةً موسيقيّةً منسيّةً على رفّ: أوراقٌ مرتّبةٌ دقيقة، لكنّها صامتةٌ لا حركة فيها. ثم يرفعها عازفٌ ويبدأ، فيولد شيءٌ آخر: صوتٌ له بدايةٌ ونهاية، وسرعةٌ ونبرة، يشغل من الزمن قدرًا ومن انتباه الناس قدرًا. النوتةُ هي البرنامج على قرصك، والعزفُ هو *العملية*. وفي جهازك الآن مئاتُ العازفين، ونواةُ النظام قائدُ أوركسترا لا تراه يوزّع عليهم الوقت جزءًا من الثانية تلو الآخر. وهذا الفصل يُجلسك مكانه: ترى العازفين، وتخاطبهم، وتُسكت مَن علا صوتُه.

#section[العملية: البرنامج وقد دبّت فيه الحياة]

الملفُّ التنفيذيّ على قرصك جمادٌ ينتظر. وما إن تشغّله حتى تحجز له النواةُ ذاكرةً، وتمنحه هويّةَ مَن أطلقه، وتقسم له نصيبًا من المعالج. هذه النسخةُ الحيّةُ العاملة هي العملية.

#define("العملية (Process)", [
  برنامجٌ قيدَ التنفيذ في هذه اللحظة، بذاكرته الخاصّة التي لا يشاركه فيها أحد، وهويّته (مالكه)، ومجلّده الحاليّ، وملفّاته المفتوحة، وبيئته. والبرنامج الواحد قد يعمل في عدّة عمليّاتٍ معًا — كنسخةٍ لكلّ تبويبةٍ في المتصفّح — ولكلٍّ منها ذاكرتُها المعزولة عن أختها.
])

ولأنّ العمليّات كثيرةٌ ومتشابهةُ الأسماء، لا يميّزها النظام بالاسم بل برقمٍ فريد.

#define("معرّف العملية (PID)", [
  رقمٌ صحيحٌ فريدٌ تمنحه النواةُ لكلّ عمليّةٍ عند ولادتها، اختصارًا لـ Process IDentifier. به تشير إليها بلا لبسٍ حين تراقبها أو تخاطبها. ولا يُعاد استعمال الرقم إلّا بعد أن تموت صاحبتُه ويدور العدّاد دورةً كاملة.
])

#subsection[شجرة النسب: مَن أنجب مَن؟]

لا تولد عمليّةٌ من عدم: كلُّ عمليّةٍ تُنجبها أخرى، فيسجّل النظام لها مع معرّفها *معرّفَ أبيها* (`PPID`)، فتنتظم العمليّاتُ كلُّها في شجرةِ نسبٍ واحدة. والمتغيّر `$$` يحمل معرّف صدفتك، تقرؤه بـ`echo $$` ثم تسأل عنه:

#session("ps -o pid,ppid,comm -p 33393", output: "  PID  PPID COMM
33393  1214 /bin/zsh")

صدفتُك ابنةُ تطبيق الطرفية الذي فتحتَه، وذاك ابنُ غيره، وهكذا صعودًا حتى جذرٍ لا أبَ له معرّفُه 1:

#session("ps -o pid,ppid,user,comm -p 1", output: "  PID  PPID USER COMM
    1     0 root /sbin/launchd")

هذه أوّلُ عمليّةٍ تُطلقها النواةُ بيدها عند الإقلاع، ومنها تنحدر كلُّ عمليّةٍ أخرى. اسمُها على ماك `launchd`، ولها فصلٌ كاملٌ لاحقًا هو «النظام والعمليّات وlaunchd»؛ ويعنينا هنا موقعُها: الجذرُ الذي لا يموت ما دام الجهاز يعمل.

#deep[
  ماذا لو مات الأب قبل ابنه؟ لا يموت الابن معه، بل *يُيَتَّم* فيتبنّاه فورًا صاحبُ المعرّف 1، فترى `PPID` وقد تحوّل إلى 1 أمام عينك. والحالُ المعاكسة *الزومبي*: عمليّةٌ ماتت ولم يقرأ أبوها بعدُ رمزَ خروجها، فيبقى سجلُّها بحال `Z` لا يستهلك معالجًا ولا رامًا، لكنّه يحجز رقمًا في الجدول حتى ينتبه أبوه.
]

#try-it[
  نفّذ `echo $$` لتعرف معرّف صدفتك، ثم `ps -o pid,ppid,comm -p` متبوعًا بذلك الرقم. خذ `PPID` الذي ظهر لك واسأل عنه بالأمر نفسه، وكرّرها مع كلّ `PPID` جديدٍ حتى تبلغ 1. كم قفزةً لزمتك؟ لقد تسلّقتَ للتوّ شجرة نسب جهازك من ورقةٍ إلى جذر.
]

#section[`ps`: لقطةٌ لكلّ ما يجري]

الأداة الأمّ لرؤية العمليّات اسمها `ps` (اختصار Process Status)، وهي *لقطةٌ* لا فيلم: تصوّر حال النظام في لحظةٍ ثم تعيدك إلى المحثّ. ووحدَها بلا خيارات لا تُظهر إلّا عمليّاتِك المرتبطةَ بطرفيّة. وتحمل على ماك ميراثَ عائلتين، فتقبل صيغتين:

```zsh
ps aux      # الصيغة البِرْكليّة: بلا شَرطة
ps -ef      # صيغة POSIX: بشَرطة
```

في الصيغة *البِرْكليّة* (BSD، أصلُ ماك) تلتصق الحروف بلا شَرطة: `a` كلُّ المستخدمين، و`u` عرضٌ غنيٌّ يُظهر المالك واستهلاك الموارد، و`x` حتى ما لا يرتبط بطرفيّة — وهي أغلبُ خدمات النظام. وفي *المعياريّة* (POSIX): `-e` كلُّ العمليّات، و`-f` عرضٌ كامل يُظهر `PPID`. الأولى أشهرُ على ماك، والثانية أضمنُ في سكربتٍ ينتقل بين الأنظمة. ولا تخلط بينهما: فالشَّرطةُ في `ps -aux` تجعل `u` تعني «مستخدمًا بعينه»، فيظنّ `ps` أنّك تسأل عن مستخدمٍ اسمه `x` ويشكو أنّه لا يعرفه.

#subsection[قراءة الأعمدة]

أعمدةُ `ps aux` هي لغةُ هذا الفصل كلِّه:

#table(
  columns: (auto, 1fr),
  [العمود], [ما يعنيه],
  [`USER`], [المستخدم المالك؛ بهويّته تعمل وبصلاحيّاته تُقيَّد.],
  [`PID`],  [معرّفها الفريد.],
  [`%CPU`], [نصيبها من المعالج، وهو *متوسّطٌ* لا لحظةٌ راهنة.],
  [`%MEM`], [نسبة ما تشغله من الذاكرة الفعليّة.],
  [`VSZ`],  [ذاكرةٌ افتراضيّةٌ محجوزةٌ لها — رقمٌ ضخمٌ ومضلّل.],
  [`RSS`],  [الذاكرة المقيمة في الرام فعلًا (بالكيلوبايت).],
  [`TT`],   [الطرفية المرتبطة بها، و`??` تعني: لا طرفية لها.],
  [`STAT`], [حالُها الآن (انظر أدناه).],
  [`STARTED`], [ساعةُ ولادتها، أو تاريخُها إن طال عمرُها.],
  [`TIME`], [مجموع ما استهلكته من زمن المعالج منذ ولادتها.],
  [`COMMAND`], [الأمر الذي أطلقها بمعطياته كاملة.],
)

#warn[
  لا تفزع من `VSZ` الضخم: الذاكرة الافتراضيّة عنوانٌ محجوزٌ على الورق لا رامٌ مستهلكة، فقد ترى برنامجًا صغيرًا «يحجز» عشرات الغيغابايت وهو لا يشغل إلّا ميغابايتاتٍ قليلة؛ والعمودُ الصادق هو `RSS`. ومثله `%CPU`: قد يتجاوز مجموعُه المئة على معالجٍ متعدّد النوى، لأنّ لكلّ نواةٍ مئةً كاملة.
]

#subsection[عمود `STAT`: ما الذي تفعله الآن؟]

حرفٌ واحدٌ يلخّص حال العملية، وقد يتبعه حرفٌ أو أكثر يزيده بيانًا:

#table(
  columns: (auto, 1fr),
  [الحرف], [الحال],
  [`R`], [جاهزةٌ للعمل أو تعمل الآن على المعالج.],
  [`S`], [نائمةٌ نومًا خفيفًا تنتظر شيئًا (أقلّ من عشرين ثانية).],
  [`I`], [خاملة: نائمةٌ منذ أكثر من عشرين ثانية.],
  [`T`], [موقوفةٌ مجمّدةٌ بإشارة: لا تعمل ولم تمت.],
  [`U`], [في انتظارٍ لا يُقطع، غالبًا على قرصٍ بطيء.],
  [`Z`], [ميّتةٌ لم يُرفع سجلُّها بعد — «زومبي».],
)

أمّا اللواحق فأشهرها `+` أي أنّها في مقدّمة الطرفية، و`s` قائدةُ جلسة، و`N` مخفوضةُ الأولويّة، و`<` مرفوعتُها. فحالُ `S+` تعني «نائمةٌ في المقدّمة».

#subsection[`-o`: اصنع جدولك بنفسك]

نادرًا ما تريد الأعمدة كلَّها، والخيار `-o` يجعلك تختار ما تعرض وترتيبَه:

```zsh
ps -o pid,ppid,user,%cpu,stat,comm -p 4711
```

ويرتّب `-r` تنازليًّا حسب المعالج، و`-m` حسب الذاكرة. وانتبه للفرق بين `comm` و`command`: الأولى مسارُ الملفّ التنفيذيّ وحدَه (`/bin/sleep`)، والثانية سطرُ الأمر بمعطياته (`/bin/sleep 300`) — فرقٌ حاسمٌ حين تميّز عمليّتين من البرنامج نفسه. والاسمُ المجرّد كلمتُه `ucomm`.

#distro[
  على لِينُكس يقرأ `ps` بياناتِه من نظام ملفّاتٍ وهميٍّ اسمه `/proc`، فيه مجلّدٌ لكلّ عمليّةٍ تقرأ منه كملفٍّ عاديّ (مثل `cat /proc/1/status`). ولا نظير له على ماك: النواةُ هنا تُسأل عبر واجهاتٍ برمجيّةٍ خاصّة، فكلُّ وصفةٍ تعتمد `/proc` لن تعمل عندك.
]

#try-it[
  نفّذ `ps aux | wc -l` لتعرف كم عمليّةً تعمل في جهازك الآن دون أن تشعر — الرقم سيفاجئك. ثم نفّذ `ps -eo pid,%cpu,%mem,comm -r | head -8` وتأمّل الثمانية الأوائل: أتعرفهم كلَّهم؟ اختر أغربَ اسمٍ فيهم واسأل عنه جهازَك بـ`whatis` أو `man`، كما تعلّمتَ في فصل «أن تساعد نفسك».
]

#section[الصيد بالاسم: `pgrep` و`pkill` و`killall`]

تمريرُ `ps aux` إلى `grep` حيلةٌ معيبة: تصطاد سطرَ `grep` نفسه، وتعطيك نصًّا تنقّب فيه عن الرقم بعينك. والأنظفُ أداتان: `pgrep` يبحث فيعطيك المعرّفات، و`pkill` يبحث فيرسل الإشارة رأسًا.

```zsh
pgrep zsh          # معرّفات كلّ عمليّةٍ في اسمها zsh
pgrep -l zsh       # المعرّف والاسم معًا
pgrep -x Finder    # مطابقةٌ تامّةٌ للاسم لا جزئيّة
pgrep -n zsh       # أحدثُ المطابِقات ولادةً وحدَها
pgrep -o zsh       # وأقدمُها ولادةً
pgrep -u ghazi     # ما يملكه مستخدمٌ بعينه
pgrep -P 4711      # أبناء العملية 4711 المباشرون
```

وافتراضًا يطابق `pgrep` *اسم البرنامج* وحده، ويكفيه أن يجد نصَّك جزءًا منه. فإن أردتَ البحث في سطر الأمر كاملًا بمعطياته فأضِف `-f`. و`pkill` توأمُه في الخيارات، لكنّه يرسل بدل أن يعرض:

```zsh
pgrep -f "sleep 500"   # ابحث في سطر الأمر كلِّه لا في الاسم وحده
pkill -x sleep         # أنهِ ما طابق الاسمَ تمامًا
pkill -HUP -x nginx    # وأرسل HUP لا TERM
```

#warn[
  ما تكتبه لـ`pgrep` ليس نصًّا حرفيًّا بل *تعبيرٌ نمطيّ* موسّع (وله فصل «التعابير النمطية» لاحقًا)، فالنقطة فيه تعني «أيّ حرف» لا النقطة نفسها. ومع `-f` يصير سلاحًا ذا حدّين: لو كتبتَ `pkill -f 77` أصبتَ كلَّ عمليّةٍ يظهر فيها العدد 77 في أيّ موضعٍ من سطرها، ولو كان جزءًا من مسارٍ عارض. والقاعدة الذهبيّة: جرّب `pgrep` أوّلًا بالمعطيات نفسها، فإن رضيتَ بالصيد فبدّل الاسمَ إلى `pkill`.
]

#subsection[`killall`: الإنهاء بالاسم دفعةً واحدة]

حين يفتح تطبيقٌ عدّةَ عمليّاتٍ بالاسم نفسه، يصير الصيدُ بالرقم مملًّا. و`killall` يرسل الإشارة إلى *كلّ* عمليّةٍ تحمل الاسم الذي تعطيه؛ جرّبه على هدفٍ من صنعك بعد `sleep 500 &` ثلاث مرّات:

```zsh
killall sleep        # TERM إلى كلّ ما اسمه كذلك
killall -9 sleep     # وقاصمةً عند الضرورة القصوى
```

والاسمُ عنده حسّاسٌ لحالة الأحرف ويجب أن يطابق تمامًا — لا جزءًا منه كما في `pgrep` — فإن أخطأتَ في حرفٍ قال لك ذلك صراحةً:

#session("killall SLEEP", output: "No matching processes belonging to you
were found")

#danger[
  `killall` واسعُ الأثر: كلمةٌ واحدةٌ تُنهي عائلةً كاملةً من العمليّات. لا تكتبه إلّا وقد تحقّقتَ من الاسم بـ`pgrep -x` قبله، ولا تسبقه بـ`sudo` وأنت تجرّب فتبلغ به عمليّاتِ النظام لا عمليّاتك. واحذر مكيدةً تاريخيّة: على أنظمة يونِكس العتيقة من طراز System V كان `killall` بلا معطًى يُنهي *كلَّ* عمليّات النظام لإطفائه؛ فلا تجرّبه على نظامٍ غريبٍ ظنًّا أنّه كعادته على ماك.
]

#section[`top`: النبض حيًّا]

عيبُ `ps` أنّه صورةٌ ساكنة. أمّا حين تريد أن *تشاهد* النبض وهو ينبض — أيُّ عمليّةٍ تلتهم المعالج الآن؟ ولماذا اشتغلت المراوح فجأة؟ — فأداتُك `top`: شاشةٌ تتجدّد وحدها كلّ ثانية.

```zsh
top -o cpu      # مرتّبةً حسب المعالج تنازليًّا
top -o mem      # مرتّبةً حسب الذاكرة
```

ويعلو جدولَ العمليّات ملخّصٌ للنظام كلِّه:

#session("top -o cpu", output: "Processes: 730 total, 3 running, 727 sleeping
Load Avg: 2.09, 2.08, 2.04
CPU usage: 11.34% user, 9.66% sys, 78.98% idle
PhysMem: 16G used (3155M wired), 121M unused")

سطرُ `Load Avg` هو *معدّل الحِمل*: متوسّط عدد العمليّات المنتظرة دورَها على المعالج في دقيقةٍ، ثم خمسٍ، ثم خمس عشرة؛ اقرأه منسوبًا إلى عدد النوى عندك. وسطرُ `CPU usage` يفصل نصيب برامجك (`user`) عن نصيب النواة (`sys`) عن الفراغ (`idle`).

وأنت داخل `top` لستَ متفرّجًا؛ فهو يقبل أوامرَ بحرفٍ واحد: `o` ثم مفتاح الترتيب (`cpu` أو `mem`) و#kbd("Enter")، و`s` لمدّة التحديث، و`S` لإرسال إشارةٍ إلى معرّفٍ تحدّده، و#kbd("q") للخروج.

#tip[
  أردتَ لقطةً واحدةً من `top` تضعها في ملفٍّ أو تمرّرها إلى أمرٍ آخر؟ عليك بوضع التسجيل: `top -l 1 -n 10 -o cpu` يطبع عيّنةً واحدةً بأعلى عشر عمليّاتٍ ثم يعيدك إلى المحثّ. هذه صيغةُ السكربتات؛ والشاشةُ الحيّة للعين وحدها.
]

#subsection[`htop`: الحقيقةُ نفسها بوجهٍ أرحم]

`top` من صنع Apple، مقتضبةٌ سريعة. وثمّة بديلٌ مجتمعيٌّ أوسعُ راحةً اسمه `htop`: ألوان، وتمريرٌ بالأسهم، واختيارٌ بالنقر، وأشرطةٌ لكلّ نواة. لا يأتي مع ماك، بل تجلبه بمدير الحزم Homebrew الذي يشغل الفصل التالي:

```zsh
brew install htop
htop -t             # اعرضها شجرةَ نسبٍ لا قائمةً مسطّحة
```

وأجملُ ما فيه هنا الخيار `-t`: يعرض العمليّات شجرةً متداخلةً ترى فيها بعينك مَن أنجب مَن. وداخله تفرز بـ#kbd("F6")، وتُنهي عمليّةً مختارةً بـ#kbd("F9")، وتخرج بـ#kbd("F10"). ولا تعوّد نفسك `sudo` لأداةِ عرض: `htop` بلا صلاحيّاتٍ يريك عمليّاتِك كاملةً.

#distro[
  على لِينُكس تجد `htop` في مستودعات كلّ توزيعة، ومعه `pstree` ترسم شجرة العمليّات بخطوطٍ في الطرفية. ولا `pstree` على ماك افتراضًا، وأقربُ ما يعوّضها `htop -t`.
]

#try-it[
  شغّل `top -o cpu`، وافتح متصفّحًا أو حرّك نافذةً ثقيلةً وراقب مَن يقفز إلى القمّة. ثم — وأنت داخله — اضغط `o` واكتب `mem` واضغط #kbd("Enter")، ولاحظ كيف انقلب الترتيبُ كلُّه: أكبرُ آكلي الذاكرة غالبًا ليسوا أكبرَ آكلي المعالج. اخرج بـ#kbd("q").
]

#section[الإشارات: كيف تخاطب عمليّةً حيّة]

لا تُنهي عمليّةً في يونِكس بيدك، ولا تدخل عليها ذاكرتَها. أنت تُرسل إليها *إشارة*: رسالةً قصيرةً موحّدةً تحملها النواةُ نيابةً عنك.

#define("الإشارة (Signal)", [
  إخطارٌ رقميٌّ صغيرٌ ترسله النواةُ إلى عمليّةٍ لتقاطع سيرَها بطلب: أن تنتهي، أو تتجمّد، أو تعيد قراءة إعداداتها. لكلّ إشارةٍ رقمٌ واسمٌ رمزيّ. وأكثرُ الإشارات يستطيع البرنامجُ أن *يلتقطها* فيتصرّف بها كما يشاء — إلّا اثنتين لا تُلتقطان أبدًا.
])

تسرد قائمتها كلَّها بـ`kill -l`، والترتيبُ فيها هو الترقيم: الأولى رقمها 1 وما بعدها على التوالي. وأهمُّها في العمل اليوميّ ستٌّ:

#table(
  columns: (auto, auto, 1fr),
  [الاسم], [الرقم], [معناها],
  [`HUP`],  [1],  [«أُغلِقت السمّاعة»، وصارت عرفًا تعني: أعِد قراءة إعداداتك.],
  [`INT`],  [2],  [مقاطعةٌ من لوحة المفاتيح — وهي ما يرسله #kbd("Ctrl") + #kbd("C").],
  [`KILL`], [9],  [إنهاءٌ فوريٌّ لا يُلتقط ولا يُردّ.],
  [`TERM`], [15], [طلبُ إنهاءٍ مهذّب، وهو الافتراض.],
  [`STOP`], [17], [جمّد العملية فورًا — لا يُلتقط أيضًا.],
  [`CONT`], [19], [أكمِل بعد التجميد.],
)

#subsection[`TERM` تطلب، و`KILL` تبطش]

الأمر الذي يرسل الإشارات اسمه — على غرابته — `kill`، وهو افتراضًا يرسل `TERM` لا `KILL`. والفرق بينهما في الأدب لا في الشدّة وحدها: `TERM` طَرْقٌ على الباب يقول «أنهِ عملك واخرج»، فتلتقطه العمليةُ فتحفظ ملفّاتِها وتغلق اتّصالاتِها ثم تخرج بكرامة. أمّا `KILL` فلا يصل إليها أصلًا؛ النواةُ تنزع الحياة منها في مكانها، فلا تحفظ ولا تنظّف ولا تودّع.

ولنرَ الفرق بأعيننا. اكتب هذا *السكربت* — أي ملفًّا نصّيًّا فيه أوامرُ تُنفَّذ بالترتيب — في `worker.sh`، واجعله تنفيذيًّا بـ`chmod +x worker.sh` كما تعلّمتَ في فصل الصلاحيات:

```zsh
#!/bin/zsh
# يلتقط TERM فيحفظ عمله قبل أن يخرج
trap 'echo saved >> /tmp/work.log; exit 0' TERM
while true; do sleep 1; done
```

السطر `trap` يقول: «إن جاءتك `TERM` فنفّذ هذا قبل أن تخرج» (وله شرحٌ أوفى في فصل «أساسيات كتابة السكربتات»). شغّله بـ`./worker.sh &`، ثم أرسل إليه الطلبَ المهذّب بـ`kill %1`، واقرأ سجلّه:

#session("cat /tmp/work.log", output: "saved")

التقط السكربتُ الإشارةَ فحفظ ثم خرج. الآن احذف السجلّ وأعِد التجربة، لكن أنهِه بالقاصمة `kill -9 %1`:

#session("cat /tmp/work.log", output: "cat: /tmp/work.log: No such file or
directory")

لا سطرَ محفوظًا، ولا ملفَّ أصلًا: لم يُمهَل لحظةً واحدةً ليكتب. هذا هو الفرق بين أن *تطلب* وأن *تبطش*.

#warn[
  `kill -9` ملاذٌ أخير لا خيارٌ أوّل: جرّب `kill` المجرّدة وامنح العملية ثانيتين، فأغلبُ ما يبدو «معلّقًا» ينتهي بأدبٍ لو صبرتَ عليه. ولا تجعل `-9` عادةً في سكربتاتك: البرنامج الذي يُقتَل قسرًا قد يترك ملفّاتٍ نصفَ مكتوبة، أو أقفالًا لم تُرفَع، أو قاعدةَ بياناتٍ تطلب إصلاحًا عند التشغيل التالي. الأدبُ مع العمليّات حمايةٌ لبياناتك أنت.
]

#subsection[التجميد والإحياء: `STOP` و`CONT`]

ليست كلُّ الإشارات قتلًا. `STOP` تجمّد العملية في مكانها: تبقى في الذاكرة بكلّ حالها ولا تأخذ من المعالج شيئًا. و`CONT` تُعيدها من حيث توقّفت كأنّ شيئًا لم يكن. وعمود `STAT` يشهد بالتبدّل: كانت العملية 4711 نائمةً (`S`)، فانظر إليها الآن:

#session("kill -STOP 4711; ps -o stat= -p 4711", output: "T")

#session("kill -CONT 4711; ps -o stat= -p 4711", output: "S")

الحرف `T` هو التجميد، وهو مفيدٌ عمليًّا: لو رأيتَ عمليّةً تلتهم المعالج ولم تحسم أمرَها، جمّدها بـ`STOP` لتهدأ الحرارةُ وتفكّر على مهل، ثم أطلقها بـ`CONT` أو أنهِها بـ`TERM`. (والعلامة `=` بعد اسم العمود تعني: اطبع القيمة بلا عنوانٍ فوقها.)

و`KILL` و`STOP` وحدَهما لا يستطيع برنامجٌ التقاطَهما ولا تجاهلَهما؛ أمّا ما عداهما — حتى `TERM` و`INT` — فيعترضه البرنامج ويتصرّف به كما يشاء، وهو ما فعله سكربتُك قبل قليل.

#distro[
  أرقام الإشارات ليست واحدةً في كلّ الأنظمة، والأسماءُ هي الآمنة: `STOP` هي 17 على ماك وBSD و19 على لِينُكس، و`CONT` هي 19 هنا و18 هناك. فاكتبها بالاسم لا بالرقم، يعمل أمرُك أينما ذهبت.
]

#try-it[
  أطلق هدفًا آمنًا: `sleep 500 &`، ثم خذ معرّفه بـ`pgrep -n -x sleep`. اقرأ حاله بـ`ps -o stat= -p` متبوعًا بالمعرّف (سيكون `S`)، ثم جمّده بـ`kill -STOP` واقرأ حاله ثانيةً (`T`)، ثم أحيِه بـ`kill -CONT` واقرأه ثالثةً فيعود `S`. أخيرًا أنهِه بـ`kill` المجرّدة، وتأكّد أنّه ذهب فلم يعد `ps` يجد له أثرًا. ثلاث إشاراتٍ في دقيقة، ورأيتَ أثر كلٍّ منها بحرفٍ واحد.
]

#section[التحكّم بالمهامّ: في يديك أو خلف ظهرك]

حين تنفّذ أمرًا طويلًا تمسك الطرفيةُ عنه حتى ينتهي. لكنّ الصدفة تملك أن تشغّل أكثر من مهمّةٍ معًا: واحدةً في *المقدّمة* تمسك لوحةَ المفاتيح، وسواها في *الخلفيّة* تعمل صامتة.

#define("المهمّة (Job)", [
  عمليّةٌ — أو سلسلةُ عمليّاتٍ في أنبوبٍ واحد — أطلقتها صدفتُك وتتولّى هي إدارتها، فترقّمها ترقيمًا خاصًّا بها يبدأ من 1 وتشير إليه بعلامة النسبة: `%1` و`%2`. ولا تخلط بين رقم المهمّة الذي لا تعرفه إلّا صدفتُك، ومعرّف العملية الذي يعرفه النظام كلُّه.
])

تُلحق الأمرَ بعلامة `&` فيبدأ في الخلفيّة وتعود إليك الطرفيةُ فورًا، وتسرد ما لديك بـ`jobs`:

#session("jobs -l", output: "[1]  - 33984 running    sleep 100
[2]  + 33985 running    sleep 200")

الرقم بين القوسين رقمُ المهمّة، و`+` تشير إلى المهمّة الحاليّة (التي تعنيها `fg` إن لم تسمِّ شيئًا) و`-` إلى التالية لها، و`-l` يضيف معرّف العملية الحقيقيّ. والانتقالُ بين الحالين بأربع أدوات:

#table(
  columns: (auto, 1fr),
  [الأداة], [ما تفعل],
  [`&`], [تُلحق بالأمر فيبدأ في الخلفيّة رأسًا.],
  [#kbd("Ctrl") + #kbd("Z")], [تجمّد مهمّة المقدّمة وتعيدك إلى المحثّ.],
  [`bg %1`], [تُكمل المهمّة المجمّدة، لكن في الخلفيّة.],
  [`fg %1`], [تجلب مهمّةً من الخلفيّة إلى المقدّمة.],
)

فحين تنسى `&` ويشغلك أمرٌ طويل، لا تقتله ولا تنتظر: اضغط #kbd("Ctrl") + #kbd("Z") ليتجمّد (وهي إشارة `TSTP`)، ثم `bg` ليكمل في الخلفيّة، فتسترجع طرفيّتك دون أن تُضيّع دقيقةً من عمله. وتقبل `kill` أرقامَ المهامّ: `kill %2` أوضحُ وأقلُّ خطرًا من تذكّر رقمٍ من خمس خانات.

#subsection[ما يبقى بعد أن تغلق الطرفية]

المهمّة في الخلفيّة ما تزال ابنةَ صدفتك. وحين تغلق نافذةَ الطرفية تُرسَل إشارة `HUP` إلى مهامّها — واسمُها من hang up، «أَغلِق السمّاعة»، من أيّام الطرفيّات المتّصلة بخطّ الهاتف — فتموت أغلبُها. وللنجاة أداتان:

```zsh
nohup ./long-task.sh &   # حصّنه من HUP منذ البداية
disown %1                # أو انزع القائمة من السجلّ
```

والفرق بينهما في التوقيت: `nohup` قرارٌ *مسبقٌ* لحظةَ الإطلاق، يحصّن البرنامج من `HUP` ويحوّل مخرجاتِه إلى ملفّ `nohup.out` إن كانت متّجهةً إلى الشاشة. و`disown` قرارٌ *لاحقٌ* بعد أن يبدأ: يمحو المهمّة من سجلّ الصدفة فلا تعود تُخطِرها عند الخروج. فبعد `disown %1` لا يجدها `jobs`، ويجدها `pgrep` حيّةً تعمل: خرجت من السجلّ لا من الوجود.

#tip[
  الأنظفُ أن تجمع الأمرين وتوجّه المخرجات بنفسك بدل `nohup.out`: `nohup ./task.sh > run.log 2>&1 &` ثم `disown`. وإن أردتَ أن *تعود إلى* مهمّتك لا أن تتركها فحسب، فحاجتُك مضاعِفُ طرفيّاتٍ مثل `tmux`.
]

#try-it[
  نفّذ `sleep 300 &` مرّتين لتصير لك مهمّتان، ثم `jobs -l` لتراهما بمعرّفيهما. اجلب الثانية إلى المقدّمة بـ`fg %2`، ثم جمّدها بـ#kbd("Ctrl") + #kbd("Z") ولاحظ ماذا يطبع لك، ثم أعِدها إلى الخلفيّة بـ`bg %2`. أخيرًا نفّذ `disown %1` ثم `jobs` — أين ذهبت الأولى؟ تأكّد أنّها حيّةٌ بـ`pgrep -f "sleep 300"`، ثم نظّف بـ`pkill -f "sleep 300"`.
]

#section[الأولويّة: مَن يتقدّم في الطابور؟]

النواةُ تقسم المعالج بين العمليّات، ولها في القسمة مقياسٌ اسمه *اللطف*: كلّما كانت العملية «ألطف» تنازلت لغيرها عن دورها أكثر.

#define("قيمة اللطف (nice)", [
  رقمٌ يرافق كلَّ عمليّةٍ يخبر النواةَ بمدى استعجالها، قيمتُه الافتراضيّة 0. فكلّما *ارتفع* الرقم قلّت أولويّةُ العملية (صارت ألطفَ فتنازلت أكثر)، وكلّما انخفض ارتفعت أولويّتُها. ومداه على ماك من `-20` (أشدُّ إلحاحًا) إلى `20` (أكثرُ تنازلًا).
])

تُطلق أمرًا بلطفٍ محدّدٍ بـ`nice`، وتغيّر لطفَ عمليّةٍ قائمةٍ بـ`renice`، وتقرأ النتيجة في عمود `NI`:

```zsh
nice -n 10 ./heavy-task.sh   # أطلقه متنازلًا من أوّل لحظة
renice 15 -p 4711            # واجعل عمليّةً قائمةً ألطف
```

#session("renice 15 -p 4711; ps -o pid,ni,comm -p 4711", output: "  PID NI COMM
 4711 15 /bin/sleep")

وهذا مفيدٌ في عملٍ ثقيلٍ طويل — ضغطِ ملفّاتٍ أو ترجمةِ شفرةٍ أو تحويلِ فيديو — تريده أن يمضي دون أن يُبطئ عليك جهازك: يأخذ المعالجَ حين يفرغ، ويتنحّى حين تحتاجه.

#warn[
  رفعُ الأولويّة ليس كخفضها. المستخدم العاديّ يستطيع أن *يزيد* رقم اللطف متى شاء، لكنّه *لا يستطيع* أن ينقصه أبدًا: لا ليعيده إلى ما كان، ولا ليهبط به تحت الصفر. وهذا حاجزٌ متعمّد: لولاه لأمكن أيَّ برنامجٍ أن يتقدّم على الجميع فيشلّ الجهاز. والقاعدة: التنازل مباحٌ لك ولا رجعة فيه، والتقدّم يحتاج إذن المدير.
]

#distro[
  فرقان يوقعان المنتقلَ بين النظامين: أقصى لطفٍ على ماك (وBSD) هو `20` وعلى لِينُكس `19`؛ و`-n` في `renice` تعني على ماك *زيادةً* تُضاف إلى القيمة الحاليّة — والقيمةُ المطلقة تُكتب بلا خيارٍ (`renice 15 -p 4711`) — بينما هي على لِينُكس القيمةُ المطلقة نفسها.
]

#section[`lsof`: مَن يمسك هذا الملفّ؟]

في يونِكس «كلُّ شيءٍ ملفّ»: المجلّداتُ ملفّات، وحتى اتّصالُ الشبكة ملفٌّ مفتوح. ومن هنا نبعت `lsof` — أي list open files — تجيبك عن سؤالين يتكرّران: مَن يمسك هذا الملفّ فلا يدعني أحذفه؟ ومَن يجلس على هذا المنفذ فلا يدع خادمي يبدأ؟

#define("المنفذ (Port)", [
  رقمٌ بين 1 و65535 يميّز بابًا من أبواب الشبكة في جهازك. فالعنوان يقول «أيّ جهاز»، والمنفذ يقول «أيّ برنامجٍ فيه». ولا يجلس على المنفذ الواحد — في العادة — إلّا برنامجٌ واحد، ولذلك تشكو الخوادمُ من «المنفذ مشغول». وله تفصيله في فصل «الشبكات على ماك».
])

```zsh
lsof -p 4711            # كلّ ما تفتحه العملية 4711
lsof ~/notes.txt        # مَن يمسك هذا الملفّ؟
lsof -u ghazi           # كلّ ما يفتحه مستخدمٌ بعينه
lsof -nP -i :8080       # مَن يجلس على المنفذ 8080؟
```

ويمنع `-n` و`-P` ترجمةَ العناوين إلى أسماء نطاقاتٍ وأرقامِ المنافذ إلى أسماء خدمات، فيصير الخرجُ أسرعَ وأوضح؛ فبغيرهما قد يطبع `http-alt` بدل `8080` فتحار. وأعمدةُ الخرج تُقرأ هكذا:

#table(
  columns: (auto, 1fr),
  [العمود], [ما يعنيه],
  [`COMMAND`], [اسم البرنامج المالك.],
  [`PID`],  [معرّف العملية — وهو ما تريده غالبًا.],
  [`FD`],   [رقم *واصف الملفّ*: الرقم الذي تعرف به العمليةُ ملفًّا فتحته. وقد يحلّ محلَّه `cwd` لمجلّدها الحاليّ أو `txt` لبرنامجها نفسه.],
  [`TYPE`], [نوعه: `REG` ملفٌّ عاديّ، `DIR` مجلّد، `IPv4` اتّصال.],
  [`NAME`], [المسار، أو العنوان والمنفذ وحالُ الاتّصال.],
)

وتذكّر أنّك ترى بقدر ما تملك: `lsof` بلا صلاحيّة المدير لا يكشف لك إلّا ملفّاتِ عمليّاتك أنت، وهذا حجبٌ مقصودٌ لا عطل. وحين لا تريد إلّا المعرّف لتمرّره إلى أمرٍ آخر، فالخيار `-t` يعطيك الأرقام مجرّدةً:

#session("lsof -t -i :8080", output: "34899")

#tip[
  هذه الوصفة تحلّ أشهرَ إزعاجٍ يلقاه من يشتغل بالخوادم — رسالةَ «المنفذ مشغول»: `kill $(lsof -t -i :8080)`، فيجلب `lsof` معرّفَ الجالس ويسلّمه إلى `kill`. ولا تكتبها إلّا بعد أن تنظر إلى `lsof -nP -i :8080` وتتأكّد أنّ الجالس خادمُك التجريبيّ لا خدمةٌ من خدمات النظام.
]

#distro[
  `lsof` نفسُها متاحةٌ على لِينُكس وBSD بالصياغة ذاتها. أمّا التتبّع العميق فيختلف: تراقب نداءاتِ برنامجٍ للنظام بـ`strace` على لِينُكس وبـ`dtruss` على ماك، وهذه تحتاج `sudo` وتمنعها حمايةُ SIP من أغلب برامج Apple.
]

#section[`ulimit`: سقفُ ما تستطيعه العملية]

للعملية حدودٌ لا تتعدّاها: كم ملفًّا تفتح معًا، وكم تكبر ذاكرتُها، وكم يطول زمنُها على المعالج. تضبطها الصدفةُ فترثها كلُّ عمليّةٍ تولد منها، وأداتُها `ulimit` (وهي مبنيّةٌ في الصدفة لا برنامجًا مستقلًّا):

#session("ulimit -a", output: "-t: cpu time (seconds)              unlimited
-f: file size (blocks)              unlimited
-s: stack size (kbytes)             8192
-c: core file size (blocks)         0
-u: processes                       2784
-n: file descriptors                256")

ولكلّ سقفٍ قيمتان: قيمةٌ *ليّنةٌ* هي المطبّقة الآن وتستطيع أنت رفعها إلى حدّ الصلبة، وقيمةٌ *صلبةٌ* لا يرفعها إلّا المدير؛ تقرؤهما بـ`ulimit -Sn` و`ulimit -Hn`، وتغيّر اللّيّنة بـ`ulimit -Sn` متبوعًا بالقيمة. وأكثرُ السقوف إثارةً للمشاكل `-n`: عددُ الملفّات المفتوحة، فأدواتُ التطوير الحديثة تفتح آلافًا منها، وحين تضيق بها تسقط برسالةٍ محيّرةٍ نصُّها `too many open files`؛ وعلاجُها الأوّل رفعُ السقف اللّيّن:

#session("(ulimit -Sn 4096; ulimit -Sn)", output: "4096")

وانتبه للقوسين: رُفعت القيمة داخل *صدفةٍ فرعيّة*، فلمّا خرجنا منها عادت الأصليّة. وهذه طبيعةُ `ulimit`: يؤثّر في الصدفة الحاليّة وفيما تلده بعده لا فيما وُلد قبله، ولا يبقى أثرُه بعد إغلاق النافذة؛ ولذلك يوضع في ملفّ إعداد الصدفة إن أُريد له الدوام، كما يأتي في فصل «البيئة وتخصيص zsh».

#warn[
  رفعُ السقوف ليس علاجًا لكلّ داء. البرنامج الذي يستنفد آلافَ الملفّات المفتوحة غالبًا لا يغلق ما يفتح، وهذا خللٌ فيه لا ضيقٌ في نظامك؛ ورفعُ السقف يؤجّل السقوطَ ولا يمنعه. ارفعه حين تكون الحاجة مشروعةً — كخادمٍ يخدم آلافَ الاتّصالات — وابحث عن السبب حين تكون مريبة.
]

#try-it[
  افتح ملفًّا نصّيًّا طويلًا بـ`less /etc/services` في نافذةِ طرفيّة، ثم اسأل عنه من نافذةٍ أخرى: `lsof /etc/services` — سترى `less` ممسكًا به، وعمود `FD` يخبرك برقم واصفه. ثم اسأل `lsof -p` عن معرّف `less` نفسه لترى كم ملفًّا يفتح برنامجٌ «بسيط» في الحقيقة. وأخيرًا نفّذ `ulimit -Sn` ثم `ulimit -Hn` وقارن سقفك اللّيّن بالصلب: كم يتّسع لك أن ترفع الأوّل قبل أن تبلغ الثاني؟
]

#section[خلاصة الفصل]

رأيتَ أنّ البرنامج على القرص نوتةٌ صامتة، وأنّ *العملية* هي العزفُ نفسه: ذاكرةٌ وهويّةٌ ونصيبٌ من المعالج. وتسلّقتَ شجرة النسب حتى الجذر رقم 1، والتقطتَ اللقطة بـ`ps` بصيغتيه وقرأتَ أعمدتها وصنعتَ جدولك بـ`-o`، وصدتَ بالاسم بـ`pgrep` و`pkill` و`killall`، وشاهدتَ النبض حيًّا في `top` وشجرتَه في `htop -t`. وتعلّمتَ أنّ مخاطبة العمليّات *إشارة*: `TERM` تطرق الباب و`KILL` تخلعه، و`STOP` تجمّد و`CONT` تُحيي — ورأيتَ الفرق بعينك في سجلّ سكربتٍ حَفِظ مرّةً ولم يُمهَل مرّة. ونقلتَ مهامّك بين المقدّمة والخلفيّة، وحصّنتَ ما يجب أن يبقى بـ`nohup` و`disown`، وضبطتَ الأولويّة بـ`nice`، وكشفتَ بـ`lsof` مَن يمسك ملفًّا أو منفذًا، وقِستَ سقوفَك بـ`ulimit`. ولكلّ هذا وجهٌ رسوميٌّ في «مراقب النشاط» (`open -a "Activity Monitor"`)، لكنّ النافذة لا تُفتح على خادمٍ بعيدٍ تصله بـ`ssh` — وهناك لا يبقى معك إلّا ما في هذا الفصل. وفي الفصل التالي ننتقل من مراقبة ما يعمل إلى جلب ما لا تملكه بعد: Homebrew، أمينُ المستودع الذي يجلب لك أدوات العالم بأمرٍ واحد — ومنها `htop` التي جرّبتَها للتوّ.

#challenge[
  (1) *الطبيب الشرعيّ:* أجلِس على المنفذ 8080 برنامجًا مرفقًا مع ماك بـ`nc -l 8080 &` (و`nc` أداةُ شبكةٍ بسيطةٌ تنتظر اتّصالًا لا أكثر)، ثم — دون أن تنظر إلى ما طبعته الصدفة — اكتشف معرّفَه بطريقتين: مرّةً بـ`lsof` من رقم المنفذ، ومرّةً بـ`pgrep -f`. تأكّد أنّ الرقمين واحد، ثم أنهِ الجالسَ بأدبٍ بـ`kill` وتحقّق أنّ المنفذ صار حرًّا. (2) *الفرق بأصابعك:* أعِد بناء سكربت `worker.sh` من الفصل وشغّله مرّتين: أنهِ الأولى بـ`kill` والثانية بـ`kill -9`، وقارن `/tmp/work.log` في الحالين. ثم غيّر سطر `trap` ليلتقط `INT` بدل `TERM`، وشغّل السكربت في المقدّمة، وأنهِه بـ#kbd("Ctrl") + #kbd("C") — هل حفظ؟ ولماذا؟ (3) *المتنازل:* أطلق عملًا ثقيلًا في الخلفيّة (مثل `find /usr /System/Library -type f > /tmp/out.txt 2>/dev/null &`)، واقرأ لطفَه في عمود `NI`، ثم اجعله ألطفَ بـ`renice`، ثم حاول أن تعيده إلى `0` — ماذا قال لك النظام، ولماذا هذا المنعُ في مصلحتك؟
]
