#objectives((
  [تفرّق بين البرنامج الساكن على القرص والعملية الحيّة، وتتسلّق شجرة النسب بـ`PID` و`PPID` حتى جذرها رقم 1.],
  [تستخرج ما تريد من `ps` بصيغتيه، وتصطاد بالاسم بـ`pgrep`، وتراقب النبض حيًّا بـ`top` و`htop`.],
  [تخاطب العمليّات بالإشارات: `TERM` تطلب، و`KILL` تبطش، و`STOP` و`CONT` تجمّد وتُحيي.],
  [تنقل مهامّك بين المقدّمة والخلفيّة، وتعرف ما يبقى حيًّا بعد إغلاق الطرفية وما يموت معها.],
  [تكشف بـ`lsof` مَن يمسك ملفًّا أو يجلس على منفذ، وتضبط الأولويّة بـ`nice` وسقوفَ الموارد بـ`ulimit`.],
))

تخيّل نوتةً موسيقيّةً منسيّةً على رفّ: أوراقٌ فيها نقاطٌ وخطوطٌ مرتّبة، كاملةٌ ودقيقة، لكنّها صامتةٌ لا صوت فيها ولا حركة. ثم يرفعها عازفٌ ويبدأ، فيولد شيءٌ آخر تمامًا: صوتٌ يملأ القاعة، له بدايةٌ ونهاية، وسرعةٌ ونبرة، ويشغل من الزمن قدرًا ومن انتباه الناس قدرًا. النوتةُ على الرفّ هي البرنامج على قرصك؛ والعزفُ هو *العملية*. وفي جهازك الآن ليس عازفٌ واحدٌ بل مئات، كلٌّ منهم يعزف لحنه في اللحظة نفسها، ونواةُ النظام قائدُ أوركسترا لا تراه يوزّع عليهم الوقت جزءًا من الثانية تلو الآخر، فيخرج من هذا الازدحام كلِّه انسجامٌ واحدٌ تسمّيه «جهازي يعمل». هذا الفصل يعلّمك أن ترى العازفين، وتعرف مَن يعلو صوتُه على غيره، وتخاطبه، وتُسكته إن لزم — أي أن تجلس أنت مكان القائد.

#section[العملية: البرنامج وقد دبّت فيه الحياة]

الملفُّ التنفيذيّ على قرصك جمادٌ محض: بضعةُ آلافٍ من البايتات تنتظر. وما إن تشغّله حتى تحجز له النواةُ ذاكرةً خاصّةً به وحدَه، وتمنحه هويّةً هي هويّةُ المستخدم الذي أطلقه، وتفتح له ملفّاتٍ يقرأ منها ويكتب فيها، وتبدأ تقسم له نصيبًا من المعالج. هذه النسخةُ الحيّةُ العاملة هي العملية.

#define("العملية (Process)", [
  برنامجٌ قيدَ التنفيذ في هذه اللحظة، بذاكرته الخاصّة التي لا يشاركه فيها أحد، وهويّته (مالكه)، ومجلّده الحاليّ، وملفّاته المفتوحة، وبيئته. والبرنامج الواحد قد يعمل في عدّة عمليّاتٍ معًا — كنسخةٍ لكلّ تبويبةٍ في المتصفّح — ولكلٍّ منها ذاكرتُها المعزولة عن أختها.
])

ولأنّ العمليّات كثيرةٌ ومتشابهةُ الأسماء، لا يميّزها النظام بالاسم بل برقمٍ فريد.

#define("معرّف العملية (PID)", [
  رقمٌ صحيحٌ فريدٌ تمنحه النواةُ لكلّ عمليّةٍ عند ولادتها، اختصارًا لـ Process IDentifier. به تشير إليها بلا لبسٍ حين تراقبها أو تخاطبها. ولا يُعاد استعمال الرقم إلّا بعد أن تموت صاحبتُه ويدور العدّاد دورةً كاملة.
])

#subsection[شجرة النسب: مَن أنجب مَن؟]

لا تولد عمليّةٌ من عدم. كلُّ عمليّةٍ في يونِكس تُنجبها عمليّةٌ أخرى، فيسجّل النظام لها إلى جانب معرّفها *معرّفَ أبيها* (`PPID`). ومن هنا تنتظم العمليّاتُ كلُّها في شجرةِ نسبٍ واحدة. جرّب أن ترى موضعك من هذه الشجرة؛ فالمتغيّر `$$` يحمل معرّف صدفتك الحاليّة، تقرؤه بـ`echo $$` ثم تسأل عنه:

#session("ps -o pid,ppid,comm -p 33393", output: "  PID  PPID COMM
33393  1214 /bin/zsh")

صدفتُك ابنةُ برنامجٍ آخر — تطبيقِ الطرفية الذي فتحتَه — وذاك ابنُ غيره، وهكذا صعودًا. والصعودُ لا يمتدّ إلى الأبد؛ فالشجرة تنتهي إلى جذرٍ واحدٍ لا أبَ له، معرّفُه 1:

#session("ps -o pid,ppid,user,comm -p 1", output: "  PID  PPID USER COMM
    1     0 root /sbin/launchd")

هذه أوّلُ عمليّةٍ تُطلقها النواةُ بيدها عند الإقلاع، ومنها تنحدر كلُّ عمليّةٍ أخرى في جهازك. اسمُها على ماك `launchd`، وهي التي تشغّل خدمات النظام وتُبقيها حيّة، ولها فصلٌ كاملٌ لاحقًا هو فصل «النظام والعمليّات وlaunchd». ويعنينا منها هنا موقعُها فقط: الجذرُ الذي لا يموت ما دام الجهاز يعمل.

#deep[
  ماذا لو مات الأب قبل ابنه؟ لا يموت الابن معه، بل *يُيَتَّم* فيتبنّاه فورًا صاحبُ المعرّف 1. جرّبها بنفسك: أطلق صدفةً فرعيّةً تشغّل أمرًا طويلًا في الخلفيّة ثم تخرج هي، واقرأ `PPID` الابن قبل موت أبيه وبعده — سيتحوّل من رقم أبيه إلى 1 أمام عينك. والحالُ المعاكسة تُسمّى *الزومبي*: عمليّةٌ ماتت فعلًا لكنّ أباها لم يقرأ بعدُ رمزَ خروجها، فيبقى سجلُّها في جدول العمليّات بحال `Z` بلا ذاكرةٍ ولا عمل. الزومبي لا يستهلك معالجًا ولا رامًا، لكنّه يحجز رقمًا في الجدول؛ ويُرفَع سجلُّه حالما ينتبه أبوه، فإن مات الأب قبل أن ينتبه انتقل الزومبي إلى كفالة المعرّف 1 فدفنه عنه.
]

#try-it[
  نفّذ `echo $$` لتعرف معرّف صدفتك، ثم `ps -o pid,ppid,comm -p` متبوعًا بذلك الرقم. خذ `PPID` الذي ظهر لك واسأل عنه بالأمر نفسه، وكرّرها مع كلّ `PPID` جديدٍ حتى تبلغ 1. كم قفزةً لزمتك؟ لقد تسلّقتَ للتوّ شجرة نسب جهازك من ورقةٍ إلى جذر.
]

#section[`ps`: لقطةٌ لكلّ ما يجري]

الأداة الأمّ لرؤية العمليّات اسمها `ps` (اختصار Process Status). وهي *لقطةٌ* لا فيلم: تصوّر حال النظام في لحظةٍ واحدةٍ ثم تعيدك إلى المحثّ فورًا. ووحدَه بلا خيارات لا يُظهر `ps` إلّا عمليّاتِك أنت التي لها طرفيّةٌ تتحكّم بها، وهي قليلةٌ لا تُشبع الفضول.

ويحمل `ps` على ماك ميراثَ عائلتين، فيقبل صيغتين مختلفتين للخيارات، ومن جهل ذلك حار:

```zsh
ps aux      # الصيغة البِرْكليّة: بلا شَرطة
ps -ef      # صيغة POSIX: بشَرطة
```

الأولى *بِرْكليّة* (BSD) وهي أصلُ ماك: حروفٌ ملتصقةٌ بلا شَرطةٍ سابقة، معناها `a` كلُّ المستخدمين لا أنت وحدك، و`u` عرضٌ غنيٌّ يُظهر المالك واستهلاك الموارد، و`x` حتى ما لا يرتبط بطرفيّة (وهي أغلبُ خدمات النظام). والثانية *معياريّة* (POSIX): `-e` كلُّ العمليّات، و`-f` عرضٌ كامل يُظهر `PPID`. الأولى أشهرُ على ماك، والثانية أضمنُ إن كتبتَ سكربتًا ينتقل بين الأنظمة. ولا تخلط الصيغتين في أمرٍ واحد: فـ`ps -aux` ليست `ps aux`؛ إذ تجعل الشَّرطةُ الحرفَ `u` يعني «مستخدمًا بعينه»، فيظنّ `ps` أنّك تسأل عن مستخدمٍ اسمه `x` ويشكو أنّه لا يعرفه. حرفٌ واحدٌ زائدٌ يقلب معنى الأمر كلَّه.

#subsection[قراءة الأعمدة]

أعمدةُ `ps aux` هي لغةُ هذا الفصل كلِّه، وتعلّمُها مرّةً يكفيك:

#table(
  columns: (auto, 1fr),
  [العمود], [ما يعنيه],
  [`USER`], [المستخدم المالك؛ بهويّته تعمل وبصلاحيّاته تُقيَّد.],
  [`PID`],  [معرّفها الفريد.],
  [`%CPU`], [نصيبها من المعالج، وهو *متوسّطٌ* لا لحظةٌ راهنة.],
  [`%MEM`], [نسبة ما تشغله من الذاكرة الفعليّة.],
  [`VSZ`],  [ذاكرةٌ افتراضيّةٌ محجوزةٌ لها — رقمٌ ضخمٌ ومضلّل.],
  [`RSS`],  [الذاكرة المقيمة في الرام فعلًا (بالكيلوبايت).],
  [`TT`],   [الطرفية المرتبطة بها، و`??` تعني: لا طرفية لها.],
  [`STAT`], [حالُها الآن (انظر أدناه).],
  [`STARTED`], [ساعةُ ولادتها، أو تاريخُها إن طال عمرُها.],
  [`TIME`], [مجموع ما استهلكته من زمن المعالج منذ ولادتها.],
  [`COMMAND`], [الأمر الذي أطلقها بمعطياته كاملة.],
)

#warn[
  لا تفزع من `VSZ` الضخم. الذاكرة الافتراضيّة عنوانٌ محجوزٌ على الورق لا رامٌ مستهلكة، فقد ترى برنامجًا صغيرًا «يحجز» عشرات الغيغابايت وهو لا يشغل منها إلّا ميغابايتاتٍ قليلة. العمودُ الذي يخبرك بالحقيقة هو `RSS`. ومثله `%CPU`: قد يتجاوز مجموعُه المئة على معالجٍ متعدّد النوى، لأنّ لكلّ نواةٍ مئةً كاملة.
]

#subsection[عمود `STAT`: ما الذي تفعله الآن؟]

حرفٌ واحدٌ يلخّص حال العملية، وقد يتبعه حرفٌ أو أكثر يزيده بيانًا:

#table(
  columns: (auto, 1fr),
  [الحرف], [الحال],
  [`R`], [جاهزةٌ للعمل أو تعمل الآن على المعالج.],
  [`S`], [نائمةٌ نومًا خفيفًا تنتظر شيئًا (أقلّ من عشرين ثانية).],
  [`I`], [خاملة: نائمةٌ منذ أكثر من عشرين ثانية.],
  [`T`], [موقوفةٌ مجمّدةٌ بإشارة: لا تعمل ولم تمت.],
  [`U`], [في انتظارٍ لا يُقطع، غالبًا على قرصٍ بطيء.],
  [`Z`], [ميّتةٌ لم يُرفع سجلُّها بعد — «زومبي».],
)

أمّا اللواحق فأشهرها `+` أي أنّها في مقدّمة الطرفية (تمسك لوحة المفاتيح الآن)، و`s` أي أنّها قائدةُ جلسة، و`N` أي أنّ أولويّتها مخفوضة، و`<` أي أنّها مرفوعة الأولويّة. فحالُ `Ss` تعني «نائمةٌ قائدةُ جلسة»، و`S+` تعني «نائمةٌ في المقدّمة».

#subsection[`-o`: اصنع جدولك بنفسك]

نادرًا ما تريد الأعمدة كلَّها. الخيار `-o` يجعلك تختار ما تعرض وترتيبَه، فتخرج بجدولٍ نظيفٍ يسهل على العين وعلى الأدوات:

```zsh
ps -o pid,ppid,user,%cpu,stat,comm -p 4711
ps -eo pid,%cpu,comm -r | head -5   # أشرهُ العمليّات
```

الخيار `-r` يرتّب تنازليًّا حسب استهلاك المعالج، و`-m` حسب الذاكرة. وانتبه للفرق بين `comm` و`command`: الأولى تعطيك مسار الملفّ التنفيذيّ وحدَه بلا معطيات (`/bin/sleep`)، والثانية سطرَ الأمر بمعطياته كلِّها (`sleep 300`) — وهو فرقٌ حاسمٌ حين تريد تمييز عمليّتين من البرنامج نفسه بمعطياتٍ مختلفة. وإن أردتَ الاسم المجرّد بلا مسارٍ ولا معطياتٍ فالكلمة `ucomm`.

#distro[
  على لِينُكس يقرأ `ps` بياناتِه من نظام ملفّاتٍ وهميٍّ اسمه `/proc`، فيه مجلّدٌ باسم كلّ عمليّةٍ تفتحه وتقرأ منه كملفٍّ عاديّ (مثل `cat /proc/1/status`). ولا نظير له على ماك: النواةُ هنا لا تعرض عمليّاتِها في نظام ملفّات، بل تُسأل عبر واجهاتٍ برمجيّةٍ خاصّة، وعليها تُبنى أدواتُ ماك. فإن قرأتَ وصفةً تعتمد `/proc` فاعلم أنّها لِينُكسيّةٌ محضةٌ لن تعمل عندك.
]

#try-it[
  نفّذ `ps aux | wc -l` لتعرف كم عمليّةً تعمل في جهازك الآن دون أن تشعر — الرقم سيفاجئك. ثم نفّذ `ps -eo pid,%cpu,%mem,comm -r | head -8` وتأمّل الثمانية الأوائل: أتعرفهم كلَّهم؟ اختر أغربَ اسمٍ فيهم واسأل عنه جهازَك بـ`whatis` أو `man`، كما تعلّمتَ في فصل «أن تساعد نفسك».
]

#section[الصيد بالاسم: `pgrep` و`pkill`]

تمريرُ `ps aux` إلى `grep` حيلةٌ قديمةٌ معيبة: تصطاد سطرَ `grep` نفسه، وتعطيك نصًّا عليك أن تنقّب فيه عن الرقم بعينك. والأنظفُ أداتان مصنوعتان لهذا: `pgrep` يبحث فيعطيك المعرّفات، و`pkill` يبحث فيرسل الإشارة رأسًا.

```zsh
pgrep zsh          # معرّفات كلّ عمليّةٍ في اسمها zsh
pgrep -l zsh       # المعرّف والاسم معًا
pgrep -x Finder    # مطابقةٌ تامّةٌ للاسم لا جزئيّة
pgrep -n zsh       # أحدثُ المطابِقات ولادةً وحدَها
pgrep -o zsh       # وأقدمُها ولادةً
pgrep -u ghazi     # ما يملكه مستخدمٌ بعينه
pgrep -P 4711      # أبناء العملية 4711 المباشرون
```

#session("pgrep -l zsh", output: "12939 zsh
25970 zsh")

وافتراضًا يطابق `pgrep` *اسم البرنامج* وحده، ويكفيه أن يجد نصَّك جزءًا من الاسم لا الاسمَ كلَّه — ولهذا كان `-x` لمن أراد المطابقة التامّة. فإن أردتَ البحث في سطر الأمر كاملًا بمعطياته فأضِف `-f`. و`pkill` توأمُه في الخيارات تمامًا، لكنّه يرسل بدل أن يعرض:

```zsh
pgrep -f "sleep 500"   # ابحث في سطر الأمر كلِّه لا في الاسم وحده
pkill -x sleep         # أنهِ ما طابق الاسمَ تمامًا
pkill -HUP -x nginx    # وأرسل HUP لا TERM
```

#warn[
  ما تكتبه لـ`pgrep` ليس نصًّا حرفيًّا بل *تعبيرٌ نمطيّ* موسّع (وله فصل «التعابير النمطية» كاملًا لاحقًا)، فالنقطة فيه تعني «أيّ حرف» لا النقطة نفسها. ومع `-f` يصير سلاحًا ذا حدّين: يطابق سطرَ الأمر بأكمله فقد يصطاد ما لم تقصد. لو كتبتَ `pkill -f 77` أصبتَ كلَّ عمليّةٍ يظهر فيها العدد 77 في أيّ موضعٍ من سطرها، ولو كان جزءًا من مسارٍ أو من رقمٍ آخر عارض. والقاعدة الذهبيّة: نفّذ `pgrep` أوّلًا بالمعطيات نفسها وتأمّل الصيد، فإن رضيتَ بالقائمة فبدّل الاسمَ إلى `pkill`.
]

#section[`top`: النبض حيًّا]

عيبُ `ps` أنّه صورةٌ ساكنة. أمّا حين تريد أن *تشاهد* النبض وهو ينبض — أيُّ عمليّةٍ تلتهم المعالج الآن؟ ولماذا اشتغلت المراوح فجأة؟ — فأداتُك `top`: شاشةٌ تتجدّد وحدها كلّ ثانية.

```zsh
top -o cpu      # مرتّبةً حسب المعالج تنازليًّا
top -o mem      # مرتّبةً حسب الذاكرة
```

ويعلو الشاشةَ ملخّصٌ للنظام كلِّه قبل جدول العمليّات، فيه أسطرٌ تستحقّ القراءة:

#session("top -o cpu", output: "Processes: 730 total, 3 running, 727 sleeping
Load Avg: 2.09, 2.08, 2.04
CPU usage: 11.34% user, 9.66% sys, 78.98% idle
PhysMem: 16G used (3155M wired), 121M unused")

سطرُ `Load Avg` هو *معدّل الحِمل*: متوسّط عدد العمليّات المنتظرة دورَها على المعالج خلال دقيقةٍ، ثم خمسٍ، ثم خمس عشرة. اقرأه منسوبًا إلى عدد النوى عندك: رقمٌ قريبٌ من عددها يعني انشغالًا صحّيًّا، وضِعفُه يعني ازدحامًا وطابورًا. وسطرُ `CPU usage` يفصل نصيب برامجك (`user`) عن نصيب النواة (`sys`) عن الفراغ (`idle`).

وأنت داخل `top` لستَ متفرّجًا؛ فهو يقبل أوامرَ بحرفٍ واحد: تضغط `o` فيسألك عن مفتاح الترتيب فتكتب `cpu` أو `mem` وتضغط #kbd("Enter")، و`s` لتغيّر مدّة التحديث، و`S` لترسل إشارةً إلى معرّفٍ تحدّده، و`?` للمساعدة، و#kbd("q") للخروج.

#tip[
  إن أردتَ لقطةً واحدةً من `top` تضعها في ملفٍّ أو تمرّرها إلى أمرٍ آخر بدل الشاشة الحيّة، فاستعمل وضع التسجيل: `top -l 1 -n 10 -o cpu` يطبع عيّنةً واحدةً بأعلى عشر عمليّاتٍ ثم يعيدك إلى المحثّ. هذه هي الصيغة التي تصلح للسكربتات؛ أمّا الشاشة الحيّة فللعين وحدها.
]

#subsection[`htop`: الحقيقةُ نفسها بوجهٍ أرحم]

`top` أداةٌ من صنع Apple، مقتضبةٌ سريعة. وثمّة بديلٌ مجتمعيٌّ محبوبٌ أوسعُ راحةً اسمه `htop`: ألوان، وتمريرٌ بالأسهم، واختيارٌ للعملية بالنقر، وأشرطةٌ لكلّ نواةٍ على حِدة. لا يأتي مع ماك، بل تجلبه بمدير الحزم Homebrew الذي يشغل الفصل التالي كاملًا:

```zsh
brew install htop
htop -t             # اعرضها شجرةَ نسبٍ لا قائمةً مسطّحة
```

وأجملُ ما فيه لهذا الفصل الخيار `-t`: يعرض العمليّات شجرةً متداخلةً ترى فيها بعينك مَن أنجب مَن، فتنكشف لك بنيةُ النظام التي تسلّقتها قبل قليل. وداخله تفرز بـ#kbd("F6")، وتُنهي عمليّةً مختارةً بـ#kbd("F9")، وتخرج بـ#kbd("F10") أو #kbd("q").

وقد ينبّهك Homebrew بعد التثبيت إلى أنّ `htop` يحتاج صلاحيّات المدير ليعرض عمليّاتِ المستخدمين الآخرين عرضًا كاملًا. وهذا صحيحٌ لكنّه ليس شرطًا للاستعمال: `htop` بلا صلاحيّاتٍ يريك عمليّاتِك أنت كاملةً، وهو ما تحتاجه في تسعٍ من كلّ عشر مرّات. ولا تعوّد نفسك `sudo` لأداةِ عرضٍ ما دمتَ لا تحتاجها.

#distro[
  على لِينُكس تجد `htop` في مستودعات كلّ توزيعة، ومعه أداةٌ صغيرةٌ لطيفةٌ اسمها `pstree` ترسم شجرة العمليّات بخطوطٍ في الطرفية. ولا `pstree` على ماك افتراضًا؛ وأقربُ ما يعوّضها `htop -t`، أو أن تعرض `PPID` مع `PID` وتتتبّع السلسلة بعينك كما فعلتَ في تمرين تسلّق الشجرة.
]

#try-it[
  شغّل `top -o cpu`، وافتح متصفّحًا أو حرّك نافذةً ثقيلةً وراقب مَن يقفز إلى القمّة. ثم — وأنت داخله — اضغط `o` واكتب `mem` واضغط #kbd("Enter")، ولاحظ كيف انقلب الترتيبُ كلُّه: أكبرُ آكلي الذاكرة غالبًا ليسوا أكبرَ آكلي المعالج. اخرج بـ#kbd("q").
]

#section[الإشارات: كيف تخاطب عمليّةً حيّة]

لا تُنهي عمليّةً في يونِكس بيدك، ولا تدخل عليها ذاكرتَها. أنت تُرسل إليها *إشارة*: رسالةً قصيرةً موحّدةً تحملها النواةُ نيابةً عنك.

#define("الإشارة (Signal)", [
  إخطارٌ رقميٌّ صغيرٌ ترسله النواةُ إلى عمليّةٍ لتقاطع سيرَها بطلب: أن تنتهي، أو تتجمّد، أو تعيد قراءة إعداداتها. لكلّ إشارةٍ رقمٌ واسمٌ رمزيّ. وأكثرُ الإشارات يستطيع البرنامجُ أن *يلتقطها* فيتصرّف بها كما يشاء — إلّا اثنتين لا تُلتقطان أبدًا.
])

ولترى قائمة الإشارات المتاحة على جهازك:

#session("kill -l", output: "HUP INT QUIT ILL TRAP ABRT EMT FPE KILL BUS SEGV
SYS PIPE ALRM TERM URG STOP TSTP CONT CHLD TTIN
TTOU IO XCPU XFSZ VTALRM PROF WINCH INFO USR1 USR2")

الترتيبُ هو الترقيم: الأولى رقمها 1 وما بعدها على التوالي. وأهمُّها في العمل اليوميّ ستٌّ:

#table(
  columns: (auto, auto, 1fr),
  [الاسم], [الرقم], [معناها],
  [`HUP`],  [1],  [«أُغلِقت السمّاعة»، وصارت عرفًا تعني: أعِد قراءة إعداداتك.],
  [`INT`],  [2],  [مقاطعةٌ من لوحة المفاتيح — وهي ما يرسله #kbd("Ctrl") + #kbd("C").],
  [`KILL`], [9],  [إنهاءٌ فوريٌّ لا يُلتقط ولا يُردّ.],
  [`TERM`], [15], [طلبُ إنهاءٍ مهذّب، وهو الافتراض.],
  [`STOP`], [17], [جمّد العملية فورًا — لا يُلتقط أيضًا.],
  [`CONT`], [19], [أكمِل بعد التجميد.],
)

#subsection[`TERM` تطلب، و`KILL` تبطش]

الأمر الذي يرسل الإشارات اسمه — على غرابته — `kill`، وهو افتراضًا يرسل `TERM` لا `KILL`. والفرق بينهما ليس في الشدّة فحسب بل في الأدب: `TERM` طَرْقٌ على الباب يقول «أنهِ عملك واخرج»، فتملك العمليةُ أن تلتقطه فتحفظ ملفّاتِها وتغلق اتّصالاتِها ثم تخرج بكرامة. أمّا `KILL` فلا يصل إلى العملية أصلًا؛ النواةُ تتلقّاه وتنزع الحياة منها في مكانها، فلا تحفظ ولا تنظّف ولا تودّع.

ولنرَ الفرق بأعيننا لا بالكلام. اكتب هذا *السكربت* الصغير — أي ملفًّا نصّيًّا فيه أوامرُ تُنفَّذ بالترتيب — في ملفّ `worker.sh`، واجعله تنفيذيًّا بـ`chmod +x worker.sh` كما تعلّمتَ في فصل الصلاحيات:

```zsh
#!/bin/zsh
# يلتقط TERM فيحفظ عمله قبل أن يخرج
trap 'echo saved >> /tmp/work.log; exit 0' TERM
while true; do sleep 1; done
```

السطر `trap` يقول: «إن جاءتك `TERM` فنفّذ هذا قبل أن تخرج» (وله شرحٌ أوفى في فصل «أساسيات كتابة السكربتات»). شغّله في الخلفيّة بـ`./worker.sh &`، ثم أرسل إليه الطلب المهذّب بـ`kill %1`، ثم اقرأ سجلّه:

#session("cat /tmp/work.log", output: "saved")

التقط السكربتُ الإشارةَ فحفظ ثم خرج. الآن احذف السجلّ وأعِد التجربة من نظيف، لكن أنهِه هذه المرّة بالإشارة القاصمة `kill -9 %1`:

#session("cat /tmp/work.log", output: "cat: /tmp/work.log: No such file or
directory")

لا سطرَ محفوظًا، ولا ملفَّ أصلًا: لم يُمهَل السكربتُ لحظةً واحدةً ليكتب. هذا هو الفرق بين أن *تطلب* وأن *تبطش*، وهو نفسه الفرق بين محرّرٍ يحفظ مسوّدتك قبل الإغلاق وآخرَ يفقدها.

#warn[
  `kill -9` ملاذٌ أخير لا خيارٌ أوّل. جرّب `kill` المجرّدة أوّلًا وامنح العملية ثانيتين؛ فأغلبُ ما يبدو «معلّقًا» ينتهي بأدبٍ لو صبرتَ عليه. ولا تجعل `-9` عادةً في سكربتاتك: البرنامج الذي يُقتَل قسرًا قد يترك خلفه ملفّاتٍ نصفَ مكتوبة، أو أقفالًا لم تُرفَع، أو قاعدةَ بياناتٍ تطلب إصلاحًا عند التشغيل التالي. الأدبُ مع العمليّات ليس ترفًا؛ إنّه حمايةٌ لبياناتك أنت.
]

#subsection[التجميد والإحياء: `STOP` و`CONT`]

ليست كلُّ الإشارات قتلًا. الإشارة `STOP` تجمّد العملية في مكانها: تبقى في الذاكرة بكلّ حالها، لكنّها لا تأخذ من المعالج شيئًا. و`CONT` تُعيدها من حيث توقّفت كأنّ شيئًا لم يكن. راقب عمود `STAT` وهو يتبدّل:

#session("ps -o stat= -p 4711", output: "S")

#session("kill -STOP 4711; ps -o stat= -p 4711", output: "T")

#session("kill -CONT 4711; ps -o stat= -p 4711", output: "S")

الحرف `T` هو التجميد. وهذا مفيدٌ عمليًّا: لو رأيتَ عمليّةً تلتهم المعالج ولم تحسم أمرَها بعد، جمّدها بـ`STOP` لتهدأ الحرارةُ وتفكّر على مهل، ثم أطلقها بـ`CONT` أو أنهِها بـ`TERM`. (والعلامة `=` بعد اسم العمود في `ps -o stat=` تعني: اطبع القيمة بلا عنوانٍ فوقها.)

ولاحظ أنّ `KILL` و`STOP` هما الإشارتان الوحيدتان اللتان لا يستطيع برنامجٌ التقاطَهما ولا تجاهلَهما. ولهذا صار `kill -9` مضربَ المثل: لأنّه الوحيد الذي لا يُردّ. أمّا ما عداهما — حتى `TERM` و`INT` — فيستطيع البرنامج أن يعترضه ويتصرّف به كما يشاء، وهو بالضبط ما فعله سكربتُك قبل قليل.

#distro[
  أرقام الإشارات ليست واحدةً في كلّ الأنظمة، والأسماءُ هي الآمنة. على ماك وBSD: `STOP` هي 17 و`TSTP` هي 18 و`CONT` هي 19. أمّا على لِينُكس فـ`CONT` هي 18 و`STOP` هي 19 و`TSTP` هي 20. والمتّفَق عليه في الأنظمة كلِّها هو الأرقام 1 إلى 6 (`HUP` و`INT` و`QUIT` و`ILL` و`TRAP` و`ABRT`)، و`KILL` (9)، و`SEGV` (11)، و`PIPE` (13)، و`ALRM` (14)، و`TERM` (15). والخلاصة العمليّة: اكتب `kill -TERM` و`kill -STOP` بالاسم لا بالرقم، يعمل أمرُك أينما ذهبت.
]

#try-it[
  أطلق هدفًا آمنًا: `sleep 500 &`، ثم خذ معرّفه بـ`pgrep -n -x sleep`. اقرأ حاله بـ`ps -o stat= -p` متبوعًا بالمعرّف (سيكون `S`)، ثم جمّده بـ`kill -STOP` واقرأ حاله ثانيةً (`T`)، ثم أحيِه بـ`kill -CONT` واقرأه ثالثةً فيعود `S`. أخيرًا أنهِه بـ`kill` المجرّدة، وتأكّد أنّه ذهب فلم يعد `ps` يجد له أثرًا. ثلاث إشاراتٍ في دقيقة، ورأيتَ أثر كلٍّ منها بحرفٍ واحد.
]

#section[`killall`: الإنهاء بالاسم]

حين يفتح تطبيقٌ عدّةَ عمليّاتٍ بالاسم نفسه، يصير الصيدُ بالرقم مملًّا. والأمر `killall` يرسل الإشارة إلى *كلّ* عمليّةٍ تحمل الاسم الذي تعطيه. جرّبه على هدفٍ من صنعك: نفّذ `sleep 500 &` ثلاث مرّات، ثم:

```zsh
killall sleep        # TERM إلى كلّ ما اسمه كذلك
killall -9 sleep     # وقاصمةً عند الضرورة القصوى
```

والاسمُ عنده حسّاسٌ لحالة الأحرف ويجب أن يطابق تمامًا — لا جزءًا منه كما في `pgrep` — فإن أخطأتَ في حرفٍ لم يجد شيئًا وقال لك ذلك صراحةً:

#session("killall SLEEP", output: "No matching processes belonging to you
were found")

#danger[
  `killall` واسعُ الأثر: كلمةٌ واحدةٌ تُنهي عائلةً كاملةً من العمليّات دفعةً واحدة. لا تكتبه إلّا وقد تحقّقتَ من الاسم بـ`pgrep -x` قبله، ولا تسبقه بـ`sudo` وأنت تجرّب فتبلغ به عمليّاتِ النظام لا عمليّاتك. واحذر مكيدةً تاريخيّة: على أنظمة يونِكس العتيقة من طراز System V كان `killall` بلا معطًى يُنهي *كلَّ* عمليّات النظام لإطفائه. فإن جلستَ يومًا أمام نظامٍ غريبٍ فلا تجرّب هذا الأمر ظنًّا أنّه كعادته على ماك.
]

#section[التحكّم بالمهامّ: في يديك أو خلف ظهرك]

حين تنفّذ أمرًا طويلًا تمسك الطرفيةُ عنه حتى ينتهي، فلا تستطيع كتابة غيره. لكنّ الصدفة تملك أن تشغّل أكثر من مهمّةٍ في وقتٍ واحد: واحدةً في *المقدّمة* تمسك لوحةَ المفاتيح، وسواها في *الخلفيّة* تعمل صامتة.

#define("المهمّة (Job)", [
  عمليّةٌ — أو سلسلةُ عمليّاتٍ في أنبوبٍ واحد — أطلقتها صدفتُك وتتولّى هي إدارتها. والصدفة ترقّمها ترقيمًا خاصًّا بها يبدأ من 1، وتشير إليه بعلامة النسبة: `%1` و`%2`. ولا تخلط بين رقم المهمّة الذي لا تعرفه إلّا صدفتُك، ومعرّف العملية الذي يعرفه النظام كلُّه.
])

تُلحق الأمرَ بعلامة `&` فيبدأ في الخلفيّة وتعود إليك الطرفيةُ فورًا، وتسرد ما لديك بـ`jobs`:

#session("jobs -l", output: "[1]  - 33984 running    sleep 100
[2]  + 33985 running    sleep 200")

الرقم بين القوسين رقمُ المهمّة، والعلامة `+` تشير إلى المهمّة الحاليّة (التي تعنيها `fg` إن لم تسمِّ شيئًا) و`-` إلى التالية لها، والخيار `-l` يضيف معرّف العملية الحقيقيّ. والانتقالُ بين الحالين بأربع أدوات:

#table(
  columns: (auto, 1fr),
  [الأداة], [ما تفعل],
  [`&`], [تُلحق بالأمر فيبدأ في الخلفيّة رأسًا.],
  [#kbd("Ctrl") + #kbd("Z")], [تجمّد مهمّة المقدّمة وتعيدك إلى المحثّ.],
  [`bg %1`], [تُكمل المهمّة المجمّدة، لكن في الخلفيّة.],
  [`fg %1`], [تجلب مهمّةً من الخلفيّة إلى المقدّمة.],
)

فحين تنسى `&` ويشغلك أمرٌ طويل، لا تقتله ولا تنتظر: اضغط #kbd("Ctrl") + #kbd("Z") ليتجمّد (وهي إشارة `TSTP`)، ثم `bg` ليكمل في الخلفيّة، وقد استرجعتَ طرفيّتك دون أن تُضيّع دقيقةً من عمله. وتقبل `kill` أرقامَ المهامّ كما تقبل المعرّفات: `kill %2` أوضحُ وأقلُّ خطرًا من تذكّر رقمٍ من خمس خانات.

#subsection[ما يبقى بعد أن تغلق الطرفية]

المهمّة في الخلفيّة ليست حرّةً تمامًا: هي ما تزال ابنةَ صدفتك. وحين تغلق نافذةَ الطرفية تُرسَل إشارة `HUP` إلى مهامّها — والاسمُ نفسه شاهدٌ على أصلٍ عتيق: hang up أي «أَغلِق السمّاعة»، من أيّام الطرفيّات التي كانت تتّصل بالحاسوب عبر خطّ الهاتف، فإذا انقطع الخطّ أُخطِرت البرامجُ بأنّ صاحبها ذهب. ولذلك تموت أغلبُ المهامّ بإغلاق النافذة. وللنجاة أداتان:

```zsh
nohup ./long-task.sh &   # حصّنه من HUP منذ البداية
disown %1                # أو انزع القائمة من السجلّ
```

والفرق بينهما في التوقيت والأثر: `nohup` قرارٌ *مسبقٌ* تتّخذه لحظةَ الإطلاق، فيحصّن البرنامج من `HUP` ويحوّل مخرجاتِه إلى ملفّ `nohup.out` إن كانت متّجهةً إلى الشاشة. أمّا `disown` فقرارٌ *لاحقٌ* تتّخذه بعد أن يكون البرنامج قد بدأ: يمحو المهمّة من سجلّ الصدفة فلا تعود تُخطِرها بشيءٍ عند الخروج. جرّب: بعد `disown %1` اسأل `jobs` فلن تجدها، ثم اسأل `pgrep` عنها فستجدها حيّةً تعمل. لقد خرجت من سجلّ الصدفة لا من الوجود.

#tip[
  الأنظفُ أن تجمع الأمرين وتوجّه المخرجات بنفسك بدل أن تتركها لـ`nohup.out`: `nohup ./task.sh > run.log 2>&1 &` ثم `disown`. هكذا تعرف أين تجد سجلّ عملك بالضبط. وإن كانت مهمّتك طويلةً حقًّا وتريد أن *تعود إليها* لا أن تتركها فحسب، فما تحتاجه مضاعِفُ طرفيّاتٍ مثل `tmux`، وله موضعه في فصل «الطرفية بيئةَ عملٍ متكاملة».
]

#try-it[
  نفّذ `sleep 300 &` مرّتين لتصير لك مهمّتان، ثم `jobs -l` لتراهما بمعرّفيهما. اجلب الثانية إلى المقدّمة بـ`fg %2`، ثم جمّدها بـ#kbd("Ctrl") + #kbd("Z") ولاحظ ماذا يطبع لك، ثم أعِدها إلى الخلفيّة بـ`bg %2`. أخيرًا نفّذ `disown %1` ثم `jobs` — أين ذهبت الأولى؟ تأكّد أنّها حيّةٌ بـ`pgrep -f "sleep 300"`، ثم نظّف بـ`pkill -f "sleep 300"`.
]

#section[الأولويّة: مَن يتقدّم في الطابور؟]

النواةُ تقسم المعالج بين العمليّات، ولها في القسمة مقياسٌ اسمه *اللطف*: كلّما كانت العملية «ألطف» تنازلت لغيرها عن دورها أكثر.

#define("قيمة اللطف (nice)", [
  رقمٌ يرافق كلَّ عمليّةٍ يخبر النواةَ بمدى استعجالها، قيمتُه الافتراضيّة 0. فكلّما *ارتفع* الرقم قلّت أولويّةُ العملية (صارت ألطفَ فتنازلت أكثر)، وكلّما انخفض ارتفعت أولويّتُها. ومداه على ماك من `-20` (أشدُّ إلحاحًا) إلى `20` (أكثرُ تنازلًا).
])

تُطلق أمرًا بلطفٍ محدّدٍ بـ`nice`، وتغيّر لطفَ عمليّةٍ قائمةٍ بـ`renice`، وتقرأ النتيجة في عمود `NI`:

```zsh
nice -n 10 ./heavy-task.sh   # أطلقه متنازلًا من أوّل لحظة
renice 15 -p 4711            # واجعل عمليّةً قائمةً ألطف
```

#session("renice 15 -p 4711; ps -o pid,ni,comm -p 4711", output: "  PID NI COMM
 4711 15 /bin/sleep")

وهذا مفيدٌ حين تشغّل عملًا ثقيلًا طويلًا — ضغطَ ملفّاتٍ، أو ترجمةَ شفرةٍ، أو تحويلَ فيديو — وتريده أن يمضي دون أن يُبطئ عليك بقيّةَ الجهاز: أطلقه بـ`nice -n 10` فيأخذ المعالجَ حين يفرغ، ويتنحّى حين تحتاجه أنت.

#warn[
  رفعُ الأولويّة ليس كخفضها. المستخدم العاديّ يستطيع أن *يزيد* رقم اللطف متى شاء فتصير عمليّتُه أشدَّ تنازلًا، لكنّه *لا يستطيع* أن ينقصه أبدًا: لا ليعيده إلى ما كان، ولا ليهبط به تحت الصفر. صفحة `man renice` تقول ذلك صراحةً في باب العيوب: حتى مَن خفض أولويّة عمليّته بيده لا يملك رفعَها ثانية. وهذا حاجزٌ متعمّد: لولاه لأمكن أيَّ برنامجٍ أن يتقدّم على الجميع فيشلّ الجهاز. والقاعدة: التنازل مباحٌ لك ولا رجعة فيه، والتقدّم يحتاج إذن المدير.
]

#distro[
  فرقان دقيقان يوقعان المنتقلَ بين النظامين. أوّلهما المدى: أقصى لطفٍ على ماك (وBSD) هو `20`، وعلى لِينُكس `19`. وثانيهما — وهو الأخطر — معنى الخيار `-n` في `renice`: على ماك يعني *زيادةً* تُضاف إلى القيمة الحاليّة، بينما تُكتب القيمةُ المطلقة بلا خيارٍ أصلًا (`renice 15 -p 4711`). أمّا على لِينُكس فـ`-n` هي القيمة المطلقة نفسها. فإن نسختَ أمرًا من مقالٍ لِينُكسيّ فقد تحصل على غير ما أردت.
]

#section[`lsof`: مَن يمسك هذا الملفّ؟]

في يونِكس «كلُّ شيءٍ ملفّ»: الملفّاتُ ملفّات، والمجلّداتُ ملفّات، وحتى اتّصالُ الشبكة ملفٌّ مفتوح. ومن هنا نبعت أداةٌ نفيسة اسمها `lsof` — أي list open files، «اسرد الملفّات المفتوحة» — تجيبك عن سؤالين يتكرّران على كلّ من عمل بالطرفية: مَن يمسك هذا الملفّ فلا يدعني أحذفه؟ ومَن يجلس على هذا المنفذ فلا يدع خادمي يبدأ؟

#define("المنفذ (Port)", [
  رقمٌ بين 1 و65535 يميّز بابًا من أبواب الشبكة في جهازك. فالعنوان يقول «أيّ جهاز»، والمنفذ يقول «أيّ برنامجٍ فيه». ولا يجلس على المنفذ الواحد — في العادة — إلّا برنامجٌ واحد، ولذلك تشكو الخوادمُ من «المنفذ مشغول» حين تجد بابَها محجوزًا. وله تفصيله في فصل «الشبكات على ماك».
])

```zsh
lsof -p 4711            # كلّ ما تفتحه العملية 4711
lsof ~/notes.txt        # مَن يمسك هذا الملفّ؟
lsof -u ghazi           # كلّ ما يفتحه مستخدمٌ بعينه
lsof -nP -i :8080       # مَن يجلس على المنفذ 8080؟
```

والخياران `-n` و`-P` يمنعان `lsof` من ترجمة العناوين إلى أسماء نطاقاتٍ وأرقامِ المنافذ إلى أسماء خدمات، فيصير الخرجُ أسرعَ وأوضح؛ فبغيرهما قد يطبع لك `http-alt` بدل `8080` فتحار. وأعمدةُ الخرج تُقرأ هكذا:

#table(
  columns: (auto, 1fr),
  [العمود], [ما يعنيه],
  [`COMMAND`], [اسم البرنامج المالك.],
  [`PID`],  [معرّف العملية — وهو ما تريده غالبًا.],
  [`USER`], [مالكها.],
  [`FD`],   [رقم *واصف الملفّ*: الرقم الذي تعرف به العمليةُ ملفًّا فتحته. وقد يحلّ محلَّه `cwd` لمجلّدها الحاليّ أو `txt` لبرنامجها نفسه.],
  [`TYPE`], [نوعه: `REG` ملفٌّ عاديّ، `DIR` مجلّد، `IPv4` اتّصال.],
  [`NAME`], [المسار، أو العنوان والمنفذ وحالُ الاتّصال.],
)

وتذكّر أنّك ترى بقدر ما تملك: `lsof` بلا صلاحيّة المدير لا يكشف لك إلّا ملفّاتِ عمليّاتك أنت، فإن سألتَه عن منفذٍ تجلس عليه خدمةٌ من خدمات النظام لم يُجب. وهذا حجبٌ مقصودٌ لا عطل.

وحين لا تريد إلّا المعرّف لتمرّره إلى أمرٍ آخر، فالخيار `-t` يعطيك الأرقام مجرّدةً بلا عناوينَ ولا أعمدة:

#session("lsof -t -i :8080", output: "34899")

#tip[
  هذه الوصفة تحلّ أشهرَ إزعاجٍ يلقاه من يشتغل بالخوادم — رسالةَ «المنفذ مشغول»: `kill $(lsof -t -i :8080)`. يجلب `lsof` معرّفَ الجالس على المنفذ فيسلّمه إلى `kill`، فيطلب منه الانصراف بأدب. ولا تكتبها إلّا بعد أن تنظر بعينك إلى `lsof -nP -i :8080` وتتأكّد أنّ الجالس هو خادمُك التجريبيّ لا خدمةٌ من خدمات النظام.
]

#distro[
  `lsof` نفسُها متاحةٌ على لِينُكس وBSD بالصياغة ذاتها، وهذا من قليلٍ لا يتغيّر. لكنّ أدوات التتبّع العميق تختلف: على لِينُكس تراقب نداءاتِ برنامجٍ للنظام بأداة `strace`، ونظيرُها على ماك `dtruss` المبنيّةُ على DTrace. غير أنّ `dtruss` تحتاج `sudo`، وحمايةُ تكامل النظام (SIP) تمنعها من تتبّع أغلب برامج Apple نفسها ما دامت مفعّلة — وهي مفعّلةٌ افتراضًا ويجب أن تبقى كذلك، كما رأيتَ في فصل «sudo والجذر وحماية SIP». فلا تتوقّع على ماك حرّيّةَ التتبّع التي تعرفها على لِينُكس.
]

#section[`ulimit`: سقفُ ما تستطيعه العملية]

للعملية حدودٌ لا تتعدّاها: كم ملفًّا تفتح في وقتٍ واحد، وكم تكبر ذاكرتُها، وكم يطول زمنُها على المعالج. تضبط هذه السقوفَ الصدفةُ فترثها كلُّ عمليّةٍ تولد منها، والأداة اسمها `ulimit` (وهي مبنيّةٌ في الصدفة لا برنامجًا مستقلًّا):

#session("ulimit -a", output: "-t: cpu time (seconds)              unlimited
-f: file size (blocks)              unlimited
-s: stack size (kbytes)             8192
-c: core file size (blocks)         0
-u: processes                       2784
-n: file descriptors                256")

والأرقام تختلف من إصدارٍ لآخر ومن طرفيّةٍ لأخرى، فلا تستغرب إن رأيتَ عندك غيرَ ما ترى هنا؛ وسقفُ الملفّات `-n` خاصّةً لزم الرقم 256 على ماك دهرًا طويلًا، وقد تجده عندك أكبرَ من ذلك بكثير.

ولكلّ سقفٍ قيمتان: قيمةٌ *ليّنةٌ* هي المطبّقة الآن وتستطيع أنت رفعها إلى حدّ الصلبة، وقيمةٌ *صلبةٌ* هي الحدّ الأعلى الذي لا يرفعه إلّا المدير؛ تقرؤهما بـ`ulimit -Sn` و`ulimit -Hn`، وتغيّر اللّيّنة وحدَها بـ`ulimit -Sn` متبوعًا بالقيمة. وأكثرُ هذه السقوف إثارةً للمشاكل `-n`: عددُ الملفّات المفتوحة. فأدواتُ التطوير الحديثة — من مترجماتٍ ومراقباتِ ملفّاتٍ وخوادمِ تطوير — تفتح آلافًا منها، وحين تضيق بها تسقط برسالةٍ محيّرةٍ نصُّها `too many open files`. وعلاجُها الأوّل رفعُ السقف اللّيّن:

#session("(ulimit -Sn 4096; ulimit -Sn)", output: "4096")

وانتبه للقوسين في المثال أعلاه: رُفعت القيمة داخل *صدفةٍ فرعيّة*، فلمّا خرجنا منها عادت القيمةُ الأصليّة كما كانت. وهذه طبيعةُ `ulimit`: يؤثّر في الصدفة الحاليّة وفيما تلده بعده لا فيما وُلد قبله، ولا يبقى أثرُه بعد إغلاق النافذة؛ ولذلك يوضع في ملفّ إعداد الصدفة إن أُريد له الدوام، كما يأتي في فصل «البيئة وتخصيص zsh».

#warn[
  رفعُ السقوف ليس علاجًا لكلّ داء. البرنامج الذي يستنفد آلافَ الملفّات المفتوحة غالبًا لا يغلق ما يفتح، وهذا خللٌ فيه لا ضيقٌ في نظامك؛ ورفعُ السقف يؤجّل السقوطَ ولا يمنعه. ارفعه حين تعرف أنّ الحاجة مشروعةٌ — كخادمٍ يخدم آلافَ الاتّصالات — وابحث عن السبب حين تكون الحاجةُ مريبة.
]

#try-it[
  افتح ملفًّا نصّيًّا طويلًا بـ`less /etc/services` في نافذةِ طرفيّة، ثم اسأل عنه من نافذةٍ أخرى: `lsof /etc/services` — سترى `less` ممسكًا به، وعمود `FD` يخبرك برقم واصفه. ثم اسأل `lsof -p` عن معرّف `less` نفسه لترى كم ملفًّا يفتح برنامجٌ «بسيط» في الحقيقة. وأخيرًا نفّذ `ulimit -Sn` ثم `ulimit -Hn` وقارن سقفك اللّيّن بالصلب: كم يتّسع لك أن ترفع الأوّل قبل أن تبلغ الثاني؟
]

#section[مراقب النشاط: الوجه الرسوميّ]

كلُّ ما تعلّمتَه في هذا الفصل له وجهٌ رسوميٌّ مرفقٌ مع ماك اسمه *مراقب النشاط*، تفتحه من الطرفية:

```zsh
open -a "Activity Monitor"
```

وحين تنظر فيه الآن ستراه بعينٍ أخرى: عمودُ `% CPU` هو `%CPU` نفسه، وعمودُ «الذاكرة» قريبٌ من `RSS`، وزرُّ «الإنهاء القسريّ» ليس إلّا `kill -9` بواجهة. فالفرق ليس في المعلومة بل فيما تستطيع فعله بها: النافذة تُريك، والطرفية تُريك وتُؤتمِت. والمحترف يستعمل الاثنين — لكنّه يعرف أنّ النافذة لا تُفتح على خادمٍ بعيدٍ تصله بـ`ssh`، وهناك لا يبقى معك إلّا ما في هذا الفصل.

#section[خلاصة الفصل]

رأيتَ أنّ البرنامج على القرص نوتةٌ صامتة، وأنّ *العملية* هي العزفُ نفسه: ذاكرةٌ وهويّةٌ ونصيبٌ من المعالج. وتسلّقتَ شجرة النسب بـ`PID` و`PPID` حتى الجذر رقم 1، وعرفتَ أنّ اليتيم يتبنّاه ذلك الجذر وأنّ الزومبي سجلٌّ لم يُرفع بعد. ثم التقطتَ اللقطة بـ`ps` بصيغتيه البِرْكليّة والمعياريّة، وقرأتَ أعمدتها ومنها `RSS` الصادق و`STAT` المختصر، وصنعتَ جدولك بـ`-o`. وصدتَ بالاسم بـ`pgrep` و`pkill` و`killall`، وشاهدتَ النبض حيًّا في `top` وشجرتَه في `htop -t`. وتعلّمتَ أنّ مخاطبة العمليّات *إشارة*: `TERM` تطرق الباب و`KILL` تخلعه، و`STOP` تجمّد و`CONT` تُحيي — ورأيتَ الفرق بعينك في سجلّ سكربتٍ حَفِظ مرّةً ولم يُمهَل مرّة. ونقلتَ مهامّك بين المقدّمة والخلفيّة بـ`&` و`jobs` و`fg` و`bg`، وحصّنتَ ما يجب أن يبقى بـ`nohup` و`disown`. ثم ضبطتَ الأولويّة بـ`nice`، وكشفتَ بـ`lsof` مَن يمسك ملفًّا أو منفذًا، وقِستَ سقوفَك بـ`ulimit`. في الفصل التالي ننتقل من مراقبة ما يعمل إلى جلب ما لا تملكه بعد: Homebrew، أمينُ المستودع الذي يجلب لك أدوات العالم بأمرٍ واحد — ومنها `htop` التي جرّبتَها للتوّ.

#challenge[
  (1) *الطبيب الشرعيّ:* أجلِس على المنفذ 8080 برنامجًا مرفقًا مع ماك بـ`nc -l 8080 &` (و`nc` أداةُ شبكةٍ بسيطةٌ تنتظر اتّصالًا لا أكثر)، ثم — دون أن تنظر إلى ما طبعته الصدفة — اكتشف معرّفَه بطريقتين: مرّةً بـ`lsof` من رقم المنفذ، ومرّةً بـ`pgrep -f`. تأكّد أنّ الرقمين واحد، ثم أنهِ الجالسَ بأدبٍ بـ`kill` وتحقّق أنّ المنفذ صار حرًّا. (2) *الفرق بأصابعك:* أعِد بناء سكربت `worker.sh` من الفصل وشغّله مرّتين: أنهِ الأولى بـ`kill` والثانية بـ`kill -9`، وقارن `/tmp/work.log` في الحالين. ثم غيّر سطر `trap` ليلتقط `INT` بدل `TERM`، وشغّل السكربت في المقدّمة، وأنهِه بـ#kbd("Ctrl") + #kbd("C") — هل حفظ؟ ولماذا؟ (3) *المتنازل:* أطلق عملًا ثقيلًا في الخلفيّة (مثل `find /usr /System/Library -type f > /tmp/out.txt 2>/dev/null &`)، واقرأ لطفَه في عمود `NI`، ثم اجعله ألطفَ بـ`renice`، ثم حاول أن تعيده إلى `0` — ماذا قال لك النظام، ولماذا هذا المنعُ في مصلحتك؟
]
