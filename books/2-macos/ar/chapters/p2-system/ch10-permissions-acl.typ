#chapter[الصلاحيات والملكية وقوائم ACL]

#objectives((
  [تقرأ سطر `ls -l` محرفًا محرفًا: نوع العنصر، ثمّ ثلاثيّات المالك والمجموعة والآخرين.],
  [تفرّق بين `r` و`w` و`x`، وتدرك أنّ معناها ينقلب حين يكون الهدفُ مجلّدًا لا ملفًّا.],
  [تضبط الأذون بـ`chmod` رمزيًّا (`u+x`) وعدديًّا (`755`)، وتحسب الثمانيّ في رأسك.],
  [تنقل الملكيّة بـ`chown` و`chgrp`، وتعرف من أين جاء `644`، وما البتّات الخاصّة الثلاث.],
  [تتقن الطبقات الأربع التي يزيدها ماك: السمات الممتدّة `@`، وقوائم ACL بعلامتها `+`، ورايات `chflags`، وحاجز TCC.],
))

تخيّل مطارًا كبيرًا. تحمل تذكرةً صحيحةً باسمك، ومع ذلك لا تمرّ بإبرازها وحدها: عند البوّابة الأولى يُطابَق اسمُك بالتذكرة، وعند الثانية يُفتَّش متاعك، وعند الثالثة يُختَم جوازك، ثمّ يوقفك بعد ذلك كلِّه موظّفٌ ليسألك عن سبب سفرك. بوّاباتٌ متتاليةٌ لا بوّابةٌ واحدة، ولكلٍّ منها وحدَها أن تردّك، ونجاحُك في الأولى لا يُغنيك شيئًا عند الثانية.

هكذا بالضبط يحرس ماك ملفّاتك. البوّابة الأولى هي نظام الأذون اليونِكسيّ العتيق الذي ورثه ماك عن BSD، وهي التي تراها في `ls -l` وتشغل نصف هذا الفصل. وفوقها أربعُ طبقاتٍ لا وجود لها بهذه الصورة على لِينُكس: سماتٌ ممتدّةٌ تلتصق بالملفّ، وقائمةُ تحكّمٍ دقيقةٌ بالوصول، ورايةٌ تعلو على المالك نفسه، وحارسٌ اسمه TCC يقف بين تطبيقك وبين بياناتك الحسّاسة. مَن عرف البوّابة الأولى وحدها حار كثيرًا؛ ومَن عرف الخمس لم تعُد رسالة `Permission denied` لغزًا عنده.

#section[سطر `ls -l`: بطاقةُ هويّةٍ في عشرة محارف]

كلُّ ملفٍّ ومجلّدٍ على جهازك يحمل بطاقةً خفيّةً تجيب عن سؤالين: لِمَن هذا العنصر؟ وماذا يُسمح لكلّ فئةٍ أن تفعل به؟ ويعرض `ls -l` هذه البطاقة كاملة. أنشئ مجلّدًا تجريبيًّا وجرّب:

#session("ls -l", output: "total 8
drwxr-xr-x  2 ghazi  staff  64 Jul 23 17:42 docs
-rw-r--r--  1 ghazi  staff  11 Jul 23 17:42 note.txt")

يبدو السطر طلسمًا، لكنّه سبعةُ حقولٍ مرتّبةٍ تُقرأ من اليسار (فالمخرجات إنجليزيّةٌ يساريّة): كتلةُ الأذون، ثمّ عددُ الروابط الصُّلبة، ثمّ اسمُ المالك، ثمّ اسمُ المجموعة، ثمّ الحجمُ بالبايت، ثمّ تاريخُ آخر تعديل، ثمّ الاسم. الحقلان الثالث والرابع هما *الملكيّة*، والحقل الأوّل هو *الأذون*، وهما موضوعنا.

#define("الملكيّة (Ownership)", [
  لكلّ عنصرٍ *مالكٌ* واحدٌ هو المستخدم الذي أنشأه غالبًا، ثمّ *مجموعةٌ* واحدةٌ قد ينتمي إليها عدّة مستخدمين. ومَن ليس المالكَ ولا عضوًا في المجموعة فهو من *الآخرين*. ثلاثُ فئاتٍ لا رابعة لها، ورموزها `u` للمالك و`g` للمجموعة و`o` للآخرين، و`a` للثلاث مجتمعة.
])

على ماك تكون مجموعتك الأساسيّة `staff` غالبًا، وهي مجموعةٌ يشترك فيها كلُّ المستخدمين العاديّين على الجهاز؛ تحقّق من هويّتك كاملةً بأمر `id`. أمّا كتلة الأذون فعشرةُ محارف، تنقسم إلى محرفٍ للنوع وثلاثِ ثلاثيّاتٍ متتالية:

#table(
  columns: (auto, auto, 1fr),
  align: (right, center, right),
  table.header([الموضع], [في مثالنا], [ما يعنيه]),
  [المحرف 1], [`-`], [نوع العنصر: ملفٌّ عاديّ],
  [من 2 إلى 4], [`rw-`], [ما يملك *المالكُ* فعله],
  [من 5 إلى 7], [`r--`], [ما تملك *المجموعةُ* فعله],
  [من 8 إلى 10], [`r--`], [ما يملك *الآخرون* فعله],
)

وداخل كلّ ثلاثيّةٍ الترتيبُ ثابتٌ أبدًا: `r` ثمّ `w` ثمّ `x`. فإن مُنِح الإذنُ ظهر حرفُه، وإن حُجب ظهرت مكانه شَرطة `-`. أمّا المحرف الأوّل فيخبرك بنوع العنصر: `-` ملفٌّ عاديّ، و`d` مجلّد، و`l` رابطٌ رمزيّ، و`b` أو `c` جهازٌ من أجهزة النظام. فلنقرأ مثالنا كأنّنا نتهجّاه: `-rw-r--r--` تعني «ملفٌّ عاديّ، مالكه يقرأ ويكتب، والمجموعة تقرأ فقط، والآخرون يقرؤون فقط». وسطرُ المجلّد `drwxr-xr-x` يعني «مجلّدٌ، مالكه يفعل كلَّ شيء، والبقيّةُ يسردون ويدخلون فحسب».

#tip[
  إن كتبت `ls -l docs` عرض لك ما *بداخل* المجلّد، لا المجلّدَ نفسه. ولتفحص بطاقة المجلّد ذاتِه أضف الخيار `-d` هكذا: `ls -ld docs`. احفظ هذه الحيلة؛ ستحتاجها في كلّ فحصٍ لمجلّد.
]

#section[الأذون الثلاثة: ومعناها ينقلب على المجلّد]

#define("الأذون الثلاثة", [
  *القراءة* (`r` أي read)، ثمّ *الكتابة* (`w` أي write)، ثمّ *التنفيذ* (`x` أي execute). كلُّ إذنٍ إمّا ممنوحٌ أو ممنوع، ولا وسط بينهما.
])

وهنا المفاجأة التي يتعثّر فيها كلُّ مبتدئ: هذه الحروف الثلاثة تعني على المجلّد شيئًا مختلفًا تمامًا عمّا تعنيه على الملفّ.

#table(
  columns: (auto, 1fr, 1fr),
  align: (center, right, right),
  table.header([الإذن], [على ملفّ], [على مجلّد]),
  [`r`], [قراءةُ محتواه], [*سردُ أسماء* ما بداخله],
  [`w`], [تعديلُ محتواه], [إنشاءُ عناصرَ فيه وحذفُها وإعادةُ تسميتها],
  [`x`], [تشغيلُه كبرنامج], [*الدخولُ إليه والعبورُ منه*],
)

تأمّل الصفّ الأخير: على المجلّد لا يعني `x` «تشغيلًا» — فالمجلّدات لا تُشغَّل — بل يعني *حقَّ العبور*. فلتصل إلى ملفٍّ داخل مجلّد، لا بدّ لك من `x` على المجلّد، ولو كان الملفّ نفسه مقروءًا للعالم أجمع. والأعجب أنّ `r` و`x` مستقلّان تمامًا: يمكنك أن تملك أحدهما دون الآخر، فيتغيّر سلوك النظام تغيّرًا حادًّا كما سترى بعينك في التجربة التالية.

#warn[
  المفاجأة الأشيع: قد تملك `w` على *ملفٍّ* ولا تستطيع حذفه؛ لأنّ الحذف في الحقيقة تعديلٌ *للمجلّد* الحاوي — إذ يُزال اسمُ الملفّ من سجلّ المجلّد — فيتطلّب `w` على المجلّد لا على الملفّ. تذكّر هذا حين يحيّرك رفضُ الحذف.
]

#try-it[
  هذه أنفعُ تجربةٍ في الفصل، فلا تتخطّها. أنشئ مجلّدًا وضع فيه ملفًّا: `mkdir docs` ثمّ `echo hi > docs/inside.txt`. الآن اسحب `x` وحدها عن المجلّد بـ`chmod -x docs` وجرّب `ls docs` ثمّ `cat docs/inside.txt`: سيُطبَع لك الاسم `inside.txt` ويُرفَض الفتح. (وقد يسبق الاسمَ سطرُ شكوى من `ls` نصّه `ls: fts_read: Permission denied`؛ فالأمر قرأ سجلّ الأسماء ثمّ عجز عن العبور ليسأل عن تفاصيلها، وهو نفسه برهانٌ على انفصال `r` عن `x`.) أعِد `x` بـ`chmod +x docs`، ثمّ اسحب `r` وحدها بـ`chmod -r docs` وأعد التجربتين: انقلب الحال تمامًا — يُرفَض السردُ ويَنجح الفتح، لأنّك تعرف الاسم فتعبر إليه مباشرة. أعِد `r` بعدها بـ`chmod +r docs`.
]

والجملةُ التي تلخّص التجربة: `r` يعطيك *فهرس* المجلّد، و`x` يعطيك *مفتاح بابه*. فمن ملك الفهرس دون المفتاح رأى الأسماء ولم يفتح شيئًا، ومن ملك المفتاح دون الفهرس فتح ما يعرف اسمه ولم يرَ القائمة.

#section[`chmod`: ضبط الأذون]

أمرُ تغيير الأذون اسمه `chmod`، وهو اختصار عبارة change mode أي «غيّر النمط». وله صيغتان: رمزيّةٌ سهلة القراءة، وعدديّةٌ سريعة الكتابة، وكلتاهما تفعل الشيء نفسه.

#subsection[الصيغة الرمزيّة: مَن، ثمّ العامل، ثمّ الأذون]

تركيبها ثلاثة أجزاءٍ متلاصقةٍ بلا مسافات: *مَن* (`u` أو `g` أو `o` أو `a`)، ثمّ *العامل* (`+` يضيف، و`-` يسحب، و`=` يثبّت ما ذكرتَه ويمحو ما عداه)، ثمّ *الأذون* (أيُّ خليطٍ من `r` و`w` و`x`).

```zsh
chmod u+x deploy.sh      # امنح المالك التنفيذ
chmod go-w rep.txt       # اسحب الكتابة عنهما
chmod a=r public.txt     # للجميع قراءةٌ فقط
chmod ug+rw,o-rwx s.txt  # تعديلان بفاصلة
```

اقرأ كلَّ سطرٍ كجملةٍ عربيّةٍ مفهومة. ولاحظ في الثالث كيف يمحو `=` كلَّ ما عدا ما ذكرتَ، وفي الرابع كيف تفصل فاصلةٌ بلا مسافةٍ بين تعديلين في أمرٍ واحد. والفرق بين `+` و`=` جوهريّ: الأوّل *يُضيف* فوق الموجود، والثاني *يَجُبّ* ما قبله.

#subsection[الصيغة العدديّة: ثلاثة أرقامٍ لا أكثر]

هذه لغة المحترفين، وأساسها أنّ لكلّ إذنٍ وزنًا رقميًّا: `r` تساوي `4`، و`w` تساوي `2`، و`x` تساوي `1`. تجمع أوزان ما مُنِح في كلّ ثلاثيّةٍ فيخرج رقمٌ واحدٌ من `0` إلى `7` يمثّلها كاملة:

#table(
  columns: (auto, auto, 1fr),
  align: (center, center, right),
  table.header([الرقم], [الثلاثيّة], [الحساب]),
  [`7`], [`rwx`], [4 + 2 + 1],
  [`6`], [`rw-`], [4 + 2],
  [`5`], [`r-x`], [4 + 1],
  [`4`], [`r--`], [4],
  [`3`], [`-wx`], [2 + 1],
  [`2`], [`-w-`], [2],
  [`1`], [`--x`], [1],
  [`0`], [`---`], [لا شيء],
)

وبما أنّ الفئات ثلاث، فالأمر ثلاثةُ أرقام: الأوّل للمالك، والثاني للمجموعة، والثالث للآخرين. تأمّل أشهرها:

```zsh
chmod 755 script.sh          # rwx r-x r-x
chmod 644 note.txt           # rw- r-- r--
chmod 600 ~/.ssh/id_ed25519  # rw- --- ---
chmod -R 755 site            # -R يغوص في المجلّد
```

فـ`755` هو الشائع للمجلّدات وللبرامج القابلة للتشغيل، و`644` للملفّات العاديّة، و`600` لمفتاحٍ سرّيٍّ لا يراه أحدٌ سواك. والخيار `-R` (أي recursive) يطبّق الأمر على المجلّد وكلّ ما تحته. والجسر بين الصيغتين بسيط: اكتب الثلاثيّات وحوّل كلًّا إلى رقمها؛ فـ`rw-r-xr--` تصير `654`. تمرّن على التحويل في الاتّجاهين حتى يصير آليًّا في رأسك.

#danger[
  `chmod 777` يفتح العنصر للعالم أجمع: كلُّ مستخدمٍ يقرأ ويكتب وينفّذ. إيّاك أن تعتاده حلًّا سريعًا كلّما ضاق بك أمرٌ برسالة `Permission denied`؛ فهو ثغرةٌ صريحة، وكثيرٌ من الاختراقات بدأ بها. والقاعدة دائمًا: امنح *أقلّ* إذنٍ يكفي للعمل، لا أوسعه.
]

#section[الملكيّة: `chown` و`chgrp`]

الأذون تجيب عن «ماذا يُسمح»، أمّا «لِمَن» فيضبطه أمران: `chown` يغيّر المالك (وقد يغيّر المجموعة معه)، و`chgrp` يغيّر المجموعة وحدها.

```zsh
chown layla file.txt        # اجعل المالك layla
chown layla:staff file.txt  # مالكٌ ومجموعةٌ معًا
chgrp admin file.txt        # المجموعة وحدها
```

لكن جرّب أوّلَ أمرٍ منها على ملفٍّ تملكه أنت، وانظر ماذا يحدث فعلًا:

#session("chown root note.txt", output: "chown: note.txt: Operation not permitted")

القاعدة صارمةٌ ومنطقيّة، وصفحةُ دليل `chown` تنصّ عليها صراحةً: *إهداءُ ملفٍّ لمستخدمٍ آخر لا يجوز إلّا لمدير النظام*. ولو أمكن لأيّ أحدٍ أن ينسب ملفّاته لغيره أو ينتزع ملفّات جاره، لانهار نظام الملكيّة كلُّه. لذا يسبق `chown` غالبًا الأمرُ `sudo`، وله فصلٌ كاملٌ يليه هو فصل sudo والجذر وحماية SIP. أمّا `chgrp` فأرحمُ قليلًا: يسمح لك بنقل ملفّك إلى مجموعةٍ *أنت عضوٌ فيها*، ويردّك عمّا سواها:

#session("chgrp wheel note.txt", output: "chgrp: you are not a member of group wheel")

#danger[
  احذر `chown -R` و`chmod -R` على مسارٍ خاطئ. جملةٌ واحدةٌ في غير موضعها — كأن تكتب `/` بدل `./` — تقلب ملكيّة ملفّات النظام رأسًا على عقب فتتعطّل الخدمات وتسجيلُ الدخول. اقرأ المسار مرّتين قبل أن تضغط #kbd("Enter").
]

#distro[
  فرقٌ صامتٌ يفاجئ القادم من لِينُكس، وتذكره صفحةُ دليل `chmod` نفسها في سطرٍ عابر: على ماك (وسائر أنظمة BSD) يرث الملفُّ الجديد *مجموعةَ المجلّد الحاوي*، لا مجموعةَ مُنشئه. فلو غيّرت مجموعة مجلّدٍ إلى `admin` ثمّ أنشأت فيه ملفًّا، وجدتَ الملفّ لمجموعة `admin` تلقائيًّا وإن كانت مجموعتُك الأساسيّة `staff`. أمّا لِينُكس فيمنح الملفَّ مجموعةَ مُنشئه الأساسيّة، ولا يرث مجموعةَ المجلّد إلّا إذا وُضعت على المجلّد بتُّ `setgid`. ومعنى ذلك عمليًّا أنّ حيلة `setgid` الشهيرة على لِينُكس لمجلّدات الفرق أقلُّ حاجةً إليها على ماك.
]

#section[`umask`: من أين جاء `644`؟]

لماذا يولد ملفُّك النصّيّ الجديد بـ`644` تحديدًا، ومجلّدُك الجديد بـ`755`؟ الجواب قناعٌ يُدعى `umask`.

#define("umask", [
  قناعٌ يحدّد الأذون التي *تُحجَب* آليًّا عن كلّ عنصرٍ جديد. لا يمنح شيئًا أبدًا؛ بل يطرح. وقيمته النمطيّة على ماك `022`.
])

والآليّة أنّ النظام يبدأ من قاعدةٍ سخيّة — `666` للملفّات و`777` للمجلّدات — ثمّ يطرح منها ما يشير إليه القناع. فبقناع `022` تُسحَب الكتابة (وزنها `2`) من المجموعة ومن الآخرين، ولا يُمسّ المالك: فيصير الملفّ `644` والمجلّد `755`. ولاحظ لماذا لا يولد الملفّ العاديّ بإذن تنفيذٍ أبدًا: لأنّ قاعدته `666` خاليةٌ من `x` أصلًا، وهذا حكيمٌ فالنصوص لا تُشغَّل.

تكتب `umask` وحدها فتردّ عليك بالرقم `022` مجرّدًا؛ وتضيف الخيار `-S` (اختصار symbolic أي «رمزيّ») فتردّ بما *يبقى* مسموحًا بعد الطرح، لا بما حُجب:

#session("umask -S", output: "u=rwx,g=rx,o=rx")

ولتشديد الخصوصيّة اضبط قناعًا أوسع: `umask 077` يجعل كلَّ جديدٍ لك وحدك (ملفٌّ `600` ومجلّدٌ `700`). لكنّ الضبط يدوم للجلسة الحاليّة فحسب؛ ولتثبيته دائمًا يوضع السطر في ملفّ إعداد صدفتك، وذلك موضوع فصل البيئة وتخصيص zsh.

#try-it[
  رسّخ الصيغتين والقناع في تجربةٍ واحدةٍ لا تتجاوز الدقيقة. أنشئ مجلّدًا خاليًا وادخله، ثمّ نفّذ `umask` و`umask -S` وسجّل جوابيهما. الآن `touch a.txt` و`mkdir d` وافحصهما بـ`ls -l` و`ls -ld d`: هل خرجا بـ`644` و`755` كما تتوقّع القاعدة؟ ثمّ نفّذ `umask 077` وكرّر الإنشاء بأسماء جديدة وقارن. وأخيرًا تدرّب على الجسر بين الصيغتين: اضبط `chmod 640 a.txt` ثمّ اقرأ الناتج بـ`ls -l` وتهجّه ثلاثيّةً ثلاثيّة، ثمّ أعد الأذون نفسها بالصيغة الرمزيّة `chmod u=rw,g=r,o= a.txt` وتأكّد أنّ السطر لم يتغيّر. وحين تغلق النافذة يعود القناع إلى `022` وحده، فلا شيء تنظّفه.
]

#section[البتّات الخاصّة الثلاث]

فوق الأذون التسعة، ثلاثُ بتّاتٍ خاصّةٍ تحلّ مشكلاتٍ دقيقة. لن تُنشئها كثيرًا، لكنّ قراءتها في `ls -l` مهارةٌ لازمة، وأوزانها رقمٌ رابعٌ يسبق الثلاثة: `4` لبتّة setuid، و`2` لبتّة setgid، و`1` للبتّة اللاصقة.

فأمّا *setuid* على ملفٍّ تنفيذيّ فتجعله يعمل — أثناء تشغيله — بصلاحيّة *مالكه* لا بصلاحيّة من شغّله. افحص أمرًا حيًّا على جهازك:

#session("ls -l /bin/ps", output: "-rwsr-xr-x  1 root  wheel  170816 Jun 25 05:29 /bin/ps")

انظر إلى `s` مكان `x` في ثلاثيّة المالك: هذا هو setuid. والأمر `ps` — وله فصلٌ كاملٌ هو فصل العمليات: نبض النظام — يعرض عمليّات الجهاز كلِّه لا عمليّاتك وحدها، وقراءةُ عمليّات المستخدمين الآخرين تحتاج سلطةً أعلى من سلطتك؛ فهو مملوكٌ لـ`root` وعليه هذه البتّة، فيستعير سلطة مالكه لحظةَ تشغيله دون أن تصير أنت مديرًا. وتُضبَط رمزيًّا بـ`u+s` أو عدديًّا بـ`4755`.

وأمّا *setgid* فأختُها لكن بصلاحيّة المجموعة، وتظهر `s` في ثلاثيّة المجموعة كما في الأمر `write` عندك (`-r-xr-sr-x`). وأمّا *البتّة اللاصقة* (sticky) فتُوضَع على المجلّدات المشتركة: إذ تمنع من يكتب في المجلّد أن يحذف ملفّات *غيره*، فلا يحذف الملفَّ إلّا مالكُه أو مالك المجلّد. وأشهر مثالٍ حيٍّ عليها مجلّد `/tmp` نفسُه:

#session("ls -ld /tmp/", output: "drwxrwxrwt  42 root  wheel  1344 Jul 23 18:06 /tmp/")

الحرف الأخير `t` مكان `x` هو البتّة اللاصقة. مجلّد `/tmp` مفتوحٌ للكتابة للجميع لأنّ كلّ برنامجٍ يحتاج مكانًا مؤقّتًا؛ ولولا اللصق لاستطاع أيُّ مستخدمٍ أن يمحو ملفّات جاره المؤقّتة فيُسقط برامجه. وتُضبَط رمزيًّا بـ`+t` أو عدديًّا بـ`1777`.

#note[
  إن ظهر الحرف الخاصّ *كبيرًا* (`S` أو `T` بدل `s` و`t`) فذلك يعني أنّ إذن التنفيذ `x` الأصليّ *غيرُ* ممنوحٍ في تلك الثلاثيّة. فالحرف الصغير يجمع البتّة الخاصّة مع تنفيذٍ قائم، والكبير يشير إلى بتّةٍ خاصّةٍ بلا تنفيذ — وهي حالةٌ غالبًا ما تكون خطأً غير مقصود.
]

#danger[
  بتّة setuid على ملفٍّ يملكه `root` سيفٌ حادّ: إن كان في البرنامج ثغرةٌ واحدة، صار بابًا لاختراق النظام كلِّه، لأنّ المهاجم يرث سلطة `root` منه. لا تضعها إلّا حين تفهم تمامًا لماذا، وتجنّبها كليًّا على السكربتات — وكثيرٌ من الأنظمة (ومنها ماك) تتجاهلها على السكربتات أصلًا لهذا السبب بالذات.
]

#section[ما ينفرد به ماك: أربعُ طبقاتٍ فوق `rwx`]

كلُّ ما مضى مشتركٌ بين ماك ولِينُكس وBSD. أمّا ما يلي فهو ما يجعل الصلاحيات على ماك تجربةً مختلفة، وهو أيضًا سببُ أكثر الحيرة التي يشكو منها القادمون إليه من لِينُكس: أربعُ طبقاتٍ تعلو على `rwx`، ولكلٍّ منها علامتُها في المخرجات وأداتُها في الطرفية. واحفظ من الآن قاعدةً تختصر علاقتها كلَّها: *كلُّ طبقةٍ منها تستطيع أن تمنعك وحدها، ولا تستطيع واحدةٌ أن تُبطِل منعَ أختها*. فرضاك عن سطر `ls -l` لا يعني شيئًا ما دامت فوقه طبقةٌ ترفض.

#subsection[العلامة `@`: السمات الممتدّة والحجر الصحّيّ]

نفّذ `ls -l` في مجلّد تنزيلاتك، وستلمح علامة `@` صغيرةً في ذيل كتلة الأذون لم ترها من قبل.

#define("السمة الممتدّة (Extended Attribute)", [
  بياناتٌ إضافيّةٌ يعلّقها النظام على الملفّ خارج محتواه، كبطاقةٍ ملصوقةٍ على ظهر ظرفٍ مغلق: اسمٌ وقيمة. لا علاقة لها بالأذون، لكنّها تسافر مع الملفّ وتؤثّر في سلوك النظام تجاهه. وعلامتها في `ls -l` هي `@`.
])

الخيار `-@` يريك أسماء هذه السمات وأحجامها، والأداة `xattr` تريك قيمها:

#session("ls -l@ app.zip", output: "-rw-r--r--@ 1 ghazi  staff  98214 Jul 17 16:35 app.zip
        com.apple.metadata:kMDItemWhereFroms     121
        com.apple.quarantine                      57")

#session("xattr -p com.apple.quarantine app.zip", output: "0081;6a5a2f8f;Chrome;53CF9D5A-C76F-4F69")

وهذه أهمُّ سمةٍ في نظامك كلِّه. اسمها `com.apple.quarantine` أي *الحجر الصحّيّ*، ويضعها ماك على كلّ ما ينزل من الإنترنت: من متصفّحٍ أو بريدٍ أو رسالة. وقيمتُها سجلٌّ من أربعة حقولٍ تفصلها الفاصلة المنقوطة `;`: رقمٌ ست عشريٌّ يختزن حالة الحجر، ثمّ ختمٌ زمنيّ، ثمّ *اسمُ البرنامج الذي أنزل الملفّ* (وهو `Chrome` هنا)، ثمّ معرّفٌ فريدٌ لعمليّة التنزيل — وهو معرّفٌ طويلٌ اقتُطع طرفُه أعلاه ليتّسع للسطر. بهذه السمة يعرف ماك أنّ الملفّ غريبٌ عن جهازك، فيعرض عليك عند أوّل فتحٍ ذلك السؤال المألوف: «هذا التطبيق نُزّل من الإنترنت، أمتأكّد؟».

ولهذا تفسيرٌ لمشهدٍ محيّر: قد يكون الملفّ مملوكًا لك بأذون `755` سليمة، ومع ذلك يرفض ماك تشغيله. فالمشكلة ليست في البوّابة الأولى، بل في هذه البطاقة الملصوقة. وتُنزَع بأمرٍ واحد:

```zsh
xattr app.zip                          # اسرد الأسماء
xattr -l app.zip                       # اعرض القيم
xattr -d com.apple.quarantine app.zip  # احذف سمةً
xattr -c app.zip                       # امسح الكلّ
```

ولإزالة السمة عن مجلّدٍ وكلِّ ما تحته أضف الخيار `-r` هكذا: `xattr -r -d com.apple.quarantine ./app`.

#danger[
  حذفُ سمة الحجر الصحّيّ ليس «إصلاحًا»؛ إنّه *تعطيلٌ لفحصٍ أمنيّ* وضعته Apple لحمايتك. فبنزعها تتخطّى تحذير Gatekeeper — وله فصلٌ كاملٌ هو فصل أمن ماك المدمج: Gatekeeper وXProtect والتوقيع — وتُخبر النظام: «أنا أضمن هذا الملفّ». لا تفعلها إلّا لملفٍّ تثق بمصدره ثقةً تامّة وتعرف لماذا وُضعت عليه العلامة. وإيّاك أن تعتاد `xattr -c -r` على مجلّداتٍ كاملةٍ نزلت من الشبكة؛ فأنت بذلك تنزع الحجر عن الأصحّاء والمرضى معًا.
]

#subsection[العلامة `+`: قوائم التحكّم بالوصول ACL]

نظام «مالكٍ ومجموعةٍ وآخرين» أنيقٌ لكنّه ضيّق: ماذا لو أردتَ أن تمنح *شخصًا واحدًا بعينه* — ليس المالك ولا في المجموعة — حقَّ القراءة، دون أن تفتح الملفّ للآخرين جميعًا؟ هنا تدخل قوائم ACL.

#define("قائمة التحكّم بالوصول (ACL)", [
  اختصار Access Control List: قائمةٌ *مرتّبة* من المُدخَلات تُلحَق بالعنصر، كلُّ مُدخَلةٍ تذكر مستخدمًا أو مجموعةً بعينها، وتقول `allow` أو `deny`، ثمّ تعدّد أذونًا دقيقة. تُفحَص *قبل* أذون `rwx` ولا تمحوها. وعلامتها في `ls -l` هي `+`.
])

ونموذج ماك مبنيٌّ على معيار NFSv4، لا على POSIX ACL الذي تعرفه لِينُكس، وهذا يجعله *أغنى بكثير*: فبدل ثلاثة أذونٍ فقط تملك أكثر من عشرة أذونٍ دقيقة، وتستطيع أن تمنع (`deny`) صراحةً لا أن تمنح فحسب. تُعرَض القائمة بخيار `ls` الذي اسمه `-e`، وتُضاف المُدخَلة بـ`chmod +a`. أنشئ ملفًّا فارغًا وامنح نفسك عليه حقّ الحذف صراحةً:

#session("chmod +a \"ghazi allow write,delete\" rep.txt", output: none)
#session("ls -le rep.txt", output: "-rw-r--r--+ 1 ghazi  staff  0 Jul 23 18:04 rep.txt
 0: user:ghazi allow write,delete")

ظهرت علامة `+` في ذيل الأذون، وظهرت تحت السطر مُدخَلةٌ واحدةٌ رقمها `0`. والآن أضف مُدخَلةَ منعٍ *بعدها*، وراقب أين تستقرّ:

#session("chmod +a \"everyone deny delete\" rep.txt", output: none)
#session("ls -le rep.txt", output: "-rw-r--r--+ 1 ghazi  staff  0 Jul 23 18:04 rep.txt
 0: group:everyone deny delete
 1: user:ghazi allow write,delete")

كتبتَ المنع ثانيًا فوضعه ماك أوّلًا. المُدخَلات مرقّمةٌ من الصفر وتُقرأ بالترتيب: فأوّلُ مُدخَلةٍ تنطبق هي التي تحكم، ولا يُنظَر إلى ما بعدها. ولهذا لا يترك ماك الترتيب لك، بل يعيد رصّ القائمة على *صورةٍ قانونيّة* تصفها صفحة دليل `chmod` في أربع درجات: المنعُ المكتوب على العنصر نفسه، ثمّ السماحُ المكتوب عليه، ثمّ المنعُ الموروث من مجلّده، ثمّ السماحُ الموروث. فالمنع قبل المنح، والمكتوبُ هنا قبل النازل من فوق. وأثرُ ذلك عمليٌّ صارم: لن تستطيع حذف ملفّك أنت رغم أنّك مالكه وأذونه `644` وأنّك منحتَ نفسك `delete` صراحةً بيدك:

#session("rm rep.txt", output: "rm: rep.txt: Permission denied")

وهذه بعضُ الأذون الدقيقة التي لا نظير لها في `rwx`، وتجد جدولها كاملًا في `man chmod`:

#table(
  columns: (auto, 1fr),
  align: (right, right),
  table.header([الإذن], [معناه]),
  [`delete`], [حذفُ العنصر نفسه],
  [`writeattr`], [تعديلُ سمات العنصر الأساسيّة كتواريخه],
  [`readextattr` و`writeextattr`], [قراءةُ السمات الممتدّة وكتابتُها],
  [`readsecurity` و`writesecurity`], [قراءةُ قائمة ACL نفسها وتعديلُها],
  [`chown`], [تحويلُ ملكيّة العنصر],
  [`list` و`search`], [سردُ أسماء المجلّد، والعبورُ إلى اسمٍ معلومٍ فيه],
  [`add_file` و`add_subdirectory`], [إضافةُ ملفٍّ، وإضافةُ مجلّدٍ فرعيّ],
  [`delete_child`], [حذفُ عنصرٍ من داخل المجلّد],
)

ولحذف المُدخَلات ثلاثُ طرق: `chmod -a "النصّ نفسه"` يحذف مُدخَلةً بنصّها، و`chmod -a# 0` يحذف المُدخَلة رقم صفر، و`chmod -N` يمسح القائمة كلَّها فتختفي علامة `+`.

#deep[
  ولمن أراد أن يعرف *كيف* تجتمع القائمة مع `rwx` بدل أن يحفظ النتيجة: يفحص النظام قائمة ACL أوّلًا، فإن وجد فيها مُدخَلةً تنطبق على طالب الوصول حسم بها منعًا أو منحًا وانتهى الأمر؛ فإن لم يجد شيئًا ينطبق، رجع إلى أذون `rwx` التسعة كأنّ القائمة غير موجودة. وهذا يفسّر أمرين معًا: لماذا ردّتك مُدخَلةُ المنع أعلاه رغم ملكيّتك، ولماذا بقيت قراءةُ الملفّ وكتابتُه تعملان كما كانتا — فلا مُدخَلةَ في القائمة تتحدّث عنهما أصلًا. وجرّب البرهان المعاكس بنفسك: `chmod 000 z.txt` يغلق الملفّ في وجهك تمامًا حتى عن `cat`، فإن أتبعتَه بـ`chmod +a "$(whoami) allow read" z.txt` عاد `cat z.txt` يعمل وسطرُ الأذون على حاله `----------`. قائمةٌ فتحت ما أغلقته الأذون.
]

وأقوى ما في نموذج ماك هو *الوراثة*: تضع القاعدة مرّةً واحدةً على المجلّد، فتنسخها كلُّ العناصر التي تولد فيه بعدُ. والكلمتان `file_inherit` و`directory_inherit` تفعلان ذلك، ولا تُقبلان إلّا على مجلّد:

#session("chmod +a \"ghazi allow read,write,file_inherit\" team", output: none)
#session("ls -lde team", output: "drwxr-xr-x+ 2 ghazi  staff  64 Jul 23 18:07 team
 0: user:ghazi allow list,add_file,file_inherit")

توقّف عند مفاجأةٍ صغيرةٍ في السطر: كتبتَ `read,write` فقرأتَ `list,add_file`. ذلك أنّ `read` و`write` إذنا *ملفّ* لا إذنا مجلّد، فترجمهما `chmod` إلى مقابليهما على المجلّد وحفظ الأصل للوراثة. والدليل في أوّل ملفٍّ يولد هناك:

#session("ls -le team/a.txt", output: "-rw-r--r--+ 1 ghazi  staff  0 Jul 23 18:07 team/a.txt
 0: user:ghazi inherited allow read,write")

لاحظ كلمة `inherited` في المُدخَلة: النظام يخبرك صراحةً أنّ هذه القاعدة لم تُكتَب هنا، بل وُرِثت من المجلّد الأب. وبهذا تبني مجلّد فريقٍ تُطبَّق سياستُه على كلّ ما يُنشأ فيه مستقبلًا دون تدخّلٍ يدويّ. والوراثة تسري على المولود بعد وضع القاعدة لا على ما وُلد قبلها، فرتّب مجلّدك أوّلًا ثمّ املأه.

#note[
  دقّةٌ تُوفّر عليك حيرة: لا يعرض `ls -l` إلّا علامةً واحدةً بعد كتلة الأذون. فإن اجتمعت على العنصر سماتٌ ممتدّةٌ وقائمةُ ACL *معًا*، ظهرت `@` وحدها واختفت `+`. فلا تظنّ أنّ القائمة زالت؛ وافحص دائمًا بالخيارين معًا: `ls -le@`.
]

#try-it[
  في مجلّدٍ تجريبيّ: أنشئ `touch rep.txt` وافحصه بـ`ls -le` (لا مُدخَلات بعد، ولا علامة `+`). أضف مُدخَلة سماحٍ أوّلًا: `chmod +a "$(whoami) allow write,delete" rep.txt`، وأعد `ls -l` لترى `+` وقد ظهرت، ثمّ `ls -le` لترى المُدخَلة `0`. الآن أضف مُدخَلة منعٍ `chmod +a "everyone deny delete" rep.txt` وأعد `ls -le`: أين استقرّت المُدخَلة الجديدة، وقد كتبتَها أخيرًا؟ ثمّ حاول `rm rep.txt` وتأمّل الرفض رغم ملكيّتك للملفّ ورغم `delete` التي منحتَها لنفسك. احذف مُدخَلة المنع وحدها بـ`chmod -a# 0 rep.txt` وأعد `rm`: نجح هذه المرّة. لقد رأيتَ بعينك كيف تُقرأ القائمة من أعلاها ولماذا يقدّم ماك المنع.
]

#subsection[`chflags`: رايةٌ تعلو على المالك]

الطبقة الثالثة *رايةٌ* تُغرَز في العنصر فتقيّده بغضّ النظر عن أذونه وعن مالكه. وقد صافحتَ الرايات في فصل شجرة نظام ماك حين نزعتَ راية `hidden` عن مكتبتك؛ وهنا نبلغ أعمقها أثرًا. تُقرأ الرايات بالخيار `-O` (بحرف `O` الكبير) وتُضبَط بأمر `chflags`:

#session("chflags uchg a.txt", output: none)
#session("ls -lO a.txt", output: "-rw-r--r--  1 ghazi  staff  uchg 0 Jul 23 18:04 a.txt")
#session("rm a.txt", output: "rm: a.txt: Operation not permitted")

الراية `uchg` اختصار user immutable أي «غير قابلٍ للتغيير»، وهي ما يقابل خانة «مقفَل» في نافذة «عرض المعلومات» بالواجهة الرسوميّة. تأمّل السطر: الأذون `rw-r--r--` تقول إنّ المالك يكتب، والمالك أنت، ومع ذلك رُفض الحذف — لأنّ الراية تعلو على الأذون. وتفكّها بـ`chflags nouchg a.txt`، فالبادئة `no` تنزع أيّ راية كما رأيت في `nohidden`.

وأبعدُ الرايات أثرًا في جهازك رايةٌ لا تضعها أنت ولا تنزعها: `restricted`، وهي ختمُ حماية تكامل النظام (SIP) الذي تضعه Apple على مجلّدات النظام. ولأنّ سطر `ls -lO` يطول على مجلّدات النظام، اسأل عن الرايات وحدها بأداة `stat` وصيغتها `-f` التي تنتقي الحقول التي تريدها فحسب — `%N` للاسم و`%Sf` للرايات نصًّا:

#session("stat -f '%N: %Sf' /System /usr", output: "/System: restricted
/usr: restricted,hidden")

هذه الراية لا يزيلها حتى `root` نفسه ما دامت الحماية مفعّلة، ولها فصلٌ خاصٌّ هو فصل sudo والجذر وحماية SIP؛ فاكتفِ الآن بأن تعرف معنى الكلمة إذا رأيتَها.

#subsection[TCC: حين تكون الأذون صحيحةً ويُرفَض الوصول]

وصلنا إلى الفخّ الذي يحيّر كلَّ مستخدم ماك، والذي لا نظير له على لِينُكس البتّة. جرّب هذا الأمر في طرفيّتك:

#session("ls ~/Library/Mail", output: "ls: /Users/ghazi/Library/Mail: Operation not permitted")

توقّف وتأمّل الموقف: المجلّد داخل مجلّد منزلك، وأنت مالكه، وأذونه `drwx------` أي أنّ لك وحدك كلَّ شيءٍ فيه، ومع ذلك رُدِدتَ. فأذونك سليمةٌ مئةً في المئة، ولا قائمةَ ACL تمنعك، ولا رايةَ `uchg` عليه. البوّابة التي ردّتك هي الرابعة والأخيرة، واسمها TCC.

#define("TCC (الشفافية والموافقة والتحكّم)", [
  اختصار Transparency, Consent, and Control: طبقةُ خصوصيّةٍ في ماك تحرس فئاتٍ من بياناتك (البريد، والرسائل، والصور، وجهات الاتّصال، وسطح المكتب والمستندات، والكاميرا والميكروفون) وتسأل *أيُّ تطبيقٍ يطلبها*، لا *أيُّ مستخدمٍ يطلبها*. فالإذن هنا مربوطٌ بالبرنامج، لا بهويّتك.
])

وهذا هو مفتاح الفهم كلِّه: الطبقات السابقة كلُّها تسأل «مَن أنت؟»، وTCC وحده يسأل «بأيّ تطبيقٍ جئت؟». والطرفية عنده تطبيقٌ كسائر التطبيقات، لا يمنحها أحدٌ امتيازًا لأنّها طرفية. فحين تكتب `ls` داخل Terminal، فالسائل في نظر TCC هو *تطبيق Terminal*، وإن لم يكن مأذونًا له رُدَّ وإن كنتَ أنت المالك.

والعلاج ليس `chmod` ولا `sudo` — ولن ينفعك `sudo` هنا شيئًا — بل موافقةٌ تُعطى مرّةً واحدةً من الواجهة الرسوميّة: افتح «إعدادات النظام»، ثمّ «الخصوصية والأمان»، ثمّ «الوصول الكامل إلى القرص»، وفعّل تطبيق الطرفية الذي تستعمله، ثمّ أغلقه وأعد فتحه ليسري الإذن. بعدها ينجح الأمر نفسه دون أن تغيّر حرفًا واحدًا في أذون الملفّ.

#warn[
  علامةٌ فارقةٌ تُشخّص لك المشكلة في ثانية، فاحفظها: رسالة `Permission denied` تعني أنّ *الأذون أو ACL* ردّتك، فعالِجها بـ`chmod` أو افحصها بـ`ls -le`. أمّا رسالة `Operation not permitted` فتعني أنّ *طبقةً أعلى* ردّتك: رايةٌ من `chflags`، أو حماية SIP، أو TCC. فإن رأيت الرسالة الثانية فلا تُضِع وقتك في `chmod`؛ ابحث في الرايات والخصوصيّة.
]

#try-it[
  نفّذ `ls -ld ~/Library/Mail` أوّلًا: سترى أنّك المالك وأنّ الأذون كاملةٌ لك. ثمّ نفّذ `ls ~/Library/Mail`. فإن نجح فطرفيّتك مأذونٌ لها بالوصول الكامل للقرص من قبل؛ وإن رُدِدتَ برسالة `Operation not permitted` فقد رأيتَ TCC بعينك. افتح حينها إعدادات الخصوصيّة وامنح الإذن، ثمّ أعد فتح الطرفية وأعد الأمر. لاحظ أنّك لم تلمس أذون الملفّ ولا مرّةً واحدة.
]

#distro[
  على لِينُكس تتوزّع هذه الطبقات على أدواتٍ أخرى مختلفةِ الأسماء والفلسفة. فقوائم ACL موجودةٌ لكنّها بنموذج POSIX الأفقر: تُقرأ بـ`getfacl` وتُكتب بـ`setfacl`، ولا تعرف `deny` صراحةً ولا الأذون الدقيقة مثل `writeattr` و`chown`. والراياتُ يقابلها على نظام ملفّات ext4 أمرا `lsattr` و`chattr` (فالراية `+i` تشبه `uchg`). وأمّا التحكّم الإجباريّ فتؤدّيه أنظمةٌ مثل SELinux على فيدورا وAppArmor على أوبونتو، وهي تقيّد *البرامج* لا المستخدمين كما يفعل TCC، لكنّها تُضبَط بسياساتٍ نصيّةٍ يكتبها مدير النظام لا بمفتاحٍ في نافذة إعدادات. ولا وجود على لِينُكس لشيءٍ يشبه سمة الحجر الصحّيّ `com.apple.quarantine`؛ فالثقة هناك مبنيّةٌ على توقيع مستودعات الحزم، لا على وسم كلّ ملفٍّ نازلٍ على حِدة.
]

#section[خلاصة الفصل]

صارت بطاقةُ كلِّ ملفٍّ مقروءةً بين يديك. تقرأ محارف `ls -l` العشرة: نوعًا ثمّ ثلاثيّاتٍ للمالك والمجموعة والآخرين. وتعرف أنّ `r` و`w` و`x` تنقلب معانيها على المجلّد، فـ`r` فهرسُه و`x` مفتاحُ بابه. وتضبط الأذون بـ`chmod` رمزيًّا وعدديًّا وتحسب الثمانيّ في رأسك، وتنقل الملكيّة بـ`chown` و`chgrp` عالمًا متى يلزمك `sudo`، وتفهم من أين جاء `644` عبر `umask`، وتميّز البتّات الخاصّة الثلاث ولماذا كان `/tmp` لاصقًا.

ثمّ صعدتَ فوق يونِكس إلى ما ينفرد به ماك: العلامة `@` وسمةُ الحجر الصحّيّ التي تفسّر رفضَ تشغيل ما نزّلته، والعلامة `+` وقوائمُ ACL الغنيّة بنموذج NFSv4 — بأذونها الدقيقة، وترتيبها القانونيّ الذي يقدّم المنع على المنح، ووراثتها التي تحكم مجلّدًا كاملًا بسطرٍ واحد — ورايةُ `chflags` التي تعلو على المالك، وحاجزُ TCC الذي يسأل عن تطبيقك لا عن هويّتك. وخرجتَ بقاعدةٍ تشخيصيّةٍ واحدةٍ تختصر الفصل كلَّه: `Permission denied` تعالجها بـ`chmod` وتفحصها بـ`ls -le`، و`Operation not permitted` تبحث لها في طبقةٍ أعلى. وقد لاحظتَ أنّ كثيرًا من أفعال هذا الفصل توقّف عند عتبةٍ واحدة: سلطةُ المدير. وهي بالضبط موضوع الفصل التالي: `sudo` والجذر وحماية تكامل النظام.

#challenge[
  ثلاث مسائل، كلُّها في مجلّدٍ تجريبيٍّ تنشئه ثمّ تحذفه:

  (1) أنشئ ملفًّا `report.txt` واضبط أذونه بحيث يقرأه ويكتبه المالك، وتقرأه المجموعة فقط، ولا يملك الآخرون شيئًا — اكتب الأمر بالصيغتين الرمزيّة والعدديّة، وتحقّق بـ`ls -l` أنّ السطر واحدٌ في الحالتين. ثمّ اقلب السؤال: أيّ قناع `umask` يجعل هذه الأذون هي الافتراض لكلّ ملفٍّ جديد؟

  (2) نزّل ملفًّا أيًّا كان من متصفّحك، وافحصه بـ`ls -l@` ثمّ بـ`xattr -l`: أيُّ برنامجٍ أنزله بحسب سجلّ الحجر الصحّيّ؟ وأيّ حقلٍ من حقول السمة الأربعة قرأتَ منه الجواب؟

  (3) اختبار الطبقات الثلاث: أنشئ ثلاثة ملفّاتٍ متطابقة، ثمّ ضع على الأوّل `chflags uchg`، وعلى الثاني `chmod 000`، وعلى الثالث `chmod +a "everyone deny delete"`. حاول الآن حذف كلٍّ منها بـ`rm` وسجّل ما جرى حرفيًّا. ستجد ثلاثة أجوبةٍ لا جوابين: رايةٌ تردّك، وقائمةٌ تردّك، وملفٌّ ذو أذونٍ صفريّةٍ *يُحذَف فعلًا* بعد سؤالِ توكيدٍ لم تطلبه. فسّر حالة الملفّ المحذوف بالاستعانة بما قرأتَه عن معنى `w` على المجلّد لا على الملفّ، ثمّ افتح `man rm` واقرأ أوّل فقرةٍ في `DESCRIPTION` لتعرف متى يسأل `rm` سؤالَ التوكيد ولماذا. وأخيرًا قارن نصَّ الرفضَين: أيُّهما `Permission denied` وأيُّهما `Operation not permitted`؟ وماذا يخبرك ذلك عن الطبقة التي تسكنها ACL؟
]
