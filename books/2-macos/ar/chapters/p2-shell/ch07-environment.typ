#chapter[البيئة وتخصيص zsh]

#objectives((
  [تفهم معنى «متغيّر البيئة»، وكيف تقرؤه وتضبطه، وكيف يورَّث للبرامج التي تشغّلها.],
  [تعرف كيف تجد الصدفةُ الأوامرَ عبر متغيّر `PATH`، وكيف تضيف إليه أدواتك.],
  [تميّز ملفّات zsh الأربعة — `.zshenv` و`.zprofile` و`.zshrc` و`.zlogin` — ومتى يُقرأ كلٌّ منها.],
  [تصنع أسماءً مستعارة تختصر أوامرك الطويلة.],
  [تعيد تصميم المحثّ `PROMPT` بلونٍ ومعلوماتٍ على ذوقك.],
))

حين يلتحق موظّفٌ جديدٌ بشركة، لا يُترك في العراء. يُعطى بطاقةَ دخول، ومكتبًا له عنوان، وقائمةَ أرقامٍ يتّصل بها، ومجموعةً من قواعد المكان. هذه «البيئة» التي يعمل ضمنها تحدّد ما يستطيع الوصولَ إليه وكيف يتصرّف. كلُّ برنامجٍ تشغّله من الصدفة يولد كذلك داخل بيئة: مجموعةٌ من القيم الجاهزة يرثها فور ولادته، تخبره من أنت، وأين مجلد بيتك، وأين يبحث عن الأدوات. في هذا الفصل نفتح هذه البيئة، ونضبطها، ونطوّع صدفة zsh لتكون على مقاسك.

#section[متغيّرات البيئة: ذاكرة الصدفة]

الصدفة لا تحفظ الأوامر فحسب، بل تحفظ *قيمًا* مسمّاة تعود إليها متى احتاجتها. القيمة المسمّاة تُدعى متغيّرًا: اسمٌ تقرنه بقيمةٍ تفصل بينهما علامةُ المساواة. وبعض هذه المتغيّرات مشتركٌ بين الصدفة وكلّ برنامجٍ تشغّله منها، فسُمّي «متغيّر البيئة».

#define("متغيّر البيئة (Environment Variable)", [
  قيمةٌ مسمّاةٌ تحفظها الصدفة وتورّثها لكلّ برنامجٍ يُشغَّل منها. أمثلتها: `HOME` (مسار مجلد بيتك)، و`USER` (اسم مستخدمك)، و`SHELL` (مسار صدفتك). تُكتب أسماؤها بالحروف الكبيرة عُرفًا.
])

لقراءة قيمة متغيّرٍ، ضع علامة الدولار قبل اسمه. الأمر `echo` يطبع ما بعده، فإن أعطيته `$HOME` طبع القيمة لا الاسم:

```zsh
echo $HOME       # /Users/ghazi
echo $USER       # ghazi
echo "أهلًا يا $USER"   # أهلًا يا ghazi
```

ولرؤية بيئتك كاملةً، استعمل `printenv` (اطبع البيئة) أو `env` وحدها:

```zsh
printenv           # يسرد كل متغيّرات البيئة سطرًا سطرًا
printenv HOME      # يطبع قيمة متغيّرٍ واحد
```

#note[
  الفرق بين علامتَي الاقتباس مهمّ: `"$USER"` بين علامتَين مزدوجتين تُستبدَل بقيمتها، أمّا `'$USER'` بين علامتَين مفردتين فتبقى نصًّا حرفيًّا كما هي. المزدوجة «تفتح الباب» للقيم، والمفردة «تقفله».
]

#try-it[
  افتح الطرفية ونفّذ: `echo $HOME`، ثم `echo $SHELL`، ثم `printenv | head`. هل يظهر `SHELL` منتهيًا بـ `zsh`؟ إن كان كذلك فأنت على الصدفة الافتراضية في ماك.
]

#section[من متغيّرٍ خاصٍّ إلى بيئةٍ موروثة: export]

ليست كلُّ المتغيّرات موروثة. حين تكتب `name=Ghazi`، تصنع متغيّرًا يخصّ صدفتك وحدها؛ لو شغّلتَ برنامجًا فلن يراه. لتجعله جزءًا من البيئة الموروثة، «صدّره» بالأمر `export`.

#define("التصدير (export)", [
  أمرٌ يرفع متغيّرًا من كونه خاصًّا بالصدفة الحالية إلى كونه متغيّرَ بيئةٍ يرثه كلُّ برنامجٍ تشغّله بعده. `export name=Ghazi` يصنع المتغيّر ويصدّره في خطوة.
])

الصورة أوضح بتشبيه: المتغيّر غير المصدَّر ملاحظةٌ على مكتبك أنت، يراها من يجلس مكانك. أمّا المصدَّر فبطاقةُ هويّةٍ تُعطى نسختُها لكلّ «ابنٍ» ترسله في مهمّة — أي لكلّ برنامجٍ تشغّله:

```zsh
greeting=مرحبا        # متغيّر صدفةٍ خاصّ (غير مصدَّر)
export EDITOR=nano    # متغيّر بيئةٍ موروث: يخبر البرامج أيّ محرّرٍ تفتح
```

المتغيّر `greeting` هنا لن تراه البرامجُ الأبناء؛ أمّا `EDITOR` فسيقرؤه كلُّ برنامجٍ يحتاج أن يفتح لك محرّرًا (مثل `git`). لكن انتبه: هذا التصدير يعيش ما دامت نافذة الطرفية مفتوحة فقط. أغلقتَها فذهب. لجعله دائمًا نضعه في ملفّ إعدادٍ يُقرأ عند كلّ بدء — وهذا موضوع القسمين التاليين.

#try-it[
  نفّذ `export EDITOR=nano` ثم `echo $EDITOR`. الآن أغلق الطرفية وافتحها من جديد وأعد `echo $EDITOR` — ستجده فارغًا. هكذا تثبت بنفسك أنّ التصدير مؤقّت حتى تحفظه في ملفّ.
]

#section[كيف تجد الصدفةُ الأوامر؟ متغيّر PATH]

حين تكتب `ls`، كيف تعرف الصدفة أين برنامج `ls` بين آلاف الملفّات؟ لا تبحث في القرص كلّه، بل تنظر في قائمةٍ قصيرةٍ من المجلّدات محفوظةٍ في متغيّرٍ اسمه `PATH`. تمرّ عليها بالترتيب، وأوّل مجلدٍ يحوي البرنامج تنفّذه منه.

#define("المسار (PATH)", [
  متغيّر بيئةٍ يحوي قائمة مجلّداتٍ تفصل بينها النقطتان `:`، تبحث فيها الصدفةُ عن البرامج بالترتيب من اليسار إلى اليمين. أوّل تطابقٍ يفوز.
])

اطبع مسارك، واسأل الصدفة من أين تأتي بأمرٍ معيّن عبر `which`:

```zsh
echo $PATH
# /opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

which ls        # /bin/ls  ← من هنا يأتي ls
which brew      # /opt/homebrew/bin/brew
```

لإضافة مجلدٍ فيه أدواتُك الخاصّة، أَلحِقه بالقائمة القديمة دون أن تمحوها. لاحظ `$PATH` القديمة داخل القيمة الجديدة:

```zsh
export PATH="$HOME/bin:$PATH"   # يضيف ~/bin في مقدّمة البحث
```

#warn[
  الخطأ الأشهر: كتابة `export PATH="$HOME/bin"` بلا `:$PATH` في آخرها. هذا يمحو القائمة كلَّها ويُبقي مجلدك وحده، فتتوقّف أوامرُ مثل `ls` و`git` عن العمل في هذه النافذة لأنّ الصدفة لم تعد تعرف أين تجدها. أعد ذكر `$PATH` دائمًا لتحافظ على ما كان.
]

على ماك تحديدًا، ثمّة آليّةٌ تبني `PATH` الأساسيّة قبل ملفّاتك: أداةٌ اسمها `path_helper` تقرأ ملفّ `/etc/paths` وملفّات مجلد `/etc/paths.d`، ويستدعيها ملفُّ نظامٍ اسمه `/etc/zprofile` عند كلّ تسجيل دخول. لهذا يُنصح بإضافة مساراتك في `.zprofile` أو `.zshrc` لا في `.zshenv`، وإلّا قد يعيد `path_helper` ترتيبَ مسارك ويقدّم مسارات النظام على مسارك.

كذلك حين تثبّت Homebrew (مدير الحزم على ماك)، يطلب منك إضافة سطرٍ يهيّئ بيئته ومسارَه:

```zsh
# على معالجات Apple Silicon (M1 فأحدث)
eval "$(/opt/homebrew/bin/brew shellenv)"
# على معالجات Intel القديمة يكون المسار /usr/local بدلًا منه
```

#distro[
  على لِينُكس وBSD لا وجود لـ `path_helper`؛ تُبنى `PATH` من ملفّات النظام مثل `/etc/profile` و`/etc/environment`. أمّا فكرة `PATH` نفسها فمتطابقةٌ في كلّ أنظمة يونِكس حرفًا حرفًا: قائمةُ مجلّداتٍ تفصلها النقطتان.
]

#try-it[
  نفّذ `which -a python3` (الخيار `-a` يُظهر كلّ التطابقات لا الأوّل فقط). كم نسخةً على جهازك؟ ثم أنشئ مجلدًا `mkdir -p ~/bin`، وأضِفه إلى مسارك بالسطر أعلاه، وتأكّد عبر `echo $PATH`.
]

#section[ملفّات zsh: متى يُقرأ كلُّ ملفّ؟]

لكي تدوم إعداداتك بعد إغلاق الطرفية، تضعها في ملفّاتٍ نصّيةٍ في مجلد بيتك تقرؤها zsh آليًّا عند بدئها. لكنّ zsh لا تقرؤها كلَّها دائمًا؛ الأمر يتوقّف على *نوع* الصدفة التي بدأت. فلنعرّف النوعين أوّلًا.

#define("صدفة الدخول (Login Shell)", [
  الصدفة التي تبدأ عند تسجيل دخولك، وتقرأ ملفّات «التهيئة الأولى» كـ `.zprofile`. في ماك، تطبيق Terminal وiTerm2 يفتحان صدفة دخولٍ في كلّ نافذةٍ جديدة افتراضيًّا.
])

#define("الصدفة التفاعليّة (Interactive Shell)", [
  الصدفة التي تجلس أمامها تكتب وتقرأ الردود مباشرة، وتقرأ ملفّ `.zshrc`. أغلب نوافذ طرفيّتك تفاعليّةٌ وصدفةُ دخولٍ في آنٍ واحد.
])

وهذه خريطة الملفّات الأربعة وترتيب قراءتها:

#table(
  columns: (auto, 1fr),
  align: (right, right),
  table.header([الملفّ], [متى يُقرأ وماذا تضع فيه]),
  [`.zshenv`],  [يُقرأ *دائمًا* في كلّ صدفةٍ (حتى السكربتات غير التفاعليّة). للمتغيّرات القليلة التي يجب أن تراها كلُّ الأدوات. اتركه خفيفًا.],
  [`.zprofile`], [يُقرأ مرّةً عند صدفة الدخول، قبل `.zshrc`. للأشياء التي تُهيَّأ مرّةً: `PATH`، وتهيئة Homebrew.],
  [`.zshrc`],   [يُقرأ في كلّ صدفةٍ تفاعليّة. هنا يعيش أغلب تخصيصك: الأسماء المستعارة، والمحثّ، والدوال.],
  [`.zlogin`],  [يُقرأ عند صدفة الدخول، بعد `.zshrc`. نادرُ الاستعمال؛ لأوامرَ تريدها آخرَ ما يُنفَّذ.],
)

فالترتيب عند فتح نافذةٍ جديدة على ماك: `.zshenv` ثمّ `.zprofile` ثمّ `.zshrc` ثمّ `.zlogin`. القاعدة العمليّة البسيطة: ضع متغيّرات البيئة و`PATH` في `.zprofile`، وضع كلَّ ما تراه وتلمسه (الأسماء المستعارة والمحثّ) في `.zshrc`. وإن حرت، فـ `.zshrc` هو الملفّ الذي ستعدّله 90٪ من الوقت.

بعد أيّ تعديلٍ للملفّ، لا حاجة لإغلاق الطرفية؛ أعد قراءته في مكانه بالأمر `source`:

```zsh
source ~/.zshrc     # يطبّق التعديلات فورًا في النافذة الحالية
# أو باختصارٍ مكافئ:
. ~/.zshrc
```

#danger[
  انتبه لعلامة إعادة التوجيه حين تكتب في الملفّ من الطرفية: السهم المفرد `>` *يمحو الملفّ كلَّه* ويستبدله بالسطر الجديد، فتفقد إعداداتك دفعةً واحدة. المزدوج `>>` هو الذي *يُلحِق* في آخر الملفّ دون محو. فاكتب دائمًا `echo '...' >> ~/.zshrc` بسهمين، لا بسهمٍ واحد.
]

#distro[
  الأسماء نفسها موجودةٌ على لِينُكس وBSD، لكنّ الفرق الجوهريّ: أغلب طرفيّات لِينُكس تفتح صدفةً تفاعليّةً *غير* صدفة دخول، فتقرأ `.zshrc` وحده وتتجاهل `.zprofile`. في ماك تفتح Terminal صدفةَ دخولٍ فتقرأ الاثنين. لهذا قد «يعمل» إعدادك على ماك ولا يعمل على لِينُكس إن وضعتَه في الملفّ الخطأ.
]

#try-it[
  افتح `.zshrc` بمحرّرٍ: `nano ~/.zshrc`. أضف في آخره سطرًا: `echo "أهلًا يا $USER"`. احفظ (#kbd("Ctrl") + #kbd("O") ثم #kbd("Ctrl") + #kbd("X"))، ثم `source ~/.zshrc`. هل ظهرت التحيّة؟ افتح نافذةً جديدة لتراها ترحّب بك عند كلّ بدء.
]

#section[الأسماء المستعارة: اختصر أوامرك]

إن كنت تكتب أمرًا طويلًا مرارًا، فامنحه اسمًا قصيرًا من عندك. هذا هو «الاسم المستعار»: كلمةٌ تختارها تنوب عن أمرٍ كامل.

#define("الاسم المستعار (Alias)", [
  اسمٌ قصيرٌ تعرّفه ليكون اختصارًا لأمرٍ أطول. حين تكتبه، تستبدله الصدفةُ بالأمر الكامل قبل تنفيذه.
])

تُعرَّف الأسماء المستعارة بالأمر `alias`، وتوضع في `.zshrc` لأنها للاستعمال التفاعليّ:

```zsh
alias ll='ls -lah'        # قائمةٌ مفصّلةٌ تشمل المخفيّة وبأحجامٍ مقروءة
alias gs='git status'     # حالة المستودع بحرفين
alias ..='cd ..'          # اصعد مجلدًا للأعلى
```

بعد وضعها في `.zshrc` وإعادة قراءته، اكتب `ll` فتنفّذ `ls -lah`. ولحذف اسمٍ في الجلسة الحالية استعمل `unalias ll`. ولرؤية كلّ أسمائك المعرّفة، اكتب `alias` وحدها.

#tip[
  إن أردت تنفيذ الأمر الأصليّ متجاوزًا الاسم المستعار مرّةً واحدة، فضع قبله شَرطةً مائلة: `\ls` يشغّل `ls` الأصليّ لا اسمك المستعار له. مفيدٌ حين تعرّف اسمًا مستعارًا بنفس اسم الأمر الأصليّ.
]

#try-it[
  أضف إلى `.zshrc` اسمًا مستعارًا يعجبك — مثلًا `alias week='date +%V'` ليطبع رقم أسبوع السنة. أعد قراءة الملفّ وجرّبه. ثم اكتب `alias` وحدها لتستعرض قائمتك كلَّها.
]

#section[تخصيص المحثّ: PROMPT]

المحثّ هو النصّ الذي تعرضه الصدفة قبل كلّ سطرٍ تكتبه — الرمز الذي رأيته ينتظرك. في zsh يتحكّم فيه متغيّرٌ اسمه `PROMPT`، ويمكنك إعادة تصميمه بالكامل: أن يُظهر اسمك، ومجلدك الحالي، وبألوان.

#define("المحثّ (PROMPT)", [
  النصّ الذي تطبعه zsh في بداية كلّ سطرٍ لتقول «أنا مستعدّة». قيمته محفوظةٌ في المتغيّر `PROMPT`، وتُبنى من «رموز نسبة» خاصّةٍ بـ zsh تبدأ كلٌّ منها بعلامة `%`.
])

رموز zsh للمحثّ تختلف عن رموز صدفة bash؛ إليك أشهرها: `%n` اسم المستخدم، و`%m` اسم الجهاز المختصر، و`%~` المجلد الحالي مع اختصار البيت إلى `~`، و`%#` تطبع `#` إن كنت مديرًا و`%` لغيره. وللألوان `%F{اللون}` تفتح لونًا و`%f` تغلقه:

```zsh
# محثٌّ بسيط: مستخدم@جهاز ثم المجلد ثم الرمز
PROMPT='%n@%m %~ %# '

# محثٌّ ملوّن: الاسم أخضر والمجلد أزرق
PROMPT='%F{green}%n%f %F{blue}%~%f %# '
```

يمكنك كذلك وضع معلوماتٍ في يمين الشاشة عبر `RPROMPT`، مثل الوقت الحاليّ برمز `%*`:

```zsh
RPROMPT='%F{242}%*%f'    # الوقت بلونٍ رماديٍّ خافت على اليمين
```

ضع سطر `PROMPT` في `.zshrc` ليدوم. جرّب قيمًا مختلفةً مباشرةً في الطرفية أوّلًا لتراها فورًا، فإذا أعجبتك انقلها إلى الملفّ.

#warn[
  لا تخلط رموز bash برموز zsh. في bash يُكتب المستخدم `\u` والمجلد `\w`، أمّا في zsh فهي `%n` و`%~`. لو نسخت محثَّ bash إلى zsh، ستظهر لك الرموز نصًّا حرفيًّا لأنها بلغةٍ أخرى. رموز zsh تبدأ بـ `%` دائمًا.
]

#try-it[
  جرّب في الطرفية مباشرةً: `PROMPT='%F{magenta}%~%f %# '`. تغيّر محثّك حالًا؟ بدّل `magenta` بـ `cyan` أو `yellow`. حين ترضى، أضف السطر إلى `.zshrc` ليبقى بعد إغلاق النافذة.
]

#section[خلاصة الفصل]

تعلّمت أنّ لكلّ برنامجٍ بيئةً يرثها عند ولادته: متغيّراتٌ مسمّاةٌ تقرؤها بعلامة الدولار، وتحوّلها إلى موروثةٍ بالأمر `export`. وعرفت أنّ `PATH` هو دليل الصدفة إلى الأوامر، وأنّ على ماك تبنيه أداةُ `path_helper` عبر `/etc/zprofile`. وميّزت ملفّات zsh الأربعة: `.zshenv` يُقرأ دائمًا، و`.zprofile` عند الدخول، و`.zshrc` في كلّ صدفةٍ تفاعليّة وهو ملفّك الأكثر تعديلًا، و`.zlogin` أخيرًا. وأخيرًا صنعت أسماءً مستعارةً تختصر أوامرك، وأعدت تصميم محثّك بلونٍ ومعلوماتٍ على ذوقك. صار للطرفية طابعُك أنت. في الفصل التالي نبني على هذا لنكتب أوّل سكربتاتنا التي تؤتمت العمل المتكرّر.

#challenge[
  اجمع ما تعلّمته في ملفّ `.zshrc` واحد: أضف مسار `~/bin` إلى `PATH` (في `.zprofile`)، وعرّف ثلاثة أسماءٍ مستعارةٍ تفيدك، واضبط `PROMPT` ملوّنًا يُظهر مجلدك الحالي، وصدّر `EDITOR`. ثم أغلق الطرفية وافتحها من جديد: هل بقي كلُّ شيءٍ كما ضبطته؟ وأخيرًا، خمّن قبل أن تجرّب: أين ستضع متغيّرًا تريد أن تراه حتى السكربتات غير التفاعليّة — في `.zshrc` أم `.zshenv`؟ ولماذا؟
]
