#chapter[ما الطرفية على ماك؟]

#objectives((
  [تفهم أنّ ماك ليس عالمًا منعزلًا، بل نظام *يونِكس* معتمَد يشترك مع لِينُكس وBSD في جذرٍ واحد.],
  [تميّز بين ثلاث كلماتٍ يخلط بينها كثيرون: النواة، والصدفة، والطرفية.],
  [تفتح تطبيق Terminal على ماك، وتعرف أنّ صدفتك الافتراضيّة اسمها zsh.],
  [تكتب أوّل أمرٍ في حياتك، وتقرأ «تشريح الأمر»: الفعل، والخيار، والمُعطى.],
))

قد تظنّ أنّ جهاز ماك الأنيق الذي بين يديك عالمٌ مغلقٌ خاصٌّ بشركة Apple وحدها: أيقوناتٌ ملوّنة، ونوافذ تنساب بسلاسة، وكلُّ شيءٍ يُدار بالفأرة والنقر. لكنْ تحت هذه البذلة الأنيقة يخفق قلبٌ عتيقٌ متينٌ عمره عقود: قلب *يونِكس*، النظام نفسه الذي يشغّل خوادم الإنترنت وحواسيب الجامعات منذ السبعينيّات. الطرفيةُ هي البابُ الذي تفتحه لتصافح هذا القلب مباشرة، دون وسيط الفأرة. وحين تتعلّم مخاطبته، فأنت لا تتعلّم حيلةً خاصّةً بماك، بل لغةً تعمل على لِينُكس وBSD كذلك.

#section[ماك نظام يونِكس في جوهره]

لنبدأ بالمفاجأة التي يجهلها كثيرٌ من مستخدمي ماك: نظام macOS ليس نظامًا فريدًا اخترعته Apple من العدم، بل هو من عائلة *يونِكس* العريقة.

#define("يونِكس (Unix)", [
  نظام تشغيلٍ وُلد في مختبرات Bell عام 1969، ووضع الأسس التي بُنيت عليها معظم أنظمة اليوم: الملفّات والمجلّدات، والصَّدفة، والأوامر النصيّة. لِينُكس وBSD وmacOS كلّها أبناءٌ لفلسفة يونِكس أو أحفادٌ لها.
])

بل إنّ macOS *معتمَدٌ رسميًّا* بوصفه يونِكس: حصل على شهادة «UNIX» من منظّمة The Open Group، وهي الجهة المالكة للعلامة. هذا يعني أنّ ماك ليس مجرّد نظامٍ «يشبه» يونِكس، بل يونِكسٌ أصيلٌ بالمعنى القانونيّ والتقنيّ معًا — وهذا شرفٌ لا يحمله لِينُكس نفسه (فلِينُكس «شبيهٌ بيونِكس» لكنه غير معتمَد).

#subsection[الاسم السرّيّ: Darwin]

لِبّ macOS، أي الطبقة الأساسيّة التي تعمل تحت الواجهة الرسوميّة، له اسمٌ خاصّ: *Darwin*. وDarwin نظامٌ مفتوح المصدر بناه مهندسو Apple، وورث جزءًا كبيرًا من أدواته وسلوكه من عائلة *BSD*.

#define("BSD", [
  عائلةٌ من أنظمة يونِكس نشأت في جامعة كاليفورنيا في بيركلي (‏Berkeley Software Distribution). منها تُشتقّ اليوم أنظمةٌ مثل FreeBSD وOpenBSD. وأدوات ماك في الطرفية تتبع تقاليد BSD، لا تقاليد *GNU* — وهي مجموعة الأدوات الحرّة التي يقوم عليها نظام لِينُكس.
])

هذا الأصل ليس تفصيلًا تاريخيًّا نتزيّن به، بل له أثرٌ عمليٌّ ستلمسه بيدك: بعض الأوامر على ماك تتصرّف تصرّفًا مختلفًا قليلًا عمّا تجده في كتب لِينُكس، لأنّ نسخة ماك «بِرْكليّة» (BSD) بينما نسخة لِينُكس «غْنُويّة» (GNU). سنخصّص لهذا الفرق فصلًا كاملًا لاحقًا؛ يكفيك الآن أن تعرف من أين يأتي.

#note[
  حين تسمع مستخدمي لِينُكس يتحدّثون عن أوامر مثل `ls` و`grep` و`ssh`، فهم يتحدّثون عن الأدوات نفسها التي على ماك. الجذر واحد. ما تتعلّمه هنا رصيدٌ يونِكسيٌّ مشترك، لا مهارةً معزولةً في جزيرة Apple.
]

#section[ثلاث كلماتٍ لا تخلط بينها: النواة والصدفة والطرفية]

تخيّل مطعمًا فخمًا. أنت لا تدخل المطبخ لتطبخ، بل تخبر النادلَ بما تريد، فينقل طلبك إلى الطبّاخ، ويعود إليك بالطبق. هذا التقسيم نفسه هو ما يجري في ماك، وفهمه يميّزك عن عامّة المستخدمين.

في أعماق النظام يقبع *الطبّاخ*: برنامجٌ واحدٌ هو الوحيد الذي يلمس العتاد مباشرة — يوزّع المعالج، ويحجز الذاكرة، ويقرأ القرص. اسمه *النواة* (Kernel). ونواة ماك تحمل اسم XNU، وتجمع بين تقنيّتين عريقتين. لكنك لن تخاطب النواة مباشرة أبدًا؛ فهي كالطبّاخ منشغلةٌ ولا تحبّ المقاطعة.

بينك وبين النواة يقف *النادل*: برنامجٌ يأخذ كلماتك، ويفهمها، ويأمر النواة نيابةً عنك، ثم يعود إليك بالجواب. هذا النادل اسمه *الصدفة*.

#define("الصدفة (Shell)", [
  برنامجٌ يقرأ الأوامر التي تكتبها، ويترجمها إلى طلباتٍ للنواة، ثم يعرض لك ما تعيده. سُمّيت «صدفة» لأنها تحيط بالنواة كما تحيط القوقعةُ باللؤلؤة. صدفة ماك الافتراضيّة اليوم اسمها *zsh*.
])

بقيت الطاولةُ التي تجلس إليها لتحدّث النادل. تلك الطاولة هي *الطرفية*.

#define("الطرفية (Terminal)", [
  النافذة التي تُظهر لك الصدفةَ: تكتب فيها أوامرك بلوحة المفاتيح، وتقرأ فيها النتائج. على ماك، التطبيق الذي يفتح هذه النافذة اسمه Terminal، وتجده في مجلّد `/Applications/Utilities`. الطرفيةُ هي الوسيط المرئيّ؛ والصدفةُ هي العقل الذي يعمل خلفها.
])

فالترتيب من الخارج إلى الداخل: أنت تكتب في *الطرفية*، فيقرأ كلامَك *الصدفة* (zsh)، فتأمر *النواة* (XNU)، فتحرّك *العتاد*. أربع طبقاتٍ كأربعة أدوارٍ في المطعم.

#warn[
  الكلمات الثلاث تُستعمل أحيانًا وكأنها مترادفة، وهذا شائع. لكن تذكّر: الطرفيةُ النافذة، والصدفةُ المترجم، والنواةُ المنفّذ. حين يقول أحدهم «افتح الترمنال» فهو يعني التطبيق؛ وحين يقول «في الشِّل» فهو يعني الصدفة التي تعمل داخله.
]

#subsection[أكثر من طرفيةٍ واحدة: iTerm2]

تطبيق Terminal المرفق مع ماك ممتازٌ للبداية، وهو كلُّ ما تحتاجه لتنهي هذا الكتاب. لكنك ستسمع كثيرًا باسم بديلٍ شهيرٍ اسمه *iTerm2*: تطبيق طرفيةٍ مجّانيٌّ من طرفٍ ثالث، يضيف مزايا للمحترفين كتقسيم النافذة إلى ألواح، والبحث في المخرجات، وتخصيصٍ أعمق. المهمّ أن تفهم أنّ iTerm2 وTerminal مجرّد *نوافذ* مختلفة على الصدفة نفسها؛ فالأوامر التي تكتبها لا تتغيّر بينهما البتّة. ابدأ بـTerminal الآن، وأجّل iTerm2 حتى تألف أرضك.

#section[zsh: صدفة ماك الافتراضيّة]

لكلّ نظامٍ صدفةٌ يأتي بها جاهزةً. الصدفة الأشهر تاريخيًّا في عالم يونِكس اسمها *bash*، وهي التي جاء بها ماك سنواتٍ طويلة. لكنّ Apple بدّلتها: منذ إصدار macOS Catalina عام 2019، صارت الصدفة الافتراضيّة الجديدة على كلّ جهاز ماك هي *zsh*.

#define("zsh", [
  صدفةٌ حديثةٌ (اسمها الكامل Z shell) متوافقةٌ في معظمها مع bash، لكنها أغنى: إكمالٌ تلقائيٌّ أذكى للأوامر، وتصحيحٌ للأخطاء الإملائيّة، وتخصيصٌ واسعٌ للمظهر. كلُّ ما تتعلّمه من أوامر يعمل عليها.
])

لا تقلق من هذا التبديل: الأوامر الأساسيّة التي سنتعلّمها — `ls` و`cd` و`grep` وأخواتها — واحدةٌ على bash وzsh معًا. الفروق بين الصدفتين تظهر في التخصيص المتقدّم وكتابة السكربتات، وسنفرد لها فصلًا في الجزء الثاني. أمّا الآن فيكفيك أن تعرف اسم صدفتك. وللتأكّد منه بنفسك أمرٌ لطيف:

```zsh
echo $SHELL      # يطبع مسار صدفتك الافتراضيّة
```

إن كان جهازك حديثًا فستقرأ الجواب `/bin/zsh`. أمّا إن كان قديمًا لم يُحدَّث فقد ترى `/bin/bash` — وكلاهما يسير معنا في هذا الكتاب.

#distro[
  على لِينُكس تكون الصدفة الافتراضيّة غالبًا bash (لا zsh)، وعلى بعض أنظمة BSD تكون صدفةً أخرى اسمها `tcsh` أو `sh`. لكنّ zsh متوفّرةٌ للتثبيت في كلّ هذه الأنظمة؛ فاختيار ماك لها ليس حصرًا عليه، بل تفضيلٌ لصدفةٍ يونِكسيّةٍ متاحةٍ للجميع.
]

#section[أوّل أمرٍ على ماك]

يكفي نظريًّا. لنفتح الطرفية الآن. أسرع طريقٍ هو البحث الفوريّ (Spotlight): اضغط #kbd("Cmd") + #kbd("Space")، ثم اكتب كلمة `Terminal` واضغط #kbd("Enter"). أو افتح مجلّد «التطبيقات» ← «الأدوات» (Utilities)، وانقر أيقونة Terminal.

ستظهر نافذةٌ فيها سطرٌ ينتهي بالرمز `%` ومؤشّرٌ يومض. هذا *المحثّ* (Prompt): الصدفةُ تقول لك «أنا مستعدّة، أَملِ عليّ». وعلى zsh ينتهي المحثّ للمستخدم العاديّ بعلامة `%`؛ فإن رأيته يومًا ينتهي بعلامة `#` فاعلم أنك تعمل بصلاحيّات المدير الكاملة (root) — وهي حالةٌ حسّاسة سنعود إليها.

اكتب الكلمة التالية ثم اضغط #kbd("Enter"):

#session("whoami", output: "abuhaytham")

كلمة `whoami` تعني «مَن أنا؟». أجابت الصدفةُ باسم المستخدم الذي دخلتَ به. مبروك — هذا أوّل حوارٍ لك مع النظام. لنجرّب ثلاثةً أخرى:

```zsh
pwd            # أين أنا الآن؟ (اسم المجلّد الحالي)
date           # كم الساعة وما تاريخ اليوم؟
echo مرحبا     # ردّد ورائي هذه الكلمة
```

#try-it[
  افتح Terminal الآن عبر #kbd("Cmd") + #kbd("Space")، ونفّذ الأوامر الأربعة: `whoami` و`pwd` و`date` ثم `echo` متبوعةً باسمك. لا تكتفِ بالقراءة — اكتبها بيدك وشاهد جواب كلٍّ منها. هذه أوّل لبنةٍ حقيقيّة.
]

#note[
  إن كتبتَ كلمةً لا تعرفها الصدفة، ردّت بـ `command not found` (لم يُعثر على الأمر). لا تقلق؛ ليست كارثة، بل مجرّد أنّ النادل لم يفهم الطلب. صحّح الإملاء وأعد المحاولة.
]

#section[تشريح الأمر: لغةٌ لها قواعد]

قد يبدو كلُّ أمرٍ طلسمًا يُحفظ، لكنّ الحقيقة أجمل: الأوامر *جُمَلٌ* في لغةٍ لها نحو. الجملة الواحدة ثلاثة أركان. انظر هذه:

```zsh
ls -l /Users
```

- الركن الأول `ls` هو *الفعل*: اسم الأمر، أي ما تريد فعله (هنا: اعرض قائمةً بالملفّات).
- الركن الثاني `-l` هو *خيار* (Option): يعدّل سلوك الفعل، ويبدأ غالبًا بشَرطة. هنا يعني «بتفصيلٍ طويل».
- الركن الثالث `/Users` هو *المُعطى* (Argument): الشيء الذي يقع عليه الفعل، وهو هنا المجلّد الذي يضمّ حسابات المستخدمين على ماك.

فالجملة تُقرأ: «اعرض (`ls`) بالتفصيل (`-l`) محتويات مجلّد المستخدمين (`/Users`)». حين تستوعب هذا التقسيم، تتوقّف عن حفظ الأوامر ككتلٍ مصمتة، وتبدأ في *تأليفها*: تتعلّم أفعالًا، وتركّب بها جملك بنفسك. وهذه نقطة التحوّل التي يصير عندها الحاسوبُ طوعَ يدك.

#tip[
  الخيارات القصيرة تبدأ بشَرطةٍ واحدةٍ وحرف (`-l`)، والطويلة بشَرطتين وكلمة (`--verbose`). لكنْ تنبّهْ: كثيرٌ من أدوات ماك البِرْكليّة (BSD) لا تفهم إلّا الشكل القصير، بينما تقبل نظيراتُها الغْنُويّة (GNU) على لِينُكس الشكلين معًا. فإن رفض أمرٌ على ماك خيارًا طويلًا فذلك طبعُه لا خطؤك.
]

#distro[
  هنا يظهر أصل ماك البِرْكليّ عمليًّا. لتلوين ناتج `ls` بحسب نوع الملفّ، تكتب على ماك (BSD): `ls -G`؛ بينما تكتب على معظم توزيعات لِينُكس (GNU): `ls --color`. الفعل واحدٌ والغاية واحدة، لكنّ اسم الخيار يختلف باختلاف العائلة. تنبّهْ لهذا كلّما نقلتَ أمرًا من كتاب لِينُكس إلى ماك.
]

#danger[
  اللغة نفسها التي تعرض الملفّات تستطيع محوها بلا رجعةٍ ولا سلّة مهملات. أوامر مثل `rm -rf` (احذف كلَّ شيءٍ في مسارٍ دون سؤال) و`diskutil eraseDisk` (امسح قرصًا بأكمله) لا استعادة بعدها. لا تكتب أمرًا مدمّرًا لمجرّد التجربة، ولا تنسخ أمرًا من الإنترنت لا تفهمه. في هذا الكتاب سنميّز كلّ أمرٍ خطيرٍ بصندوقٍ كهذا.
]

#section[أساسٌ يعمل في كلّ مكان]

أجملُ ما في هذا الفصل أنّ ما تعلّمته لتوّك ليس محبوسًا في ماك. المحثّ، والصدفة، والفعل والخيار والمُعطى، وأوامر `whoami` و`pwd` و`ls` — كلُّها من صميم يونِكس. لو جلستَ غدًا أمام خادم لِينُكس عبر الشبكة، أو حاسوب FreeBSD، لوجدتَ الأوامر نفسها تعمل بالحروف ذاتها.

هذا هو سرّ قوّة ما تتعلّمه: أنت لا تتقن جهازًا واحدًا، بل *أسلوبًا* في مخاطبة الحواسيب عمره نصفُ قرن، ويشغّل اليوم أغلب البنية التحتيّة للإنترنت. ماك بابك إلى هذا العالم، وهو بابٌ فخمٌ ومريح.

#section[خلاصة الفصل]

عرفتَ أنّ ماك نظام يونِكسٍ معتمَد، وأنّ لِبّه Darwin ذو أصلٍ بِرْكليٍّ (BSD). وميّزتَ الطبقات الأربع: العتاد تحرّكه النواة (XNU)، والنواةَ تخاطبها الصدفة (zsh)، والصدفةَ تراها في الطرفية (Terminal، أو iTerm2). وفتحتَ الطرفية، وكتبتَ أوّل أوامرك، وعرفتَ أنّ كلّ أمرٍ جملةٌ من فعلٍ وخيارٍ ومُعطًى، وأنّ هذا كلَّه أساسٌ يونِكسيٌّ مشترك. في الفصل التالي سنتعلّم التنقّل: كيف نتحرّك بين مجلّدات ماك — من `/Users` إلى `/Applications` — كما نتنقّل بين غرف بيت.

#challenge[
  دون أن تنظر في الأعلى، أجب: ما الفرق بين النواة والصدفة والطرفية؟ ثم افتح Terminal ونفّذ `echo $SHELL` لتعرف اسم صدفتك — هل هي zsh أم bash؟ أخيرًا، نفّذ أمرًا واحدًا يجمع فعلًا وخيارًا ومُعطًى (جرّب `ls -l /Applications`)، وخمّن ماذا تعرض قبل أن تضغط #kbd("Enter"): هل صحّ حدسك؟
]
