#chapter[شجرة نظام ماك: أين يسكن كلّ شيء]

#objectives((
  [تقرأ خريطة الجذر `/` كاملةً، فتعرف ما يسكن كلّ مجلّدٍ تحته ولمَ سُمّي باسمه.],
  [تميّز مستويات المكتبة الثلاثة — `/System/Library` و`/Library` و`~/Library` — فتعرف أين تبحث عن إعدادات أيّ تطبيق.],
  [تكشف لماذا `/etc` و`/var` و`/tmp` أسماءٌ مستعارةٌ لا مجلّداتٍ حقيقيّة، وأين تسكن فعلًا.],
  [تفهم لماذا يبدو قرصك قرصًا واحدًا وهو في الحقيقة قرصان: وحدةٌ مختومةٌ للنظام وأخرى لبياناتك.],
  [تعرف أين يضع Homebrew أشياءه، وما `.DS_Store` ولماذا يلاحقك في كلّ مجلّد.],
))

في الفصل السابق تعلّمتَ المشي: `cd` تنقلك، و`ls` تريك، و`pwd` تخبرك أين أنت. لكنّ المشي بلا خريطةٍ تسكّعٌ لا تنقّل. تخيّل موظّفًا جديدًا في مبنًى إداريٍّ ضخم: أُعطي مفتاحًا وقيل له «تجوّل». سيمضي أسبوعًا كاملًا قبل أن يكتشف أنّ الأرشيف في القبو، وأنّ غرفة الخوادم لا تُفتح إلّا بإذن. أمّا لو وضعوا في يده مخطّط المبنى في أوّل يوم، لعرف في ساعةٍ ما يعرفه غيره في شهر. هذا الفصل هو ذلك المخطّط: لن نتعلّم فيه أمرًا جديدًا للمشي، بل سنتعلّم *أين نمشي ولماذا*. وحين تفرغ منه لن يبقى في جهازك مجلّدٌ يخيفك.

#section[نظرةٌ من القمّة: ماذا تحت الجذر؟]

نبدأ من أعلى نقطةٍ في النظام: الجذر `/`. سنسرد ما فيه بالخيار `-F` كي يلحق كلَّ اسمٍ رمزٌ يبيّن نوعه: `/` للمجلّد، و`@` للوصلة الرمزيّة — وسيتّضح معناها بعد قليل.

#session("ls -F /", output: "Applications/  Volumes/  etc@      sbin/\nLibrary/       bin/      home@     tmp@\nSystem/        cores/    opt/      usr/\nUsers/         dev/      private/  var@")

ستّة عشر اسمًا، لا أكثر. وهذه هي الخريطة كلّها في نظرةٍ واحدة؛ لا تحفظها، بل تعرّف إلى الوجوه فحسب، وسنجلس مع أهمّها بعد قليل:

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 0 { center + horizon } else { right + horizon },
  table.header([المجلّد], [ما يسكن فيه]),
  [`/`], [الجذر: أصل الشجرة كلّها، ولا شيء فوقه.],
  [`/Applications`], [التطبيقات ذات الواجهة الرسوميّة، لك ولسائر مستخدمي الجهاز.],
  [`/Users`], [بيوت المستخدمين. بيتك أنت هو `/Users` يتلوه اسمك، ويختصره الرمز `~`.],
  [`/System`], [نظام التشغيل نفسه. مِلكُ آبِل وحدها، ولا يُكتب فيه البتّة.],
  [`/Library`], [الموارد والإعدادات المشتركة بين كلّ مستخدمي الجهاز.],
  [`/Volumes`], [مرافئُ الأقراص الخارجيّة وصور الأقراص وأقسام الشبكة.],
  [`/usr`], [أدوات يونِكس ومكتباتها ووثائقها — أضخم مجلّدات النظام عددًا.],
  [`/bin` و`/sbin`], [أوامرُ أساسيّةٌ جدًّا لازمةٌ لإقلاع النظام وإنقاذه: `ls` و`cp` و`zsh`.],
  [`/private`], [الملفّات المتغيّرة الحقيقيّة: الإعدادات والسجلّات والمؤقّتات.],
  [`/etc` و`/var` و`/tmp`], [ليست مجلّداتٍ أصلًا، بل أسماءٌ مستعارةٌ تشير إلى داخل `/private`.],
  [`/dev`], [ملفّاتُ الأجهزة: كلّ قرصٍ ومنفذٍ ولوحةِ مفاتيحَ يمثّلها ملفٌّ هنا.],
  [`/opt`], [برامجُ خارجيّةٌ تُثبَّت مستقلّةً عن النظام (وهنا يسكن Homebrew على معالجات آبِل).],
  [`/cores`], [مكان «صور الذاكرة» التي يسكبها برنامجٌ ساعةَ انهياره؛ فارغٌ عندك على الأرجح، وهذا خبرٌ سارّ.],
  [`/home`], [لافتةٌ إلى مجلّدٍ فارغٍ، موروثةٌ عن يونِكس؛ بيوتُ ماك في `/Users` لا هنا.],
)

#note[
  لاحظ تقسيمًا لطيفًا: الأسماء التي تبدأ بحرفٍ كبير — `Applications` و`Library` و`System` و`Users` و`Volumes` — إرثُ ماك ونِكْسْتْ سْتِب (NeXTSTEP) الذي بُني عليه؛ والأسماء الصغيرة — `bin` و`etc` و`usr` و`var` — إرثُ يونِكس القديم من سبعينيّات القرن الماضي. ماك حاسوبٌ يمشي على ساقين: ساقٍ من آبِل وساقٍ من يونِكس، وتراهما هنا جنبًا إلى جنبٍ في قائمةٍ واحدة.
]

#distro[
  على لِينُكس شجرةٌ منظّمةٌ بمعيارٍ مكتوبٍ اسمه FHS (معيار تراتُب نظام الملفّات)، وفروقه عن ماك أربعة: بيوتُ الناس في `/home` لا `/Users`؛ ولا وجود لـ`/System` أصلًا، فالنظام موزّعٌ على `/usr` و`/etc`؛ و`/opt` هناك لبرامجَ تجاريّةٍ تُثبَّت يدويًّا لا لمدير حزمٍ كـHomebrew؛ و`/etc` مجلّدٌ حقيقيٌّ لا وصلةٌ إلى غيره. وتزيد لِينُكس مجلّدين لا نظير لهما هنا: `/proc` و`/sys`، ينسجهما النظام في الذاكرة ليكشف لك حالته لحظةً بلحظة. أمّا الفكرة الكبرى — شجرةٌ واحدةٌ من جذرٍ واحد — فمشتركةٌ بين كلّ أبناء يونِكس، وماك منهم.
]

#try-it[
  نفّذ `ls -F /` على جهازك وقارن ما ظهر بالجدول أعلاه. ثم اختر ثلاثة مجلّداتٍ لم تسمع بها قبل اليوم وانظر داخلها: `ls /cores` و`ls /opt` و`ls /private`. أيّها كان فارغًا؟ وأيّها فاجأك بما فيه؟
]

#section[المكتبات الثلاث: مفتاح فهم ماك]

إن كان في هذا الفصل درسٌ واحدٌ يستحقّ أن تحفظه فهو هذا. كثيرٌ من حَيرة مستخدمي ماك — «أين حفظ البرنامجُ إعداداتي؟» و«لماذا يظهر هذا الخطّ عندي ولا يظهر عند زميلي؟» — مردُّه إلى الخلط بين ثلاث مكتباتٍ يحملن الاسم نفسه.

#define("المكتبة (Library)", [
  مجلّدٌ ماكيٌّ خاصٌّ تسكن فيه *الأشياء المساندة* للبرامج: إعداداتها، وبياناتها، وخطوطها، وذاكرتها المؤقّتة، وخدماتها العاملة في الخلفيّة. ليست مكتبة كتبٍ بل مخزنَ عُدّة. وفي ماك ثلاث مكتباتٍ لا واحدة، ولكلٍّ منها صاحبٌ ونطاق.
])

تخيّل مبنًى فيه ثلاث خزائن: خزانةٌ في غرفة الإدارة مقفلةٌ بمفتاحٍ لا يملكه أحدٌ من السكّان، فيها المخطّطات الأصليّة؛ وخزانةٌ في البهو مشتركةٌ يضع فيها المالك ما ينتفع به الجميع؛ وخزانةٌ ثالثةٌ في شقّتك أنت لا يفتحها غيرك. هذه هي المكتبات الثلاث بالضبط:

#table(
  columns: (auto, auto, 1fr),
  align: (x, y) => if x == 2 { right + horizon } else { center + horizon },
  table.header([المكتبة], [لمن؟], [ماذا فيها ومَن يكتب فيها]),
  [`/System/Library`], [لآبِل], [مكوّنات نظام التشغيل نفسه. مختومةٌ للقراءة فقط، لا يكتب فيها أحد: لا أنت ولا مديرُ الجهاز. انظرْ ولا تلمس.],
  [`/Library`], [لكلّ المستخدمين], [ما يشترك فيه كلّ من يستعمل الجهاز: خطوطٌ عامّة، وإضافاتٌ، وخدماتٌ في الخلفيّة. الكتابة فيها تحتاج صلاحيّة مدير.],
  [`~/Library`], [لك وحدك], [إعداداتك أنت وبياناتك: تفضيلات التطبيقات، وحساباتك، وخطوطك الخاصّة. تكتب فيها بلا إذن، ولا يراها غيرك.],
)

والقاعدة التي تُخرجك من كلّ حَيرة: كلّما ضاق النطاق عَلَتِ الأولويّة. فما في `~/Library` يغلب ما في `/Library`، وهذا يغلب ما في `/System/Library`. ولذلك إن ثبّتَّ خطًّا باسم خطٍّ موجودٍ في النظام، فُضِّل خطُّك أنت. جرّبْ أن ترى الثلاثة في سطرٍ واحد:

#session("ls -d /Library/Fonts ~/Library/Fonts", output: "/Library/Fonts\n/Users/ghazi/Library/Fonts")

ومكتبةُ الخطوط الثالثة `/System/Library/Fonts` موجودةٌ كذلك، لم نذكرها في الأمر لأنّك لن تكتب فيها يومًا.

#subsection[ماذا يسكن في كلّ مكتبة؟]

المكتبات الثلاث تتشابه في أسماء غرفها الداخليّة تشابهًا كبيرًا؛ فمن حفظ خمسة أسماءٍ منها عرف طريقه في الثلاث جميعًا:

#table(
  columns: (auto, 1fr),
  align: (x, y) => if x == 0 { center + horizon } else { right + horizon },
  table.header([الغرفة], [ما يسكن فيها]),
  [`Application Support`], [بياناتُ التطبيقات العاملة: مكتبةُ رسائلك، وملفّاتُ محرّرك، وقواعدُ بياناته. أثمنُ ما في المكتبة.],
  [`Preferences`], [ملفّاتُ التفضيلات بامتداد `.plist` أي «قائمة الخصائص»: ملفٌّ لكلّ تطبيقٍ يحفظ خياراتك فيه.],
  [`Caches`], [ذاكرةٌ مؤقّتةٌ يعيد التطبيق بناءها إن فُقدت. أكبرُ مستهلكٍ للمساحة، وأقلُّها قيمة.],
  [`LaunchAgents`], [برامجُ تعمل تلقائيًّا حين تسجّل دخولك. من هنا تبدأ رحلة «لماذا يبطئ جهازي عند الإقلاع؟».],
  [`Fonts`], [الخطوط. ما تضعه في `~/Library/Fonts` تراه أنت وحدك، وما في `/Library/Fonts` يراه كلّ من على الجهاز.],
)

#danger[
  المكتبة الشخصيّة ليست ميدانًا للتجريب الأعمى. مجلّدا `~/Library/Containers` و`~/Library/Application Support` يحملان *بيانات تطبيقاتك نفسها* لا إعداداتها فحسب: محادثاتك، ومسوّداتك، ومفاتيح تراخيصك. وحذفُ مجلّدٍ منهما لا يعيد التطبيق إلى حالته الأولى، بل يمحو عملك محوًا لا رجعة فيه ولا سلّة مهملات. القاعدة: انظرْ في `~/Library` كما تشاء، ولا تحذف منها شيئًا إلّا وأنت تعرف بالضبط ماذا تحذف ولماذا.
]

#distro[
  ليس على لِينُكس مكتباتٌ ثلاث، بل توزيعٌ آخرُ للأدوار: إعداداتُك الشخصيّة في `~/.config` وبياناتك في `~/.local/share` (وفق اصطلاحٍ اسمه XDG)، وإعداداتُ النظام في `/etc`، والمواردُ المشتركة في `/usr/share`، والخطوطُ في `/usr/share/fonts` و`~/.fonts`. الفكرة واحدة — نطاقٌ للنظام ونطاقٌ للجميع ونطاقٌ لك — لكنّ ماك جمعها تحت اسمٍ واحدٍ متكرّرٍ ثلاث مرّات، وهو أوضحُ للمبتدئ وأسهلُ حفظًا.
]

#try-it[
  افتح الثلاث ووازن بينها بعينك: `ls /System/Library` ثم `ls /Library` ثم `ls ~/Library`. ستجد أسماءً تتكرّر في الثلاثة. ثم اسأل نفسك سؤالًا عمليًّا: أين يحفظ محرّرك المفضّل تفضيلاتك؟ ابحث عن اسمه في ناتج `ls ~/Library/Preferences`.
]

#section[لماذا اختفت مكتبتك؟ وكيف تراها]

إن فتحتَ بيتك في الفايندر (Finder) فلن تجد `Library` بين مجلّداتك. أخفتها آبِل عمدًا منذ إصدار Lion، لأنّ عبث المبتدئين بها كان يعطب تطبيقاتهم. لكنّ الطرفية لم تُخدَع يومًا: هي تراها كما ترى غيرها.

والمفاجأة أنّ `Library` ليست مخفيّةً بالطريقة المألوفة. فالاصطلاح المعروف أن يبدأ الاسم بنقطة، ولا نقطة في `Library`. سرُّها *رايةٌ* مغروزةٌ في المجلّد نفسه، تكشفها بالخيار `-O` (حرف O الكبير) مع `ls`:

#session("ls -lO ~", output: "drwx------+  8 ghazi  staff  -       Desktop\ndrwx------+  5 ghazi  staff  -       Documents\ndrwx------+  8 ghazi  staff  -       Downloads\ndrwx------@ 92 ghazi  staff  hidden  Library\ndrwx------   4 ghazi  staff  -       Movies")

انظر إلى العمود الجديد: في كلّ المجلّدات شَرطةٌ `-` أي «لا رايات»، إلّا `Library` فمكتوبٌ عندها `hidden`.

#note[
  مخرجاتُ بعض الأوامر أعرضُ من صفحة كتابٍ صغير، فنحذف منها في هذه الصفحات أعمدةً لا تخدم الفكرة — كعمود التاريخ وتفاصيل السعة. ما تراه على شاشتك أوفى ممّا تراه هنا، والجوهر واحد. فلا تحسبنّ اختلافَ عدد الأعمدة خطأً في جهازك.
]

#define("راية الملفّ (File flag)", [
  خاصّيّةٌ صغيرةٌ تُغرز في الملفّ نفسه فتغيّر تصرّف النظام معه، وهي غير الصلاحيات تمامًا. أشهرها `hidden` أي «أخفِ هذا العنصر عن الواجهة الرسوميّة»، و`uchg` أي «امنع تعديله». تُقرأ بـ`ls -lO` وتُغيَّر بأمر `chflags`.
])

فإن أردت رؤية مكتبتك فأمامك ثلاثُ طرقٍ متدرّجةٍ في الجرأة:

```zsh
ls -la ~/Library           # 1) انظر من الطرفية
open ~/Library             # 2) افتح في الفايندر
chflags nohidden ~/Library # 3) انزع راية الإخفاء
```

الأمر `open` ماكيٌّ خالص، يفتح أيّ ملفٍّ أو مجلّدٍ بالتطبيق المناسب له كأنّك نقرتَه نقرتين. والأمر `chflags` يغيّر رايات الملفّ: تكتب `nohidden` فينزع الراية، و`hidden` فيعيدها. وهو تغييرٌ آمنٌ رجوعُه بيدك في أيّ لحظة:

```zsh
chflags hidden ~/Library   # أعِدها متى شئت
```

#tip[
  في الفايندر حيلتان تغنيانك عن كلّ ما سبق: اضغط #kbd("Shift") + #kbd("Command") + #kbd(".") فتظهر كلّ المخفيّات دفعةً واحدة، واضغطها ثانيةً فتختفي. وإن فتحتَ قائمة «الانتقال» وأنت ضاغطٌ مفتاح #kbd("Option")، ظهر لك مدخل «المكتبة» في القائمة نفسها.
]

#warn[
  قد يعيد تحديثٌ كبيرٌ للنظام رايةَ الإخفاء إلى مكتبتك بعد أن نزعتَها. ليس عطبًا ولا فقدانًا لشيء؛ المجلّد في مكانه كما هو، والطرفية تراه كما كانت. أعِدْ `chflags nohidden ~/Library` إن أزعجك غيابه، ولا تُفزِعْك عودةُ الحال.
]

#try-it[
  نفّذ `ls -lO ~` على جهازك وابحث عن كلمة `hidden` في عمود الرايات. كم عنصرًا يحملها في بيتك؟ ثم نفّذ `open ~/Library` وتجوّل في مجلّد `Preferences` بالفايندر دقيقةً واحدة ثم أغلق النافذة. ألا ترى أنّك اليوم تعرف عن بيتك ما لا يعرفه أكثر مستخدمي ماك؟
]

#section[أسماءٌ مستعارةٌ لا مجلّدات: سرُّ `/private`]

عُدْ إلى قائمة الجذر في أوّل الفصل وتأمّل الأسماء الأربعة التي لحقتها العلامة `@`: `etc` و`home` و`tmp` و`var`. هذه العلامة تقول لك: «لستُ مجلّدًا، أنا لافتةٌ تشير إلى مكانٍ آخر». وثلاثةٌ منها تدلّ على مقصدٍ واحد، فلنبدأ بها. انظر بنفسك:

#session("ls -ld /etc", output: "lrwxr-xr-x@ 1 root  wheel  11  /etc -> private/etc")

اقرأ السطر من يساره: الحرف الأوّل `l` (اختصار link) يعني وصلةً رمزيّة، لا `d` للمجلّد ولا `-` للملفّ العاديّ. وفي آخر السطر سهمٌ يشير إلى الوجهة الحقيقيّة: `private/etc`. (وأمّا العلامة `@` الملتصقة بالصلاحيات فشيءٌ آخر تمامًا: تعني أنّ للملفّ خصائصَ ممتدّةً إضافيّة، ولا صلة لها بعلامة `@` التي يضعها `ls -F` بعد الاسم.)

#define("الوصلة الرمزيّة (Symbolic link)", [
  ملفٌّ صغيرٌ لا محتوى له إلّا *مسارُ ملفٍّ آخر*. حين تفتحه يحوّلك النظامُ إلى وجهته تلقائيًّا. أشبه بلافتةٍ في مطارٍ مكتوبٌ عليها «البوّابة 12 من هنا»: اللافتة ليست البوّابة، لكنّها توصلك إليها. ويسمّيها بعضهم «الرابط الرمزيّ»، واسمها المختصر `symlink`.
])

وأمرٌ صغيرٌ اسمه `readlink` وظيفتُه الوحيدة أن يقرأ لك وجهة الوصلة دون زخرفة:

```zsh
readlink /etc     # private/etc
readlink /var     # private/var
readlink /tmp     # private/tmp
```

#note[
  إن فتحتَ دليل هذا الأمر بـ`man readlink` على ماك ففاجأتك صفحةٌ عنوانها `stat`، فلم تخطئ: `readlink` على أنظمة BSD ليس برنامجًا مستقلًّا بل وجهٌ ثانٍ للأمر `stat` يتصرّف تصرّفًا مختصرًا حين يُنادى بهذا الاسم. وستتعلّم في فصل «أن تساعد نفسك» كيف تقرأ صفحات الدليل هذه قراءةَ محترف.
]

فأين تسكن هذه الثلاثة حقيقةً؟ في مجلّدٍ واحدٍ اسمه `/private`:

#session("ls /private", output: "etc  tftpboot  tmp  var")

وهنا يسكن ما لا يستقرّ: `/private/etc` فيه ملفّاتُ إعدادات النظام النصّيّة، و`/private/var` فيه السجلّاتُ وقواعدُ البيانات المتغيّرة، و`/private/tmp` فيه الملفّاتُ المؤقّتة التي تُمسح دوريًّا. (وأمّا الجار الرابع `tftpboot` فبقيّةٌ من خدمةٍ قديمةٍ تُقلِع بها أجهزةٌ عبر الشبكة، لن تحتاجها ولن تلمسها.) والسببُ في هذا الالتفاف تاريخيٌّ محض: نظام نِكْسْتْ سْتِب — جدُّ ماك — كان يجمع كلّ ما يخصّ جهازًا بعينه في مجلّد `/private` ليسهل فصلُه عن نظامٍ مشتركٍ عبر الشبكة. ولمّا وجب على ماك أن يبقى متوافقًا مع يونِكس التي تطلب `/etc` في مكانه، حُلّت المسألة بثلاث لافتات. فالماضي حاضرٌ في جهازك ولو في صورة سهمٍ صغير.

وتبقى اللافتة الرابعة `/home`، وهي تشير إلى مسارٍ غريب المظهر ووجهتُه مجلّدٌ فارغ:

#session("readlink /home", output: "/System/Volumes/Data/home")

لا يشغلْك شكلُ هذا المسار الآن؛ سيتّضح كلّ حرفٍ فيه في القسم التالي. أمّا الفراغ فمقصود: أبقت آبِل `/home` موضعًا مهيّأً تُركَّب فيه بيوتُ المستخدمين القادمةُ من خادمٍ في الشبكة، وهي حاجةٌ مؤسّسيّةٌ لن تمرّ بك على جهازك الشخصيّ. فاللافتة هنا معلّقةٌ على غرفةٍ لم تُؤثَّث بعد.

#warn[
  ستفاجئك هذه الوصلات يومًا: تدخل `cd /tmp` ثم تسأل `pwd` فيجيبك `/private/tmp` لا `/tmp`. لم يخطئ أحدٌ ولم تنتقل إلى غير وجهتك؛ الصدفةُ أرتك *المسار الحقيقيّ* بعد اجتياز اللافتة. الطريقان يؤدّيان إلى الغرفة نفسها، فلا تحسبهما مكانين.
]

#section[قرصٌ واحدٌ في عينك، قرصان في الحقيقة]

قبل أن نمضي، مصطلحٌ لا غنى عنه في هذا القسم كلّه:

#define("وحدة التخزين (Volume)", [
  مساحةٌ مستقلّةٌ على القرص، لها نظام ملفّاتٍ خاصٌّ بها واسمٌ تُعرَف به، تُركَّب في الشجرة عند مجلّدٍ بعينه فتبدو جزءًا منها. القرص الواحد يحمل وحداتٍ كثيرة؛ تخيّلها شققًا في عمارةٍ واحدة: جدرانٌ تفصل بينها، ومدخلٌ واحدٌ يجمعها.
])

منذ إصدار macOS Catalina فعلت آبِل شيئًا جريئًا: شطرت نظامك شطرين على وحدتين اثنتين. اسأل النظام عن أقراصه لترى:

#session("diskutil list", output: "/dev/disk1 (synthesized):\n  #:  TYPE NAME                        IDENTIFIER\n  0:  APFS Container Scheme -          disk1\n  1:  APFS Volume Macintosh HD - Data  disk1s1\n  2:  APFS Volume Preboot              disk1s2\n  3:  APFS Volume Recovery             disk1s3\n  4:  APFS Volume Macintosh HD         disk1s4\n  5:  APFS Snapshot com.apple.os...    disk1s4s1\n  6:  APFS Volume VM                   disk1s6")

اقتصرنا هنا على الجزء الذي يهمّنا؛ ويسبقه على شاشتك وصفُ القرص الماديّ نفسه. و`APFS` هو اسم نظام ملفّات ماك الحديث الذي مرّ بك في فصل التنقّل. والوحدتان اللتان تهمّانك الآن هما `Macintosh HD` و`Macintosh HD - Data`. (وإن كنتَ قد سمّيتَ قرصك باسمٍ آخر رأيتَ اسمك مكانهما، وبعض إصدارات ماك تختصر اسم الثانية إلى `Data` وحدها.)

#define("وحدة النظام المختومة (SSV)", [
  وحدةُ تخزينٍ تحمل نظام التشغيل وحده، مضبوطةٌ *للقراءة فقط*، وعليها ختمٌ تعمّيّ — توقيعٌ رياضيٌّ يُحسب لمحتواها كلّه. يتحقّق ماك من هذا الختم عند كلّ إقلاع، فإن غُيّر فيها بايتٌ واحدٌ انكسر الختمُ وعرف النظامُ أنّه عُبث به. واسمها الكامل Signed System Volume. وقد بدأ الشطرُ في إصدار Catalina وتمّ الختمُ في الإصدار الذي تلاه، Big Sur.
])

والوحدةُ الثانية، وهي وحدةُ البيانات، هي حيث تعيش أنت: بيتك، وتطبيقاتك، ومكتبتك، وكلّ ملفٍّ كتبتَه في حياتك. لكن كيف تبدوان شجرةً واحدةً وأنت تتنقّل؟ اسأل عن الوحدة التي يقع عليها الجذر، ثم عن الوحدة التي يقع عليها بيتك:

#session("df -h /", output: "Filesystem      Size   Used  Mounted on\n/dev/disk1s4s1  932Gi   12Gi  /")
#session("df -h ~", output: "Filesystem    Size   Used   Mounted on\n/dev/disk1s1  932Gi  102Gi  /System/Volumes/Data")

وحدتان مختلفتان (`disk1s4s1` و`disk1s1`)، وشجرةٌ واحدةٌ في عينك. والذي يلحم الشطرين اسمه *الوصلة الثابتة*.

#define("الوصلة الثابتة (Firmlink)", [
  جسرٌ ثنائيّ الاتّجاه بين مجلّدٍ في وحدة النظام ومجلّدٍ في وحدة البيانات، تصنعه آبِل وحدها ولا يملك المستخدم إنشاءه. تختلف عن الوصلة الرمزيّة في أنّها غير مرئيّةٍ البتّة: لا سهمَ ولا علامةَ نوع، ولا يشعر بها أمرٌ ولا برنامج. ووظيفتها أن يبدو القرصان المنفصلان شجرةً واحدةً متّصلة.
])

وقائمةُ هذه الجسور مكتوبةٌ في ملفٍّ تقرؤه بالأمر `cat` (وله فصل «عرض الملفّات وقراءتها» بعد قليل):

#session("cat /usr/share/firmlinks", output: "/Applications   Applications\n/Library        Library\n/Users          Users\n/Volumes        Volumes\n/cores          cores\n/opt            opt\n/private        private\n/usr/local      usr/local\n...")

كلّ سطرٍ يقول: «ما تراه على اليسار في الجذر، هو حقيقةً على وحدة البيانات». ولهذا كان `/Users` على `disk1s1` رغم أنّ `/` على `disk1s4s1`. وقد اقتطفنا أشهر السطور، فالقائمة عندك أطول: فيها جسورٌ دقيقةٌ تصل مجلّداتٍ بعينها داخل `/System` — مثل `/System/Library/Caches` — بوحدة البيانات، لأنّ النظام نفسه يحتاج موضعًا يكتب فيه ذاكرته المؤقّتة. أمّا ما سوى ذلك — `/System` و`/bin` و`/usr/bin` — فباقٍ على الوحدة المختومة، ومن ثَمّ محميٌّ حمايةً مطلقة. جرّبْ أن تكتب فيه:

#session("touch /System/Library/test", output: "touch: /System/Library/test: Read-only file system")

رفضٌ قاطع. ولاحظ أنّ الرفض لم يأتِ من نقصٍ في صلاحياتك — لو جرّبتَها بصلاحيّة مديرٍ لجاءك الرفضُ نفسه — بل من كون الوحدة مضبوطةً للقراءة فقط في أصلها. هذا الجدارُ هو ما يجعل عطب نظام ماك من داخله أمرًا شبه مستحيل.

#deep[
  للفضوليّ: الوحدتان ليستا مخفيّتين تمامًا، بل تُركّبان تحت `/System/Volumes`. نفّذ `ls /System/Volumes/Data` فسترى نسخةً من الجذر: `Applications` و`Library` و`Users` و`private` — وبينها `home` الفارغ الذي رأيت لافتته في الجذر قبل قليل. إنّه الوجه الآخر للجسور نفسها منظورًا إليه من الناحية الأخرى. ولا حاجة بك إلى استعمال هذه المسارات الطويلة أبدًا؛ إنّما ذكرناها لتعرف أنّ ما تراه شجرةً واحدةً خياطةٌ محكمةٌ لا مصادفة.
]

#try-it[
  اسأل جهازك ثلاثة أسئلةٍ بالترتيب: `diskutil list` (كم وحدةً على قرصك الداخليّ؟)، ثم `df -h /` و`df -h ~` (أهما على وحدةٍ واحدة؟)، ثم `mount` واقرأ السطر الذي ينتهي بالجذر `/`: ستجد بين قوسيه الكلمة `read-only`، وتجاورها في الإصدارات الحديثة كلمة `sealed` أي «مختوم». لقد رأيتَ الآن بعينك ما يقرؤه الناس في المقالات ولا يصدّقونه.
]

#section[أين يسكن Homebrew؟]

#define("Homebrew", [
  *مديرُ حزمٍ* لماك: برنامجٌ يجلب الأدوات ويثبّتها ويحدّثها ويحذفها بأمرٍ واحد، بدل تنزيلها يدويًّا من المواقع. أمرُه في الطرفية `brew`، وله فصلٌ كاملٌ لاحقًا. يكفيك الآن أن تعرف اسمه، لأنّ لسكنه في الشجرة قصّةً تخصّ هذا الفصل.
])

والسؤال الذي يهمّنا منه الآن واحد: أين يضع ما ينزّله؟ والجواب يختلف باختلاف معالج جهازك، وهذا من أكثر ما يُربك القادمين الجدد:

- على أجهزة إنتل (المعالج `x86_64`): البيتُ هو `/usr/local`، وفيه `bin` للأوامر و`Cellar` للحزم.
- على معالجات آبِل (المعالج `arm64`): البيتُ هو `/opt/homebrew` بالبنية نفسها تمامًا.

اسأل أداتك أين تسكن، ثم اسأل جهازك أيَّ معالجٍ فيه:

#session("brew --prefix", output: "/usr/local")
#session("uname -m", output: "x86_64")

هذا ناتجُ جهازٍ بمعالج إنتل. ولو كان جهازك بمعالج آبِل لقرأتَ `arm64` في الثاني و`/opt/homebrew` في الأوّل. وليس هذا الفرقُ مزاجًا: حين انتقلت آبِل إلى معالجاتها سنة 2020 صار كثيرٌ من المستخدمين يشغّلون نسختين من الأدوات على الجهاز الواحد — نسخةً أصليّةً وأخرى مترجَمةً لإنتل. فلو تشاركتا `/usr/local` لتصادمتا؛ فأُعطيت نسخةُ آبِل بيتًا جديدًا نظيفًا في `/opt/homebrew`.

#tip[
  حين تقرأ مقالةً تأمرك بمسارٍ مثل `/usr/local/bin/tool`، لا تنسخه نسخًا أعمى. اسأل جهازك أوّلًا: `brew --prefix` يعطيك بيت Homebrew عندك أنت، و`which أداة` يعطيك المسار الكامل لأيّ أمرٍ مثبَّت. هذه العادة تعفيك من ساعاتٍ من الحيرة، خصوصًا إن انتقلتَ بين جهازَي إنتل وآبِل.
]

#section[الملفّات المخفيّة وشبح `.DS_Store`]

بقيت طبقةٌ أخيرةٌ من الخريطة: ما لا تراه إلّا إن طلبتَه. والقاعدة في يونِكس كلّها بسيطةٌ إلى حدّ الطرافة: كلّ اسمٍ يبدأ بنقطةٍ يُخفى عن العرض الافتراضيّ. ليس تشفيرًا ولا حمايةً، بل اصطلاحًا لئلّا تزدحم عينك بملفّاتٍ لا تلمسها كلّ يوم. وهنا يظهر ضيفٌ ثقيلٌ لا يفارق مستخدمي ماك:

#session("ls -la ~/Desktop", output: "total 280\ndrwx------+  8 ghazi  staff    256  .\ndrwxr-x---+ 43 ghazi  staff   1376  ..\n-rw-r--r--@  1 ghazi  staff  10244  .DS_Store\n-rw-r--r--   1 ghazi  staff      0  .localized\ndrwxr-xr-x  24 ghazi  staff    768  zero-to-root")

#define([`.DS_Store`], [
  ملفٌّ ينشئه الفايندر في كلّ مجلّدٍ يعرضه، ليحفظ فيه *شكل العرض* لا محتواه: حجمَ النافذة، وموضعَ كلّ أيقونة، ونمطَ الترتيب، وصورةَ الخلفيّة. واسمه اختصارٌ لعبارة Desktop Services Store. حذفُه غيرُ ضارٍّ البتّة؛ وأقصى ما يحدث أنّ الفايندر ينسى ترتيب أيقوناتك في ذلك المجلّد ثم يعيد إنشاء الملفّ عند أوّل زيارة.
])

فلماذا يزعج إذن؟ لأنّه لا يبقى في جهازك. حين ترفع مشروعًا إلى مستودعٍ برمجيٍّ يتسلّل معه فيلوّث سجلّ التغييرات، وحين تنسخ مجلّدًا إلى ذاكرةٍ محمولةٍ يسافر معك فيراه زميلك على ويندوز أو لِينُكس ملفًّا غامضًا، وحين تعمل على قرص شبكةٍ مشتركٍ ينثر الفايندرُ نسخةً منه في كلّ مجلّدٍ يمرّ به. هو ضيفٌ مؤدّبٌ في بيتك، ثقيلٌ في بيت غيرك.

#tip[
  في مشاريعك البرمجيّة أضف السطر `.DS_Store` إلى ملفّ `.gitignore` مرّةً واحدة، فيكفّ عن ملاحقتك إلى الأبد. وستعرف هذا الملفّ حقّ المعرفة في فصل Git.
]

وإن كنتَ تعمل كثيرًا على أقراص الشبكة المشتركة، فلآبِل إعدادٌ يمنع الفايندر من نثر الملفّ عليها:

```zsh
defaults write com.apple.desktopservices \
    DSDontWriteNetworkStores -bool true
```

والأمر `defaults` بابُ الطرفية إلى تفضيلات ماك: يقرؤها ويكتب فيها كما تفعل نوافذ الإعدادات. أمّا الشَّرطة المائلة العكسيّة في آخر السطر الأوّل فتعني «الأمر لم ينتهِ بعدُ، أكمِلْه في السطر التالي»، وهي حيلةٌ نلجأ إليها كي لا يطول السطر فيتعب العين. ويسري هذا الإعداد بعد تسجيل خروجٍ ودخول.

#note[
  ليس `.DS_Store` وحده في بيتك. نفّذ `ls -a ~` وستجد جيرانًا كثرًا: `.zshrc` إعداداتُ صدفتك، و`.gitconfig` هويّتك في Git، و`.ssh` مفاتيحُك السرّيّة، و`.Trash` سلّةُ مهملاتك (نعم، السلّة مجلّدٌ مخفيٌّ في بيتك لا مكانٌ سحريّ). هذه الملفّاتُ النقطيّة هي *ذاكرةُ عاداتك* في النظام، وستقضي معها وقتًا طويلًا في فصول الصدفة والبيئة.
]

#try-it[
  نفّذ `ls -a ~` واقرأ القائمة كلّها بتمهّل: كم ملفًّا نقطيًّا عندك؟ اختر ثلاثةً منها واستنتج من أسمائها أيَّ برنامجٍ أنشأها. ثم نفّذ `ls -la ~/Desktop` وابحث عن `.DS_Store`: ما حجمه؟ ستفاجئك ضخامته على ملفٍّ لا يحفظ إلّا مواضع أيقونات.
]

#section[خلاصة الفصل]

صارت في يدك خريطةُ ماك كاملة. عرفتَ ما تحت الجذر: `/Users` بيوتُ الناس، و`/Applications` برامجُك، و`/System` قلبُ آبِل المختوم، و`/usr` و`/bin` أدواتُ يونِكس، و`/Volumes` مرافئُ الأقراص الخارجيّة. وحفظتَ مفتاح ماك الأكبر: مكتباتٌ ثلاثٌ متدرّجة — `/System/Library` لآبِل، و`/Library` للجميع، و`~/Library` لك وحدك — وفي كلٍّ منها `Application Support` و`Preferences` و`Caches` و`LaunchAgents` و`Fonts`. وعرفتَ لماذا اختفت مكتبتك عن الفايندر: رايةُ `hidden` تُقرأ بـ`ls -lO` وتُنزَع بـ`chflags nohidden`. وكشفتَ سرّ `/private`: أنّ `/etc` و`/var` و`/tmp` لافتاتٌ لا غرف. وفهمتَ لماذا يبدو قرصك واحدًا وهو اثنان: وحدةٌ مختومةٌ للقراءة فقط، ووحدةُ بياناتٍ لك، تلحمهما وصلاتٌ ثابتةٌ لا تراها العين. وعرفتَ أين يسكن Homebrew: `/usr/local` على إنتل و`/opt/homebrew` على معالجات آبِل. وأخيرًا صافحتَ `.DS_Store` وعلمتَ لماذا يلاحقك. في الفصل التالي ننتقل من معرفة *أين* تسكن الملفّات إلى معرفة *ما* بداخلها: نفتحها ونقرؤها ونستكشف محتواها.

#challenge[
  ثلاث مسائلَ تُجيب عنها من جهازك وحده، دون بحثٍ في الإنترنت. (1) اكتشف عمليًّا أنّ `/tmp` ليس مجلّدًا حقيقيًّا: نفّذ `ls -ld /tmp` واقرأ السهم، ثم `readlink /tmp`، ثم `cd /tmp` و`pwd` — واشرح لنفسك في جملةٍ واحدةٍ لماذا اختلف ناتج `pwd` عمّا كتبت. (2) اعثر على مجلّد `Preferences` في المكتبات الثلاث كلّها بأمر `ls -d` واحدٍ يذكر المسارات الثلاثة معًا، ثم وازن بين عدد الملفّات في `~/Library/Preferences` وعددها في `/Library/Preferences`: أيّهما أكثر، ولماذا في رأيك؟ (3) أجب عن سؤالين، لكلٍّ منهما أمرٌ واحدٌ يكفي: على أيّ وحدةٍ يقع مجلّد `/Applications` عندك — المختومة أم وحدة البيانات؟ وأين بيتُ Homebrew على جهازك أنت؟
]
