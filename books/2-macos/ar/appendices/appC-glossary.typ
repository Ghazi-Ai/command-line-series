#section[أساس ماك: النظام والنواة]

#gloss(
  [ماك أو إس], [macOS], [نظام تشغيل حواسيب آبل المكتبيّة والمحمولة، وواجهته الرسوميّة فوق أساسٍ يونِكسيٍّ اسمه Darwin.],
  [داروِن], [Darwin], [الأساس مفتوح المصدر الذي يقوم عليه macOS، ويجمع نواة XNU مع فضاء مستخدمٍ مشتقٍّ من BSD.],
  [نواة إكس إن يو], [XNU], [نواة ماك الهجينة، تدمج نواة Mach الدقيقة مع مكوّناتٍ من BSD وطبقة مشغّلات؛ الاسم اختصارُ «X is Not Unix».],
  [ماخ], [Mach], [النواة الدقيقة التي تشكّل قلب XNU، وتتولّى إدارة الذاكرة والعمليّات والرسائل بينها.],
  [يونِكس], [Unix], [عائلة أنظمة التشغيل الأمّ التي انحدر منها ماك وBSD ولِينُكس؛ وماك نظامٌ يونِكسيٌّ معتمَدٌ رسميًّا.],
  [معيار بوزكس], [POSIX], [مواصفةٌ تحدّد سلوك واجهات يونِكس وأوامره الأساسيّة، فتضمن نقل السكربتات بين الأنظمة المطابِقة لها.],
  [ماخ-أو], [Mach-O], [صيغة الملفّات التنفيذيّة والمكتبات في ماك (مشتقّةٌ من نواة Mach)، مقابل ELF على لِينُكس.],
)

#section[الصدفة والطرفية]

#gloss(
  [الطرفية], [Terminal / Terminal.app], [تطبيق ماك المدمج الذي يفتح نافذةً تكتب فيها الأوامر وتقرأ نتائجها؛ الوسيط الذي تظهر الصدفةُ خلاله.],
  [زَد شِل], [zsh], [الصدفة الافتراضيّة في ماك منذ إصدار Catalina، وهي غنيّةٌ بالإكمال والتخصيص؛ يشغّلها الأمر `zsh`.],
  [باش], [bash], [الصدفة الافتراضيّة سابقًا في ماك، ولا تزال متاحةً بإصدارٍ قديم (`bash` النسخة ٣) لأسباب رخصةٍ؛ تُحدَّث عبر Homebrew.],
  [آي تيرم ٢], [iTerm2], [بديلٌ شهيرٌ لتطبيق الطرفية على ماك، يضيف تبويباتٍ وتقسيماتٍ وميزاتٍ متقدّمة.],
  [المحثّ], [Prompt], [الرمز الذي ينتهي به سطر الصدفة (`%` في zsh عادةً) معلنًا استعدادها لتلقّي أمرٍ جديد.],
  [أوماي‌زد‌شِل], [Oh My Zsh], [إطارٌ مجتمعيٌّ لإدارة إعدادات zsh وسماتها وملحقاتها بسهولة.],
  [الملفّ الشخصيّ], [.zshrc], [ملفّ إعدادات zsh التفاعليّة في دليل البيت، يُقرأ عند فتح كلّ جلسةٍ لضبط البيئة والاختصارات.],
)

#section[هومبرو وإدارة الحزم]

#gloss(
  [هومبرو], [Homebrew], [مدير الحزم الأشهر لماك (غير رسميّ)، يثبّت البرامج الطرفيّة والرسوميّة عبر الأمر `brew`.],
  [الوصفة], [Formula], [مِلفُّ تعريفٍ بلغة Ruby يصف كيفيّة تنزيل برنامجٍ طرفيٍّ وبنائه وتثبيته عبر Homebrew.],
  [البرميل], [Cask], [امتدادٌ في Homebrew يثبّت التطبيقات الرسوميّة الجاهزة (`.app`) والخطوط والإضافات عبر `brew install --cask`.],
  [القارورة], [Bottle], [نسخةٌ مبنيّةٌ مسبقًا من وصفةٍ تُنزَّل جاهزةً فتُسرِّع التثبيت دون بناءٍ من المصدر.],
  [الصنبور], [Tap], [مستودع Git إضافيٌّ يوسّع Homebrew بوصفاتٍ خارج المستودع الرسميّ؛ يُضاف بـ `brew tap`.],
  [القبو], [Cellar], [المجلّد الذي يخزّن Homebrew فيه إصداراته المثبّتة، تحت `/opt/homebrew` على معالجات آبل و`/usr/local` على إنتل.],
  [الاعتماديّة], [Dependency], [حزمةٌ يحتاجها برنامجٌ آخر ليعمل، فيثبّتها `brew` تلقائيًّا معه.],
)

#section[خصائص ماك النظاميّة]

#gloss(
  [لانش‌دي], [launchd], [العمليّة الأمّ (PID رقم ١) ونظام الإقلاع وإدارة الخدمات في ماك، يشغّل العفاريت والوكلاء ويعيد تشغيلها.],
  [لانش‌كتل], [launchctl], [الأداة الطرفيّة التي تخاطب `launchd` لتحميل الخدمات وتشغيلها وإيقافها وسردها.],
  [قائمة الخصائص], [plist / Property List], [صيغة ملفّات إعداداتٍ من آبل (XML أو ثنائيّة) تخزّن أزواج مفتاحٍ وقيمة؛ تُقرأ وتُحرَّر بـ `plutil` و`defaults`.],
  [وكيل الإطلاق], [LaunchAgent], [ملفّ `plist` يصف خدمةً تعمل نيابةً عن مستخدمٍ بعد دخوله، مكانها `~/Library/LaunchAgents`.],
  [عفريت الإطلاق], [LaunchDaemon], [ملفّ `plist` يصف خدمةً على مستوى النظام تعمل قبل الدخول، مكانها `/Library/LaunchDaemons`.],
  [حماية سلامة النظام], [SIP], [ميزةٌ تمنع حتى الجذر من تعديل ملفّات النظام المحميّة؛ تُدار بأداة `csrutil` من وضع الاسترداد.],
  [البوّاب], [Gatekeeper], [حارسٌ أمنيٌّ يتحقّق من توقيع التطبيقات المنزَّلة وتوثيقها قبل السماح بأوّل تشغيلٍ لها.],
  [التوقيع البرمجيّ], [Code Signing], [ختمٌ رقميٌّ يثبت هويّة صانع التطبيق وسلامته؛ يُنشأ ويُفحَص بأداة `codesign`.],
  [التوثيق], [Notarization], [فحصٌ آليٌّ من آبل للبرامج الموزَّعة خارج المتجر، يبحث عن البرمجيّات الخبيثة قبل اعتمادها.],
  [إكس‌بروتكت], [XProtect], [نظام مكافحة البرمجيّات الخبيثة المدمج في ماك، يحدّث توقيعاته في الخلفيّة صامتًا.],
)

